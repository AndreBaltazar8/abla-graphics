// Strict, bounded glTF 2.0 metallic/roughness material mapping in pure Abla.

import "abla/float"
import "abla/json"
import "core.ab"
import "material.ab"

val gltfAlphaOpaque = 0
val gltfAlphaMask = 1
val gltfAlphaBlend = 2

class GltfTextureInfo(
    val index: int = -1,
    val texCoord: int = 0,
    val scale: f64 = 1.0
) {
    fun present(): bool = this.index >= 0
    fun valid(): bool = this.index >= -1 && this.index <= 1048575 &&
        this.texCoord >= 0 && this.texCoord <= 7 &&
        this.scale >= 0.0 && this.scale <= 64.0
}

class GltfClearcoatMaterial(
    val present: bool = false,
    val factor: f64 = 0.0,
    val roughness: f64 = 0.0,
    val texture: GltfTextureInfo = GltfTextureInfo(),
    val roughnessTexture: GltfTextureInfo = GltfTextureInfo(),
    val normalTexture: GltfTextureInfo = GltfTextureInfo()
) {
    fun valid(): bool = !this.present || (
        this.factor >= 0.0 && this.factor <= 1.0 &&
        this.roughness >= 0.0 && this.roughness <= 1.0 &&
        this.texture.valid() && this.roughnessTexture.valid() &&
        this.normalTexture.valid()
    )
}

class GltfSheenMaterial(
    val present: bool = false,
    val color: Vec3 = Vec3(0.0, 0.0, 0.0),
    val roughness: f64 = 0.0,
    val colorTexture: GltfTextureInfo = GltfTextureInfo(),
    val roughnessTexture: GltfTextureInfo = GltfTextureInfo()
) {
    fun valid(): bool = !this.present || (
        gltfUnitVec3(this.color) &&
        this.roughness >= 0.0 && this.roughness <= 1.0 &&
        this.colorTexture.valid() && this.roughnessTexture.valid()
    )
}

class GltfTransmissionMaterial(
    val present: bool = false,
    val factor: f64 = 0.0,
    val texture: GltfTextureInfo = GltfTextureInfo()
) {
    fun valid(): bool = !this.present || (
        this.factor >= 0.0 && this.factor <= 1.0 && this.texture.valid()
    )
}

class GltfVolumeMaterial(
    val present: bool = false,
    val thickness: f64 = 0.0,
    val thicknessTexture: GltfTextureInfo = GltfTextureInfo(),
    // -1 represents the specification's default infinite distance.
    val attenuationDistance: f64 = -1.0,
    val attenuationColor: Vec3 = Vec3(1.0, 1.0, 1.0)
) {
    fun valid(): bool = !this.present || (
        this.thickness >= 0.0 && this.thicknessTexture.valid() &&
        (this.attenuationDistance == -1.0 || this.attenuationDistance > 0.0) &&
        gltfUnitVec3(this.attenuationColor)
    )
}

class GltfSpecularMaterial(
    val present: bool = false,
    val factor: f64 = 1.0,
    val texture: GltfTextureInfo = GltfTextureInfo(),
    val color: Vec3 = Vec3(1.0, 1.0, 1.0),
    val colorTexture: GltfTextureInfo = GltfTextureInfo()
) {
    fun valid(): bool = !this.present || (
        this.factor >= 0.0 && this.factor <= 1.0 &&
        gltfPositiveVec3(this.color) && this.texture.valid() &&
        this.colorTexture.valid()
    )
}

class GltfIridescenceMaterial(
    val present: bool = false,
    val factor: f64 = 0.0,
    val texture: GltfTextureInfo = GltfTextureInfo(),
    val ior: f64 = 1.3,
    val thicknessMinimum: f64 = 100.0,
    val thicknessMaximum: f64 = 400.0,
    val thicknessTexture: GltfTextureInfo = GltfTextureInfo()
) {
    fun valid(): bool = !this.present || (
        this.factor >= 0.0 && this.factor <= 1.0 &&
        this.texture.valid() && this.ior >= 1.0 &&
        this.thicknessMinimum >= 0.0 &&
        this.thicknessMaximum >= this.thicknessMinimum &&
        this.thicknessTexture.valid()
    )
}

class GltfAnisotropyMaterial(
    val present: bool = false,
    val strength: f64 = 0.0,
    val rotation: f64 = 0.0,
    val texture: GltfTextureInfo = GltfTextureInfo()
) {
    fun valid(): bool = !this.present || (
        this.strength >= 0.0 && this.strength <= 1.0 &&
        gltfFinite(this.rotation) && this.texture.valid()
    )
}

class GltfMaterialExtensions(
    val syntaxValid: bool = true,
    val unlit: bool = false,
    val clearcoat: GltfClearcoatMaterial = GltfClearcoatMaterial(),
    val sheen: GltfSheenMaterial = GltfSheenMaterial(),
    val transmission: GltfTransmissionMaterial = GltfTransmissionMaterial(),
    val volume: GltfVolumeMaterial = GltfVolumeMaterial(),
    val specular: GltfSpecularMaterial = GltfSpecularMaterial(),
    val iorPresent: bool = false,
    val ior: f64 = 1.5,
    val iridescence: GltfIridescenceMaterial = GltfIridescenceMaterial(),
    val anisotropy: GltfAnisotropyMaterial = GltfAnisotropyMaterial(),
    val dispersionPresent: bool = false,
    val dispersion: f64 = 0.0
) {
    fun advancedPresent(): bool = this.clearcoat.present ||
        this.sheen.present || this.transmission.present ||
        this.volume.present || this.specular.present || this.iorPresent ||
        this.iridescence.present || this.anisotropy.present ||
        this.dispersionPresent

    fun valid(): bool = this.syntaxValid && this.clearcoat.valid() &&
        this.sheen.valid() && this.transmission.valid() && this.volume.valid() &&
        this.specular.valid() && this.iridescence.valid() &&
        this.anisotropy.valid() &&
        (!this.iorPresent || this.ior == 0.0 || this.ior >= 1.0) &&
        (!this.dispersionPresent || this.dispersion >= 0.0) &&
        (!this.volume.present || this.transmission.present) &&
        (!this.dispersionPresent || this.volume.present) &&
        (!this.unlit || !this.advancedPresent())
}

class GltfMaterial(
    val name: string = "",
    val pbr: PbrMaterial = PbrMaterial(),
    val alphaMode: int = gltfAlphaOpaque,
    val alphaCutoff: f64 = 0.5,
    val doubleSided: bool = false,
    val baseColorTexture: GltfTextureInfo = GltfTextureInfo(),
    val metallicRoughnessTexture: GltfTextureInfo = GltfTextureInfo(),
    val normalTexture: GltfTextureInfo = GltfTextureInfo(),
    val occlusionTexture: GltfTextureInfo = GltfTextureInfo(),
    val emissiveTexture: GltfTextureInfo = GltfTextureInfo(),
    val extensions: GltfMaterialExtensions = GltfMaterialExtensions()
) {
    fun valid(): bool = this.name.size <= 4096 && this.pbr.valid() &&
        this.alphaMode >= gltfAlphaOpaque && this.alphaMode <= gltfAlphaBlend &&
        this.alphaCutoff >= 0.0 && this.alphaCutoff <= 1.0 &&
        this.baseColorTexture.valid() &&
        this.metallicRoughnessTexture.valid() && this.normalTexture.valid() &&
        this.occlusionTexture.valid() && this.emissiveTexture.valid() &&
        this.extensions.valid()

    fun blendState(): ColorBlendState = if (this.alphaMode == gltfAlphaBlend)
        graphicsAlphaBlendState() else ColorBlendState()

    fun cullMode(): int = if (this.doubleSided) cullModeNone else cullModeBack

    fun textureReferencesValid(textureCount: int): bool =
        gltfTextureReferenceValid(this.baseColorTexture, textureCount) &&
        gltfTextureReferenceValid(this.metallicRoughnessTexture, textureCount) &&
        gltfTextureReferenceValid(this.normalTexture, textureCount) &&
        gltfTextureReferenceValid(this.occlusionTexture, textureCount) &&
        gltfTextureReferenceValid(this.emissiveTexture, textureCount) &&
        gltfTextureReferenceValid(this.extensions.clearcoat.texture, textureCount) &&
        gltfTextureReferenceValid(this.extensions.clearcoat.roughnessTexture, textureCount) &&
        gltfTextureReferenceValid(this.extensions.clearcoat.normalTexture, textureCount) &&
        gltfTextureReferenceValid(this.extensions.sheen.colorTexture, textureCount) &&
        gltfTextureReferenceValid(this.extensions.sheen.roughnessTexture, textureCount) &&
        gltfTextureReferenceValid(this.extensions.transmission.texture, textureCount) &&
        gltfTextureReferenceValid(this.extensions.volume.thicknessTexture, textureCount) &&
        gltfTextureReferenceValid(this.extensions.specular.texture, textureCount) &&
        gltfTextureReferenceValid(this.extensions.specular.colorTexture, textureCount) &&
        gltfTextureReferenceValid(this.extensions.iridescence.texture, textureCount) &&
        gltfTextureReferenceValid(this.extensions.iridescence.thicknessTexture, textureCount) &&
        gltfTextureReferenceValid(this.extensions.anisotropy.texture, textureCount)
}

class GltfMaterialParseResult(
    val materials: array<GltfMaterial>,
    val succeeded: bool,
    val error: string
)

class GltfScalar(val value: f64, val valid: bool)

fun gltfFinite(value: f64): bool = value == value &&
    value >= -1.7976931348623157e308 && value <= 1.7976931348623157e308

fun gltfUnitVec3(value: Vec3): bool = gltfFinite(value.x) &&
    gltfFinite(value.y) && gltfFinite(value.z) &&
    value.x >= 0.0 && value.x <= 1.0 &&
    value.y >= 0.0 && value.y <= 1.0 &&
    value.z >= 0.0 && value.z <= 1.0

fun gltfPositiveVec3(value: Vec3): bool = gltfFinite(value.x) &&
    gltfFinite(value.y) && gltfFinite(value.z) &&
    value.x >= 0.0 && value.y >= 0.0 && value.z >= 0.0

fun gltfTextureReferenceValid(info: GltfTextureInfo, count: int): bool =
    info.valid() && (!info.present() || info.index < count)

fun gltfPositivePower10(exponent: int): f64 {
    if (exponent <= 0) return 1.0
    val half = gltfPositivePower10(exponent / 2)
    val squared = half * half
    if (exponent - exponent / 2 * 2 == 0) squared else squared * 10.0
}

// JsonNumber retains its exact source spelling. Decode it here so glTF users
// do not need a native strtod dependency and integer-only factors are not a
// special case. JSON grammar validation has already happened in jsonParse.
fun gltfScalar(number: Json): GltfScalar {
    val text = number.asNumber().text
    var valid = number.isNumber() && text.size > 0 && text.size <= 128
    var cursor = 0
    var negative = false
    if (valid && text[cursor] == 45) {
        negative = true
        cursor = cursor + 1
    }
    var mantissa = 0
    var digits = 0
    while (valid && cursor < text.size && text[cursor] >= 48 && text[cursor] <= 57) {
        if (digits < 18) mantissa = mantissa * 10 + text[cursor] - 48
        digits = digits + 1
        cursor = cursor + 1
    }
    var fractionDigits = 0
    if (valid && cursor < text.size && text[cursor] == 46) {
        cursor = cursor + 1
        while (cursor < text.size && text[cursor] >= 48 && text[cursor] <= 57) {
            if (digits < 18) mantissa = mantissa * 10 + text[cursor] - 48
            digits = digits + 1
            fractionDigits = fractionDigits + 1
            cursor = cursor + 1
        }
    }
    var exponent = 0
    var exponentNegative = false
    if (valid && cursor < text.size && (text[cursor] == 101 || text[cursor] == 69)) {
        cursor = cursor + 1
        if (cursor < text.size && (text[cursor] == 43 || text[cursor] == 45)) {
            exponentNegative = text[cursor] == 45
            cursor = cursor + 1
        }
        while (cursor < text.size && text[cursor] >= 48 && text[cursor] <= 57) {
            if (exponent <= 308) exponent = exponent * 10 + text[cursor] - 48
            cursor = cursor + 1
        }
    }
    val signedExponent = if (exponentNegative) -exponent else exponent
    val scaleExponent = signedExponent - fractionDigits
    valid = valid && cursor == text.size && digits <= 18 &&
        exponent <= 308 && scaleExponent >= -308 && scaleExponent <= 308
    val unscaled = f64FromInt(mantissa)
    val value = if (scaleExponent < 0)
        unscaled / gltfPositivePower10(-scaleExponent)
    else unscaled * gltfPositivePower10(scaleExponent)
    val signedValue = if (negative) -value else value
    GltfScalar(signedValue, valid && gltfFinite(signedValue))
}

fun gltfOptionalScalar(object: Json, key: string, fallback: f64): GltfScalar =
    if (!object.has(key)) GltfScalar(fallback, true)
    else gltfScalar(object.get(key))

fun gltfTextureInfo(object: Json, key: string, scaleKey: string = ""): GltfTextureInfo {
    if (!object.has(key)) return GltfTextureInfo()
    val value = object.get(key)
    if (!value.isObject() || !value.has("index") || !value.get("index").intAvailable()) {
        return GltfTextureInfo(index = -2)
    }
    val coordinate = if (value.has("texCoord") && value.get("texCoord").intAvailable())
        value.getInt("texCoord") else if (value.has("texCoord")) -1 else 0
    val scale = if (scaleKey.size > 0)
        gltfOptionalScalar(value, scaleKey, 1.0) else GltfScalar(1.0, true)
    GltfTextureInfo(value.getInt("index"), coordinate, if (scale.valid) scale.value else -1.0)
}

fun gltfColor(arrayValue: Json, expected: int, fallback: Color): Color {
    if (!arrayValue.isArray() || arrayValue.size() != expected) return Color(-1.0, 0.0, 0.0)
    val red = gltfScalar(arrayValue.at(0))
    val green = gltfScalar(arrayValue.at(1))
    val blue = gltfScalar(arrayValue.at(2))
    val alpha = if (expected == 4) gltfScalar(arrayValue.at(3)) else GltfScalar(fallback.alpha, true)
    if (red.valid && green.valid && blue.valid && alpha.valid)
        Color(red.value, green.value, blue.value, alpha.value)
    else Color(-1.0, 0.0, 0.0)
}

fun gltfOptionalVec3(object: Json, key: string, fallback: Vec3): Vec3 {
    if (!object.has(key)) return fallback
    val color = gltfColor(
        object.get(key), 3, Color(fallback.x, fallback.y, fallback.z)
    )
    Vec3(color.red, color.green, color.blue)
}

fun gltfMaterialExtensions(value: Json): GltfMaterialExtensions {
    if (!value.has("extensions")) return GltfMaterialExtensions()
    val extensions = value.get("extensions")
    if (!extensions.isObject()) return GltfMaterialExtensions(syntaxValid = false)

    val unlitPresent = extensions.has("KHR_materials_unlit")
    val unlitValue = if (unlitPresent)
        extensions.get("KHR_materials_unlit") else jsonObject([], [])

    val clearcoatPresent = extensions.has("KHR_materials_clearcoat")
    val clearcoatValue = if (clearcoatPresent)
        extensions.get("KHR_materials_clearcoat") else jsonObject([], [])
    val clearcoat = if (clearcoatValue.isObject()) clearcoatValue
        else jsonObject([], [])
    val clearcoatFactor = gltfOptionalScalar(clearcoat, "clearcoatFactor", 0.0)
    val clearcoatRoughness = gltfOptionalScalar(
        clearcoat, "clearcoatRoughnessFactor", 0.0
    )

    val sheenPresent = extensions.has("KHR_materials_sheen")
    val sheenValue = if (sheenPresent)
        extensions.get("KHR_materials_sheen") else jsonObject([], [])
    val sheen = if (sheenValue.isObject()) sheenValue else jsonObject([], [])
    val sheenRoughness = gltfOptionalScalar(
        sheen, "sheenRoughnessFactor", 0.0
    )

    val transmissionPresent = extensions.has("KHR_materials_transmission")
    val transmissionValue = if (transmissionPresent)
        extensions.get("KHR_materials_transmission") else jsonObject([], [])
    val transmission = if (transmissionValue.isObject()) transmissionValue
        else jsonObject([], [])
    val transmissionFactor = gltfOptionalScalar(
        transmission, "transmissionFactor", 0.0
    )

    val volumePresent = extensions.has("KHR_materials_volume")
    val volumeValue = if (volumePresent)
        extensions.get("KHR_materials_volume") else jsonObject([], [])
    val volume = if (volumeValue.isObject()) volumeValue else jsonObject([], [])
    val thickness = gltfOptionalScalar(volume, "thicknessFactor", 0.0)
    val attenuationDistance = gltfOptionalScalar(
        volume, "attenuationDistance", -1.0
    )

    val specularPresent = extensions.has("KHR_materials_specular")
    val specularValue = if (specularPresent)
        extensions.get("KHR_materials_specular") else jsonObject([], [])
    val specular = if (specularValue.isObject()) specularValue
        else jsonObject([], [])
    val specularFactor = gltfOptionalScalar(specular, "specularFactor", 1.0)

    val iorPresent = extensions.has("KHR_materials_ior")
    val iorValue = if (iorPresent)
        extensions.get("KHR_materials_ior") else jsonObject([], [])
    val iorObject = if (iorValue.isObject()) iorValue else jsonObject([], [])
    val ior = gltfOptionalScalar(iorObject, "ior", 1.5)

    val iridescencePresent = extensions.has("KHR_materials_iridescence")
    val iridescenceValue = if (iridescencePresent)
        extensions.get("KHR_materials_iridescence") else jsonObject([], [])
    val iridescence = if (iridescenceValue.isObject()) iridescenceValue
        else jsonObject([], [])
    val iridescenceFactor = gltfOptionalScalar(
        iridescence, "iridescenceFactor", 0.0
    )
    val iridescenceIor = gltfOptionalScalar(
        iridescence, "iridescenceIor", 1.3
    )
    val iridescenceMinimum = gltfOptionalScalar(
        iridescence, "iridescenceThicknessMinimum", 100.0
    )
    val iridescenceMaximum = gltfOptionalScalar(
        iridescence, "iridescenceThicknessMaximum", 400.0
    )

    val anisotropyPresent = extensions.has("KHR_materials_anisotropy")
    val anisotropyValue = if (anisotropyPresent)
        extensions.get("KHR_materials_anisotropy") else jsonObject([], [])
    val anisotropy = if (anisotropyValue.isObject()) anisotropyValue
        else jsonObject([], [])
    val anisotropyStrength = gltfOptionalScalar(
        anisotropy, "anisotropyStrength", 0.0
    )
    val anisotropyRotation = gltfOptionalScalar(
        anisotropy, "anisotropyRotation", 0.0
    )

    val dispersionPresent = extensions.has("KHR_materials_dispersion")
    val dispersionValue = if (dispersionPresent)
        extensions.get("KHR_materials_dispersion") else jsonObject([], [])
    val dispersionObject = if (dispersionValue.isObject()) dispersionValue
        else jsonObject([], [])
    val dispersion = gltfOptionalScalar(dispersionObject, "dispersion", 0.0)

    val syntaxValid = (!unlitPresent || unlitValue.isObject()) &&
        (!clearcoatPresent || clearcoatValue.isObject()) &&
        (!sheenPresent || sheenValue.isObject()) &&
        (!transmissionPresent || transmissionValue.isObject()) &&
        (!volumePresent || volumeValue.isObject()) &&
        (!specularPresent || specularValue.isObject()) &&
        (!iorPresent || iorValue.isObject()) &&
        (!iridescencePresent || iridescenceValue.isObject()) &&
        (!anisotropyPresent || anisotropyValue.isObject()) &&
        (!dispersionPresent || dispersionValue.isObject()) &&
        clearcoatFactor.valid && clearcoatRoughness.valid &&
        sheenRoughness.valid && transmissionFactor.valid &&
        thickness.valid && attenuationDistance.valid && specularFactor.valid &&
        ior.valid && iridescenceFactor.valid && iridescenceIor.valid &&
        iridescenceMinimum.valid && iridescenceMaximum.valid &&
        anisotropyStrength.valid && anisotropyRotation.valid && dispersion.valid

    GltfMaterialExtensions(
        syntaxValid = syntaxValid,
        unlit = unlitPresent,
        clearcoat = GltfClearcoatMaterial(
            clearcoatPresent, clearcoatFactor.value, clearcoatRoughness.value,
            gltfTextureInfo(clearcoat, "clearcoatTexture"),
            gltfTextureInfo(clearcoat, "clearcoatRoughnessTexture"),
            gltfTextureInfo(clearcoat, "clearcoatNormalTexture", "scale")
        ),
        sheen = GltfSheenMaterial(
            sheenPresent,
            gltfOptionalVec3(sheen, "sheenColorFactor", Vec3(0.0, 0.0, 0.0)),
            sheenRoughness.value,
            gltfTextureInfo(sheen, "sheenColorTexture"),
            gltfTextureInfo(sheen, "sheenRoughnessTexture")
        ),
        transmission = GltfTransmissionMaterial(
            transmissionPresent, transmissionFactor.value,
            gltfTextureInfo(transmission, "transmissionTexture")
        ),
        volume = GltfVolumeMaterial(
            volumePresent, thickness.value,
            gltfTextureInfo(volume, "thicknessTexture"),
            attenuationDistance.value,
            gltfOptionalVec3(
                volume, "attenuationColor", Vec3(1.0, 1.0, 1.0)
            )
        ),
        specular = GltfSpecularMaterial(
            specularPresent, specularFactor.value,
            gltfTextureInfo(specular, "specularTexture"),
            gltfOptionalVec3(
                specular, "specularColorFactor", Vec3(1.0, 1.0, 1.0)
            ),
            gltfTextureInfo(specular, "specularColorTexture")
        ),
        iorPresent = iorPresent,
        ior = ior.value,
        iridescence = GltfIridescenceMaterial(
            iridescencePresent, iridescenceFactor.value,
            gltfTextureInfo(iridescence, "iridescenceTexture"),
            iridescenceIor.value, iridescenceMinimum.value,
            iridescenceMaximum.value,
            gltfTextureInfo(iridescence, "iridescenceThicknessTexture")
        ),
        anisotropy = GltfAnisotropyMaterial(
            anisotropyPresent, anisotropyStrength.value,
            anisotropyRotation.value,
            gltfTextureInfo(anisotropy, "anisotropyTexture")
        ),
        dispersionPresent = dispersionPresent,
        dispersion = dispersion.value
    )
}

fun gltfMaterial(value: Json): GltfMaterial {
    if (!value.isObject()) return GltfMaterial(alphaMode = -1)
    val pbrValue = if (value.has("pbrMetallicRoughness"))
        value.get("pbrMetallicRoughness") else jsonObject([], [])
    if (!pbrValue.isObject()) return GltfMaterial(alphaMode = -1)
    val baseColor = if (pbrValue.has("baseColorFactor"))
        gltfColor(pbrValue.get("baseColorFactor"), 4, Color(1.0, 1.0, 1.0))
    else Color(1.0, 1.0, 1.0)
    val emissive = if (value.has("emissiveFactor"))
        gltfColor(value.get("emissiveFactor"), 3, Color(0.0, 0.0, 0.0))
    else Color(0.0, 0.0, 0.0)
    val metallic = gltfOptionalScalar(pbrValue, "metallicFactor", 1.0)
    val roughness = gltfOptionalScalar(pbrValue, "roughnessFactor", 1.0)
    val cutoff = gltfOptionalScalar(value, "alphaCutoff", 0.5)
    val extensions = value.get("extensions")
    val emissiveExtension = if (extensions.isObject())
        extensions.get("KHR_materials_emissive_strength") else jsonNull()
    val emissiveStrength = if (emissiveExtension.isObject())
        gltfOptionalScalar(emissiveExtension, "emissiveStrength", 1.0)
    else GltfScalar(1.0, true)
    val alphaText = if (value.has("alphaMode")) value.getString("alphaMode") else "OPAQUE"
    val alpha = if (alphaText == "OPAQUE") gltfAlphaOpaque
        else if (alphaText == "MASK") gltfAlphaMask
        else if (alphaText == "BLEND") gltfAlphaBlend else -1
    val normal = gltfTextureInfo(value, "normalTexture", "scale")
    val occlusion = gltfTextureInfo(value, "occlusionTexture", "strength")
    GltfMaterial(
        name = if (value.has("name") && value.get("name").isString()) value.getString("name") else "",
        pbr = PbrMaterial(
            baseColor = baseColor,
            metallic = if (metallic.valid) metallic.value else -1.0,
            roughness = if (roughness.valid) roughness.value else -1.0,
            ambientOcclusion = if (occlusion.present()) occlusion.scale else 1.0,
            emissiveStrength = if (emissiveStrength.valid) emissiveStrength.value else -1.0,
            emissiveColor = emissive
        ),
        alphaMode = alpha,
        alphaCutoff = if (cutoff.valid) cutoff.value else -1.0,
        doubleSided = value.has("doubleSided") && value.get("doubleSided").isBoolean() && value.get("doubleSided").asBoolean(),
        baseColorTexture = gltfTextureInfo(pbrValue, "baseColorTexture"),
        metallicRoughnessTexture = gltfTextureInfo(pbrValue, "metallicRoughnessTexture"),
        normalTexture = normal,
        occlusionTexture = occlusion,
        emissiveTexture = gltfTextureInfo(value, "emissiveTexture"),
        extensions = gltfMaterialExtensions(value)
    )
}

fun gltfMaterials(source: string): GltfMaterialParseResult {
    val parsed = jsonParse(source, JsonLimits(8388608, 64, 250000, 1048576, 100000, true))
    if (!parsed.succeeded) return GltfMaterialParseResult([], false, "${parsed.error.code} at ${parsed.error.line}:${parsed.error.column}")
    if (!parsed.value.isObject() || !parsed.value.has("materials") || !parsed.value.get("materials").isArray()) {
        return GltfMaterialParseResult([], false, "glTF materials array is missing")
    }
    val values = parsed.value.get("materials")
    if (values.size() > 65536) return GltfMaterialParseResult([], false, "glTF material limit exceeded")
    var materials: array<GltfMaterial> = []
    var valid = true
    var index = 0
    while (valid && index < values.size()) {
        val material = gltfMaterial(values.at(index))
        valid = material.valid()
        if (valid) materials.append(material)
        index = index + 1
    }
    if (valid) GltfMaterialParseResult(materials, true, "")
    else GltfMaterialParseResult([], false, "invalid glTF material at index ${index - 1}")
}
