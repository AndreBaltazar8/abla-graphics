// Pure-Abla glTF buffer acquisition, accessor decoding, and GPU materialization.

import "abla/crypto"
import "abla/float"
import "buffer.ab"
import "gltf_scene.ab"

class GltfBufferPayloads(
    val values: array<string>,
    val valid: bool,
    val error: string
)

// Dense accessor decoding is setup work. Keeping every validated accessor in
// one affine cache lets animation and deformation reuse sparse expansion,
// stride removal, and normalized source bytes across every frame.
resource class GltfAccessorCache(
    var values: array<BufferBytes>,
    val valid: bool,
    val error: string
)

resource class GltfGpuPrimitive(
    val vertices: GraphicsBuffer,
    val indices: GraphicsBuffer,
    val vertexCount: int,
    val indexCount: int,
    val error: string
) {
    fun valid(): bool = this.error.size == 0 && this.vertices.valid() &&
        this.indices.valid() && this.vertexCount > 0 && this.indexCount > 0

    trusted fun drop(): void {
        this.vertices.drop()
        this.indices.drop()
        return
    }
}

resource class GltfGpuTexturedPrimitive(
    val vertices: GraphicsBuffer,
    val indices: GraphicsBuffer,
    val vertexCount: int,
    val indexCount: int,
    val layout: VertexBufferLayout,
    val error: string
) {
    fun valid(): bool = this.error.size == 0 && this.vertices.valid() &&
        this.indices.valid() && this.vertexCount > 0 && this.indexCount > 0 &&
        this.layout.valid()

    trusted fun drop(): void {
        this.vertices.drop()
        this.indices.drop()
        return
    }
}

resource class GltfGpuTexturedScene(
    val vertices: GraphicsBuffer,
    val indices: GraphicsBuffer,
    val vertexCount: int,
    val indexCount: int,
    val drawIndexCounts: array<int>,
    val drawIndexOffsets: array<int>,
    val layout: VertexBufferLayout,
    val error: string
) {
    fun valid(): bool = this.error == "" && this.vertices.valid() &&
        this.indices.valid() && this.vertexCount > 0 && this.indexCount > 0 &&
        this.drawIndexCounts.size > 0 &&
        this.drawIndexCounts.size == this.drawIndexOffsets.size &&
        this.layout.valid()

    trusted fun drop(): void {
        this.vertices.drop()
        this.indices.drop()
        return
    }
}

resource class GltfPackedTexturedScene(
    val vertices: BufferBytes,
    val indices: BufferBytes,
    val vertexCount: int,
    val indexCount: int,
    val drawIndexCounts: array<int>,
    val drawIndexOffsets: array<int>,
    val layout: VertexBufferLayout,
    val error: string
) {
    fun valid(): bool = this.error == "" && this.vertices.valid() &&
        this.indices.valid() && this.vertexCount > 0 && this.indexCount > 0 &&
        this.vertices.size == this.vertexCount * this.layout.stride &&
        this.indices.size == this.indexCount * 4 &&
        this.drawIndexCounts.size > 0 &&
        this.drawIndexCounts.size == this.drawIndexOffsets.size &&
        this.layout.valid()

    trusted fun drop(): void {
        this.vertices.storage.close()
        this.indices.storage.close()
        return
    }
}

// Reusable CPU-side data for animated retained geometry. Accessors are decoded
// once and the fixed-size vertex stream is overwritten on every sampled pose.
resource class GltfTexturedSceneUpdateCache(
    val accessors: GltfAccessorCache,
    val vertices: BufferBytes,
    val vertexBases: array<int>,
    val resourceIndexCounts: array<int>,
    val resourceIndexOffsets: array<int>,
    val vertexCount: int,
    val valid: bool,
    val error: string
)

fun gltfDataUriPayload(uri: string): string {
    val prefix = "data:application/octet-stream;base64,"
    val generic = "data:application/gltf-buffer;base64,"
    if (uri.size >= prefix.size && uri.slice(0, prefix.size) == prefix)
        base64Decode(uri.slice(prefix.size, uri.size))
    else if (uri.size >= generic.size && uri.slice(0, generic.size) == generic)
        base64Decode(uri.slice(generic.size, uri.size))
    else ""
}

// A caller may supply external/GLB payloads by index. An empty supplied value
// falls back to a base64 data URI; all byte lengths must match the document.
fun gltfBufferPayloads(
    document: GltfDocument,
    supplied: array<string> = []
): GltfBufferPayloads {
    val values: array<string> = []
    var valid = document.valid() &&
        (supplied.size == 0 || supplied.size == document.buffers.size)
    var index = 0
    while (valid && index < document.buffers.size) {
        val external = if (supplied.size == document.buffers.size)
            supplied[index] else ""
        val payload = if (external.size > 0) external
            else gltfDataUriPayload(document.buffers[index].uri)
        valid = payload.size == document.buffers[index].byteLength
        if (valid) values.append(payload)
        index = index + 1
    }
    GltfBufferPayloads(
        values,
        valid,
        if (valid) "" else "glTF buffer payload count or byte length mismatch"
    )
}

fun gltfLoadUnsigned(bytes: string, offset: int, size: int): int =
    if (offset < 0 || offset > bytes.size - size) -1
    else if (size == 1) bytes[offset]
    else if (size == 2) bytes[offset] + bytes[offset + 1] * 256
    else if (size == 4) bytes[offset] + bytes[offset + 1] * 256 +
        bytes[offset + 2] * 65536 + bytes[offset + 3] * 16777216
    else -1

trusted fun gltfLoadUnsignedBuffer(
    bytes: BufferBytes,
    offset: int,
    size: int
): int = if (!bytes.valid() || offset < 0 || offset > bytes.size - size) -1
    else if (size == 1) bytes.load(offset)
    else if (size == 2) bytes.load(offset) + bytes.load(offset + 1) * 256
    else if (size == 4) bytes.load(offset) + bytes.load(offset + 1) * 256 +
        bytes.load(offset + 2) * 65536 + bytes.load(offset + 3) * 16777216
    else -1

fun gltfTextureCoordinateAccessorSupported(accessor: GltfAccessor): bool =
    accessor.elementType == "VEC2" &&
    ((accessor.componentType == gltfComponentF32 && !accessor.normalized) ||
     ((accessor.componentType == gltfComponentU8 ||
       accessor.componentType == gltfComponentU16) && accessor.normalized))

// Writes one compact accessor element into the portable float vertex contract.
// glTF normalized unsigned values expand once during retained-buffer creation,
// keeping backend formats and frame submission identical.
trusted fun gltfStoreAccessorElementF32(
    var destination: BufferBytes,
    destinationOffset: int,
    source: BufferBytes,
    accessor: GltfAccessor,
    element: int,
    components: int
): bool {
    val componentSize = accessor.componentByteSize()
    var valid = destination.valid() && source.valid() &&
        destinationOffset >= 0 && components > 0 &&
        destinationOffset <= destination.size - components * 4 &&
        element >= 0 && element < accessor.count &&
        accessor.elementByteSize() == components * componentSize &&
        ((accessor.componentType == gltfComponentF32 &&
          !accessor.normalized) ||
         ((accessor.componentType == gltfComponentU8 ||
           accessor.componentType == gltfComponentU16) &&
          accessor.normalized))
    var component = 0
    while (valid && component < components) {
        val sourceOffset = element * accessor.elementByteSize() +
            component * componentSize
        if (accessor.componentType == gltfComponentF32) {
            var byteIndex = 0
            while (valid && byteIndex < 4) {
                valid = destination.store(
                    destinationOffset + component * 4 + byteIndex,
                    source.load(sourceOffset + byteIndex)
                )
                byteIndex = byteIndex + 1
            }
        } else {
            val value = gltfLoadUnsignedBuffer(
                source, sourceOffset, componentSize
            )
            val divisor = if (componentSize == 1) 255.0 else 65535.0
            valid = value >= 0 && destination.storeF32(
                f64FromInt(value) / divisor,
                destinationOffset + component * 4
            )
        }
        component = component + 1
    }
    valid
}

trusted fun gltfStoreDefaultSurfaceDirection(
    var destination: BufferBytes,
    destinationOffset: int,
    tangent: bool
): bool =
    destination.storeF32(if (tangent) 1.0 else 0.0, destinationOffset) &&
    destination.storeF32(0.0, destinationOffset + 4) &&
    destination.storeF32(if (tangent) 0.0 else 1.0, destinationOffset + 8) &&
    (!tangent || destination.storeF32(1.0, destinationOffset + 12))

trusted fun gltfCopyStringBytes(
    source: string,
    sourceOffset: int,
    var destination: BufferBytes,
    destinationOffset: int,
    size: int
): bool {
    var valid = sourceOffset >= 0 && destinationOffset >= 0 && size >= 0 &&
        sourceOffset <= source.size - size &&
        destinationOffset <= destination.size - size
    var index = 0
    while (valid && index < size) {
        valid = destination.store(
            destinationOffset + index, source[sourceOffset + index]
        )
        index = index + 1
    }
    valid
}

trusted fun gltfAccessorBytes(
    document: GltfDocument,
    payloads: GltfBufferPayloads,
    accessorIndex: int
): BufferBytes {
    if (!document.valid() || !payloads.valid ||
        accessorIndex < 0 || accessorIndex >= document.accessors.size)
        return bufferBytes(0)
    val accessor = document.accessors[accessorIndex]
    val elementSize = accessor.elementByteSize()
    val output = bufferBytes(accessor.count * elementSize)
    var valid = output.valid() && output.fill(0)
    if (valid && accessor.bufferView >= 0) {
        val view = document.bufferViews[accessor.bufferView]
        val payload = payloads.values[view.buffer]
        val stride = if (view.byteStride == 0) elementSize else view.byteStride
        var element = 0
        while (valid && element < accessor.count) {
            valid = gltfCopyStringBytes(
                payload,
                view.byteOffset + accessor.byteOffset + element * stride,
                output,
                element * elementSize,
                elementSize
            )
            element = element + 1
        }
    }
    if (valid && accessor.sparse.present()) {
        val sparse = accessor.sparse
        val indexView = document.bufferViews[sparse.indicesBufferView]
        val valueView = document.bufferViews[sparse.valuesBufferView]
        val indexPayload = payloads.values[indexView.buffer]
        val valuePayload = payloads.values[valueView.buffer]
        val indexSize = gltfComponentByteSize(sparse.indicesComponentType)
        var sparseIndex = 0
        var previous = -1
        while (valid && sparseIndex < sparse.count) {
            val destinationIndex = gltfLoadUnsigned(
                indexPayload,
                indexView.byteOffset + sparse.indicesByteOffset +
                    sparseIndex * indexSize,
                indexSize
            )
            valid = destinationIndex > previous &&
                destinationIndex < accessor.count && gltfCopyStringBytes(
                    valuePayload,
                    valueView.byteOffset + sparse.valuesByteOffset +
                        sparseIndex * elementSize,
                    output,
                    destinationIndex * elementSize,
                    elementSize
                )
            previous = destinationIndex
            sparseIndex = sparseIndex + 1
        }
    }
    if (valid) output else bufferBytes(0)
}

trusted fun gltfAccessorCache(
    document: GltfDocument,
    payloads: GltfBufferPayloads
): GltfAccessorCache {
    val values: array<BufferBytes> = []
    var valid = document.valid() && payloads.valid &&
        document.accessors.size > 0
    var accessor = 0
    while (valid && accessor < document.accessors.size) {
        val bytes = gltfAccessorBytes(document, payloads, accessor)
        valid = bytes.valid()
        values.append(move(bytes))
        accessor = accessor + 1
    }
    GltfAccessorCache(
        move(values), valid,
        if (valid) "" else "glTF accessor cache decoding failed"
    )
}

trusted fun gltfTexturedSceneUpdateCache(
    document: GltfDocument,
    payloads: GltfBufferPayloads,
    plan: GltfSceneResourcePlan
): GltfTexturedSceneUpdateCache {
    val accessors = gltfAccessorCache(document, payloads)
    val vertexBases: array<int> = []
    val resourceIndexCounts: array<int> = []
    val resourceIndexOffsets: array<int> = []
    var vertexCount = 0
    var indexCount = 0
    var valid = accessors.valid && plan.valid &&
        plan.meshIndices.size == plan.primitiveIndices.size &&
        plan.meshIndices.size == plan.resourceNodes.size &&
        plan.meshIndices.size > 0
    var resourceIndex = 0
    while (valid && resourceIndex < plan.meshIndices.size) {
        val mesh = plan.meshIndices[resourceIndex]
        val primitiveIndex = plan.primitiveIndices[resourceIndex]
        valid = mesh >= 0 && mesh < document.meshes.size &&
            primitiveIndex >= 0 &&
            primitiveIndex < document.meshes[mesh].primitives.size
        if (valid) {
            val primitive = document.meshes[mesh].primitives[primitiveIndex]
            val positions = document.accessors[primitive.position]
            val indices = if (primitive.indices >= 0)
                document.accessors[primitive.indices].count
                else positions.count
            valid = positions.count > 0 && indices > 0 &&
                positions.count <= 16777216 - vertexCount &&
                indices <= 16777216 - indexCount
            if (valid) {
                vertexBases.append(vertexCount)
                resourceIndexCounts.append(indices)
                resourceIndexOffsets.append(indexCount * 4)
                vertexCount = vertexCount + positions.count
                indexCount = indexCount + indices
            }
        }
        resourceIndex = resourceIndex + 1
    }
    val vertices = bufferBytes(if (valid) vertexCount * 48 else 0)
    valid = valid && vertices.valid()
    GltfTexturedSceneUpdateCache(
        move(accessors), move(vertices), vertexBases,
        resourceIndexCounts, resourceIndexOffsets, vertexCount, valid,
        if (valid) "" else "glTF animated scene cache creation failed"
    )
}

trusted fun gltfAccessorComponentF64(
    bytes: BufferBytes,
    accessor: GltfAccessor,
    element: int,
    component: int
): f64 {
    if (!bytes.valid() || element < 0 || element >= accessor.count ||
        component < 0 || component >= accessor.componentCount()) return 0.0
    val size = accessor.componentByteSize()
    val offset = element * accessor.elementByteSize() + component * size
    if (accessor.componentType == gltfComponentF32) bytes.loadF32(offset)
    else {
        val value = gltfLoadUnsignedBuffer(bytes, offset, size)
        if (accessor.normalized)
            f64FromInt(value) / if (size == 1) 255.0 else 65535.0
        else f64FromInt(value)
    }
}

trusted fun gltfAccessorMat4(
    bytes: BufferBytes,
    element: int
): Mat4 {
    val offset = element * 64
    Mat4(
        bytes.loadF32(offset), bytes.loadF32(offset + 16),
        bytes.loadF32(offset + 32), bytes.loadF32(offset + 48),
        bytes.loadF32(offset + 4), bytes.loadF32(offset + 20),
        bytes.loadF32(offset + 36), bytes.loadF32(offset + 52),
        bytes.loadF32(offset + 8), bytes.loadF32(offset + 24),
        bytes.loadF32(offset + 40), bytes.loadF32(offset + 56),
        bytes.loadF32(offset + 12), bytes.loadF32(offset + 28),
        bytes.loadF32(offset + 44), bytes.loadF32(offset + 60)
    )
}

trusted fun gltfAddWeightedVec3(
    var destination: BufferBytes,
    vertexBase: int,
    vertexCount: int,
    componentOffset: int,
    source: BufferBytes,
    accessor: GltfAccessor,
    weight: f64
): bool {
    var valid = destination.valid() && source.valid() &&
        vertexBase >= 0 && vertexCount == accessor.count &&
        componentOffset >= 0 && componentOffset <= 36 &&
        accessor.componentType == gltfComponentF32 &&
        accessor.elementType == "VEC3" && !accessor.normalized
    var vertex = 0
    while (valid && vertex < vertexCount) {
        var component = 0
        while (valid && component < 3) {
            val destinationOffset = (vertexBase + vertex) * 48 +
                componentOffset + component * 4
            valid = destination.storeF32(
                destination.loadF32(destinationOffset) +
                    source.loadF32(vertex * 12 + component * 4) * weight,
                destinationOffset
            )
            component = component + 1
        }
        vertex = vertex + 1
    }
    valid
}

trusted fun gltfBakeSkinDecoded(
    document: GltfDocument,
    drawList: GltfSceneDrawList,
    state: GltfDeformationState,
    nodeIndex: int,
    primitive: GltfPrimitive,
    inverseBindBytes: BufferBytes,
    jointBytes: BufferBytes,
    weightBytes: BufferBytes,
    var vertices: BufferBytes,
    vertexBase: int,
    vertexCount: int
): bool {
    val node = document.nodes[nodeIndex]
    if (node.skin < 0) return true
    val skin = document.skins[node.skin]
    var meshWorld = drawList.nodeWorldTransforms[nodeIndex]
    if (state.valid) meshWorld = state.worldTransforms[nodeIndex]
    val inverseMesh = mat4AffineInverse(meshWorld)
    val matrices: array<Mat4> = []
    var valid = vertices.valid() && inverseMesh.valid &&
        primitive.joints0 >= 0 && primitive.weights0 >= 0 &&
        drawList.nodeWorldTransforms.size == document.nodes.size &&
        drawList.nodeWorldAvailable.size == document.nodes.size &&
        drawList.nodeWorldAvailable[nodeIndex] &&
        (skin.inverseBindMatrices < 0 || inverseBindBytes.valid())
    var joint = 0
    while (valid && joint < skin.joints.size) {
        val jointNode = skin.joints[joint]
        valid = drawList.nodeWorldAvailable[jointNode]
        if (valid) {
            val inverseBind = if (skin.inverseBindMatrices >= 0)
                gltfAccessorMat4(inverseBindBytes, joint)
                else mat4Identity()
            var jointWorld = drawList.nodeWorldTransforms[jointNode]
            if (state.valid) jointWorld = state.worldTransforms[jointNode]
            matrices.append(inverseMesh.value.multiplied(jointWorld).multiplied(
                inverseBind
            ))
        }
        joint = joint + 1
    }
    val jointAccessor = document.accessors[primitive.joints0]
    val weightAccessor = document.accessors[primitive.weights0]
    valid = valid && jointBytes.valid() && weightBytes.valid() &&
        jointAccessor.count == vertexCount && weightAccessor.count == vertexCount
    var vertex = 0
    while (valid && vertex < vertexCount) {
        val offset = (vertexBase + vertex) * 48
        val position = Vec3(
            vertices.loadF32(offset), vertices.loadF32(offset + 4),
            vertices.loadF32(offset + 8)
        )
        val normal = Vec3(
            vertices.loadF32(offset + 20), vertices.loadF32(offset + 24),
            vertices.loadF32(offset + 28)
        )
        val tangent = Vec3(
            vertices.loadF32(offset + 32), vertices.loadF32(offset + 36),
            vertices.loadF32(offset + 40)
        )
        var px = 0.0
        var py = 0.0
        var pz = 0.0
        var nx = 0.0
        var ny = 0.0
        var nz = 0.0
        var tx = 0.0
        var ty = 0.0
        var tz = 0.0
        var total = 0.0
        var influence = 0
        while (valid && influence < 4) {
            val jointIndex = gltfLoadUnsignedBuffer(
                jointBytes,
                vertex * jointAccessor.elementByteSize() +
                    influence * jointAccessor.componentByteSize(),
                jointAccessor.componentByteSize()
            )
            val weight = gltfAccessorComponentF64(
                weightBytes, weightAccessor, vertex, influence
            )
            valid = jointIndex >= 0 && jointIndex < matrices.size &&
                weight >= 0.0 && weight <= 1.0
            if (valid && weight > 0.0) {
                val transformedPosition = matrices[jointIndex].transformPoint(
                    position
                )
                val transformedNormal = matrices[jointIndex].transformDirection(
                    normal
                )
                val transformedTangent = matrices[jointIndex].transformDirection(
                    tangent
                )
                px = px + transformedPosition.x * weight
                py = py + transformedPosition.y * weight
                pz = pz + transformedPosition.z * weight
                nx = nx + transformedNormal.x * weight
                ny = ny + transformedNormal.y * weight
                nz = nz + transformedNormal.z * weight
                tx = tx + transformedTangent.x * weight
                ty = ty + transformedTangent.y * weight
                tz = tz + transformedTangent.z * weight
                total = total + weight
            }
            influence = influence + 1
        }
        valid = valid && total >= 0.99 && total <= 1.01
        if (valid) {
            val scale = 1.0 / total
            valid = vertices.storeF32(px * scale, offset) &&
                vertices.storeF32(py * scale, offset + 4) &&
                vertices.storeF32(pz * scale, offset + 8) &&
                vertices.storeF32(nx * scale, offset + 20) &&
                vertices.storeF32(ny * scale, offset + 24) &&
                vertices.storeF32(nz * scale, offset + 28) &&
                vertices.storeF32(tx * scale, offset + 32) &&
                vertices.storeF32(ty * scale, offset + 36) &&
                vertices.storeF32(tz * scale, offset + 40)
        }
        vertex = vertex + 1
    }
    valid
}

trusted fun gltfBakeSkin(
    document: GltfDocument,
    payloads: GltfBufferPayloads,
    drawList: GltfSceneDrawList,
    state: GltfDeformationState,
    nodeIndex: int,
    primitive: GltfPrimitive,
    var vertices: BufferBytes,
    vertexBase: int,
    vertexCount: int
): bool {
    val node = document.nodes[nodeIndex]
    if (node.skin < 0) return true
    val skin = document.skins[node.skin]
    val inverseBindBytes = if (skin.inverseBindMatrices >= 0)
        gltfAccessorBytes(document, payloads, skin.inverseBindMatrices)
        else bufferBytes(0)
    val jointBytes = gltfAccessorBytes(document, payloads, primitive.joints0)
    val weightBytes = gltfAccessorBytes(document, payloads, primitive.weights0)
    gltfBakeSkinDecoded(
        document, drawList, state, nodeIndex, primitive,
        inverseBindBytes, jointBytes, weightBytes,
        vertices, vertexBase, vertexCount
    )
}

trusted fun gltfBakeSkinCached(
    document: GltfDocument,
    cache: GltfAccessorCache,
    drawList: GltfSceneDrawList,
    state: GltfDeformationState,
    nodeIndex: int,
    primitive: GltfPrimitive,
    var vertices: BufferBytes,
    vertexBase: int,
    vertexCount: int
): bool {
    val node = document.nodes[nodeIndex]
    if (node.skin < 0) return true
    val skin = document.skins[node.skin]
    val inverseBindIndex = if (skin.inverseBindMatrices >= 0)
        skin.inverseBindMatrices else primitive.joints0
    gltfBakeSkinDecoded(
        document, drawList, state, nodeIndex, primitive,
        cache.values[inverseBindIndex], cache.values[primitive.joints0],
        cache.values[primitive.weights0], vertices, vertexBase, vertexCount
    )
}

trusted fun GraphicsApplication.gltfGpuPrimitive(
    document: GltfDocument,
    payloads: GltfBufferPayloads,
    meshIndex: int,
    primitiveIndex: int
): GltfGpuPrimitive {
    var error = ""
    var vertexCount = 0
    var indexCount = 0
    var vertexBytes = bufferBytes(0)
    var indexBytes = bufferBytes(0)
    if (!this.valid() || !document.valid() || !payloads.valid ||
        meshIndex < 0 || meshIndex >= document.meshes.size ||
        primitiveIndex < 0 ||
        primitiveIndex >= document.meshes[meshIndex].primitives.size) {
        error = "invalid glTF primitive materialization request"
    } else {
        val primitive = document.meshes[meshIndex].primitives[primitiveIndex]
        val position = document.accessors[primitive.position]
        vertexCount = position.count
        vertexBytes = gltfAccessorBytes(document, payloads, primitive.position)
        if (primitive.indices >= 0) {
            val source = gltfAccessorBytes(document, payloads, primitive.indices)
            val accessor = document.accessors[primitive.indices]
            val sourceSize = accessor.componentByteSize()
            indexCount = accessor.count
            indexBytes = bufferBytes(indexCount * 4)
            var index = 0
            var stored = source.valid() && indexBytes.valid()
            while (stored && index < indexCount) {
                stored = indexBytes.storeU32(
                    gltfLoadUnsignedBuffer(source, index * sourceSize, sourceSize),
                    index * 4
                )
                index = index + 1
            }
            if (!stored) error = "glTF index accessor decoding failed"
        } else {
            indexCount = vertexCount
            indexBytes = bufferBytes(indexCount * 4)
            var index = 0
            var stored = indexBytes.valid()
            while (stored && index < indexCount) {
                stored = indexBytes.storeU32(index, index * 4)
                index = index + 1
            }
            if (!stored) error = "glTF generated index decoding failed"
        }
        if (!vertexBytes.valid()) error = "glTF position accessor decoding failed"
    }
    val vertices = this.buffer(BufferDescriptor(
        label = "gltf-positions",
        size = if (vertexBytes.valid()) vertexBytes.size else 0,
        usage = bufferUsageVertex | bufferUsageCopyDestination
    ))
    val indices = this.buffer(BufferDescriptor(
        label = "gltf-indices",
        size = if (indexBytes.valid()) indexBytes.size else 0,
        usage = bufferUsageIndex | bufferUsageCopyDestination
    ))
    if (error.size == 0 &&
        (!vertices.writeAllBytes(vertexBytes) || !indices.writeAllBytes(indexBytes)))
        error = "glTF GPU buffer upload failed"
    GltfGpuPrimitive(
        move(vertices), move(indices), vertexCount, indexCount, error
    )
}

// The compact textured path expands glTF's FLOAT or normalized unsigned UVs
// once at setup into a retained 20-byte position/UV vertex stream.
trusted fun GraphicsApplication.gltfGpuTexturedPrimitive(
    document: GltfDocument,
    payloads: GltfBufferPayloads,
    meshIndex: int,
    primitiveIndex: int
): GltfGpuTexturedPrimitive {
    val layout = VertexBufferLayout(20, [
        VertexAttribute(0, 0, vertexFormatFloat32x3),
        VertexAttribute(1, 12, vertexFormatFloat32x2)
    ])
    var error = ""
    var vertexCount = 0
    var indexCount = 0
    var vertexBytes = bufferBytes(0)
    var indexBytes = bufferBytes(0)
    if (!this.valid() || !document.valid() || !payloads.valid ||
        meshIndex < 0 || meshIndex >= document.meshes.size ||
        primitiveIndex < 0 ||
        primitiveIndex >= document.meshes[meshIndex].primitives.size) {
        error = "invalid textured glTF primitive materialization request"
    } else {
        val primitive = document.meshes[meshIndex].primitives[primitiveIndex]
        if (primitive.texCoord0 < 0) {
            error = "textured glTF primitive requires TEXCOORD_0"
        } else {
            val position = document.accessors[primitive.position]
            val texCoord = document.accessors[primitive.texCoord0]
            vertexCount = position.count
            if (position.componentType != gltfComponentF32 ||
                position.elementType != "VEC3" ||
                position.normalized ||
                !gltfTextureCoordinateAccessorSupported(texCoord) ||
                texCoord.count != vertexCount) {
                error = "textured glTF primitive requires FLOAT VEC3 positions and supported VEC2 UVs"
            } else {
                val positions = gltfAccessorBytes(
                    document, payloads, primitive.position
                )
                val coordinates = gltfAccessorBytes(
                    document, payloads, primitive.texCoord0
                )
                vertexBytes = bufferBytes(vertexCount * 20)
                var vertex = 0
                var stored = positions.valid() && coordinates.valid() &&
                    vertexBytes.valid()
                while (stored && vertex < vertexCount) {
                    var byteIndex = 0
                    while (stored && byteIndex < 12) {
                        stored = vertexBytes.store(
                            vertex * 20 + byteIndex,
                            positions.load(vertex * 12 + byteIndex)
                        )
                        byteIndex = byteIndex + 1
                    }
                    if (stored) stored = gltfStoreAccessorElementF32(
                        vertexBytes, vertex * 20 + 12,
                        coordinates, texCoord, vertex, 2
                    )
                    vertex = vertex + 1
                }
                if (!stored) error = "textured glTF vertex interleave failed"
            }
            if (primitive.indices >= 0) {
                val source = gltfAccessorBytes(
                    document, payloads, primitive.indices
                )
                val accessor = document.accessors[primitive.indices]
                val sourceSize = accessor.componentByteSize()
                indexCount = accessor.count
                indexBytes = bufferBytes(indexCount * 4)
                var index = 0
                var stored = source.valid() && indexBytes.valid()
                while (stored && index < indexCount) {
                    stored = indexBytes.storeU32(
                        gltfLoadUnsignedBuffer(
                            source, index * sourceSize, sourceSize
                        ),
                        index * 4
                    )
                    index = index + 1
                }
                if (!stored) error = "glTF index accessor decoding failed"
            } else {
                indexCount = vertexCount
                indexBytes = bufferBytes(indexCount * 4)
                var index = 0
                var stored = indexBytes.valid()
                while (stored && index < indexCount) {
                    stored = indexBytes.storeU32(index, index * 4)
                    index = index + 1
                }
                if (!stored) error = "glTF generated index decoding failed"
            }
        }
    }
    val vertices = this.buffer(BufferDescriptor(
        label = "gltf-position-uv",
        size = if (vertexBytes.valid()) vertexBytes.size else 0,
        usage = bufferUsageVertex | bufferUsageCopyDestination
    ))
    val indices = this.buffer(BufferDescriptor(
        label = "gltf-indices",
        size = if (indexBytes.valid()) indexBytes.size else 0,
        usage = bufferUsageIndex | bufferUsageCopyDestination
    ))
    if (error.size == 0 &&
        (!vertices.writeAllBytes(vertexBytes) ||
         !indices.writeAllBytes(indexBytes)))
        error = "textured glTF GPU buffer upload failed"
    GltfGpuTexturedPrimitive(
        move(vertices), move(indices), vertexCount, indexCount, layout, error
    )
}

// Packs every unique accessor-identity resource once. The fixed surface vertex
// contains position, expanded UV, normal, and tangent; absent directions use
// glTF-safe defaults. Indices become absolute packed vertices.
trusted fun gltfPackedTexturedScene(
    document: GltfDocument,
    payloads: GltfBufferPayloads,
    drawList: GltfSceneDrawList,
    plan: GltfSceneResourcePlan,
    state: GltfDeformationState = GltfDeformationState()
): GltfPackedTexturedScene {
    val layout = VertexBufferLayout(48, [
        VertexAttribute(0, 0, vertexFormatFloat32x3),
        VertexAttribute(1, 12, vertexFormatFloat32x2),
        VertexAttribute(2, 20, vertexFormatFloat32x3),
        VertexAttribute(3, 32, vertexFormatFloat32x4)
    ])
    val vertexBases: array<int> = []
    val resourceIndexOffsets: array<int> = []
    val resourceIndexCounts: array<int> = []
    var vertexCount = 0
    var indexCount = 0
    var valid = document.valid() && payloads.valid &&
        drawList.valid && plan.valid &&
        state.compatible(document.nodes.size) &&
        plan.meshIndices.size == plan.primitiveIndices.size &&
        plan.meshIndices.size == plan.resourceNodes.size &&
        plan.drawableResources.size == drawList.drawables.size &&
        plan.meshIndices.size > 0
    var drawableValidation = 0
    while (valid && drawableValidation < drawList.drawables.size) {
        val resourceId = plan.drawableResources[drawableValidation]
        valid = resourceId >= 0 && resourceId < plan.resourceNodes.size
        if (valid) {
            val drawable = drawList.drawables[drawableValidation]
            val primitive = document.meshes[drawable.mesh].primitives[
                drawable.primitive
            ]
            valid = (primitive.targets.size == 0 &&
                document.nodes[drawable.node].skin < 0) ||
                plan.resourceNodes[resourceId] == drawable.node
            if (valid && state.valid && primitive.targets.size > 0)
                valid = state.nodeWeightCounts[drawable.node] ==
                    primitive.targets.size
        }
        drawableValidation = drawableValidation + 1
    }
    var resourceIndex = 0
    while (valid && resourceIndex < plan.meshIndices.size) {
        val meshIndex = plan.meshIndices[resourceIndex]
        val primitiveIndex = plan.primitiveIndices[resourceIndex]
        valid = meshIndex >= 0 && meshIndex < document.meshes.size &&
            primitiveIndex >= 0 &&
            primitiveIndex < document.meshes[meshIndex].primitives.size
        if (valid) {
            val primitive = document.meshes[meshIndex].primitives[
                primitiveIndex
            ]
            valid = primitive.texCoord0 >= 0
            if (valid) {
                val position = document.accessors[primitive.position]
                val texCoord = document.accessors[primitive.texCoord0]
                val normal = if (primitive.normal >= 0)
                    document.accessors[primitive.normal] else GltfAccessor()
                val tangent = if (primitive.tangent >= 0)
                    document.accessors[primitive.tangent] else GltfAccessor()
                val primitiveIndexCount = if (primitive.indices >= 0)
                    document.accessors[primitive.indices].count
                    else position.count
                valid = position.componentType == gltfComponentF32 &&
                    position.elementType == "VEC3" && !position.normalized &&
                    gltfTextureCoordinateAccessorSupported(texCoord) &&
                    texCoord.count == position.count &&
                    (primitive.normal < 0 ||
                     (normal.componentType == gltfComponentF32 &&
                      normal.elementType == "VEC3" && !normal.normalized &&
                      normal.count == position.count)) &&
                    (primitive.tangent < 0 ||
                     (tangent.componentType == gltfComponentF32 &&
                      tangent.elementType == "VEC4" && !tangent.normalized &&
                      tangent.count == position.count)) &&
                    position.count <= 16777216 - vertexCount &&
                    primitiveIndexCount <= 16777216 - indexCount
                if (valid) {
                    vertexBases.append(vertexCount)
                    resourceIndexOffsets.append(indexCount * 4)
                    resourceIndexCounts.append(primitiveIndexCount)
                    vertexCount = vertexCount + position.count
                    indexCount = indexCount + primitiveIndexCount
                }
            }
        }
        resourceIndex = resourceIndex + 1
    }
    val vertexBytes = bufferBytes(if (valid) vertexCount * 48 else 0)
    val indexBytes = bufferBytes(if (valid) indexCount * 4 else 0)
    resourceIndex = 0
    while (valid && resourceIndex < plan.meshIndices.size) {
        val primitive = document.meshes[plan.meshIndices[resourceIndex]].primitives[
            plan.primitiveIndices[resourceIndex]
        ]
        val position = document.accessors[primitive.position]
        val positions = gltfAccessorBytes(
            document, payloads, primitive.position
        )
        val coordinates = gltfAccessorBytes(
            document, payloads, primitive.texCoord0
        )
        val normals = if (primitive.normal >= 0) gltfAccessorBytes(
            document, payloads, primitive.normal
        ) else bufferBytes(0)
        val tangents = if (primitive.tangent >= 0) gltfAccessorBytes(
            document, payloads, primitive.tangent
        ) else bufferBytes(0)
        val vertexBase = vertexBases[resourceIndex]
        var vertex = 0
        valid = positions.valid() && coordinates.valid() &&
            (primitive.normal < 0 || normals.valid()) &&
            (primitive.tangent < 0 || tangents.valid()) &&
            vertexBytes.valid() && indexBytes.valid()
        while (valid && vertex < position.count) {
            var byteIndex = 0
            while (valid && byteIndex < 12) {
                valid = vertexBytes.store(
                    (vertexBase + vertex) * 48 + byteIndex,
                    positions.load(vertex * 12 + byteIndex)
                )
                byteIndex = byteIndex + 1
            }
            val destinationOffset = (vertexBase + vertex) * 48
            if (valid) valid = gltfStoreAccessorElementF32(
                vertexBytes, destinationOffset + 12,
                coordinates, document.accessors[primitive.texCoord0],
                vertex, 2
            )
            if (valid) valid = if (primitive.normal >= 0)
                gltfStoreAccessorElementF32(
                    vertexBytes, destinationOffset + 20,
                    normals, document.accessors[primitive.normal], vertex, 3
                )
                else gltfStoreDefaultSurfaceDirection(
                    vertexBytes, destinationOffset + 20, false
                )
            if (valid) valid = if (primitive.tangent >= 0)
                gltfStoreAccessorElementF32(
                    vertexBytes, destinationOffset + 32,
                    tangents, document.accessors[primitive.tangent], vertex, 4
                )
                else gltfStoreDefaultSurfaceDirection(
                    vertexBytes, destinationOffset + 32, true
                )
            vertex = vertex + 1
        }
        val nodeIndex = plan.resourceNodes[resourceIndex]
        val mesh = document.meshes[plan.meshIndices[resourceIndex]]
        val node = document.nodes[nodeIndex]
        var targetIndex = 0
        while (valid && targetIndex < primitive.targets.size) {
            val target = primitive.targets[targetIndex]
            var weight = 0.0
            if (state.valid)
                weight = state.weights[
                    state.nodeWeightOffsets[nodeIndex] + targetIndex
                ]
            else if (node.weights.size > 0) weight = node.weights[targetIndex]
            else if (mesh.weights.size > 0) weight = mesh.weights[targetIndex]
            if (weight != 0.0 && target.position >= 0) {
                val accessor = document.accessors[target.position]
                val deltas = gltfAccessorBytes(
                    document, payloads, target.position
                )
                valid = gltfAddWeightedVec3(
                    vertexBytes, vertexBase, position.count, 0,
                    deltas, accessor, weight
                )
            }
            if (valid && weight != 0.0 && target.normal >= 0) {
                val accessor = document.accessors[target.normal]
                val deltas = gltfAccessorBytes(
                    document, payloads, target.normal
                )
                valid = gltfAddWeightedVec3(
                    vertexBytes, vertexBase, position.count, 20,
                    deltas, accessor, weight
                )
            }
            if (valid && weight != 0.0 && target.tangent >= 0) {
                val accessor = document.accessors[target.tangent]
                val deltas = gltfAccessorBytes(
                    document, payloads, target.tangent
                )
                valid = gltfAddWeightedVec3(
                    vertexBytes, vertexBase, position.count, 32,
                    deltas, accessor, weight
                )
            }
            targetIndex = targetIndex + 1
        }
        if (valid) valid = gltfBakeSkin(
            document, payloads, drawList, state, nodeIndex, primitive,
            vertexBytes, vertexBase, position.count
        )
        val outputIndexOffset = resourceIndexOffsets[resourceIndex]
        if (valid && primitive.indices >= 0) {
            val source = gltfAccessorBytes(
                document, payloads, primitive.indices
            )
            val accessor = document.accessors[primitive.indices]
            val sourceSize = accessor.componentByteSize()
            var index = 0
            valid = source.valid()
            while (valid && index < accessor.count) {
                val value = gltfLoadUnsignedBuffer(
                    source, index * sourceSize, sourceSize
                )
                valid = value >= 0 && value < position.count &&
                    indexBytes.storeU32(
                        vertexBase + value,
                        outputIndexOffset + index * 4
                    )
                index = index + 1
            }
        } else if (valid) {
            var index = 0
            while (valid && index < position.count) {
                valid = indexBytes.storeU32(
                    vertexBase + index,
                    outputIndexOffset + index * 4
                )
                index = index + 1
            }
        }
        resourceIndex = resourceIndex + 1
    }
    val drawIndexCounts: array<int> = []
    val drawIndexOffsets: array<int> = []
    var drawIndex = 0
    while (valid && drawIndex < plan.drawableResources.size) {
        val resourceId = plan.drawableResources[drawIndex]
        valid = resourceId >= 0 && resourceId < resourceIndexCounts.size
        if (valid) {
            drawIndexCounts.append(resourceIndexCounts[resourceId])
            drawIndexOffsets.append(resourceIndexOffsets[resourceId])
        }
        drawIndex = drawIndex + 1
    }
    GltfPackedTexturedScene(
        move(vertexBytes), move(indexBytes), vertexCount, indexCount,
        drawIndexCounts, drawIndexOffsets, layout,
        if (valid) "" else "glTF textured scene packing failed"
    )
}

trusted fun GraphicsApplication.gltfGpuTexturedScene(
    document: GltfDocument,
    payloads: GltfBufferPayloads,
    drawList: GltfSceneDrawList,
    plan: GltfSceneResourcePlan,
    state: GltfDeformationState = GltfDeformationState()
): GltfGpuTexturedScene {
    val packed = gltfPackedTexturedScene(
        document, payloads, drawList, plan, state
    )
    var valid = this.valid() && packed.valid()
    val vertices = this.buffer(BufferDescriptor(
        label = "gltf-scene-position-uv",
        size = if (valid) packed.vertices.size else 0,
        usage = bufferUsageVertex | bufferUsageCopyDestination
    ))
    val indices = this.buffer(BufferDescriptor(
        label = "gltf-scene-indices",
        size = if (valid) packed.indices.size else 0,
        usage = bufferUsageIndex | bufferUsageCopyDestination
    ))
    if (valid) valid = vertices.writeAllBytes(packed.vertices) &&
        indices.writeAllBytes(packed.indices)
    GltfGpuTexturedScene(
        move(vertices), move(indices), packed.vertexCount, packed.indexCount,
        packed.drawIndexCounts, packed.drawIndexOffsets, packed.layout,
        if (valid) "" else "glTF textured scene packing or upload failed"
    )
}

// Rebuilds deformed vertex contents while preserving both GPU objects and all
// retained draw ranges. Animation cannot silently change scene topology.
trusted fun GltfGpuTexturedScene.refreshDeformation(
    document: GltfDocument,
    payloads: GltfBufferPayloads,
    drawList: GltfSceneDrawList,
    plan: GltfSceneResourcePlan,
    state: GltfDeformationState
): bool {
    val packed = gltfPackedTexturedScene(
        document, payloads, drawList, plan, state
    )
    var valid = this.valid() && packed.valid() && state.valid &&
        packed.vertexCount == this.vertexCount &&
        packed.indexCount == this.indexCount &&
        packed.layout.stride == this.layout.stride &&
        packed.drawIndexCounts.size == this.drawIndexCounts.size &&
        packed.drawIndexOffsets.size == this.drawIndexOffsets.size
    var draw = 0
    while (valid && draw < this.drawIndexCounts.size) {
        valid = packed.drawIndexCounts[draw] == this.drawIndexCounts[draw] &&
            packed.drawIndexOffsets[draw] == this.drawIndexOffsets[draw]
        draw = draw + 1
    }
    valid && this.vertices.writeAllBytes(packed.vertices)
}

trusted fun gltfRepackTexturedSceneVerticesCached(
    document: GltfDocument,
    drawList: GltfSceneDrawList,
    plan: GltfSceneResourcePlan,
    state: GltfDeformationState,
    var cache: GltfTexturedSceneUpdateCache
): bool {
    var valid = document.valid() && drawList.valid && plan.valid &&
        state.valid && state.compatible(document.nodes.size) && cache.valid &&
        cache.accessors.values.size == document.accessors.size &&
        cache.vertexBases.size == plan.meshIndices.size &&
        cache.resourceIndexCounts.size == plan.meshIndices.size &&
        cache.resourceIndexOffsets.size == plan.meshIndices.size &&
        cache.vertices.size == cache.vertexCount * 48 &&
        plan.meshIndices.size == plan.primitiveIndices.size &&
        plan.meshIndices.size == plan.resourceNodes.size &&
        plan.drawableResources.size == drawList.drawables.size
    var drawable = 0
    while (valid && drawable < drawList.drawables.size) {
        val resourceIndex = plan.drawableResources[drawable]
        valid = resourceIndex >= 0 &&
            resourceIndex < plan.resourceNodes.size
        if (valid) {
            val draw = drawList.drawables[drawable]
            val primitive = document.meshes[draw.mesh].primitives[draw.primitive]
            valid = ((primitive.targets.size == 0 &&
                document.nodes[draw.node].skin < 0) ||
                plan.resourceNodes[resourceIndex] == draw.node) &&
                (primitive.targets.size == 0 ||
                 state.nodeWeightCounts[draw.node] == primitive.targets.size)
        }
        drawable = drawable + 1
    }
    var resourceIndex = 0
    while (valid && resourceIndex < plan.meshIndices.size) {
        val primitive = document.meshes[
            plan.meshIndices[resourceIndex]
        ].primitives[
            plan.primitiveIndices[resourceIndex]
        ]
        val position = document.accessors[primitive.position]
        val coordinateIndex = if (primitive.texCoord0 >= 0 &&
            primitive.texCoord0 < document.accessors.size)
            primitive.texCoord0 else primitive.position
        val coordinateAccessor = document.accessors[coordinateIndex]
        val positions = cache.accessors.values[primitive.position]
        val coordinates = cache.accessors.values[coordinateIndex]
        val vertexBase = cache.vertexBases[resourceIndex]
        valid = primitive.texCoord0 >= 0 &&
            position.componentType == gltfComponentF32 &&
            position.elementType == "VEC3" && !position.normalized &&
            gltfTextureCoordinateAccessorSupported(coordinateAccessor) &&
            coordinateAccessor.count == position.count &&
            positions.valid() && coordinates.valid() &&
            vertexBase >= 0 && vertexBase <= cache.vertexCount &&
            position.count <= cache.vertexCount - vertexBase
        if (valid && primitive.normal >= 0) {
            val normalAccessor = document.accessors[primitive.normal]
            valid = normalAccessor.componentType == gltfComponentF32 &&
                normalAccessor.elementType == "VEC3" &&
                !normalAccessor.normalized &&
                normalAccessor.count == position.count &&
                cache.accessors.values[primitive.normal].valid()
        }
        if (valid && primitive.tangent >= 0) {
            val tangentAccessor = document.accessors[primitive.tangent]
            valid = tangentAccessor.componentType == gltfComponentF32 &&
                tangentAccessor.elementType == "VEC4" &&
                !tangentAccessor.normalized &&
                tangentAccessor.count == position.count &&
                cache.accessors.values[primitive.tangent].valid()
        }
        var vertex = 0
        while (valid && vertex < position.count) {
            val destinationOffset = (vertexBase + vertex) * 48
            var byteIndex = 0
            while (valid && byteIndex < 12) {
                valid = cache.vertices.store(
                    destinationOffset + byteIndex,
                    positions.load(vertex * 12 + byteIndex)
                )
                byteIndex = byteIndex + 1
            }
            if (valid) valid = gltfStoreAccessorElementF32(
                cache.vertices, destinationOffset + 12,
                coordinates, coordinateAccessor, vertex, 2
            )
            if (valid && primitive.normal >= 0)
                valid = gltfStoreAccessorElementF32(
                    cache.vertices, destinationOffset + 20,
                    cache.accessors.values[primitive.normal],
                    document.accessors[primitive.normal], vertex, 3
                )
            else if (valid) valid = gltfStoreDefaultSurfaceDirection(
                cache.vertices, destinationOffset + 20, false
            )
            if (valid && primitive.tangent >= 0)
                valid = gltfStoreAccessorElementF32(
                    cache.vertices, destinationOffset + 32,
                    cache.accessors.values[primitive.tangent],
                    document.accessors[primitive.tangent], vertex, 4
                )
            else if (valid) valid = gltfStoreDefaultSurfaceDirection(
                cache.vertices, destinationOffset + 32, true
            )
            vertex = vertex + 1
        }
        val nodeIndex = plan.resourceNodes[resourceIndex]
        var targetIndex = 0
        while (valid && targetIndex < primitive.targets.size) {
            val target = primitive.targets[targetIndex]
            val weight = state.weights[
                state.nodeWeightOffsets[nodeIndex] + targetIndex
            ]
            if (weight != 0.0 && target.position >= 0)
                valid = gltfAddWeightedVec3(
                    cache.vertices, vertexBase, position.count, 0,
                    cache.accessors.values[target.position],
                    document.accessors[target.position], weight
                )
            if (valid && weight != 0.0 && target.normal >= 0)
                valid = gltfAddWeightedVec3(
                    cache.vertices, vertexBase, position.count, 20,
                    cache.accessors.values[target.normal],
                    document.accessors[target.normal], weight
                )
            if (valid && weight != 0.0 && target.tangent >= 0)
                valid = gltfAddWeightedVec3(
                    cache.vertices, vertexBase, position.count, 32,
                    cache.accessors.values[target.tangent],
                    document.accessors[target.tangent], weight
                )
            targetIndex = targetIndex + 1
        }
        if (valid) valid = gltfBakeSkinCached(
            document, cache.accessors, drawList, state, nodeIndex, primitive,
            cache.vertices, vertexBase, position.count
        )
        resourceIndex = resourceIndex + 1
    }
    valid
}

// Cached animation refresh performs no accessor decoding, index repacking, or
// vertex-scratch allocation. The caller retains one cache beside the scene.
trusted fun GltfGpuTexturedScene.refreshDeformationCached(
    document: GltfDocument,
    drawList: GltfSceneDrawList,
    plan: GltfSceneResourcePlan,
    state: GltfDeformationState,
    var cache: GltfTexturedSceneUpdateCache
): bool {
    var valid = this.valid() && cache.valid && state.valid &&
        cache.vertexCount == this.vertexCount &&
        this.layout.stride == 48 &&
        plan.drawableResources.size == this.drawIndexCounts.size &&
        cache.resourceIndexCounts.size == plan.meshIndices.size &&
        cache.resourceIndexOffsets.size == plan.meshIndices.size
    var draw = 0
    while (valid && draw < this.drawIndexCounts.size) {
        val resourceIndex = plan.drawableResources[draw]
        valid = resourceIndex >= 0 &&
            resourceIndex < cache.resourceIndexCounts.size &&
            this.drawIndexCounts[draw] ==
                cache.resourceIndexCounts[resourceIndex] &&
            this.drawIndexOffsets[draw] ==
                cache.resourceIndexOffsets[resourceIndex]
        draw = draw + 1
    }
    if (valid) valid = gltfRepackTexturedSceneVerticesCached(
        document, drawList, plan, state, cache
    )
    valid && this.vertices.writeAllBytes(cache.vertices)
}
