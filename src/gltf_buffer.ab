// Pure-Abla glTF buffer acquisition, accessor decoding, and GPU materialization.

import "abla/crypto"
import "buffer.ab"
import "gltf_scene.ab"

class GltfBufferPayloads(
    val values: array<string>,
    val valid: bool,
    val error: string
)

resource class GltfGpuPrimitive(
    val vertices: GraphicsBuffer,
    val indices: GraphicsBuffer,
    val vertexCount: int,
    val indexCount: int,
    val error: string
) {
    fun valid(): bool = this.error.size == 0 && this.vertices.valid() &&
        this.indices.valid() && this.vertexCount > 0 && this.indexCount > 0

    trusted fun drop(): void {
        this.vertices.drop()
        this.indices.drop()
        return
    }
}

resource class GltfGpuTexturedPrimitive(
    val vertices: GraphicsBuffer,
    val indices: GraphicsBuffer,
    val vertexCount: int,
    val indexCount: int,
    val layout: VertexBufferLayout,
    val error: string
) {
    fun valid(): bool = this.error.size == 0 && this.vertices.valid() &&
        this.indices.valid() && this.vertexCount > 0 && this.indexCount > 0 &&
        this.layout.valid()

    trusted fun drop(): void {
        this.vertices.drop()
        this.indices.drop()
        return
    }
}

resource class GltfGpuTexturedScene(
    val vertices: GraphicsBuffer,
    val indices: GraphicsBuffer,
    val vertexCount: int,
    val indexCount: int,
    val drawIndexCounts: array<int>,
    val drawIndexOffsets: array<int>,
    val layout: VertexBufferLayout,
    val error: string
) {
    fun valid(): bool = this.error == "" && this.vertices.valid() &&
        this.indices.valid() && this.vertexCount > 0 && this.indexCount > 0 &&
        this.drawIndexCounts.size > 0 &&
        this.drawIndexCounts.size == this.drawIndexOffsets.size &&
        this.layout.valid()

    trusted fun drop(): void {
        this.vertices.drop()
        this.indices.drop()
        return
    }
}

fun gltfDataUriPayload(uri: string): string {
    val prefix = "data:application/octet-stream;base64,"
    val generic = "data:application/gltf-buffer;base64,"
    if (uri.size >= prefix.size && uri.slice(0, prefix.size) == prefix)
        base64Decode(uri.slice(prefix.size, uri.size))
    else if (uri.size >= generic.size && uri.slice(0, generic.size) == generic)
        base64Decode(uri.slice(generic.size, uri.size))
    else ""
}

// A caller may supply external/GLB payloads by index. An empty supplied value
// falls back to a base64 data URI; all byte lengths must match the document.
fun gltfBufferPayloads(
    document: GltfDocument,
    supplied: array<string> = []
): GltfBufferPayloads {
    val values: array<string> = []
    var valid = document.valid() &&
        (supplied.size == 0 || supplied.size == document.buffers.size)
    var index = 0
    while (valid && index < document.buffers.size) {
        val external = if (supplied.size == document.buffers.size)
            supplied[index] else ""
        val payload = if (external.size > 0) external
            else gltfDataUriPayload(document.buffers[index].uri)
        valid = payload.size == document.buffers[index].byteLength
        if (valid) values.append(payload)
        index = index + 1
    }
    GltfBufferPayloads(
        values,
        valid,
        if (valid) "" else "glTF buffer payload count or byte length mismatch"
    )
}

fun gltfLoadUnsigned(bytes: string, offset: int, size: int): int =
    if (offset < 0 || offset > bytes.size - size) -1
    else if (size == 1) bytes[offset]
    else if (size == 2) bytes[offset] + bytes[offset + 1] * 256
    else if (size == 4) bytes[offset] + bytes[offset + 1] * 256 +
        bytes[offset + 2] * 65536 + bytes[offset + 3] * 16777216
    else -1

trusted fun gltfLoadUnsignedBuffer(
    bytes: BufferBytes,
    offset: int,
    size: int
): int = if (!bytes.valid() || offset < 0 || offset > bytes.size - size) -1
    else if (size == 1) bytes.load(offset)
    else if (size == 2) bytes.load(offset) + bytes.load(offset + 1) * 256
    else if (size == 4) bytes.load(offset) + bytes.load(offset + 1) * 256 +
        bytes.load(offset + 2) * 65536 + bytes.load(offset + 3) * 16777216
    else -1

trusted fun gltfCopyStringBytes(
    source: string,
    sourceOffset: int,
    var destination: BufferBytes,
    destinationOffset: int,
    size: int
): bool {
    var valid = sourceOffset >= 0 && destinationOffset >= 0 && size >= 0 &&
        sourceOffset <= source.size - size &&
        destinationOffset <= destination.size - size
    var index = 0
    while (valid && index < size) {
        valid = destination.store(
            destinationOffset + index, source[sourceOffset + index]
        )
        index = index + 1
    }
    valid
}

trusted fun gltfAccessorBytes(
    document: GltfDocument,
    payloads: GltfBufferPayloads,
    accessorIndex: int
): BufferBytes {
    if (!document.valid() || !payloads.valid ||
        accessorIndex < 0 || accessorIndex >= document.accessors.size)
        return bufferBytes(0)
    val accessor = document.accessors[accessorIndex]
    val elementSize = accessor.elementByteSize()
    val output = bufferBytes(accessor.count * elementSize)
    var valid = output.valid() && output.fill(0)
    if (valid && accessor.bufferView >= 0) {
        val view = document.bufferViews[accessor.bufferView]
        val payload = payloads.values[view.buffer]
        val stride = if (view.byteStride == 0) elementSize else view.byteStride
        var element = 0
        while (valid && element < accessor.count) {
            valid = gltfCopyStringBytes(
                payload,
                view.byteOffset + accessor.byteOffset + element * stride,
                output,
                element * elementSize,
                elementSize
            )
            element = element + 1
        }
    }
    if (valid && accessor.sparse.present()) {
        val sparse = accessor.sparse
        val indexView = document.bufferViews[sparse.indicesBufferView]
        val valueView = document.bufferViews[sparse.valuesBufferView]
        val indexPayload = payloads.values[indexView.buffer]
        val valuePayload = payloads.values[valueView.buffer]
        val indexSize = gltfComponentByteSize(sparse.indicesComponentType)
        var sparseIndex = 0
        var previous = -1
        while (valid && sparseIndex < sparse.count) {
            val destinationIndex = gltfLoadUnsigned(
                indexPayload,
                indexView.byteOffset + sparse.indicesByteOffset +
                    sparseIndex * indexSize,
                indexSize
            )
            valid = destinationIndex > previous &&
                destinationIndex < accessor.count && gltfCopyStringBytes(
                    valuePayload,
                    valueView.byteOffset + sparse.valuesByteOffset +
                        sparseIndex * elementSize,
                    output,
                    destinationIndex * elementSize,
                    elementSize
                )
            previous = destinationIndex
            sparseIndex = sparseIndex + 1
        }
    }
    if (valid) output else bufferBytes(0)
}

trusted fun GraphicsApplication.gltfGpuPrimitive(
    document: GltfDocument,
    payloads: GltfBufferPayloads,
    meshIndex: int,
    primitiveIndex: int
): GltfGpuPrimitive {
    var error = ""
    var vertexCount = 0
    var indexCount = 0
    var vertexBytes = bufferBytes(0)
    var indexBytes = bufferBytes(0)
    if (!this.valid() || !document.valid() || !payloads.valid ||
        meshIndex < 0 || meshIndex >= document.meshes.size ||
        primitiveIndex < 0 ||
        primitiveIndex >= document.meshes[meshIndex].primitives.size) {
        error = "invalid glTF primitive materialization request"
    } else {
        val primitive = document.meshes[meshIndex].primitives[primitiveIndex]
        val position = document.accessors[primitive.position]
        vertexCount = position.count
        vertexBytes = gltfAccessorBytes(document, payloads, primitive.position)
        if (primitive.indices >= 0) {
            val source = gltfAccessorBytes(document, payloads, primitive.indices)
            val accessor = document.accessors[primitive.indices]
            val sourceSize = accessor.componentByteSize()
            indexCount = accessor.count
            indexBytes = bufferBytes(indexCount * 4)
            var index = 0
            var stored = source.valid() && indexBytes.valid()
            while (stored && index < indexCount) {
                stored = indexBytes.storeU32(
                    gltfLoadUnsignedBuffer(source, index * sourceSize, sourceSize),
                    index * 4
                )
                index = index + 1
            }
            if (!stored) error = "glTF index accessor decoding failed"
        } else {
            indexCount = vertexCount
            indexBytes = bufferBytes(indexCount * 4)
            var index = 0
            var stored = indexBytes.valid()
            while (stored && index < indexCount) {
                stored = indexBytes.storeU32(index, index * 4)
                index = index + 1
            }
            if (!stored) error = "glTF generated index decoding failed"
        }
        if (!vertexBytes.valid()) error = "glTF position accessor decoding failed"
    }
    val vertices = this.buffer(BufferDescriptor(
        label = "gltf-positions",
        size = if (vertexBytes.valid()) vertexBytes.size else 0,
        usage = bufferUsageVertex | bufferUsageCopyDestination
    ))
    val indices = this.buffer(BufferDescriptor(
        label = "gltf-indices",
        size = if (indexBytes.valid()) indexBytes.size else 0,
        usage = bufferUsageIndex | bufferUsageCopyDestination
    ))
    if (error.size == 0 &&
        (!vertices.writeAllBytes(vertexBytes) || !indices.writeAllBytes(indexBytes)))
        error = "glTF GPU buffer upload failed"
    GltfGpuPrimitive(
        move(vertices), move(indices), vertexCount, indexCount, error
    )
}

// The first textured path deliberately accepts the portable core glTF shape:
// FLOAT VEC3 positions plus FLOAT VEC2 TEXCOORD_0, packed once at setup into a
// retained 20-byte position/UV vertex stream. Normalized integer UV expansion
// remains a later format-broadening step.
trusted fun GraphicsApplication.gltfGpuTexturedPrimitive(
    document: GltfDocument,
    payloads: GltfBufferPayloads,
    meshIndex: int,
    primitiveIndex: int
): GltfGpuTexturedPrimitive {
    val layout = VertexBufferLayout(20, [
        VertexAttribute(0, 0, vertexFormatFloat32x3),
        VertexAttribute(1, 12, vertexFormatFloat32x2)
    ])
    var error = ""
    var vertexCount = 0
    var indexCount = 0
    var vertexBytes = bufferBytes(0)
    var indexBytes = bufferBytes(0)
    if (!this.valid() || !document.valid() || !payloads.valid ||
        meshIndex < 0 || meshIndex >= document.meshes.size ||
        primitiveIndex < 0 ||
        primitiveIndex >= document.meshes[meshIndex].primitives.size) {
        error = "invalid textured glTF primitive materialization request"
    } else {
        val primitive = document.meshes[meshIndex].primitives[primitiveIndex]
        if (primitive.texCoord0 < 0) {
            error = "textured glTF primitive requires TEXCOORD_0"
        } else {
            val position = document.accessors[primitive.position]
            val texCoord = document.accessors[primitive.texCoord0]
            vertexCount = position.count
            if (position.componentType != gltfComponentF32 ||
                position.elementType != "VEC3" ||
                texCoord.componentType != gltfComponentF32 ||
                texCoord.elementType != "VEC2" ||
                texCoord.count != vertexCount) {
                error = "textured glTF primitive requires matching FLOAT VEC3/VEC2 accessors"
            } else {
                val positions = gltfAccessorBytes(
                    document, payloads, primitive.position
                )
                val coordinates = gltfAccessorBytes(
                    document, payloads, primitive.texCoord0
                )
                vertexBytes = bufferBytes(vertexCount * 20)
                var vertex = 0
                var stored = positions.valid() && coordinates.valid() &&
                    vertexBytes.valid()
                while (stored && vertex < vertexCount) {
                    var byteIndex = 0
                    while (stored && byteIndex < 12) {
                        stored = vertexBytes.store(
                            vertex * 20 + byteIndex,
                            positions.load(vertex * 12 + byteIndex)
                        )
                        byteIndex = byteIndex + 1
                    }
                    byteIndex = 0
                    while (stored && byteIndex < 8) {
                        stored = vertexBytes.store(
                            vertex * 20 + 12 + byteIndex,
                            coordinates.load(vertex * 8 + byteIndex)
                        )
                        byteIndex = byteIndex + 1
                    }
                    vertex = vertex + 1
                }
                if (!stored) error = "textured glTF vertex interleave failed"
            }
            if (primitive.indices >= 0) {
                val source = gltfAccessorBytes(
                    document, payloads, primitive.indices
                )
                val accessor = document.accessors[primitive.indices]
                val sourceSize = accessor.componentByteSize()
                indexCount = accessor.count
                indexBytes = bufferBytes(indexCount * 4)
                var index = 0
                var stored = source.valid() && indexBytes.valid()
                while (stored && index < indexCount) {
                    stored = indexBytes.storeU32(
                        gltfLoadUnsignedBuffer(
                            source, index * sourceSize, sourceSize
                        ),
                        index * 4
                    )
                    index = index + 1
                }
                if (!stored) error = "glTF index accessor decoding failed"
            } else {
                indexCount = vertexCount
                indexBytes = bufferBytes(indexCount * 4)
                var index = 0
                var stored = indexBytes.valid()
                while (stored && index < indexCount) {
                    stored = indexBytes.storeU32(index, index * 4)
                    index = index + 1
                }
                if (!stored) error = "glTF generated index decoding failed"
            }
        }
    }
    val vertices = this.buffer(BufferDescriptor(
        label = "gltf-position-uv",
        size = if (vertexBytes.valid()) vertexBytes.size else 0,
        usage = bufferUsageVertex | bufferUsageCopyDestination
    ))
    val indices = this.buffer(BufferDescriptor(
        label = "gltf-indices",
        size = if (indexBytes.valid()) indexBytes.size else 0,
        usage = bufferUsageIndex | bufferUsageCopyDestination
    ))
    if (error.size == 0 &&
        (!vertices.writeAllBytes(vertexBytes) ||
         !indices.writeAllBytes(indexBytes)))
        error = "textured glTF GPU buffer upload failed"
    GltfGpuTexturedPrimitive(
        move(vertices), move(indices), vertexCount, indexCount, layout, error
    )
}

// Packs every unique accessor-identity resource once. Indices are rewritten to
// absolute vertices, so one vertex binding serves every per-draw index range.
trusted fun GraphicsApplication.gltfGpuTexturedScene(
    document: GltfDocument,
    payloads: GltfBufferPayloads,
    drawList: GltfSceneDrawList,
    plan: GltfSceneResourcePlan
): GltfGpuTexturedScene {
    val layout = VertexBufferLayout(20, [
        VertexAttribute(0, 0, vertexFormatFloat32x3),
        VertexAttribute(1, 12, vertexFormatFloat32x2)
    ])
    val vertexBases: array<int> = []
    val resourceIndexOffsets: array<int> = []
    val resourceIndexCounts: array<int> = []
    var vertexCount = 0
    var indexCount = 0
    var valid = this.valid() && document.valid() && payloads.valid &&
        drawList.valid && plan.valid &&
        plan.meshIndices.size == plan.primitiveIndices.size &&
        plan.drawableResources.size == drawList.drawables.size &&
        plan.meshIndices.size > 0
    var resourceIndex = 0
    while (valid && resourceIndex < plan.meshIndices.size) {
        val meshIndex = plan.meshIndices[resourceIndex]
        val primitiveIndex = plan.primitiveIndices[resourceIndex]
        valid = meshIndex >= 0 && meshIndex < document.meshes.size &&
            primitiveIndex >= 0 &&
            primitiveIndex < document.meshes[meshIndex].primitives.size
        if (valid) {
            val primitive = document.meshes[meshIndex].primitives[
                primitiveIndex
            ]
            valid = primitive.texCoord0 >= 0
            if (valid) {
                val position = document.accessors[primitive.position]
                val texCoord = document.accessors[primitive.texCoord0]
                val primitiveIndexCount = if (primitive.indices >= 0)
                    document.accessors[primitive.indices].count
                    else position.count
                valid = position.componentType == gltfComponentF32 &&
                    position.elementType == "VEC3" &&
                    texCoord.componentType == gltfComponentF32 &&
                    texCoord.elementType == "VEC2" &&
                    texCoord.count == position.count &&
                    position.count <= 16777216 - vertexCount &&
                    primitiveIndexCount <= 16777216 - indexCount
                if (valid) {
                    vertexBases.append(vertexCount)
                    resourceIndexOffsets.append(indexCount * 4)
                    resourceIndexCounts.append(primitiveIndexCount)
                    vertexCount = vertexCount + position.count
                    indexCount = indexCount + primitiveIndexCount
                }
            }
        }
        resourceIndex = resourceIndex + 1
    }
    val vertexBytes = bufferBytes(if (valid) vertexCount * 20 else 0)
    val indexBytes = bufferBytes(if (valid) indexCount * 4 else 0)
    resourceIndex = 0
    while (valid && resourceIndex < plan.meshIndices.size) {
        val primitive = document.meshes[plan.meshIndices[resourceIndex]].primitives[
            plan.primitiveIndices[resourceIndex]
        ]
        val position = document.accessors[primitive.position]
        val positions = gltfAccessorBytes(
            document, payloads, primitive.position
        )
        val coordinates = gltfAccessorBytes(
            document, payloads, primitive.texCoord0
        )
        val vertexBase = vertexBases[resourceIndex]
        var vertex = 0
        valid = positions.valid() && coordinates.valid() &&
            vertexBytes.valid() && indexBytes.valid()
        while (valid && vertex < position.count) {
            var byteIndex = 0
            while (valid && byteIndex < 12) {
                valid = vertexBytes.store(
                    (vertexBase + vertex) * 20 + byteIndex,
                    positions.load(vertex * 12 + byteIndex)
                )
                byteIndex = byteIndex + 1
            }
            byteIndex = 0
            while (valid && byteIndex < 8) {
                valid = vertexBytes.store(
                    (vertexBase + vertex) * 20 + 12 + byteIndex,
                    coordinates.load(vertex * 8 + byteIndex)
                )
                byteIndex = byteIndex + 1
            }
            vertex = vertex + 1
        }
        val outputIndexOffset = resourceIndexOffsets[resourceIndex]
        if (valid && primitive.indices >= 0) {
            val source = gltfAccessorBytes(
                document, payloads, primitive.indices
            )
            val accessor = document.accessors[primitive.indices]
            val sourceSize = accessor.componentByteSize()
            var index = 0
            valid = source.valid()
            while (valid && index < accessor.count) {
                val value = gltfLoadUnsignedBuffer(
                    source, index * sourceSize, sourceSize
                )
                valid = value >= 0 && value < position.count &&
                    indexBytes.storeU32(
                        vertexBase + value,
                        outputIndexOffset + index * 4
                    )
                index = index + 1
            }
        } else if (valid) {
            var index = 0
            while (valid && index < position.count) {
                valid = indexBytes.storeU32(
                    vertexBase + index,
                    outputIndexOffset + index * 4
                )
                index = index + 1
            }
        }
        resourceIndex = resourceIndex + 1
    }
    val drawIndexCounts: array<int> = []
    val drawIndexOffsets: array<int> = []
    var drawIndex = 0
    while (valid && drawIndex < plan.drawableResources.size) {
        val resourceId = plan.drawableResources[drawIndex]
        valid = resourceId >= 0 && resourceId < resourceIndexCounts.size
        if (valid) {
            drawIndexCounts.append(resourceIndexCounts[resourceId])
            drawIndexOffsets.append(resourceIndexOffsets[resourceId])
        }
        drawIndex = drawIndex + 1
    }
    val vertices = this.buffer(BufferDescriptor(
        label = "gltf-scene-position-uv",
        size = if (valid) vertexBytes.size else 0,
        usage = bufferUsageVertex | bufferUsageCopyDestination
    ))
    val indices = this.buffer(BufferDescriptor(
        label = "gltf-scene-indices",
        size = if (valid) indexBytes.size else 0,
        usage = bufferUsageIndex | bufferUsageCopyDestination
    ))
    if (valid) valid = vertices.writeAllBytes(vertexBytes) &&
        indices.writeAllBytes(indexBytes)
    GltfGpuTexturedScene(
        move(vertices), move(indices), vertexCount, indexCount,
        drawIndexCounts, drawIndexOffsets, layout,
        if (valid) "" else "glTF textured scene packing or upload failed"
    )
}
