// Typed physical texture materialization for deterministic render graphs.

import "core.ab"
import "resources.ab"
import "bytes.ab"
import "application.ab"
import "texture.ab"
import "texture_pool.ab"
import "sampler.ab"
import "binding.ab"
import "pool.ab"
import "graph.ab"

val graphicsMaximumGraphTextureResources = 256
val graphicsMaximumGraphExecutionGeneration = graphicsMaximumInt

class GraphicsGraphTextureDeclaration(
    val resourceId: int,
    val texture: TextureDescriptor
) {
    fun valid(): bool = this.resourceId >= 0 && this.texture.valid()
}

class GraphicsGraphBufferDeclaration(
    val resourceId: int,
    val buffer: BufferDescriptor
) {
    fun valid(): bool = this.resourceId >= 0 && this.buffer.valid()
}

fun graphicsGraphBufferDescriptorsCompatible(
    left: BufferDescriptor,
    right: BufferDescriptor
): bool = left.valid() && right.valid() && left.size == right.size &&
    left.usage == right.usage &&
    left.mappedAtCreation == right.mappedAtCreation &&
    left.persistentMapping == right.persistentMapping &&
    left.memory == right.memory

fun graphicsGraphBufferPoolBlockSize(size: int): int {
    var blockSize = 4
    while (size > 0 && blockSize < graphicsMaximumBufferPoolBytes &&
        ((size - 1) / blockSize) + 1 >
            graphicsMaximumBufferPoolBlocks) {
        blockSize = blockSize * 2
    }
    if (size > 0 && size <= graphicsMaximumBufferPoolBytes)
        blockSize else 0
}

fun graphicsGraphBufferPoolCapacity(size: int): int {
    val blockSize = graphicsGraphBufferPoolBlockSize(size)
    val blocks = if (blockSize > 0)
        ((size - 1) / blockSize) + 1 else 0
    if (blocks > 0 && blocks <= graphicsMaximumBufferPoolBlocks)
        blocks * blockSize else 0
}

fun textureDescriptorStorageBytes(texture: TextureDescriptor): int {
    var total = 0
    var mipLevel = 0
    var valid = texture.valid()
    while (valid && mipLevel < texture.mipLevels) {
        val width = textureMipDimension(texture.size.width, mipLevel)
        val height = if (texture.dimension == textureDimension1D) 1
            else textureMipDimension(texture.size.height, mipLevel)
        val depth = textureMipDepth(texture, mipLevel)
        val mipBytes = textureDataRequiredBytesRange(
            texture,
            width,
            height,
            depth
        )
        valid = mipBytes > 0 &&
            graphicsSizeProductFits(mipBytes, texture.samples)
        if (valid) {
            val sampledBytes = mipBytes * texture.samples
            valid = total <= graphicsMaximumInt - sampledBytes
            if (valid) total = total + sampledBytes
        }
        mipLevel = mipLevel + 1
    }
    if (valid && mipLevel == texture.mipLevels) total else -1
}

fun graphicsGraphLifetimeIndex(
    plan: GraphicsRenderGraphPlan,
    resourceId: int
): int {
    var result = -1
    var index = 0
    while (result < 0 && index < plan.lifetimes.size) {
        if (plan.lifetimes[index].resourceId == resourceId) result = index
        index = index + 1
    }
    result
}

fun graphicsGraphTextureDeclarationIndex(
    declarations: array<GraphicsGraphTextureDeclaration>,
    resourceId: int
): int {
    var result = -1
    var index = 0
    while (result < 0 && index < declarations.size) {
        if (declarations[index].resourceId == resourceId) result = index
        index = index + 1
    }
    result
}

fun graphicsGraphBufferDeclarationIndex(
    declarations: array<GraphicsGraphBufferDeclaration>,
    resourceId: int
): int {
    var result = -1
    var index = 0
    while (result < 0 && index < declarations.size) {
        if (declarations[index].resourceId == resourceId) result = index
        index = index + 1
    }
    result
}

resource class GraphicsMaterializedRenderGraph(
    val resources: array<GraphicsGraphResource>,
    val passes: array<GraphicsGraphPass>,
    val declarations: array<GraphicsGraphTextureDeclaration>,
    val bufferDeclarations: array<GraphicsGraphBufferDeclaration>,
    val plan: GraphicsRenderGraphPlan,
    val compiledBarrierCounts: array<int>,
    val compiledSourceAccesses: array<int>,
    val compiledDestinationAccesses: array<int>,
    val pools: array<GraphicsTexturePool>,
    val slotLeases: array<int>,
    val bufferPools: array<GraphicsBufferPool>,
    val bufferAllocations: array<int>,
    val texturePoolSlots: array<int>,
    val bufferPoolSlots: array<int>,
    val resourceSlots: array<int>,
    val backend: int,
    var executing: bool,
    var executionGeneration: int,
    var currentPassPosition: int,
    var completedExecutions: int,
    var abortedExecutions: int,
    var currentExecutionBarriers: int,
    var lastExecutionBarriers: int,
    var totalExecutedBarriers: int,
    var backendBarrierCalls: int,
    val error: GraphicsError
) {
    fun valid(): bool {
        var accepted = !this.error.occurred() && this.plan.valid() &&
            this.resources.size > 0 &&
            this.resources.size <= graphicsMaximumGraphTextureResources &&
            this.declarations.size + this.bufferDeclarations.size ==
                this.resources.size &&
            this.resourceSlots.size == this.resources.size &&
            this.compiledBarrierCounts.size == this.plan.order.size &&
            this.compiledSourceAccesses.size == this.plan.order.size &&
            this.compiledDestinationAccesses.size == this.plan.order.size &&
            this.slotLeases.size == this.pools.size &&
            this.bufferAllocations.size == this.bufferPools.size &&
            this.texturePoolSlots.size == this.plan.allocations.size &&
            this.bufferPoolSlots.size == this.plan.allocations.size &&
            (this.backend == graphicsBackendOpenGl ||
             this.backend == graphicsBackendVulkan) &&
            this.executionGeneration >= 0 &&
            this.completedExecutions >= 0 &&
            this.abortedExecutions >= 0 &&
            this.currentExecutionBarriers >= 0 &&
            this.currentExecutionBarriers <= this.plan.barriers.size &&
            this.lastExecutionBarriers >= 0 &&
            (this.executing ||
             this.totalExecutedBarriers >= this.currentExecutionBarriers) &&
            this.backendBarrierCalls >= 0 &&
            this.currentPassPosition >= -1 &&
            this.currentPassPosition < this.plan.order.size
        var slot = 0
        var passPosition = 0
        while (accepted && passPosition < this.plan.order.size) {
            val count = this.compiledBarrierCounts[passPosition]
            val sourceAccess = this.compiledSourceAccesses[passPosition]
            val destinationAccess =
                this.compiledDestinationAccesses[passPosition]
            accepted = count >= 0 &&
                ((count == 0 && sourceAccess == 0 &&
                  destinationAccess == 0) ||
                 (count > 0 && sourceAccess >= graphAccessRead &&
                  sourceAccess <= graphAccessReadWrite &&
                  destinationAccess >= graphAccessRead &&
                  destinationAccess <= graphAccessReadWrite))
            passPosition = passPosition + 1
        }
        while (accepted && slot < this.pools.size) {
            accepted = this.pools[slot].valid() &&
                this.pools[slot].backend == this.backend &&
                this.pools[slot].descriptor.capacity == 1 &&
                this.pools[slot].leaseValid(this.slotLeases[slot])
            slot = slot + 1
        }
        slot = 0
        while (accepted && slot < this.bufferPools.size) {
            accepted = this.bufferPools[slot].valid() &&
                this.bufferPools[slot].backing.backend == this.backend &&
                this.bufferPools[slot].descriptor.maximumAllocations == 1 &&
                this.bufferPools[slot].allocationValid(
                    this.bufferAllocations[slot]
                )
            slot = slot + 1
        }
        slot = 0
        while (accepted && slot < this.plan.allocations.size) {
            val texturePool = this.texturePoolSlots[slot]
            val bufferPool = this.bufferPoolSlots[slot]
            accepted = (texturePool >= 0) != (bufferPool >= 0) &&
                texturePool < this.pools.size &&
                bufferPool < this.bufferPools.size
            slot = slot + 1
        }
        var resourceIndex = 0
        while (accepted && resourceIndex < this.resources.size) {
            val declarationIndex = graphicsGraphTextureDeclarationIndex(
                this.declarations,
                this.resources[resourceIndex].id
            )
            val bufferDeclarationIndex =
                graphicsGraphBufferDeclarationIndex(
                    this.bufferDeclarations,
                    this.resources[resourceIndex].id
                )
            accepted = (declarationIndex >= 0) !=
                (bufferDeclarationIndex >= 0)
            if (accepted && declarationIndex >= 0) {
                accepted = this.declarations[declarationIndex].valid()
            } else if (accepted) {
                val descriptor = this.bufferDeclarations[
                    bufferDeclarationIndex
                ].buffer
                val bufferPool = this.bufferPoolIndex(
                    this.resources[resourceIndex].id
                )
                accepted = descriptor.valid() &&
                    descriptor.size == this.resources[resourceIndex].size &&
                    ((!this.resources[resourceIndex].transient &&
                      this.resourceSlots[resourceIndex] == -1) ||
                     (this.resources[resourceIndex].transient &&
                      bufferPool >= 0 &&
                      bufferPool < this.bufferPools.size &&
                      this.bufferPools[bufferPool].allocationSize(
                          this.bufferAllocations[bufferPool]
                      ) == descriptor.size &&
                      (this.bufferPools[
                          bufferPool
                      ].backing.descriptor.usage & descriptor.usage) ==
                          descriptor.usage))
            }
            if (accepted && declarationIndex >= 0 &&
                this.resources[resourceIndex].transient) {
                slot = this.resourceSlots[resourceIndex]
                val poolIndex = if (slot >= 0 &&
                    slot < this.texturePoolSlots.size)
                    this.texturePoolSlots[slot] else -1
                accepted = poolIndex >= 0 && poolIndex < this.pools.size &&
                    textureDescriptorsStorageCompatible(
                        this.declarations[declarationIndex].texture,
                        this.pools[poolIndex].descriptor.texture
                    )
            } else if (accepted && declarationIndex >= 0) {
                accepted = this.resourceSlots[resourceIndex] == -1
            }
            resourceIndex = resourceIndex + 1
        }
        accepted
    }

    fun resourceIndex(resourceId: int): int =
        graphicsGraphResourceIndex(this.resources, resourceId)

    fun resourceSlot(resourceId: int): int {
        val index = this.resourceIndex(resourceId)
        if (index >= 0) this.resourceSlots[index] else -1
    }

    fun texturePoolIndex(resourceId: int): int {
        val slot = this.resourceSlot(resourceId)
        if (slot >= 0 && slot < this.texturePoolSlots.size)
            this.texturePoolSlots[slot] else -1
    }

    fun bufferPoolIndex(resourceId: int): int {
        val slot = this.resourceSlot(resourceId)
        if (slot >= 0 && slot < this.bufferPoolSlots.size)
            this.bufferPoolSlots[slot] else -1
    }

    fun transientResource(resourceId: int): bool {
        val index = this.resourceIndex(resourceId)
        index >= 0 && this.resources[index].transient
    }

    fun importedResource(resourceId: int): bool {
        val index = this.resourceIndex(resourceId)
        index >= 0 && !this.resources[index].transient
    }

    fun textureResource(resourceId: int): bool =
        graphicsGraphTextureDeclarationIndex(
            this.declarations,
            resourceId
        ) >= 0

    fun bufferResource(resourceId: int): bool =
        graphicsGraphBufferDeclarationIndex(
            this.bufferDeclarations,
            resourceId
        ) >= 0

    fun textureDescriptor(resourceId: int): TextureDescriptor {
        val declarationIndex = graphicsGraphTextureDeclarationIndex(
            this.declarations,
            resourceId
        )
        if (declarationIndex >= 0)
            this.declarations[declarationIndex].texture
        else TextureDescriptor()
    }

    fun bufferDescriptor(resourceId: int): BufferDescriptor {
        val declarationIndex = graphicsGraphBufferDeclarationIndex(
            this.bufferDeclarations,
            resourceId
        )
        if (declarationIndex >= 0)
            this.bufferDeclarations[declarationIndex].buffer
        else BufferDescriptor()
    }

    fun currentAccess(resourceId: int): int {
        if (!this.executing || this.currentPassPosition < 0 ||
            this.currentPassPosition >= this.plan.order.size) return 0
        val passIndex = graphicsGraphPassIndex(
            this.passes,
            this.plan.order[this.currentPassPosition]
        )
        if (passIndex >= 0)
            graphicsGraphAccess(this.passes[passIndex], resourceId)
        else 0
    }

    fun active(token: int): bool = this.valid() && this.executing &&
        token > 0 && token == this.executionGeneration

    fun resourceActive(token: int, resourceId: int): bool =
        this.active(token) && this.currentAccess(resourceId) != 0

    fun physicalIdentity(resourceId: int): int {
        if (!this.valid()) return 0
        val texturePool = this.texturePoolIndex(resourceId)
        val bufferPool = this.bufferPoolIndex(resourceId)
        if (texturePool >= 0 && texturePool < this.pools.size) {
            val textureSlot = texturePoolTokenSlot(
                this.slotLeases[texturePool]
            )
            return if (this.backend == graphicsBackendOpenGl)
                this.pools[texturePool].textures[textureSlot].openGl.handle
            else this.pools[texturePool].textures[textureSlot].vulkan.image
        }
        if (bufferPool >= 0 && bufferPool < this.bufferPools.size) {
            return if (this.backend == graphicsBackendOpenGl)
                this.bufferPools[bufferPool].backing.openGl.handle
            else this.bufferPools[bufferPool].backing.vulkan.handle
        }
        0
    }

    fun samePhysicalTexture(left: int, right: int): bool {
        val leftSlot = this.resourceSlot(left)
        val rightSlot = this.resourceSlot(right)
        this.valid() && leftSlot >= 0 && leftSlot == rightSlot &&
            this.physicalIdentity(left) != 0 &&
            this.physicalIdentity(left) == this.physicalIdentity(right)
    }

    fun samePhysicalBuffer(left: int, right: int): bool {
        val leftSlot = this.resourceSlot(left)
        val rightSlot = this.resourceSlot(right)
        this.valid() && this.bufferResource(left) &&
            this.bufferResource(right) && leftSlot >= 0 &&
            leftSlot == rightSlot && this.physicalIdentity(left) != 0 &&
            this.physicalIdentity(left) == this.physicalIdentity(right)
    }

    trusted fun beginExecution(): int {
        var token = 0
        if (this.valid() && !this.executing &&
            this.executionGeneration <
                graphicsMaximumGraphExecutionGeneration) {
            this.executionGeneration = this.executionGeneration + 1
            this.executing = true
            this.currentPassPosition = -1
            this.currentExecutionBarriers = 0
            token = this.executionGeneration
        }
        token
    }

    trusted fun beginPass(token: int, passId: int): bool {
        val next = this.currentPassPosition + 1
        val accepted = this.active(token) && next < this.plan.order.size &&
            this.plan.order[next] == passId
        if (accepted) this.currentPassPosition = next
        accepted
    }

    trusted fun completeExecution(token: int): bool {
        val accepted = this.active(token) &&
            this.currentPassPosition == this.plan.order.size - 1
        if (accepted) {
            this.executing = false
            this.currentPassPosition = -1
            this.completedExecutions = this.completedExecutions + 1
            this.lastExecutionBarriers = this.currentExecutionBarriers
        }
        accepted
    }

    trusted fun abortExecution(token: int): bool {
        val accepted = this.active(token) &&
            this.abortedExecutions < graphicsMaximumGraphExecutionGeneration
        if (accepted) {
            this.executing = false
            this.currentPassPosition = -1
            this.currentExecutionBarriers = 0
            this.abortedExecutions = this.abortedExecutions + 1
        }
        accepted
    }
}

trusted fun GraphicsApplication.materializeRenderGraphResources(
    resources: array<GraphicsGraphResource>,
    passes: array<GraphicsGraphPass>,
    declarations: array<GraphicsGraphTextureDeclaration>,
    bufferDeclarations: array<GraphicsGraphBufferDeclaration>
): GraphicsMaterializedRenderGraph {
    val plan = graphicsRenderGraph(resources, passes)
    val pools: array<GraphicsTexturePool> = []
    val slotLeases: array<int> = []
    val bufferPools: array<GraphicsBufferPool> = []
    val bufferAllocations: array<int> = []
    val texturePoolSlots: array<int> = []
    val bufferPoolSlots: array<int> = []
    val resourceSlots: array<int> = []
    val compiledBarrierCounts: array<int> = []
    val compiledSourceAccesses: array<int> = []
    val compiledDestinationAccesses: array<int> = []
    val slotDescriptors: array<TextureDescriptor> = []
    val slotBufferDescriptors: array<BufferDescriptor> = []
    val slotTextureDefined: array<bool> = []
    val slotBufferDefined: array<bool> = []
    var error = GraphicsError()
    if (!this.valid()) error = GraphicsError(
        graphicsErrorInvalidConfiguration,
        "GraphicsApplication.materializeRenderGraphResources",
        "graph resource materialization requires a valid application"
    )
    else if (!plan.valid()) error = GraphicsError(
        plan.error.code,
        "GraphicsApplication.materializeRenderGraphResources",
        plan.error.message
    )
    else if (resources.size > graphicsMaximumGraphTextureResources ||
        declarations.size + bufferDeclarations.size !=
            resources.size) error = GraphicsError(
        graphicsErrorLimitExceeded,
        "GraphicsApplication.materializeRenderGraphResources",
        "every graph resource needs one typed texture or imported-buffer declaration and at most 256 resources are supported"
    )

    var passPosition = 0
    while (!error.occurred() && passPosition < plan.order.size) {
        var barrierCount = 0
        var sourceAccess = 0
        var destinationAccess = 0
        var barrierIndex = 0
        while (barrierIndex < plan.barriers.size) {
            val barrier = plan.barriers[barrierIndex]
            if (barrier.destinationPass == plan.order[passPosition]) {
                barrierCount = barrierCount + 1
                sourceAccess = sourceAccess | barrier.sourceAccess
                destinationAccess =
                    destinationAccess | barrier.destinationAccess
            }
            barrierIndex = barrierIndex + 1
        }
        compiledBarrierCounts.append(barrierCount)
        compiledSourceAccesses.append(sourceAccess)
        compiledDestinationAccesses.append(destinationAccess)
        passPosition = passPosition + 1
    }

    var slot = 0
    while (!error.occurred() && slot < plan.allocations.size) {
        slotDescriptors.append(TextureDescriptor())
        slotBufferDescriptors.append(BufferDescriptor())
        slotTextureDefined.append(false)
        slotBufferDefined.append(false)
        texturePoolSlots.append(-1)
        bufferPoolSlots.append(-1)
        slot = slot + 1
    }
    var resourceIndex = 0
    while (!error.occurred() && resourceIndex < resources.size) {
        val graphResource = resources[resourceIndex]
        val declarationIndex = graphicsGraphTextureDeclarationIndex(
            declarations,
            graphResource.id
        )
        val bufferDeclarationIndex = graphicsGraphBufferDeclarationIndex(
            bufferDeclarations,
            graphResource.id
        )
        var textureDuplicate = false
        var declarationScan = 0
        while (declarationScan < declarations.size) {
            if (declarations[declarationScan].resourceId == graphResource.id &&
                declarationScan != declarationIndex) textureDuplicate = true
            declarationScan = declarationScan + 1
        }
        var bufferDuplicate = false
        declarationScan = 0
        while (declarationScan < bufferDeclarations.size) {
            if (bufferDeclarations[declarationScan].resourceId ==
                graphResource.id &&
                declarationScan != bufferDeclarationIndex)
                bufferDuplicate = true
            declarationScan = declarationScan + 1
        }
        if ((declarationIndex >= 0) == (bufferDeclarationIndex >= 0) ||
            textureDuplicate || bufferDuplicate ||
            (declarationIndex >= 0 &&
             !declarations[declarationIndex].valid()) ||
            (bufferDeclarationIndex >= 0 &&
             !bufferDeclarations[bufferDeclarationIndex].valid())) {
            error = GraphicsError(
                graphicsErrorInvalidConfiguration,
                "GraphicsApplication.materializeRenderGraphResources",
                "graph resource declarations must be valid, unique, exclusive, and complete"
            )
        } else if (bufferDeclarationIndex >= 0) {
            val descriptor = bufferDeclarations[
                bufferDeclarationIndex
            ].buffer
            val lifetimeIndex = graphicsGraphLifetimeIndex(
                plan,
                graphResource.id
            )
            slot = if (lifetimeIndex >= 0)
                plan.lifetimes[lifetimeIndex].allocationSlot else -1
            val transientValid = descriptor.size == graphResource.size &&
                descriptor.size <= graphicsMaximumBufferPoolBytes &&
                !descriptor.mappedAtCreation &&
                !descriptor.persistentMapping &&
                descriptor.memory == bufferMemoryDeviceLocal &&
                (descriptor.usage &
                    (bufferUsageMapRead | bufferUsageMapWrite)) == 0
            if ((graphResource.transient &&
                 (!transientValid || slot < 0 ||
                  slot >= plan.allocations.size ||
                  plan.allocations[slot].capacity < descriptor.size)) ||
                (!graphResource.transient && slot != -1) ||
                descriptor.size != graphResource.size) {
                error = GraphicsError(
                    graphicsErrorInvalidConfiguration,
                    "GraphicsApplication.materializeRenderGraphResources",
                    "graph buffers must match the logical size; transient buffers require device-local unmapped storage and a planned allocation"
                )
            } else if (graphResource.transient &&
                (slotTextureDefined[slot] ||
                 (slotBufferDefined[slot] &&
                  !graphicsGraphBufferDescriptorsCompatible(
                      slotBufferDescriptors[slot],
                      descriptor
                  )))) {
                error = GraphicsError(
                    graphicsErrorInvalidConfiguration,
                    "GraphicsApplication.materializeRenderGraphResources",
                    "opaque graph compatibility cannot alias buffer and texture slots or different buffer descriptors"
                )
            } else if (graphResource.transient &&
                !slotBufferDefined[slot]) {
                slotBufferDescriptors[slot] = descriptor
                slotBufferDefined[slot] = true
            }
            resourceSlots.append(slot)
        } else {
            val descriptor = declarations[declarationIndex].texture
            val storageBytes = textureDescriptorStorageBytes(descriptor)
            val lifetimeIndex = graphicsGraphLifetimeIndex(
                plan,
                graphResource.id
            )
            slot = if (lifetimeIndex >= 0)
                plan.lifetimes[lifetimeIndex].allocationSlot else -1
            if (graphResource.transient &&
                (storageBytes <= 0 || graphResource.size != storageBytes ||
                 slot < 0 || slot >= plan.allocations.size ||
                 plan.allocations[slot].capacity < storageBytes)) {
                error = GraphicsError(
                    graphicsErrorInvalidConfiguration,
                    "GraphicsApplication.materializeRenderGraphResources",
                    "transient graph texture size and planned allocation must match its complete descriptor"
                )
            } else if (!graphResource.transient && slot != -1) {
                error = GraphicsError(
                    graphicsErrorInvalidConfiguration,
                    "GraphicsApplication.materializeRenderGraphResources",
                    "imported graph textures cannot receive transient allocations"
                )
            } else if (graphResource.transient &&
                slotBufferDefined[slot]) {
                error = GraphicsError(
                    graphicsErrorInvalidConfiguration,
                    "GraphicsApplication.materializeRenderGraphResources",
                    "opaque graph compatibility cannot alias texture and buffer resources"
                )
            } else if (graphResource.transient &&
                slotTextureDefined[slot] &&
                !textureDescriptorsStorageCompatible(
                    slotDescriptors[slot],
                    descriptor
                )) {
                error = GraphicsError(
                    graphicsErrorInvalidConfiguration,
                    "GraphicsApplication.materializeRenderGraphResources",
                    "opaque graph compatibility cannot alias different texture descriptors"
                )
            } else if (graphResource.transient &&
                !slotTextureDefined[slot]) {
                slotDescriptors[slot] = descriptor
                slotTextureDefined[slot] = true
            }
            resourceSlots.append(slot)
        }
        resourceIndex = resourceIndex + 1
    }

    slot = 0
    while (!error.occurred() && slot < plan.allocations.size) {
        if (!slotTextureDefined[slot] && !slotBufferDefined[slot]) {
            error = GraphicsError(
                graphicsErrorInvalidConfiguration,
                "GraphicsApplication.materializeRenderGraphResources",
                "every planned transient allocation needs a typed descriptor"
            )
        } else if (slotTextureDefined[slot]) {
            val pool = this.texturePool(TexturePoolDescriptor(
                label = "render-graph-transient",
                texture = slotDescriptors[slot],
                capacity = 1
            ))
            if (!pool.valid()) error = GraphicsError(
                pool.error.code,
                "GraphicsApplication.materializeRenderGraphResources",
                pool.error.message
            )
            val lease = if (!error.occurred()) pool.acquire() else 0
            if (!texturePoolTokenValid(lease)) error = GraphicsError(
                graphicsErrorDriverFailure,
                "GraphicsApplication.materializeRenderGraphResources",
                "failed to retain a physical transient texture"
            )
            pools.append(move(pool))
            slotLeases.append(lease)
            texturePoolSlots[slot] = pools.size - 1
        } else {
            val descriptor = slotBufferDescriptors[slot]
            val blockSize = graphicsGraphBufferPoolBlockSize(descriptor.size)
            val capacity = graphicsGraphBufferPoolCapacity(descriptor.size)
            val pool = this.bufferPool(BufferPoolDescriptor(
                label = "render-graph-transient-buffer",
                capacity = capacity,
                blockSize = blockSize,
                maximumAllocations = 1,
                usage = descriptor.usage | bufferUsageCopySource |
                    bufferUsageCopyDestination
            ))
            if (!pool.valid()) error = GraphicsError(
                pool.error.code,
                "GraphicsApplication.materializeRenderGraphResources",
                pool.error.message
            )
            val allocation = if (!error.occurred())
                pool.allocate(descriptor.size, 1) else 0
            if (!bufferPoolTokenValid(allocation)) error = GraphicsError(
                graphicsErrorDriverFailure,
                "GraphicsApplication.materializeRenderGraphResources",
                "failed to retain a physical transient buffer allocation"
            )
            bufferPools.append(move(pool))
            bufferAllocations.append(allocation)
            bufferPoolSlots[slot] = bufferPools.size - 1
        }
        slot = slot + 1
    }

    GraphicsMaterializedRenderGraph(
        resources,
        passes,
        declarations,
        bufferDeclarations,
        plan,
        compiledBarrierCounts,
        compiledSourceAccesses,
        compiledDestinationAccesses,
        move(pools),
        slotLeases,
        move(bufferPools),
        bufferAllocations,
        texturePoolSlots,
        bufferPoolSlots,
        resourceSlots,
        this.backend,
        false,
        0,
        -1,
        0,
        0,
        0,
        0,
        0,
        0,
        error
    )
}

trusted fun GraphicsApplication.materializeRenderGraphTextures(
    resources: array<GraphicsGraphResource>,
    passes: array<GraphicsGraphPass>,
    declarations: array<GraphicsGraphTextureDeclaration>
): GraphicsMaterializedRenderGraph = this.materializeRenderGraphResources(
    resources,
    passes,
    declarations,
    []
)

trusted fun GraphicsApplication.writeGraphTextureBytes(
    var graph: GraphicsMaterializedRenderGraph,
    token: int,
    resourceId: int,
    source: BufferBytes,
    selection: TextureRegion = TextureRegion(),
    layout: TextureDataLayout = TextureDataLayout()
): bool {
    val pool = graph.texturePoolIndex(resourceId)
    return graph.resourceActive(token, resourceId) &&
        (graph.currentAccess(resourceId) & graphAccessWrite) != 0 &&
        pool >= 0 && pool < graph.pools.size &&
        this.writeTexturePoolBytes(
            graph.pools[pool],
            graph.slotLeases[pool],
            source,
            selection,
            layout
        )
}

trusted fun GraphicsApplication.readGraphTextureBytes(
    var graph: GraphicsMaterializedRenderGraph,
    token: int,
    resourceId: int,
    var destination: BufferBytes,
    selection: TextureRegion = TextureRegion(),
    layout: TextureDataLayout = TextureDataLayout()
): bool {
    val pool = graph.texturePoolIndex(resourceId)
    return graph.resourceActive(token, resourceId) &&
        (graph.currentAccess(resourceId) & graphAccessRead) != 0 &&
        pool >= 0 && pool < graph.pools.size &&
        this.readTexturePoolBytes(
            graph.pools[pool],
            graph.slotLeases[pool],
            destination,
            selection,
            layout
        )
}

trusted fun GraphicsApplication.copyGraphTexture(
    graph: GraphicsMaterializedRenderGraph,
    token: int,
    sourceResourceId: int,
    destinationResourceId: int,
    copy: TextureCopyDescriptor = TextureCopyDescriptor()
): bool {
    val sourceSlot = graph.resourceSlot(sourceResourceId)
    val destinationSlot = graph.resourceSlot(destinationResourceId)
    val sourcePool = graph.texturePoolIndex(sourceResourceId)
    val destinationPool = graph.texturePoolIndex(destinationResourceId)
    return graph.resourceActive(token, sourceResourceId) &&
        graph.resourceActive(token, destinationResourceId) &&
        (graph.currentAccess(sourceResourceId) & graphAccessRead) != 0 &&
        (graph.currentAccess(destinationResourceId) & graphAccessWrite) != 0 &&
        sourcePool >= 0 && sourcePool < graph.pools.size &&
        destinationPool >= 0 && destinationPool < graph.pools.size &&
        sourceSlot != destinationSlot && this.copyTexturePoolLease(
            graph.pools[sourcePool],
            graph.slotLeases[sourcePool],
            graph.pools[destinationPool],
            graph.slotLeases[destinationPool],
            copy
        )
}

trusted fun GraphicsApplication.copyGraphTextureRange(
    graph: GraphicsMaterializedRenderGraph,
    token: int,
    sourceResourceId: int,
    destinationResourceId: int,
    sourceMipLevel: int,
    sourceX: int,
    sourceY: int,
    sourceZ: int,
    destinationMipLevel: int,
    destinationX: int,
    destinationY: int,
    destinationZ: int,
    width: int,
    height: int,
    depth: int
): bool {
    val sourceSlot = graph.resourceSlot(sourceResourceId)
    val destinationSlot = graph.resourceSlot(destinationResourceId)
    val sourcePool = graph.texturePoolIndex(sourceResourceId)
    val destinationPool = graph.texturePoolIndex(destinationResourceId)
    return graph.resourceActive(token, sourceResourceId) &&
        graph.resourceActive(token, destinationResourceId) &&
        (graph.currentAccess(sourceResourceId) & graphAccessRead) != 0 &&
        (graph.currentAccess(destinationResourceId) & graphAccessWrite) != 0 &&
        sourcePool >= 0 && sourcePool < graph.pools.size &&
        destinationPool >= 0 && destinationPool < graph.pools.size &&
        sourceSlot != destinationSlot && this.copyTexturePoolLeaseRange(
            graph.pools[sourcePool],
            graph.slotLeases[sourcePool],
            graph.pools[destinationPool],
            graph.slotLeases[destinationPool],
            sourceMipLevel,
            sourceX,
            sourceY,
            sourceZ,
            destinationMipLevel,
            destinationX,
            destinationY,
            destinationZ,
            width,
            height,
            depth
        )
}

trusted fun GraphicsApplication.sampledGraphTextureEntry(
    binding: int,
    visibility: int,
    graph: GraphicsMaterializedRenderGraph,
    token: int,
    resourceId: int,
    sampler: GraphicsSampler
): GraphicsBindingEntry {
    val pool = graph.texturePoolIndex(resourceId)
    if (graph.resourceActive(token, resourceId) &&
        (graph.currentAccess(resourceId) & graphAccessRead) != 0 &&
        pool >= 0 && pool < graph.pools.size) {
        return this.sampledTexturePoolEntry(
            binding,
            visibility,
            graph.pools[pool],
            graph.slotLeases[pool],
            sampler
        )
    }
    GraphicsBindingEntry(
        binding,
        graphicsBindingSampledTexture,
        visibility,
        0,
        0,
        0,
        0,
        0,
        0,
        0,
        0,
        graph.textureDescriptor(resourceId),
        graph.textureDescriptor(resourceId).dimension,
        this.backend,
        GraphicsError(
            graphicsErrorInvalidConfiguration,
            "GraphicsApplication.sampledGraphTextureEntry",
            "sampled graph textures must be active transient read resources"
        )
    )
}

trusted fun GraphicsApplication.sampledRetainedGraphTextureEntry(
    binding: int,
    visibility: int,
    graph: GraphicsMaterializedRenderGraph,
    resourceId: int,
    sampler: GraphicsSampler
): GraphicsBindingEntry {
    val pool = graph.texturePoolIndex(resourceId)
    if (graph.valid() && graph.transientResource(resourceId) &&
        graph.textureResource(resourceId) &&
        (graph.textureDescriptor(resourceId).usage & textureUsageSampled) != 0 &&
        pool >= 0 && pool < graph.pools.size &&
        graph.pools[pool].leaseValid(graph.slotLeases[pool])) {
        return this.sampledTexturePoolEntry(
            binding,
            visibility,
            graph.pools[pool],
            graph.slotLeases[pool],
            sampler
        )
    }
    GraphicsBindingEntry(
        binding,
        graphicsBindingSampledTexture,
        visibility,
        0,
        0,
        0,
        0,
        0,
        0,
        0,
        0,
        graph.textureDescriptor(resourceId),
        graph.textureDescriptor(resourceId).dimension,
        this.backend,
        GraphicsError(
            graphicsErrorInvalidConfiguration,
            "GraphicsApplication.sampledRetainedGraphTextureEntry",
            "retained graph texture entries require a sampled transient texture with a stable pool lease"
        )
    )
}

trusted fun GraphicsApplication.graphBufferEntry(
    binding: int,
    visibility: int,
    graph: GraphicsMaterializedRenderGraph,
    resourceId: int,
    kind: int
): GraphicsBindingEntry {
    val poolIndex = graph.bufferPoolIndex(resourceId)
    if (graph.valid() && graph.transientResource(resourceId) &&
        graph.bufferResource(resourceId) && poolIndex >= 0 &&
        poolIndex < graph.bufferPools.size) {
        return this.bufferPoolBindingEntry(
            binding,
            visibility,
            graph.bufferPools[poolIndex],
            graph.bufferAllocations[poolIndex],
            kind
        )
    }
    GraphicsBindingEntry(
        binding,
        kind,
        visibility,
        0,
        0,
        0,
        0,
        0,
        0,
        0,
        0,
        TextureDescriptor(),
        textureDimensionUndefined,
        this.backend,
        GraphicsError(
            graphicsErrorInvalidConfiguration,
            "GraphicsApplication.graphBufferEntry",
            "graph buffer entries require a materialized transient buffer"
        )
    )
}

trusted fun GraphicsApplication.storageGraphBufferEntry(
    binding: int,
    visibility: int,
    graph: GraphicsMaterializedRenderGraph,
    resourceId: int
): GraphicsBindingEntry = this.graphBufferEntry(
    binding,
    visibility,
    graph,
    resourceId,
    graphicsBindingStorageBuffer
)

trusted fun GraphicsApplication.uniformGraphBufferEntry(
    binding: int,
    visibility: int,
    graph: GraphicsMaterializedRenderGraph,
    resourceId: int
): GraphicsBindingEntry = this.graphBufferEntry(
    binding,
    visibility,
    graph,
    resourceId,
    graphicsBindingUniformBuffer
)

fun GraphicsApplication.matchesImportedGraphTexture(
    graph: GraphicsMaterializedRenderGraph,
    token: int,
    resourceId: int,
    texture: GraphicsTexture
): bool = graph.resourceActive(token, resourceId) &&
    graph.importedResource(resourceId) && texture.valid() &&
    this.ownsTexture(texture) && textureDescriptorsStorageCompatible(
        graph.textureDescriptor(resourceId),
        texture.descriptor
    )

trusted fun GraphicsApplication.copyImportedToGraphTexture(
    graph: GraphicsMaterializedRenderGraph,
    token: int,
    sourceResourceId: int,
    source: GraphicsTexture,
    destinationResourceId: int,
    copy: TextureCopyDescriptor = TextureCopyDescriptor()
): bool {
    val destinationPool = graph.texturePoolIndex(destinationResourceId)
    return this.matchesImportedGraphTexture(
        graph,
        token,
        sourceResourceId,
        source
    ) && (graph.currentAccess(sourceResourceId) & graphAccessRead) != 0 &&
        graph.resourceActive(token, destinationResourceId) &&
        (graph.currentAccess(destinationResourceId) & graphAccessWrite) != 0 &&
        destinationPool >= 0 && destinationPool < graph.pools.size &&
        this.copyTexture(
            source,
            graph.pools[destinationPool].textures[texturePoolTokenSlot(
                graph.slotLeases[destinationPool]
            )],
            copy
        )
}

trusted fun GraphicsApplication.copyGraphTextureToImported(
    graph: GraphicsMaterializedRenderGraph,
    token: int,
    sourceResourceId: int,
    destinationResourceId: int,
    destination: GraphicsTexture,
    copy: TextureCopyDescriptor = TextureCopyDescriptor()
): bool {
    val sourcePool = graph.texturePoolIndex(sourceResourceId)
    return graph.resourceActive(token, sourceResourceId) &&
        (graph.currentAccess(sourceResourceId) & graphAccessRead) != 0 &&
        this.matchesImportedGraphTexture(
            graph,
            token,
            destinationResourceId,
            destination
        ) &&
        (graph.currentAccess(destinationResourceId) & graphAccessWrite) != 0 &&
        sourcePool >= 0 && sourcePool < graph.pools.size &&
        this.copyTexture(
            graph.pools[sourcePool].textures[texturePoolTokenSlot(
                graph.slotLeases[sourcePool]
            )],
            destination,
            copy
        )
}

trusted fun GraphicsApplication.sampledImportedGraphTextureEntry(
    binding: int,
    visibility: int,
    graph: GraphicsMaterializedRenderGraph,
    token: int,
    resourceId: int,
    texture: GraphicsTexture,
    sampler: GraphicsSampler
): GraphicsBindingEntry {
    if (this.matchesImportedGraphTexture(
        graph,
        token,
        resourceId,
        texture
    ) && (graph.currentAccess(resourceId) & graphAccessRead) != 0) {
        return this.sampledTextureEntry(
            binding,
            visibility,
            texture,
            sampler
        )
    }
    GraphicsBindingEntry(
        binding,
        graphicsBindingSampledTexture,
        visibility,
        0,
        0,
        0,
        0,
        0,
        0,
        0,
        0,
        graph.textureDescriptor(resourceId),
        graph.textureDescriptor(resourceId).dimension,
        this.backend,
        GraphicsError(
            graphicsErrorInvalidConfiguration,
            "GraphicsApplication.sampledImportedGraphTextureEntry",
            "sampled imported graph textures must be active caller-owned read resources"
        )
    )
}
