// Affine backend-neutral bind groups with explicit shader-visible entries.

import "abla/unsafe/memory"
import "core.ab"
import "application.ab"
import "texture.ab"
import "sampler.ab"
import "buffer.ab"
import "shader/glsl.ab"
import "driver/opengl.ab"
import "driver/vulkan.ab"

val graphicsBindingSampledTexture = 1
val graphicsBindingUniformBuffer = 2
val graphicsBindingStorageBuffer = 3
val graphicsBindingStorageTexture = 4

val graphicsStorageTextureReadOnly = 1
val graphicsStorageTextureWriteOnly = 2
val graphicsStorageTextureReadWrite = 3

val shaderVisibilityVertex = 1
val shaderVisibilityFragment = 2
val shaderVisibilityCompute = 4
val shaderVisibilityAll = 7

fun graphicsBindingVisibilityValid(visibility: int): bool =
    visibility > 0 && (visibility & shaderVisibilityAll) == visibility

fun graphicsBindingVulkanStageFlags(visibility: int): int {
    var flags = 0
    if ((visibility & shaderVisibilityVertex) != 0) flags = flags | 1
    if ((visibility & shaderVisibilityFragment) != 0) flags = flags | 16
    if ((visibility & shaderVisibilityCompute) != 0) flags = flags | 32
    flags
}

fun graphicsBindingStageVisibility(stage: string): int =
    if (stage == shaderStageVertex) shaderVisibilityVertex
    else if (stage == shaderStageFragment) shaderVisibilityFragment
    else if (stage == shaderStageCompute) shaderVisibilityCompute
    else 0

fun graphicsSampledTextureDimension(dataType: string): int =
    if (dataType == "sampler2D") textureDimension2D
    else if (dataType == "sampler2DArray") textureDimension2DArray
    else if (dataType == "samplerCube") textureDimensionCube
    else if (dataType == "sampler3D") textureDimension3D
    else textureDimensionUndefined

fun graphicsStorageTextureDimension(dataType: string): int =
    if (dataType == "image2D" || dataType == "iimage2D" ||
        dataType == "uimage2D") textureDimension2D
    else textureDimensionUndefined

fun graphicsStorageTextureAccessValid(access: int): bool =
    access >= graphicsStorageTextureReadOnly &&
    access <= graphicsStorageTextureReadWrite

fun graphicsStorageTextureOpenGlAccess(access: int): int =
    if (access == graphicsStorageTextureReadOnly) 35000
    else if (access == graphicsStorageTextureWriteOnly) 35001
    else if (access == graphicsStorageTextureReadWrite) 35002
    else 0

fun graphicsStorageTextureReflectedAccess(access: string): int =
    if (access == "readonly") graphicsStorageTextureReadOnly
    else if (access == "writeonly") graphicsStorageTextureWriteOnly
    else graphicsStorageTextureReadWrite

fun graphicsStorageTextureReflectedFormat(format: string): int =
    if (format == "r8") textureFormatR8Unorm
    else if (format == "rg8") textureFormatRg8Unorm
    else if (format == "rgba8") textureFormatRgba8Unorm
    else if (format == "r16f") textureFormatR16Float
    else if (format == "rg16f") textureFormatRg16Float
    else if (format == "rgba16f") textureFormatRgba16Float
    else if (format == "r32f") textureFormatR32Float
    else if (format == "rg32f") textureFormatRg32Float
    else if (format == "rgba32f") textureFormatRgba32Float
    else textureFormatUndefined

fun graphicsStorageTextureFormatValid(format: int): bool =
    format == textureFormatR8Unorm || format == textureFormatRg8Unorm ||
    format == textureFormatRgba8Unorm ||
    format == textureFormatR16Float || format == textureFormatRg16Float ||
    format == textureFormatRgba16Float ||
    format == textureFormatR32Float || format == textureFormatRg32Float ||
    format == textureFormatRgba32Float

fun graphicsStorageTextureRequiredFeatures(
    format: int,
    visibility: int
): int {
    var features = graphicsFeatureStorageTextures
    if (format != textureFormatRgba32Float) {
        features = features | graphicsFeatureStorageTextureExtendedFormats
    }
    if ((visibility & shaderVisibilityFragment) != 0) {
        features = features | graphicsFeatureFragmentStorageTextures
    }
    if ((visibility & shaderVisibilityVertex) != 0) features = -1
    features
}

fun graphicsStorageTextureSupported(
    capabilities: GraphicsCapabilities,
    format: int,
    visibility: int
): bool {
    val required = graphicsStorageTextureRequiredFeatures(format, visibility)
    graphicsStorageTextureFormatValid(format) && required >= 0 &&
        capabilities.supports(required)
}

class GraphicsBindingEntry(
    val binding: int,
    val kind: int,
    val visibility: int,
    val openGlResource: int,
    val openGlSampler: int,
    val vulkanResource: int,
    val vulkanView: int,
    val vulkanSampler: int,
    val offset: int,
    val size: int,
    val bufferSize: int,
    val texture: TextureDescriptor,
    val textureDimension: int,
    val backend: int,
    val error: GraphicsError
) {
    fun openGlValid(): bool = this.openGlResource != 0 &&
        ((this.kind == graphicsBindingSampledTexture &&
          this.openGlSampler != 0 && this.offset == 0 &&
          this.size == 0 && this.bufferSize == 0) ||
         ((this.kind == graphicsBindingUniformBuffer ||
           this.kind == graphicsBindingStorageBuffer) &&
          this.openGlSampler == 0 && this.offset >= 0 &&
          this.size > 0 && this.bufferSize > 0 &&
          this.offset <= this.bufferSize - this.size) ||
         (this.kind == graphicsBindingStorageTexture &&
          this.openGlSampler != 0 && this.offset == 0 &&
          (this.size == 35000 || this.size == 35001 ||
           this.size == 35002) &&
          graphicsStorageTextureAccessValid(this.bufferSize) &&
          this.texture.valid()))

    fun vulkanValid(): bool =
        (this.kind == graphicsBindingSampledTexture &&
         (this.vulkanResource != 0 || this.vulkanView != 0) &&
         this.vulkanSampler != 0 && this.offset == 0 &&
         this.size == 0 && this.bufferSize == 0 &&
         this.texture.valid()) ||
        ((this.kind == graphicsBindingUniformBuffer ||
          this.kind == graphicsBindingStorageBuffer) &&
         this.vulkanResource != 0 && this.vulkanView == 0 &&
         this.vulkanSampler == 0 && this.offset >= 0 &&
         this.size > 0 && this.bufferSize > 0 &&
         this.offset <= this.bufferSize - this.size) ||
        (this.kind == graphicsBindingStorageTexture &&
         (this.vulkanResource != 0 || this.vulkanView != 0) &&
         this.vulkanSampler == 0 && this.offset == 0 && this.size == 0 &&
         graphicsStorageTextureAccessValid(this.bufferSize) &&
         this.texture.valid())

    fun valid(): bool = !this.error.occurred() &&
        this.binding >= 0 && this.binding <= 31 &&
        graphicsBindingVisibilityValid(this.visibility) &&
        this.kind >= graphicsBindingSampledTexture &&
        this.kind <= graphicsBindingStorageTexture &&
        ((this.backend == graphicsBackendOpenGl && this.openGlValid()) ||
         (this.backend == graphicsBackendVulkan && this.vulkanValid()))

    fun matches(reflected: ShaderBinding): bool {
        val stageVisibility = graphicsBindingStageVisibility(reflected.stage)
        val sampledDimension = graphicsSampledTextureDimension(
            reflected.dataType
        )
        val storageDimension = graphicsStorageTextureDimension(
            reflected.dataType
        )
        val typeMatches =
            (this.kind == graphicsBindingSampledTexture &&
             reflected.storage == "uniform" &&
             sampledDimension != textureDimensionUndefined &&
             this.textureDimension == sampledDimension) ||
            (this.kind == graphicsBindingUniformBuffer &&
             reflected.storage == "uniform" &&
             !glslSamplerType(reflected.dataType) &&
             storageDimension == textureDimensionUndefined) ||
            (this.kind == graphicsBindingStorageBuffer &&
             reflected.storage == "buffer") ||
            (this.kind == graphicsBindingStorageTexture &&
             reflected.storage == "uniform" &&
             storageDimension != textureDimensionUndefined &&
             this.textureDimension == storageDimension &&
             this.bufferSize == graphicsStorageTextureReflectedAccess(
                reflected.access
             ) && this.texture.format ==
                graphicsStorageTextureReflectedFormat(
                    reflected.imageFormat
                ))
        reflected.set == 0 && reflected.binding == this.binding &&
            reflected.arraySize == 1 && stageVisibility != 0 &&
            (this.visibility & stageVisibility) != 0 && typeMatches
    }
}

resource class GraphicsBindGroup(
    val entries: array<GraphicsBindingEntry>,
    val openGlKinds: array<int>,
    val openGlBindings: array<int>,
    val openGlResources: array<int>,
    val openGlOffsets: array<int>,
    val openGlSizes: array<int>,
    val openGlSamplers: array<int>,
    val openGlDisplay: i64*,
    val openGlContext: i64*,
    val vulkan: VulkanBindGroup,
    val backend: int,
    val error: GraphicsError
) {
    fun valid(): bool = !this.error.occurred() &&
        ((this.backend == graphicsBackendOpenGl &&
          this.entries.size > 0 &&
          this.openGlKinds.size == this.entries.size &&
          this.openGlBindings.size == this.entries.size &&
          this.openGlResources.size == this.entries.size &&
          this.openGlOffsets.size == this.entries.size &&
          this.openGlSizes.size == this.entries.size &&
          this.openGlSamplers.size == this.entries.size &&
          !pointerIsNull(this.openGlDisplay) &&
          !pointerIsNull(this.openGlContext)) ||
         (this.backend == graphicsBackendVulkan && this.vulkan.valid() &&
          this.entries.size == this.vulkan.bindingCount))

    fun empty(): bool = this.backend == graphicsBackendAuto &&
        this.entries.size == 0 && !this.vulkan.valid() &&
        !this.error.occurred()

    fun matches(bindings: array<ShaderBinding>): bool {
        var matched = bindings.size >= this.entryCount()
        var bindingIndex = 0
        while (matched && bindingIndex < bindings.size) {
            var found = false
            var entryIndex = 0
            while (!found && entryIndex < this.entryCount()) {
                found = this.entries[entryIndex].matches(
                    bindings[bindingIndex]
                )
                entryIndex = entryIndex + 1
            }
            matched = matched && found
            bindingIndex = bindingIndex + 1
        }
        var entryIndex = 0
        while (matched && entryIndex < this.entryCount()) {
            var found = false
            bindingIndex = 0
            while (!found && bindingIndex < bindings.size) {
                found = this.entries[entryIndex].matches(
                    bindings[bindingIndex]
                )
                bindingIndex = bindingIndex + 1
            }
            matched = matched && found
            entryIndex = entryIndex + 1
        }
        matched
    }

    fun entryCount(): int = this.entries.size

    trusted fun drop(): void {
        this.vulkan.drop()
        return
    }
}

fun emptyGraphicsBindGroup(): GraphicsBindGroup = GraphicsBindGroup(
    [],
    [],
    [],
    [],
    [],
    [],
    [],
    nativeNullPointer(),
    nativeNullPointer(),
    VulkanBindGroup(nativeNullPointer(), 0, 0, 0, [], 0),
    graphicsBackendAuto,
    GraphicsError()
)

trusted fun GraphicsApplication.sampledTextureEntry(
    binding: int,
    visibility: int,
    texture: GraphicsTexture,
    sampler: GraphicsSampler
): GraphicsBindingEntry {
    var error = GraphicsError()
    if (!this.valid() || !texture.valid() || !sampler.valid() ||
        !this.ownsTexture(texture) || !this.ownsSampler(sampler) ||
        binding < 0 || binding > 31 ||
        !graphicsBindingVisibilityValid(visibility) ||
        (texture.descriptor.usage & textureUsageSampled) == 0 ||
        textureFormatHasDepth(texture.descriptor.format)) {
        error = GraphicsError(
            graphicsErrorInvalidConfiguration,
            "GraphicsApplication.sampledTextureEntry",
            "sampled texture entries require owned color resources, a binding from 0 to 31, and valid visibility"
        )
    }
    GraphicsBindingEntry(
        binding,
        graphicsBindingSampledTexture,
        visibility,
        if (this.backend == graphicsBackendOpenGl) texture.openGl.handle else 0,
        if (this.backend == graphicsBackendOpenGl) sampler.openGl.handle else 0,
        if (this.backend == graphicsBackendVulkan) texture.vulkan.image else 0,
        0,
        if (this.backend == graphicsBackendVulkan) sampler.vulkan.handle else 0,
        0,
        0,
        0,
        texture.descriptor,
        texture.descriptor.dimension,
        this.backend,
        error
    )
}

trusted fun GraphicsApplication.sampledTextureViewEntry(
    binding: int,
    visibility: int,
    view: GraphicsTextureView,
    sampler: GraphicsSampler
): GraphicsBindingEntry {
    var error = GraphicsError()
    val validation = view.descriptor.validation(view.texture)
    val dimension = view.descriptor.resolvedDimension(view.texture)
    val format = view.descriptor.resolvedFormat(view.texture)
    if (!this.valid() || !view.valid() || !sampler.valid() ||
        !this.ownsTextureView(view) || !this.ownsSampler(sampler) ||
        !validation.succeeded || binding < 0 || binding > 31 ||
        !graphicsBindingVisibilityValid(visibility) ||
        (view.texture.usage & textureUsageSampled) == 0 ||
        view.texture.samples != 1 || textureFormatHasDepth(format)) {
        error = GraphicsError(
            graphicsErrorInvalidConfiguration,
            "GraphicsApplication.sampledTextureViewEntry",
            "sampled texture-view entries require an owned single-sample color view, a binding from 0 to 31, and valid visibility"
        )
    }
    GraphicsBindingEntry(
        binding,
        graphicsBindingSampledTexture,
        visibility,
        if (this.backend == graphicsBackendOpenGl) view.openGl.handle else 0,
        if (this.backend == graphicsBackendOpenGl) sampler.openGl.handle else 0,
        0,
        if (this.backend == graphicsBackendVulkan) view.vulkan.handle else 0,
        if (this.backend == graphicsBackendVulkan) sampler.vulkan.handle else 0,
        0,
        0,
        0,
        view.texture,
        dimension,
        this.backend,
        error
    )
}

trusted fun GraphicsApplication.storageTextureEntry(
    binding: int,
    visibility: int,
    var texture: GraphicsTexture,
    access: int = graphicsStorageTextureWriteOnly
): GraphicsBindingEntry {
    var error = GraphicsError()
    val format = openGlTextureInternalFormat(texture.descriptor.format)
    var prepared = true
    if (this.backend == graphicsBackendVulkan && texture.valid() &&
        this.ownsTexture(texture)) {
        prepared = this.vulkanDevice.prepareStorageTexture(
            texture.vulkan,
            texture.descriptor
        )
    }
    if (!this.valid() || !texture.valid() || !this.ownsTexture(texture) ||
        binding < 0 || binding > 31 ||
        !graphicsBindingVisibilityValid(visibility) ||
        !graphicsStorageTextureAccessValid(access) ||
        !graphicsStorageTextureSupported(
            this.capabilities, texture.descriptor.format, visibility
        ) ||
        (texture.descriptor.usage & textureUsageStorage) == 0 ||
        texture.descriptor.dimension != textureDimension2D ||
        texture.descriptor.samples != 1 || texture.descriptor.mipLevels != 1 ||
        format == 0 || !prepared) {
        error = GraphicsError(
            graphicsErrorInvalidConfiguration,
            "GraphicsApplication.storageTextureEntry",
            "storage texture entries require an owned single-mip two-dimensional storage texture with a supported image format and stage, valid access, binding, and visibility"
        )
    }
    GraphicsBindingEntry(
        binding,
        graphicsBindingStorageTexture,
        visibility,
        if (this.backend == graphicsBackendOpenGl) texture.openGl.handle else 0,
        if (this.backend == graphicsBackendOpenGl) format else 0,
        if (this.backend == graphicsBackendVulkan) texture.vulkan.image else 0,
        0,
        0,
        0,
        if (this.backend == graphicsBackendOpenGl)
            graphicsStorageTextureOpenGlAccess(access) else 0,
        access,
        texture.descriptor,
        texture.descriptor.dimension,
        this.backend,
        error
    )
}

trusted fun GraphicsApplication.storageTextureViewEntry(
    binding: int,
    visibility: int,
    var texture: GraphicsTexture,
    view: GraphicsTextureView,
    access: int = graphicsStorageTextureWriteOnly
): GraphicsBindingEntry {
    var error = GraphicsError()
    val validation = view.descriptor.validation(texture.descriptor)
    val format = view.descriptor.resolvedFormat(texture.descriptor)
    val dimension = view.descriptor.resolvedDimension(texture.descriptor)
    var prepared = true
    if (this.backend == graphicsBackendVulkan && texture.valid() &&
        view.valid() && this.ownsTexture(texture) &&
        this.ownsTextureView(view)) {
        prepared = this.vulkanDevice.prepareStorageTexture(
            texture.vulkan,
            texture.descriptor,
            view.descriptor.baseMipLevel,
            view.descriptor.resolvedMipLevelCount(texture.descriptor),
            view.descriptor.baseArrayLayer,
            view.descriptor.resolvedArrayLayerCount(texture.descriptor)
        )
    }
    if (!this.valid() || !texture.valid() || !view.valid() ||
        !this.ownsTexture(texture) || !this.ownsTextureView(view) ||
        !validation.succeeded ||
        !textureDescriptorsStorageCompatible(
            view.texture, texture.descriptor
        ) || binding < 0 || binding > 31 ||
        !graphicsBindingVisibilityValid(visibility) ||
        !graphicsStorageTextureAccessValid(access) ||
        !graphicsStorageTextureSupported(
            this.capabilities, format, visibility
        ) ||
        (texture.descriptor.usage & textureUsageStorage) == 0 ||
        dimension != textureDimension2D || texture.descriptor.samples != 1 ||
        view.descriptor.resolvedMipLevelCount(texture.descriptor) != 1 ||
        view.descriptor.resolvedArrayLayerCount(texture.descriptor) != 1 ||
        !prepared) {
        error = GraphicsError(
            graphicsErrorInvalidConfiguration,
            "GraphicsApplication.storageTextureViewEntry",
            "storage texture-view entries require an owned one-mip, one-layer two-dimensional storage view with a supported image format and stage, matching parent texture, valid access, binding, and visibility"
        )
    }
    GraphicsBindingEntry(
        binding,
        graphicsBindingStorageTexture,
        visibility,
        if (this.backend == graphicsBackendOpenGl) view.openGl.handle else 0,
        if (this.backend == graphicsBackendOpenGl)
            openGlTextureInternalFormat(format) else 0,
        0,
        if (this.backend == graphicsBackendVulkan) view.vulkan.handle else 0,
        0,
        0,
        if (this.backend == graphicsBackendOpenGl)
            graphicsStorageTextureOpenGlAccess(access) else 0,
        access,
        TextureDescriptor(
            size = Extent3D(
                textureMipDimension(
                    texture.descriptor.size.width,
                    view.descriptor.baseMipLevel
                ),
                textureMipDimension(
                    texture.descriptor.size.height,
                    view.descriptor.baseMipLevel
                )
            ),
            dimension = dimension,
            format = format,
            usage = texture.descriptor.usage
        ),
        dimension,
        this.backend,
        error
    )
}

trusted fun GraphicsApplication.bufferBindingEntry(
    binding: int,
    visibility: int,
    buffer: GraphicsBuffer,
    kind: int
): GraphicsBindingEntry = this.bufferBindingRangeEntry(
    binding,
    visibility,
    buffer,
    kind,
    0,
    buffer.descriptor.size
)

trusted fun GraphicsApplication.bufferBindingRangeEntry(
    binding: int,
    visibility: int,
    buffer: GraphicsBuffer,
    kind: int,
    offset: int = 0,
    size: int = -1
): GraphicsBindingEntry {
    var error = GraphicsError()
    val requiredUsage = if (kind == graphicsBindingUniformBuffer)
        bufferUsageUniform
    else if (kind == graphicsBindingStorageBuffer) bufferUsageStorage
    else 0
    val byteCount = bufferCopyResolvedSize(
        offset,
        size,
        buffer.descriptor.size
    )
    val requiredAlignment = if (kind == graphicsBindingUniformBuffer)
        this.capabilities.limits.minimumUniformBufferOffsetAlignment
    else if (kind == graphicsBindingStorageBuffer)
        this.capabilities.limits.minimumStorageBufferOffsetAlignment
    else 0
    if (!this.valid() || !buffer.valid() || !this.ownsBuffer(buffer) ||
        binding < 0 || binding > 31 ||
        !graphicsBindingVisibilityValid(visibility) || requiredUsage == 0 ||
        (buffer.descriptor.usage & requiredUsage) == 0 ||
        offset < 0 || offset >= buffer.descriptor.size || byteCount <= 0 ||
        byteCount > buffer.descriptor.size - offset ||
        requiredAlignment <= 0 ||
        (offset & (requiredAlignment - 1)) != 0) {
        error = GraphicsError(
            graphicsErrorInvalidConfiguration,
            "GraphicsApplication.bufferBindingRangeEntry",
            "buffer entries require an aligned in-bounds range, matching usage, a binding from 0 to 31, and valid visibility"
        )
    }
    GraphicsBindingEntry(
        binding,
        kind,
        visibility,
        if (this.backend == graphicsBackendOpenGl) buffer.openGl.handle else 0,
        0,
        if (this.backend == graphicsBackendVulkan) buffer.vulkan.handle else 0,
        0,
        0,
        offset,
        byteCount,
        buffer.descriptor.size,
        TextureDescriptor(),
        textureDimensionUndefined,
        this.backend,
        error
    )
}

trusted fun GraphicsApplication.uniformBufferEntry(
    binding: int,
    visibility: int,
    buffer: GraphicsBuffer
): GraphicsBindingEntry = this.bufferBindingEntry(
    binding,
    visibility,
    buffer,
    graphicsBindingUniformBuffer
)

trusted fun GraphicsApplication.storageBufferEntry(
    binding: int,
    visibility: int,
    buffer: GraphicsBuffer
): GraphicsBindingEntry = this.bufferBindingEntry(
    binding,
    visibility,
    buffer,
    graphicsBindingStorageBuffer
)

trusted fun GraphicsApplication.uniformBufferRangeEntry(
    binding: int,
    visibility: int,
    buffer: GraphicsBuffer,
    offset: int = 0,
    size: int = -1
): GraphicsBindingEntry = this.bufferBindingRangeEntry(
    binding,
    visibility,
    buffer,
    graphicsBindingUniformBuffer,
    offset,
    size
)

trusted fun GraphicsApplication.storageBufferRangeEntry(
    binding: int,
    visibility: int,
    buffer: GraphicsBuffer,
    offset: int = 0,
    size: int = -1
): GraphicsBindingEntry = this.bufferBindingRangeEntry(
    binding,
    visibility,
    buffer,
    graphicsBindingStorageBuffer,
    offset,
    size
)

trusted fun GraphicsApplication.bindGroup(
    entries: array<GraphicsBindingEntry>
): GraphicsBindGroup {
    var error = GraphicsError()
    var valid = this.valid() && entries.size > 0 && entries.size <= 16
    var index = 0
    while (valid && index < entries.size) {
        valid = entries[index].valid() && entries[index].backend == this.backend
        var earlier = 0
        while (valid && earlier < index) {
            valid = entries[earlier].binding != entries[index].binding
            earlier = earlier + 1
        }
        index = index + 1
    }
    if (!valid) error = GraphicsError(
        graphicsErrorInvalidConfiguration,
        "GraphicsApplication.bindGroup",
        "bind groups require 1 to 16 valid, application-owned entries with unique binding numbers"
    )
    var vulkan = VulkanBindGroup(nativeNullPointer(), 0, 0, 0, [], 0)
    val openGlKinds: array<int> = []
    val openGlBindings: array<int> = []
    val openGlResources: array<int> = []
    val openGlOffsets: array<int> = []
    val openGlSizes: array<int> = []
    val openGlSamplers: array<int> = []
    if (valid && this.backend == graphicsBackendOpenGl) {
        index = 0
        while (index < entries.size) {
            openGlKinds.append(entries[index].kind)
            openGlBindings.append(entries[index].binding)
            openGlResources.append(entries[index].openGlResource)
            openGlOffsets.append(
                if (entries[index].kind != graphicsBindingSampledTexture &&
                    entries[index].kind != graphicsBindingStorageTexture &&
                    entries[index].offset == 0 &&
                    entries[index].size == entries[index].bufferSize)
                    -1
                else entries[index].offset
            )
            openGlSizes.append(entries[index].size)
            openGlSamplers.append(entries[index].openGlSampler)
            index = index + 1
        }
    }
    if (valid && this.backend == graphicsBackendVulkan) {
        val nativeEntries: array<VulkanBindingEntry> = []
        index = 0
        while (index < entries.size) {
            val entry = entries[index]
            nativeEntries.append(VulkanBindingEntry(
                entry.binding,
                if (entry.kind == graphicsBindingSampledTexture) 1
                else if (entry.kind == graphicsBindingStorageTexture) 3
                else if (entry.kind == graphicsBindingUniformBuffer) 6
                else 7,
                graphicsBindingVulkanStageFlags(entry.visibility),
                entry.vulkanResource,
                entry.vulkanSampler,
                entry.offset,
                entry.size,
                entry.texture,
                entry.vulkanView
            ))
            index = index + 1
        }
        vulkan = this.vulkanDevice.bindGroup(nativeEntries)
        if (!vulkan.valid()) error = GraphicsError(
            graphicsErrorDriverFailure,
            "VulkanDevice.bindGroup",
            "Vulkan bind-group creation failed"
        )
    }
    GraphicsBindGroup(
        entries,
        openGlKinds,
        openGlBindings,
        openGlResources,
        openGlOffsets,
        openGlSizes,
        openGlSamplers,
        if (this.backend == graphicsBackendOpenGl) this.openGl.display
            else nativeNullPointer(),
        if (this.backend == graphicsBackendOpenGl) this.openGl.context
            else nativeNullPointer(),
        move(vulkan),
        this.backend,
        error
    )
}

trusted fun GraphicsApplication.textureBinding(
    texture: GraphicsTexture,
    sampler: GraphicsSampler
): GraphicsBindGroup = this.bindGroup([
    this.sampledTextureEntry(
        0,
        shaderVisibilityFragment,
        texture,
        sampler
    )
])

trusted fun GraphicsApplication.textureViewBinding(
    view: GraphicsTextureView,
    sampler: GraphicsSampler
): GraphicsBindGroup = this.bindGroup([
    this.sampledTextureViewEntry(
        0,
        shaderVisibilityFragment,
        view,
        sampler
    )
])

trusted fun GraphicsApplication.textureUniformBinding(
    texture: GraphicsTexture,
    sampler: GraphicsSampler,
    uniform: GraphicsBuffer
): GraphicsBindGroup = this.bindGroup([
    this.sampledTextureEntry(
        0,
        shaderVisibilityFragment,
        texture,
        sampler
    ),
    this.uniformBufferEntry(1, shaderVisibilityVertex, uniform)
])

trusted fun GraphicsApplication.textureViewUniformBinding(
    view: GraphicsTextureView,
    sampler: GraphicsSampler,
    uniform: GraphicsBuffer
): GraphicsBindGroup = this.bindGroup([
    this.sampledTextureViewEntry(
        0,
        shaderVisibilityFragment,
        view,
        sampler
    ),
    this.uniformBufferEntry(1, shaderVisibilityVertex, uniform)
])
