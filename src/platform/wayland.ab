    trusted fun receiveNativeHeader(): bool {
        var succeeded = this.ensureWireStorage(this.seatIdentifier >= 2)
        if (succeeded && this.seatIdentifier < 2) succeeded =
            waylandNativeReadExact(
                this.connection.descriptor,
                this.wireScratch,
                0,
                8
            )
        var receivedTotal = 0
        while (succeeded && this.seatIdentifier >= 2 &&
            receivedTotal < 8) {
            val workspaceAddress = nativePointerAddress(
                this.ancillaryScratch.address
            )
            val wireAddress = nativePointerAddress(this.wireScratch.address)
            this.ancillaryScratch.storeI64(
                0,
                wireAddress + receivedTotal
            )
            this.ancillaryScratch.storeI64(8, 8 - receivedTotal)
            this.ancillaryScratch.storeI64(16, 0)
            this.ancillaryScratch.storeI64(24, 0)
            this.ancillaryScratch.storeI64(32, 0)
            this.ancillaryScratch.storeI64(40, 0)
            this.ancillaryScratch.storeI64(48, 0)
            this.ancillaryScratch.storeI64(56, workspaceAddress)
            this.ancillaryScratch.storeI64(64, 1)
            this.ancillaryScratch.storeI64(72, workspaceAddress + 16)
            this.ancillaryScratch.storeI64(80, 24)
            this.ancillaryScratch.storeI64(88, 0)
            var received = linuxSyscall3(
                47,
                this.connection.descriptor,
                workspaceAddress + 40,
                1073741824
            )
            while (received == -4) {
                received = linuxSyscall3(
                    47,
                    this.connection.descriptor,
                    workspaceAddress + 40,
                    1073741824
                )
            }
            succeeded = received > 0 && received <= 8 - receivedTotal
            if (succeeded) {
                val controlLength = this.ancillaryScratch.loadI64(80)
                val flags = this.ancillaryScratch.loadI64(88) & 4294967295
                if (controlLength > 0) {
                    val descriptor =
                        this.ancillaryScratch.loadI64(32) & 4294967295
                    succeeded = this.receivedDescriptor < 0 &&
                        controlLength >= 20 && controlLength <= 24 &&
                        this.ancillaryScratch.loadI64(16) == 20 &&
                        this.ancillaryScratch.loadI64(24) == 4294967297 &&
                        (flags & 8) == 0 && descriptor >= 0 &&
                        descriptor <= 2147483647
                    if (succeeded) this.receivedDescriptor = descriptor
                    else if (descriptor <= 2147483647) {
                        linuxSyscall1(3, descriptor)
                    }
                }
            }
            if (succeeded) receivedTotal = receivedTotal + received
        }
        if (!succeeded && this.receivedDescriptor >= 0) {
            linuxSyscall1(3, this.receivedDescriptor)
            this.receivedDescriptor = -1
        }
