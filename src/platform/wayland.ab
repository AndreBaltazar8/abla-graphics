                7,
                nativePointerAddress(this.wireScratch.address),
                1,
                timeoutMilliseconds
            )
            while (measured == -4) {
                measured = linuxSyscall3(
                    7,
                    nativePointerAddress(this.wireScratch.address),
                    1,
                    timeoutMilliseconds
