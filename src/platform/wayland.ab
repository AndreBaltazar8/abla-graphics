    trusted fun pollProtocol(timeoutMilliseconds: int = 0): bool {
        var succeeded = this.connection.valid() &&
            timeoutMilliseconds >= 0 &&
            timeoutMilliseconds <= waylandMaximumRepeatDelayMilliseconds &&
            this.ensureWireStorage(this.seatIdentifier >= 2)
