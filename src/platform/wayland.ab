            this.relativePointerManagerIdentifier = relativeManager.identifier
            this.relativePointerIdentifier = relativeIdentifier
            this.pointerConstraintsIdentifier = constraints.identifier
        }
        succeeded
    }

    fun setPointerCaptured(captured: bool): bool {
        var succeeded = this.valid() && this.pointerIdentifier >= 2
        if (succeeded && captured != this.pointerCaptured && captured) {
            if (this.relativePointerIdentifier == 0) {
                succeeded = this.enablePointerCaptureProtocol()
            }
            val identifier = if (succeeded)
                this.connection.allocateIdentifier()
            else -1
            val request = if (succeeded) waylandPointerLockRequest(
                this.pointerConstraintsIdentifier,
                identifier,
                this.surfaceIdentifier,
                this.pointerIdentifier
