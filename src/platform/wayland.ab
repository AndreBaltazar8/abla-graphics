            if (succeeded) succeeded = request != "" &&
                this.connection.send(request)
            if (succeeded) succeeded = this.commit()
            if (succeeded) {
                this.lockedPointerIdentifier = identifier
                this.pointerCaptured = true
                this.pointerCaptureActive = false
                this.relativePointerXFixed =
                    this.pointerX * waylandFixedDenominator
                this.relativePointerYFixed =
                    this.pointerY * waylandFixedDenominator
