            (capabilities & waylandSeatCapabilityPointer) == 0) {
            if (this.relativePointerIdentifier >= 2) {
                succeeded = this.disablePointerCaptureProtocol()
            }
        }
        if (succeeded && this.pointerIdentifier >= 2 &&
            (capabilities & waylandSeatCapabilityPointer) == 0) {
            succeeded = this.connection.send(
                waylandPacket(this.pointerIdentifier, 1)
            )
            if (succeeded) {
                this.pointerIdentifier = 0
                this.pointerFocused = false
                this.pointerEnterSerial = 0
            }
        }
        if (succeeded && this.keyboardIdentifier >= 2 &&
            (capabilities & waylandSeatCapabilityKeyboard) == 0) {
            succeeded = this.connection.send(
                waylandPacket(this.keyboardIdentifier, 0)
            )
            if (succeeded) {
                this.keyboardIdentifier = 0
                this.keyboardFocused = false
                this.cancelKeyRepeat()
            }
        }
        if (succeeded && this.pointerIdentifier == 0 &&
            (capabilities & waylandSeatCapabilityPointer) != 0) {
            val identifier = this.connection.allocateIdentifier()
            succeeded = identifier >= 2 && this.connection.send(
                waylandNewIdentifierRequest(
                    this.seatIdentifier,
                    0,
                    identifier
                )
            )
            if (succeeded) this.pointerIdentifier = identifier
        }
        if (succeeded && this.keyboardIdentifier == 0 &&
            (capabilities & waylandSeatCapabilityKeyboard) != 0) {
            val identifier = this.connection.allocateIdentifier()
            succeeded = identifier >= 2 && this.connection.send(
                waylandNewIdentifierRequest(
                    this.seatIdentifier,
                    1,
                    identifier
                )
            )
            if (succeeded) this.keyboardIdentifier = identifier
        }
        if (succeeded) {
            this.seatCapabilities = capabilities
            this.seatCapabilitiesReceived = true
        }
        succeeded
    }

    trusted fun enableInput(): bool {
        var succeeded = this.valid() && this.seatIdentifier == 0 &&
            this.ensureWireStorage(true)
        val seat = if (succeeded)
            this.connection.bind("wl_seat", 7)
        else WaylandBinding()
        succeeded = succeeded && seat.valid
        if (succeeded) {
            this.seatIdentifier = seat.identifier
            this.seatVersion = seat.version
        }
        var messages = 0
        while (succeeded && !this.seatCapabilitiesReceived &&
            messages < 16384) {
            succeeded = this.dispatchNative()
            messages = messages + 1
        }
        succeeded && this.seatCapabilitiesReceived
    }

    fun clipboardOfferIndex(identifier: int): int {
        var result = -1
