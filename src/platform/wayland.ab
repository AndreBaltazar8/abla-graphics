        } else if (succeeded && captured != this.pointerCaptured) {
            succeeded = this.lockedPointerIdentifier >= 2 &&
                this.retiredLockedPointerIdentifiers.size < 4096 &&
                this.connection.send(waylandPacket(
                    this.lockedPointerIdentifier,
                    0
                ))
