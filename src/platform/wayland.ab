            succeeded = measured >= 0
            if (succeeded && measured > 0) {
                succeeded = (this.wireScratch.load(6) & 25) != 0 &&
                    this.dispatchNative()
            }
        }
        succeeded
    }

    trusted fun drawCursorPixels(address: int): bool {
        var succeeded = address > 0
        var y = 0
        while (succeeded && y < waylandCursorHeight) {
            var x = 0
            while (x < waylandCursorWidth) {
                val triangle = y < 18 && x <= y / 2
                val stem = y >= 10 && y < 23 && x >= 4 && x <= 7
                val visible = triangle || stem
                val outline = visible && (
                    x == 0 || (triangle && x == y / 2) ||
                    (triangle && y == 17) ||
                    (stem && (x == 4 || x == 7 || y == 22))
                )
                val color = if (outline) 12 else 244
                val pixel = nativePointerFromAddress(
                    address + (y * waylandCursorWidth + x) * 4
                )
                ablaUnsafeStoreU8(pixel, if (visible) color else 0)
                ablaUnsafeStoreU8(
                    ablaUnsafePointerOffset(pixel, 1),
                    if (visible) color else 0
                )
                ablaUnsafeStoreU8(
                    ablaUnsafePointerOffset(pixel, 2),
                    if (visible) color else 0
                )
                ablaUnsafeStoreU8(
                    ablaUnsafePointerOffset(pixel, 3),
                    if (visible) 255 else 0
                )
                x = x + 1
            }
            y = y + 1
        }
        succeeded
    }

    fun applyCursor(): bool {
        val surface = if (this.cursorVisible)
            this.cursorSurfaceIdentifier
        else 0
        val request = waylandPointerCursorRequest(
            this.pointerIdentifier,
            this.pointerEnterSerial,
            surface,
            0,
            0
