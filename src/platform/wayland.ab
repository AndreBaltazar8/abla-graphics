    fun enableClipboard(): bool {
        var succeeded = this.valid()
        if (succeeded && this.seatIdentifier == 0) {
            succeeded = this.enableInput()
        }
        if (succeeded && this.dataDeviceIdentifier == 0) {
            val manager = this.connection.bind(
                "wl_data_device_manager",
                3
