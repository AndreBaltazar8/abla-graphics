    fun dispatchRelativePointer(message: WaylandMessage): int {
        var result = 0
        if (message.objectIdentifier == this.relativePointerIdentifier &&
            message.opcode == 0) {
            result = if (message.payload.size == 24) 1 else -1
            if (result > 0 && this.pointerCaptureActive) {
                val dx = waylandSignedU32(waylandU32(message.payload, 8))
                val dy = waylandSignedU32(waylandU32(message.payload, 12))
                val xSafe = if (dx >= 0)
                    this.relativePointerXFixed <= waylandMaximumInteger - dx
                else this.relativePointerXFixed >=
                    -waylandMaximumInteger - dx
                val ySafe = if (dy >= 0)
                    this.relativePointerYFixed <= waylandMaximumInteger - dy
                else this.relativePointerYFixed >=
                    -waylandMaximumInteger - dy
                result = if (xSafe && ySafe &&
                    this.relativeMotionEvents < waylandMaximumInteger) 1
                else -1
                if (result > 0) {
                    this.lastRelativeXFixed = dx
                    this.lastRelativeYFixed = dy
                    this.lastRelativeUnacceleratedXFixed = waylandSignedU32(
                        waylandU32(message.payload, 16)
                    )
                    this.lastRelativeUnacceleratedYFixed = waylandSignedU32(
                        waylandU32(message.payload, 20)
                    )
                    this.relativePointerXFixed =
                        this.relativePointerXFixed + dx
                    this.relativePointerYFixed =
                        this.relativePointerYFixed + dy
                    this.pointerX = this.relativePointerXFixed /
                        waylandFixedDenominator
                    this.pointerY = this.relativePointerYFixed /
                        waylandFixedDenominator
                    this.relativeMotionEvents = this.relativeMotionEvents + 1
                    if (!this.enqueueInputEvent(WindowEvent(
                        windowEventPointerMoved,
                        this.pointerX,
                        this.pointerY,
                        "",
                        1
                    ))) result = -1
                }
            }
        }
        result
    }

    fun dispatchLockedPointer(message: WaylandMessage): int {
        var result = 0
        if (message.objectIdentifier == this.lockedPointerIdentifier &&
            (message.opcode == 0 || message.opcode == 1)) {
            result = if (message.payload.size == 0) 1 else -1
            if (result > 0) this.pointerCaptureActive = message.opcode == 0
        } else if (this.retiredLockedPointerIndex(
            message.objectIdentifier
        ) >= 0 && (message.opcode == 0 || message.opcode == 1)) {
            result = if (message.payload.size == 0) 1 else -1
        }
        result
    }

    fun updateSeatCapabilities(capabilities: int): bool {
        var succeeded = this.connection.valid() &&
            this.seatIdentifier >= 2 && capabilities >= 0 &&
            capabilities <= 7
