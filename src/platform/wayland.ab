// Wayland wire-protocol foundation implemented entirely in Abla.
//
// This module connects to the compositor's AF_UNIX stream directly. It does
// not use libwayland-client, GLFW, SDL, or a project native shim.

import "abla/sys/linux"
import "abla/sys/linux/fs"
import "abla/sys/linux/process"
import "abla/unsafe/memory"
import "../window.ab"
import "xkb.ab"

val waylandDisplayIdentifier = 1
val waylandMaximumMessageBytes = 65532
val waylandMaximumGlobals = 4096
val waylandSeatCapabilityPointer = 1
val waylandSeatCapabilityKeyboard = 2
val waylandMaximumRepeatRate = 1000
val waylandMaximumRepeatDelayMilliseconds = 600000
val waylandMaximumClipboardBytes = 1048576
val waylandClipboardTransferTimeoutMilliseconds = 5000
val waylandCursorWidth = 16
val waylandCursorHeight = 24
val waylandPointerConstraintPersistent = 2
val waylandClipboardMimeUtf8 = "text/plain;charset=utf-8"
val waylandClipboardMimeText = "text/plain"
val waylandToplevelStateMaximized = 1
val waylandToplevelStateFullscreen = 2
val waylandToplevelStateResizing = 3
val waylandToplevelStateActivated = 4
val waylandFixedDenominator = 256
val waylandFixedMaximum = 2147483647
val waylandFixedMaximumInteger = 8388607
val waylandFixedUnset = -256
val waylandFractionalScaleDenominator = 120
val waylandMaximumFractionalScale = 7680
val waylandNanosecondsPerMillisecond = 1000000
val waylandNanosecondsPerSecond = 1000000000
val waylandMaximumInteger = 9223372036854775807

fun waylandKeyFromEvdev(code: int): int {
    var key = keyUnknown
    if (code >= 2 && code <= 10) key = key1 + code - 2
    else if (code == 11) key = key0
    else if (code == 16) key = keyQ
    else if (code == 17) key = keyW
    else if (code == 18) key = keyE
    else if (code == 19) key = keyR
    else if (code == 20) key = keyT
    else if (code == 21) key = keyY
    else if (code == 22) key = keyU
    else if (code == 23) key = keyI
    else if (code == 24) key = keyO
    else if (code == 25) key = keyP
    else if (code == 30) key = keyA
    else if (code == 31) key = keyS
    else if (code == 32) key = keyD
    else if (code == 33) key = keyF
    else if (code == 34) key = keyG
    else if (code == 35) key = keyH
    else if (code == 36) key = keyJ
    else if (code == 37) key = keyK
    else if (code == 38) key = keyL
    else if (code == 44) key = keyZ
    else if (code == 45) key = keyX
    else if (code == 46) key = keyC
    else if (code == 47) key = keyV
    else if (code == 48) key = keyB
    else if (code == 49) key = keyN
    else if (code == 50) key = keyM
    else if (code >= 59 && code <= 68) key = keyF1 + code - 59
    else if (code == 87) key = keyF11
    else if (code == 88) key = keyF12
    else if (code == 1) key = keyEscape
    else if (code == 12) key = keyMinus
    else if (code == 13) key = keyEqual
    else if (code == 14) key = keyBackspace
    else if (code == 15) key = keyTab
    else if (code == 26) key = keyLeftBracket
    else if (code == 27) key = keyRightBracket
    else if (code == 28) key = keyEnter
    else if (code == 29) key = keyLeftControl
    else if (code == 39) key = keySemicolon
    else if (code == 40) key = keyApostrophe
    else if (code == 41) key = keyGraveAccent
    else if (code == 42) key = keyLeftShift
    else if (code == 43) key = keyBackslash
    else if (code == 51) key = keyComma
    else if (code == 52) key = keyPeriod
    else if (code == 53) key = keySlash
    else if (code == 54) key = keyRightShift
    else if (code == 55) key = keyKpMultiply
    else if (code == 56) key = keyLeftAlt
    else if (code == 57) key = keySpace
    else if (code == 58) key = keyCapsLock
    else if (code == 69) key = keyNumLock
    else if (code == 70) key = keyScrollLock
    else if (code >= 71 && code <= 73) key = keyKp7 + code - 71
    else if (code == 74) key = keyKpSubtract
    else if (code >= 75 && code <= 77) key = keyKp4 + code - 75
    else if (code == 78) key = keyKpAdd
    else if (code >= 79 && code <= 81) key = keyKp1 + code - 79
    else if (code == 82) key = keyKp0
    else if (code == 83) key = keyKpDecimal
    else if (code == 96) key = keyKpEnter
    else if (code == 97) key = keyRightControl
    else if (code == 98) key = keyKpDivide
    else if (code == 100) key = keyRightAlt
    else if (code == 102) key = keyHome
    else if (code == 103) key = keyUp
    else if (code == 104) key = keyPageUp
    else if (code == 105) key = keyLeft
    else if (code == 106) key = keyRight
    else if (code == 107) key = keyEnd
    else if (code == 108) key = keyDown
    else if (code == 109) key = keyPageDown
    else if (code == 110) key = keyInsert
    else if (code == 111) key = keyDelete
    else if (code == 125) key = keyLeftSuper
    else if (code == 126) key = keyRightSuper
    else if (code == 127) key = keyMenu
    key
}

fun waylandPointerButton(code: int): int {
    var button = pointerButtonUnknown
    if (code == 272) button = pointerButtonLeft
    else if (code == 273) button = pointerButtonRight
    else if (code == 274) button = pointerButtonMiddle
    else if (code == 275) button = pointerButtonBack
    else if (code == 276) button = pointerButtonForward
    button
}

fun waylandSignedU32(value: int): int =
    if (value >= 2147483648) value - 4294967296 else value

fun waylandFixedInteger(value: int): int =
    waylandSignedU32(value) / waylandFixedDenominator

fun waylandKeyRepeatable(key: int): bool = key != keyUnknown &&
    key != keyCapsLock && key != keyScrollLock && key != keyNumLock &&
    key != keyPrintScreen && key != keyPause &&
    key != keyLeftShift && key != keyRightShift &&
    key != keyLeftControl && key != keyRightControl &&
    key != keyLeftAlt && key != keyRightAlt &&
    key != keyLeftSuper && key != keyRightSuper && key != keyMenu

fun waylandRepeatPeriodNanoseconds(rate: int): int =
    if (rate >= 1 && rate <= waylandMaximumRepeatRate)
        waylandNanosecondsPerSecond / rate
    else 0

fun waylandRepeatPollTimeout(
    requestedMilliseconds: int,
    deadlineNanoseconds: int,
    nowNanoseconds: int
): int {
    var result = requestedMilliseconds
    if (requestedMilliseconds >= 0 && deadlineNanoseconds >= 0 &&
        nowNanoseconds > 0) {
        val remaining = deadlineNanoseconds - nowNanoseconds
        val wholeMilliseconds = if (remaining > 0)
            remaining / waylandNanosecondsPerMillisecond
        else 0
        val repeatWait = if (remaining <= 0) 0
        else if (remaining - wholeMilliseconds *
            waylandNanosecondsPerMillisecond > 0)
            wholeMilliseconds + 1
        else wholeMilliseconds
        if (repeatWait < result) result = repeatWait
    }
    result
}

fun waylandContainsState(states: array<int>, state: int): bool {
    var found = false
    var index = 0
    while (!found && index < states.size) {
        found = states[index] == state
        index = index + 1
    }
    found
}

fun waylandScaledDimension(logical: int, scale: int): int =
    if (logical > 0 && logical <= 65536 && scale >= 1 &&
        scale <= waylandMaximumFractionalScale)
        (logical * scale + waylandFractionalScaleDenominator / 2) /
            waylandFractionalScaleDenominator
    else 0

fun waylandU32(value: string, offset: int): int =
    value[offset] + value[offset + 1] * 256 +
    value[offset + 2] * 65536 + value[offset + 3] * 16777216

fun waylandStoreU32(
    var buffer: NativeByteBuffer,
    offset: int,
    value: int
): void {
    buffer.store(offset, value & 255)
    buffer.store(offset + 1, (value >>> 8) & 255)
    buffer.store(offset + 2, (value >>> 16) & 255)
    buffer.store(offset + 3, (value >>> 24) & 255)
    return
}

trusted fun waylandNativeU32(
    var buffer: NativeByteBuffer,
    offset: int
): int = buffer.load(offset) + buffer.load(offset + 1) * 256 +
    buffer.load(offset + 2) * 65536 +
    buffer.load(offset + 3) * 16777216

trusted fun waylandStoreNativeHeader(
    var buffer: NativeByteBuffer,
    offset: int,
    objectIdentifier: int,
    opcode: int,
    length: int
): bool {
    val valid = !buffer.closed && objectIdentifier > 0 &&
        opcode >= 0 && opcode <= 65535 && length >= 8 &&
        length <= waylandMaximumMessageBytes &&
        (length / 4) * 4 == length &&
        offset >= 0 && offset + length <= buffer.capacity
    if (valid) {
        waylandStoreU32(buffer, offset, objectIdentifier)
        waylandStoreU32(buffer, offset + 4, (length << 16) | opcode)
    }
    valid
}

trusted fun waylandNativeWriteAll(
    descriptor: int,
    var buffer: NativeByteBuffer,
    offset: int,
    length: int
): bool {
    var writtenTotal = 0
    var succeeded = descriptor >= 0 && !buffer.closed && offset >= 0 &&
        length >= 0 && offset + length <= buffer.capacity
    val address = nativePointerAddress(buffer.address)
    while (succeeded && writtenTotal < length) {
        // Linux x86-64 sendto with MSG_NOSIGNAL on the connected stream.
        var written = linuxSyscall6(
            44,
            descriptor,
            address + offset + writtenTotal,
            length - writtenTotal,
            16384,
            0,
            0
        )
        while (written == -4) {
            written = linuxSyscall6(
                44,
                descriptor,
                address + offset + writtenTotal,
                length - writtenTotal,
                16384,
                0,
                0
            )
        }
        if (written <= 0) succeeded = false
        else writtenTotal = writtenTotal + written
    }
    succeeded
}

trusted fun waylandNativeReadExact(
    descriptor: int,
    var buffer: NativeByteBuffer,
    offset: int,
    length: int
): bool {
    var readTotal = 0
    var succeeded = descriptor >= 0 && !buffer.closed && offset >= 0 &&
        length >= 0 && offset + length <= buffer.capacity
    val address = nativePointerAddress(buffer.address)
    while (succeeded && readTotal < length) {
        var received = linuxSyscall3(
            0,
            descriptor,
            address + offset + readTotal,
            length - readTotal
        )
        while (received == -4) {
            received = linuxSyscall3(
                0,
                descriptor,
                address + offset + readTotal,
                length - readTotal
            )
        }
        if (received <= 0) succeeded = false
        else readTotal = readTotal + received
    }
    succeeded
}

fun waylandAligned(length: int): int = ((length + 3) / 4) * 4

fun waylandWriteAll(descriptor: int, value: string): bool {
    var offset = 0
    var succeeded = descriptor >= 0
    while (succeeded && offset < value.size) {
        val written = linuxWrite(
            descriptor,
            value.slice(offset, value.size)
        )
        if (written <= 0) succeeded = false
        else offset = offset + written
    }
    succeeded
}

fun waylandReadExact(descriptor: int, length: int): string {
    var result = ""
    var reading = descriptor >= 0 && length >= 0 &&
        length <= waylandMaximumMessageBytes
    while (reading && result.size < length) {
        val part = LinuxFileDescriptor(descriptor).read(length - result.size)
        if (part.size == 0) reading = false
        else result = "$result$part"
    }
    if (result.size == length) result else ""
}

fun waylandPacket(
    objectIdentifier: int,
    opcode: int,
    payload: string = ""
): string {
    val length = 8 + payload.size
    var result = ""
    if (objectIdentifier > 0 && opcode >= 0 && opcode <= 65535 &&
        length >= 8 && length <= waylandMaximumMessageBytes &&
        (length / 4) * 4 == length) {
        val packet = nativeByteBuffer(length + 1)
        waylandStoreU32(packet, 0, objectIdentifier)
        waylandStoreU32(packet, 4, (length << 16) | opcode)
        var index = 0
        while (index < payload.size) {
            packet.store(8 + index, payload[index])
            index = index + 1
        }
        result = packet.adoptString(length)
    }
    result
}

fun waylandU32Payload(value: int): string {
    val payload = nativeByteBuffer(5)
    waylandStoreU32(payload, 0, value)
    payload.adoptString(4)
}

fun waylandU32PairPayload(first: int, second: int): string {
    val payload = nativeByteBuffer(9)
    waylandStoreU32(payload, 0, first)
    waylandStoreU32(payload, 4, second)
    payload.adoptString(8)
}

fun waylandU32ArrayPayload(values: array<int>): string {
    var result = ""
    if (values.size <= (waylandMaximumMessageBytes - 8) / 4) {
        val payload = nativeByteBuffer(values.size * 4 + 1)
        var index = 0
        while (index < values.size) {
            waylandStoreU32(payload, index * 4, values[index])
            index = index + 1
        }
        result = payload.adoptString(values.size * 4)
    }
    result
}

fun waylandPointerCursorRequest(
    pointerIdentifier: int,
    serial: int,
    surfaceIdentifier: int,
    hotspotX: int,
    hotspotY: int
): string = if (pointerIdentifier >= 2 && serial > 0 &&
    surfaceIdentifier >= 0)
        waylandPacket(
            pointerIdentifier,
            0,
            waylandU32ArrayPayload([
                serial,
                surfaceIdentifier,
                hotspotX,
                hotspotY
            ])
        )
    else ""

fun waylandRelativePointerRequest(
    managerIdentifier: int,
    relativePointerIdentifier: int,
    pointerIdentifier: int
): string = if (managerIdentifier >= 2 &&
    relativePointerIdentifier >= 2 && pointerIdentifier >= 2)
        waylandPacket(
            managerIdentifier,
            1,
            waylandU32PairPayload(
                relativePointerIdentifier,
                pointerIdentifier
            )
        )
    else ""

fun waylandPointerLockRequest(
    managerIdentifier: int,
    lockIdentifier: int,
    surfaceIdentifier: int,
    pointerIdentifier: int
): string = if (managerIdentifier >= 2 && lockIdentifier >= 2 &&
    surfaceIdentifier >= 2 && pointerIdentifier >= 2)
        waylandPacket(
            managerIdentifier,
            1,
            waylandU32ArrayPayload([
                lockIdentifier,
                surfaceIdentifier,
                pointerIdentifier,
                0,
                waylandPointerConstraintPersistent
            ])
        )
    else ""

// Linux x86-64 sendmsg with one SCM_RIGHTS descriptor. Wayland file
// descriptor arguments travel out-of-band and consume no wire payload bytes.
fun waylandSendDescriptor(
    socketDescriptor: int,
    packet: string,
    passedDescriptor: int
): bool {
    var succeeded = socketDescriptor >= 0 && packet != "" &&
        passedDescriptor >= 0
    var sent = -1
    if (succeeded) {
        // iovec[0..15], cmsghdr/control[16..39], msghdr[40..95].
        val workspace = nativeByteBuffer(96)
        val address = nativePointerAddress(workspace.address)
        workspace.storeI64(0, nativeCStringAddress(packet))
        workspace.storeI64(8, packet.size)
        workspace.storeI64(16, 20)
        workspace.storeI64(24, 4294967297)
        workspace.storeI64(32, passedDescriptor)
        workspace.storeI64(40, 0)
        workspace.storeI64(48, 0)
        workspace.storeI64(56, address)
        workspace.storeI64(64, 1)
        workspace.storeI64(72, address + 16)
        workspace.storeI64(80, 24)
        workspace.storeI64(88, 0)
        sent = linuxSyscall3(46, socketDescriptor, address + 40, 16384)
        while (sent == -4) {
            sent = linuxSyscall3(46, socketDescriptor, address + 40, 16384)
        }
        workspace.close()
        succeeded = sent > 0 && sent <= packet.size
    }
    if (succeeded && sent < packet.size) succeeded = waylandWriteAll(
        socketDescriptor,
        packet.slice(sent, packet.size)
    )
    succeeded
}

class WaylandClipboardRead(
    val succeeded: bool = false,
    val text: string = ""
)

trusted fun waylandReadDescriptorText(
    descriptor: int,
    maximum: int = waylandMaximumClipboardBytes
): WaylandClipboardRead {
    var result = ""
    var succeeded = descriptor >= 0 && maximum >= 0 &&
        maximum <= waylandMaximumClipboardBytes
    val bytes = nativeByteBuffer(maximum + 1)
    val poll = nativeByteBuffer(8)
    var measured = 0
    var complete = false
    while (succeeded && !complete && measured <= maximum) {
        waylandStoreU32(poll, 0, descriptor)
        poll.store(4, 1)
        poll.store(5, 0)
        poll.store(6, 0)
        poll.store(7, 0)
        var ready = linuxSyscall3(
            7,
            nativePointerAddress(poll.address),
            1,
            waylandClipboardTransferTimeoutMilliseconds
        )
        while (ready == -4) {
            ready = linuxSyscall3(
                7,
                nativePointerAddress(poll.address),
                1,
                waylandClipboardTransferTimeoutMilliseconds
            )
        }
        succeeded = ready > 0 && (poll.load(6) & 25) != 0
        if (succeeded) {
            var amount = linuxSyscall3(
                0,
                descriptor,
                nativePointerAddress(bytes.pointerAt(measured)),
                maximum + 1 - measured
            )
            while (amount == -4) {
                amount = linuxSyscall3(
                    0,
                    descriptor,
                    nativePointerAddress(bytes.pointerAt(measured)),
                    maximum + 1 - measured
                )
            }
            succeeded = amount >= 0
            if (amount == 0) complete = true
            else if (amount > 0) measured = measured + amount
        }
    }
    succeeded = succeeded && complete && measured <= maximum
    poll.close()
    if (succeeded) result = bytes.adoptString(measured)
    else bytes.close()
    WaylandClipboardRead(succeeded, result)
}

fun waylandStringPayload(value: string): string {
    var valid = value.size <= 4096
    var index = 0
    while (valid && index < value.size) {
        valid = value[index] != 0
        index = index + 1
    }
    val length = value.size + 1
    val padded = waylandAligned(length)
    var result = ""
    if (valid && padded + 4 <= waylandMaximumMessageBytes - 8) {
        val payload = nativeByteBuffer(padded + 5)
        waylandStoreU32(payload, 0, length)
        index = 0
        while (index < value.size) {
            payload.store(4 + index, value[index])
            index = index + 1
        }
        payload.store(4 + value.size, 0)
        result = payload.adoptString(4 + padded)
    }
    result
}

fun waylandStringRequest(
    objectIdentifier: int,
    opcode: int,
    value: string
): string {
    val payload = waylandStringPayload(value)
    if (payload != "")
        waylandPacket(objectIdentifier, opcode, payload)
    else ""
}

fun waylandNewIdentifierRequest(
    objectIdentifier: int,
    opcode: int,
    newIdentifier: int
): string = waylandPacket(
    objectIdentifier,
    opcode,
    waylandU32Payload(newIdentifier)
)

class WaylandString(
    val valid: bool,
    val text: string = "",
    val next: int = 0
)

fun waylandString(value: string, offset: int): WaylandString {
    var valid = offset >= 0 && offset + 4 <= value.size
    val length = if (valid) waylandU32(value, offset) else 0
    val padded = if (length >= 0) waylandAligned(length) else 0
    valid = valid && length > 0 && length <= 4097 &&
        padded >= length && offset + 4 + padded <= value.size &&
        value[offset + 4 + length - 1] == 0
    var index = 0
    while (valid && index + 1 < length) {
        valid = value[offset + 4 + index] != 0
        index = index + 1
    }
    val text = if (valid)
        value.slice(offset + 4, offset + 4 + length - 1)
    else ""
    WaylandString(valid, text, if (valid) offset + 4 + padded else offset)
}

fun waylandNullableStringPayloadValid(value: string): bool {
    val parsed = waylandString(value, 0)
    (value.size == 4 && waylandU32(value, 0) == 0) ||
        (parsed.valid && parsed.next == value.size)
}

class WaylandMessage(
    val valid: bool,
    val objectIdentifier: int = 0,
    val opcode: int = 0,
    val payload: string = ""
)

fun waylandDecodeMessage(value: string): WaylandMessage {
    var valid = value.size >= 8 && value.size <= waylandMaximumMessageBytes &&
        (value.size / 4) * 4 == value.size
    val objectIdentifier = if (valid) waylandU32(value, 0) else 0
    val descriptor = if (valid) waylandU32(value, 4) else 0
    val length = (descriptor >>> 16) & 65535
    val opcode = descriptor & 65535
    valid = valid && objectIdentifier > 0 && length == value.size
    WaylandMessage(
        valid,
        objectIdentifier,
        opcode,
        if (valid) value.slice(8, value.size) else ""
    )
}

fun waylandReadMessage(descriptor: int): WaylandMessage {
    val header = waylandReadExact(descriptor, 8)
    var valid = header.size == 8
    val messageWord = if (valid) waylandU32(header, 4) else 0
    val length = (messageWord >>> 16) & 65535
    valid = valid && length >= 8 && length <= waylandMaximumMessageBytes &&
        (length / 4) * 4 == length
    val payload = if (valid)
        waylandReadExact(descriptor, length - 8)
    else ""
    valid = valid && payload.size == length - 8
    waylandDecodeMessage(if (valid) "$header$payload" else "")
}

class WaylandGlobal(
    val valid: bool = false,
    val name: int = 0,
    val interfaceName: string = "",
    val version: int = 0
)

fun waylandRegistryGlobal(payload: string): WaylandGlobal {
    val hasName = payload.size >= 4
    val name = if (hasName) waylandU32(payload, 0) else 0
    val parsedInterface = waylandString(payload, 4)
    val valid = hasName && name > 0 && parsedInterface.valid &&
        parsedInterface.next + 4 == payload.size
    val version = if (valid) waylandU32(payload, parsedInterface.next) else 0
    WaylandGlobal(
        valid && parsedInterface.text != "" && version > 0,
        name,
        parsedInterface.text,
        version
    )
}

class WaylandBinding(
    val valid: bool = false,
    val identifier: int = 0,
    val name: int = 0,
    val interfaceName: string = "",
    val version: int = 0
)

class WaylandDataOffer(
    val identifier: int = 0,
    val mimeTypes: array<string> = []
) {
    fun valid(): bool = this.identifier > 0

    fun hasMime(mimeType: string): bool {
        var found = false
        var index = 0
        while (!found && index < this.mimeTypes.size) {
            found = this.mimeTypes[index] == mimeType
            index = index + 1
        }
        found
    }

    fun textMime(): string =
        if (this.hasMime(waylandClipboardMimeUtf8)) waylandClipboardMimeUtf8
        else if (this.hasMime(waylandClipboardMimeText)) waylandClipboardMimeText
        else ""

    fun withMime(mimeType: string): WaylandDataOffer {
        val retained: array<string> = []
        var index = 0
        while (index < this.mimeTypes.size) {
            retained.append(this.mimeTypes[index])
            index = index + 1
        }
        if (mimeType != "" && !this.hasMime(mimeType) &&
            retained.size < 256) retained.append(mimeType)
        WaylandDataOffer(this.identifier, retained)
    }
}

class WaylandDataSource(
    val identifier: int = 0,
    val text: string = ""
) {
    fun valid(): bool = this.identifier >= 2 &&
        this.text.size <= waylandMaximumClipboardBytes
}

class WaylandOutputGeometry(
    val valid: bool = false,
    val x: int = 0,
    val y: int = 0,
    val physicalWidth: int = 0,
    val physicalHeight: int = 0,
    val subpixel: int = 0,
    val make: string = "",
    val model: string = "",
    val transform: int = 0
)

class WaylandOutputMode(
    val valid: bool = false,
    val current: bool = false,
    val preferred: bool = false,
    val width: int = 0,
    val height: int = 0,
    val refreshMillihertz: int = 0
)

class WaylandOutput(
    val identifier: int = 0,
    val globalName: int = 0,
    val version: int = 0,
    val xdgIdentifier: int = 0,
    val xdgVersion: int = 0,
    val logicalX: int = 0,
    val logicalY: int = 0,
    val logicalWidth: int = 0,
    val logicalHeight: int = 0,
    val xdgDone: bool = false,
    val geometry: WaylandOutputGeometry = WaylandOutputGeometry(),
    val mode: WaylandOutputMode = WaylandOutputMode(),
    val scale: int = 1,
    val name: string = "",
    val description: string = "",
    val done: bool = false
) {
    fun valid(): bool = this.identifier >= 2 && this.globalName > 0 &&
        this.version >= 2 && this.geometry.valid && this.mode.valid &&
        this.mode.width > 0 && this.mode.height > 0 &&
        this.scale >= 1 && (this.xdgIdentifier == 0 ||
            (this.xdgIdentifier >= 2 && this.xdgVersion >= 1 &&
             this.logicalWidth > 0 && this.logicalHeight > 0))

    fun displayName(): string {
        var result = this.name
        if (result == "") result = this.description
        if (result == "" && this.geometry.make != "" &&
            this.geometry.model != "") {
            result = "${this.geometry.make} ${this.geometry.model}"
        } else if (result == "" && this.geometry.model != "") {
            result = this.geometry.model
        } else if (result == "" && this.geometry.make != "") {
            result = this.geometry.make
        }
        result
    }

    fun monitor(): Monitor = Monitor(
        this.displayName(),
        this.mode.width,
        this.mode.height,
        this.geometry.physicalWidth,
        this.geometry.physicalHeight
    )

    fun withGeometry(geometry: WaylandOutputGeometry): WaylandOutput =
        WaylandOutput(
            this.identifier,
            this.globalName,
            this.version,
            this.xdgIdentifier,
            this.xdgVersion,
            this.logicalX,
            this.logicalY,
            this.logicalWidth,
            this.logicalHeight,
            this.xdgDone,
            geometry,
            this.mode,
            this.scale,
            this.name,
            this.description,
            false
        )

    fun withMode(mode: WaylandOutputMode): WaylandOutput = WaylandOutput(
        this.identifier,
        this.globalName,
        this.version,
        this.xdgIdentifier,
        this.xdgVersion,
        this.logicalX,
        this.logicalY,
        this.logicalWidth,
        this.logicalHeight,
        this.xdgDone,
        this.geometry,
        if (mode.current || (!this.mode.valid && mode.preferred))
            mode else this.mode,
        this.scale,
        this.name,
        this.description,
        false
    )

    fun withScale(scale: int): WaylandOutput = WaylandOutput(
        this.identifier,
        this.globalName,
        this.version,
        this.xdgIdentifier,
        this.xdgVersion,
        this.logicalX,
        this.logicalY,
        this.logicalWidth,
        this.logicalHeight,
        this.xdgDone,
        this.geometry,
        this.mode,
        scale,
        this.name,
        this.description,
        false
    )

    fun withName(name: string): WaylandOutput = WaylandOutput(
        this.identifier,
        this.globalName,
        this.version,
        this.xdgIdentifier,
        this.xdgVersion,
        this.logicalX,
        this.logicalY,
        this.logicalWidth,
        this.logicalHeight,
        this.xdgDone,
        this.geometry,
        this.mode,
        this.scale,
        name,
        this.description,
        false
    )

    fun withDescription(description: string): WaylandOutput = WaylandOutput(
        this.identifier,
        this.globalName,
        this.version,
        this.xdgIdentifier,
        this.xdgVersion,
        this.logicalX,
        this.logicalY,
        this.logicalWidth,
        this.logicalHeight,
        this.xdgDone,
        this.geometry,
        this.mode,
        this.scale,
        this.name,
        description,
        false
    )

    fun finished(): WaylandOutput = WaylandOutput(
        this.identifier,
        this.globalName,
        this.version,
        this.xdgIdentifier,
        this.xdgVersion,
        this.logicalX,
        this.logicalY,
        this.logicalWidth,
        this.logicalHeight,
        if (this.xdgVersion >= 3 && this.logicalWidth > 0 &&
            this.logicalHeight > 0) true else this.xdgDone,
        this.geometry,
        this.mode,
        this.scale,
        this.name,
        this.description,
        true
    )

    fun withXdgBinding(
        identifier: int,
        version: int
    ): WaylandOutput = WaylandOutput(
        this.identifier,
        this.globalName,
        this.version,
        identifier,
        version,
        0,
        0,
        0,
        0,
        false,
        this.geometry,
        this.mode,
        this.scale,
        this.name,
        this.description,
        this.done
    )

    fun withLogicalPosition(x: int, y: int): WaylandOutput = WaylandOutput(
        this.identifier,
        this.globalName,
        this.version,
        this.xdgIdentifier,
        this.xdgVersion,
        x,
        y,
        this.logicalWidth,
        this.logicalHeight,
        false,
        this.geometry,
        this.mode,
        this.scale,
        this.name,
        this.description,
        this.done
    )

    fun withLogicalSize(width: int, height: int): WaylandOutput =
        WaylandOutput(
            this.identifier,
            this.globalName,
            this.version,
            this.xdgIdentifier,
            this.xdgVersion,
            this.logicalX,
            this.logicalY,
            width,
            height,
            false,
            this.geometry,
            this.mode,
            this.scale,
            this.name,
            this.description,
            this.done
        )

    fun withXdgName(name: string): WaylandOutput = WaylandOutput(
        this.identifier,
        this.globalName,
        this.version,
        this.xdgIdentifier,
        this.xdgVersion,
        this.logicalX,
        this.logicalY,
        this.logicalWidth,
        this.logicalHeight,
        false,
        this.geometry,
        this.mode,
        this.scale,
        name,
        this.description,
        this.done
    )

    fun withXdgDescription(description: string): WaylandOutput =
        WaylandOutput(
            this.identifier,
            this.globalName,
            this.version,
            this.xdgIdentifier,
            this.xdgVersion,
            this.logicalX,
            this.logicalY,
            this.logicalWidth,
            this.logicalHeight,
            false,
            this.geometry,
            this.mode,
            this.scale,
            this.name,
            description,
            this.done
        )

    fun finishedXdg(): WaylandOutput = WaylandOutput(
        this.identifier,
        this.globalName,
        this.version,
        this.xdgIdentifier,
        this.xdgVersion,
        this.logicalX,
        this.logicalY,
        this.logicalWidth,
        this.logicalHeight,
        true,
        this.geometry,
        this.mode,
        this.scale,
        this.name,
        this.description,
        this.done
    )
}

class WaylandToplevelConfigure(
    val valid: bool = false,
    val width: int = 0,
    val height: int = 0,
    val states: array<int> = []
)

fun waylandI32(value: string, offset: int): int {
    val encoded = waylandU32(value, offset)
    if (encoded <= 2147483647) encoded else encoded - 4294967296
}

fun waylandOutputGeometry(payload: string): WaylandOutputGeometry {
    var valid = payload.size >= 32
    val physicalWidth = if (valid) waylandI32(payload, 8) else -1
    val physicalHeight = if (valid) waylandI32(payload, 12) else -1
    val subpixel = if (valid) waylandI32(payload, 16) else -1
    val make = if (valid) waylandString(payload, 20) else WaylandString(false)
    val model = if (make.valid)
        waylandString(payload, make.next)
    else WaylandString(false)
    val transform = if (model.valid && model.next + 4 == payload.size)
        waylandI32(payload, model.next)
    else -1
    valid = valid && physicalWidth >= 0 && physicalHeight >= 0 &&
        subpixel >= 0 && subpixel <= 5 && make.valid && model.valid &&
        model.next + 4 == payload.size && transform >= 0 && transform <= 7
    WaylandOutputGeometry(
        valid,
        if (valid) waylandI32(payload, 0) else 0,
        if (valid) waylandI32(payload, 4) else 0,
        if (valid) physicalWidth else 0,
        if (valid) physicalHeight else 0,
        if (valid) subpixel else 0,
        if (valid) make.text else "",
        if (valid) model.text else "",
        if (valid) transform else 0
    )
}

fun waylandOutputMode(payload: string): WaylandOutputMode {
    val flags = if (payload.size == 16) waylandU32(payload, 0) else 0
    val width = if (payload.size == 16) waylandI32(payload, 4) else 0
    val height = if (payload.size == 16) waylandI32(payload, 8) else 0
    val refresh = if (payload.size == 16) waylandI32(payload, 12) else -1
    val valid = payload.size == 16 && (flags & ~3) == 0 &&
        width > 0 && height > 0 && refresh >= 0
    WaylandOutputMode(
        valid,
        valid && (flags & 1) != 0,
        valid && (flags & 2) != 0,
        if (valid) width else 0,
        if (valid) height else 0,
        if (valid) refresh else 0
    )
}

fun waylandToplevelConfigure(payload: string): WaylandToplevelConfigure {
    var valid = payload.size >= 12
    val width = if (valid) waylandI32(payload, 0) else 0
    val height = if (valid) waylandI32(payload, 4) else 0
    val length = if (valid) waylandU32(payload, 8) else 0
    val padded = if (length >= 0) waylandAligned(length) else 0
    valid = valid && width >= 0 && height >= 0 &&
        length >= 0 && (length / 4) * 4 == length &&
        padded >= length && 12 + padded == payload.size
    val states: array<int> = []
    var offset = 0
    while (valid && offset < length) {
        states.append(waylandU32(payload, 12 + offset))
        offset = offset + 4
    }
    WaylandToplevelConfigure(valid, width, height, states)
}

fun waylandRegistryBindRequest(
    registryIdentifier: int,
    global: WaylandGlobal,
    version: int,
    newIdentifier: int
): string {
    var result = ""
    val stringLength = global.interfaceName.size + 1
    val stringPadded = waylandAligned(stringLength)
    val payloadLength = 4 + 4 + stringPadded + 4 + 4
    if (registryIdentifier > 0 && global.valid && version > 0 &&
        version <= global.version && global.interfaceName.size <= 4096 &&
        newIdentifier >= 2 &&
        payloadLength + 8 <= waylandMaximumMessageBytes) {
        val payload = nativeByteBuffer(payloadLength + 1)
        waylandStoreU32(payload, 0, global.name)
        waylandStoreU32(payload, 4, stringLength)
        var index = 0
        while (index < global.interfaceName.size) {
            payload.store(8 + index, global.interfaceName[index])
            index = index + 1
        }
        payload.store(8 + global.interfaceName.size, 0)
        waylandStoreU32(payload, 8 + stringPadded, version)
        waylandStoreU32(payload, 12 + stringPadded, newIdentifier)
        result = waylandPacket(
            registryIdentifier,
            0,
            payload.adoptString(payloadLength)
        )
    }
    result
}

fun waylandDisplayPath(): string {
    val configured = linuxEnvironment("WAYLAND_DISPLAY")
    val display = if (configured.found && configured.value != "")
        configured.value
    else "wayland-0"
    val absolute = display.size > 0 && display[0] == 47
    var result = if (absolute) display else ""
    if (!absolute) {
        val runtime = linuxEnvironment("XDG_RUNTIME_DIR")
        if (runtime.found && runtime.value != "") {
            result = "${runtime.value}/$display"
        }
    }
    result
}

fun waylandDescriptor(value: string): int {
    var result = -1
    var parsed = 0
    var valid = value != "" && value.size <= 10
    var index = 0
    while (valid && index < value.size) {
        val digit = value[index] - 48
        valid = digit >= 0 && digit <= 9 &&
            parsed <= (2147483647 - digit) / 10
        if (valid) parsed = parsed * 10 + digit
        index = index + 1
    }
    if (valid) result = parsed
    result
}

fun waylandInheritedDescriptor(): int {
    val configured = linuxEnvironment("WAYLAND_SOCKET")
    if (configured.found) waylandDescriptor(configured.value) else -1
}

fun waylandConnectUnix(path: string): int {
    var descriptor = -1
    if (path != "" && path.size <= 107) {
        descriptor = linuxSyscall3(41, 1, 524289, 0)
    }
    if (descriptor >= 0) {
        val address = nativeByteBuffer(110)
        address.store(0, 1)
        address.store(1, 0)
        var index = 0
        while (index < path.size) {
            address.store(2 + index, path[index])
            index = index + 1
        }
        address.store(2 + path.size, 0)
        val connected = linuxSyscall3(
            42,
            descriptor,
            nativePointerAddress(address.address),
            3 + path.size
        )
        address.close()
        if (connected != 0) {
            linuxSyscall1(3, descriptor)
            descriptor = -1
        }
    }
    descriptor
}

resource class WaylandConnection(
    var descriptor: int,
    val registryIdentifier: int,
    var nextIdentifier: int,
    var globals: array<WaylandGlobal>,
    var failed: bool = false,
    var error: string = ""
) {
    fun valid(): bool = this.descriptor >= 0 &&
        this.registryIdentifier >= 2 && !this.failed

    fun allocateIdentifier(): int {
        var result = -1
        if (this.valid() && this.nextIdentifier >= 2 &&
            this.nextIdentifier < 4278190079) {
            result = this.nextIdentifier
            this.nextIdentifier = this.nextIdentifier + 1
        }
        result
    }

    fun fail(message: string): void {
        this.failed = true
        this.error = message
        return
    }

    fun global(interfaceName: string): WaylandGlobal {
        var result = WaylandGlobal()
        var index = 0
        while (index < this.globals.size) {
            val candidate = this.globals[index]
            if (candidate.valid && candidate.interfaceName == interfaceName &&
                (!result.valid || candidate.version > result.version)) {
                result = candidate
            }
            index = index + 1
        }
        result
    }

    fun removeGlobal(name: int): void {
        val retained: array<WaylandGlobal> = []
        var index = 0
        while (index < this.globals.size) {
            if (this.globals[index].name != name) {
                retained.append(this.globals[index])
            }
            index = index + 1
        }
        this.globals = retained
        return
    }

    fun send(packet: string): bool {
        val succeeded = this.valid() && packet != "" &&
            waylandWriteAll(this.descriptor, packet)
        if (!succeeded && !this.failed) this.fail("Wayland request failed")
        succeeded
    }

    fun read(): WaylandMessage {
        val message = if (this.valid())
            waylandReadMessage(this.descriptor)
        else WaylandMessage(false)
        if (!message.valid && !this.failed) this.fail(
            "Wayland message read failed"
        )
        message
    }

    // Returns 1 when a core message was consumed, 0 for an application
    // object, and -1 for malformed or unknown core traffic.
    fun dispatchCore(message: WaylandMessage): int {
        var result = 0
        if (!message.valid) result = -1
        else if (message.objectIdentifier == this.registryIdentifier &&
            message.opcode == 0) {
            val global = waylandRegistryGlobal(message.payload)
            if (global.valid && this.globals.size < waylandMaximumGlobals) {
                this.globals.append(global)
                result = 1
            } else result = -1
        } else if (message.objectIdentifier == this.registryIdentifier &&
            message.opcode == 1) {
            if (message.payload.size == 4) {
                this.removeGlobal(waylandU32(message.payload, 0))
                result = 1
            } else result = -1
        } else if (message.objectIdentifier == waylandDisplayIdentifier &&
            message.opcode == 0) {
            var detail = "Wayland compositor protocol error"
            if (message.payload.size >= 12) {
                val parsed = waylandString(message.payload, 8)
                if (parsed.valid) detail = parsed.text
            }
            this.fail(detail)
            result = -1
        } else if (message.objectIdentifier == waylandDisplayIdentifier &&
            message.opcode == 1) {
            result = if (message.payload.size == 4) 1 else -1
        } else if (message.objectIdentifier == this.registryIdentifier ||
            message.objectIdentifier == waylandDisplayIdentifier) result = -1
        if (result < 0 && !this.failed) this.fail(
            "Malformed Wayland core event"
        )
        result
    }

    fun roundtrip(): bool {
        val callbackIdentifier = this.allocateIdentifier()
        var succeeded = callbackIdentifier >= 2 && waylandWriteAll(
            this.descriptor,
            waylandNewIdentifierRequest(
                waylandDisplayIdentifier,
                0,
                callbackIdentifier
            )
        )
        var complete = false
        var messages = 0
        while (succeeded && !complete && messages < 16384) {
            val message = this.read()
            succeeded = message.valid
            if (succeeded && message.objectIdentifier ==
                callbackIdentifier && message.opcode == 0) {
                succeeded = message.payload.size == 4
                complete = succeeded
            } else if (succeeded &&
                message.objectIdentifier == callbackIdentifier) succeeded = false
            else if (succeeded) succeeded = this.dispatchCore(message) >= 0
            messages = messages + 1
        }
        succeeded = succeeded && complete
        if (!succeeded && !this.failed) this.fail(
            "Wayland roundtrip failed"
        )
        succeeded
    }

    fun bind(interfaceName: string, maximumVersion: int): WaylandBinding {
        val global = this.global(interfaceName)
        val version = if (global.valid && maximumVersion > 0 &&
            maximumVersion < global.version) maximumVersion
        else global.version
        val identifier = if (global.valid && version > 0)
            this.allocateIdentifier()
        else -1
        val request = if (identifier >= 2) waylandRegistryBindRequest(
            this.registryIdentifier,
            global,
            version,
            identifier
        ) else ""
        val succeeded = request != "" &&
            waylandWriteAll(this.descriptor, request)
        if (!succeeded && global.valid) this.fail(
            "Wayland global bind failed"
        )
        WaylandBinding(
            succeeded,
            if (succeeded) identifier else 0,
            if (succeeded) global.name else 0,
            if (succeeded) global.interfaceName else "",
            if (succeeded) version else 0
        )
    }

    fun drop(): void {
        if (this.descriptor >= 0) linuxSyscall1(3, this.descriptor)
        this.descriptor = -1
        return
    }
}

resource class WaylandXdgWindow(
    var connection: WaylandConnection,
    val compositorIdentifier: int,
    val wmBaseIdentifier: int,
    val surfaceIdentifier: int,
    val xdgSurfaceIdentifier: int,
    val toplevelIdentifier: int,
    var width: int,
    var height: int,
    var states: array<int>,
    var configured: bool,
    var closeRequested: bool,
    var lastConfigureSerial: int,
    var title: string,
    var appId: string,
    var seatIdentifier: int,
    var seatVersion: int,
    var seatCapabilities: int,
    var seatCapabilitiesReceived: bool,
    var seatName: string,
    var pointerIdentifier: int,
    var keyboardIdentifier: int,
    var pointerFocused: bool,
    var keyboardFocused: bool,
    var pointerX: int,
    var pointerY: int,
    var lastInputSerial: int,
    var pointerEnterSerial: int,
    var cursorVisible: bool,
    var cursorSurfaceIdentifier: int,
    var cursorShmIdentifier: int,
    var cursorBufferIdentifier: int,
    var cursorBufferReleased: bool,
    var cursorMappedAddress: int,
    var cursorMappedLength: int,
    var cursorMappedBytes: NativeByteBuffer,
    var relativePointerManagerIdentifier: int,
    var relativePointerIdentifier: int,
    var pointerConstraintsIdentifier: int,
    var lockedPointerIdentifier: int,
    var retiredLockedPointerIdentifiers: array<int>,
    var pointerCaptured: bool,
    var pointerCaptureActive: bool,
    var relativePointerXFixed: int,
    var relativePointerYFixed: int,
    var lastRelativeXFixed: int,
    var lastRelativeYFixed: int,
    var lastRelativeUnacceleratedXFixed: int,
    var lastRelativeUnacceleratedYFixed: int,
    var relativeMotionEvents: int,
    var dataDeviceManagerIdentifier: int,
    var dataDeviceManagerVersion: int,
    var dataDeviceIdentifier: int,
    var clipboardSources: array<WaylandDataSource>,
    var activeClipboardSourceIdentifier: int,
    var clipboardOffers: array<WaylandDataOffer>,
    var selectionOfferIdentifier: int,
    var clipboardTransfersServed: int,
    var keymapFormat: int,
    var keymap: string,
    var parsedKeymap: XkbKeymap,
    var repeatRate: int,
    var repeatDelay: int,
    var repeatPlatformCode: int,
    var repeatKey: int,
    var repeatDeadlineNanoseconds: int,
    var repeatPeriodNanoseconds: int,
    var repeatClockScratch: NativeByteBuffer,
    var modifiersDepressed: int,
    var modifiersLatched: int,
    var modifiersLocked: int,
    var modifierGroup: int,
    var ancillaryScratch: NativeByteBuffer,
    var receivedDescriptor: int,
    var pendingInputEvents: array<WindowEvent>,
    var pendingInputIndex: int,
    var fractionalScaleManagerIdentifier: int,
    var fractionalScaleIdentifier: int,
    var preferredFractionalScale: int,
    var viewporterIdentifier: int,
    var viewportIdentifier: int,
    var viewportDestinationWidth: int,
    var viewportDestinationHeight: int,
    var viewportSourceXFixed: int,
    var viewportSourceYFixed: int,
    var viewportSourceWidthFixed: int,
    var viewportSourceHeightFixed: int,
    var xdgOutputManagerIdentifier: int,
    var xdgOutputManagerVersion: int,
    var outputsEnabled: bool,
    var outputs: array<WaylandOutput>,
    var surfaceOutputIdentifiers: array<int>,
    var primaryOutputIdentifier: int,
    var shmIdentifier: int,
    var bufferIdentifiers: array<int>,
    var bufferBusy: array<bool>,
    var activeBufferIndex: int,
    var nextBufferIndex: int,
    var mappedAddress: int,
    var mappedLength: int,
    var mappedBytes: NativeByteBuffer,
    var wireScratch: NativeByteBuffer,
    var sharedFrameBytes: int,
    var bufferWidth: int,
    var bufferHeight: int,
    var bufferStride: int,
    var frameCallbackIdentifier: int,
    var frameComplete: bool,
    var shmFormats: array<int>
) {
    fun valid(): bool = this.connection.valid() &&
        this.compositorIdentifier >= 2 && this.wmBaseIdentifier >= 2 &&
        this.surfaceIdentifier >= 2 && this.xdgSurfaceIdentifier >= 2 &&
        this.toplevelIdentifier >= 2 && this.configured

    fun setTitle(value: string): bool {
        val succeeded = this.connection.send(waylandStringRequest(
            this.toplevelIdentifier,
            2,
            value
        ))
        if (succeeded) this.title = value
        succeeded
    }

    fun setAppId(value: string): bool {
        val succeeded = this.connection.send(waylandStringRequest(
            this.toplevelIdentifier,
            3,
            value
        ))
        if (succeeded) this.appId = value
        succeeded
    }

    fun hasToplevelState(state: int): bool = waylandContainsState(
        this.states,
        state
    )

    fun setFullscreen(
        fullscreen: bool,
        outputIdentifier: int = 0
    ): bool {
        val outputKnown = outputIdentifier == 0 ||
            this.outputIndex(outputIdentifier) >= 0
        val packet = if (fullscreen && outputKnown)
            waylandPacket(
                this.toplevelIdentifier,
                11,
                waylandU32Payload(outputIdentifier)
            )
        else if (!fullscreen && outputIdentifier == 0)
            waylandPacket(this.toplevelIdentifier, 12)
        else ""
        this.valid() && packet != "" && this.connection.send(packet)
    }

    fun setMaximized(maximized: bool): bool = this.valid() &&
        this.connection.send(waylandPacket(
            this.toplevelIdentifier,
            if (maximized) 9 else 10
        ))

    fun setMinimized(): bool = this.valid() && this.connection.send(
        waylandPacket(this.toplevelIdentifier, 13)
    )

    fun setResizable(resizable: bool): bool {
        val width = if (resizable) 0 else this.width
        val height = if (resizable) 0 else this.height
        var succeeded = this.valid() && width >= 0 && height >= 0 &&
            this.connection.send(waylandPacket(
                this.toplevelIdentifier,
                7,
                waylandU32PairPayload(width, height)
            )) && this.connection.send(waylandPacket(
                this.toplevelIdentifier,
                8,
                waylandU32PairPayload(width, height)
            ))
        if (succeeded) succeeded = this.commit()
        succeeded
    }

    fun requestClose(): bool {
        val succeeded = this.valid() && !this.closeRequested &&
            this.enqueueInputEvent(WindowEvent(windowEventCloseRequested))
        if (succeeded) this.closeRequested = true
        succeeded
    }

    fun preferredFramebufferWidth(): int = waylandScaledDimension(
        this.width,
        if (this.preferredFractionalScale > 0)
            this.preferredFractionalScale
        else waylandFractionalScaleDenominator
    )

    fun preferredFramebufferHeight(): int = waylandScaledDimension(
        this.height,
        if (this.preferredFractionalScale > 0)
            this.preferredFractionalScale
        else waylandFractionalScaleDenominator
    )

    fun enableFractionalScale(): bool {
        var succeeded = this.valid() &&
            this.fractionalScaleManagerIdentifier == 0 &&
            this.fractionalScaleIdentifier == 0
        val manager = if (succeeded) this.connection.bind(
            "wp_fractional_scale_manager_v1",
            1
        ) else WaylandBinding()
        succeeded = succeeded && manager.valid
        val identifier = if (succeeded)
            this.connection.allocateIdentifier()
        else -1
        if (succeeded) succeeded = identifier >= 2 && this.connection.send(
            waylandPacket(
                manager.identifier,
                1,
                waylandU32PairPayload(identifier, this.surfaceIdentifier)
            )
        )
        if (succeeded) {
            this.fractionalScaleManagerIdentifier = manager.identifier
            this.fractionalScaleIdentifier = identifier
        }
        succeeded
    }

    fun enableViewport(): bool {
        var succeeded = this.valid() && this.viewporterIdentifier == 0 &&
            this.viewportIdentifier == 0
        val manager = if (succeeded) this.connection.bind(
            "wp_viewporter",
            1
        ) else WaylandBinding()
        succeeded = succeeded && manager.valid
        val identifier = if (succeeded)
            this.connection.allocateIdentifier()
        else -1
        if (succeeded) succeeded = identifier >= 2 && this.connection.send(
            waylandPacket(
                manager.identifier,
                1,
                waylandU32PairPayload(identifier, this.surfaceIdentifier)
            )
        )
        if (succeeded) {
            this.viewporterIdentifier = manager.identifier
            this.viewportIdentifier = identifier
        }
        succeeded
    }

    fun viewportDestinationSet(): bool =
        this.viewportDestinationWidth > 0 &&
        this.viewportDestinationHeight > 0

    fun viewportSourceSet(): bool = this.viewportSourceWidthFixed > 0 &&
        this.viewportSourceHeightFixed > 0

    fun setViewportSourceFixed(
        xFixed: int,
        yFixed: int,
        widthFixed: int,
        heightFixed: int
    ): bool {
        val unset = xFixed == waylandFixedUnset &&
            yFixed == waylandFixedUnset &&
            widthFixed == waylandFixedUnset &&
            heightFixed == waylandFixedUnset
        val validRectangle = xFixed >= 0 &&
            xFixed <= waylandFixedMaximum && yFixed >= 0 &&
            yFixed <= waylandFixedMaximum && widthFixed > 0 &&
