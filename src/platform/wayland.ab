    fun pointerCaptureAvailable(): bool = this.connection.global(
        "zwp_relative_pointer_manager_v1"
    ).valid && this.connection.global(
        "zwp_pointer_constraints_v1"
    ).valid

    fun retiredLockedPointerIndex(identifier: int): int {
        var result = -1
