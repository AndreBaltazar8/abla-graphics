    fun enablePointerCaptureProtocol(): bool {
        var succeeded = this.valid() && this.pointerIdentifier >= 2 &&
            this.relativePointerManagerIdentifier == 0 &&
            this.relativePointerIdentifier == 0 &&
            this.pointerConstraintsIdentifier == 0 &&
            this.pointerCaptureAvailable()
        val relativeManager = if (succeeded) this.connection.bind(
            "zwp_relative_pointer_manager_v1",
            1
        ) else WaylandBinding()
        val constraints = if (succeeded) this.connection.bind(
            "zwp_pointer_constraints_v1",
            1
