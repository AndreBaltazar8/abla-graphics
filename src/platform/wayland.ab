                this.retiredLockedPointerIdentifiers.append(
                    this.lockedPointerIdentifier
                )
                this.lockedPointerIdentifier = 0
                this.pointerCaptured = false
                this.pointerCaptureActive = false
            }
        }
        succeeded
    }

    fun disablePointerCaptureProtocol(): bool {
        var succeeded = this.connection.valid()
        if (succeeded && this.pointerCaptured) {
            succeeded = this.setPointerCaptured(false)
        }
        if (succeeded && this.relativePointerIdentifier >= 2) {
            succeeded = this.connection.send(waylandPacket(
                this.relativePointerIdentifier,
                0
            ))
        }
        if (succeeded && this.pointerConstraintsIdentifier >= 2) {
            succeeded = this.connection.send(waylandPacket(
                this.pointerConstraintsIdentifier,
                0
            ))
        }
        if (succeeded && this.relativePointerManagerIdentifier >= 2) {
            succeeded = this.connection.send(waylandPacket(
                this.relativePointerManagerIdentifier,
                0
            ))
        }
        if (succeeded) {
            this.relativePointerIdentifier = 0
            this.pointerConstraintsIdentifier = 0
            this.relativePointerManagerIdentifier = 0
        }
        succeeded
    }

    fun setPointerPositionHint(x: int, y: int): bool {
        val valid = x >= 0 && x <= waylandFixedMaximumInteger &&
            y >= 0 && y <= waylandFixedMaximumInteger
        var succeeded = this.valid() && this.pointerCaptured &&
            this.lockedPointerIdentifier >= 2 && valid &&
            this.connection.send(waylandPacket(
                this.lockedPointerIdentifier,
