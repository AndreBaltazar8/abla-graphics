            succeeded = manager.valid
            val identifier = if (succeeded)
                this.connection.allocateIdentifier()
            else -1
            if (succeeded) succeeded = identifier >= 2 &&
                this.connection.send(waylandPacket(
                    manager.identifier,
                    1,
                    waylandU32PairPayload(identifier, this.seatIdentifier)
                ))
            if (succeeded) {
                this.dataDeviceManagerIdentifier = manager.identifier
                this.dataDeviceManagerVersion = manager.version
                this.dataDeviceIdentifier = identifier
            }
        }
        succeeded && this.dataDeviceIdentifier >= 2
    }

    fun setClipboard(value: string): bool {
        var succeeded = value.size <= waylandMaximumClipboardBytes &&
            this.clipboardSources.size < 64 &&
            this.lastInputSerial > 0 && this.enableClipboard()
        val sourceIdentifier = if (succeeded)
            this.connection.allocateIdentifier()
        else -1
        if (succeeded) succeeded = sourceIdentifier >= 2 &&
            this.connection.send(waylandNewIdentifierRequest(
                this.dataDeviceManagerIdentifier,
                0,
                sourceIdentifier
            )) && this.connection.send(waylandStringRequest(
                sourceIdentifier,
                0,
                waylandClipboardMimeUtf8
            )) && this.connection.send(waylandStringRequest(
                sourceIdentifier,
                0,
                waylandClipboardMimeText
            )) && this.connection.send(waylandPacket(
                this.dataDeviceIdentifier,
                1,
                waylandU32PairPayload(
                    sourceIdentifier,
                    this.lastInputSerial
                )
            ))
