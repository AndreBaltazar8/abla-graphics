// Minimal X11 wire-protocol client implemented entirely in Abla.
//
// This module talks to the local X server over AF_UNIX. It does not use Xlib,
// XCB, GLFW, SDL, or a project native shim.

import "abla/sys/linux"
import "abla/sys/linux/fs"
import "abla/sys/linux/process"
import "abla/unsafe/memory"
import "../window.ab"

val x11EventMask = 1 | 2 | 4 | 8 | 64 | 32768 | 131072 | 2097152

fun x11U16(value: string, offset: int): int =
    value[offset] + value[offset + 1] * 256

fun x11I16(value: string, offset: int): int {
    val measured = x11U16(value, offset)
    if (measured >= 32768) measured - 65536 else measured
}

fun x11U32(value: string, offset: int): int =
    x11U16(value, offset) + x11U16(value, offset + 2) * 65536

fun x11BigU16(value: string, offset: int): int =
    value[offset] * 256 + value[offset + 1]

fun x11StoreU16(var buffer: NativeByteBuffer, offset: int, value: int): void {
    buffer.store(offset, value & 255)
    buffer.store(offset + 1, (value >>> 8) & 255)
    return
}

fun x11StoreU32(var buffer: NativeByteBuffer, offset: int, value: int): void {
    x11StoreU16(buffer, offset, value & 65535)
    x11StoreU16(buffer, offset + 2, (value >>> 16) & 65535)
    return
}

fun x11Packet(var buffer: NativeByteBuffer, length: int): string =
    buffer.adoptString(length)

fun x11WriteAll(descriptor: int, value: string): bool {
    var offset = 0
    var succeeded = descriptor >= 0
    while (succeeded && offset < value.size) {
        val written = linuxWrite(
            descriptor,
            value.slice(offset, value.size)
        )
        if (written <= 0) succeeded = false
        else offset = offset + written
    }
    succeeded
}

fun x11ReadExact(descriptor: int, length: int): string {
    var result = ""
    var reading = descriptor >= 0 && length >= 0 && length <= 16777216
    while (reading && result.size < length) {
        val file = LinuxFileDescriptor(descriptor)
        val part = file.read(length - result.size)
        if (part.size == 0) reading = false
        else result = "$result$part"
    }
    if (result.size == length) result else ""
}

fun x11DisplayNumber(value: string): int {
    var colon = -1
    var index = 0
    while (index < value.size) {
        if (value[index] == 58) colon = index
        index = index + 1
    }
    var result = -1
    if (colon >= 0 && colon + 1 < value.size) {
        var parsed = 0
        var valid = true
        index = colon + 1
        var digits = 0
        while (valid && index < value.size && value[index] != 46) {
            val digit = value[index] - 48
            if (digit < 0 || digit > 9) valid = false
            else {
                parsed = parsed * 10 + digit
                digits = digits + 1
            }
            index = index + 1
        }
        if (valid && digits > 0 && parsed <= 65535) result = parsed
    }
    result
}

fun x11ConfiguredDisplayNumber(): int {
    val configured = linuxEnvironment("DISPLAY")
    if (configured.found) x11DisplayNumber(configured.value) else -1
}

class X11Authority(val name: string, val data: string)

fun x11AuthorityPath(): string {
    val configured = linuxEnvironment("XAUTHORITY")
    var result = if (configured.found) configured.value else ""
    if (result == "") {
        val home = linuxEnvironment("HOME")
        if (home.found) result = "${home.value}/.Xauthority"
    }
    result
}

fun x11Authority(displayNumber: int): X11Authority {
    var selectedName = ""
    var selectedData = ""
    val path = x11AuthorityPath()
    var source = ""
    if (path != "" && Path(path).exists()) source = Path(path).readText()
    val wantedNumber = "$displayNumber"
    var offset = 0
    while (selectedData == "" && offset + 2 <= source.size) {
        val family = x11BigU16(source, offset)
        offset = offset + 2
        var valid = offset + 2 <= source.size
        var addressLength = 0
        if (valid) {
            addressLength = x11BigU16(source, offset)
            offset = offset + 2
            valid = addressLength <= 4096 &&
                offset + addressLength + 2 <= source.size
        }
        if (valid) offset = offset + addressLength
        var number = ""
        if (valid) {
            val length = x11BigU16(source, offset)
            offset = offset + 2
            valid = length <= 64 && offset + length + 2 <= source.size
            if (valid) {
                number = source.slice(offset, offset + length)
                offset = offset + length
            }
        }
        var name = ""
        if (valid) {
            val length = x11BigU16(source, offset)
            offset = offset + 2
            valid = length <= 256 && offset + length + 2 <= source.size
            if (valid) {
                name = source.slice(offset, offset + length)
                offset = offset + length
            }
        }
        var data = ""
        if (valid) {
            val length = x11BigU16(source, offset)
            offset = offset + 2
            valid = length <= 4096 && offset + length <= source.size
            if (valid) {
                data = source.slice(offset, offset + length)
                offset = offset + length
            }
        }
        if (valid && (family == 256 || family == 65535) &&
            number == wantedNumber && name == "MIT-MAGIC-COOKIE-1" &&
            data.size == 16) {
            selectedName = name
            selectedData = data
        }
        if (!valid) offset = source.size
    }
    X11Authority(selectedName, selectedData)
}

fun x11ConnectUnix(displayNumber: int): int {
    var descriptor = -1
    val path = "/tmp/.X11-unix/X$displayNumber"
    if (displayNumber >= 0 && displayNumber <= 65535 && path.size <= 107) {
        descriptor = linuxSyscall3(41, 1, 524289, 0)
    }
    if (descriptor >= 0) {
        val address = nativeByteBuffer(110)
        address.store(0, 1)
        address.store(1, 0)
        var index = 0
        while (index < path.size) {
            address.store(2 + index, path[index])
            index = index + 1
        }
        address.store(2 + path.size, 0)
        val connected = linuxSyscall3(
            42,
            descriptor,
            nativePointerAddress(address.address),
            3 + path.size
        )
        address.close()
        if (connected != 0) {
            linuxSyscall1(3, descriptor)
            descriptor = connected
        }
    }
    descriptor
}

class X11Setup(
    val succeeded: bool,
    val resourceBase: int,
    val resourceMask: int,
    val root: int,
    val rootVisual: int,
    val rootDepth: int,
    val blackPixel: int,
    val whitePixel: int,
    val minimumKeycode: int,
    val maximumKeycode: int,
    val screenWidth: int,
    val screenHeight: int,
    val screenWidthMillimeters: int,
    val screenHeightMillimeters: int
)

fun x11Setup(descriptor: int, authority: X11Authority): X11Setup {
    var succeeded = descriptor >= 0
    if (succeeded) {
        val namePadded = ((authority.name.size + 3) / 4) * 4
        val dataPadded = ((authority.data.size + 3) / 4) * 4
        val length = 12 + namePadded + dataPadded
        val request = nativeByteBuffer(length + 1)
        request.store(0, 108)
        request.store(1, 0)
        x11StoreU16(request, 2, 11)
        x11StoreU16(request, 4, 0)
        x11StoreU16(request, 6, authority.name.size)
        x11StoreU16(request, 8, authority.data.size)
        request.store(10, 0)
        request.store(11, 0)
        var index = 0
        while (index < authority.name.size) {
            request.store(12 + index, authority.name[index])
            index = index + 1
        }
        index = 0
        while (index < authority.data.size) {
            request.store(12 + namePadded + index, authority.data[index])
            index = index + 1
        }
        succeeded = x11WriteAll(descriptor, x11Packet(request, length))
    }

    var prefix = ""
    if (succeeded) prefix = x11ReadExact(descriptor, 8)
    succeeded = prefix.size == 8 && prefix[0] == 1
    var body = ""
    if (succeeded) {
        val bodyLength = x11U16(prefix, 6) * 4
        succeeded = bodyLength >= 32 && bodyLength <= 16777216
        if (succeeded) body = x11ReadExact(descriptor, bodyLength)
        succeeded = body.size == bodyLength
    }

    var resourceBase = 0
    var resourceMask = 0
    var root = 0
    var rootVisual = 0
    var rootDepth = 0
    var blackPixel = 0
    var whitePixel = 0
    var minimumKeycode = 0
    var maximumKeycode = 0
    var screenWidth = 0
    var screenHeight = 0
    var screenWidthMillimeters = 0
    var screenHeightMillimeters = 0
    if (succeeded) {
        resourceBase = x11U32(body, 4)
        resourceMask = x11U32(body, 8)
        val vendorLength = x11U16(body, 16)
        val formatCount = body[21]
        val screenCount = body[20]
        minimumKeycode = body[26]
        maximumKeycode = body[27]
        val screenOffset =
            32 + ((vendorLength + 3) / 4) * 4 + formatCount * 8
        succeeded = screenCount > 0 && screenOffset + 40 <= body.size
        if (succeeded) {
            root = x11U32(body, screenOffset)
            whitePixel = x11U32(body, screenOffset + 8)
            blackPixel = x11U32(body, screenOffset + 12)
            screenWidth = x11U16(body, screenOffset + 20)
            screenHeight = x11U16(body, screenOffset + 22)
            screenWidthMillimeters = x11U16(body, screenOffset + 24)
            screenHeightMillimeters = x11U16(body, screenOffset + 26)
            rootVisual = x11U32(body, screenOffset + 32)
            rootDepth = body[screenOffset + 38]
            succeeded = root != 0 && resourceMask != 0 && rootDepth > 0 &&
                screenWidth > 0 && screenHeight > 0
        }
    }
    X11Setup(
        succeeded,
        resourceBase,
        resourceMask,
        root,
        rootVisual,
        rootDepth,
        blackPixel,
        whitePixel,
        minimumKeycode,
        maximumKeycode,
        screenWidth,
        screenHeight,
        screenWidthMillimeters,
        screenHeightMillimeters
    )
}

fun x11KeyboardMappingRequest(first: int, count: int): string {
    val request = nativeByteBuffer(9)
    request.store(0, 101)
    request.store(1, 0)
    x11StoreU16(request, 2, 2)
    request.store(4, first)
    request.store(5, count)
    request.store(6, 0)
    request.store(7, 0)
    x11Packet(request, 8)
}

fun x11KeyboardMapping(
    descriptor: int,
    minimumKeycode: int,
    maximumKeycode: int
): array<int> {
    val mapping: array<int> = []
    var index = 0
    while (index < 512) {
        mapping.append(0)
        index = index + 1
    }
    val count = maximumKeycode - minimumKeycode + 1
    if (descriptor >= 0 && minimumKeycode >= 8 && maximumKeycode <= 255 &&
        count > 0 && count <= 248 &&
        x11WriteAll(
            descriptor,
            x11KeyboardMappingRequest(minimumKeycode, count)
        )) {
        val reply = x11ReadExact(descriptor, 32)
        if (reply.size == 32 && reply[0] == 1) {
            val symbolsPerKeycode = reply[1]
            val bodyLength = x11U32(reply, 4) * 4
            val body = x11ReadExact(descriptor, bodyLength)
            if (symbolsPerKeycode > 0 &&
                body.size == count * symbolsPerKeycode * 4) {
                var keycode = minimumKeycode
                while (keycode <= maximumKeycode) {
                    var symbolIndex = 0
                    var primary = 0
                    while (primary == 0 && symbolIndex < symbolsPerKeycode) {
                        val offset = (
                            (keycode - minimumKeycode) * symbolsPerKeycode +
                            symbolIndex
                        ) * 4
                        primary = x11U32(body, offset)
                        symbolIndex = symbolIndex + 1
                    }
                    var shifted = primary
                    if (symbolsPerKeycode > 1) {
                        val shiftedOffset = (
                            (keycode - minimumKeycode) * symbolsPerKeycode + 1
                        ) * 4
                        val candidate = x11U32(body, shiftedOffset)
                        if (candidate != 0) shifted = candidate
                    }
                    mapping[keycode * 2] = primary
                    mapping[keycode * 2 + 1] = shifted
                    keycode = keycode + 1
                }
            }
        }
    }
    mapping
}

fun x11KeyboardMappingAvailable(mapping: array<int>): bool {
    var available = false
    var index = 0
    while (!available && index < mapping.size) {
        available = mapping[index] != 0
        index = index + 1
    }
    available
}

fun x11KeyFromKeysym(symbol: int): int {
    var key = keyUnknown
    if (symbol >= 32 && symbol <= 126) {
        key = symbol
        if (key >= 97 && key <= 122) key = key - 32
    } else if (symbol == 65288) key = keyBackspace
    else if (symbol == 65289) key = keyTab
    else if (symbol == 65293) key = keyEnter
    else if (symbol == 65307) key = keyEscape
    else if (symbol == 65360) key = keyHome
    else if (symbol == 65361) key = keyLeft
    else if (symbol == 65362) key = keyUp
    else if (symbol == 65363) key = keyRight
    else if (symbol == 65364) key = keyDown
    else if (symbol == 65365) key = keyPageUp
    else if (symbol == 65366) key = keyPageDown
    else if (symbol == 65367) key = keyEnd
    else if (symbol == 65379) key = keyInsert
    else if (symbol == 65535) key = keyDelete
    else if (symbol >= 65470 && symbol <= 65481) key = keyF1 + symbol - 65470
    else if (symbol >= 65456 && symbol <= 65465) key = keyKp0 + symbol - 65456
    else if (symbol == 65454) key = keyKpDecimal
    else if (symbol == 65455) key = keyKpDivide
    else if (symbol == 65450) key = keyKpMultiply
    else if (symbol == 65453) key = keyKpSubtract
    else if (symbol == 65451) key = keyKpAdd
    else if (symbol == 65421) key = keyKpEnter
    else if (symbol == 65469) key = keyKpEqual
    else if (symbol == 65509) key = keyCapsLock
    else if (symbol == 65300) key = keyScrollLock
    else if (symbol == 65407) key = keyNumLock
    else if (symbol == 65377) key = keyPrintScreen
    else if (symbol == 65299) key = keyPause
    else if (symbol == 65505) key = keyLeftShift
    else if (symbol == 65506) key = keyRightShift
    else if (symbol == 65507) key = keyLeftControl
    else if (symbol == 65508) key = keyRightControl
    else if (symbol == 65513) key = keyLeftAlt
    else if (symbol == 65514) key = keyRightAlt
    else if (symbol == 65515) key = keyLeftSuper
    else if (symbol == 65516) key = keyRightSuper
    else if (symbol == 65383) key = keyMenu
    key
}

fun x11CodepointFromKeysym(symbol: int): int {
    var codepoint = 0
    if ((symbol >= 32 && symbol <= 126) ||
        (symbol >= 160 && symbol <= 255)) codepoint = symbol
    else if ((symbol & 4278190080) == 16777216) {
        val unicode = symbol & 16777215
        if (unicode >= 32 && unicode <= 1114111 &&
            (unicode < 55296 || unicode > 57343)) codepoint = unicode
    }
    codepoint
}

fun x11Utf8(codepoint: int): string {
    var result = ""
    if (codepoint >= 1 && codepoint <= 1114111 &&
        (codepoint < 55296 || codepoint > 57343)) {
        val output = nativeByteBuffer(5)
        var length = 0
        if (codepoint <= 127) {
            output.store(0, codepoint)
            length = 1
        } else if (codepoint <= 2047) {
            output.store(0, 192 | (codepoint >>> 6))
            output.store(1, 128 | (codepoint & 63))
            length = 2
        } else if (codepoint <= 65535) {
            output.store(0, 224 | (codepoint >>> 12))
            output.store(1, 128 | ((codepoint >>> 6) & 63))
            output.store(2, 128 | (codepoint & 63))
            length = 3
        } else {
            output.store(0, 240 | (codepoint >>> 18))
            output.store(1, 128 | ((codepoint >>> 12) & 63))
            output.store(2, 128 | ((codepoint >>> 6) & 63))
            output.store(3, 128 | (codepoint & 63))
            length = 4
        }
        result = output.adoptString(length)
    }
    result
}

class X11TextInput(val codepoint: int, val text: string)

fun x11TextInput(
    keysyms: array<int>,
    platformCode: int,
    state: int
): X11TextInput {
    var symbol = 0
    val offset = platformCode * 2
    if (offset >= 0 && offset + 1 < keysyms.size &&
        (state & (4 | 8 | 64)) == 0) {
        val primary = keysyms[offset]
        val shifted = keysyms[offset + 1]
        val shift = (state & 1) != 0
        val caps = (state & 2) != 0 &&
            primary >= 97 && primary <= 122 &&
            shifted >= 65 && shifted <= 90
        if (shift != caps) symbol = shifted else symbol = primary
    }
    val codepoint = x11CodepointFromKeysym(symbol)
    X11TextInput(codepoint, x11Utf8(codepoint))
}

fun x11PointerButton(platformCode: int): int {
    var button = pointerButtonUnknown
    if (platformCode == 1) button = pointerButtonLeft
    else if (platformCode == 2) button = pointerButtonMiddle
    else if (platformCode == 3) button = pointerButtonRight
    else if (platformCode == 8) button = pointerButtonBack
    else if (platformCode == 9) button = pointerButtonForward
    button
}

fun x11CreateRequest(
    setup: X11Setup,
    window: int,
    config: WindowConfig
): string {
    val request = nativeByteBuffer(41)
    request.store(0, 1)
    request.store(1, setup.rootDepth)
    x11StoreU16(request, 2, 10)
    x11StoreU32(request, 4, window)
    x11StoreU32(request, 8, setup.root)
    x11StoreU16(request, 12, 0)
    x11StoreU16(request, 14, 0)
    x11StoreU16(request, 16, config.width)
    x11StoreU16(request, 18, config.height)
    x11StoreU16(request, 20, 0)
    x11StoreU16(request, 22, 1)
    x11StoreU32(request, 24, setup.rootVisual)
    x11StoreU32(request, 28, 2050)
    x11StoreU32(request, 32, setup.blackPixel)
    x11StoreU32(request, 36, x11EventMask)
    x11Packet(request, 40)
}

fun x11SingleWindowRequest(opcode: int, window: int): string {
    val request = nativeByteBuffer(9)
    request.store(0, opcode)
    request.store(1, 0)
    x11StoreU16(request, 2, 2)
    x11StoreU32(request, 4, window)
    x11Packet(request, 8)
}

fun x11ResizeWindowRequest(window: int, width: int, height: int): string {
    val request = nativeByteBuffer(21)
    request.store(0, 12)
    request.store(1, 0)
    x11StoreU16(request, 2, 5)
    x11StoreU32(request, 4, window)
    x11StoreU16(request, 8, 12)
    x11StoreU16(request, 10, 0)
    x11StoreU32(request, 12, width)
    x11StoreU32(request, 16, height)
    x11Packet(request, 20)
}

fun x11InternAtomRequest(name: string): string {
    var length = name.size
    if (length > 4096) length = 4096
    val padded = ((length + 3) / 4) * 4
    val total = 8 + padded
    val request = nativeByteBuffer(total + 1)
    request.store(0, 16)
    request.store(1, 0)
    x11StoreU16(request, 2, total / 4)
    x11StoreU16(request, 4, length)
    request.store(6, 0)
    request.store(7, 0)
    var index = 0
    while (index < length) {
        request.store(8 + index, name[index])
        index = index + 1
    }
    while (index < padded) {
        request.store(8 + index, 0)
        index = index + 1
    }
    x11Packet(request, total)
}

fun x11InternAtom(descriptor: int, name: string): int {
    var atom = 0
    if (descriptor >= 0 && name != "" &&
        x11WriteAll(descriptor, x11InternAtomRequest(name))) {
        val reply = x11ReadExact(descriptor, 32)
        if (reply.size == 32 && reply[0] == 1) atom = x11U32(reply, 8)
    }
    atom
}

fun x11WindowProtocolsRequest(
    window: int,
    protocolsAtom: int,
    deleteAtom: int
): string {
    val request = nativeByteBuffer(29)
    request.store(0, 18)
    request.store(1, 0)
    x11StoreU16(request, 2, 7)
    x11StoreU32(request, 4, window)
    x11StoreU32(request, 8, protocolsAtom)
    x11StoreU32(request, 12, 4)
    request.store(16, 32)
    request.store(17, 0)
    request.store(18, 0)
    request.store(19, 0)
    x11StoreU32(request, 20, 1)
    x11StoreU32(request, 24, deleteAtom)
    x11Packet(request, 28)
}

fun x11CloseClientMessageRequest(
    window: int,
    protocolsAtom: int,
    deleteAtom: int
): string {
    val request = nativeByteBuffer(45)
    request.store(0, 25)
    request.store(1, 0)
    x11StoreU16(request, 2, 11)
    x11StoreU32(request, 4, window)
    x11StoreU32(request, 8, 0)
    request.store(12, 33)
    request.store(13, 32)
    x11StoreU16(request, 14, 0)
    x11StoreU32(request, 16, window)
    x11StoreU32(request, 20, protocolsAtom)
    x11StoreU32(request, 24, deleteAtom)
    x11Packet(request, 44)
}

fun x11SyntheticKeyRequest(
    window: int,
    platformCode: int,
    pressed: bool,
    state: int = 0
): string {
    val request = nativeByteBuffer(45)
    request.store(0, 25)
    request.store(1, 0)
    x11StoreU16(request, 2, 11)
    x11StoreU32(request, 4, window)
    x11StoreU32(request, 8, if (pressed) 1 else 2)
    request.store(12, if (pressed) 2 else 3)
    request.store(13, platformCode)
    x11StoreU16(request, 14, 0)
    x11StoreU32(request, 16, 0)
    x11StoreU32(request, 20, 0)
    x11StoreU32(request, 24, window)
    x11StoreU32(request, 28, 0)
    x11StoreU16(request, 32, 0)
    x11StoreU16(request, 34, 0)
    x11StoreU16(request, 36, 0)
    x11StoreU16(request, 38, 0)
    x11StoreU16(request, 40, state)
    request.store(42, 1)
    request.store(43, 0)
    x11Packet(request, 44)
}

fun x11SyntheticPointerRequest(
    window: int,
    eventType: int,
    detail: int,
    x: int,
    y: int
): string {
    val request = nativeByteBuffer(45)
    request.store(0, 25)
    request.store(1, 0)
    x11StoreU16(request, 2, 11)
    x11StoreU32(request, 4, window)
    var mask = 64
    if (eventType == 4) mask = 4
    else if (eventType == 5) mask = 8
    x11StoreU32(request, 8, mask)
    request.store(12, eventType)
    request.store(13, detail)
    x11StoreU16(request, 14, 0)
    x11StoreU32(request, 16, 0)
    x11StoreU32(request, 20, 0)
    x11StoreU32(request, 24, window)
    x11StoreU32(request, 28, 0)
    x11StoreU16(request, 32, x)
    x11StoreU16(request, 34, y)
    x11StoreU16(request, 36, x)
    x11StoreU16(request, 38, y)
    x11StoreU16(request, 40, 0)
    request.store(42, 1)
    request.store(43, 0)
    x11Packet(request, 44)
}

fun x11WarpPointerRequest(window: int, x: int, y: int): string {
    val request = nativeByteBuffer(25)
    request.store(0, 41)
    request.store(1, 0)
    x11StoreU16(request, 2, 6)
    x11StoreU32(request, 4, 0)
    x11StoreU32(request, 8, window)
    x11StoreU16(request, 12, 0)
    x11StoreU16(request, 14, 0)
    x11StoreU16(request, 16, 0)
    x11StoreU16(request, 18, 0)
    x11StoreU16(request, 20, x)
    x11StoreU16(request, 22, y)
    x11Packet(request, 24)
}

fun x11GrabPointerRequest(window: int): string {
    val request = nativeByteBuffer(25)
    request.store(0, 26)
    request.store(1, 0)
    x11StoreU16(request, 2, 6)
    x11StoreU32(request, 4, window)
    x11StoreU16(request, 8, 4 | 8 | 64)
    request.store(10, 1)
    request.store(11, 1)
    x11StoreU32(request, 12, window)
    x11StoreU32(request, 16, 0)
    x11StoreU32(request, 20, 0)
    x11Packet(request, 24)
}

fun x11UngrabPointerRequest(): string {
    val request = nativeByteBuffer(9)
    request.store(0, 27)
    request.store(1, 0)
    x11StoreU16(request, 2, 2)
    x11StoreU32(request, 4, 0)
    x11Packet(request, 8)
}

fun x11WindowTitleRequest(window: int, title: string): string {
    var length = title.size
    if (length > 4096) length = 4096
    val padded = ((length + 3) / 4) * 4
    val total = 24 + padded
    val request = nativeByteBuffer(total + 1)
    request.store(0, 18)
    request.store(1, 0)
    x11StoreU16(request, 2, total / 4)
    x11StoreU32(request, 4, window)
    x11StoreU32(request, 8, 39)
    x11StoreU32(request, 12, 31)
    request.store(16, 8)
    request.store(17, 0)
    request.store(18, 0)
    request.store(19, 0)
    x11StoreU32(request, 20, length)
    var index = 0
    while (index < length) {
        request.store(24 + index, title[index])
        index = index + 1
    }
    while (index < padded) {
        request.store(24 + index, 0)
        index = index + 1
    }
    x11Packet(request, total)
}

fun x11WindowSizeHintsRequest(
    window: int,
    width: int,
    height: int
): string {
    val request = nativeByteBuffer(97)
    request.store(0, 18)
    request.store(1, 0)
    x11StoreU16(request, 2, 24)
    x11StoreU32(request, 4, window)
    x11StoreU32(request, 8, 40)
    x11StoreU32(request, 12, 41)
    request.store(16, 32)
    request.store(17, 0)
    request.store(18, 0)
    request.store(19, 0)
    x11StoreU32(request, 20, 18)
    x11StoreU32(request, 24, 48)
    x11StoreU32(request, 44, width)
    x11StoreU32(request, 48, height)
    x11StoreU32(request, 52, width)
    x11StoreU32(request, 56, height)
    x11Packet(request, 96)
}

fun x11UndecoratedHintsRequest(window: int, motifHintsAtom: int): string {
    val request = nativeByteBuffer(45)
    request.store(0, 18)
    request.store(1, 0)
    x11StoreU16(request, 2, 11)
    x11StoreU32(request, 4, window)
    x11StoreU32(request, 8, motifHintsAtom)
    x11StoreU32(request, 12, motifHintsAtom)
    request.store(16, 32)
    request.store(17, 0)
    request.store(18, 0)
    request.store(19, 0)
    x11StoreU32(request, 20, 5)
    x11StoreU32(request, 24, 2)
    x11StoreU32(request, 28, 0)
    x11StoreU32(request, 32, 0)
    x11StoreU32(request, 36, 0)
    x11StoreU32(request, 40, 0)
    x11Packet(request, 44)
}

fun x11AtomPropertyRequest(
    window: int,
    propertyAtom: int,
    valueAtom: int
): string {
    val request = nativeByteBuffer(29)
    request.store(0, 18)
    request.store(1, 0)
    x11StoreU16(request, 2, 7)
    x11StoreU32(request, 4, window)
    x11StoreU32(request, 8, propertyAtom)
    x11StoreU32(request, 12, 4)
    request.store(16, 32)
    request.store(17, 0)
    request.store(18, 0)
    request.store(19, 0)
    x11StoreU32(request, 20, 1)
    x11StoreU32(request, 24, valueAtom)
    x11Packet(request, 28)
}

fun x11BytePropertyRequest(
    window: int,
    propertyAtom: int,
    typeAtom: int,
    value: string
): string {
    var length = value.size
    if (length > 1048576) length = 1048576
    val padded = ((length + 3) / 4) * 4
    val total = 24 + padded
    val request = nativeByteBuffer(total + 1)
    request.store(0, 18)
    request.store(1, 0)
    x11StoreU16(request, 2, total / 4)
    x11StoreU32(request, 4, window)
    x11StoreU32(request, 8, propertyAtom)
    x11StoreU32(request, 12, typeAtom)
    request.store(16, 8)
    request.store(17, 0)
    request.store(18, 0)
    request.store(19, 0)
    x11StoreU32(request, 20, length)
    var index = 0
    while (index < length) {
        request.store(24 + index, value[index])
        index = index + 1
    }
    while (index < padded) {
        request.store(24 + index, 0)
        index = index + 1
    }
    x11Packet(request, total)
}

fun x11TargetsPropertyRequest(
    window: int,
    propertyAtom: int,
    utf8Atom: int,
    targetsAtom: int
): string {
    val request = nativeByteBuffer(33)
    request.store(0, 18)
    request.store(1, 0)
    x11StoreU16(request, 2, 8)
    x11StoreU32(request, 4, window)
    x11StoreU32(request, 8, propertyAtom)
    x11StoreU32(request, 12, 4)
    request.store(16, 32)
    request.store(17, 0)
    request.store(18, 0)
    request.store(19, 0)
    x11StoreU32(request, 20, 2)
    x11StoreU32(request, 24, utf8Atom)
    x11StoreU32(request, 28, targetsAtom)
    x11Packet(request, 32)
}

fun x11SetSelectionOwnerRequest(owner: int, selectionAtom: int): string {
    val request = nativeByteBuffer(17)
    request.store(0, 22)
    request.store(1, 0)
    x11StoreU16(request, 2, 4)
    x11StoreU32(request, 4, owner)
    x11StoreU32(request, 8, selectionAtom)
    x11StoreU32(request, 12, 0)
    x11Packet(request, 16)
}

fun x11GetSelectionOwnerRequest(selectionAtom: int): string {
    val request = nativeByteBuffer(9)
    request.store(0, 23)
    request.store(1, 0)
    x11StoreU16(request, 2, 2)
    x11StoreU32(request, 4, selectionAtom)
    x11Packet(request, 8)
}

fun x11ConvertSelectionRequest(
    requestor: int,
    selectionAtom: int,
    targetAtom: int,
    propertyAtom: int
): string {
    val request = nativeByteBuffer(25)
    request.store(0, 24)
    request.store(1, 0)
    x11StoreU16(request, 2, 6)
    x11StoreU32(request, 4, requestor)
    x11StoreU32(request, 8, selectionAtom)
    x11StoreU32(request, 12, targetAtom)
    x11StoreU32(request, 16, propertyAtom)
    x11StoreU32(request, 20, 0)
    x11Packet(request, 24)
}

fun x11SelectionNotifyRequest(
    requestor: int,
    selectionAtom: int,
    targetAtom: int,
    propertyAtom: int,
    time: int
): string {
    val request = nativeByteBuffer(45)
    request.store(0, 25)
    request.store(1, 0)
    x11StoreU16(request, 2, 11)
    x11StoreU32(request, 4, requestor)
    x11StoreU32(request, 8, 0)
    request.store(12, 31)
    request.store(13, 0)
    x11StoreU16(request, 14, 0)
    x11StoreU32(request, 16, time)
    x11StoreU32(request, 20, requestor)
    x11StoreU32(request, 24, selectionAtom)
    x11StoreU32(request, 28, targetAtom)
    x11StoreU32(request, 32, propertyAtom)
    x11StoreU32(request, 36, 0)
    x11StoreU32(request, 40, 0)
    x11Packet(request, 44)
}

fun x11GetPropertyRequest(window: int, propertyAtom: int): string {
    val request = nativeByteBuffer(25)
    request.store(0, 20)
    request.store(1, 1)
    x11StoreU16(request, 2, 6)
    x11StoreU32(request, 4, window)
    x11StoreU32(request, 8, propertyAtom)
    x11StoreU32(request, 12, 0)
    x11StoreU32(request, 16, 0)
    x11StoreU32(request, 20, 262144)
    x11Packet(request, 24)
}

resource class X11Window(
    var descriptor: int,
    val identifier: int,
    val visual: int,
    val protocolsAtom: int,
    val deleteAtom: int,
    val clipboardAtom: int,
    val utf8Atom: int,
    val targetsAtom: int,
    val clipboardPropertyAtom: int,
    val keysyms: array<int>,
    val primaryMonitor: Monitor,
    var width: int,
    var height: int,
    var visible: bool,
    var pointerCaptured: bool,
    var title: string,
    var pendingEvent: WindowEvent,
    var pendingPackets: array<string>,
    var pendingPacketIndex: int,
    var clipboardOwned: bool,
    var clipboard: string
) {
    fun valid(): bool = this.descriptor >= 0 && this.identifier != 0
    fun keyboardMapped(): bool = x11KeyboardMappingAvailable(this.keysyms)

    fun platformKeycode(key: int): int {
        var result = 0
        var index = 8
        while (result == 0 && index * 2 < this.keysyms.size) {
            if (x11KeyFromKeysym(this.keysyms[index * 2]) == key) result = index
            index = index + 1
        }
        result
    }

    fun readReplyHeader(): string {
        var reply = ""
        var reading = this.valid()
        var queued = 0
        while (reading && reply == "" && queued < 4096) {
            val packet = x11ReadExact(this.descriptor, 32)
            if (packet.size != 32 || packet[0] == 0) reading = false
            else if (packet[0] == 1) reply = packet
            else {
                this.pendingPackets.append(packet)
                queued = queued + 1
            }
        }
        reply
    }

    fun sendSyntheticKey(
        platformCode: int,
        pressed: bool,
        state: int = 0
    ): bool =
        this.valid() && platformCode >= 8 && platformCode <= 255 &&
        x11WriteAll(
            this.descriptor,
            x11SyntheticKeyRequest(
                this.identifier,
                platformCode,
                pressed,
                state
            )
        )

    fun sendSyntheticPointerButton(
        platformCode: int,
        pressed: bool
    ): bool = this.valid() && platformCode >= 1 && platformCode <= 255 &&
        x11WriteAll(
            this.descriptor,
            x11SyntheticPointerRequest(
                this.identifier,
                if (pressed) 4 else 5,
                platformCode,
                0,
                0
            )
        )

    fun sendSyntheticPointerMove(x: int, y: int): bool =
        this.valid() && x >= -32768 && x <= 32767 &&
        y >= -32768 && y <= 32767 && x11WriteAll(
            this.descriptor,
            x11SyntheticPointerRequest(this.identifier, 6, 0, x, y)
        )

    fun setPointerPosition(x: int, y: int): bool =
        this.valid() && x >= -32768 && x <= 32767 &&
        y >= -32768 && y <= 32767 && x11WriteAll(
            this.descriptor,
            x11WarpPointerRequest(this.identifier, x, y)
        )

    fun setPointerCaptured(captured: bool): bool {
        var succeeded = this.valid()
        if (succeeded && captured != this.pointerCaptured) {
            if (captured) {
                succeeded = this.visible && x11WriteAll(
                    this.descriptor,
                    x11GrabPointerRequest(this.identifier)
                )
                val reply = if (succeeded) this.readReplyHeader() else ""
                succeeded = reply.size == 32 && reply[0] == 1 && reply[1] == 0
            } else {
                succeeded = x11WriteAll(
                    this.descriptor,
                    x11UngrabPointerRequest()
                )
            }
            if (succeeded) this.pointerCaptured = captured
        }
        succeeded
    }

    fun setClipboard(value: string): bool {
        var succeeded = this.valid() && value.size <= 1048576 &&
            this.clipboardAtom != 0 && x11WriteAll(
                this.descriptor,
                x11SetSelectionOwnerRequest(
                    this.identifier,
                    this.clipboardAtom
                )
            ) && x11WriteAll(
                this.descriptor,
                x11GetSelectionOwnerRequest(this.clipboardAtom)
            )
        val reply = if (succeeded) this.readReplyHeader() else ""
        succeeded = reply.size == 32 && x11U32(reply, 8) == this.identifier
        if (succeeded) {
            this.clipboardOwned = true
            this.clipboard = value
        }
        succeeded
    }

    fun requestClipboard(): bool = this.valid() &&
        this.clipboardAtom != 0 && this.utf8Atom != 0 &&
        this.clipboardPropertyAtom != 0 && x11WriteAll(
            this.descriptor,
            x11ConvertSelectionRequest(
                this.identifier,
                this.clipboardAtom,
                this.utf8Atom,
                this.clipboardPropertyAtom
            )
        )

    fun requestClipboardFormats(): bool = this.valid() &&
        this.clipboardAtom != 0 && this.targetsAtom != 0 &&
        this.clipboardPropertyAtom != 0 && x11WriteAll(
            this.descriptor,
            x11ConvertSelectionRequest(
                this.identifier,
                this.clipboardAtom,
                this.targetsAtom,
                this.clipboardPropertyAtom
            )
        )

    fun serveClipboardRequest(event: string): bool {
        val requestor = x11U32(event, 12)
        val selection = x11U32(event, 16)
        val target = x11U32(event, 20)
        var property = x11U32(event, 24)
        if (property == 0) property = target
        var succeeded = this.clipboardOwned &&
            selection == this.clipboardAtom && requestor != 0 && property != 0
        if (succeeded && (target == this.utf8Atom || target == 31)) {
            succeeded = x11WriteAll(
                this.descriptor,
                x11BytePropertyRequest(
                    requestor,
                    property,
                    target,
                    this.clipboard
                )
            )
        } else if (succeeded && target == this.targetsAtom) {
            succeeded = x11WriteAll(
                this.descriptor,
                x11TargetsPropertyRequest(
                    requestor,
                    property,
                    this.utf8Atom,
                    this.targetsAtom
                )
            )
        } else succeeded = false
        x11WriteAll(
            this.descriptor,
            x11SelectionNotifyRequest(
                requestor,
                selection,
                target,
                if (succeeded) property else 0,
                x11U32(event, 4)
            )
        ) && succeeded
    }

    fun readClipboardProperty(target: int): WindowEvent {
        var text = ""
        var textAvailable = false
        var succeeded = x11WriteAll(
            this.descriptor,
            x11GetPropertyRequest(this.identifier, this.clipboardPropertyAtom)
        )
        val reply = if (succeeded) this.readReplyHeader() else ""
        succeeded = reply.size == 32 && x11U32(reply, 12) == 0 &&
            x11U32(reply, 16) <= 1048576
        var body = ""
        if (reply.size == 32) {
            val bodyLength = x11U32(reply, 4) * 4
            if (bodyLength >= 0 && bodyLength <= 4194304) {
                body = x11ReadExact(this.descriptor, bodyLength)
            }
        }
        val itemCount = if (reply.size == 32) x11U32(reply, 16) else 0
        if (target == this.utf8Atom) {
            succeeded = succeeded && reply[1] == 8 &&
                x11U32(reply, 8) == this.utf8Atom && body.size >= itemCount
            if (succeeded) {
                text = body.slice(0, itemCount)
                textAvailable = true
            }
        } else if (target == this.targetsAtom) {
            succeeded = succeeded && reply[1] == 32 &&
                x11U32(reply, 8) == 4 && body.size >= itemCount * 4
            var index = 0
            while (succeeded && index < itemCount) {
                if (x11U32(body, index * 4) == this.utf8Atom) {
                    textAvailable = true
                }
                index = index + 1
            }
        } else succeeded = false
        WindowEvent(
            windowEventClipboard,
            if (succeeded) 1 else 0,
            if (textAvailable) 1 else 0,
            text
        )
    }

    fun show(): bool {
        var succeeded = this.valid()
        if (succeeded && !this.visible) {
            succeeded = x11WriteAll(
                this.descriptor,
                x11SingleWindowRequest(8, this.identifier)
            )
            if (succeeded) this.visible = true
        }
        succeeded
    }

    fun hide(): bool {
        var succeeded = this.valid()
        if (succeeded && this.pointerCaptured) {
            succeeded = this.setPointerCaptured(false)
        }
        if (succeeded && this.visible) {
            succeeded = x11WriteAll(
                this.descriptor,
                x11SingleWindowRequest(10, this.identifier)
            )
            if (succeeded) this.visible = false
        }
        succeeded
    }

    fun setTitle(title: string): bool {
        val succeeded = this.valid() && title.size <= 4096 &&
            x11WriteAll(
                this.descriptor,
                x11WindowTitleRequest(this.identifier, title)
            )
        if (succeeded) this.title = title
        succeeded
    }

    fun resize(width: int, height: int): bool =
        this.valid() && width > 0 && width <= 65536 &&
        height > 0 && height <= 65536 && x11WriteAll(
            this.descriptor,
            x11ResizeWindowRequest(this.identifier, width, height)
        )

    fun pollEvent(timeoutMilliseconds: int = 0): WindowEvent {
        var result = WindowEvent()
        if (this.pendingEvent.happened()) {
            result = this.pendingEvent
            this.pendingEvent = WindowEvent()
        } else if (this.valid() && timeoutMilliseconds >= 0 &&
            timeoutMilliseconds <= 600000) {
            var event = ""
            var readable = false
            if (this.pendingPacketIndex < this.pendingPackets.size) {
                event = this.pendingPackets[this.pendingPacketIndex]
                this.pendingPacketIndex = this.pendingPacketIndex + 1
                readable = true
                if (this.pendingPacketIndex == this.pendingPackets.size) {
                    this.pendingPackets = []
                    this.pendingPacketIndex = 0
                }
            } else {
                val poll = nativeByteBuffer(8)
                x11StoreU32(poll, 0, this.descriptor)
                x11StoreU16(poll, 4, 1)
                val measured = linuxSyscall3(
                    7,
                    nativePointerAddress(poll.address),
                    1,
                    timeoutMilliseconds
                )
                readable = measured > 0 && poll.load(6) != 0
                poll.close()
                if (readable) event = x11ReadExact(this.descriptor, 32)
            }
            if (readable) {
                if (event.size == 32) {
                    val kind = event[0] & 127
                    if (kind == 2 || kind == 3) {
                        val platformCode = event[1]
                        val offset = platformCode * 2
                        val symbol = if (offset < this.keysyms.size)
                            this.keysyms[offset]
                        else 0
                        result = WindowEvent(
                            windowEventKey,
                            x11KeyFromKeysym(symbol),
                            if (kind == 2) 1 else 0,
                            "",
                            platformCode
                        )
                        if (kind == 2) {
                            val text = x11TextInput(
                                this.keysyms,
                                platformCode,
                                x11U16(event, 28)
                            )
                            if (text.text != "") {
                                this.pendingEvent = WindowEvent(
                                    windowEventText,
                                    text.codepoint,
                                    0,
                                    text.text,
                                    platformCode
                                )
                            }
                        }
                    } else if (kind == 4 || kind == 5) {
                        val platformCode = event[1]
                        if (kind == 4 && platformCode >= 4 &&
                            platformCode <= 7) {
                            var scrollX = 0
                            var scrollY = 0
                            if (platformCode == 4) scrollY = 1
                            else if (platformCode == 5) scrollY = -1
                            else if (platformCode == 6) scrollX = -1
                            else if (platformCode == 7) scrollX = 1
                            result = WindowEvent(
                                windowEventScrolled,
                                scrollX,
                                scrollY,
                                "",
                                platformCode
                            )
                        } else if (platformCode < 4 || platformCode > 7) {
                            result = WindowEvent(
                                windowEventPointerButton,
                                x11PointerButton(platformCode),
                                if (kind == 4) 1 else 0,
                                "",
                                platformCode
                            )
                        }
                    } else if (kind == 6) {
                        result = WindowEvent(
                            windowEventPointerMoved,
                            x11I16(event, 24),
                            x11I16(event, 26)
                        )
                    } else if (kind == 9 || kind == 10) {
                        result = WindowEvent(
                            windowEventFocused,
                            if (kind == 9) 1 else 0
                        )
                    } else if (kind == 17) {
                        result = WindowEvent(windowEventCloseRequested)
                    } else if (kind == 29 &&
                        x11U32(event, 12) == this.clipboardAtom) {
                        this.clipboardOwned = false
                        this.clipboard = ""
                    } else if (kind == 30) {
                        this.serveClipboardRequest(event)
                    } else if (kind == 31 &&
                        x11U32(event, 12) == this.clipboardAtom) {
                        if (x11U32(event, 20) == this.clipboardPropertyAtom) {
                            result = this.readClipboardProperty(
                                x11U32(event, 16)
                            )
                        } else {
                            result = WindowEvent(windowEventClipboard)
                        }
                    } else if (kind == 33 && event[1] == 32 &&
                        x11U32(event, 8) == this.protocolsAtom &&
                        x11U32(event, 12) == this.deleteAtom) {
                        result = WindowEvent(windowEventCloseRequested)
                    } else if (kind == 22) {
                        this.width = x11U16(event, 20)
                        this.height = x11U16(event, 22)
                        result = WindowEvent(
                            windowEventResized,
                            this.width,
                            this.height
                        )
                    }
                }
            }
        }
        result
    }

    fun requestClose(): bool =
        this.valid() && this.protocolsAtom != 0 && this.deleteAtom != 0 &&
        x11WriteAll(
            this.descriptor,
            x11CloseClientMessageRequest(
                this.identifier,
                this.protocolsAtom,
                this.deleteAtom
            )
        )

    fun drop(): void {
        if (this.valid() && this.pointerCaptured) {
            x11WriteAll(this.descriptor, x11UngrabPointerRequest())
            this.pointerCaptured = false
        }
        if (this.valid()) {
            x11WriteAll(
                this.descriptor,
                x11SingleWindowRequest(4, this.identifier)
            )
        }
        if (this.descriptor >= 0) linuxSyscall1(3, this.descriptor)
        this.descriptor = -1
        return
    }
}

fun x11Window(
    config: WindowConfig = WindowConfig(),
    displayNumber: int = x11ConfiguredDisplayNumber()
): X11Window {
    var descriptor = -1
    var identifier = 0
    var visual = 0
    var protocolsAtom = 0
    var deleteAtom = 0
    var clipboardAtom = 0
    var utf8Atom = 0
    var targetsAtom = 0
    var clipboardPropertyAtom = 0
    var keysyms: array<int> = []
    var primaryMonitor = Monitor()
    if (config.valid() && !config.transparent) {
        descriptor = x11ConnectUnix(displayNumber)
    }
    if (descriptor >= 0) {
        val setup = x11Setup(descriptor, x11Authority(displayNumber))
        if (setup.succeeded) {
            primaryMonitor = Monitor(
                "X11 screen 0",
                setup.screenWidth,
                setup.screenHeight,
                setup.screenWidthMillimeters,
                setup.screenHeightMillimeters
            )
            keysyms = x11KeyboardMapping(
                descriptor,
                setup.minimumKeycode,
                setup.maximumKeycode
            )
            protocolsAtom = x11InternAtom(descriptor, "WM_PROTOCOLS")
            deleteAtom = x11InternAtom(descriptor, "WM_DELETE_WINDOW")
            clipboardAtom = x11InternAtom(descriptor, "CLIPBOARD")
            utf8Atom = x11InternAtom(descriptor, "UTF8_STRING")
            targetsAtom = x11InternAtom(descriptor, "TARGETS")
            clipboardPropertyAtom = x11InternAtom(
                descriptor,
                "ABLA_CLIPBOARD"
            )
            visual = setup.rootVisual
            identifier = setup.resourceBase | (1 & setup.resourceMask)
            val created = x11WriteAll(
                descriptor,
                x11CreateRequest(setup, identifier, config)
            )
            var ready = false
            if (created) {
                var configured = x11KeyboardMappingAvailable(keysyms) &&
                    protocolsAtom != 0 && deleteAtom != 0 &&
                    clipboardAtom != 0 && utf8Atom != 0 &&
                    targetsAtom != 0 && clipboardPropertyAtom != 0 &&
                    x11WriteAll(
                    descriptor,
                    x11WindowTitleRequest(identifier, config.title)
                )
                if (configured) {
                    configured = x11WriteAll(
                        descriptor,
                        x11WindowProtocolsRequest(
                            identifier,
                            protocolsAtom,
                            deleteAtom
                        )
                    )
                }
                if (configured && !config.resizable) {
                    configured = x11WriteAll(
                        descriptor,
                        x11WindowSizeHintsRequest(
                            identifier,
                            config.width,
                            config.height
                        )
                    )
                }
                if (configured && !config.decorated) {
                    val motifHints = x11InternAtom(
                        descriptor,
                        "_MOTIF_WM_HINTS"
                    )
                    configured = motifHints != 0
                    if (configured) {
                        configured = x11WriteAll(
                            descriptor,
                            x11UndecoratedHintsRequest(identifier, motifHints)
                        )
                    }
                }
                if (configured && config.fullscreen) {
                    val state = x11InternAtom(descriptor, "_NET_WM_STATE")
                    val fullscreen = x11InternAtom(
                        descriptor,
                        "_NET_WM_STATE_FULLSCREEN"
                    )
                    configured = state != 0 && fullscreen != 0
                    if (configured) {
                        configured = x11WriteAll(
                            descriptor,
                            x11AtomPropertyRequest(
                                identifier,
                                state,
                                fullscreen
                            )
                        )
                    }
                }
                ready = configured && (!config.visible || x11WriteAll(
                        descriptor,
                        x11SingleWindowRequest(8, identifier)
                    ))
            }
            if (!ready) identifier = 0
        }
        if (identifier == 0) {
            linuxSyscall1(3, descriptor)
            descriptor = -1
        }
    }
    X11Window(
        descriptor,
        identifier,
        visual,
