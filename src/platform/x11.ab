// Minimal X11 wire-protocol client implemented entirely in Abla.
//
// This module talks to the local X server over AF_UNIX. It does not use Xlib,
// XCB, GLFW, SDL, or a project native shim.

import "abla/sys/linux"
import "abla/sys/linux/fs"
import "abla/sys/linux/process"
import "abla/unsafe/memory"
import "../window.ab"

val x11EventMask = 1 | 2 | 4 | 8 | 64 | 32768 | 131072 | 2097152

fun x11U16(value: string, offset: int): int =
    value[offset] + value[offset + 1] * 256

fun x11U32(value: string, offset: int): int =
    x11U16(value, offset) + x11U16(value, offset + 2) * 65536

fun x11BigU16(value: string, offset: int): int =
    value[offset] * 256 + value[offset + 1]

fun x11StoreU16(var buffer: NativeByteBuffer, offset: int, value: int): void {
    buffer.store(offset, value & 255)
    buffer.store(offset + 1, (value >>> 8) & 255)
    return
}

fun x11StoreU32(var buffer: NativeByteBuffer, offset: int, value: int): void {
    x11StoreU16(buffer, offset, value & 65535)
    x11StoreU16(buffer, offset + 2, (value >>> 16) & 65535)
    return
}

fun x11Packet(var buffer: NativeByteBuffer, length: int): string =
    buffer.adoptString(length)

fun x11WriteAll(descriptor: int, value: string): bool {
    var offset = 0
    var succeeded = descriptor >= 0
    while (succeeded && offset < value.size) {
        val written = linuxWrite(
            descriptor,
            value.slice(offset, value.size)
        )
        if (written <= 0) succeeded = false
        else offset = offset + written
    }
    succeeded
}

fun x11ReadExact(descriptor: int, length: int): string {
    var result = ""
    var reading = descriptor >= 0 && length >= 0 && length <= 16777216
    while (reading && result.size < length) {
        val file = LinuxFileDescriptor(descriptor)
        val part = file.read(length - result.size)
        if (part.size == 0) reading = false
        else result = "$result$part"
    }
    if (result.size == length) result else ""
}

fun x11DisplayNumber(value: string): int {
    var colon = -1
    var index = 0
    while (index < value.size) {
        if (value[index] == 58) colon = index
        index = index + 1
    }
    var result = -1
    if (colon >= 0 && colon + 1 < value.size) {
        var parsed = 0
        var valid = true
        index = colon + 1
        var digits = 0
        while (valid && index < value.size && value[index] != 46) {
            val digit = value[index] - 48
            if (digit < 0 || digit > 9) valid = false
            else {
                parsed = parsed * 10 + digit
                digits = digits + 1
            }
            index = index + 1
        }
        if (valid && digits > 0 && parsed <= 65535) result = parsed
    }
    result
}

fun x11ConfiguredDisplayNumber(): int {
    val configured = linuxEnvironment("DISPLAY")
    if (configured.found) x11DisplayNumber(configured.value) else -1
}

class X11Authority(val name: string, val data: string)

fun x11AuthorityPath(): string {
    val configured = linuxEnvironment("XAUTHORITY")
    var result = if (configured.found) configured.value else ""
    if (result == "") {
        val home = linuxEnvironment("HOME")
        if (home.found) result = "${home.value}/.Xauthority"
    }
    result
}

fun x11Authority(displayNumber: int): X11Authority {
    var selectedName = ""
    var selectedData = ""
    val path = x11AuthorityPath()
    var source = ""
    if (path != "" && Path(path).exists()) source = Path(path).readText()
    val wantedNumber = "$displayNumber"
    var offset = 0
    while (selectedData == "" && offset + 2 <= source.size) {
        val family = x11BigU16(source, offset)
        offset = offset + 2
        var valid = offset + 2 <= source.size
        var addressLength = 0
        if (valid) {
            addressLength = x11BigU16(source, offset)
            offset = offset + 2
            valid = addressLength <= 4096 &&
                offset + addressLength + 2 <= source.size
        }
        if (valid) offset = offset + addressLength
        var number = ""
        if (valid) {
            val length = x11BigU16(source, offset)
            offset = offset + 2
            valid = length <= 64 && offset + length + 2 <= source.size
            if (valid) {
                number = source.slice(offset, offset + length)
                offset = offset + length
            }
        }
        var name = ""
        if (valid) {
            val length = x11BigU16(source, offset)
            offset = offset + 2
            valid = length <= 256 && offset + length + 2 <= source.size
            if (valid) {
                name = source.slice(offset, offset + length)
                offset = offset + length
            }
        }
        var data = ""
        if (valid) {
            val length = x11BigU16(source, offset)
            offset = offset + 2
            valid = length <= 4096 && offset + length <= source.size
            if (valid) {
                data = source.slice(offset, offset + length)
                offset = offset + length
            }
        }
        if (valid && (family == 256 || family == 65535) &&
            number == wantedNumber && name == "MIT-MAGIC-COOKIE-1" &&
            data.size == 16) {
            selectedName = name
            selectedData = data
        }
        if (!valid) offset = source.size
    }
    X11Authority(selectedName, selectedData)
}

fun x11ConnectUnix(displayNumber: int): int {
    var descriptor = -1
    val path = "/tmp/.X11-unix/X$displayNumber"
    if (displayNumber >= 0 && displayNumber <= 65535 && path.size <= 107) {
        descriptor = linuxSyscall3(41, 1, 524289, 0)
    }
    if (descriptor >= 0) {
        val address = nativeByteBuffer(110)
        address.store(0, 1)
        address.store(1, 0)
        var index = 0
        while (index < path.size) {
            address.store(2 + index, path[index])
            index = index + 1
        }
        address.store(2 + path.size, 0)
        val connected = linuxSyscall3(
            42,
            descriptor,
            nativePointerAddress(address.address),
            3 + path.size
        )
        address.close()
        if (connected != 0) {
            linuxSyscall1(3, descriptor)
            descriptor = connected
        }
    }
    descriptor
}

class X11Setup(
    val succeeded: bool,
    val resourceBase: int,
    val resourceMask: int,
    val root: int,
    val rootVisual: int,
    val rootDepth: int,
    val blackPixel: int,
    val whitePixel: int,
    val minimumKeycode: int,
    val maximumKeycode: int
)

fun x11Setup(descriptor: int, authority: X11Authority): X11Setup {
    var succeeded = descriptor >= 0
    if (succeeded) {
        val namePadded = ((authority.name.size + 3) / 4) * 4
        val dataPadded = ((authority.data.size + 3) / 4) * 4
        val length = 12 + namePadded + dataPadded
        val request = nativeByteBuffer(length + 1)
        request.store(0, 108)
        request.store(1, 0)
        x11StoreU16(request, 2, 11)
        x11StoreU16(request, 4, 0)
        x11StoreU16(request, 6, authority.name.size)
        x11StoreU16(request, 8, authority.data.size)
        request.store(10, 0)
        request.store(11, 0)
        var index = 0
        while (index < authority.name.size) {
            request.store(12 + index, authority.name[index])
            index = index + 1
        }
        index = 0
        while (index < authority.data.size) {
            request.store(12 + namePadded + index, authority.data[index])
            index = index + 1
        }
        succeeded = x11WriteAll(descriptor, x11Packet(request, length))
    }

    var prefix = ""
    if (succeeded) prefix = x11ReadExact(descriptor, 8)
    succeeded = prefix.size == 8 && prefix[0] == 1
    var body = ""
    if (succeeded) {
        val bodyLength = x11U16(prefix, 6) * 4
        succeeded = bodyLength >= 32 && bodyLength <= 16777216
        if (succeeded) body = x11ReadExact(descriptor, bodyLength)
        succeeded = body.size == bodyLength
    }

    var resourceBase = 0
    var resourceMask = 0
    var root = 0
    var rootVisual = 0
    var rootDepth = 0
    var blackPixel = 0
    var whitePixel = 0
    var minimumKeycode = 0
    var maximumKeycode = 0
    if (succeeded) {
        resourceBase = x11U32(body, 4)
        resourceMask = x11U32(body, 8)
        val vendorLength = x11U16(body, 16)
        val formatCount = body[21]
        val screenCount = body[20]
        minimumKeycode = body[26]
        maximumKeycode = body[27]
        val screenOffset =
            32 + ((vendorLength + 3) / 4) * 4 + formatCount * 8
        succeeded = screenCount > 0 && screenOffset + 40 <= body.size
        if (succeeded) {
            root = x11U32(body, screenOffset)
            whitePixel = x11U32(body, screenOffset + 8)
            blackPixel = x11U32(body, screenOffset + 12)
            rootVisual = x11U32(body, screenOffset + 32)
            rootDepth = body[screenOffset + 38]
            succeeded = root != 0 && resourceMask != 0 && rootDepth > 0
        }
    }
    X11Setup(
        succeeded,
        resourceBase,
        resourceMask,
        root,
        rootVisual,
        rootDepth,
        blackPixel,
        whitePixel,
        minimumKeycode,
        maximumKeycode
    )
}

fun x11KeyboardMappingRequest(first: int, count: int): string {
    val request = nativeByteBuffer(9)
    request.store(0, 101)
    request.store(1, 0)
    x11StoreU16(request, 2, 2)
    request.store(4, first)
    request.store(5, count)
    request.store(6, 0)
    request.store(7, 0)
    x11Packet(request, 8)
}

fun x11KeyboardMapping(
    descriptor: int,
    minimumKeycode: int,
    maximumKeycode: int
): array<int> {
    val mapping: array<int> = []
    var index = 0
    while (index < 256) {
        mapping.append(0)
        index = index + 1
    }
    val count = maximumKeycode - minimumKeycode + 1
    if (descriptor >= 0 && minimumKeycode >= 8 && maximumKeycode <= 255 &&
        count > 0 && count <= 248 &&
        x11WriteAll(
            descriptor,
            x11KeyboardMappingRequest(minimumKeycode, count)
        )) {
        val reply = x11ReadExact(descriptor, 32)
        if (reply.size == 32 && reply[0] == 1) {
            val symbolsPerKeycode = reply[1]
            val bodyLength = x11U32(reply, 4) * 4
            val body = x11ReadExact(descriptor, bodyLength)
            if (symbolsPerKeycode > 0 &&
                body.size == count * symbolsPerKeycode * 4) {
                var keycode = minimumKeycode
                while (keycode <= maximumKeycode) {
                    var symbolIndex = 0
                    var symbol = 0
                    while (symbol == 0 && symbolIndex < symbolsPerKeycode) {
                        val offset = (
                            (keycode - minimumKeycode) * symbolsPerKeycode +
                            symbolIndex
                        ) * 4
                        symbol = x11U32(body, offset)
                        symbolIndex = symbolIndex + 1
                    }
                    mapping[keycode] = symbol
                    keycode = keycode + 1
                }
            }
        }
    }
    mapping
}

fun x11KeyboardMappingAvailable(mapping: array<int>): bool {
    var available = false
    var index = 0
    while (!available && index < mapping.size) {
        available = mapping[index] != 0
        index = index + 1
    }
    available
}

fun x11KeyFromKeysym(symbol: int): int {
    var key = keyUnknown
    if (symbol >= 32 && symbol <= 126) {
        key = symbol
        if (key >= 97 && key <= 122) key = key - 32
    } else if (symbol == 65288) key = keyBackspace
    else if (symbol == 65289) key = keyTab
    else if (symbol == 65293) key = keyEnter
    else if (symbol == 65307) key = keyEscape
    else if (symbol == 65360) key = keyHome
    else if (symbol == 65361) key = keyLeft
    else if (symbol == 65362) key = keyUp
    else if (symbol == 65363) key = keyRight
    else if (symbol == 65364) key = keyDown
    else if (symbol == 65365) key = keyPageUp
    else if (symbol == 65366) key = keyPageDown
    else if (symbol == 65367) key = keyEnd
    else if (symbol == 65379) key = keyInsert
    else if (symbol == 65535) key = keyDelete
    else if (symbol >= 65470 && symbol <= 65481) key = keyF1 + symbol - 65470
    else if (symbol >= 65456 && symbol <= 65465) key = keyKp0 + symbol - 65456
    else if (symbol == 65454) key = keyKpDecimal
    else if (symbol == 65455) key = keyKpDivide
    else if (symbol == 65450) key = keyKpMultiply
    else if (symbol == 65453) key = keyKpSubtract
    else if (symbol == 65451) key = keyKpAdd
    else if (symbol == 65421) key = keyKpEnter
    else if (symbol == 65469) key = keyKpEqual
    else if (symbol == 65509) key = keyCapsLock
    else if (symbol == 65300) key = keyScrollLock
    else if (symbol == 65407) key = keyNumLock
    else if (symbol == 65377) key = keyPrintScreen
    else if (symbol == 65299) key = keyPause
    else if (symbol == 65505) key = keyLeftShift
    else if (symbol == 65506) key = keyRightShift
    else if (symbol == 65507) key = keyLeftControl
    else if (symbol == 65508) key = keyRightControl
    else if (symbol == 65513) key = keyLeftAlt
    else if (symbol == 65514) key = keyRightAlt
    else if (symbol == 65515) key = keyLeftSuper
    else if (symbol == 65516) key = keyRightSuper
    else if (symbol == 65383) key = keyMenu
    key
}

fun x11CreateRequest(
    setup: X11Setup,
    window: int,
    config: WindowConfig
): string {
    val request = nativeByteBuffer(41)
    request.store(0, 1)
    request.store(1, setup.rootDepth)
    x11StoreU16(request, 2, 10)
    x11StoreU32(request, 4, window)
    x11StoreU32(request, 8, setup.root)
    x11StoreU16(request, 12, 0)
    x11StoreU16(request, 14, 0)
    x11StoreU16(request, 16, config.width)
    x11StoreU16(request, 18, config.height)
    x11StoreU16(request, 20, 0)
    x11StoreU16(request, 22, 1)
    x11StoreU32(request, 24, setup.rootVisual)
    x11StoreU32(request, 28, 2050)
    x11StoreU32(request, 32, setup.blackPixel)
    x11StoreU32(request, 36, x11EventMask)
    x11Packet(request, 40)
}

fun x11SingleWindowRequest(opcode: int, window: int): string {
    val request = nativeByteBuffer(9)
    request.store(0, opcode)
    request.store(1, 0)
    x11StoreU16(request, 2, 2)
    x11StoreU32(request, 4, window)
    x11Packet(request, 8)
}

fun x11InternAtomRequest(name: string): string {
    var length = name.size
    if (length > 4096) length = 4096
    val padded = ((length + 3) / 4) * 4
    val total = 8 + padded
    val request = nativeByteBuffer(total + 1)
    request.store(0, 16)
    request.store(1, 0)
    x11StoreU16(request, 2, total / 4)
    x11StoreU16(request, 4, length)
    request.store(6, 0)
    request.store(7, 0)
    var index = 0
    while (index < length) {
        request.store(8 + index, name[index])
        index = index + 1
    }
    while (index < padded) {
        request.store(8 + index, 0)
        index = index + 1
    }
    x11Packet(request, total)
}

fun x11InternAtom(descriptor: int, name: string): int {
    var atom = 0
    if (descriptor >= 0 && name != "" &&
        x11WriteAll(descriptor, x11InternAtomRequest(name))) {
        val reply = x11ReadExact(descriptor, 32)
        if (reply.size == 32 && reply[0] == 1) atom = x11U32(reply, 8)
    }
    atom
}

fun x11WindowProtocolsRequest(
    window: int,
    protocolsAtom: int,
    deleteAtom: int
): string {
    val request = nativeByteBuffer(29)
    request.store(0, 18)
    request.store(1, 0)
    x11StoreU16(request, 2, 7)
    x11StoreU32(request, 4, window)
    x11StoreU32(request, 8, protocolsAtom)
    x11StoreU32(request, 12, 4)
    request.store(16, 32)
    request.store(17, 0)
    request.store(18, 0)
    request.store(19, 0)
    x11StoreU32(request, 20, 1)
    x11StoreU32(request, 24, deleteAtom)
    x11Packet(request, 28)
}

fun x11CloseClientMessageRequest(
    window: int,
    protocolsAtom: int,
    deleteAtom: int
): string {
    val request = nativeByteBuffer(45)
    request.store(0, 25)
    request.store(1, 0)
    x11StoreU16(request, 2, 11)
    x11StoreU32(request, 4, window)
    x11StoreU32(request, 8, 0)
    request.store(12, 33)
    request.store(13, 32)
    x11StoreU16(request, 14, 0)
    x11StoreU32(request, 16, window)
    x11StoreU32(request, 20, protocolsAtom)
    x11StoreU32(request, 24, deleteAtom)
    x11Packet(request, 44)
}

fun x11SyntheticKeyRequest(
    window: int,
    platformCode: int,
    pressed: bool
): string {
    val request = nativeByteBuffer(45)
    request.store(0, 25)
    request.store(1, 0)
    x11StoreU16(request, 2, 11)
    x11StoreU32(request, 4, window)
    x11StoreU32(request, 8, if (pressed) 1 else 2)
    request.store(12, if (pressed) 2 else 3)
    request.store(13, platformCode)
    x11StoreU16(request, 14, 0)
    x11StoreU32(request, 16, 0)
    x11StoreU32(request, 20, 0)
    x11StoreU32(request, 24, window)
    x11StoreU32(request, 28, 0)
    x11StoreU16(request, 32, 0)
    x11StoreU16(request, 34, 0)
    x11StoreU16(request, 36, 0)
    x11StoreU16(request, 38, 0)
    x11StoreU16(request, 40, 0)
    request.store(42, 1)
    request.store(43, 0)
    x11Packet(request, 44)
}

fun x11WindowTitleRequest(window: int, title: string): string {
    var length = title.size
    if (length > 4096) length = 4096
    val padded = ((length + 3) / 4) * 4
    val total = 24 + padded
    val request = nativeByteBuffer(total + 1)
    request.store(0, 18)
    request.store(1, 0)
    x11StoreU16(request, 2, total / 4)
    x11StoreU32(request, 4, window)
    x11StoreU32(request, 8, 39)
    x11StoreU32(request, 12, 31)
    request.store(16, 8)
    request.store(17, 0)
    request.store(18, 0)
    request.store(19, 0)
    x11StoreU32(request, 20, length)
    var index = 0
    while (index < length) {
        request.store(24 + index, title[index])
        index = index + 1
    }
    while (index < padded) {
        request.store(24 + index, 0)
        index = index + 1
    }
    x11Packet(request, total)
}

fun x11WindowSizeHintsRequest(
    window: int,
    width: int,
    height: int
): string {
    val request = nativeByteBuffer(97)
    request.store(0, 18)
    request.store(1, 0)
    x11StoreU16(request, 2, 24)
    x11StoreU32(request, 4, window)
    x11StoreU32(request, 8, 40)
    x11StoreU32(request, 12, 41)
    request.store(16, 32)
    request.store(17, 0)
    request.store(18, 0)
    request.store(19, 0)
    x11StoreU32(request, 20, 18)
    x11StoreU32(request, 24, 48)
    x11StoreU32(request, 44, width)
    x11StoreU32(request, 48, height)
    x11StoreU32(request, 52, width)
    x11StoreU32(request, 56, height)
    x11Packet(request, 96)
}

fun x11UndecoratedHintsRequest(window: int, motifHintsAtom: int): string {
    val request = nativeByteBuffer(45)
    request.store(0, 18)
    request.store(1, 0)
    x11StoreU16(request, 2, 11)
    x11StoreU32(request, 4, window)
    x11StoreU32(request, 8, motifHintsAtom)
    x11StoreU32(request, 12, motifHintsAtom)
    request.store(16, 32)
    request.store(17, 0)
    request.store(18, 0)
    request.store(19, 0)
    x11StoreU32(request, 20, 5)
    x11StoreU32(request, 24, 2)
    x11StoreU32(request, 28, 0)
    x11StoreU32(request, 32, 0)
    x11StoreU32(request, 36, 0)
    x11StoreU32(request, 40, 0)
    x11Packet(request, 44)
}

fun x11AtomPropertyRequest(
    window: int,
    propertyAtom: int,
    valueAtom: int
): string {
    val request = nativeByteBuffer(29)
    request.store(0, 18)
    request.store(1, 0)
    x11StoreU16(request, 2, 7)
    x11StoreU32(request, 4, window)
    x11StoreU32(request, 8, propertyAtom)
    x11StoreU32(request, 12, 4)
    request.store(16, 32)
    request.store(17, 0)
    request.store(18, 0)
    request.store(19, 0)
    x11StoreU32(request, 20, 1)
    x11StoreU32(request, 24, valueAtom)
    x11Packet(request, 28)
}

resource class X11Window(
    var descriptor: int,
    val identifier: int,
    val visual: int,
    val protocolsAtom: int,
    val deleteAtom: int,
    val keysyms: array<int>,
    var width: int,
    var height: int,
    var visible: bool,
    var title: string
) {
    fun valid(): bool = this.descriptor >= 0 && this.identifier != 0
    fun keyboardMapped(): bool = x11KeyboardMappingAvailable(this.keysyms)

    fun platformKeycode(key: int): int {
        var result = 0
        var index = 0
        while (result == 0 && index < this.keysyms.size) {
            if (x11KeyFromKeysym(this.keysyms[index]) == key) result = index
            index = index + 1
        }
        result
    }

    fun sendSyntheticKey(platformCode: int, pressed: bool): bool =
        this.valid() && platformCode >= 8 && platformCode <= 255 &&
        x11WriteAll(
            this.descriptor,
            x11SyntheticKeyRequest(this.identifier, platformCode, pressed)
        )

    fun show(): bool {
        var succeeded = this.valid()
        if (succeeded && !this.visible) {
            succeeded = x11WriteAll(
                this.descriptor,
                x11SingleWindowRequest(8, this.identifier)
            )
            if (succeeded) this.visible = true
        }
        succeeded
    }

    fun hide(): bool {
        var succeeded = this.valid()
        if (succeeded && this.visible) {
            succeeded = x11WriteAll(
                this.descriptor,
                x11SingleWindowRequest(10, this.identifier)
            )
            if (succeeded) this.visible = false
        }
        succeeded
    }

    fun setTitle(title: string): bool {
        val succeeded = this.valid() && title.size <= 4096 &&
            x11WriteAll(
                this.descriptor,
                x11WindowTitleRequest(this.identifier, title)
            )
        if (succeeded) this.title = title
        succeeded
    }

    fun pollEvent(timeoutMilliseconds: int = 0): WindowEvent {
        var result = WindowEvent()
        if (this.valid() && timeoutMilliseconds >= 0 &&
            timeoutMilliseconds <= 600000) {
            val poll = nativeByteBuffer(8)
            x11StoreU32(poll, 0, this.descriptor)
            x11StoreU16(poll, 4, 1)
            val measured = linuxSyscall3(
                7,
                nativePointerAddress(poll.address),
                1,
                timeoutMilliseconds
            )
            val readable = measured > 0 && poll.load(6) != 0
            poll.close()
            if (readable) {
                val event = x11ReadExact(this.descriptor, 32)
                if (event.size == 32) {
                    val kind = event[0] & 127
                    if (kind == 2 || kind == 3) {
                        val platformCode = event[1]
                        val symbol = if (platformCode < this.keysyms.size)
                            this.keysyms[platformCode]
                        else 0
                        result = WindowEvent(
                            windowEventKey,
                            x11KeyFromKeysym(symbol),
                            if (kind == 2) 1 else 0,
                            "",
                            platformCode
                        )
                    } else if (kind == 4 || kind == 5) {
                        result = WindowEvent(
                            windowEventPointerButton,
                            event[1],
                            if (kind == 4) 1 else 0
                        )
                    } else if (kind == 6) {
                        result = WindowEvent(
                            windowEventPointerMoved,
                            x11U16(event, 24),
                            x11U16(event, 26)
                        )
                    } else if (kind == 9 || kind == 10) {
                        result = WindowEvent(
                            windowEventFocused,
                            if (kind == 9) 1 else 0
                        )
                    } else if (kind == 17) {
                        result = WindowEvent(windowEventCloseRequested)
                    } else if (kind == 33 && event[1] == 32 &&
                        x11U32(event, 8) == this.protocolsAtom &&
                        x11U32(event, 12) == this.deleteAtom) {
                        result = WindowEvent(windowEventCloseRequested)
                    } else if (kind == 22) {
                        this.width = x11U16(event, 20)
                        this.height = x11U16(event, 22)
                        result = WindowEvent(
                            windowEventResized,
                            this.width,
                            this.height
                        )
                    }
                }
            }
        }
        result
    }

    fun requestClose(): bool =
        this.valid() && this.protocolsAtom != 0 && this.deleteAtom != 0 &&
        x11WriteAll(
            this.descriptor,
            x11CloseClientMessageRequest(
                this.identifier,
                this.protocolsAtom,
                this.deleteAtom
            )
        )

    fun drop(): void {
        if (this.valid()) {
            x11WriteAll(
                this.descriptor,
                x11SingleWindowRequest(4, this.identifier)
            )
        }
        if (this.descriptor >= 0) linuxSyscall1(3, this.descriptor)
        this.descriptor = -1
        return
    }
}

fun x11Window(
    config: WindowConfig = WindowConfig(),
    displayNumber: int = x11ConfiguredDisplayNumber()
): X11Window {
    var descriptor = -1
    var identifier = 0
    var visual = 0
    var protocolsAtom = 0
    var deleteAtom = 0
    var keysyms: array<int> = []
    if (config.valid() && !config.transparent) {
        descriptor = x11ConnectUnix(displayNumber)
    }
    if (descriptor >= 0) {
        val setup = x11Setup(descriptor, x11Authority(displayNumber))
        if (setup.succeeded) {
            keysyms = x11KeyboardMapping(
                descriptor,
                setup.minimumKeycode,
                setup.maximumKeycode
            )
            protocolsAtom = x11InternAtom(descriptor, "WM_PROTOCOLS")
            deleteAtom = x11InternAtom(descriptor, "WM_DELETE_WINDOW")
            visual = setup.rootVisual
            identifier = setup.resourceBase | (1 & setup.resourceMask)
            val created = x11WriteAll(
                descriptor,
                x11CreateRequest(setup, identifier, config)
            )
            var ready = false
            if (created) {
                var configured = x11KeyboardMappingAvailable(keysyms) &&
                    protocolsAtom != 0 && deleteAtom != 0 && x11WriteAll(
                    descriptor,
                    x11WindowTitleRequest(identifier, config.title)
                )
                if (configured) {
                    configured = x11WriteAll(
                        descriptor,
                        x11WindowProtocolsRequest(
                            identifier,
                            protocolsAtom,
                            deleteAtom
                        )
                    )
                }
                if (configured && !config.resizable) {
                    configured = x11WriteAll(
                        descriptor,
                        x11WindowSizeHintsRequest(
                            identifier,
                            config.width,
                            config.height
                        )
                    )
                }
                if (configured && !config.decorated) {
                    val motifHints = x11InternAtom(
                        descriptor,
                        "_MOTIF_WM_HINTS"
                    )
                    configured = motifHints != 0
                    if (configured) {
                        configured = x11WriteAll(
                            descriptor,
                            x11UndecoratedHintsRequest(identifier, motifHints)
                        )
                    }
                }
                if (configured && config.fullscreen) {
                    val state = x11InternAtom(descriptor, "_NET_WM_STATE")
                    val fullscreen = x11InternAtom(
                        descriptor,
                        "_NET_WM_STATE_FULLSCREEN"
                    )
                    configured = state != 0 && fullscreen != 0
                    if (configured) {
                        configured = x11WriteAll(
                            descriptor,
                            x11AtomPropertyRequest(
                                identifier,
                                state,
                                fullscreen
                            )
                        )
                    }
                }
                ready = configured && (!config.visible || x11WriteAll(
                        descriptor,
                        x11SingleWindowRequest(8, identifier)
                    ))
            }
            if (!ready) identifier = 0
        }
        if (identifier == 0) {
            linuxSyscall1(3, descriptor)
            descriptor = -1
        }
    }
    X11Window(
        descriptor,
        identifier,
        visual,
        protocolsAtom,
        deleteAtom,
        keysyms,
        config.width,
        config.height,
        config.visible,
        config.title
    )
}
