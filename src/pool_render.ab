// Generation-checked device-buffer-pool draw helpers.

import "core.ab"
import "pool.ab"
import "render.ab"
import "push_constants.ab"

trusted fun GraphicsApplication.presentRenderBufferPoolVertices(
    var pipeline: GraphicsRenderPipeline,
    pool: GraphicsBufferPool,
    vertices: int,
    vertexCount: int,
    clear: Color,
    instanceCount: int = 1
): bool = pool.allocationValid(vertices) && this.presentRenderVertices(
    pipeline,
    pool.backing,
    vertexCount,
    clear,
    instanceCount,
    pool.allocationOffset(vertices),
    pool.allocationSize(vertices)
)

trusted fun GraphicsApplication.presentRenderBufferPoolIndexed(
    var pipeline: GraphicsRenderPipeline,
    pool: GraphicsBufferPool,
    vertices: int,
    indices: int,
    indexCount: int,
    clear: Color,
    instanceCount: int = 1
): bool = pool.allocationValid(vertices) &&
    pool.allocationValid(indices) && this.presentRenderIndexed(
        pipeline,
        pool.backing,
        pool.backing,
        indexCount,
        clear,
        instanceCount,
        pool.allocationOffset(vertices),
        pool.allocationSize(vertices),
        pool.allocationOffset(indices),
        pool.allocationSize(indices)
    )

trusted fun GraphicsApplication.presentRenderBufferPoolVerticesIndirect(
    var pipeline: GraphicsRenderPipeline,
    pool: GraphicsBufferPool,
    vertices: int,
    indirect: int,
    clear: Color
): bool = pool.allocationValid(vertices) &&
    pool.allocationValid(indirect) && this.presentRenderVerticesIndirect(
        pipeline,
        pool.backing,
        pool.backing,
        clear,
        pool.allocationOffset(vertices),
        pool.allocationSize(vertices),
        pool.allocationOffset(indirect),
        pool.allocationSize(indirect)
    )

trusted fun GraphicsApplication.presentRenderBufferPoolIndexedIndirect(
    var pipeline: GraphicsRenderPipeline,
    pool: GraphicsBufferPool,
    vertices: int,
    indices: int,
    indirect: int,
    clear: Color
): bool = pool.allocationValid(vertices) &&
    pool.allocationValid(indices) && pool.allocationValid(indirect) &&
    this.presentRenderIndexedIndirect(
        pipeline,
        pool.backing,
        pool.backing,
        pool.backing,
        clear,
        pool.allocationOffset(vertices),
        pool.allocationSize(vertices),
        pool.allocationOffset(indices),
        pool.allocationSize(indices),
        pool.allocationOffset(indirect),
        pool.allocationSize(indirect)
    )

