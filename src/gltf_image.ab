// Shared owned glTF image payload and decoded-pixel contracts.

import "pixels.ab"

class GltfImagePayload(
    val bytes: string,
    val mimeType: string,
    val valid: bool,
    val error: string
)

resource class GltfImagePixels(
    val pixels: PixelBuffer,
    val mimeType: string,
    val error: string
) {
    fun valid(): bool = this.error == "" &&
        (this.mimeType == "image/png" || this.mimeType == "image/jpeg") &&
        this.pixels.valid()

    trusted fun drop(): void {
        this.pixels.storage.close()
        return
    }
}
