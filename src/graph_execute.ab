// Ordered backend memory dependencies for materialized render graphs.

import "core.ab"
import "application.ab"
import "graph.ab"
import "graph_texture.ab"
import "driver/opengl.ab"
import "driver/vulkan.ab"

val graphicsGraphOpenGlAllBarrierBits = 65535
val graphicsGraphVulkanAllCommandsStage = 65536
val graphicsGraphVulkanMemoryReadAccess = 32768
val graphicsGraphVulkanMemoryWriteAccess = 65536

class GraphicsGraphBarrierIntent(
    val resourceId: int,
    val sourcePass: int,
    val destinationPass: int,
    val sourceAccess: int,
    val destinationAccess: int,
    val openGlBits: int,
    val vulkanSourceStage: int,
    val vulkanDestinationStage: int,
    val vulkanSourceAccess: int,
    val vulkanDestinationAccess: int
) {
    fun valid(): bool = this.resourceId >= 0 && this.sourcePass >= 0 &&
        this.destinationPass >= 0 &&
        this.sourceAccess >= graphAccessRead &&
        this.sourceAccess <= graphAccessReadWrite &&
        this.destinationAccess >= graphAccessRead &&
        this.destinationAccess <= graphAccessReadWrite &&
        this.openGlBits > 0 &&
        this.vulkanSourceStage == graphicsGraphVulkanAllCommandsStage &&
        this.vulkanDestinationStage == graphicsGraphVulkanAllCommandsStage &&
        this.vulkanSourceAccess > 0 && this.vulkanDestinationAccess > 0
}

fun graphicsGraphVulkanMemoryAccess(access: int): int {
    var result = 0
    if ((access & graphAccessRead) != 0) {
        result = result | graphicsGraphVulkanMemoryReadAccess
    }
    if ((access & graphAccessWrite) != 0) {
        result = result | graphicsGraphVulkanMemoryWriteAccess
    }
    result
}

fun graphicsGraphBarrierIntent(
    barrier: GraphicsGraphBarrier
): GraphicsGraphBarrierIntent = GraphicsGraphBarrierIntent(
    barrier.resourceId,
    barrier.sourcePass,
    barrier.destinationPass,
    barrier.sourceAccess,
    barrier.destinationAccess,
    graphicsGraphOpenGlAllBarrierBits,
    graphicsGraphVulkanAllCommandsStage,
    graphicsGraphVulkanAllCommandsStage,
    graphicsGraphVulkanMemoryAccess(barrier.sourceAccess),
    graphicsGraphVulkanMemoryAccess(barrier.destinationAccess)
)

fun graphicsGraphBarrierCountForPass(
    plan: GraphicsRenderGraphPlan,
    passId: int
): int {
    var count = 0
    var index = 0
    while (index < plan.barriers.size) {
        if (plan.barriers[index].destinationPass == passId) count = count + 1
        index = index + 1
    }
    count
}

trusted fun GraphicsApplication.beginMaterializedRenderGraphPass(
    var graph: GraphicsMaterializedRenderGraph,
    token: int,
    passId: int
): bool {
    val next = graph.currentPassPosition + 1
    var succeeded = this.valid() && graph.active(token) &&
        this.backend == graph.backend && next >= 0 &&
        next < graph.plan.order.size && graph.plan.order[next] == passId
    val barrierCount = if (succeeded)
        graph.compiledBarrierCounts[next] else 0
    val sourceAccess = if (succeeded)
        graph.compiledSourceAccesses[next] else 0
    val destinationAccess = if (succeeded)
        graph.compiledDestinationAccesses[next] else 0
    val openGlBits = if (barrierCount > 0)
        graphicsGraphOpenGlAllBarrierBits else 0
    val vulkanSourceAccess =
        graphicsGraphVulkanMemoryAccess(sourceAccess)
    val vulkanDestinationAccess =
        graphicsGraphVulkanMemoryAccess(destinationAccess)
    if (succeeded && barrierCount > 0 &&
        this.backend == graphicsBackendOpenGl) {
        succeeded = this.openGl.graphMemoryBarrier(openGlBits)
    } else if (succeeded && barrierCount > 0 &&
        this.backend == graphicsBackendVulkan) {
        succeeded = this.vulkanDevice.graphMemoryBarrier(
            vulkanSourceAccess,
            vulkanDestinationAccess
        )
    }
    if (succeeded) succeeded = graph.beginPass(token, passId)
    if (succeeded && barrierCount > 0) {
        graph.currentExecutionBarriers =
            graph.currentExecutionBarriers + barrierCount
        graph.totalExecutedBarriers =
            graph.totalExecutedBarriers + barrierCount
        graph.backendBarrierCalls = graph.backendBarrierCalls + 1
    }
    succeeded
}

trusted fun GraphicsApplication.recordVulkanMaterializedRenderGraphPass(
    var graph: GraphicsMaterializedRenderGraph,
    token: int,
    passId: int
): bool {
    val next = graph.currentPassPosition + 1
    var succeeded = this.valid() &&
        this.backend == graphicsBackendVulkan && graph.active(token) &&
        graph.backend == graphicsBackendVulkan && next >= 0 &&
        next < graph.plan.order.size && graph.plan.order[next] == passId
    val barrierCount = if (succeeded)
        graph.compiledBarrierCounts[next] else 0
    val sourceAccess = if (succeeded)
        graph.compiledSourceAccesses[next] else 0
    val destinationAccess = if (succeeded)
        graph.compiledDestinationAccesses[next] else 0
    succeeded = succeeded && barrierCount >= 0 &&
        graph.currentExecutionBarriers <= graphicsMaximumInt - barrierCount
    if (succeeded && barrierCount > 0) {
        this.vulkanDevice.recordTransferMemoryBarrier(
            graphicsGraphVulkanAllCommandsStage,
            graphicsGraphVulkanAllCommandsStage,
            graphicsGraphVulkanMemoryAccess(sourceAccess),
            graphicsGraphVulkanMemoryAccess(destinationAccess)
        )
    }
    if (succeeded) succeeded = graph.beginPass(token, passId)
    if (succeeded) {
        graph.currentExecutionBarriers =
            graph.currentExecutionBarriers + barrierCount
    }
    succeeded
}
