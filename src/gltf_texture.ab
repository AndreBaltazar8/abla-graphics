// Pure-Abla glTF image acquisition, PNG/JPEG decoding, and retained sampled
// texture/sampler materialization.

import "abla/crypto"
import "gltf_buffer.ab"
import "gltf_image.ab"
import "gltf_jpeg.ab"
import "gltf_png.ab"
import "texture.ab"
import "sampler.ab"
import "./gltf_scene.ab"
import "./resources.ab"
import "./core.ab"
import "./pixels.ab"
import "./gltf_material.ab"

resource class GltfGpuTexture(
    val texture: GraphicsTexture,
    val sampler: GraphicsSampler,
    val source: int,
    val error: string
) {
    fun valid(): bool = this.error == "" && this.source >= 0 &&
        this.texture.valid() && this.sampler.valid()

    trusted fun drop(): void {
        this.texture.drop()
        this.sampler.drop()
        return
    }
}

val gltfMaterialTextureBaseColor = 0
val gltfMaterialTextureMetallicRoughness = 1
val gltfMaterialTextureNormal = 2
val gltfMaterialTextureOcclusion = 3
val gltfMaterialTextureEmissive = 4
val gltfMaterialTextureChannelCount = 5

// Affine, deduplicated resources plus one stable slot per material/channel.
// Three complete materials fit the portable 16-entry bind-group ceiling.
resource class GltfGpuMaterialTextureTable(
    val values: array<GltfGpuTexture>,
    val materialIndices: array<int>,
    val slots: array<int>,
    val error: string
) {
    fun valid(): bool {
        var valid = this.error == "" && this.values.size > 0 &&
            this.values.size <= this.slots.size &&
            this.materialIndices.size > 0 &&
            this.materialIndices.size <= gltfMaximumMaterialBatchMaterials &&
            this.slots.size == this.materialIndices.size *
                gltfMaterialTextureChannelCount
        var index = 0
        while (valid && index < this.values.size) {
            valid = this.values[index].valid()
            index = index + 1
        }
        index = 0
        while (valid && index < this.slots.size) {
            valid = this.slots[index] >= 0 &&
                this.slots[index] < this.values.size
            index = index + 1
        }
        valid
    }

    fun materialCount(): int = this.materialIndices.size

    fun resourceSlot(material: int, channel: int): int =
        if (this.valid() && material >= 0 &&
            material < this.materialIndices.size && channel >= 0 &&
            channel < gltfMaterialTextureChannelCount)
            this.slots[material * gltfMaterialTextureChannelCount + channel]
        else -1

    fun binding(material: int, channel: int): int =
        if (material >= 0 && material < this.materialIndices.size &&
            channel >= 0 && channel < gltfMaterialTextureChannelCount)
            material * gltfMaterialTextureChannelCount + channel
        else -1
}

fun gltfMaterialTextureInfo(
    material: GltfMaterial,
    channel: int
): GltfTextureInfo =
    if (channel == gltfMaterialTextureBaseColor)
        material.baseColorTexture
    else if (channel == gltfMaterialTextureMetallicRoughness)
        material.metallicRoughnessTexture
    else if (channel == gltfMaterialTextureNormal)
        material.normalTexture
    else if (channel == gltfMaterialTextureOcclusion)
        material.occlusionTexture
    else if (channel == gltfMaterialTextureEmissive)
        material.emissiveTexture
    else GltfTextureInfo(index = -2)

fun gltfMaterialTextureSrgb(channel: int): bool =
    channel == gltfMaterialTextureBaseColor ||
    channel == gltfMaterialTextureEmissive

fun gltfMaterialFallbackKey(channel: int): int =
    if (channel == gltfMaterialTextureBaseColor) -1
    else if (channel == gltfMaterialTextureMetallicRoughness ||
        channel == gltfMaterialTextureOcclusion) -2
    else if (channel == gltfMaterialTextureNormal) -3
    else -4

fun gltfImagePayload(
    document: GltfDocument,
    buffers: GltfBufferPayloads,
    imageIndex: int,
    supplied: array<string> = []
): GltfImagePayload {
    if (!document.valid() || !buffers.valid || imageIndex < 0 ||
        imageIndex >= document.images.size ||
        (supplied.size != 0 && supplied.size != document.images.size))
        return GltfImagePayload("", "", false, "invalid glTF image request")
    val image = document.images[imageIndex]
    val external = if (supplied.size == document.images.size)
        supplied[imageIndex] else ""
    var bytes = external
    var mimeType = image.mimeType
    if (bytes.size == 0 && image.bufferView >= 0) {
        val view = document.bufferViews[image.bufferView]
        val source = buffers.values[view.buffer]
        if (view.byteOffset <= source.size - view.byteLength)
            bytes = source.slice(view.byteOffset, view.byteOffset + view.byteLength)
    } else if (bytes.size == 0 && image.uri.size > 0) {
        val png = "data:image/png;base64,"
        val jpeg = "data:image/jpeg;base64,"
        if (image.uri.size >= png.size &&
            image.uri.slice(0, png.size) == png) {
            bytes = base64Decode(image.uri.slice(png.size, image.uri.size))
            mimeType = "image/png"
        } else if (image.uri.size >= jpeg.size &&
            image.uri.slice(0, jpeg.size) == jpeg) {
            bytes = base64Decode(image.uri.slice(jpeg.size, image.uri.size))
            mimeType = "image/jpeg"
        }
    }
    val valid = bytes.size > 0 && bytes.size <= 67108864 &&
        (mimeType == "image/png" || mimeType == "image/jpeg")
    GltfImagePayload(
        if (valid) bytes else "",
        if (valid) mimeType else "",
        valid,
        if (valid) "" else "unsupported or missing glTF image payload"
    )
}

trusted fun gltfDecodeImage(payload: GltfImagePayload): GltfImagePixels =
    if (payload.mimeType == "image/png") gltfDecodePng(payload)
    else gltfDecodeJpeg(payload)

fun gltfSamplerAddress(mode: int): int =
    if (mode == 33071) samplerAddressClampToEdge
    else if (mode == 33648) samplerAddressMirrorRepeat
    else samplerAddressRepeat

fun gltfSamplerDescriptor(value: GltfSampler): SamplerDescriptor {
    val mag = if (value.magFilter == 9728)
        samplerFilterNearest else samplerFilterLinear
    val min = if (value.minFilter == 9728 || value.minFilter == 9984 ||
        value.minFilter == 9986) samplerFilterNearest else samplerFilterLinear
    val mip = if (value.minFilter == 9986 || value.minFilter == 9987)
        samplerFilterLinear else samplerFilterNearest
    SamplerDescriptor(
        label = value.name,
        addressU = gltfSamplerAddress(value.wrapS),
        addressV = gltfSamplerAddress(value.wrapT),
        addressW = samplerAddressRepeat,
        magFilter = mag,
        minFilter = min,
        mipmapFilter = mip,
        lodMinimum = 0,
        lodMaximum = 0
    )
}

trusted fun GraphicsApplication.gltfGpuTexture(
    document: GltfDocument,
    buffers: GltfBufferPayloads,
    textureIndex: int,
    suppliedImages: array<string> = [],
    srgb: bool = true
): GltfGpuTexture {
    if (!this.valid() || !document.valid() || !buffers.valid ||
        textureIndex < 0 || textureIndex >= document.textures.size)
        return GltfGpuTexture(
            this.texture(TextureDescriptor()),
            this.sampler(SamplerDescriptor(addressU = -1)),
            -1,
            "invalid glTF texture materialization request"
        )
    val metadata = document.textures[textureIndex]
    val payload = gltfImagePayload(
        document, buffers, metadata.source, suppliedImages
    )
    val decoded = gltfDecodeImage(payload)
    if (!decoded.valid()) return GltfGpuTexture(
        this.texture(TextureDescriptor()),
        this.sampler(SamplerDescriptor(addressU = -1)),
        metadata.source,
        decoded.error
    )
    val texture = this.texture(TextureDescriptor(
        label = metadata.name,
        size = Extent3D(decoded.pixels.width, decoded.pixels.height),
        format = if (srgb) textureFormatRgba8UnormSrgb
            else textureFormatRgba8Unorm,
        usage = textureUsageSampled | textureUsageCopyDestination
    ))
    val samplerMetadata = if (metadata.sampler >= 0)
        document.samplers[metadata.sampler] else GltfSampler()
    val sampler = this.sampler(gltfSamplerDescriptor(samplerMetadata))
    val uploaded = texture.valid() && sampler.valid() &&
        texture.writePixels(decoded.pixels, TextureWriteDescriptor())
    GltfGpuTexture(
        move(texture),
        move(sampler),
        metadata.source,
        if (uploaded) "" else "glTF texture upload or sampler creation failed"
    )
}

trusted fun GraphicsApplication.gltfGpuFallbackTexture(
    channel: int,
    source: int
): GltfGpuTexture {
    val pixels = pixelBuffer(1, 1)
    val red = if (channel == gltfMaterialTextureNormal) 128
        else if (channel == gltfMaterialTextureEmissive) 0 else 255
    val green = if (channel == gltfMaterialTextureNormal) 128
        else if (channel == gltfMaterialTextureEmissive) 0 else 255
    val blue = if (channel == gltfMaterialTextureEmissive) 0 else 255
    val filled = pixels.valid() && pixels.clearRgba8(red, green, blue, 255)
    val texture = this.texture(TextureDescriptor(
        label = "gltf-material-fallback-$channel",
        size = Extent3D(1, 1),
        format = if (gltfMaterialTextureSrgb(channel))
            textureFormatRgba8UnormSrgb else textureFormatRgba8Unorm,
        usage = textureUsageSampled | textureUsageCopyDestination
    ))
    val sampler = this.sampler(SamplerDescriptor(
        label = "gltf-material-fallback-$channel",
        addressU = samplerAddressClampToEdge,
        addressV = samplerAddressClampToEdge,
        addressW = samplerAddressClampToEdge,
        magFilter = samplerFilterNearest,
        minFilter = samplerFilterNearest,
        mipmapFilter = samplerFilterNearest,
        lodMinimum = 0,
        lodMaximum = 0
    ))
    val uploaded = filled && texture.valid() && sampler.valid() &&
        texture.writePixels(pixels, TextureWriteDescriptor())
    GltfGpuTexture(
        move(texture), move(sampler), source,
        if (uploaded) "" else "glTF fallback texture creation failed"
    )
}

trusted fun GraphicsApplication.gltfGpuMaterialTextureTable(
    document: GltfDocument,
    buffers: GltfBufferPayloads,
    materialIndices: array<int>,
    suppliedImages: array<string> = []
): GltfGpuMaterialTextureTable {
    val values: array<GltfGpuTexture> = []
    val slots: array<int> = []
    val keys: array<int> = []
    var valid = this.valid() && document.valid() && buffers.valid &&
        materialIndices.size > 0 &&
        materialIndices.size <= gltfMaximumMaterialBatchMaterials &&
        (suppliedImages.size == 0 ||
         suppliedImages.size == document.images.size)
    var material = 0
    while (valid && material < materialIndices.size) {
        val materialIndex = materialIndices[material]
        valid = materialIndex >= -1 && materialIndex < document.materials.size
        var earlier = 0
        while (valid && earlier < material) {
            valid = materialIndices[earlier] != materialIndex
            earlier = earlier + 1
        }
        var channel = 0
        while (valid && channel < gltfMaterialTextureChannelCount) {
            val materialValue = if (materialIndex >= 0)
                document.materials[materialIndex] else GltfMaterial()
            val info = gltfMaterialTextureInfo(materialValue, channel)
            val srgb = gltfMaterialTextureSrgb(channel)
            val key = if (info.present()) info.index * 2 +
                (if (srgb) 1 else 0)
                else gltfMaterialFallbackKey(channel)
            var slot = -1
            var candidate = 0
            while (slot < 0 && candidate < keys.size) {
                if (keys[candidate] == key) slot = candidate
                candidate = candidate + 1
            }
            if (slot < 0) {
                val gpu = if (info.present()) this.gltfGpuTexture(
                    document, buffers, info.index, suppliedImages, srgb
                ) else this.gltfGpuFallbackTexture(
                    channel,
                    document.images.size + document.textures.size +
                        channel + 1
                )
                valid = gpu.valid()
                keys.append(key)
                values.append(move(gpu))
                slot = values.size - 1
            }
            if (valid) slots.append(slot)
            channel = channel + 1
        }
        material = material + 1
    }
    GltfGpuMaterialTextureTable(
        move(values), materialIndices, slots,
        if (valid) "" else "glTF material texture table creation failed"
    )
}
