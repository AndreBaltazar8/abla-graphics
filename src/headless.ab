// Backend-neutral driver ownership for work that requires no platform window.

import "abla/unsafe/memory"
import "core.ab"
import "resources.ab"
import "driver/opengl.ab"
import "driver/vulkan.ab"

resource class GraphicsHeadlessApplication(
    var openGl: OpenGlContext,
    var vulkanDevice: VulkanDevice,
    var vulkanInstance: VulkanInstance,
    val backend: int,
    val capabilities: GraphicsCapabilities,
    val adapterName: string,
    val error: GraphicsError
) {
    fun valid(): bool = !this.error.occurred() &&
        this.capabilities.valid() &&
        ((this.backend == graphicsBackendOpenGl && this.openGl.valid()) ||
         (this.backend == graphicsBackendVulkan &&
          this.vulkanInstance.valid() && this.vulkanDevice.valid()))

    trusted fun probe(): bool {
        var succeeded = false
        if (this.backend == graphicsBackendOpenGl) {
            succeeded = this.openGl.clearBlackAndReadRgba8() == 0
        } else if (this.backend == graphicsBackendVulkan) {
            val buffer = this.vulkanDevice.buffer(8)
            succeeded = buffer.valid() && this.vulkanDevice.fillBuffer(
                buffer,
                BufferFillDescriptor(287454020)
            ) &&
                buffer.readI64() == 1234605615291183940
        }
        succeeded
    }

    trusted fun solidRgba8(
        red: int,
        green: int,
        blue: int,
        alpha: int = 255
    ): int {
        var result = -1
        val validColor = red >= 0 && red <= 255 &&
            green >= 0 && green <= 255 && blue >= 0 && blue <= 255 &&
            alpha >= 0 && alpha <= 255
        if (this.valid() && validColor &&
            this.backend == graphicsBackendOpenGl) {
            result = this.openGl.clearAndReadRgba8(
                red, green, blue, alpha
            )
        } else if (this.valid() && validColor &&
            this.backend == graphicsBackendVulkan) {
            val packed = red + green * 256 + blue * 65536 +
                alpha * 16777216
            val buffer = this.vulkanDevice.buffer(8)
            if (buffer.valid() && this.vulkanDevice.fillBuffer(
                buffer,
                BufferFillDescriptor(packed)
            ) && (buffer.readI64() & 4294967295) == packed) result = packed
        }
        result
    }

    trusted fun drop(): void {
        this.vulkanDevice.drop()
        this.vulkanInstance.drop()
        this.openGl.drop()
        return
    }
}

trusted fun graphicsHeadlessApplication(
    config: GraphicsConfig = GraphicsConfig(),
    width: int = 64,
    height: int = 64
): GraphicsHeadlessApplication {
    var openGl = OpenGlContext(
        nativeNullPointer(),
        nativeNullPointer(),
        nativeNullPointer(),
        0,
        0
    )
    var vulkanDevice = VulkanDevice(
        nativeNullPointer(),
        nativeNullPointer(),
        -1,
        0,
        nativeNullPointer(),
        false,
        false,
        false,
        true,
        false,
        0,
        0,
        0,
        0,
        "",
        nativePointerCell(nativeNullPointer()),
        nativeByteBuffer(0)
    )
    var vkInstance = VulkanInstance(nativeNullPointer(), 0)
    var backend = graphicsBackendAuto
    var capabilities = GraphicsCapabilities()
    var adapterName = ""
    var error = GraphicsError()
    var requiredFeaturesUnavailable = false

    if (!config.valid() || width <= 0 || width > 16384 ||
        height <= 0 || height > 16384) {
        error = GraphicsError(
            graphicsErrorInvalidConfiguration,
            "graphicsHeadlessApplication",
            "headless application configuration is invalid"
        )
    }

    val tryVulkan = !error.occurred() &&
        (config.backend == graphicsBackendAuto ||
         config.backend == graphicsBackendHeadless ||
         config.backend == graphicsBackendVulkan)
    if (tryVulkan) {
        vkInstance = vulkanInstance(
            "Abla Graphics headless",
            enableDebugUtils = config.validation
        )
        val adapters = vkInstance.adapters()
        var index = 0
        while (!vulkanDevice.valid() && index < adapters.size) {
            val adapterCapabilities = adapters[index].capabilities()
            if (adapterCapabilities.valid() &&
                adapterCapabilities.supports(config.requiredFeatures)) {
                vulkanDevice = adapters[index].device()
                if (vulkanDevice.valid()) {
                    adapterName = adapters[index].name
                    capabilities = adapterCapabilities
                }
            } else if (adapterCapabilities.valid()) {
                requiredFeaturesUnavailable = true
            }
            index = index + 1
        }
        if (vulkanDevice.valid()) backend = graphicsBackendVulkan
        else vkInstance.drop()
    }

    val tryOpenGl = !error.occurred() && backend == graphicsBackendAuto &&
        (config.backend == graphicsBackendAuto ||
         config.backend == graphicsBackendHeadless ||
         config.backend == graphicsBackendOpenGl)
    if (tryOpenGl) {
        openGl = openGlHeadlessContext(width, height)
        if (openGl.valid()) {
            val openGlCapabilities = openGl.capabilities()
            if (openGlCapabilities.valid() &&
                openGlCapabilities.supports(config.requiredFeatures)) {
                backend = graphicsBackendOpenGl
                adapterName = "OpenGL surfaceless context"
                capabilities = openGlCapabilities
            } else {
                requiredFeaturesUnavailable = true
                openGl.drop()
            }
        }
    }

    if (!error.occurred() && backend == graphicsBackendAuto) {
        error = GraphicsError(
            if (requiredFeaturesUnavailable)
                graphicsErrorUnsupportedFeature
            else graphicsErrorBackendUnavailable,
            "graphicsHeadlessApplication",
            if (requiredFeaturesUnavailable)
                "the requested features are unavailable"
            else "the requested headless backend is unavailable"
        )
    }

    GraphicsHeadlessApplication(
        move(openGl),
        move(vulkanDevice),
        move(vkInstance),
        backend,
        capabilities,
        adapterName,
        error
    )
}
