// Affine typed Vulkan structure builders. These are the runtime surface used
// by generated schemas: storage is zeroed once, pointer fields are borrowed,
// and the native bytes stay valid until the builder is dropped.

import "abla/unsafe/memory"
import "vulkan_builder_schema.ab"

class RawVulkanBuilderTypeLayout(
    val size: int,
    val alignment: int,
    val structureType: int,
    val extendsTypes: string,
    val valid: bool
)

class RawVulkanBuilderMemberLayout(
    val kind: string,
    val offset: int,
    val elementSize: int,
    val elementCount: int,
    val valid: bool
)

fun rawVulkanBuilderDelimiter(
    schema: string,
    begin: int,
    delimiter: int
): int {
    var found = -1
    var index = begin
    while (found < 0 && index < schema.size) {
        if (schema[index] == delimiter) found = index
        index = index + 1
    }
    found
}

fun rawVulkanBuilderInteger(
    schema: string,
    begin: int,
    end: int
): int {
    val negative = begin < end && schema[begin] == 45
    var index = if (negative) begin + 1 else begin
    var value = 0
    while (index < end && schema[index] >= 48 && schema[index] <= 57) {
        value = value * 10 + schema[index] - 48
        index = index + 1
    }
    if (negative) -value else value
}

fun rawVulkanBuilderTypeLayout(
    typeName: string
): RawVulkanBuilderTypeLayout {
    val schema = rawVulkanBuilderTypeSchema()
    var cursor = 0
    var size = 0
    var alignment = 0
    var structureType = -1
    var extendsTypes = ""
    var found = false
    while (!found && cursor < schema.size) {
        val nameEnd = rawVulkanBuilderDelimiter(schema, cursor, 124)
        val sizeEnd = rawVulkanBuilderDelimiter(schema, nameEnd + 1, 124)
        val alignmentEnd = rawVulkanBuilderDelimiter(
            schema, sizeEnd + 1, 124
        )
        val structureTypeEnd = rawVulkanBuilderDelimiter(
            schema, alignmentEnd + 1, 59
        )
        val recordEnd = if (structureTypeEnd >= 0)
            rawVulkanBuilderDelimiter(schema, alignmentEnd + 1, 124) else -1
        if (nameEnd < 0 || sizeEnd < 0 || alignmentEnd < 0 ||
            structureTypeEnd < 0 || recordEnd < 0) {
            cursor = schema.size
        } else if (schema.slice(cursor, nameEnd) == typeName) {
            size = rawVulkanBuilderInteger(schema, nameEnd + 1, sizeEnd)
            alignment = rawVulkanBuilderInteger(
                schema, sizeEnd + 1, alignmentEnd
            )
            structureType = rawVulkanBuilderInteger(
                schema, alignmentEnd + 1, recordEnd
            )
            extendsTypes = schema.slice(recordEnd + 1, structureTypeEnd)
            found = true
        } else cursor = structureTypeEnd + 1
    }
    RawVulkanBuilderTypeLayout(
        size, alignment, structureType, extendsTypes, found
    )
}

fun rawVulkanBuilderMemberLayout(
    typeName: string,
    memberName: string
): RawVulkanBuilderMemberLayout {
    val schema = rawVulkanBuilderMemberSchema()
    var cursor = 0
    var kind = ""
    var offset = -1
    var elementSize = 0
    var elementCount = 0
    var found = false
    while (!found && cursor < schema.size) {
        val ownerEnd = rawVulkanBuilderDelimiter(schema, cursor, 124)
        val nameEnd = rawVulkanBuilderDelimiter(schema, ownerEnd + 1, 124)
        val kindEnd = rawVulkanBuilderDelimiter(schema, nameEnd + 1, 124)
        val offsetEnd = rawVulkanBuilderDelimiter(schema, kindEnd + 1, 124)
        val sizeEnd = rawVulkanBuilderDelimiter(schema, offsetEnd + 1, 124)
        val recordEnd = rawVulkanBuilderDelimiter(schema, sizeEnd + 1, 59)
        if (ownerEnd < 0 || nameEnd < 0 || kindEnd < 0 ||
            offsetEnd < 0 || sizeEnd < 0 || recordEnd < 0) {
            cursor = schema.size
        } else if (schema.slice(cursor, ownerEnd) == typeName &&
            schema.slice(ownerEnd + 1, nameEnd) == memberName) {
            kind = schema.slice(nameEnd + 1, kindEnd)
            offset = rawVulkanBuilderInteger(schema, kindEnd + 1, offsetEnd)
            elementSize = rawVulkanBuilderInteger(
                schema, offsetEnd + 1, sizeEnd
            )
            elementCount = rawVulkanBuilderInteger(
                schema, sizeEnd + 1, recordEnd
            )
            found = true
        } else cursor = recordEnd + 1
    }
    RawVulkanBuilderMemberLayout(
        kind, offset, elementSize, elementCount, found
    )
}

fun rawVulkanBuilderSize(typeName: string): int =
    rawVulkanBuilderTypeLayout(typeName).size

fun rawVulkanBuilderAlignment(typeName: string): int =
    rawVulkanBuilderTypeLayout(typeName).alignment

fun rawVulkanBuilderMemberOffset(
    typeName: string,
    memberName: string
): int = rawVulkanBuilderMemberLayout(typeName, memberName).offset

fun rawVulkanBuilderMemberKind(
    typeName: string,
    memberName: string
): string = rawVulkanBuilderMemberLayout(typeName, memberName).kind

trusted fun rawVulkanStoreU32(
    var bytes: NativeByteBuffer,
    offset: int,
    value: int
): bool = value >= 0 && value <= 4294967295 &&
    bytes.store(offset, value & 255) &&
    bytes.store(offset + 1, (value >>> 8) & 255) &&
    bytes.store(offset + 2, (value >>> 16) & 255) &&
    bytes.store(offset + 3, (value >>> 24) & 255)

trusted fun rawVulkanStoreI32(
    var bytes: NativeByteBuffer,
    offset: int,
    value: int
): bool = value >= -2147483648 && value <= 4294967295 &&
    bytes.store(offset, value & 255) &&
    bytes.store(offset + 1, (value >>> 8) & 255) &&
    bytes.store(offset + 2, (value >>> 16) & 255) &&
    bytes.store(offset + 3, (value >>> 24) & 255)

trusted fun rawVulkanZeroedBytes(size: int): NativeByteBuffer {
    val bytes = nativeByteBuffer(size)
    var index = 0
    while (index < bytes.capacity) {
        bytes.store(index, 0)
        index = index + 1
    }
    move(bytes)
}

trusted fun rawVulkanZeroedStructure(
    typeName: string
): NativeByteBuffer {
    val layout = rawVulkanBuilderTypeLayout(typeName)
    val bytes = rawVulkanZeroedBytes(layout.size)
    if (layout.valid && layout.structureType >= 0) {
        rawVulkanStoreI32(
            bytes,
            rawVulkanBuilderMemberOffset(typeName, "sType"),
            layout.structureType
        )
    }
    move(bytes)
}

trusted fun rawVulkanBuilderStoreI32(
    var bytes: NativeByteBuffer,
    typeName: string,
    memberName: string,
    value: int
): bool = rawVulkanBuilderStoreI32At(
    bytes, 0, typeName, memberName, 0, value
)

trusted fun rawVulkanBuilderStoreI32At(
    var bytes: NativeByteBuffer,
    baseOffset: int,
    typeName: string,
    memberName: string,
    elementIndex: int,
    value: int
): bool {
    val layout = rawVulkanBuilderMemberLayout(typeName, memberName)
    layout.valid && layout.kind == "i32" && elementIndex >= 0 &&
        elementIndex < layout.elementCount && rawVulkanStoreI32(
            bytes,
            baseOffset + layout.offset + elementIndex * layout.elementSize,
            value
        )
}

trusted fun rawVulkanBuilderStoreI64(
    var bytes: NativeByteBuffer,
    typeName: string,
    memberName: string,
    value: int
): bool = rawVulkanBuilderStoreI64At(
    bytes, 0, typeName, memberName, 0, value
)

trusted fun rawVulkanBuilderStoreI64At(
    var bytes: NativeByteBuffer,
    baseOffset: int,
    typeName: string,
    memberName: string,
    elementIndex: int,
    value: int
): bool {
    val layout = rawVulkanBuilderMemberLayout(typeName, memberName)
    layout.valid && layout.kind == "i64" && elementIndex >= 0 &&
        elementIndex < layout.elementCount && bytes.storeI64(
            baseOffset + layout.offset + elementIndex * layout.elementSize,
            value
        )
}

trusted fun rawVulkanBuilderStorePointer(
    var bytes: NativeByteBuffer,
    typeName: string,
    memberName: string,
    value: i64*
): bool = rawVulkanBuilderStorePointerAt(
    bytes, 0, typeName, memberName, 0, value
)

trusted fun rawVulkanBuilderStorePointerAt(
    var bytes: NativeByteBuffer,
    baseOffset: int,
    typeName: string,
    memberName: string,
    elementIndex: int,
    value: i64*
): bool {
    val layout = rawVulkanBuilderMemberLayout(typeName, memberName)
    layout.valid && layout.kind == "pointer" && elementIndex >= 0 &&
        elementIndex < layout.elementCount && bytes.storePointer(
            baseOffset + layout.offset + elementIndex * layout.elementSize,
            value
        )
}

trusted fun rawVulkanBuilderStoreBytesAt(
    var bytes: NativeByteBuffer,
    baseOffset: int,
    typeName: string,
    memberName: string,
    var source: NativeByteBuffer,
    sourceOffset: int = 0
): bool {
    val layout = rawVulkanBuilderMemberLayout(typeName, memberName)
    val byteCount = layout.elementSize * layout.elementCount
    val destinationOffset = baseOffset + layout.offset
    val accepted = layout.valid && byteCount > 0 && sourceOffset >= 0 &&
        sourceOffset <= source.capacity - byteCount &&
        destinationOffset >= 0 &&
        destinationOffset <= bytes.capacity - byteCount
    var index = 0
    while (accepted && index < byteCount) {
        bytes.store(destinationOffset + index, source.load(sourceOffset + index))
        index = index + 1
    }
    accepted
}

resource class RawVulkanStructureBuilder(
    val typeName: string,
    val expectedSize: int,
    val bytes: NativeByteBuffer
) {
    fun valid(): bool = !this.bytes.closed && this.expectedSize > 0 &&
        this.bytes.capacity == this.expectedSize
    fun pointer(): i64* = if (this.valid()) this.bytes.address
        else nativeNullPointer()
    trusted fun storeI32(memberName: string, value: int): bool =
        this.valid() && rawVulkanBuilderStoreI32(
            this.bytes, this.typeName, memberName, value
        )
    trusted fun storeI32Element(
        memberName: string,
        elementIndex: int,
        value: int
    ): bool = this.valid() && rawVulkanBuilderStoreI32At(
        this.bytes, 0, this.typeName, memberName, elementIndex, value
    )
    trusted fun storeI64(memberName: string, value: int): bool =
        this.valid() && rawVulkanBuilderStoreI64(
            this.bytes, this.typeName, memberName, value
        )
    trusted fun storePointer(memberName: string, value: i64*): bool =
        this.valid() && rawVulkanBuilderStorePointer(
            this.bytes, this.typeName, memberName, value
        )
    trusted fun storeBytes(
        memberName: string,
        var source: NativeByteBuffer,
        sourceOffset: int = 0
    ): bool = this.valid() && rawVulkanBuilderStoreBytesAt(
        this.bytes, 0, this.typeName, memberName, source, sourceOffset
    )
    fun drop(): void { this.bytes.close(); return }
}

trusted fun rawVulkanStructureBuilder(
    typeName: string
): RawVulkanStructureBuilder {
    val size = rawVulkanBuilderSize(typeName)
    val bytes = rawVulkanZeroedStructure(typeName)
    RawVulkanStructureBuilder(typeName, size, move(bytes))
}

fun rawVulkanBuilderTokenContains(tokens: string, wanted: string): bool {
    var found = false
    var begin = 0
    var index = 0
    while (!found && index <= tokens.size) {
        if (index == tokens.size || tokens[index] == 44) {
            found = tokens.slice(begin, index) == wanted
            begin = index + 1
        }
        index = index + 1
    }
    found
}

fun rawVulkanBuilderArrayContains(
    values: array<string>,
    wanted: string
): bool {
    var found = false
    var index = 0
    while (!found && index < values.size) {
        if (values[index] == wanted) found = true
        index = index + 1
    }
    found
}

fun rawVulkanBuilderAlignUp(value: int, alignment: int): int =
    if (alignment <= 1) value else
        ((value + alignment - 1) / alignment) * alignment

resource class RawVulkanStructureChain(
    val rootTypeName: string,
    val typeNames: array<string>,
    val offsets: array<int>,
    val expectedSize: int,
    val bytes: NativeByteBuffer
) {
    fun valid(): bool = !this.bytes.closed && this.expectedSize > 0 &&
        this.typeNames.size > 0 && this.offsets.size == this.typeNames.size &&
        this.bytes.capacity == this.expectedSize
    fun nodeCount(): int = if (this.valid()) this.typeNames.size else 0
    fun pointer(): i64* = if (this.valid())
        this.bytes.pointerAt(this.offsets[0]) else nativeNullPointer()
    fun nodePointer(index: int): i64* = if (this.valid() && index >= 0 &&
        index < this.offsets.size) this.bytes.pointerAt(this.offsets[index])
        else nativeNullPointer()
    trusted fun storeI32(
        nodeIndex: int,
        memberName: string,
        value: int
    ): bool = this.valid() && nodeIndex >= 0 &&
        nodeIndex < this.typeNames.size && rawVulkanBuilderStoreI32At(
            this.bytes, this.offsets[nodeIndex], this.typeNames[nodeIndex],
            memberName, 0, value
        )
    trusted fun storeI64(
        nodeIndex: int,
        memberName: string,
        value: int
    ): bool = this.valid() && nodeIndex >= 0 &&
        nodeIndex < this.typeNames.size && rawVulkanBuilderStoreI64At(
            this.bytes, this.offsets[nodeIndex], this.typeNames[nodeIndex],
            memberName, 0, value
        )
    fun drop(): void { this.bytes.close(); return }
}

trusted fun rawVulkanStructureChain(
    rootTypeName: string,
    requestedTypes: array<string>
): RawVulkanStructureChain {
    val typeNames: array<string> = []
    val offsets: array<int> = []
    var valid = requestedTypes.size > 0 &&
        rawVulkanBuilderTypeLayout(rootTypeName).valid
    var totalSize = 0
    var index = 0
    while (valid && index < requestedTypes.size) {
        val typeName = requestedTypes[index]
        val layout = rawVulkanBuilderTypeLayout(typeName)
        val next = rawVulkanBuilderMemberLayout(typeName, "pNext")
        val structureType = rawVulkanBuilderMemberLayout(typeName, "sType")
        valid = layout.valid && layout.structureType >= 0 &&
            rawVulkanBuilderTokenContains(layout.extendsTypes, rootTypeName) &&
            next.valid && next.kind == "pointer" && next.elementCount == 1 &&
            structureType.valid && structureType.kind == "i32" &&
            structureType.elementCount == 1 &&
            !rawVulkanBuilderArrayContains(typeNames, typeName)
        if (valid) {
            totalSize = rawVulkanBuilderAlignUp(totalSize, layout.alignment)
            typeNames.append(typeName)
            offsets.append(totalSize)
            totalSize = totalSize + layout.size
        }
        index = index + 1
    }
    val bytes = rawVulkanZeroedBytes(if (valid) totalSize else 0)
    index = 0
    while (valid && index < typeNames.size) {
        val layout = rawVulkanBuilderTypeLayout(typeNames[index])
        valid = rawVulkanBuilderStoreI32At(
            bytes, offsets[index], typeNames[index], "sType", 0,
            layout.structureType
        ) && rawVulkanBuilderStorePointerAt(
            bytes, offsets[index], typeNames[index], "pNext", 0,
            if (index + 1 < offsets.size) bytes.pointerAt(offsets[index + 1])
            else nativeNullPointer()
        )
        index = index + 1
    }
    RawVulkanStructureChain(
        rootTypeName, typeNames, offsets,
        if (valid) totalSize else 0, move(bytes)
    )
}

resource class RawVkEventCreateInfo(val bytes: NativeByteBuffer) {
    fun valid(): bool = !this.bytes.closed &&
        this.bytes.capacity == rawVulkanBuilderSize("VkEventCreateInfo")
    fun pointer(): i64* = if (this.valid()) this.bytes.address
        else nativeNullPointer()
    fun drop(): void { this.bytes.close(); return }
}

trusted fun rawVkEventCreateInfo(
    flags: int = 0,
    next: i64* = nativeNullPointer()
): RawVkEventCreateInfo {
    val bytes = rawVulkanZeroedStructure("VkEventCreateInfo")
    rawVulkanBuilderStorePointer(bytes, "VkEventCreateInfo", "pNext", next)
    rawVulkanBuilderStoreI32(bytes, "VkEventCreateInfo", "flags", flags)
    RawVkEventCreateInfo(move(bytes))
}

resource class RawVkFenceCreateInfo(val bytes: NativeByteBuffer) {
    fun valid(): bool = !this.bytes.closed &&
        this.bytes.capacity == rawVulkanBuilderSize("VkFenceCreateInfo")
    fun pointer(): i64* = if (this.valid()) this.bytes.address
        else nativeNullPointer()
    fun drop(): void { this.bytes.close(); return }
}

trusted fun rawVkFenceCreateInfo(
    flags: int = 0,
    next: i64* = nativeNullPointer()
): RawVkFenceCreateInfo {
    val bytes = rawVulkanZeroedStructure("VkFenceCreateInfo")
    rawVulkanBuilderStorePointer(bytes, "VkFenceCreateInfo", "pNext", next)
    rawVulkanBuilderStoreI32(bytes, "VkFenceCreateInfo", "flags", flags)
    RawVkFenceCreateInfo(move(bytes))
