resource class RawVkDeviceQueueInfo2(val bytes: NativeByteBuffer) {
    fun valid(): bool = !this.bytes.closed &&
        this.bytes.capacity == rawVulkanBuilderSize("VkDeviceQueueInfo2")
    fun pointer(): i64* = if (this.valid()) this.bytes.address
        else nativeNullPointer()
    fun drop(): void { this.bytes.close(); return }
}

trusted fun rawVkDeviceQueueInfo2(
    queueFamilyIndex: int,
    queueIndex: int = 0,
    flags: int = 0,
    next: i64* = nativeNullPointer()
): RawVkDeviceQueueInfo2 {
    val bytes = rawVulkanZeroedStructure("VkDeviceQueueInfo2")
    rawVulkanBuilderStorePointer(bytes, "VkDeviceQueueInfo2", "pNext", next)
    rawVulkanBuilderStoreI32(bytes, "VkDeviceQueueInfo2", "flags", flags)
    rawVulkanBuilderStoreI32(
        bytes, "VkDeviceQueueInfo2", "queueFamilyIndex", queueFamilyIndex
    )
    rawVulkanBuilderStoreI32(
        bytes, "VkDeviceQueueInfo2", "queueIndex", queueIndex
    )
    RawVkDeviceQueueInfo2(move(bytes))
}

resource class RawVkCommandBufferBeginInfo(val bytes: NativeByteBuffer) {
    fun valid(): bool = !this.bytes.closed &&
        this.bytes.capacity == rawVulkanBuilderSize(
            "VkCommandBufferBeginInfo"
        )
    fun pointer(): i64* = if (this.valid()) this.bytes.address
        else nativeNullPointer()
    fun drop(): void { this.bytes.close(); return }
}

trusted fun rawVkCommandBufferBeginInfo(
    flags: int = 0,
    inheritanceInfo: i64* = nativeNullPointer(),
    next: i64* = nativeNullPointer()
): RawVkCommandBufferBeginInfo {
    val bytes = rawVulkanZeroedStructure("VkCommandBufferBeginInfo")
    rawVulkanBuilderStorePointer(
        bytes, "VkCommandBufferBeginInfo", "pNext", next
    )
    rawVulkanBuilderStoreI32(
        bytes, "VkCommandBufferBeginInfo", "flags", flags
    )
    rawVulkanBuilderStorePointer(
        bytes, "VkCommandBufferBeginInfo", "pInheritanceInfo",
        inheritanceInfo
    )
    RawVkCommandBufferBeginInfo(move(bytes))
}
