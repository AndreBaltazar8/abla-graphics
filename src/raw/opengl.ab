// Explicit OpenGL raw surface. Registry metadata is generated from gl.xml;
// command resolution and indirect calls remain explicit and backend-specific.

import "opengl_calls.ab"
import "native.ab"
import "../application.ab"
import "../driver/native_symbols.ab"
import "abla/unsafe/native"
import "abla/text"

fun rawOpenGlDecimal(text: string, begin: int, end: int): int {
    var value = 0
    var valid = begin < end
    var index = begin
    while (valid && index < end) {
        val byte = text[index]
        valid = byte >= 48 && byte <= 57
        if (valid) value = value * 10 + byte - 48
        index = index + 1
    }
    if (valid) value else -1
}

fun rawOpenGlCoreTransitionVersion(transition: string): int {
    val prefix = "GL_VERSION_"
    val featureEnd = textFindByte(transition, 58)
    var version = -1
    if (featureEnd > prefix.size && transition.size >= prefix.size &&
        transition.slice(0, prefix.size) == prefix) {
        val separator = textFindByte(
            transition, 95, prefix.size, featureEnd
        )
        if (separator > prefix.size && separator + 1 < featureEnd) {
            val major = rawOpenGlDecimal(
                transition, prefix.size, separator
            )
            val minor = rawOpenGlDecimal(
                transition, separator + 1, featureEnd
            )
            if (major >= 0 && minor >= 0) version = major * 100 + minor
        }
    }
    version
}

fun rawOpenGlProfileMatches(profile: string, coreProfile: bool): bool =
    profile == "all" || (profile == "core" && coreProfile) ||
    (profile == "compatibility" && !coreProfile)

fun rawOpenGlCoreTransitionsAdvertised(
    transitions: string,
    version: int,
    coreProfile: bool
): bool {
    var advertised = false
    var begin = 0
    var cursor = 0
    while (cursor <= transitions.size) {
        if (cursor == transitions.size || transitions[cursor] == 124) {
            val transition = transitions.slice(begin, cursor)
            val first = textFindByte(transition, 58)
            val second = if (first >= 0)
                textFindByte(transition, 58, first + 1, transition.size)
                else -1
            val transitionVersion = rawOpenGlCoreTransitionVersion(
                transition
            )
            if (first >= 0 && second > first &&
                transitionVersion >= 0 && transitionVersion <= version &&
                rawOpenGlProfileMatches(
                    transition.slice(second + 1, transition.size),
                    coreProfile
                )) advertised = transition.slice(first + 1, second) == "+"
            begin = cursor + 1
        }
        cursor = cursor + 1
    }
    advertised
}

trusted fun rawOpenGlExtensionProvidersAdvertised(
    providers: string,
    coreProfile: bool,
    platform: string
): bool {
    var advertised = false
    var begin = 0
    var cursor = 0
    while (!advertised && cursor <= providers.size) {
        if (cursor == providers.size || providers[cursor] == 124) {
            val provider = providers.slice(begin, cursor)
            val first = textFindByte(provider, 58)
            val second = if (first >= 0)
                textFindByte(provider, 58, first + 1, provider.size)
                else -1
            val providerPlatform = if (first >= 0 && second > first)
                provider.slice(first + 1, second) else ""
            if (first > 0 && second > first &&
                (providerPlatform == "all" ||
                    providerPlatform == platform) &&
                rawOpenGlProfileMatches(
                    provider.slice(second + 1, provider.size), coreProfile
                )) advertised = openGlExtensionAvailable(
                    provider.slice(0, first)
                )
            begin = cursor + 1
        }
        cursor = cursor + 1
    }
    advertised
}

fun rawOpenGlExtensionNameAvailable(
    extensions: array<string>,
    wanted: string
): bool {
    var found = false
    var index = 0
    while (!found && index < extensions.size) {
        found = extensions[index] == wanted
        index = index + 1
    }
    found
}

fun rawOpenGlSnapshotExtensionProvidersAdvertised(
    providers: string,
    coreProfile: bool,
    platform: string,
    extensions: array<string>
): bool {
    var advertised = false
    var begin = 0
    var cursor = 0
    while (!advertised && cursor <= providers.size) {
        if (cursor == providers.size || providers[cursor] == 124) {
            val provider = providers.slice(begin, cursor)
            val first = textFindByte(provider, 58)
            val second = if (first >= 0)
                textFindByte(provider, 58, first + 1, provider.size)
                else -1
            val providerPlatform = if (first >= 0 && second > first)
                provider.slice(first + 1, second) else ""
            if (first > 0 && second > first &&
                (providerPlatform == "all" ||
                    providerPlatform == platform) &&
                rawOpenGlProfileMatches(
                    provider.slice(second + 1, provider.size), coreProfile
                )) {
                advertised = rawOpenGlExtensionNameAvailable(
                    extensions, provider.slice(0, first)
                )
            }
            begin = cursor + 1
        }
        cursor = cursor + 1
    }
    advertised
}

class RawOpenGlCapabilitySnapshot(
    val version: int,
    val coreProfile: bool,
    val platform: string,
    val extensions: array<string>,
    val valid: bool
) {
    fun commandAdvertised(capability: RawCommandCapability): bool =
        this.valid && capability.valid() &&
        capability.dispatchScope == "context" && (
            rawOpenGlCoreTransitionsAdvertised(
                capability.coreTransitions,
                this.version,
                this.coreProfile
            ) || rawOpenGlSnapshotExtensionProvidersAdvertised(
                capability.extensionProviders,
                this.coreProfile,
                this.platform,
                this.extensions
            )
        )
}

trusted fun rawOpenGlResolveCommandAddress(name: string): int {
    var address = nativePointerAddress(eglGetProcAddress(name))
    if (address == 0) address = nativePointerAddress(dlsym(
        nativeNullPointer(),
        name
    ))
    address
}

// This non-owning view must not outlive the GraphicsApplication it came from.
class RawOpenGlApi(
    val display: i64*,
    val surface: i64*,
    val context: i64*,
    val commands: array<string>,
    val callShapes: array<string>,
    val callAbis: array<string>,
    val coreTransitionSchema: string,
    val extensionProviderSchema: string,
    val dispatchScopeSchema: string,
    val platform: string,
    val available: bool
) {
    fun capability(name: string): RawCommandCapability =
        rawRegistryCommandCapability(
            this.commands,
            this.coreTransitionSchema,
            this.extensionProviderSchema,
            this.dispatchScopeSchema,
            name
        )

    trusted fun commandAdvertised(name: string): bool {
        val capability = this.capability(name)
        var advertised = false
        if (capability.valid() && this.makeCurrent()) {
            val major = nativeI64Cell(0)
            val minor = nativeI64Cell(0)
            val profile = nativeI64Cell(0)
            glGetIntegerv(33307, major.address)
            glGetIntegerv(33308, minor.address)
            val version = (major.load() & 4294967295) * 100 +
                (minor.load() & 4294967295)
            var coreProfile = false
            if (version >= 302) {
                glGetIntegerv(37158, profile.address)
                coreProfile = (profile.load() & 1) != 0
            }
            advertised = rawOpenGlCoreTransitionsAdvertised(
                capability.coreTransitions, version, coreProfile
            ) || rawOpenGlExtensionProvidersAdvertised(
                capability.extensionProviders, coreProfile, this.platform
            )
        }
        advertised
    }

    trusted fun commandSupported(name: string): bool =
        this.commandAdvertised(name) && this.command(name).valid()

    trusted fun capabilitySnapshot(): RawOpenGlCapabilitySnapshot {
        var version = -1
        var coreProfile = false
        val extensions: array<string> = []
        var valid = this.makeCurrent()
        if (valid) {
            val major = nativeI64Cell(0)
            val minor = nativeI64Cell(0)
            val profile = nativeI64Cell(0)
            val count = nativeI64Cell(0)
            glGetIntegerv(33307, major.address)
            glGetIntegerv(33308, minor.address)
            version = (major.load() & 4294967295) * 100 +
                (minor.load() & 4294967295)
            if (version >= 302) {
                glGetIntegerv(37158, profile.address)
                coreProfile = (profile.load() & 1) != 0
            }
            glGetIntegerv(33309, count.address)
            val extensionCount = count.load() & 4294967295
            valid = extensionCount >= 0 && extensionCount <= 65536
            var index = 0
            while (valid && index < extensionCount) {
                val address = glGetStringi(7939, index)
                valid = !pointerIsNull(address)
                if (valid) extensions.append(borrowNativeCString(address))
                index = index + 1
            }
        }
        RawOpenGlCapabilitySnapshot(
            version, coreProfile, this.platform, extensions, valid
        )
    }

    trusted fun featureMatrix(): RawFeatureMatrix {
        val snapshot = this.capabilitySnapshot()
        val cursor = RawCommandCapabilityCursor(
            this.coreTransitionSchema,
            this.extensionProviderSchema,
            this.dispatchScopeSchema
        )
        var metadata = 0
        var core = 0
        var extension = 0
        var advertised = 0
        var supported = 0
        var context = 0
        var firstInvalid = ""
        var firstUnresolved = ""
        var index = 0
        while (index < this.commands.size) {
            val capability = cursor.next(this.commands[index])
            if (capability.valid()) metadata = metadata + 1
            else if (firstInvalid == "") firstInvalid = capability.name
            if (capability.hasCorePath()) core = core + 1
            if (capability.hasExtensionPath()) extension = extension + 1
            if (capability.dispatchScope == "context") context = context + 1
            val isAdvertised = snapshot.commandAdvertised(capability)
            if (isAdvertised) {
                advertised = advertised + 1
                if (rawOpenGlResolveCommandAddress(capability.name) != 0) {
                    supported = supported + 1
                } else if (firstUnresolved == "") {
                    firstUnresolved = capability.name
                }
            }
            index = index + 1
        }
        if (!cursor.exhausted() && firstInvalid == "") {
            firstInvalid = "#capability-schema"
        }
        RawFeatureMatrix(
            this.commands.size,
            metadata,
            core,
            extension,
            advertised,
            supported,
            context,
            0,
            0,
            0,
            firstInvalid,
            firstUnresolved
        )
    }

    trusted fun makeCurrent(): bool = this.available &&
        eglMakeCurrent(
            this.display,
            this.surface,
            this.surface,
            this.context
        ) == eglTrue

    trusted fun command(name: string): RawNativeCommand {
        var address = 0
        val index = rawRegistryCommandIndex(this.commands, name)
        if (index >= 0 && this.makeCurrent()) {
            address = rawOpenGlResolveCommandAddress(name)
        }
        rawRegistryCommand(
            this.commands,
            this.callShapes,
            this.callAbis,
            name,
            address,
            nativePointerAddress(this.context)
        )
    }

    trusted fun callVoid0(command: RawNativeCommand): bool {
        val callable = command.callableAsVoid0() &&
            command.owner == nativePointerAddress(this.context) &&
            this.makeCurrent()
        if (callable) callNativeVoid0(command.address)
        callable
    }

    trusted fun callVoidI32(
        command: RawNativeCommand,
        first: int
    ): bool {
        val callable = command.callableAsVoidI32() &&
            command.owner == nativePointerAddress(this.context) &&
            this.makeCurrent()
        if (callable) callNativeVoidI32(command.address, first)
        callable
    }

    trusted fun callVoidI32I32(
        command: RawNativeCommand,
        first: int,
        second: int
    ): bool {
        val callable = command.callableAsVoidI32I32() &&
            command.owner == nativePointerAddress(this.context) &&
