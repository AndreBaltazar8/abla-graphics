}

trusted fun GraphicsApplication.rawOpenGlApi(): RawOpenGlApi {
    val available = this.valid() && this.backend == graphicsBackendOpenGl &&
        this.openGl.valid()
    RawOpenGlApi(
        this.openGl.display,
        this.openGl.surface,
        this.openGl.context,
        rawOpenGlCallNames(),
        rawOpenGlCallShapes(),
        rawOpenGlCallAbis(),
        rawOpenGlCallCoreTransitionSchema(),
        rawOpenGlCallExtensionProviderSchema(),
        rawOpenGlCallDispatchScopeSchema(),
        "x11",
        available
    )
}
