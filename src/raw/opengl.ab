        callable
    }

    trusted fun callVoidI32I32I32I32I32I32I32I32I8(
        command: RawNativeCommand,
        first: int,
        second: int,
        third: int,
        fourth: int,
        fifth: int,
        sixth: int,
        seventh: int,
        eighth: int,
        ninth: int
    ): bool {
        val callable = command.callableAsVoidI32I32I32I32I32I32I32I32I8() &&
            command.owner == nativePointerAddress(this.context) &&
            this.makeCurrent()
        if (callable) callNativeVoidI32I32I32I32I32I32I32I32I8(command.address, first, second, third, fourth, fifth, sixth, seventh, eighth, ninth)
        callable
    }

    trusted fun callVoidI32I32I32I32I32I8I32I64(
