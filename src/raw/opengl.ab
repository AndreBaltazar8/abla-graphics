// Explicit OpenGL raw surface. Registry metadata is generated from gl.xml;
// command resolution and indirect calls remain explicit and backend-specific.

import "opengl_calls.ab"
import "native.ab"
import "../application.ab"
import "../driver/native_symbols.ab"
import "abla/unsafe/native"

// This non-owning view must not outlive the GraphicsApplication it came from.
class RawOpenGlApi(
    val display: i64*,
    val surface: i64*,
    val context: i64*,
    val commands: array<string>,
    val callShapes: array<string>,
    val callAbis: array<string>,
    val available: bool
) {
    trusted fun makeCurrent(): bool = this.available &&
        eglMakeCurrent(
            this.display,
            this.surface,
            this.surface,
            this.context
        ) == eglTrue

    trusted fun command(name: string): RawNativeCommand {
        var address = 0
        val index = rawRegistryCommandIndex(this.commands, name)
        if (index >= 0 && this.makeCurrent()) {
            address = nativePointerAddress(eglGetProcAddress(name))
            if (address == 0) address = nativePointerAddress(dlsym(
                nativeNullPointer(),
                name
            ))
        }
        rawRegistryCommand(
            this.commands,
            this.callShapes,
            this.callAbis,
            name,
            address,
            nativePointerAddress(this.context)
        )
    }

    trusted fun callVoid0(command: RawNativeCommand): bool {
        val callable = command.callableAsVoid0() &&
            command.owner == nativePointerAddress(this.context) &&
            this.makeCurrent()
        if (callable) callNativeVoid0(command.address)
        callable
    }

    trusted fun callVoidI32(
        command: RawNativeCommand,
        first: int
    ): bool {
        val callable = command.callableAsVoidI32() &&
            command.owner == nativePointerAddress(this.context) &&
            this.makeCurrent()
        if (callable) callNativeVoidI32(command.address, first)
        callable
    }

    trusted fun callVoidI32I32(
        command: RawNativeCommand,
        first: int,
        second: int
    ): bool {
        val callable = command.callableAsVoidI32I32() &&
            command.owner == nativePointerAddress(this.context) &&
            this.makeCurrent()
        if (callable) callNativeVoidI32I32(command.address, first, second)
        callable
    }

    trusted fun callVoidI32I32I32(
        command: RawNativeCommand,
        first: int,
        second: int,
        third: int
    ): bool {
        val callable = command.callableAsVoidI32I32I32() &&
            command.owner == nativePointerAddress(this.context) &&
            this.makeCurrent()
        if (callable)
            callNativeVoidI32I32I32(command.address, first, second, third)
        callable
    }

    trusted fun callVoidI32I32I32I32(
        command: RawNativeCommand,
        first: int,
        second: int,
        third: int,
        fourth: int
    ): bool {
        val callable = command.callableAsVoidI32I32I32I32() &&
            command.owner == nativePointerAddress(this.context) &&
            this.makeCurrent()
        if (callable) callNativeVoidI32I32I32I32(
            command.address, first, second, third, fourth
        )
        callable
    }

    trusted fun callVoidI32I32I32I32I32(
        command: RawNativeCommand,
        first: int,
        second: int,
        third: int,
        fourth: int,
        fifth: int
    ): bool {
        val callable = command.callableAsVoidI32I32I32I32I32() &&
            command.owner == nativePointerAddress(this.context) &&
            this.makeCurrent()
        if (callable) callNativeVoidI32I32I32I32I32(
            command.address, first, second, third, fourth, fifth
        )
        callable
    }

    trusted fun callVoidI32I32I32I32I32I32(
        command: RawNativeCommand,
        first: int,
        second: int,
        third: int,
        fourth: int,
        fifth: int,
        sixth: int
    ): bool {
        val callable = command.callableAsVoidI32I32I32I32I32I32() &&
            command.owner == nativePointerAddress(this.context) &&
            this.makeCurrent()
        if (callable) callNativeVoidI32I32I32I32I32I32(
            command.address, first, second, third, fourth, fifth, sixth
        )
        callable
    }

    trusted fun callVoidPointer(
        command: RawNativeCommand,
        first: i64*
    ): bool {
        val callable = command.callableAsVoidPointer() &&
            command.owner == nativePointerAddress(this.context) &&
            this.makeCurrent()
        if (callable) callNativeVoidPointer(command.address, first)
        callable
    }

    trusted fun callVoidI32Pointer(
        command: RawNativeCommand,
        first: int,
        second: i64*
    ): bool {
        val callable = command.callableAsVoidI32Pointer() &&
            command.owner == nativePointerAddress(this.context) &&
            this.makeCurrent()
        if (callable) callNativeVoidI32Pointer(command.address, first, second)
        callable
    }

    trusted fun callVoidI32I32Pointer(
        command: RawNativeCommand,
        first: int,
        second: int,
        third: i64*
    ): bool {
        val callable = command.callableAsVoidI32I32Pointer() &&
            command.owner == nativePointerAddress(this.context) &&
            this.makeCurrent()
        if (callable) callNativeVoidI32I32Pointer(
            command.address, first, second, third
        )
        callable
    }

    trusted fun callVoidI32I32I32Pointer(
        command: RawNativeCommand,
        first: int,
        second: int,
        third: int,
        fourth: i64*
    ): bool {
        val callable = command.callableAsVoidI32I32I32Pointer() &&
            command.owner == nativePointerAddress(this.context) &&
            this.makeCurrent()
        if (callable) callNativeVoidI32I32I32Pointer(
            command.address, first, second, third, fourth
        )
        callable
    }

    trusted fun callVoidI32I32I32I32Pointer(
        command: RawNativeCommand,
        first: int,
        second: int,
        third: int,
        fourth: int,
        fifth: i64*
    ): bool {
        val callable = command.callableAsVoidI32I32I32I32Pointer() &&
            command.owner == nativePointerAddress(this.context) &&
            this.makeCurrent()
        if (callable) callNativeVoidI32I32I32I32Pointer(
            command.address, first, second, third, fourth, fifth
        )
        callable
    }
}

trusted fun GraphicsApplication.rawOpenGlApi(): RawOpenGlApi {
    val available = this.valid() && this.backend == graphicsBackendOpenGl &&
        this.openGl.valid()
    RawOpenGlApi(
        this.openGl.display,
        this.openGl.surface,
        this.openGl.context,
        rawOpenGlCallNames(),
        rawOpenGlCallShapes(),
        rawOpenGlCallAbis(),
        available
    )
}
