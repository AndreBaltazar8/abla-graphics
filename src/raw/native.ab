// Shared explicit raw-command value. Resolving a command is separate from
// calling it so steady-state indirect calls do not scan or allocate registry
// metadata.

import "abla/platform/host"
import "abla/text"

fun rawResolvePlatformCallAbiFor(
    callAbi: string,
    macOS: bool
): string {
    if (textFindSequence(callAbi, "handle") < 0) return callAbi
    val resultWanted = "handleResult"
    val resultReplacement = if (macOS) "pointer" else "u32"
    var result = ""
    var cursor = 0
    var found = textFindSequence(
        callAbi, resultWanted, cursor, callAbi.size
    )
    while (found >= 0) {
        result = "$result${callAbi.slice(cursor, found)}$resultReplacement"
        cursor = found + resultWanted.size
        found = textFindSequence(
            callAbi, resultWanted, cursor, callAbi.size
        )
    }
    val resolvedResult = "$result${callAbi.slice(cursor, callAbi.size)}"
    val wanted = "handle"
    val replacement = if (macOS) "pointer" else "i32"
    result = ""
    cursor = 0
    found = textFindSequence(
        resolvedResult, wanted, cursor, resolvedResult.size
    )
    while (found >= 0) {
        result = "$result${resolvedResult.slice(cursor, found)}$replacement"
        cursor = found + wanted.size
        found = textFindSequence(
            resolvedResult, wanted, cursor, resolvedResult.size
        )
    }
    "$result${resolvedResult.slice(cursor, resolvedResult.size)}"
}

fun rawResolvePlatformCallAbi(callAbi: string): string =
    rawResolvePlatformCallAbiFor(callAbi, ablaHostIsMacOS())

class RawCommandCapability(
    val name: string,
    val coreTransitions: string,
    val extensionProviders: string,
    val dispatchScope: string
) {
    fun valid(): bool = this.name != "" &&
        (this.coreTransitions != "" || this.extensionProviders != "")
    fun hasCorePath(): bool = this.coreTransitions != ""
    fun hasExtensionPath(): bool = this.extensionProviders != ""
    fun hasCoreFeature(feature: string): bool =
        rawCapabilityRecordContains(this.coreTransitions, feature)
    fun hasExtension(extension: string): bool =
        rawCapabilityRecordContains(this.extensionProviders, extension)
    fun extensionPlatform(extension: string): string =
        rawCapabilityExtensionPlatform(this.extensionProviders, extension)
}

class RawCommandCapabilityCursor(
    val coreTransitionSchema: string,
    val extensionProviderSchema: string,
    val dispatchScopeSchema: string,
    var coreOffset: int = 0,
    var extensionOffset: int = 0,
    var scopeOffset: int = 0
) {
    fun next(name: string): RawCommandCapability {
        var coreEnd = this.coreOffset
        while (coreEnd < this.coreTransitionSchema.size &&
            this.coreTransitionSchema[coreEnd] != 59) {
            coreEnd = coreEnd + 1
        }
        var extensionEnd = this.extensionOffset
        while (extensionEnd < this.extensionProviderSchema.size &&
            this.extensionProviderSchema[extensionEnd] != 59) {
            extensionEnd = extensionEnd + 1
        }
        var scopeEnd = this.scopeOffset
        while (scopeEnd < this.dispatchScopeSchema.size &&
            this.dispatchScopeSchema[scopeEnd] != 59) {
            scopeEnd = scopeEnd + 1
        }
        val capability = RawCommandCapability(
            name,
            this.coreTransitionSchema.slice(this.coreOffset, coreEnd),
            this.extensionProviderSchema.slice(
                this.extensionOffset, extensionEnd
            ),
            this.dispatchScopeSchema.slice(this.scopeOffset, scopeEnd)
        )
        this.coreOffset = coreEnd + 1
        this.extensionOffset = extensionEnd + 1
        this.scopeOffset = scopeEnd + 1
        capability
    }

    fun exhausted(): bool =
        this.coreOffset >= this.coreTransitionSchema.size &&
        this.extensionOffset >= this.extensionProviderSchema.size &&
        this.scopeOffset >= this.dispatchScopeSchema.size
}

class RawFeatureMatrix(
    val totalCommands: int,
    val metadataCommands: int,
    val corePathCommands: int,
    val extensionPathCommands: int,
    val advertisedCommands: int,
    val supportedCommands: int,
    val contextCommands: int,
    val globalCommands: int,
    val instanceCommands: int,
    val deviceCommands: int,
    val firstInvalidMetadata: string,
    val firstAdvertisedUnresolved: string
) {
    fun complete(): bool =
        this.totalCommands > 0 &&
        this.metadataCommands == this.totalCommands &&
        this.advertisedCommands > 0 &&
        this.supportedCommands == this.advertisedCommands &&
        this.firstInvalidMetadata == "" &&
        this.firstAdvertisedUnresolved == ""
}

fun rawCapabilityRecordContains(records: string, wanted: string): bool {
    var found = false
    var begin = 0
    var cursor = 0
    while (!found && cursor <= records.size) {
        if (cursor == records.size || records[cursor] == 124) {
            val record = records.slice(begin, cursor)
            val end = textFindByte(record, 58)
            found = end > 0 && record.slice(0, end) == wanted
            begin = cursor + 1
        }
        cursor = cursor + 1
    }
    found
}

fun rawCapabilityExtensionPlatform(
    records: string,
    wanted: string
): string {
    var platform = ""
    var begin = 0
    var cursor = 0
    while (platform == "" && cursor <= records.size) {
        if (cursor == records.size || records[cursor] == 124) {
            val record = records.slice(begin, cursor)
            val first = textFindByte(record, 58)
            val second = if (first >= 0)
                textFindByte(record, 58, first + 1, record.size)
                else -1
            if (first > 0 && second > first &&
                record.slice(0, first) == wanted) {
                platform = record.slice(first + 1, second)
            }
            begin = cursor + 1
        }
        cursor = cursor + 1
    }
    platform
}

fun rawRegistryCommandCapability(
    commands: array<string>,
    coreTransitionSchema: string,
    extensionProviderSchema: string,
    dispatchScopeSchema: string,
    name: string
): RawCommandCapability {
    val index = rawRegistryCommandIndex(commands, name)
    RawCommandCapability(
        if (index >= 0) name else "",
        if (index >= 0) rawCapabilitySchemaRecord(
            coreTransitionSchema, index
        ) else "",
        if (index >= 0) rawCapabilitySchemaRecord(
            extensionProviderSchema, index
        ) else "",
        if (index >= 0) rawCapabilitySchemaRecord(
            dispatchScopeSchema, index
        ) else ""
    )
}

fun rawCapabilitySchemaRecord(schema: string, wanted: int): string {
    var record = ""
    var found = false
    var index = 0
    var begin = 0
    var cursor = 0
    while (!found && index <= wanted && cursor <= schema.size) {
        if (cursor == schema.size || schema[cursor] == 59) {
            if (index == wanted) {
                record = schema.slice(begin, cursor)
                found = true
            }
            index = index + 1
            begin = cursor + 1
        }
        cursor = cursor + 1
    }
    record
}

