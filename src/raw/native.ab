// Shared explicit raw-command value. Resolving a command is separate from
// calling it so steady-state indirect calls do not scan or allocate registry
// metadata.

class RawNativeCommand(
    val name: string,
    val callShape: string,
    val callAbi: string,
    val address: int,
    val owner: int
) {
    fun valid(): bool = this.address != 0
    fun callableAsVoid0(): bool =
        this.valid() && this.callAbi == "void()"
    fun callableAsVoidI32(): bool =
        this.valid() && this.callAbi == "void(i32)"
    fun callableAsVoidI32I32(): bool =
        this.valid() && this.callAbi == "void(i32,i32)"
    fun callableAsVoidPointerI32(): bool =
        this.valid() && this.callAbi == "void(pointer,i32)"
    fun callableAsVoidPointer(): bool =
        this.valid() && this.callAbi == "void(pointer)"
    fun callableAsVoidPointerI32I32(): bool =
        this.valid() && this.callAbi == "void(pointer,i32,i32)"
    fun callableAsI32Pointer(): bool =
        this.valid() && this.callAbi == "i32(pointer)"
    fun callableAsI32Pointer4(): bool =
        this.valid() &&
        this.callAbi == "i32(pointer,pointer,pointer,pointer)"
    fun callableAsVoidPointerI64Pointer(): bool =
        this.valid() && this.callAbi == "void(pointer,i64,pointer)"
    fun callableAsI32PointerI64(): bool =
        this.valid() && this.callAbi == "i32(pointer,i64)"
    fun callableAsVoidPointerPointer(): bool =
        this.valid() && this.callAbi == "void(pointer,pointer)"
    fun callableAsI32Pointer3(): bool =
        this.valid() && this.callAbi == "i32(pointer,pointer,pointer)"
    fun callableAsVoidPointer3(): bool =
        this.valid() && this.callAbi == "void(pointer,pointer,pointer)"
    fun callableAsI32PointerI32Pointer(): bool =
        this.valid() && this.callAbi == "i32(pointer,i32,pointer)"
    fun callableAsVoidPointerI32I32Pointer(): bool =
        this.valid() && this.callAbi == "void(pointer,i32,i32,pointer)"
    fun callableAsI32PointerPointer(): bool =
        this.valid() && this.callAbi == "i32(pointer,pointer)"
    fun callableAsVoidPointerI32Pointer(): bool =
        this.valid() && this.callAbi == "void(pointer,i32,pointer)"
    fun callableAsI32PointerI64Pointer(): bool =
        this.valid() && this.callAbi == "i32(pointer,i64,pointer)"
    fun callableAsI32PointerI64PointerPointer(): bool =
        this.valid() &&
        this.callAbi == "i32(pointer,i64,pointer,pointer)"
    fun callableAsVoidPointerI64I32(): bool =
        this.valid() && this.callAbi == "void(pointer,i64,i32)"
    fun callableAsVoidPointerI64I32I32(): bool =
        this.valid() && this.callAbi == "void(pointer,i64,i32,i32)"
    fun callableAsVoidPointerI64I64(): bool =
        this.valid() && this.callAbi == "void(pointer,i64,i64)"
    fun callableAsVoidPointerI64I64I32(): bool =
        this.valid() && this.callAbi == "void(pointer,i64,i64,i32)"
    fun callableAsI32PointerPointerI64(): bool =
        this.valid() && this.callAbi == "i32(pointer,pointer,i64)"
    fun callableAsI32PointerI32PointerI64(): bool =
        this.valid() && this.callAbi == "i32(pointer,i32,pointer,i64)"
    fun callableAsI64PointerPointer(): bool =
        this.valid() && this.callAbi == "i64(pointer,pointer)"
    fun callableAsI32PointerI64I64I64(): bool =
        this.valid() && this.callAbi == "i32(pointer,i64,i64,i64)"
    fun callableAsVoidPointerI64I64I32Pointer(): bool =
        this.valid() &&
        this.callAbi == "void(pointer,i64,i64,i32,pointer)"
    fun callableAsVoidPointerI64I64I64I32(): bool =
        this.valid() && this.callAbi == "void(pointer,i64,i64,i64,i32)"
    fun callableAsVoidPointerI64I64I64Pointer(): bool =
        this.valid() &&
        this.callAbi == "void(pointer,i64,i64,i64,pointer)"
    fun callableAsVoidPointerI64I64I32I32(): bool =
        this.valid() && this.callAbi == "void(pointer,i64,i64,i32,i32)"
    fun callableAsVoidPointerI64I64I64I64I32I32(): bool =
        this.valid() &&
        this.callAbi == "void(pointer,i64,i64,i64,i64,i32,i32)"
    fun callableAsVoidPointerI64(): bool =
        this.valid() && this.callAbi == "void(pointer,i64)"
    fun callableAsVoidPointerI32I64(): bool =
        this.valid() && this.callAbi == "void(pointer,i32,i64)"
    fun callableAsVoidPointerI32I64I32(): bool =
        this.valid() && this.callAbi == "void(pointer,i32,i64,i32)"
    fun callableAsVoidPointerI32I32I32(): bool =
        this.valid() && this.callAbi == "void(pointer,i32,i32,i32)"
    fun callableAsVoidPointerI32I32I32I32(): bool =
        this.valid() && this.callAbi == "void(pointer,i32,i32,i32,i32)"
    fun callableAsVoidPointerI32I32I32I32I32(): bool =
        this.valid() && this.callAbi == "void(pointer,i32,i32,i32,i32,i32)"
    fun callableAsVoidPointerI32I32I32I32I32I32(): bool =
        this.valid() &&
        this.callAbi == "void(pointer,i32,i32,i32,i32,i32,i32)"
    fun callableAsVoidPointerI32PointerPointer(): bool =
        this.valid() && this.callAbi == "void(pointer,i32,pointer,pointer)"
    fun callableAsVoidPointerI32I32PointerPointer(): bool =
        this.valid() &&
        this.callAbi == "void(pointer,i32,i32,pointer,pointer)"
    fun callableAsI32PointerI32(): bool =
        this.valid() && this.callAbi == "i32(pointer,i32)"
    fun callableAsI32PointerI64I32(): bool =
        this.valid() && this.callAbi == "i32(pointer,i64,i32)"
}

fun rawRegistryCommandIndex(
    commands: array<string>,
    wanted: string
): int {
    var index = 0
    var found = -1
    while (found < 0 && index < commands.size) {
        if (commands[index] == wanted) found = index
        index = index + 1
    }
    found
}

fun rawRegistryCommand(
    commands: array<string>,
    callShapes: array<string>,
    callAbis: array<string>,
    name: string,
    address: int,
    owner: int
): RawNativeCommand {
    val index = rawRegistryCommandIndex(commands, name)
    RawNativeCommand(
        name,
        if (index >= 0 && index < callShapes.size) callShapes[index] else "",
        if (index >= 0 && index < callAbis.size) callAbis[index] else
            "unsupported",
        if (index >= 0) address else 0,
        if (index >= 0) owner else 0
    )
}
