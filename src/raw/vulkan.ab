// Explicit Vulkan raw surface. Registry metadata is generated from vk.xml;
// instance and device command resolution stays visible to the caller.

import "vulkan_calls.ab"
import "native.ab"
import "../application.ab"
import "abla/text"
import "abla/unsafe/native"

fun rawVulkanDecimal(text: string, begin: int, end: int): int {
    var value = 0
    var valid = begin < end
    var index = begin
    while (valid && index < end) {
        val byte = text[index]
        valid = byte >= 48 && byte <= 57
        if (valid) value = value * 10 + byte - 48
        index = index + 1
    }
    if (valid) value else -1
}

fun rawVulkanCoreTransitionVersion(transition: string): int {
    val prefix = "VK_VERSION_"
    val featureEnd = textFindByte(transition, 58)
    var version = -1
    if (featureEnd > prefix.size && transition.size >= prefix.size &&
        transition.slice(0, prefix.size) == prefix) {
        val separator = textFindByte(
            transition, 95, prefix.size, featureEnd
        )
        if (separator > prefix.size && separator + 1 < featureEnd) {
            val major = rawVulkanDecimal(
                transition, prefix.size, separator
            )
            val minor = rawVulkanDecimal(
                transition, separator + 1, featureEnd
            )
            if (major >= 0 && minor >= 0) version = major * 100 + minor
        }
    }
    version
}

fun rawVulkanApiVersionNumber(apiVersion: int): int =
    ((apiVersion >> 22) & 127) * 100 + ((apiVersion >> 12) & 1023)

fun rawVulkanCoreTransitionsAdvertised(
    transitions: string,
    apiVersion: int
): bool {
    val version = rawVulkanApiVersionNumber(apiVersion)
    var advertised = false
    var begin = 0
    var cursor = 0
    while (cursor <= transitions.size) {
        if (cursor == transitions.size || transitions[cursor] == 124) {
            val transition = transitions.slice(begin, cursor)
            val first = textFindByte(transition, 58)
            val second = if (first >= 0)
                textFindByte(transition, 58, first + 1, transition.size)
                else -1
            val transitionVersion = rawVulkanCoreTransitionVersion(
                transition
            )
            if (first >= 0 && second > first &&
                transitionVersion >= 0 && transitionVersion <= version &&
                transition.slice(second + 1, transition.size) == "all") {
                advertised = transition.slice(first + 1, second) == "+"
            }
            begin = cursor + 1
        }
        cursor = cursor + 1
    }
    advertised
}

fun rawVulkanNameEnabled(names: string, wanted: string): bool {
    var found = false
    var begin = 0
    var cursor = 0
    while (!found && cursor <= names.size) {
        if (cursor == names.size || names[cursor] == 124) {
            found = names.slice(begin, cursor) == wanted
            begin = cursor + 1
        }
        cursor = cursor + 1
    }
    found
}

fun rawVulkanExtensionProvidersAdvertised(
    providers: string,
    enabledExtensions: string,
    platform: string
): bool {
    var advertised = false
    var begin = 0
    var cursor = 0
    while (!advertised && cursor <= providers.size) {
        if (cursor == providers.size || providers[cursor] == 124) {
            val provider = providers.slice(begin, cursor)
            val first = textFindByte(provider, 58)
            val second = if (first >= 0)
                textFindByte(provider, 58, first + 1, provider.size)
                else -1
            val third = if (second >= 0)
                textFindByte(provider, 58, second + 1, provider.size)
                else -1
            val providerPlatform = if (first >= 0 && second > first)
                provider.slice(first + 1, second) else ""
            val profile = if (second >= 0)
                provider.slice(second + 1, provider.size) else ""
            if (first > 0 && second > first && third < 0 &&
                profile == "all" &&
                (providerPlatform == "all" ||
                    providerPlatform == platform)) {
                advertised = rawVulkanNameEnabled(
                    enabledExtensions, provider.slice(0, first)
                )
            }
            begin = cursor + 1
        }
        cursor = cursor + 1
    }
    advertised
}

// This non-owning view must not outlive the GraphicsApplication it came from.
class RawVulkanApi(
    val instance: i64*,
    val device: i64*,
    val instanceApiVersion: int,
    val deviceApiVersion: int,
    val instanceExtensions: string,
    val deviceExtensions: string,
    val platform: string,
    val commands: array<string>,
    val callShapes: array<string>,
    val callAbis: array<string>,
    val coreTransitionSchema: string,
    val extensionProviderSchema: string,
    val dispatchScopeSchema: string,
    val available: bool
) {
    fun capability(name: string): RawCommandCapability =
        rawRegistryCommandCapability(
            this.commands,
            this.coreTransitionSchema,
            this.extensionProviderSchema,
            this.dispatchScopeSchema,
            name
        )

    fun instanceExtensionEnabled(name: string): bool =
        rawVulkanNameEnabled(this.instanceExtensions, name)

    fun deviceExtensionEnabled(name: string): bool =
        rawVulkanNameEnabled(this.deviceExtensions, name)

    fun capabilityAdvertised(capability: RawCommandCapability): bool {
        var advertised = false
        if (capability.valid()) {
            if (capability.dispatchScope == "global") {
                advertised = rawVulkanCoreTransitionsAdvertised(
                    capability.coreTransitions, this.instanceApiVersion
                )
            } else if (capability.dispatchScope == "instance") {
                advertised = rawVulkanCoreTransitionsAdvertised(
                    capability.coreTransitions, this.instanceApiVersion
                ) || rawVulkanExtensionProvidersAdvertised(
                    capability.extensionProviders,
                    this.instanceExtensions,
                    this.platform
                )
            } else if (capability.dispatchScope == "device") {
                advertised = rawVulkanCoreTransitionsAdvertised(
                    capability.coreTransitions, this.deviceApiVersion
                ) || rawVulkanExtensionProvidersAdvertised(
                    capability.extensionProviders,
                    this.deviceExtensions,
                    this.platform
                )
            }
        }
        advertised
    }

    fun instanceCommandAdvertised(name: string): bool {
        val capability = this.capability(name)
        capability.dispatchScope == "instance" &&
            this.capabilityAdvertised(capability)
    }

    fun deviceCommandAdvertised(name: string): bool {
        val capability = this.capability(name)
        capability.dispatchScope == "device" &&
            this.capabilityAdvertised(capability)
    }

    fun globalCommandAdvertised(name: string): bool {
        val capability = this.capability(name)
        capability.valid() &&
            (capability.dispatchScope == "global" ||
                name == "vkGetInstanceProcAddr") &&
            rawVulkanCoreTransitionsAdvertised(
                capability.coreTransitions, this.instanceApiVersion
            )
    }

    trusted fun instanceCommandSupported(name: string): bool =
        this.instanceCommandAdvertised(name) &&
        this.instanceCommand(name).valid()

    trusted fun deviceCommandSupported(name: string): bool =
        this.deviceCommandAdvertised(name) &&
        this.deviceCommand(name).valid()

    trusted fun globalCommandSupported(name: string): bool =
        this.globalCommandAdvertised(name) &&
        this.globalCommand(name).valid()

    trusted fun featureMatrix(): RawFeatureMatrix {
        val cursor = RawCommandCapabilityCursor(
            this.coreTransitionSchema,
            this.extensionProviderSchema,
            this.dispatchScopeSchema
        )
        var metadata = 0
        var core = 0
        var extension = 0
        var advertised = 0
        var supported = 0
        var global = 0
        var instance = 0
        var device = 0
        var firstInvalid = ""
        var firstUnresolved = ""
        var index = 0
        while (index < this.commands.size) {
            val capability = cursor.next(this.commands[index])
            if (capability.valid()) metadata = metadata + 1
            else if (firstInvalid == "") firstInvalid = capability.name
            if (capability.hasCorePath()) core = core + 1
            if (capability.hasExtensionPath()) extension = extension + 1
            if (capability.dispatchScope == "global") global = global + 1
            else if (capability.dispatchScope == "instance") {
                instance = instance + 1
            } else if (capability.dispatchScope == "device") {
                device = device + 1
            } else if (firstInvalid == "") {
                firstInvalid = capability.name
            }
            if (this.capabilityAdvertised(capability)) {
                advertised = advertised + 1
                var address = 0
                if (capability.dispatchScope == "global") {
                    address = nativePointerAddress(vkGetInstanceProcAddr(
                        nativeNullPointer(), capability.name
                    ))
                } else if (capability.dispatchScope == "instance") {
                    address = nativePointerAddress(vkGetInstanceProcAddr(
                        this.instance, capability.name
                    ))
                } else if (capability.dispatchScope == "device") {
                    address = nativePointerAddress(vkGetDeviceProcAddr(
                        this.device, capability.name
                    ))
                }
                if (address != 0) supported = supported + 1
                else if (firstUnresolved == "") {
                    firstUnresolved = capability.name
                }
            }
            index = index + 1
        }
        if (!cursor.exhausted() && firstInvalid == "") {
            firstInvalid = "#capability-schema"
        }
        RawFeatureMatrix(
            this.commands.size,
            metadata,
            core,
            extension,
            advertised,
            supported,
            0,
            global,
            instance,
            device,
            firstInvalid,
            firstUnresolved
        )
    }

    trusted fun owns(command: RawNativeCommand): bool =
        command.owner == nativePointerAddress(this.device) ||
        command.owner == nativePointerAddress(this.instance)

    trusted fun instanceCommand(name: string): RawNativeCommand {
        val index = rawRegistryCommandIndex(this.commands, name)
        val address = if (this.available && index >= 0)
            nativePointerAddress(vkGetInstanceProcAddr(this.instance, name))
            else 0
        rawRegistryCommand(
            this.commands,
            this.callShapes,
            this.callAbis,
            name,
            address,
            nativePointerAddress(this.instance)
        )
    }

    trusted fun globalCommand(name: string): RawNativeCommand {
        val index = rawRegistryCommandIndex(this.commands, name)
        val address = if (this.available && index >= 0)
            nativePointerAddress(vkGetInstanceProcAddr(
                nativeNullPointer(), name
            )) else 0
        rawRegistryCommand(
            this.commands,
            this.callShapes,
            this.callAbis,
            name,
            address,
            nativePointerAddress(this.instance)
        )
    }

    trusted fun deviceCommand(name: string): RawNativeCommand {
        val index = rawRegistryCommandIndex(this.commands, name)
        val address = if (this.available && index >= 0)
            nativePointerAddress(vkGetDeviceProcAddr(this.device, name))
            else 0
        rawRegistryCommand(
            this.commands,
            this.callShapes,
            this.callAbis,
            name,
            address,
            nativePointerAddress(this.device)
        )
    }

    trusted fun callVoidPointerI32(
        command: RawNativeCommand,
        first: i64*,
        second: int
    ): bool {
        val callable = command.callableAsVoidPointerI32() &&
            command.owner == nativePointerAddress(this.device) &&
            !pointerIsNull(first) && this.available
        if (callable) {
            callNativeVoidPointerI32(command.address, first, second)
        }
        callable
    }

    trusted fun callVoidPointer(
        command: RawNativeCommand,
        first: i64*
    ): bool {
        val callable = command.callableAsVoidPointer() &&
            command.owner == nativePointerAddress(this.device) &&
            !pointerIsNull(first) && this.available
        if (callable) callNativeVoidPointer(command.address, first)
        callable
    }

    trusted fun callVoidPointerI32I32(
        command: RawNativeCommand,
        first: i64*,
        second: int,
        third: int
    ): bool {
        val callable = command.callableAsVoidPointerI32I32() &&
            command.owner == nativePointerAddress(this.device) &&
            !pointerIsNull(first) && this.available
        if (callable) {
            callNativeVoidPointerI32I32(
                command.address, first, second, third
            )
        }
        callable
    }

    trusted fun callI32Pointer(
        command: RawNativeCommand,
        first: i64*,
        result: i64*
    ): bool {
        val callable = command.callableAsI32Pointer() &&
            this.owns(command) &&
            !pointerIsNull(first) && !pointerIsNull(result) && this.available
        if (callable) {
            ablaUnsafeStoreI64(
                result,
                callNativeI32Pointer(command.address, first)
            )
        }
        callable
    }

    trusted fun callI32Pointer4(
        command: RawNativeCommand,
        first: i64*,
        second: i64*,
        third: i64*,
        fourth: i64*,
        result: i64*
    ): bool {
        val callable = command.callableAsI32Pointer4() &&
            this.owns(command) && !pointerIsNull(first) &&
            !pointerIsNull(second) && !pointerIsNull(fourth) &&
            !pointerIsNull(result) && this.available
        if (callable) {
            ablaUnsafeStoreI64(
                result,
                callNativeI32Pointer4(
                    command.address, first, second, third, fourth
                )
            )
        }
        callable
    }

    trusted fun callVoidPointerI64Pointer(
        command: RawNativeCommand,
        first: i64*,
        second: int,
        third: i64*
    ): bool {
        val callable = command.callableAsVoidPointerI64Pointer() &&
            this.owns(command) && !pointerIsNull(first) && second != 0 &&
            this.available
        if (callable) {
            callNativeVoidPointerIntPointer(
                command.address, first, second, third
            )
        }
        callable
    }

    trusted fun callI32PointerI64(
        command: RawNativeCommand,
        first: i64*,
        second: int,
        result: i64*
    ): bool {
        val callable = command.callableAsI32PointerI64() &&
            this.owns(command) && !pointerIsNull(first) && second != 0 &&
            !pointerIsNull(result) && this.available
        if (callable) {
            ablaUnsafeStoreI64(
                result,
                callNativeI32PointerI64(command.address, first, second)
            )
        }
        callable
    }

    trusted fun callVoidPointerPointer(
        command: RawNativeCommand,
        first: i64*,
        second: i64*
    ): bool {
        val callable = command.callableAsVoidPointerPointer() &&
            this.owns(command) && !pointerIsNull(first) &&
            !pointerIsNull(second) && this.available
        if (callable) {
