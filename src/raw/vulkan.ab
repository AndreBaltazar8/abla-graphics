    trusted fun callVoidPointerI64I64I32I32Pointer(
        command: RawNativeCommand, first: i64*, second: int, third: int,
        fourth: int, fifth: int, sixth: i64*
    ): bool {
        val callable = command.callableAsVoidPointerI64I64I32I32Pointer() &&
