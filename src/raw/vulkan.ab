        )
        callable
    }

    trusted fun callVoidPointerI32I16(
        command: RawNativeCommand, first: i64*, second: int, third: int
    ): bool {
        val callable = command.callableAsVoidPointerI32I16() &&
            this.owns(command) && !pointerIsNull(first) && this.available
        if (callable) callNativeVoidPointerI32I16(
            command.address, first, second, third
        )
        callable
    }

    trusted fun callI32PointerI32PointerI32(
        command: RawNativeCommand, first: i64*, second: int,
        third: i64*, fourth: int, result: i64*
    ): bool {
        val callable = command.callableAsI32PointerI32PointerI32() &&
            this.owns(command) && !pointerIsNull(first) &&
            !pointerIsNull(result) && this.available
        if (callable) ablaUnsafeStoreI64(result,
            callNativeI32PointerI32PointerI32(
                command.address, first, second, third, fourth
            ))
        callable
    }

    trusted fun callI32PointerPointerI64Pointer(
        command: RawNativeCommand, first: i64*, second: i64*,
        third: int, fourth: i64*, result: i64*
    ): bool {
        val callable = command.callableAsI32PointerPointerI64Pointer() &&
            this.owns(command) && !pointerIsNull(first) &&
            !pointerIsNull(result) && this.available
        if (callable) ablaUnsafeStoreI64(result,
            callNativeI32PointerPointerI64Pointer(
                command.address, first, second, third, fourth
            ))
        callable
    }

}

trusted fun GraphicsApplication.rawVulkanApi(): RawVulkanApi {
    val available = this.valid() && this.backend == graphicsBackendVulkan &&
        this.vulkanInstance.valid() && this.vulkanDevice.valid()
    RawVulkanApi(
        this.vulkanInstance.handle,
        this.vulkanDevice.handle,
        this.vulkanInstance.apiVersion,
        this.vulkanDevice.apiVersion,
        this.vulkanInstance.enabledExtensions,
        this.vulkanDevice.enabledExtensions,
        this.vulkanInstance.platform,
        rawVulkanCallNames(),
        rawVulkanCallShapes(),
        rawVulkanCallAbis(),
        rawVulkanCallCoreTransitionSchema(),
        rawVulkanCallExtensionProviderSchema(),
        rawVulkanCallDispatchScopeSchema(),
        available
    )
}
