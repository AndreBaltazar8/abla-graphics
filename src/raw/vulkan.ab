// Explicit Vulkan raw surface. Registry metadata is generated from vk.xml;
// instance and device command resolution stays visible to the caller.

import "vulkan_calls.ab"
import "native.ab"
import "../application.ab"

// This non-owning view must not outlive the GraphicsApplication it came from.
class RawVulkanApi(
    val instance: i64*,
    val device: i64*,
    val commands: array<string>,
    val callShapes: array<string>,
    val callAbis: array<string>,
    val available: bool
) {
    trusted fun instanceCommand(name: string): RawNativeCommand {
        val index = rawRegistryCommandIndex(this.commands, name)
        val address = if (this.available && index >= 0)
            nativePointerAddress(vkGetInstanceProcAddr(this.instance, name))
            else 0
        rawRegistryCommand(
            this.commands,
            this.callShapes,
            this.callAbis,
            name,
            address,
            nativePointerAddress(this.instance)
        )
    }

    trusted fun deviceCommand(name: string): RawNativeCommand {
        val index = rawRegistryCommandIndex(this.commands, name)
        val address = if (this.available && index >= 0)
            nativePointerAddress(vkGetDeviceProcAddr(this.device, name))
            else 0
        rawRegistryCommand(
            this.commands,
            this.callShapes,
            this.callAbis,
            name,
            address,
            nativePointerAddress(this.device)
        )
    }

    trusted fun callVoidPointerI32(
        command: RawNativeCommand,
        first: i64*,
        second: int
    ): bool {
        val callable = command.callableAsVoidPointerI32() &&
            command.owner == nativePointerAddress(this.device) &&
            !pointerIsNull(first) && this.available
        if (callable) {
            callNativeVoidPointerI32(command.address, first, second)
        }
        callable
    }

    trusted fun callVoidPointer(
        command: RawNativeCommand,
        first: i64*
    ): bool {
        val callable = command.callableAsVoidPointer() &&
            command.owner == nativePointerAddress(this.device) &&
            !pointerIsNull(first) && this.available
        if (callable) callNativeVoidPointer(command.address, first)
        callable
    }

    trusted fun callVoidPointerI32I32(
        command: RawNativeCommand,
        first: i64*,
        second: int,
        third: int
    ): bool {
        val callable = command.callableAsVoidPointerI32I32() &&
            command.owner == nativePointerAddress(this.device) &&
            !pointerIsNull(first) && this.available
        if (callable) {
            callNativeVoidPointerI32I32(
                command.address, first, second, third
            )
        }
        callable
    }

    trusted fun callI32Pointer(
        command: RawNativeCommand,
        first: i64*,
        result: i64*
    ): bool {
        val callable = command.callableAsI32Pointer() &&
            command.owner == nativePointerAddress(this.device) &&
            !pointerIsNull(first) && !pointerIsNull(result) && this.available
        if (callable) {
            ablaUnsafeStoreI64(
                result,
                callNativeI32Pointer(command.address, first)
            )
        }
        callable
    }
}

trusted fun GraphicsApplication.rawVulkanApi(): RawVulkanApi {
    val available = this.valid() && this.backend == graphicsBackendVulkan &&
        this.vulkanInstance.valid() && this.vulkanDevice.valid()
    RawVulkanApi(
        this.vulkanInstance.handle,
        this.vulkanDevice.handle,
        rawVulkanCallNames(),
        rawVulkanCallShapes(),
        rawVulkanCallAbis(),
        available
    )
}
