// Backend-neutral application ownership and one-time backend specialization.

import "abla/unsafe/memory"
import "core.ab"
import "window.ab"
import "pixels.ab"
import "platform/x11.ab"
import "driver/opengl.ab"
import "driver/vulkan.ab"

resource class GraphicsApplication(
    var window: X11Window,
    var openGlPixels: OpenGlPixelPresenter,
    var openGl: OpenGlWindowContext,
    var vulkanPixels: VulkanPixelPresenter,
    var vulkanSwapchain: VulkanSwapchain,
    var vulkanDevice: VulkanDevice,
    var vulkanSurface: VulkanX11Surface,
    var vulkanInstance: VulkanInstance,
    val backend: int,
    val framesInFlight: int,
    val capabilities: GraphicsCapabilities,
    val adapterName: string,
    val error: GraphicsError
) {
    fun valid(): bool = !this.error.occurred() &&
        this.window.valid() &&
        this.capabilities.valid() &&
        ((this.backend == graphicsBackendOpenGl && this.openGl.valid()) ||
         (this.backend == graphicsBackendVulkan &&
          this.vulkanInstance.valid() && this.vulkanSurface.valid() &&
          this.vulkanDevice.valid() && this.vulkanSwapchain.valid() &&
          this.vulkanPixels.valid()))

    trusted fun recreateVulkanSwapchain(width: int, height: int): bool {
        var succeeded = this.backend == graphicsBackendVulkan &&
            this.vulkanDevice.valid() && this.vulkanSurface.valid() &&
            width > 0 && height > 0 && this.vulkanDevice.waitIdle()
        if (succeeded) {
            this.vulkanPixels.drop()
            this.vulkanSwapchain.drop()
            this.vulkanSurface.width = width
            this.vulkanSurface.height = height
            val adapter = VulkanAdapter(
                this.vulkanDevice.physicalDevice,
                this.adapterName,
                this.vulkanDevice.apiVersion,
                0,
                0,
                0,
                0
            )
            this.vulkanSwapchain = this.vulkanDevice.swapchain(
                adapter,
                this.vulkanSurface
            )
            if (this.vulkanSwapchain.valid()) {
                this.vulkanPixels = this.vulkanDevice.pixelPresenter(
                    this.vulkanSwapchain,
                    this.framesInFlight
                )
            }
            succeeded = this.vulkanSwapchain.valid() &&
                this.vulkanPixels.valid()
            if (succeeded) {
                this.vulkanSurface.width = this.vulkanSwapchain.width
                this.vulkanSurface.height = this.vulkanSwapchain.height
                this.window.width = this.vulkanSwapchain.width
                this.window.height = this.vulkanSwapchain.height
            }
        }
        succeeded
    }

    trusted fun pollEvent(timeoutMilliseconds: int = 0): WindowEvent {
        val event = this.window.pollEvent(timeoutMilliseconds)
        if (event.kind == windowEventResized &&
            this.backend == graphicsBackendOpenGl) {
            this.openGl.width = event.first
            this.openGl.height = event.second
        } else if (event.kind == windowEventResized &&
            this.backend == graphicsBackendVulkan) {
            // Defer recreation until the next presentation so an owning
            // render pipeline can release its framebuffers and image views
            // before the old swapchain is destroyed.
            this.vulkanSurface.width = event.first
            this.vulkanSurface.height = event.second
        }
        event
    }

    fun requestClose(): bool = this.window.requestClose()
    fun show(): bool = this.window.show()
    fun hide(): bool = this.window.hide()
    fun setTitle(title: string): bool = this.window.setTitle(title)
    fun resize(width: int, height: int): bool =
        this.window.resize(width, height)
    fun setPointerPosition(x: int, y: int): bool =
        this.window.setPointerPosition(x, y)
    fun setPointerCaptured(captured: bool): bool =
        this.window.setPointerCaptured(captured)
    fun setCursorVisible(visible: bool): bool =
        this.window.setCursorVisible(visible)
    fun cursorVisible(): bool = this.window.cursorVisible
    fun setClipboard(value: string): bool = this.window.setClipboard(value)
    fun requestClipboard(): bool = this.window.requestClipboard()
    fun requestClipboardFormats(): bool =
        this.window.requestClipboardFormats()
    fun primaryMonitor(): Monitor = this.window.primaryMonitor

    trusted fun waitIdle(): bool = this.valid() && (
        (this.backend == graphicsBackendOpenGl && this.openGl.waitIdle()) ||
        (this.backend == graphicsBackendVulkan &&
            this.vulkanDevice.waitIdle())
    )

    trusted fun recoverVulkanClearPresentation(
        outcome: int,
        color: Color,
        width: int,
        height: int
    ): bool {
        var presented = vulkanPresentSucceeded(outcome)
        if (vulkanPresentNeedsRecreation(outcome)) {
            val recovered = this.recreateVulkanSwapchain(width, height)
            if (!recovered) {
                presented = false
            } else if (!vulkanPresentSucceeded(outcome)) {
                val retried = this.vulkanDevice.presentClearFramesOutcome(
                    this.vulkanSwapchain,
                    this.vulkanPixels,
                    color
                )
                presented = vulkanPresentSucceeded(retried) &&
                    !vulkanPresentNeedsRecreation(retried)
            }
        }
        presented
    }

    trusted fun recoverVulkanPixelPresentation(
        outcome: int,
        pixels: PixelBuffer,
        width: int,
        height: int
    ): bool {
        var presented = vulkanPresentSucceeded(outcome)
        if (vulkanPresentNeedsRecreation(outcome)) {
            val recovered = this.recreateVulkanSwapchain(width, height)
            if (!recovered) {
                presented = false
            } else if (!vulkanPresentSucceeded(outcome)) {
                if (pixels.width == this.vulkanSwapchain.width &&
                    pixels.height == this.vulkanSwapchain.height) {
                    val retried = this.vulkanDevice.presentPixelsOutcome(
                        this.vulkanSwapchain,
                        this.vulkanPixels,
                        pixels
                    )
                    presented = vulkanPresentSucceeded(retried) &&
                        !vulkanPresentNeedsRecreation(retried)
                } else presented = false
            }
        }
        presented
    }

    trusted fun presentClear(color: Color): bool {
        var presented = false
        if (this.backend == graphicsBackendOpenGl) {
            presented = this.openGl.presentClear(color)
        } else if (this.backend == graphicsBackendVulkan) {
            var outcome = this.vulkanDevice.presentClearFramesOutcome(
                this.vulkanSwapchain,
                this.vulkanPixels,
                color
            )
            presented = this.recoverVulkanClearPresentation(
                outcome,
                color,
                this.window.width,
                this.window.height
            )
        }
        presented
    }

    trusted fun presentPixels(pixels: PixelBuffer): bool {
        var presented = false
        if (this.backend == graphicsBackendOpenGl) {
            presented = this.openGlPixels.present(this.openGl, pixels)
        } else if (this.backend == graphicsBackendVulkan) {
            var ready = true
            if ((pixels.width != this.vulkanSwapchain.width ||
                pixels.height != this.vulkanSwapchain.height) &&
                pixels.width == this.window.width &&
                pixels.height == this.window.height) {
                ready = this.recreateVulkanSwapchain(
                    this.window.width,
                    this.window.height
                )
            }
            var outcome = vulkanPresentOutcome(false, false, -1)
            if (ready) {
                outcome = this.vulkanDevice.presentPixelsOutcome(
                    this.vulkanSwapchain,
                    this.vulkanPixels,
                    pixels
                )
                presented = this.recoverVulkanPixelPresentation(
                    outcome,
                    pixels,
                    this.window.width,
                    this.window.height
                )
            }
        }
        presented
    }

    trusted fun drop(): void {
        this.vulkanPixels.drop()
        this.vulkanSwapchain.drop()
        this.vulkanDevice.drop()
        this.vulkanSurface.drop()
        this.vulkanInstance.drop()
        this.openGlPixels.drop()
        this.openGl.drop()
        this.window.drop()
        return
    }
}

trusted fun graphicsApplication(
    config: GraphicsConfig = GraphicsConfig(),
    windowConfig: WindowConfig = WindowConfig()
): GraphicsApplication {
    var window = X11Window(
        -1, 0, 0, 0, 0, 0, 0, 0, 0, [], Monitor(), 0, 0, false, false,
        0, true, "", windowEventEmpty, [], 0, false, "", nativeByteBuffer(0)
    )
    var openGl = OpenGlWindowContext(
        nativeNullPointer(),
        nativeNullPointer(),
        nativeNullPointer(),
        nativeNullPointer(),
        0,
        0,
        nativeByteBuffer(0)
    )
    var openGlPixels = OpenGlPixelPresenter(
        OpenGlProgram(0, 0, ""),
        0,
        0,
        0
    )
    var vulkanSwapchain = VulkanSwapchain(
        0,
        nativeNullPointer(),
        [],
        0,
        0,
        0,
        0
    )
    var vulkanPixels = VulkanPixelPresenter(
        [],
        [],
        0,
        0,
        0,
        0,
        0
    )
    var vulkanDevice = VulkanDevice(
        nativeNullPointer(),
        nativeNullPointer(),
        -1,
        0,
        nativeNullPointer(),
        false,
        false,
        0,
        0,
        0,
        0,
        nativePointerCell(nativeNullPointer()),
        nativeByteBuffer(0)
    )
    var vulkanSurface = VulkanX11Surface(
        0,
        nativeNullPointer(),
        nativeNullPointer(),
        0,
        0,
        0
    )
    var vulkanInstance = VulkanInstance(nativeNullPointer(), 0)
    var backend = graphicsBackendAuto
    var capabilities = GraphicsCapabilities()
    var adapterName = ""
    var error = GraphicsError()
    var requiredFeaturesUnavailable = false

    if (!config.valid() || !windowConfig.valid() ||
        config.backend == graphicsBackendHeadless) {
        error = GraphicsError(
            graphicsErrorInvalidConfiguration,
            "graphicsApplication",
            "surface application configuration is invalid"
        )
    } else {
        window = x11Window(windowConfig)
        if (!window.valid()) {
            error = GraphicsError(
                graphicsErrorDriverFailure,
                "x11Window",
                "could not create the platform window"
            )
        }
    }

    val tryVulkan = !error.occurred() &&
        (config.backend == graphicsBackendAuto ||
         config.backend == graphicsBackendVulkan)
    if (tryVulkan) {
        vulkanInstance = vulkanX11Instance(windowConfig.title)
        if (vulkanInstance.valid()) {
            vulkanSurface = vulkanX11Surface(vulkanInstance, window)
        }
        val adapters = vulkanInstance.adapters()
        var index = 0
        while (!vulkanSwapchain.valid() && index < adapters.size) {
            val adapter = adapters[index]
            val adapterCapabilities = adapter.capabilities()
            if (adapterCapabilities.valid() &&
                !adapterCapabilities.supports(config.requiredFeatures)) {
                requiredFeaturesUnavailable = true
            }
            if (vulkanSurface.valid() && adapter.supportsSurface(vulkanSurface) &&
                adapterCapabilities.valid() &&
                adapterCapabilities.supports(config.requiredFeatures)) {
                vulkanDevice = adapter.deviceForSurface(vulkanSurface)
                if (vulkanDevice.valid()) {
                    vulkanSwapchain = vulkanDevice.swapchain(
                        adapter,
                        vulkanSurface
                    )
                    if (vulkanSwapchain.valid()) {
                        vulkanPixels =
                            vulkanDevice.pixelPresenter(
                                vulkanSwapchain,
                                config.framesInFlight
                            )
                        if (vulkanPixels.valid()) {
                            adapterName = adapter.name
                            capabilities = adapterCapabilities
                        }
                    }
                }
            }
            index = index + 1
        }
        if (vulkanSwapchain.valid() && vulkanPixels.valid()) {
            backend = graphicsBackendVulkan
        }
        else {
            vulkanPixels.drop()
            vulkanSwapchain.drop()
            vulkanDevice.drop()
            vulkanSurface.drop()
            vulkanInstance.drop()
        }
    }

    val tryOpenGl = !error.occurred() &&
        backend == graphicsBackendAuto &&
        (config.backend == graphicsBackendAuto ||
         config.backend == graphicsBackendOpenGl)
    if (tryOpenGl) {
        openGl = openGlWindowContext(window)
        if (openGl.valid()) {
            val openGlCapabilities = openGl.capabilities()
            if (openGlCapabilities.valid() &&
                openGlCapabilities.supports(config.requiredFeatures)) {
                openGlPixels = openGlPixelPresenter(
                    openGl,
                    windowConfig.width,
                    windowConfig.height
                )
                backend = graphicsBackendOpenGl
                adapterName = "OpenGL core context"
                capabilities = openGlCapabilities
            } else {
                requiredFeaturesUnavailable = true
                openGl.drop()
            }
        }
    }

    if (!error.occurred() && backend == graphicsBackendAuto) {
        error = GraphicsError(
            if (requiredFeaturesUnavailable)
                graphicsErrorUnsupportedFeature
            else graphicsErrorBackendUnavailable,
            "graphicsApplication",
            if (requiredFeaturesUnavailable)
                "the requested features are unavailable"
            else "the requested surfaced backend is unavailable"
        )
    }

    GraphicsApplication(
        move(window),
        move(openGlPixels),
        move(openGl),
        move(vulkanPixels),
        move(vulkanSwapchain),
        move(vulkanDevice),
        move(vulkanSurface),
        move(vulkanInstance),
        backend,
        config.framesInFlight,
        capabilities,
        adapterName,
        error
    )
}
