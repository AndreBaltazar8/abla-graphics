// Reusable backend-neutral values for a reflected shader push-constant block.

import "shader/glsl.ab"
import "bytes.ab"

val graphicsPushMemberFloat = 1
val graphicsPushMemberSigned = 2
val graphicsPushMemberUnsigned = 3
val graphicsPushMemberBoolean = 4

fun ShaderPushConstantLayout.memberIndex(name: string): int {
    var result = -1
    var index = 0
    while (result < 0 && index < this.members.size) {
        if (this.members[index].name == name) result = index
        index = index + 1
    }
    result
}

fun graphicsPushMemberComponents(dataType: string, family: int): int {
    var components = 0
    if ((family == graphicsPushMemberFloat && dataType == "float") ||
        (family == graphicsPushMemberSigned && dataType == "int") ||
        (family == graphicsPushMemberUnsigned && dataType == "uint") ||
        (family == graphicsPushMemberBoolean && dataType == "bool")) {
        components = 1
    } else if ((family == graphicsPushMemberFloat && dataType == "vec2") ||
        (family == graphicsPushMemberSigned && dataType == "ivec2") ||
        (family == graphicsPushMemberUnsigned && dataType == "uvec2") ||
        (family == graphicsPushMemberBoolean && dataType == "bvec2")) {
        components = 2
    } else if ((family == graphicsPushMemberFloat && dataType == "vec3") ||
        (family == graphicsPushMemberSigned && dataType == "ivec3") ||
        (family == graphicsPushMemberUnsigned && dataType == "uvec3") ||
        (family == graphicsPushMemberBoolean && dataType == "bvec3")) {
        components = 3
    } else if ((family == graphicsPushMemberFloat && dataType == "vec4") ||
        (family == graphicsPushMemberSigned && dataType == "ivec4") ||
        (family == graphicsPushMemberUnsigned && dataType == "uvec4") ||
        (family == graphicsPushMemberBoolean && dataType == "bvec4")) {
        components = 4
    }
    components
}

fun graphicsPushMemberComponentOffset(
    layout: ShaderPushConstantLayout,
    name: string,
    family: int,
    component: int,
    arrayIndex: int
): int {
    val memberIndex = layout.memberIndex(name)
    var result = -1
    if (layout.valid && memberIndex >= 0) {
        val member = layout.members[memberIndex]
        val components = graphicsPushMemberComponents(
            member.dataType,
            family
        )
        if (components > 0 && component >= 0 && component < components &&
            arrayIndex >= 0 && arrayIndex < member.arraySize &&
            (member.arraySize == 1 || member.arrayStride > 0)) {
            val arrayOffset = if (member.arraySize > 1)
                member.arrayStride * arrayIndex else 0
            val offset = member.offset + arrayOffset + component * 4
            if (offset >= member.offset && offset <= layout.size - 4 &&
                offset <= member.offset + member.size - 4) result = offset
        }
    }
    result
}

resource class GraphicsPushConstants(
    val layout: ShaderPushConstantLayout,
    val bytes: BufferBytes,
    val error: string
) {
    fun valid(): bool = this.error == "" && this.layout.valid &&
        this.layout.size > 0 && this.bytes.valid() &&
        this.bytes.size == this.layout.size

    fun memberIndex(name: string): int {
        this.layout.memberIndex(name)
    }

    fun memberOffset(name: string): int {
        val index = this.memberIndex(name)
        if (index >= 0) this.layout.members[index].offset else -1
    }

    fun memberSize(name: string): int {
        val index = this.memberIndex(name)
        if (index >= 0) this.layout.members[index].size else -1
    }

    trusted fun writeBytes(
        source: BufferBytes,
        destinationOffset: int = 0,
        sourceOffset: int = 0,
        size: int = -1
    ): bool {
        val byteCount = if (size == -1 && sourceOffset >= 0 &&
            sourceOffset <= source.size) source.size - sourceOffset else size
        var accepted = this.valid() && source.valid() &&
            sourceOffset >= 0 && sourceOffset <= source.size &&
            destinationOffset >= 0 && destinationOffset <= this.bytes.size &&
            byteCount >= 0 && byteCount <= source.size - sourceOffset &&
            byteCount <= this.bytes.size - destinationOffset
        if (accepted && byteCount > 0) {
            ablaUnsafeCopyMemory(
                this.bytes.storage.pointerAt(destinationOffset),
                source.storage.pointerAt(sourceOffset),
                byteCount
            )
        }
        accepted
    }

    trusted fun writeMember(name: string, source: BufferBytes): bool {
        val index = this.memberIndex(name)
        index >= 0 && source.valid() &&
            source.size == this.layout.members[index].size &&
            this.writeBytes(
                source,
                this.layout.members[index].offset,
                0,
                source.size
            )
    }

    trusted fun storeMemberF32(
        name: string,
        value: f64,
        component: int = 0,
        arrayIndex: int = 0
    ): bool {
        val offset = graphicsPushMemberComponentOffset(
            this.layout,
            name,
            graphicsPushMemberFloat,
            component,
            arrayIndex
        )
        this.valid() && offset >= 0 && this.bytes.storeF32(value, offset)
    }

    trusted fun storeMemberI32(
        name: string,
        value: int,
        component: int = 0,
        arrayIndex: int = 0
    ): bool {
        val offset = graphicsPushMemberComponentOffset(
            this.layout,
            name,
            graphicsPushMemberSigned,
            component,
            arrayIndex
        )
        this.valid() && offset >= 0 && this.bytes.storeI32(value, offset)
    }

    trusted fun storeMemberU32(
        name: string,
        value: int,
        component: int = 0,
        arrayIndex: int = 0
    ): bool {
        val offset = graphicsPushMemberComponentOffset(
            this.layout,
            name,
            graphicsPushMemberUnsigned,
            component,
            arrayIndex
        )
        this.valid() && offset >= 0 && this.bytes.storeU32(value, offset)
    }

    trusted fun storeMemberBool(
        name: string,
        value: bool,
        component: int = 0,
        arrayIndex: int = 0
    ): bool {
        val offset = graphicsPushMemberComponentOffset(
            this.layout,
            name,
            graphicsPushMemberBoolean,
            component,
            arrayIndex
        )
        this.valid() && offset >= 0 &&
            this.bytes.storeU32(if (value) 1 else 0, offset)
    }

    trusted fun storeU32(value: int, offset: int = 0): bool =
        this.valid() && offset >= 0 && offset <= this.bytes.size - 4 &&
        this.bytes.storeU32(value, offset)

    trusted fun storeF32(value: f64, offset: int = 0): bool =
        this.valid() && offset >= 0 && offset <= this.bytes.size - 4 &&
        this.bytes.storeF32(value, offset)

    trusted fun fill(value: int = 0): bool =
        this.valid() && this.bytes.fill(value)

    trusted fun drop(): void {
        this.bytes.storage.close()
        return
    }
}

resource class GraphicsSubpassPushConstants(
    val layouts: array<ShaderPushConstantLayout>,
    val offsets: array<int>,
    val sizes: array<int>,
    val stageMasks: array<int>,
    val bytes: BufferBytes,
    val error: string
) {
    fun valid(): bool {
        var valid = this.error == "" && this.layouts.size >= 2 &&
            this.layouts.size <= 8 &&
            this.offsets.size == this.layouts.size &&
            this.sizes.size == this.layouts.size &&
            this.stageMasks.size == this.layouts.size &&
            this.bytes.valid()
        var expectedOffset = 0
        var index = 0
        while (valid && index < this.layouts.size) {
            val layout = this.layouts[index]
            valid = layout.valid && layout.size > 0 &&
                this.offsets[index] == expectedOffset &&
                this.sizes[index] == layout.size &&
                this.stageMasks[index] == layout.stageMask &&
                this.stageMasks[index] != 0 &&
                expectedOffset <= this.bytes.size - layout.size
            if (valid) expectedOffset = expectedOffset + layout.size
            index = index + 1
        }
        valid && expectedOffset == this.bytes.size
    }

    fun subpassCount(): int = this.layouts.size

    fun subpassOffset(index: int): int =
        if (index >= 0 && index < this.offsets.size)
            this.offsets[index]
        else -1

    trusted fun writeSubpass(
        index: int,
        values: GraphicsPushConstants
    ): bool {
        var accepted = this.valid() && values.valid() && index >= 0 &&
            index < this.layouts.size &&
            values.layout.matches(this.layouts[index])
        if (accepted) ablaUnsafeCopyMemory(
            this.bytes.storage.pointerAt(this.offsets[index]),
            values.bytes.storage.address,
            values.bytes.size
        )
        accepted
    }

    trusted fun storeF32(
        subpass: int,
        value: f64,
        offset: int = 0
    ): bool = this.valid() && subpass >= 0 &&
        subpass < this.layouts.size && offset >= 0 &&
        offset <= this.layouts[subpass].size - 4 &&
        this.bytes.storeF32(value, this.offsets[subpass] + offset)

    trusted fun storeU32(
        subpass: int,
        value: int,
        offset: int = 0
    ): bool = this.valid() && subpass >= 0 &&
        subpass < this.layouts.size && offset >= 0 &&
        offset <= this.layouts[subpass].size - 4 &&
        this.bytes.storeU32(value, this.offsets[subpass] + offset)

    trusted fun storeMemberF32(
        subpass: int,
        name: string,
        value: f64,
        component: int = 0,
        arrayIndex: int = 0
    ): bool {
        val offset = if (subpass >= 0 && subpass < this.layouts.size)
            graphicsPushMemberComponentOffset(
                this.layouts[subpass],
                name,
                graphicsPushMemberFloat,
                component,
                arrayIndex
            )
        else -1
        this.valid() && offset >= 0 &&
            this.bytes.storeF32(value, this.offsets[subpass] + offset)
    }

    trusted fun storeMemberI32(
        subpass: int,
        name: string,
        value: int,
        component: int = 0,
        arrayIndex: int = 0
    ): bool {
        val offset = if (subpass >= 0 && subpass < this.layouts.size)
            graphicsPushMemberComponentOffset(
                this.layouts[subpass],
                name,
                graphicsPushMemberSigned,
                component,
                arrayIndex
            )
        else -1
        this.valid() && offset >= 0 &&
            this.bytes.storeI32(value, this.offsets[subpass] + offset)
    }

    trusted fun storeMemberU32(
        subpass: int,
        name: string,
        value: int,
        component: int = 0,
        arrayIndex: int = 0
    ): bool {
        val offset = if (subpass >= 0 && subpass < this.layouts.size)
            graphicsPushMemberComponentOffset(
                this.layouts[subpass],
                name,
                graphicsPushMemberUnsigned,
                component,
                arrayIndex
            )
        else -1
        this.valid() && offset >= 0 &&
            this.bytes.storeU32(value, this.offsets[subpass] + offset)
    }

    trusted fun storeMemberBool(
        subpass: int,
        name: string,
        value: bool,
        component: int = 0,
        arrayIndex: int = 0
    ): bool {
        val offset = if (subpass >= 0 && subpass < this.layouts.size)
            graphicsPushMemberComponentOffset(
                this.layouts[subpass],
                name,
                graphicsPushMemberBoolean,
                component,
                arrayIndex
            )
        else -1
        this.valid() && offset >= 0 && this.bytes.storeU32(
            if (value) 1 else 0,
            this.offsets[subpass] + offset
        )
    }

    trusted fun fill(value: int = 0): bool =
        this.valid() && this.bytes.fill(value)

    trusted fun drop(): void {
        this.bytes.storage.close()
        return
    }
}

trusted fun ShaderPackage.pushConstants(
    maximumSize: int = 128
): GraphicsPushConstants {
    val layout = this.pushConstantLayout(maximumSize)
    val size = if (layout.valid && layout.size > 0) layout.size else 0
    val bytes = bufferBytes(size)
    GraphicsPushConstants(
        layout,
        move(bytes),
        if (!layout.valid) layout.error
        else if (layout.size <= 0) "shader has no push-constant block"
        else ""
    )
}
