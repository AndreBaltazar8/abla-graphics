// Affine backend-neutral GPU buffer ownership and dispatch.

import "abla/unsafe/memory"
import "core.ab"
import "resources.ab"
import "bytes.ab"
import "application.ab"
import "driver/opengl.ab"
import "driver/vulkan.ab"

resource class GraphicsBuffer(
    val openGl: OpenGlBuffer,
    val vulkan: VulkanBuffer,
    val descriptor: BufferDescriptor,
    val backend: int,
    val error: GraphicsError
) {
    fun valid(): bool = !this.error.occurred() && this.descriptor.valid() &&
        ((this.backend == graphicsBackendOpenGl && this.openGl.valid()) ||
         (this.backend == graphicsBackendVulkan && this.vulkan.valid()))

    trusted fun readI64(offset: int = 0): int {
        var result = 0
        if (this.backend == graphicsBackendOpenGl) {
            result = this.openGl.readI64(offset)
        } else if (this.backend == graphicsBackendVulkan) {
            result = this.vulkan.readI64(offset)
        }
        result
    }

    trusted fun writeI64(value: int, offset: int = 0): bool {
        var succeeded = false
        if (this.backend == graphicsBackendOpenGl) {
            succeeded = this.openGl.writeI64(value, offset)
        } else if (this.backend == graphicsBackendVulkan) {
            succeeded = this.vulkan.writeI64(value, offset)
        }
        succeeded
    }

    trusted fun writeBytes(
        source: BufferBytes,
        copy: BufferCopyDescriptor
    ): bool {
        var succeeded = this.valid() && source.valid() &&
            copy.valid(source.size, this.descriptor.size) &&
            bufferUsageAllowsCpuWrite(this.descriptor.usage)
        if (succeeded && this.backend == graphicsBackendOpenGl) {
            succeeded = this.openGl.writeBytes(source, copy)
        } else if (succeeded && this.backend == graphicsBackendVulkan) {
            succeeded = this.vulkan.writeBytes(source, copy)
        } else if (succeeded) succeeded = false
        succeeded
    }

    trusted fun writeAllBytes(source: BufferBytes): bool {
        var succeeded = this.valid() && source.valid() &&
            source.size == this.descriptor.size &&
            bufferUsageAllowsCpuWrite(this.descriptor.usage)
        if (succeeded && this.backend == graphicsBackendOpenGl) {
            succeeded = this.openGl.writeAllBytes(source)
        } else if (succeeded && this.backend == graphicsBackendVulkan) {
            succeeded = this.vulkan.writeAllBytes(source)
        } else if (succeeded) succeeded = false
        succeeded
    }

    trusted fun readBytes(
        var destination: BufferBytes,
        copy: BufferCopyDescriptor
    ): bool {
        var succeeded = this.valid() && destination.valid() &&
            copy.valid(this.descriptor.size, destination.size) &&
            bufferUsageAllowsCpuRead(this.descriptor.usage)
        if (succeeded && this.backend == graphicsBackendOpenGl) {
            succeeded = this.openGl.readBytes(destination, copy)
        } else if (succeeded && this.backend == graphicsBackendVulkan) {
            succeeded = this.vulkan.readBytes(destination, copy)
        } else if (succeeded) succeeded = false
        succeeded
    }

    trusted fun readAllBytes(var destination: BufferBytes): bool =
        this.readBytes(destination, BufferCopyDescriptor())

    fun sameResource(other: GraphicsBuffer): bool =
        this.backend == other.backend &&
        ((this.backend == graphicsBackendOpenGl &&
          this.openGl.handle != 0 &&
          this.openGl.context == other.openGl.context &&
          this.openGl.handle == other.openGl.handle) ||
         (this.backend == graphicsBackendVulkan &&
          this.vulkan.handle != 0 &&
          this.vulkan.device == other.vulkan.device &&
          this.vulkan.handle == other.vulkan.handle))

    trusted fun drop(): void {
        this.openGl.drop()
        this.vulkan.drop()
        return
    }
}

fun GraphicsApplication.ownsBuffer(buffer: GraphicsBuffer): bool =
    this.backend == buffer.backend &&
    ((this.backend == graphicsBackendOpenGl &&
      this.openGl.display == buffer.openGl.display &&
      this.openGl.context == buffer.openGl.context) ||
     (this.backend == graphicsBackendVulkan &&
      this.vulkanDevice.handle == buffer.vulkan.device))

trusted fun GraphicsApplication.copyBuffer(
    source: GraphicsBuffer,
    destination: GraphicsBuffer,
    copy: BufferCopyDescriptor
): bool {
    var succeeded = this.valid() && source.valid() && destination.valid() &&
        this.ownsBuffer(source) && this.ownsBuffer(destination) &&
        !source.sameResource(destination) &&
        copy.valid(source.descriptor.size, destination.descriptor.size) &&
        bufferUsageAllowsGpuCopySource(source.descriptor.usage) &&
        bufferUsageAllowsGpuCopyDestination(destination.descriptor.usage)
    if (succeeded && this.backend == graphicsBackendOpenGl) {
        succeeded = source.openGl.copyTo(destination.openGl, copy)
    } else if (succeeded && this.backend == graphicsBackendVulkan) {
        succeeded = this.vulkanDevice.copyBuffer(
            source.vulkan,
            destination.vulkan,
            copy
        )
    } else if (succeeded) succeeded = false
    succeeded
}

trusted fun GraphicsApplication.fillBuffer(
    buffer: GraphicsBuffer,
    descriptor: BufferFillDescriptor
): bool {
    var succeeded = this.valid() && buffer.valid() &&
        this.ownsBuffer(buffer) && descriptor.valid(buffer.descriptor.size) &&
        bufferUsageAllowsGpuCopyDestination(buffer.descriptor.usage)
    if (succeeded && this.backend == graphicsBackendOpenGl) {
        succeeded = buffer.openGl.fill(descriptor)
    } else if (succeeded && this.backend == graphicsBackendVulkan) {
        succeeded = this.vulkanDevice.fillBuffer(buffer.vulkan, descriptor)
    } else if (succeeded) succeeded = false
    succeeded
}

trusted fun GraphicsApplication.buffer(
    descriptor: BufferDescriptor
): GraphicsBuffer {
    var openGl = OpenGlBuffer(
        0,
        0,
        nativeNullPointer(),
        nativeNullPointer(),
        nativeNullPointer(),
        nativeByteBuffer(0)
    )
    var vulkan = VulkanBuffer(
        nativeNullPointer(),
        nativeNullPointer(),
        nativeNullPointer(),
        -1,
        0,
        0,
        0,
        nativePointerCell(nativeNullPointer())
    )
    var error = GraphicsError()
    val validation = descriptor.validation()
    if (!this.valid()) {
        error = GraphicsError(
            graphicsErrorInvalidConfiguration,
            "GraphicsApplication.buffer",
            "the graphics application is invalid"
        )
    } else if (!validation.succeeded) {
        error = GraphicsError(
            graphicsErrorInvalidConfiguration,
            "GraphicsApplication.buffer.${validation.field}",
            validation.message
        )
    } else if (descriptor.mappedAtCreation) {
        error = GraphicsError(
            graphicsErrorInvalidConfiguration,
            "GraphicsApplication.buffer.mappedAtCreation",
            "mapped-at-creation buffers require the forthcoming mapped-range API"
        )
    } else if ((descriptor.usage & bufferUsageStorage) != 0 &&
        !this.capabilities.supports(graphicsFeatureStorageBuffers)) {
        error = GraphicsError(
            graphicsErrorUnsupportedFeature,
            "GraphicsApplication.buffer.usage",
            "storage buffers are unavailable on the selected device"
        )
    } else if ((descriptor.usage & bufferUsageStorage) != 0 &&
        descriptor.size >
            this.capabilities.limits.maximumStorageBufferBytes) {
        error = GraphicsError(
            graphicsErrorLimitExceeded,
            "GraphicsApplication.buffer.size",
            "storage buffer size exceeds the selected device limit"
        )
    } else if (this.backend == graphicsBackendOpenGl) {
        openGl = this.openGl.buffer(descriptor.size)
        if (!openGl.valid()) {
            error = GraphicsError(
                graphicsErrorDriverFailure,
                "OpenGlWindowContext.buffer",
                "OpenGL buffer creation failed"
            )
        }
    } else if (this.backend == graphicsBackendVulkan) {
        vulkan = this.vulkanDevice.buffer(descriptor.size, descriptor.usage)
        if (!vulkan.valid()) {
            error = GraphicsError(
                graphicsErrorDriverFailure,
                "VulkanDevice.buffer",
                "Vulkan buffer creation failed"
            )
        }
    } else {
        error = GraphicsError(
            graphicsErrorBackendUnavailable,
            "GraphicsApplication.buffer",
            "the selected backend cannot create buffers"
        )
    }
    GraphicsBuffer(
        move(openGl),
        move(vulkan),
        descriptor,
        this.backend,
        error
    )
}
