// Reusable contiguous byte storage for GPU uploads and readback.

import "abla/unsafe/memory"
import "core.ab"

// Keep the graphics boundary pointer-typed while delegating to the compiler's
// standard integer-address memcpy intrinsic. This is an ordinary Abla adapter,
// so both the regular and direct LLVM pipelines retain a definition.
trusted noescape fun graphicsUnsafeCopyMemory(
    destination: i64*,
    source: i64*,
    size: int
): void {
    ablaUnsafeCopyMemory(
        nativePointerAddress(destination),
        nativePointerAddress(source),
        size
    )
    return
}

trusted noescape fun graphicsPackedU32(address: i64*, offset: int): int =
    if (pointerIsNull(address) || offset < 0) 0
    else ablaUnsafeLoadU8(ablaUnsafePointerOffset(address, offset)) +
        ablaUnsafeLoadU8(ablaUnsafePointerOffset(address, offset + 1)) * 256 +
        ablaUnsafeLoadU8(ablaUnsafePointerOffset(address, offset + 2)) * 65536 +
        ablaUnsafeLoadU8(ablaUnsafePointerOffset(address, offset + 3)) * 16777216

trusted noescape fun graphicsPackedIndexedDrawCount(
    address: i64*,
    draw: int
): int = graphicsPackedU32(address, draw * 8)

trusted noescape fun graphicsPackedIndexedDrawOffset(
    address: i64*,
    draw: int
): int = graphicsPackedU32(address, draw * 8 + 4)

resource class BufferBytes(
    val storage: NativeByteBuffer,
    val size: int
) {
    fun valid(): bool = this.size > 0 &&
        this.storage.capacity == this.size && !this.storage.closed

    trusted fun load(index: int): int =
        if (this.valid() && index >= 0 && index < this.size)
            this.storage.load(index)
        else -1

    trusted fun store(index: int, value: int): bool =
        this.valid() && value >= 0 && value <= 255 &&
        this.storage.store(index, value)

    trusted fun loadI64(offset: int = 0): int =
        if (this.valid() && offset >= 0 && offset <= this.size - 8)
            this.storage.loadI64(offset)
        else 0

    trusted fun storeI64(value: int, offset: int = 0): bool =
        this.valid() && offset >= 0 && offset <= this.size - 8 &&
        this.storage.storeI64(offset, value)

    trusted fun storeU32(value: int, offset: int = 0): bool =
        this.valid() && value >= 0 && value <= 4294967295 &&
        offset >= 0 && offset <= this.size - 4 &&
        this.storage.store(offset, value & 255) &&
        this.storage.store(offset + 1, (value >>> 8) & 255) &&
        this.storage.store(offset + 2, (value >>> 16) & 255) &&
        this.storage.store(offset + 3, (value >>> 24) & 255)

    trusted fun loadU32(offset: int = 0): int =
        if (this.valid() && offset >= 0 && offset <= this.size - 4)
            this.storage.load(offset) +
            this.storage.load(offset + 1) * 256 +
            this.storage.load(offset + 2) * 65536 +
            this.storage.load(offset + 3) * 16777216
        else 0

    trusted fun loadF32(offset: int = 0): f64 =
        graphicsScalarF32Value(this.loadU32(offset))

    trusted fun storeI32(value: int, offset: int = 0): bool =
        value >= -2147483648 && value <= 2147483647 &&
        this.storeU32(value & 4294967295, offset)

    trusted fun storeF32(value: f64, offset: int = 0): bool {
        val bits = graphicsScalarF32Bits(value)
        this.valid() && offset >= 0 && offset <= this.size - 4 &&
            this.storage.store(offset, bits & 255) &&
            this.storage.store(offset + 1, (bits >>> 8) & 255) &&
            this.storage.store(offset + 2, (bits >>> 16) & 255) &&
            this.storage.store(offset + 3, (bits >>> 24) & 255)
    }

    trusted fun storeF64(value: f64, offset: int = 0): bool =
        this.valid() && offset >= 0 && offset <= this.size - 8 &&
        this.storage.storeI64(offset, f64ToBits(value))

    trusted fun fill(value: int): bool {
        val accepted = this.valid() && value >= 0 && value <= 255
        var index = 0
        while (accepted && index < this.size) {
            this.storage.store(index, value)
            index = index + 1
        }
        accepted
    }
}

trusted fun bufferBytes(size: int): BufferBytes {
    val storage = nativeByteBuffer(if (size > 0) size else 0)
    BufferBytes(move(storage), size)
}
