// Allocation-free synchronous downloads through one coherent mapped ring.

import "core.ab"
import "resources.ab"
import "bytes.ab"
import "application.ab"
import "buffer.ab"
import "upload.ab"

val graphicsMaximumReadbackRingBytes = graphicsMaximumTransferRingBytes

class BufferReadbackRingDescriptor(
    val label: string = "buffer-readback-ring",
    val capacity: int = 1048576,
    val alignment: int = 16
) {
    fun validation(): GraphicsDescriptorValidation {
        var result = graphicsDescriptorValid()
        if (this.capacity <= 0 ||
            this.capacity > graphicsMaximumReadbackRingBytes) {
            result = graphicsDescriptorInvalid(
                "capacity",
                "readback-ring capacity must be between one byte and one GiB"
            )
        } else if (!bufferTransferAlignmentValid(this.alignment) ||
            this.alignment > this.capacity) {
            result = graphicsDescriptorInvalid(
                "alignment",
                "readback-ring alignment must be a power of two no larger than capacity"
            )
        }
        result
    }

    fun valid(): bool = this.capacity > 0 &&
        this.capacity <= graphicsMaximumReadbackRingBytes &&
        bufferTransferAlignmentValid(this.alignment) &&
        this.alignment <= this.capacity
}

resource class GraphicsBufferReadbackRing(
    val staging: GraphicsBuffer,
    val descriptor: BufferReadbackRingDescriptor,
    val backend: int,
    var cursor: int,
    var lastOffset: int,
    var downloadCount: int,
    var wrapCount: int,
    val error: GraphicsError
) {
    trusted fun valid(): bool = !this.error.occurred() &&
        this.descriptor.valid() && this.staging.valid() &&
        this.staging.backend == this.backend &&
        this.staging.descriptor.size == this.descriptor.capacity &&
        (this.staging.descriptor.usage & bufferUsageMapRead) != 0 &&
        this.staging.persistentlyMapped() && this.cursor >= 0 &&
        this.cursor <= this.descriptor.capacity && this.lastOffset >= -1 &&
        this.lastOffset < this.descriptor.capacity &&
        this.downloadCount >= 0 && this.wrapCount >= 0

    fun remainingBytes(): int = if (this.valid())
        this.descriptor.capacity - this.cursor
    else 0

    trusted fun rewind(): bool {
        val succeeded = this.valid()
        if (succeeded) {
            this.cursor = 0
            this.lastOffset = -1
        }
        succeeded
    }

    trusted fun drop(): void {
        this.staging.drop()
        return
    }
}

trusted fun GraphicsApplication.bufferReadbackRing(
    descriptor: BufferReadbackRingDescriptor = BufferReadbackRingDescriptor()
): GraphicsBufferReadbackRing {
    val validation = descriptor.validation()
    val staging = this.buffer(BufferDescriptor(
        label = descriptor.label,
        size = if (validation.succeeded) descriptor.capacity else 0,
        usage = bufferUsageMapRead | bufferUsageCopyDestination,
        mappedAtCreation = true,
        persistentMapping = true
    ))
    var error = GraphicsError()
    if (!this.valid()) error = GraphicsError(
        graphicsErrorInvalidConfiguration,
        "GraphicsApplication.bufferReadbackRing",
        "buffer readback rings require a valid graphics application"
    )
    else if (!validation.succeeded) error = GraphicsError(
        graphicsErrorInvalidConfiguration,
        "GraphicsApplication.bufferReadbackRing.${validation.field}",
        validation.message
    )
    else if (!staging.valid()) error = GraphicsError(
        staging.error.code,
        "GraphicsApplication.bufferReadbackRing",
        staging.error.message
    )
    GraphicsBufferReadbackRing(
        move(staging),
        descriptor,
        this.backend,
        0,
        -1,
        0,
        0,
        error
    )
}

trusted fun GraphicsApplication.downloadBuffer(
    var ring: GraphicsBufferReadbackRing,
    source: GraphicsBuffer,
    var destination: BufferBytes,
    copy: BufferCopyDescriptor = BufferCopyDescriptor()
): bool = this.downloadBufferRange(
    ring,
    source,
    destination,
    copy.sourceOffset,
    copy.destinationOffset,
    copy.size
)

trusted fun GraphicsApplication.downloadBufferRange(
    var ring: GraphicsBufferReadbackRing,
    source: GraphicsBuffer,
    var destination: BufferBytes,
    sourceOffset: int = 0,
    destinationOffset: int = 0,
    size: int = -1
): bool {
    val byteCount = bufferCopyResolvedSize(
        sourceOffset,
        size,
        source.descriptor.size
    )
    var succeeded = this.valid() && ring.valid() && source.valid() &&
        destination.valid() && ring.backend == this.backend &&
        this.ownsBuffer(source) && this.ownsBuffer(ring.staging) &&
        !source.sameResource(ring.staging) &&
        bufferCopyRangeValid(
            sourceOffset,
            destinationOffset,
            size,
            source.descriptor.size,
            destination.size
        ) && byteCount <= ring.descriptor.capacity &&
        bufferUsageAllowsGpuCopySource(source.descriptor.usage)
    var ringOffset = -1
    var wrapped = false
    if (succeeded) {
        ringOffset = bufferTransferAlignedOffset(
            ring.cursor,
            ring.descriptor.alignment
        )
        if (ringOffset < 0 ||
            ringOffset > ring.descriptor.capacity - byteCount) {
            ringOffset = 0
            wrapped = true
        }
        succeeded = ring.downloadCount < graphicsMaximumInt &&
            (!wrapped || ring.wrapCount < graphicsMaximumInt) &&
            this.copyBufferRange(
                source,
                ring.staging,
                sourceOffset,
                ringOffset,
                byteCount
            ) && ring.staging.readMappedRange(
                destination,
                ringOffset,
                destinationOffset,
                byteCount
            )
    }
    if (succeeded) {
        ring.cursor = ringOffset + byteCount
        ring.lastOffset = ringOffset
        ring.downloadCount = ring.downloadCount + 1
        if (wrapped) ring.wrapCount = ring.wrapCount + 1
    }
    succeeded
}
