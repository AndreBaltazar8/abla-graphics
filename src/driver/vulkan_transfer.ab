// Reusable fence-backed asynchronous Vulkan buffer-transfer slots.

import "abla/unsafe/memory"
import "../core.ab"
import "../resources.ab"
import "vulkan.ab"

noescape extern:"c" fun vkGetFenceStatus(
    device: i64*,
    fence: int
): i32

resource class VulkanTransferSlot(
    val device: i64*,
    val queue: i64*,
    var commandPool: int,
    val command: NativePointerCell,
    val scratch: NativeByteBuffer,
    var fence: int,
    var submitted: bool
) {
    trusted fun valid(): bool = !pointerIsNull(this.device) &&
        !pointerIsNull(this.queue) && this.commandPool != 0 &&
        !this.command.closed && !pointerIsNull(this.command.load()) &&
        !this.scratch.closed && this.scratch.capacity >= 216 &&
        this.fence != 0

    trusted fun inFlight(): bool = this.valid() && this.submitted

    trusted fun poll(): bool {
        var completed = this.valid() && !this.submitted
        if (this.valid() && this.submitted) {
            val status = vkGetFenceStatus(this.device, this.fence)
            completed = status == vulkanSuccess
            if (completed) this.submitted = false
        }
        completed
    }

    trusted fun wait(timeoutNanoseconds: int = -1): bool {
        var completed = this.valid() && timeoutNanoseconds >= -1 &&
            !this.submitted
        if (this.valid() && timeoutNanoseconds >= -1 && this.submitted) {
            this.scratch.storeI64(208, this.fence)
            val status = vkWaitForFences(
                this.device,
                1,
                this.scratch.pointerAt(208),
                1,
                timeoutNanoseconds
            )
            completed = status == vulkanSuccess
            if (completed) this.submitted = false
        }
        completed
    }

    trusted fun submitBufferCopy(
        source: VulkanBuffer,
        destination: VulkanBuffer,
        sourceOffset: int,
        destinationOffset: int,
        size: int
    ): bool {
        val byteCount = bufferCopyResolvedSize(
            sourceOffset,
            size,
            source.size
        )
        var succeeded = this.valid() && !this.submitted && source.valid() &&
            destination.valid() && source.device == this.device &&
            destination.device == this.device &&
            bufferCopyRangeValid(
                sourceOffset,
                destinationOffset,
                size,
                source.size,
                destination.size
            ) && vkResetCommandPool(
                this.device,
                this.commandPool,
                0
            ) == vulkanSuccess
        if (succeeded) {
            succeeded = vulkanDriverCommandBufferBeginInfoAt(
                this.scratch, 0, 1
            ) && vkBeginCommandBuffer(
                this.command.load(),
                this.scratch.address
            ) == vulkanSuccess
        }
        if (succeeded) {
            succeeded = vulkanDriverBufferCopyAt(
                this.scratch, 0, sourceOffset, destinationOffset, byteCount
            )
            if (succeeded) vkCmdCopyBuffer(
                    this.command.load(),
                    source.handle,
                    destination.handle,
                    1,
                    this.scratch.address
                )
            succeeded = vulkanDriverMemoryBarrierAt(
                this.scratch, 0, 4096,
                if (destination.persistent) 8192 else 98304
            )
            if (succeeded) vkCmdPipelineBarrier(
                this.command.load(),
                4096,
                if (destination.persistent) 16384 else 65536,
                0,
                1,
                this.scratch.address,
                0,
                nativeNullPointer(),
                0,
                nativeNullPointer()
            )
            succeeded = vkEndCommandBuffer(this.command.load()) ==
                vulkanSuccess
        }
        if (succeeded) {
            this.scratch.storeI64(208, this.fence)
            succeeded = vkResetFences(
                this.device,
                1,
                this.scratch.pointerAt(208)
            ) == vulkanSuccess
        }
        if (succeeded) {
            succeeded = vulkanDriverSubmitInfoAt(
                this.scratch, 64, 1, this.command.address
            ) && vkQueueSubmit(
                this.queue,
                1,
                this.scratch.pointerAt(64),
                this.fence
            ) == vulkanSuccess
            if (succeeded) this.submitted = true
        }
        succeeded
    }

    trusted fun beginTextureTransfer(): bool {
        var succeeded = this.valid() && !this.submitted &&
            vkResetCommandPool(
                this.device,
                this.commandPool,
                0
            ) == vulkanSuccess
        if (succeeded) {
            succeeded = vulkanDriverCommandBufferBeginInfoAt(
                this.scratch, 0, 1
            ) && vkBeginCommandBuffer(
                this.command.load(),
                this.scratch.address
            ) == vulkanSuccess
        }
        succeeded
    }

    trusted fun submitTextureCommands(): bool {
        var succeeded = vkEndCommandBuffer(this.command.load()) ==
            vulkanSuccess
        if (succeeded) {
            this.scratch.storeI64(208, this.fence)
            succeeded = vkResetFences(
                this.device,
                1,
                this.scratch.pointerAt(208)
            ) == vulkanSuccess
        }
        if (succeeded) {
            succeeded = vulkanDriverSubmitInfoAt(
                this.scratch, 128, 1, this.command.address
            ) && vkQueueSubmit(
                this.queue,
                1,
                this.scratch.pointerAt(128),
                this.fence
            ) == vulkanSuccess
            if (succeeded) this.submitted = true
        }
        succeeded
    }

    trusted fun submitTextureUpload(
        staging: VulkanBuffer,
        stagingOffset: int,
        texture: VulkanTexture,
        usage: int,
        mipLevel: int,
        x: int,
        y: int,
        width: int,
        height: int
    ): bool {
        val byteCount = width * height * 4
        var succeeded = staging.valid() && texture.valid() &&
            staging.device == this.device && texture.device == this.device &&
            staging.persistent && staging.mappedWritable() &&
            staging.mappedContains(stagingOffset, byteCount) &&
            mipLevel >= 0 && x >= 0 && y >= 0 && width > 0 && height > 0 &&
            mipLevel * 8 < texture.layouts.capacity &&
            this.beginTextureTransfer()
        var finalLayout = 1
        if (succeeded) {
            val oldLayout = texture.layouts.loadI64(mipLevel * 8)
            vulkanStoreImageBarrier(
                this.scratch.address,
                texture.image,
                oldLayout,
                7,
                if (oldLayout == 0) 0
                else vulkanTextureRestingAccessForUsage(usage, oldLayout),
                4096,
                1,
                mipLevel
            )
            vkCmdPipelineBarrier(
                this.command.load(),
                if (oldLayout == 0) 1 else 65536,
                4096,
                0,
                0,
                nativeNullPointer(),
                0,
                nativeNullPointer(),
                1,
                this.scratch.address
            )
            succeeded = vulkanDriverBufferImageCopyAt(
                this.scratch, 0, stagingOffset, 0, 0,
                1, mipLevel, 0, 1,
                x, y, 0, width, height, 1
            )
            if (succeeded) vkCmdCopyBufferToImage(
                    this.command.load(),
                    staging.handle,
                    texture.image,
                    7,
                    1,
                    this.scratch.address
                )
            finalLayout = if (
                (usage & textureUsageSampled) != 0
            ) 5 else 1
            vulkanStoreImageBarrier(
                this.scratch.address,
                texture.image,
                7,
                finalLayout,
                4096,
                vulkanTextureRestingAccessForUsage(usage, finalLayout),
                1,
                mipLevel
            )
            vkCmdPipelineBarrier(
                this.command.load(),
                4096,
                65536,
                0,
                0,
                nativeNullPointer(),
                0,
                nativeNullPointer(),
                1,
                this.scratch.address
            )
            succeeded = this.submitTextureCommands()
            if (succeeded) texture.storeLayout(mipLevel, finalLayout)
        }
        succeeded
    }

    trusted fun submitTextureReadback(
        texture: VulkanTexture,
        usage: int,
        mipLevel: int,
        x: int,
        y: int,
        width: int,
        height: int,
        staging: VulkanBuffer,
        stagingOffset: int
    ): bool {
        val byteCount = width * height * 4
        var succeeded = texture.valid() && staging.valid() &&
            texture.device == this.device && staging.device == this.device &&
            staging.persistent && staging.mappedReadable() &&
            staging.mappedContains(stagingOffset, byteCount) &&
            mipLevel >= 0 && x >= 0 && y >= 0 && width > 0 && height > 0 &&
            mipLevel * 8 < texture.layouts.capacity &&
            this.beginTextureTransfer()
        var finalLayout = 1
        if (succeeded) {
            val oldLayout = texture.layouts.loadI64(mipLevel * 8)
            finalLayout = if (oldLayout != 0) oldLayout
                else if ((usage & textureUsageSampled) != 0) 5
                else 1
            vulkanStoreImageBarrier(
                this.scratch.address,
                texture.image,
                oldLayout,
                6,
                if (oldLayout == 0) 0
                else vulkanTextureRestingAccessForUsage(usage, oldLayout),
                2048,
                1,
                mipLevel
            )
            vkCmdPipelineBarrier(
                this.command.load(),
                if (oldLayout == 0) 1 else 65536,
                4096,
                0,
                0,
                nativeNullPointer(),
                0,
                nativeNullPointer(),
                1,
                this.scratch.address
            )
            succeeded = vulkanDriverBufferImageCopyAt(
                this.scratch, 0, stagingOffset, 0, 0,
                1, mipLevel, 0, 1,
                x, y, 0, width, height, 1
            )
            if (succeeded) vkCmdCopyImageToBuffer(
                    this.command.load(),
                    texture.image,
                    6,
                    staging.handle,
                    1,
                    this.scratch.address
                )
            vulkanStoreImageBarrier(
                this.scratch.address,
                texture.image,
                6,
                finalLayout,
                2048,
                vulkanTextureRestingAccessForUsage(usage, finalLayout),
                1,
                mipLevel
            )
            vkCmdPipelineBarrier(
                this.command.load(),
                4096,
                65536,
                0,
                0,
                nativeNullPointer(),
                0,
                nativeNullPointer(),
                1,
                this.scratch.address
            )
            succeeded = vulkanDriverMemoryBarrierAt(
                this.scratch, 0, 4096, 8192
            )
            if (succeeded) vkCmdPipelineBarrier(
                this.command.load(),
                4096,
                16384,
                0,
                1,
                this.scratch.address,
                0,
                nativeNullPointer(),
                0,
                nativeNullPointer()
            )
            succeeded = this.submitTextureCommands()
            if (succeeded) texture.storeLayout(mipLevel, finalLayout)
        }
        succeeded
    }

    trusted fun submitTextureBytesTransfer(
        staging: VulkanBuffer,
        stagingOffset: int,
        texture: VulkanTexture,
        descriptor: TextureDescriptor,
        mipLevel: int,
        x: int,
        y: int,
        z: int,
        width: int,
        height: int,
        depth: int,
        upload: bool
    ): bool {
        val byteCount = textureDataRequiredBytesRange(
            descriptor,
            width,
            height,
            depth
        )
        val requiredUsage = if (upload) textureUsageCopyDestination
            else textureUsageCopySource
        var succeeded = staging.valid() && texture.valid() &&
            staging.device == this.device && texture.device == this.device &&
            staging.persistent &&
            ((upload && staging.mappedWritable()) ||
             (!upload && staging.mappedReadable())) &&
            byteCount > 0 && staging.mappedContains(stagingOffset, byteCount) &&
            !textureFormatHasDepth(descriptor.format) &&
            textureRegionRangeValid(
                descriptor,
                mipLevel,
                x,
                y,
                z,
                width,
                height,
                depth,
                requiredUsage
            ) && this.beginTextureTransfer()
        val arrayed = textureDimensionArrayed(descriptor.dimension)
        val baseArrayLayer = if (arrayed) z else 0
        val arrayLayers = if (arrayed) depth else 1
        val transferLayout = if (upload) 7 else 6
        val transferAccess = if (upload) 4096 else 2048
        val defaultFinalLayout = if (
            (descriptor.usage & textureUsageSampled) != 0
        )
            5 else 1
        var layer = 0
        while (succeeded && layer < arrayLayers) {
            val selectedLayer = baseArrayLayer + layer
            val oldLayout = texture.loadLayout(
                descriptor,
                mipLevel,
                selectedLayer
            )
            succeeded = oldLayout >= 0
            if (succeeded) {
                vulkanStoreImageBarrier(
                    this.scratch.address,
                    texture.image,
                    oldLayout,
                    transferLayout,
                    if (oldLayout == 0) 0
                    else vulkanTextureRestingAccess(descriptor, oldLayout),
                    transferAccess,
                    1,
                    mipLevel,
                    1,
                    selectedLayer,
                    1
                )
                vkCmdPipelineBarrier(
                    this.command.load(),
                    if (oldLayout == 0) 1 else 65536,
                    4096,
                    0,
                    0,
                    nativeNullPointer(),
                    0,
                    nativeNullPointer(),
                    1,
                    this.scratch.address
                )
            }
            layer = layer + 1
        }
        if (succeeded) {
            val imageZ = if (descriptor.dimension == textureDimension3D) z
                else 0
            val imageDepth = if (
                descriptor.dimension == textureDimension3D
            ) depth else 1
            succeeded = vulkanDriverBufferImageCopyAt(
                this.scratch, 0, stagingOffset, 0, 0,
                vulkanTextureAspect(descriptor.format, textureAspectAll),
                mipLevel, baseArrayLayer, arrayLayers,
                x, y, imageZ, width, height, imageDepth
            )
            if (succeeded && upload) vkCmdCopyBufferToImage(
                this.command.load(),
                staging.handle,
                texture.image,
                transferLayout,
                1,
                this.scratch.address
            )
            else if (succeeded) vkCmdCopyImageToBuffer(
                this.command.load(),
                texture.image,
                transferLayout,
                staging.handle,
                1,
                this.scratch.address
            )
        }
        layer = 0
        while (succeeded && layer < arrayLayers) {
            val selectedLayer = baseArrayLayer + layer
            val oldLayout = texture.loadLayout(
                descriptor,
                mipLevel,
                selectedLayer
            )
            val finalLayout = if (!upload && oldLayout > 0) oldLayout
                else defaultFinalLayout
            succeeded = oldLayout >= 0
            if (succeeded) {
                vulkanStoreImageBarrier(
                    this.scratch.address,
                    texture.image,
                    transferLayout,
                    finalLayout,
                    transferAccess,
                    vulkanTextureRestingAccess(descriptor, finalLayout),
                    1,
                    mipLevel,
                    1,
                    selectedLayer,
                    1
                )
                vkCmdPipelineBarrier(
                    this.command.load(),
                    4096,
                    65536,
                    0,
                    0,
                    nativeNullPointer(),
                    0,
                    nativeNullPointer(),
                    1,
                    this.scratch.address
                )
            }
            layer = layer + 1
        }
        if (succeeded && !upload) {
            succeeded = vulkanDriverMemoryBarrierAt(
                this.scratch, 0, 4096, 8192
            )
            if (succeeded) vkCmdPipelineBarrier(
                this.command.load(),
                4096,
                16384,
                0,
                1,
                this.scratch.address,
                0,
                nativeNullPointer(),
                0,
                nativeNullPointer()
            )
        }
        if (succeeded) succeeded = this.submitTextureCommands()
        if (succeeded) {
            layer = 0
            while (layer < arrayLayers) {
                val selectedLayer = baseArrayLayer + layer
                val oldLayout = texture.loadLayout(
                    descriptor,
                    mipLevel,
                    selectedLayer
                )
                val finalLayout = if (!upload && oldLayout > 0) oldLayout
                    else defaultFinalLayout
                texture.storeSubresourceLayout(
                    descriptor,
                    mipLevel,
                    selectedLayer,
                    finalLayout
                )
                layer = layer + 1
            }
        }
        succeeded
    }

    trusted fun submitTextureBytesUpload(
        staging: VulkanBuffer,
        stagingOffset: int,
        texture: VulkanTexture,
        descriptor: TextureDescriptor,
        mipLevel: int,
        x: int,
        y: int,
        z: int,
        width: int,
        height: int,
        depth: int
    ): bool = this.submitTextureBytesTransfer(
        staging, stagingOffset, texture, descriptor,
        mipLevel, x, y, z, width, height, depth, true
    )

    trusted fun submitTextureBytesReadback(
        texture: VulkanTexture,
        descriptor: TextureDescriptor,
        mipLevel: int,
        x: int,
        y: int,
        z: int,
        width: int,
        height: int,
        depth: int,
        staging: VulkanBuffer,
        stagingOffset: int
    ): bool = this.submitTextureBytesTransfer(
        staging, stagingOffset, texture, descriptor,
        mipLevel, x, y, z, width, height, depth, false
    )

    trusted fun drop(): void {
        if (this.submitted) {
            val completed = this.wait(-1)
        }
        if (this.fence != 0 && !pointerIsNull(this.device)) {
            vkDestroyFence(this.device, this.fence, nativeNullPointer())
            this.fence = 0
        }
        if (this.commandPool != 0 && !pointerIsNull(this.device)) {
            vkDestroyCommandPool(
                this.device,
                this.commandPool,
                nativeNullPointer()
            )
            this.commandPool = 0
            this.command.store(nativeNullPointer())
        }
        this.command.close()
        this.scratch.close()
        this.submitted = false
        return
    }
}

trusted fun VulkanDevice.transferSlot(): VulkanTransferSlot {
    var commandPool = 0
    val command = nativePointerCell(nativeNullPointer())
    val scratch = nativeByteBuffer(216)
    var fence = 0
    var succeeded = this.valid()
    if (succeeded) {
        succeeded = vulkanDriverCommandPoolCreateInfoAt(
            scratch, 0, this.queueFamily, 2
        ) && vkCreateCommandPool(
            this.handle,
            scratch.address,
            nativeNullPointer(),
            scratch.pointerAt(208)
        ) == vulkanSuccess
        if (succeeded) commandPool = scratch.loadI64(208)
    }
    if (succeeded) {
        succeeded = vulkanDriverCommandBufferAllocateInfoAt(
            scratch, 0, commandPool, 1
        ) && vkAllocateCommandBuffers(
            this.handle,
            scratch.address,
            command.address
        ) == vulkanSuccess
    }
    if (succeeded) {
        succeeded = vulkanDriverFenceCreateInfoAt(
            scratch, 0
        ) && vkCreateFence(
            this.handle,
            scratch.address,
            nativeNullPointer(),
            scratch.pointerAt(208)
        ) == vulkanSuccess
        if (succeeded) fence = scratch.loadI64(208)
    }
    if (!succeeded) {
        if (fence != 0) vkDestroyFence(
            this.handle,
            fence,
            nativeNullPointer()
        )
        if (commandPool != 0) vkDestroyCommandPool(
            this.handle,
            commandPool,
            nativeNullPointer()
        )
        commandPool = 0
        fence = 0
        command.store(nativeNullPointer())
    }
    VulkanTransferSlot(
        this.handle,
        this.queue,
        commandPool,
        move(command),
        move(scratch),
        fence,
        false
    )
}
