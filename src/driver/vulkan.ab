        this.stageFlags > 0 &&
        ((this.descriptorType == 1 &&
          (this.handle != 0 || this.view != 0) && this.sampler != 0 &&
          this.offset == 0 && this.size == 0 && this.texture.valid() &&
          (this.texture.usage & textureUsageSampled) != 0 &&
          (this.imageLayout == 1 || this.imageLayout == 5)) ||
         (this.descriptorType == 3 &&
          (this.handle != 0 || this.view != 0) && this.sampler == 0 &&
          this.offset == 0 && this.size == 0 && this.texture.valid() &&
          (this.texture.usage & textureUsageStorage) != 0 &&
          this.texture.samples == 1 &&
          !textureFormatHasDepth(this.texture.format) &&
          this.imageLayout == 1) ||
         ((this.descriptorType == 6 || this.descriptorType == 7) &&
          this.handle != 0 && this.view == 0 && this.sampler == 0 &&
          this.offset >= 0 && this.size > 0))
