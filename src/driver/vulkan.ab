            index = index + 1
        }
        return
    }
}

trusted fun VulkanDevice.sampler(
    descriptor: SamplerDescriptor
): VulkanSampler {
    var handle = 0
    var capabilities = GraphicsCapabilities()
    if (this.valid()) {
        capabilities = VulkanAdapter(
            this.physicalDevice,
            "",
            this.apiVersion,
            0,
            0,
            0,
            0
        ).capabilities()
    }
    if (this.valid() && descriptor.valid() &&
        graphicsSamplerAnisotropySupported(
            capabilities,
            descriptor.maximumAnisotropy
        )) {
        var compareEnable = 0
        var compareOperation = 0
        if (descriptor.compare != compareFunctionUndefined) {
            compareEnable = 1
            compareOperation = descriptor.compare - 1
        }
        val createInfo = nativeByteBuffer(vulkanDriverSizeVkSamplerCreateInfo)
        val packed = vulkanDriverSamplerCreateInfoAt(
            createInfo, 0, descriptor.magFilter, descriptor.minFilter,
            descriptor.mipmapFilter,
            vulkanSamplerAddress(descriptor.addressU),
            vulkanSamplerAddress(descriptor.addressV),
            vulkanSamplerAddress(descriptor.addressW),
            if (descriptor.maximumAnisotropy > 1) 1 else 0,
            graphicsUnsignedIntegerF32Bits(descriptor.maximumAnisotropy),
            compareEnable, compareOperation,
            graphicsUnsignedIntegerF32Bits(descriptor.lodMinimum),
            graphicsUnsignedIntegerF32Bits(descriptor.lodMaximum)
        )
        val output = nativeI64Cell(0)
        if (packed && vkCreateSampler(
            this.handle,
            createInfo.address,
            nativeNullPointer(),
            output.address
        ) == vulkanSuccess) handle = output.load()
    }
    VulkanSampler(this.handle, handle)
}

