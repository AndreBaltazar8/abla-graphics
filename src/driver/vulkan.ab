trusted fun VulkanDevice.presentBlue(
    swapchain: VulkanSwapchain
): bool = this.presentClear(
    swapchain,
    Color(
        graphicsScalar(3, 20),
        graphicsScalar(9, 20),
        graphicsScalar(17, 20)
    )
)

