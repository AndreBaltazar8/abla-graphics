fun vulkanVersionMajor(version: int): int = (version >>> 22) & 127
fun vulkanVersionMinor(version: int): int = (version >>> 12) & 1023
fun vulkanVersionPatch(version: int): int = version & 4095

trusted fun vulkanLoaderVersion(): int {
    val output = nativeI64Cell(0)
    val status = vkEnumerateInstanceVersion(output.address)
    if (status == vulkanSuccess) output.load() & 4294967295
    else vulkanApiVersion10
}

trusted fun vulkanBufferPointer(
    buffer: NativeByteBuffer,
    offset: int
): i64* = NativePointerCell(buffer.pointerAt(offset), false, false).load()

trusted fun vulkanCopyCString(
    source: NativeByteBuffer,
    offset: int,
    maximum: int
): string {
    var length = 0
    while (length < maximum && source.load(offset + length) != 0) {
        length = length + 1
    }
    val output = nativeByteBuffer(length + 1)
    var index = 0
    while (index < length) {
        output.store(index, source.load(offset + index))
        index = index + 1
    }
    output.store(length, 0)
    output.adoptString(length)
}

trusted fun vulkanApplicationInfo(
    name: string,
    requestedVersion: int
): NativeByteBuffer {
    val info = nativeByteBuffer(48)
    info.storeI64(0, vulkanStructureApplicationInfo)
    info.storePointer(8, nativeNullPointer())
    info.storePointer(
        16,
        nativePointerFromAddress(nativeCStringAddress(name))
    )
    info.storeI64(24, 1)
    info.storePointer(
        32,
        nativePointerFromAddress(nativeCStringAddress("abla-graphics"))
    )
    info.storeI64(
        40,
        (requestedVersion & 4294967295) * 4294967296 + 1
    )
    info
}

trusted fun vulkanInstanceCreateInfo(
    application: NativeByteBuffer
): NativeByteBuffer {
    val info = nativeByteBuffer(64)
    info.storeI64(0, vulkanStructureInstanceCreateInfo)
    info.storePointer(8, nativeNullPointer())
    info.storeI64(16, 0)
    info.storePointer(24, application.address)
    info.storeI64(32, 0)
    info.storePointer(40, nativeNullPointer())
    info.storeI64(48, 0)
    info.storePointer(56, nativeNullPointer())
    info
}

trusted fun vulkanX11InstanceCreateInfo(
    application: NativeByteBuffer,
    extensions: NativeByteBuffer
): NativeByteBuffer {
    val info = vulkanInstanceCreateInfo(application)
    info.storeI64(48, 2)
    info.storePointer(56, extensions.address)
    info
}

resource class VulkanInstance(var handle: i64*, val apiVersion: int) {
    trusted fun valid(): bool = !pointerIsNull(this.handle)

    trusted fun drop(): void {
        if (this.valid()) {
            vkDestroyInstance(this.handle, nativeNullPointer())
            this.handle = nativeNullPointer()
        }
        return
    }
}

trusted fun vulkanInstance(
    applicationName: string = "Abla Graphics",
    requestedVersion: int = vulkanApiVersion14
): VulkanInstance {
    val loaderVersion = vulkanLoaderVersion()
    var selectedVersion = requestedVersion
    if (selectedVersion > loaderVersion) selectedVersion = loaderVersion
    if (selectedVersion < vulkanApiVersion10) {
        selectedVersion = vulkanApiVersion10
    }
    val application = vulkanApplicationInfo(
        applicationName,
        selectedVersion
    )
    val createInfo = vulkanInstanceCreateInfo(application)
    val output = nativePointerCell(nativeNullPointer())
    val status = vkCreateInstance(
        createInfo.address,
        nativeNullPointer(),
        output.address
    )
    val handle = if (status == vulkanSuccess)
        output.load()
    else nativeNullPointer()
    VulkanInstance(handle, selectedVersion)
}

trusted fun vulkanX11Instance(
    applicationName: string = "Abla Graphics",
    requestedVersion: int = vulkanApiVersion14
): VulkanInstance {
    val loaderVersion = vulkanLoaderVersion()
    var selectedVersion = requestedVersion
    if (selectedVersion > loaderVersion) selectedVersion = loaderVersion
    if (selectedVersion < vulkanApiVersion10) {
        selectedVersion = vulkanApiVersion10
    }
    val application = vulkanApplicationInfo(
        applicationName,
        selectedVersion
    )
    val extensions = nativeByteBuffer(16)
    extensions.storePointer(
        0,
        nativePointerFromAddress(nativeCStringAddress("VK_KHR_surface"))
    )
    extensions.storePointer(
        8,
        nativePointerFromAddress(nativeCStringAddress("VK_KHR_xlib_surface"))
    )
    val createInfo = vulkanX11InstanceCreateInfo(application, extensions)
    val output = nativePointerCell(nativeNullPointer())
    val status = vkCreateInstance(
        createInfo.address,
        nativeNullPointer(),
        output.address
    )
    val handle = if (status == vulkanSuccess)
        output.load()
    else nativeNullPointer()
    VulkanInstance(handle, selectedVersion)
}

resource class VulkanX11Surface(
    var handle: int,
    var nativeDisplay: i64*,
    var instance: i64*,
    val visual: int,
    val width: int,
    val height: int
) {
    trusted fun valid(): bool =
        this.handle != 0 &&
        !pointerIsNull(this.nativeDisplay) &&
        !pointerIsNull(this.instance)

    trusted fun drop(): void {
        if (this.handle != 0 && !pointerIsNull(this.instance)) {
            vkDestroySurfaceKHR(
                this.instance,
                this.handle,
                nativeNullPointer()
            )
        }
        if (!pointerIsNull(this.nativeDisplay)) {
            XCloseDisplay(this.nativeDisplay)
        }
        this.handle = 0
        this.nativeDisplay = nativeNullPointer()
        this.instance = nativeNullPointer()
        return
    }
}

trusted fun vulkanX11Surface(
    instance: VulkanInstance,
    window: X11Window
): VulkanX11Surface {
    var nativeDisplay = nativeNullPointer()
    var surface = 0
    if (instance.valid() && window.valid() && window.visual != 0) {
        nativeDisplay = XOpenDisplay(nativeNullPointer())
    }
    if (!pointerIsNull(nativeDisplay)) {
        val createInfo = nativeByteBuffer(40)
        createInfo.storeI64(0, 1000004000)
        createInfo.storePointer(8, nativeNullPointer())
        createInfo.storeI64(16, 0)
        createInfo.storePointer(24, nativeDisplay)
        createInfo.storeI64(32, window.identifier)
        val output = nativeI64Cell(0)
        if (vkCreateXlibSurfaceKHR(
            instance.handle,
            createInfo.address,
            nativeNullPointer(),
            output.address
        ) == vulkanSuccess) {
            surface = output.load()
        }
    }
    if (surface == 0 && !pointerIsNull(nativeDisplay)) {
        XCloseDisplay(nativeDisplay)
        nativeDisplay = nativeNullPointer()
    }
    VulkanX11Surface(
        surface,
        nativeDisplay,
        instance.handle,
        window.visual,
        window.width,
        window.height
    )
}

class VulkanSurfaceCapabilities(
    val valid: bool,
    val minimumImages: int,
    val maximumImages: int,
    val width: int,
    val height: int,
    val supportedUsage: int,
    val currentTransform: int,
    val supportedCompositeAlpha: int
)

trusted fun VulkanAdapter.supportsSurface(
    surface: VulkanX11Surface,
    queueFamily: int = this.graphicsQueueFamily()
): bool {
    var supported = false
    var xlibSupported = 0
    if (surface.valid() && queueFamily >= 0) {
        xlibSupported = vkGetPhysicalDeviceXlibPresentationSupportKHR(
            this.handle,
            queueFamily,
            surface.nativeDisplay,
            surface.visual
        )
    }
    if (surface.valid() && queueFamily >= 0 && xlibSupported != 0) {
        val output = nativeI64Cell(0)
        supported = vkGetPhysicalDeviceSurfaceSupportKHR(
            this.handle,
            queueFamily,
            surface.handle,
            output.address
        ) == vulkanSuccess && (output.load() & 4294967295) != 0
    }
    supported
}

trusted fun VulkanAdapter.surfaceCapabilities(
    surface: VulkanX11Surface
): VulkanSurfaceCapabilities {
    val bytes = nativeByteBuffer(64)
    var status = -1
    if (surface.valid()) {
        status = vkGetPhysicalDeviceSurfaceCapabilitiesKHR(
            this.handle,
            surface.handle,
            bytes.address
        )
    }
    VulkanSurfaceCapabilities(
        status == vulkanSuccess,
        bytes.loadI64(0) & 4294967295,
        (bytes.loadI64(0) >>> 32) & 4294967295,
        bytes.loadI64(8) & 4294967295,
        (bytes.loadI64(8) >>> 32) & 4294967295,
        bytes.loadI64(48) & 4294967295,
        bytes.loadI64(40) & 4294967295,
        (bytes.loadI64(40) >>> 32) & 4294967295
    )
}

class VulkanAdapter(
    val handle: i64*,
    val name: string,
    val apiVersion: int,
    val driverVersion: int,
    val vendor: int,
    val device: int,
    val kind: int
)

trusted fun VulkanInstance.adapters(): array<VulkanAdapter> {
    val result: array<VulkanAdapter> = []
    if (this.valid()) {
        val count = nativeI64Cell(0)
        var status = vkEnumeratePhysicalDevices(
            this.handle,
            count.address,
            nativeNullPointer()
        )
        var measured = count.load() & 4294967295
        if (measured > 256) measured = 0
        if (status == vulkanSuccess && measured > 0) {
            val handles = nativeByteBuffer(measured * 8)
            status = vkEnumeratePhysicalDevices(
                this.handle,
                count.address,
                handles.address
            )
            measured = count.load() & 4294967295
            var index = 0
            while (status == vulkanSuccess && index < measured) {
                val handle = vulkanBufferPointer(handles, index * 8)
                val properties = nativeByteBuffer(1024)
                vkGetPhysicalDeviceProperties(
                    handle,
                    properties.address
                )
                result.append(VulkanAdapter(
                    handle,
                    vulkanCopyCString(properties, 20, 256),
                    properties.loadI64(0) & 4294967295,
                    (properties.loadI64(0) >>> 32) & 4294967295,
                    properties.loadI64(8) & 4294967295,
                    (properties.loadI64(8) >>> 32) & 4294967295,
                    properties.loadI64(16) & 4294967295
                ))
                index = index + 1
            }
        }
    }
    result
}

trusted fun VulkanAdapter.graphicsQueueFamily(): int {
    val count = nativeI64Cell(0)
    vkGetPhysicalDeviceQueueFamilyProperties(
        this.handle,
        count.address,
        nativeNullPointer()
    )
    var measured = count.load() & 4294967295
    if (measured > 256) measured = 0
    var selected = -1
    if (measured > 0) {
        val properties = nativeByteBuffer(measured * 24)
        vkGetPhysicalDeviceQueueFamilyProperties(
            this.handle,
            count.address,
            properties.address
        )
        measured = count.load() & 4294967295
        var index = 0
        while (selected < 0 && index < measured) {
            val flags = properties.loadI64(index * 24) & 4294967295
            val queues =
                (properties.loadI64(index * 24) >>> 32) & 4294967295
            if ((flags & 1) != 0 && queues > 0) selected = index
            index = index + 1
        }
    }
    selected
}

resource class VulkanDevice(
    var handle: i64*,
    var queue: i64*,
    val queueFamily: int,
    val apiVersion: int,
    val physicalDevice: i64*
) {
    trusted fun valid(): bool =
        !pointerIsNull(this.handle) && !pointerIsNull(this.queue)

    trusted fun waitIdle(): bool =
        this.valid() && vkDeviceWaitIdle(this.handle) == vulkanSuccess

    trusted fun drop(): void {
        if (!pointerIsNull(this.handle)) {
            vkDeviceWaitIdle(this.handle)
            vkDestroyDevice(this.handle, nativeNullPointer())
            this.handle = nativeNullPointer()
            this.queue = nativeNullPointer()
        }
        return
    }
}

trusted fun VulkanAdapter.device(): VulkanDevice {
    val queueFamily = this.graphicsQueueFamily()
    var handle = nativeNullPointer()
    var queue = nativeNullPointer()
    if (queueFamily >= 0) {
        val priority = nativeByteBuffer(8)
        priority.storeI64(0, 1065353216)
        val queueInfo = nativeByteBuffer(40)
        queueInfo.storeI64(0, 2)
        queueInfo.storePointer(8, nativeNullPointer())
        queueInfo.storeI64(
            16,
            (queueFamily & 4294967295) * 4294967296
        )
        queueInfo.storeI64(24, 1)
        queueInfo.storePointer(32, priority.address)

        val createInfo = nativeByteBuffer(72)
        createInfo.storeI64(0, 3)
        createInfo.storePointer(8, nativeNullPointer())
        createInfo.storeI64(16, 4294967296)
        createInfo.storePointer(24, queueInfo.address)
        createInfo.storeI64(32, 0)
        createInfo.storePointer(40, nativeNullPointer())
        createInfo.storeI64(48, 0)
        createInfo.storePointer(56, nativeNullPointer())
        createInfo.storePointer(64, nativeNullPointer())

        val output = nativePointerCell(nativeNullPointer())
        val status = vkCreateDevice(
            this.handle,
            createInfo.address,
            nativeNullPointer(),
            output.address
        )
        if (status == vulkanSuccess) {
            handle = output.load()
            val queueOutput = nativePointerCell(nativeNullPointer())
            vkGetDeviceQueue(
                handle,
                queueFamily,
                0,
                queueOutput.address
            )
            queue = queueOutput.load()
        }
    }
    VulkanDevice(
        handle,
        queue,
        queueFamily,
        this.apiVersion,
        this.handle
    )
}

resource class VulkanBuffer(
    val device: i64*,
    val physicalDevice: i64*,
    val queue: i64*,
    val queueFamily: int,
    var handle: int,
    var memory: int,
    val size: int
) {
    fun valid(): bool =
        this.handle != 0 && this.memory != 0 && this.size > 0

    trusted fun readI64(offset: int = 0): int {
        var result = 0
        if (this.valid() && offset >= 0 && offset + 8 <= this.size) {
            val mapped = nativePointerCell(nativeNullPointer())
            if (vkMapMemory(
                this.device,
                this.memory,
                offset,
                8,
                0,
                mapped.address
            ) == vulkanSuccess) {
                result = ablaUnsafeLoadI64(mapped.load())
                vkUnmapMemory(this.device, this.memory)
            }
        }
        result
    }

    trusted fun writeI64(value: int, offset: int = 0): bool {
        var succeeded = false
        if (this.valid() && offset >= 0 && offset + 8 <= this.size) {
            val mapped = nativePointerCell(nativeNullPointer())
            if (vkMapMemory(
                this.device,
                this.memory,
                offset,
                8,
                0,
                mapped.address
            ) == vulkanSuccess) {
                ablaUnsafeStoreI64(mapped.load(), value)
                vkUnmapMemory(this.device, this.memory)
                succeeded = true
            }
        }
        succeeded
    }

    trusted fun writePixels(
        pixels: PixelBuffer,
        format: int
    ): bool {
        val required = pixels.width * pixels.height * 4
        var succeeded = this.valid() && pixels.valid() &&
            required == this.size &&
            (format == 37 || format == 43 || format == 44 || format == 50)
        val mapped = nativePointerCell(nativeNullPointer())
        if (succeeded) {
            succeeded = vkMapMemory(
                this.device,
                this.memory,
                0,
                required,
                0,
                mapped.address
            ) == vulkanSuccess
        }
        val destination = mapped.load()
        var pixel = 0
        val swapRedBlue = format == 44 || format == 50
        while (succeeded && pixel < pixels.width * pixels.height) {
            val offset = pixel * 4
            val red = pixels.storage.load(offset)
            val green = pixels.storage.load(offset + 1)
            val blue = pixels.storage.load(offset + 2)
            val alpha = pixels.storage.load(offset + 3)
            ablaUnsafeStoreU8(
                ablaUnsafePointerOffset(destination, offset),
                if (swapRedBlue) blue else red
            )
            ablaUnsafeStoreU8(
                ablaUnsafePointerOffset(destination, offset + 1),
                green
            )
            ablaUnsafeStoreU8(
                ablaUnsafePointerOffset(destination, offset + 2),
                if (swapRedBlue) red else blue
            )
            ablaUnsafeStoreU8(
                ablaUnsafePointerOffset(destination, offset + 3),
                alpha
            )
            pixel = pixel + 1
        }
        if (!pointerIsNull(mapped.load())) {
            vkUnmapMemory(this.device, this.memory)
        }
        succeeded
    }

    trusted fun fill(value: int): bool {
        var succeeded = this.valid() &&
            this.size - this.size / 4 * 4 == 0
        val pool = nativeI64Cell(0)
        val command = nativePointerCell(nativeNullPointer())
        if (succeeded) {
            val poolInfo = nativeByteBuffer(24)
            poolInfo.storeI64(0, 39)
            poolInfo.storePointer(8, nativeNullPointer())
            poolInfo.storeI64(
                16,
                (this.queueFamily & 4294967295) * 4294967296 + 1
            )
            succeeded = vkCreateCommandPool(
                this.device,
                poolInfo.address,
                nativeNullPointer(),
                pool.address
            ) == vulkanSuccess
        }
        if (succeeded) {
            val allocateInfo = nativeByteBuffer(32)
            allocateInfo.storeI64(0, 40)
            allocateInfo.storePointer(8, nativeNullPointer())
            allocateInfo.storeI64(16, pool.load())
            allocateInfo.storeI64(24, 4294967296)
            succeeded = vkAllocateCommandBuffers(
                this.device,
                allocateInfo.address,
                command.address
            ) == vulkanSuccess
        }
        if (succeeded) {
            val beginInfo = nativeByteBuffer(32)
            beginInfo.storeI64(0, 42)
            beginInfo.storePointer(8, nativeNullPointer())
            beginInfo.storeI64(16, 1)
            beginInfo.storePointer(24, nativeNullPointer())
            succeeded = vkBeginCommandBuffer(
                command.load(),
                beginInfo.address
            ) == vulkanSuccess
        }
        if (succeeded) {
            vkCmdFillBuffer(
                command.load(),
                this.handle,
                0,
                this.size,
                value
            )
            val barrier = nativeByteBuffer(24)
            barrier.storeI64(0, 46)
            barrier.storePointer(8, nativeNullPointer())
            barrier.storeI64(16, 8192 * 4294967296 + 4096)
            vkCmdPipelineBarrier(
                command.load(),
                4096,
                16384,
                0,
                1,
                barrier.address,
                0,
                nativeNullPointer(),
                0,
                nativeNullPointer()
            )
            succeeded =
