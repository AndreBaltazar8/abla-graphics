    var succeeded = framesInFlight >= 1 && framesInFlight <= 8
    while (succeeded && index < framesInFlight) {
        val frame = this.pixelFrame(size)
        succeeded = frame.valid()
        frames.append(move(frame))
        index = index + 1
    }
    index = 0
    while (succeeded && index < swapchain.images.size) {
        val semaphore = nativeI64Cell(0)
        succeeded = vkCreateSemaphore(
            this.handle,
            semaphoreInfo.address,
            nativeNullPointer(),
            semaphore.address
        ) == vulkanSuccess
        if (succeeded) rendered.append(semaphore.load())
        index = index + 1
    }
    VulkanPixelPresenter(
        move(frames),
        rendered,
        swapchain.images.size,
        0,
        swapchain.width,
        swapchain.height,
        swapchain.format
    )
}

trusted fun VulkanAdapter.deviceForSurface(
    surface: VulkanX11Surface
): VulkanDevice {
    val queueFamily = this.graphicsQueueFamily()
    var handle = nativeNullPointer()
    var queue = nativeNullPointer()
    if (queueFamily >= 0 && this.supportsSurface(surface, queueFamily)) {
        val enabledFeatures = this.enabledDeviceFeatures()
        val priority = nativeByteBuffer(8)
        priority.storeI64(0, 1065353216)
        val queueInfo = nativeByteBuffer(40)
        queueInfo.storeI64(0, 2)
        queueInfo.storePointer(8, nativeNullPointer())
        queueInfo.storeI64(
            16,
            (queueFamily & 4294967295) * 4294967296
        )
        queueInfo.storeI64(24, 1)
        queueInfo.storePointer(32, priority.address)

        val extensionNames = nativeByteBuffer(8)
        extensionNames.storePointer(
            0,
            nativePointerFromAddress(
                nativeCStringAddress("VK_KHR_swapchain")
            )
        )
        val createInfo = nativeByteBuffer(72)
        createInfo.storeI64(0, 3)
        createInfo.storePointer(8, nativeNullPointer())
        createInfo.storeI64(16, 4294967296)
        createInfo.storePointer(24, queueInfo.address)
        createInfo.storeI64(32, 0)
        createInfo.storePointer(40, nativeNullPointer())
        createInfo.storeI64(48, 1)
        createInfo.storePointer(56, extensionNames.address)
        createInfo.storePointer(64, enabledFeatures.address)

        val output = nativePointerCell(nativeNullPointer())
        if (vkCreateDevice(
            this.handle,
            createInfo.address,
            nativeNullPointer(),
            output.address
        ) == vulkanSuccess) {
            handle = output.load()
            val queueOutput = nativePointerCell(nativeNullPointer())
            vkGetDeviceQueue(
                handle,
                queueFamily,
                0,
                queueOutput.address
            )
            queue = queueOutput.load()
        }
    }
    val result = VulkanDevice(
        handle,
        queue,
        queueFamily,
        this.apiVersion,
        this.handle,
        0,
        nativePointerCell(nativeNullPointer()),
        nativeByteBuffer(72)
    )
    if (result.valid()) result.initializeTransfer()
    result
}

class VulkanSurfaceFormat(
    val valid: bool,
    val format: int,
    val colorSpace: int
)

trusted fun VulkanAdapter.surfaceFormat(
    surface: VulkanX11Surface
): VulkanSurfaceFormat {
    val count = nativeI64Cell(0)
    var status = vkGetPhysicalDeviceSurfaceFormatsKHR(
        this.handle,
        surface.handle,
        count.address,
        nativeNullPointer()
    )
    var measured = count.load() & 4294967295
    if (measured > 256) measured = 0
    var selectedFormat = 0
    var selectedColorSpace = 0
    if (status == vulkanSuccess && measured > 0) {
        val formats = nativeByteBuffer(measured * 8)
        status = vkGetPhysicalDeviceSurfaceFormatsKHR(
            this.handle,
            surface.handle,
            count.address,
            formats.address
        )
        measured = count.load() & 4294967295
        if (status == vulkanSuccess && measured > 0) {
            selectedFormat = formats.loadI64(0) & 4294967295
            selectedColorSpace =
                (formats.loadI64(0) >>> 32) & 4294967295
            var index = 0
            while (index < measured) {
                val format = formats.loadI64(index * 8) & 4294967295
                val colorSpace =
                    (formats.loadI64(index * 8) >>> 32) & 4294967295
                if (format == 44 && colorSpace == 0) {
                    selectedFormat = format
                    selectedColorSpace = colorSpace
                }
                index = index + 1
            }
        }
    }
    VulkanSurfaceFormat(
        selectedFormat != 0,
        selectedFormat,
        selectedColorSpace
    )
}

resource class VulkanSwapchain(
    var handle: int,
    var device: i64*,
    val images: array<int>,
    val format: int,
    val colorSpace: int,
    val width: int,
    val height: int
) {
    trusted fun valid(): bool =
        this.handle != 0 && !pointerIsNull(this.device) &&
        this.images.size > 0 && this.width > 0 && this.height > 0

    trusted fun drop(): void {
        if (this.handle != 0 && !pointerIsNull(this.device)) {
            vkDestroySwapchainKHR(
                this.device,
                this.handle,
                nativeNullPointer()
            )
        }
        this.handle = 0
        this.device = nativeNullPointer()
        return
    }
}

resource class VulkanRenderPipeline(
    val device: i64*,
    val queue: i64*,
    var layout: int,
    var renderPass: int,
    var handle: int,
    val imageViews: array<int>,
    val framebuffers: array<int>,
    val depthTextures: array<VulkanTexture>,
    val depthViews: array<VulkanTextureView>,
    val format: int,
    val width: int,
    val height: int,
    val vertexStride: int,
    val depthEnabled: bool,
    val requiresBinding: bool
) {
    trusted fun valid(): bool = !pointerIsNull(this.device) &&
        !pointerIsNull(this.queue) && this.layout != 0 &&
        this.renderPass != 0 && this.handle != 0 && this.format != 0 &&
        this.width > 0 && this.height > 0 && this.vertexStride >= 0 &&
        this.imageViews.size > 0 &&
        this.framebuffers.size == this.imageViews.size &&
        ((!this.depthEnabled && this.depthTextures.size == 0 &&
          this.depthViews.size == 0) ||
         (this.depthEnabled &&
          this.depthTextures.size == this.imageViews.size &&
          this.depthViews.size == this.imageViews.size))

    trusted fun drop(): void {
        if (!pointerIsNull(this.queue)) vkQueueWaitIdle(this.queue)
        var index = 0
        while (index < this.framebuffers.size) {
            if (this.framebuffers[index] != 0 &&
                !pointerIsNull(this.device)) {
                vkDestroyFramebuffer(
                    this.device,
                    this.framebuffers[index],
                    nativeNullPointer()
                )
                this.framebuffers[index] = 0
            }
            index = index + 1
        }
        index = 0
        while (index < this.imageViews.size) {
            if (this.imageViews[index] != 0 &&
                !pointerIsNull(this.device)) {
                vkDestroyImageView(
                    this.device,
                    this.imageViews[index],
                    nativeNullPointer()
                )
                this.imageViews[index] = 0
            }
            index = index + 1
        }
        index = 0
        while (index < this.depthViews.size) {
            this.depthViews[index].drop()
            index = index + 1
        }
        index = 0
        while (index < this.depthTextures.size) {
            this.depthTextures[index].drop()
            index = index + 1
        }
        if (this.handle != 0 && !pointerIsNull(this.device)) {
            vkDestroyPipeline(this.device, this.handle, nativeNullPointer())
            this.handle = 0
        }
        if (this.layout != 0 && !pointerIsNull(this.device)) {
            vkDestroyPipelineLayout(
                this.device,
                this.layout,
                nativeNullPointer()
            )
            this.layout = 0
        }
        if (this.renderPass != 0 && !pointerIsNull(this.device)) {
            vkDestroyRenderPass(
                this.device,
                this.renderPass,
                nativeNullPointer()
            )
            this.renderPass = 0
        }
        return
    }
}

trusted fun VulkanDevice.renderPipeline(
    swapchain: VulkanSwapchain,
    vertex: VulkanShaderModule,
    fragment: VulkanShaderModule,
    vertexLayout: VertexBufferLayout = VertexBufferLayout(),
    topology: int = primitiveTopologyTriangleList,
    cull: int = cullModeNone,
    front: int = frontFaceCounterClockwise,
    alphaBlend: bool = false,
    depthEnabled: bool = false,
    depthWrite: bool = false,
    depthCompare: int = compareFunctionLess,
    descriptorSetLayout: int = 0
): VulkanRenderPipeline {
    var layout = 0
    var renderPass = 0
    var pipeline = 0
    val imageViews: array<int> = []
    val framebuffers: array<int> = []
    val depthTextures: array<VulkanTexture> = []
    val depthViews: array<VulkanTextureView> = []
    val vertexStride = vertexLayout.stride
    var succeeded = this.valid() && swapchain.valid() &&
        swapchain.device == this.handle && vertex.valid() && fragment.valid() &&
        vertex.device == this.handle && fragment.device == this.handle &&
        vertexLayout.valid() &&
        topology >= primitiveTopologyPointList &&
        topology <= primitiveTopologyTriangleStrip &&
        cull >= cullModeNone && cull <= cullModeBack &&
        (front == frontFaceClockwise ||
         front == frontFaceCounterClockwise) &&
        depthCompare >= compareFunctionNever &&
        depthCompare <= compareFunctionAlways &&
        (!depthWrite || depthEnabled)

    if (succeeded) {
        val attachments = nativeByteBuffer(if (depthEnabled) 80 else 40)
        attachments.storeI64(0, swapchain.format * 4294967296)
        attachments.storeI64(8, 4294967296 + 1)
        attachments.storeI64(16, 2 * 4294967296)
        attachments.storeI64(24, 1)
        attachments.storeI64(32, 1000001002)
        if (depthEnabled) {
            // VkAttachmentDescription is nine consecutive 32-bit fields,
            // hence a 36-byte array stride on the supported ABI.
            attachments.storeI64(36, 126 * 4294967296)
            attachments.storeI64(44, 4294967296 + 1)
            attachments.storeI64(52, 4294967296 + 1)
            attachments.storeI64(60, 1)
            attachments.storeI64(68, 3)
        }
        val colorReference = nativeByteBuffer(8)
        colorReference.storeI64(0, 2 * 4294967296)
        val depthReference = nativeByteBuffer(8)
        depthReference.storeI64(0, 3 * 4294967296 + 1)
        val subpass = nativeByteBuffer(72)
        subpass.storeI64(0, 0)
        subpass.storeI64(8, 0)
        subpass.storePointer(16, nativeNullPointer())
        subpass.storeI64(24, 1)
        subpass.storePointer(32, colorReference.address)
        subpass.storePointer(40, nativeNullPointer())
        subpass.storePointer(
            48,
            if (depthEnabled) depthReference.address else nativeNullPointer()
        )
        subpass.storeI64(56, 0)
        subpass.storePointer(64, nativeNullPointer())
        val createInfo = nativeByteBuffer(64)
        createInfo.storeI64(0, 38)
        createInfo.storePointer(8, nativeNullPointer())
        createInfo.storeI64(
            16,
            (if (depthEnabled) 2 else 1) * 4294967296
        )
        createInfo.storePointer(24, attachments.address)
        createInfo.storeI64(32, 1)
        createInfo.storePointer(40, subpass.address)
        createInfo.storeI64(48, 0)
        createInfo.storePointer(56, nativeNullPointer())
        val output = nativeI64Cell(0)
        succeeded = vkCreateRenderPass(
            this.handle,
            createInfo.address,
            nativeNullPointer(),
            output.address
        ) == vulkanSuccess
        if (succeeded) renderPass = output.load()
    }

    if (succeeded) {
        val layoutInfo = nativeByteBuffer(48)
        layoutInfo.storeI64(0, 30)
        layoutInfo.storePointer(8, nativeNullPointer())
        layoutInfo.storeI64(
            16,
            if (descriptorSetLayout != 0) 4294967296 else 0
        )
        val setLayout = nativeI64Cell(descriptorSetLayout)
        layoutInfo.storePointer(
            24,
            if (descriptorSetLayout != 0) setLayout.address
            else nativeNullPointer()
        )
        layoutInfo.storeI64(32, 0)
        layoutInfo.storePointer(40, nativeNullPointer())
        val output = nativeI64Cell(0)
        succeeded = vkCreatePipelineLayout(
            this.handle,
            layoutInfo.address,
            nativeNullPointer(),
            output.address
        ) == vulkanSuccess
        if (succeeded) layout = output.load()
    }

    var imageIndex = 0
    while (succeeded && imageIndex < swapchain.images.size) {
        val viewInfo = nativeByteBuffer(80)
        viewInfo.storeI64(0, 15)
        viewInfo.storePointer(8, nativeNullPointer())
        viewInfo.storeI64(16, 0)
        viewInfo.storeI64(24, swapchain.images[imageIndex])
        viewInfo.storeI64(32, swapchain.format * 4294967296 + 1)
        viewInfo.storeI64(40, 0)
        viewInfo.storeI64(48, 0)
        viewInfo.storeI64(56, 1)
        viewInfo.storeI64(64, 1)
        viewInfo.storeI64(72, 1)
        val viewOutput = nativeI64Cell(0)
        succeeded = vkCreateImageView(
            this.handle,
            viewInfo.address,
            nativeNullPointer(),
            viewOutput.address
        ) == vulkanSuccess
        if (succeeded) imageViews.append(viewOutput.load())
        imageIndex = imageIndex + 1
    }

    imageIndex = 0
    while (succeeded && depthEnabled &&
        imageIndex < swapchain.images.size) {
        val depthTexture = this.texture(TextureDescriptor(
            label = "render-depth",
            size = Extent3D(swapchain.width, swapchain.height),
            format = textureFormatDepth32Float,
            usage = textureUsageRenderAttachment
        ))
        val depthView = depthTexture.view(
            TextureDescriptor(
                label = "render-depth",
                size = Extent3D(swapchain.width, swapchain.height),
                format = textureFormatDepth32Float,
                usage = textureUsageRenderAttachment
            ),
            TextureViewDescriptor(aspect = textureAspectDepth)
        )
        succeeded = depthTexture.valid() && depthView.valid()
        if (succeeded) {
            depthTextures.append(move(depthTexture))
            depthViews.append(move(depthView))
        }
        imageIndex = imageIndex + 1
    }

    imageIndex = 0
    while (succeeded && imageIndex < imageViews.size) {
        val framebufferAttachments = nativeByteBuffer(16)
        framebufferAttachments.storeI64(0, imageViews[imageIndex])
        if (depthEnabled) framebufferAttachments.storeI64(
            8,
            depthViews[imageIndex].handle
        )
        val framebufferInfo = nativeByteBuffer(64)
        framebufferInfo.storeI64(0, 37)
        framebufferInfo.storePointer(8, nativeNullPointer())
        framebufferInfo.storeI64(16, 0)
        framebufferInfo.storeI64(24, renderPass)
        framebufferInfo.storeI64(32, if (depthEnabled) 2 else 1)
        framebufferInfo.storePointer(40, framebufferAttachments.address)
        framebufferInfo.storeI64(
            48,
            swapchain.height * 4294967296 + swapchain.width
        )
        framebufferInfo.storeI64(56, 1)
        val output = nativeI64Cell(0)
        succeeded = vkCreateFramebuffer(
            this.handle,
            framebufferInfo.address,
            nativeNullPointer(),
            output.address
        ) == vulkanSuccess
        if (succeeded) framebuffers.append(output.load())
        imageIndex = imageIndex + 1
    }

    if (succeeded) {
        val stages = nativeByteBuffer(96)
        stages.storeI64(0, 18)
        stages.storePointer(8, nativeNullPointer())
        stages.storeI64(16, 4294967296)
        stages.storeI64(24, vertex.handle)
        stages.storePointer(
            32,
            nativePointerFromAddress(nativeCStringAddress("main"))
        )
        stages.storePointer(40, nativeNullPointer())
        stages.storeI64(48, 18)
        stages.storePointer(56, nativeNullPointer())
        stages.storeI64(64, 16 * 4294967296)
        stages.storeI64(72, fragment.handle)
        stages.storePointer(
            80,
            nativePointerFromAddress(nativeCStringAddress("main"))
        )
        stages.storePointer(88, nativeNullPointer())

        val attributeCount = vertexLayout.attributeCount()
        val binding = nativeByteBuffer(16)
        binding.storeI64(0, vertexStride * 4294967296)
        binding.storeI64(8, 0)
        val attributes = nativeByteBuffer(
            if (attributeCount > 0) attributeCount * 16 else 16
        )
        if (vertexLayout.buffered() &&
            vertexLayout.attributes.size == 0) {
            attributes.storeI64(0, 0)
            attributes.storeI64(8, 103)
        } else {
            var attributeIndex = 0
            while (attributeIndex < vertexLayout.attributes.size) {
                val attribute = vertexLayout.attributes[attributeIndex]
                var format = 100
                if (attribute.format == vertexFormatUint32) format = 98
                else if (attribute.format == vertexFormatFloat32x2) format = 103
                else if (attribute.format == vertexFormatFloat32x3) format = 106
                else if (attribute.format == vertexFormatFloat32x4) format = 109
                val offset = attributeIndex * 16
                attributes.storeI64(offset,
                    attribute.location)
                attributes.storeI64(offset + 8,
                    attribute.offset * 4294967296 + format)
                attributeIndex = attributeIndex + 1
            }
        }
        val vertexInput = nativeByteBuffer(48)
        vertexInput.storeI64(0, 19)
        vertexInput.storePointer(8, nativeNullPointer())
        vertexInput.storeI64(
            16,
            if (vertexStride > 0) 4294967296 else 0
        )
        vertexInput.storePointer(
            24,
            if (vertexStride > 0) binding.address else nativeNullPointer()
        )
        vertexInput.storeI64(32, attributeCount)
        vertexInput.storePointer(
            40,
            if (attributeCount > 0) attributes.address else nativeNullPointer()
        )
        val inputAssembly = nativeByteBuffer(32)
        inputAssembly.storeI64(0, 20)
        inputAssembly.storePointer(8, nativeNullPointer())
        inputAssembly.storeI64(16, topology * 4294967296)
        inputAssembly.storeI64(24, 0)
        val viewport = nativeByteBuffer(48)
        viewport.storeI64(0, 22)
        viewport.storePointer(8, nativeNullPointer())
        viewport.storeI64(16, 4294967296)
        viewport.storePointer(24, nativeNullPointer())
        viewport.storeI64(32, 1)
        viewport.storePointer(40, nativeNullPointer())
        val rasterization = nativeByteBuffer(64)
        rasterization.storeI64(0, 23)
        rasterization.storePointer(8, nativeNullPointer())
        rasterization.storeI64(16, 0)
        rasterization.storeI64(24, 0)
        rasterization.storeI64(32, front * 4294967296 + cull)
        rasterization.storeI64(40, 0)
        rasterization.storeI64(48, 0)
        rasterization.storeI64(56, 1065353216)
        val multisample = nativeByteBuffer(48)
        multisample.storeI64(0, 24)
        multisample.storePointer(8, nativeNullPointer())
        multisample.storeI64(16, 4294967296)
        multisample.storeI64(24, 0)
        multisample.storePointer(32, nativeNullPointer())
        multisample.storeI64(40, 0)
        val depthStencil = nativeByteBuffer(104)
        depthStencil.storeI64(0, 25)
        depthStencil.storePointer(8, nativeNullPointer())
        depthStencil.storeI64(
            16,
            (if (depthEnabled) 1 else 0) * 4294967296
        )
        depthStencil.storeI64(
            24,
            (depthCompare - 1) * 4294967296 +
                (if (depthWrite) 1 else 0)
        )
        depthStencil.storeI64(32, 0)
        depthStencil.storeI64(40, 0)
        depthStencil.storeI64(48, 0)
        depthStencil.storeI64(56, 0)
        depthStencil.storeI64(64, 0)
        depthStencil.storeI64(72, 0)
        depthStencil.storeI64(80, 0)
        depthStencil.storeI64(88, 0)
        depthStencil.storeI64(96, 1065353216 * 4294967296)
        val colorAttachment = nativeByteBuffer(32)
        colorAttachment.storeI64(
            0,
            if (alphaBlend) 6 * 4294967296 + 1 else 0
        )
        colorAttachment.storeI64(8, if (alphaBlend) 7 else 0)
        colorAttachment.storeI64(
            16,
            if (alphaBlend) 7 * 4294967296 + 1 else 0
        )
        colorAttachment.storeI64(24, 15 * 4294967296)
        val colorBlend = nativeByteBuffer(56)
        colorBlend.storeI64(0, 26)
        colorBlend.storePointer(8, nativeNullPointer())
        colorBlend.storeI64(16, 0)
        colorBlend.storeI64(24, 4294967296)
        colorBlend.storePointer(32, colorAttachment.address)
        colorBlend.storeI64(40, 0)
        colorBlend.storeI64(48, 0)
        val states = nativeByteBuffer(8)
        states.storeI64(0, 4294967296)
        val dynamic = nativeByteBuffer(32)
        dynamic.storeI64(0, 27)
        dynamic.storePointer(8, nativeNullPointer())
        dynamic.storeI64(16, 2 * 4294967296)
        dynamic.storePointer(24, states.address)

        val pipelineInfo = nativeByteBuffer(144)
        pipelineInfo.storeI64(0, 28)
        pipelineInfo.storePointer(8, nativeNullPointer())
        pipelineInfo.storeI64(16, 2 * 4294967296)
        pipelineInfo.storePointer(24, stages.address)
        pipelineInfo.storePointer(32, vertexInput.address)
        pipelineInfo.storePointer(40, inputAssembly.address)
        pipelineInfo.storePointer(48, nativeNullPointer())
        pipelineInfo.storePointer(56, viewport.address)
        pipelineInfo.storePointer(64, rasterization.address)
        pipelineInfo.storePointer(72, multisample.address)
        pipelineInfo.storePointer(
            80,
            if (depthEnabled) depthStencil.address else nativeNullPointer()
        )
        pipelineInfo.storePointer(88, colorBlend.address)
        pipelineInfo.storePointer(96, dynamic.address)
        pipelineInfo.storeI64(104, layout)
        pipelineInfo.storeI64(112, renderPass)
        pipelineInfo.storeI64(120, 0)
        pipelineInfo.storeI64(128, 0)
        pipelineInfo.storeI64(136, 4294967295)
        val output = nativeI64Cell(0)
        succeeded = vkCreateGraphicsPipelines(
            this.handle,
            0,
            1,
            pipelineInfo.address,
            nativeNullPointer(),
            output.address
        ) == vulkanSuccess
        if (succeeded) pipeline = output.load()
    }

    VulkanRenderPipeline(
        this.handle,
        this.queue,
        layout,
        renderPass,
        pipeline,
        imageViews,
        framebuffers,
        move(depthTextures),
        move(depthViews),
        swapchain.format,
        swapchain.width,
        swapchain.height,
        vertexStride,
        depthEnabled,
        descriptorSetLayout != 0
    )
}

trusted fun VulkanDevice.swapchain(
    adapter: VulkanAdapter,
    surface: VulkanX11Surface
): VulkanSwapchain {
    val images: array<int> = []
    val capabilities = adapter.surfaceCapabilities(surface)
    val selected = adapter.surfaceFormat(surface)
    var width = capabilities.width
    var height = capabilities.height
    if (width == 4294967295 || height == 4294967295) {
        width = surface.width
        height = surface.height
    }
    var imageCount = capabilities.minimumImages + 1
    if (capabilities.maximumImages > 0 &&
        imageCount > capabilities.maximumImages) {
        imageCount = capabilities.maximumImages
    }
    var usage = 0
    if ((capabilities.supportedUsage & 16) != 0) usage = usage | 16
    if ((capabilities.supportedUsage & 2) != 0) usage = usage | 2
    var compositeAlpha = 1
    if ((capabilities.supportedCompositeAlpha & 1) == 0) {
        if ((capabilities.supportedCompositeAlpha & 2) != 0) {
            compositeAlpha = 2
        } else if ((capabilities.supportedCompositeAlpha & 4) != 0) {
            compositeAlpha = 4
        } else compositeAlpha = 8
    }
    var handle = 0
    if (this.valid() && capabilities.valid && selected.valid &&
        width > 0 && height > 0 && imageCount > 0 &&
        (usage & 2) != 0) {
        val createInfo = nativeByteBuffer(104)
        createInfo.storeI64(0, 1000001000)
        createInfo.storePointer(8, nativeNullPointer())
        createInfo.storeI64(16, 0)
        createInfo.storeI64(24, surface.handle)
        createInfo.storeI64(
            32,
            (selected.format & 4294967295) * 4294967296 + imageCount
        )
        createInfo.storeI64(
            40,
            (width & 4294967295) * 4294967296 +
                (selected.colorSpace & 4294967295)
        )
        createInfo.storeI64(
            48,
            (1 * 4294967296) + (height & 4294967295)
        )
        createInfo.storeI64(56, usage)
        createInfo.storeI64(64, 0)
        createInfo.storePointer(72, nativeNullPointer())
        createInfo.storeI64(
            80,
            (compositeAlpha & 4294967295) * 4294967296 +
                (capabilities.currentTransform & 4294967295)
        )
        createInfo.storeI64(88, 4294967298)
        createInfo.storeI64(96, 0)
        val output = nativeI64Cell(0)
        if (vkCreateSwapchainKHR(
            this.handle,
            createInfo.address,
            nativeNullPointer(),
            output.address
        ) == vulkanSuccess) handle = output.load()
    }
    if (handle != 0) {
        val count = nativeI64Cell(0)
        var status = vkGetSwapchainImagesKHR(
            this.handle,
            handle,
            count.address,
            nativeNullPointer()
        )
        var measured = count.load() & 4294967295
        if (measured > 16) measured = 0
        if (status == vulkanSuccess && measured > 0) {
            val handles = nativeByteBuffer(measured * 8)
            status = vkGetSwapchainImagesKHR(
                this.handle,
                handle,
                count.address,
                handles.address
            )
            measured = count.load() & 4294967295
            var index = 0
            while (status == vulkanSuccess && index < measured) {
                images.append(handles.loadI64(index * 8))
                index = index + 1
            }
        }
    }
    if (handle != 0 && images.size == 0) {
        vkDestroySwapchainKHR(this.handle, handle, nativeNullPointer())
        handle = 0
    }
    VulkanSwapchain(
        handle,
        this.handle,
        images,
        selected.format,
        selected.colorSpace,
        width,
        height
    )
}

trusted fun vulkanStoreImageBarrier(
    barrier: i64*,
    image: int,
    oldLayout: int,
    newLayout: int,
    sourceAccess: int,
    destinationAccess: int,
    aspect: int = 1,
    baseMipLevel: int = 0,
    mipLevels: int = 1
): void {
    ablaUnsafeStoreI64(barrier, 45)
    ablaUnsafeStorePointer(
        ablaUnsafePointerOffset(barrier, 8),
        nativeNullPointer()
    )
    ablaUnsafeStoreI64(
        ablaUnsafePointerOffset(barrier, 16),
        (destinationAccess & 4294967295) * 4294967296 +
            (sourceAccess & 4294967295)
    )
    ablaUnsafeStoreI64(
        ablaUnsafePointerOffset(barrier, 24),
        (newLayout & 4294967295) * 4294967296 +
            (oldLayout & 4294967295)
    )
    ablaUnsafeStoreI64(
        ablaUnsafePointerOffset(barrier, 32),
        18446744073709551615
    )
    ablaUnsafeStoreI64(ablaUnsafePointerOffset(barrier, 40), image)
    ablaUnsafeStoreI64(
        ablaUnsafePointerOffset(barrier, 48),
        baseMipLevel * 4294967296 + aspect
    )
    ablaUnsafeStoreI64(
        ablaUnsafePointerOffset(barrier, 56),
        mipLevels
    )
    ablaUnsafeStoreI64(ablaUnsafePointerOffset(barrier, 64), 1)
    return
}

trusted fun vulkanImageBarrier(
    image: int,
    oldLayout: int,
    newLayout: int,
    sourceAccess: int,
    destinationAccess: int,
    aspect: int = 1,
    baseMipLevel: int = 0,
    mipLevels: int = 1
): NativeByteBuffer {
    val barrier = nativeByteBuffer(72)
    barrier.storeI64(0, 45)
    barrier.storePointer(8, nativeNullPointer())
    barrier.storeI64(
        16,
        (destinationAccess & 4294967295) * 4294967296 +
            (sourceAccess & 4294967295)
    )
    barrier.storeI64(
        24,
        (newLayout & 4294967295) * 4294967296 +
            (oldLayout & 4294967295)
    )
    barrier.storeI64(32, 18446744073709551615)
    barrier.storeI64(40, image)
    barrier.storeI64(48, baseMipLevel * 4294967296 + aspect)
    barrier.storeI64(56, mipLevels)
    barrier.storeI64(64, 1)
    barrier
}

trusted fun VulkanDevice.presentClearOutcome(
    swapchain: VulkanSwapchain,
    clear: Color
): int {
    var succeeded = this.valid() && swapchain.valid() && clear.valid()
    var recreateSwapchain = false
    var status = if (succeeded) vulkanSuccess else -1
    var submitted = false
    val semaphoreInfo = nativeByteBuffer(24)
    semaphoreInfo.storeI64(0, 9)
    semaphoreInfo.storePointer(8, nativeNullPointer())
    semaphoreInfo.storeI64(16, 0)
    val acquired = nativeI64Cell(0)
    val rendered = nativeI64Cell(0)
    if (succeeded) {
        succeeded = vkCreateSemaphore(
            this.handle,
            semaphoreInfo.address,
            nativeNullPointer(),
            acquired.address
        ) == vulkanSuccess
    }
    if (succeeded) {
        succeeded = vkCreateSemaphore(
            this.handle,
            semaphoreInfo.address,
            nativeNullPointer(),
            rendered.address
        ) == vulkanSuccess
    }
    val imageIndex = nativeI64Cell(0)
    if (succeeded) {
        status = vkAcquireNextImageKHR(
            this.handle,
            swapchain.handle,
            9223372036854775807,
            acquired.load(),
            0,
            imageIndex.address
        )
        val outcome = vulkanPresentStatus(status)
        succeeded = vulkanPresentSucceeded(outcome)
        recreateSwapchain = vulkanPresentNeedsRecreation(outcome)
    }
    val selectedIndex = imageIndex.load() & 4294967295
    if (selectedIndex < 0 || selectedIndex >= swapchain.images.size) {
        succeeded = false
    }

    val pool = nativeI64Cell(0)
    val command = nativePointerCell(nativeNullPointer())
    if (succeeded) {
        val poolInfo = nativeByteBuffer(32)
        poolInfo.storeI64(0, 39)
        poolInfo.storePointer(8, nativeNullPointer())
        poolInfo.storeI64(
            16,
            (this.queueFamily & 4294967295) * 4294967296 + 2
        )
        succeeded = vkCreateCommandPool(
            this.handle,
            poolInfo.address,
            nativeNullPointer(),
            pool.address
        ) == vulkanSuccess
    }
    if (succeeded) {
        val allocateInfo = nativeByteBuffer(32)
        allocateInfo.storeI64(0, 40)
        allocateInfo.storePointer(8, nativeNullPointer())
        allocateInfo.storeI64(16, pool.load())
        allocateInfo.storeI64(24, 4294967296)
        succeeded = vkAllocateCommandBuffers(
            this.handle,
            allocateInfo.address,
            command.address
        ) == vulkanSuccess
    }
    if (succeeded) {
        val beginInfo = nativeByteBuffer(32)
        beginInfo.storeI64(0, 42)
        beginInfo.storePointer(8, nativeNullPointer())
        beginInfo.storeI64(16, 1)
        beginInfo.storePointer(24, nativeNullPointer())
        succeeded = vkBeginCommandBuffer(
            command.load(),
            beginInfo.address
        ) == vulkanSuccess
    }
    if (succeeded) {
        val image = swapchain.images[selectedIndex]
        val toTransfer = vulkanImageBarrier(image, 0, 7, 0, 4096)
        vkCmdPipelineBarrier(
            command.load(),
            1,
            4096,
            0,
            0,
            nativeNullPointer(),
            0,
            nativeNullPointer(),
            1,
            toTransfer.address
        )
        val color = nativeByteBuffer(16)
        color.storeI64(
            0,
            (graphicsScalarF32Bits(clear.green) & 4294967295) *
                4294967296 +
                (graphicsScalarF32Bits(clear.red) & 4294967295)
        )
        color.storeI64(
            8,
            (graphicsScalarF32Bits(clear.alpha) & 4294967295) *
                4294967296 +
                (graphicsScalarF32Bits(clear.blue) & 4294967295)
        )
        vkCmdClearColorImage(
            command.load(),
            image,
            7,
            color.address,
            1,
            nativePointerFromAddress(
                nativePointerAddress(toTransfer.address) + 48
            )
        )
        val toPresent = vulkanImageBarrier(
            image,
            7,
            1000001002,
            4096,
            0
        )
        vkCmdPipelineBarrier(
            command.load(),
            4096,
            8192,
            0,
            0,
            nativeNullPointer(),
            0,
            nativeNullPointer(),
            1,
            toPresent.address
        )
        succeeded = vkEndCommandBuffer(command.load()) == vulkanSuccess
    }
    if (succeeded) {
        val waitStage = nativeI64Cell(4096)
        val submitInfo = nativeByteBuffer(72)
        submitInfo.storeI64(0, 4)
        submitInfo.storePointer(8, nativeNullPointer())
        submitInfo.storeI64(16, 1)
        submitInfo.storePointer(24, acquired.address)
        submitInfo.storePointer(32, waitStage.address)
        submitInfo.storeI64(40, 1)
        submitInfo.storePointer(48, command.address)
        submitInfo.storeI64(56, 1)
        submitInfo.storePointer(64, rendered.address)
        succeeded = vkQueueSubmit(
            this.queue,
            1,
            submitInfo.address,
            0
        ) == vulkanSuccess
        submitted = succeeded
    }
    if (succeeded) {
        val swapchainCell = nativeI64Cell(swapchain.handle)
        val presentInfo = nativeByteBuffer(64)
        presentInfo.storeI64(0, 1000001001)
        presentInfo.storePointer(8, nativeNullPointer())
        presentInfo.storeI64(16, 1)
        presentInfo.storePointer(24, rendered.address)
        presentInfo.storeI64(32, 1)
        presentInfo.storePointer(40, swapchainCell.address)
        presentInfo.storePointer(48, imageIndex.address)
        presentInfo.storePointer(56, nativeNullPointer())
        status = vkQueuePresentKHR(this.queue, presentInfo.address)
        val outcome = vulkanPresentStatus(status)
        succeeded = vulkanPresentSucceeded(outcome)
        recreateSwapchain = recreateSwapchain ||
            vulkanPresentNeedsRecreation(outcome)
    }
    if (submitted) {
        val idle = vkQueueWaitIdle(this.queue) == vulkanSuccess
        if (succeeded && !idle) succeeded = false
    }
    if (pool.load() != 0) {
        vkDestroyCommandPool(
            this.handle,
            pool.load(),
            nativeNullPointer()
        )
    }
    if (rendered.load() != 0) {
        vkDestroySemaphore(
            this.handle,
            rendered.load(),
            nativeNullPointer()
        )
    }
    if (acquired.load() != 0) {
        vkDestroySemaphore(
            this.handle,
            acquired.load(),
            nativeNullPointer()
        )
    }
    vulkanPresentOutcome(
        succeeded,
        recreateSwapchain,
        status,
        submitted
    )
}

trusted fun VulkanDevice.presentClear(
    swapchain: VulkanSwapchain,
    clear: Color
): bool = vulkanPresentSucceeded(
    this.presentClearOutcome(swapchain, clear)
)

trusted fun VulkanDevice.presentBlue(
    swapchain: VulkanSwapchain
): bool = this.presentClear(
    swapchain,
    Color(
        0.15,
        0.45,
        0.85
    )
)

trusted fun VulkanDevice.presentClearFrameOutcome(
    swapchain: VulkanSwapchain,
    var frame: VulkanPixelFrame,
    renderedSemaphores: array<int>,
    clear: Color
): int {
    var succeeded = this.valid() && swapchain.valid() && frame.valid() &&
        clear.valid()
    var recreateSwapchain = false
    var status = if (succeeded) vulkanSuccess else -1
    var submitted = false
    frame.scratch.storeI64(96, frame.fence)
    val fence = nativePointerFromAddress(
        nativePointerAddress(frame.scratch.address) + 96
    )
    if (succeeded && frame.inFlight) {
        succeeded = vkWaitForFences(
            this.handle,
            1,
            fence,
            1,
            18446744073709551615
        ) == vulkanSuccess
        if (succeeded) frame.inFlight = false
    }
    frame.scratch.storeI64(72, frame.acquired)
    frame.scratch.storeI64(80, 0)
    val acquired = nativePointerFromAddress(
        nativePointerAddress(frame.scratch.address) + 72
    )
    val imageIndex = nativePointerFromAddress(
        nativePointerAddress(frame.scratch.address) + 80
    )
    if (succeeded) {
        status = vkAcquireNextImageKHR(
            this.handle,
            swapchain.handle,
            9223372036854775807,
            frame.acquired,
            0,
            imageIndex
        )
        val outcome = vulkanPresentStatus(status)
        succeeded = vulkanPresentSucceeded(outcome)
        recreateSwapchain = vulkanPresentNeedsRecreation(outcome)
    }
    val selectedIndex = frame.scratch.loadI64(80) & 4294967295
    if (selectedIndex < 0 || selectedIndex >= swapchain.images.size) {
        succeeded = false
    }
    if (selectedIndex < 0 || selectedIndex >= renderedSemaphores.size) {
        succeeded = false
    }
    frame.scratch.storeI64(
        88,
        if (succeeded) renderedSemaphores[selectedIndex] else 0
    )
    val rendered = nativePointerFromAddress(
        nativePointerAddress(frame.scratch.address) + 88
    )
    if (succeeded) {
        succeeded = vkResetCommandPool(
            this.handle,
            frame.commandPool,
            0
        ) == vulkanSuccess
    }
    if (succeeded) {
        frame.scratch.storeI64(0, 42)
        frame.scratch.storePointer(8, nativeNullPointer())
        frame.scratch.storeI64(16, 1)
        frame.scratch.storePointer(24, nativeNullPointer())
        succeeded = vkBeginCommandBuffer(
            frame.command.load(),
            frame.scratch.address
        ) == vulkanSuccess
    }
    if (succeeded) {
        val image = swapchain.images[selectedIndex]
        vulkanStoreImageBarrier(
            frame.scratch.address,
            image,
            0,
            7,
            0,
            4096
        )
        vkCmdPipelineBarrier(
            frame.command.load(),
            1,
            4096,
            0,
            0,
            nativeNullPointer(),
            0,
            nativeNullPointer(),
            1,
            frame.scratch.address
        )
        frame.scratch.storeI64(
            120,
            (graphicsScalarF32Bits(clear.green) & 4294967295) *
                4294967296 +
                (graphicsScalarF32Bits(clear.red) & 4294967295)
        )
        frame.scratch.storeI64(
            128,
            (graphicsScalarF32Bits(clear.alpha) & 4294967295) *
                4294967296 +
                (graphicsScalarF32Bits(clear.blue) & 4294967295)
        )
        frame.scratch.storeI64(136, 1)
        frame.scratch.storeI64(144, 1)
        frame.scratch.storeI64(152, 1)
        vkCmdClearColorImage(
            frame.command.load(),
            image,
            7,
            nativePointerFromAddress(
                nativePointerAddress(frame.scratch.address) + 120
            ),
            1,
            nativePointerFromAddress(
                nativePointerAddress(frame.scratch.address) + 136
            )
        )
        vulkanStoreImageBarrier(
            frame.scratch.address,
            image,
            7,
            1000001002,
            4096,
            0
        )
        vkCmdPipelineBarrier(
            frame.command.load(),
            4096,
            8192,
            0,
            0,
            nativeNullPointer(),
            0,
            nativeNullPointer(),
            1,
            frame.scratch.address
        )
        succeeded = vkEndCommandBuffer(
            frame.command.load()
        ) == vulkanSuccess
    }
    if (succeeded) {
        succeeded = vkResetFences(
            this.handle,
            1,
            fence
        ) == vulkanSuccess
    }
    if (succeeded) {
        frame.scratch.storeI64(104, 4096)
        frame.scratch.storeI64(0, 4)
        frame.scratch.storePointer(8, nativeNullPointer())
        frame.scratch.storeI64(16, 1)
        frame.scratch.storePointer(24, acquired)
        frame.scratch.storePointer(
            32,
            nativePointerFromAddress(
                nativePointerAddress(frame.scratch.address) + 104
            )
        )
        frame.scratch.storeI64(40, 1)
        frame.scratch.storePointer(48, frame.command.address)
        frame.scratch.storeI64(56, 1)
        frame.scratch.storePointer(64, rendered)
        succeeded = vkQueueSubmit(
            this.queue,
            1,
            frame.scratch.address,
            frame.fence
        ) == vulkanSuccess
        if (succeeded) {
            frame.inFlight = true
            submitted = true
        }
    }
    if (succeeded) {
        frame.scratch.storeI64(112, swapchain.handle)
        frame.scratch.storeI64(0, 1000001001)
        frame.scratch.storePointer(8, nativeNullPointer())
        frame.scratch.storeI64(16, 1)
        frame.scratch.storePointer(24, rendered)
        frame.scratch.storeI64(32, 1)
        frame.scratch.storePointer(
            40,
            nativePointerFromAddress(
                nativePointerAddress(frame.scratch.address) + 112
            )
        )
        frame.scratch.storePointer(48, imageIndex)
        frame.scratch.storePointer(56, nativeNullPointer())
        status = vkQueuePresentKHR(this.queue, frame.scratch.address)
        val outcome = vulkanPresentStatus(status)
        succeeded = vulkanPresentSucceeded(outcome)
        recreateSwapchain = recreateSwapchain ||
            vulkanPresentNeedsRecreation(outcome)
    }
    vulkanPresentOutcome(
        succeeded,
        recreateSwapchain,
        status,
        submitted
    )
}

trusted fun VulkanDevice.presentClearFramesOutcome(
    swapchain: VulkanSwapchain,
    var presenter: VulkanPixelPresenter,
    clear: Color
): int {
    var outcome = vulkanPresentOutcome(false, false, -1)
    if (this.valid() && swapchain.valid() && presenter.valid() &&
        presenter.width == swapchain.width &&
        presenter.height == swapchain.height &&
        presenter.format == swapchain.format && clear.valid()) {
        outcome = this.presentClearFrameOutcome(
            swapchain,
            presenter.frames[presenter.frameIndex],
            presenter.rendered,
            clear
        )
    }
    if (vulkanPresentWasSubmitted(outcome)) {
        presenter.frameIndex = if (
            presenter.frameIndex + 1 == presenter.frames.size
        ) 0 else presenter.frameIndex + 1
    }
    outcome
}

trusted fun VulkanDevice.presentRenderOutcome(
    swapchain: VulkanSwapchain,
    var presenter: VulkanPixelPresenter,
    pipeline: VulkanRenderPipeline,
    clear: Color,
    vertexBuffer: int = 0,
    vertexCount: int = 3,
    indexBuffer: int = 0,
    indexCount: int = 0,
    instanceCount: int = 1,
    descriptorSet: int = 0
): int {
    var succeeded = this.valid() && swapchain.valid() && presenter.valid() &&
        pipeline.valid() && pipeline.device == this.handle &&
        presenter.width == swapchain.width &&
        presenter.height == swapchain.height &&
        presenter.format == swapchain.format &&
        pipeline.width == swapchain.width &&
        pipeline.height == swapchain.height &&
        pipeline.format == swapchain.format &&
        pipeline.framebuffers.size == swapchain.images.size && clear.valid() &&
        vertexCount > 0 && indexCount >= 0 && instanceCount > 0 &&
        ((pipeline.vertexStride == 0 && vertexBuffer == 0) ||
         (pipeline.vertexStride > 0 && vertexBuffer != 0)) &&
        ((indexCount == 0 && indexBuffer == 0) ||
         (pipeline.vertexStride > 0 && indexCount > 0 && indexBuffer != 0)) &&
        pipeline.requiresBinding == (descriptorSet != 0)
    var recreateSwapchain = false
    var status = if (succeeded) vulkanSuccess else -1
    var submitted = false
    var frame = if (presenter.frames.size > 0) presenter.frameIndex else 0
    if (frame < 0 || frame >= presenter.frames.size) succeeded = false

    if (succeeded) {
        presenter.frames[frame].scratch.storeI64(
            96,
            presenter.frames[frame].fence
        )
        val fence = nativePointerFromAddress(
            nativePointerAddress(presenter.frames[frame].scratch.address) + 96
        )
        if (presenter.frames[frame].inFlight) {
            succeeded = vkWaitForFences(
                this.handle,
                1,
                fence,
                1,
                18446744073709551615
            ) == vulkanSuccess
            if (succeeded) presenter.frames[frame].inFlight = false
        }
    }

    if (succeeded) {
        presenter.frames[frame].scratch.storeI64(
            72,
            presenter.frames[frame].acquired
        )
        presenter.frames[frame].scratch.storeI64(80, 0)
        status = vkAcquireNextImageKHR(
            this.handle,
            swapchain.handle,
            9223372036854775807,
            presenter.frames[frame].acquired,
            0,
            nativePointerFromAddress(
                nativePointerAddress(
                    presenter.frames[frame].scratch.address
                ) + 80
            )
        )
        val outcome = vulkanPresentStatus(status)
        succeeded = vulkanPresentSucceeded(outcome)
        recreateSwapchain = vulkanPresentNeedsRecreation(outcome)
    }
    val imageIndex = if (succeeded)
        presenter.frames[frame].scratch.loadI64(80) & 4294967295
    else -1
    if (imageIndex < 0 || imageIndex >= swapchain.images.size ||
        imageIndex >= presenter.rendered.size ||
        imageIndex >= pipeline.framebuffers.size) succeeded = false

    if (succeeded) {
        presenter.frames[frame].scratch.storeI64(
            88,
            presenter.rendered[imageIndex]
        )
        succeeded = vkResetCommandPool(
            this.handle,
            presenter.frames[frame].commandPool,
            0
        ) == vulkanSuccess
    }
    if (succeeded) {
        presenter.frames[frame].scratch.storeI64(0, 42)
        presenter.frames[frame].scratch.storePointer(
            8,
            nativeNullPointer()
        )
        presenter.frames[frame].scratch.storeI64(16, 1)
        presenter.frames[frame].scratch.storePointer(
            24,
            nativeNullPointer()
        )
        succeeded = vkBeginCommandBuffer(
            presenter.frames[frame].command.load(),
            presenter.frames[frame].scratch.address
        ) == vulkanSuccess
    }
    if (succeeded) {
        presenter.frames[frame].scratch.storeI64(
            120,
            (graphicsScalarF32Bits(clear.green) & 4294967295) *
                4294967296 +
                (graphicsScalarF32Bits(clear.red) & 4294967295)
        )
        presenter.frames[frame].scratch.storeI64(
            128,
            (graphicsScalarF32Bits(clear.alpha) & 4294967295) *
                4294967296 +
                (graphicsScalarF32Bits(clear.blue) & 4294967295)
        )
        if (pipeline.depthEnabled) {
            presenter.frames[frame].scratch.storeI64(136, 1065353216)
            presenter.frames[frame].scratch.storeI64(144, 0)
        }
        presenter.frames[frame].scratch.storeI64(0, 43)
        presenter.frames[frame].scratch.storePointer(
            8,
            nativeNullPointer()
        )
        presenter.frames[frame].scratch.storeI64(16, pipeline.renderPass)
        presenter.frames[frame].scratch.storeI64(
            24,
            pipeline.framebuffers[imageIndex]
        )
        presenter.frames[frame].scratch.storeI64(32, 0)
        presenter.frames[frame].scratch.storeI64(
            40,
            swapchain.height * 4294967296 + swapchain.width
        )
        presenter.frames[frame].scratch.storeI64(
            48,
            if (pipeline.depthEnabled) 2 else 1
        )
        presenter.frames[frame].scratch.storePointer(
            56,
            nativePointerFromAddress(
                nativePointerAddress(
                    presenter.frames[frame].scratch.address
                ) + 120
            )
        )
        vkCmdBeginRenderPass(
            presenter.frames[frame].command.load(),
            presenter.frames[frame].scratch.address,
            0
        )
        presenter.frames[frame].scratch.storeI64(0, 0)
        presenter.frames[frame].scratch.storeI64(
            8,
            (graphicsUnsignedIntegerF32Bits(swapchain.height) & 4294967295) *
                4294967296 +
                (graphicsUnsignedIntegerF32Bits(swapchain.width) & 4294967295)
        )
        presenter.frames[frame].scratch.storeI64(
            16,
            1065353216 * 4294967296
        )
        vkCmdSetViewport(
            presenter.frames[frame].command.load(),
            0,
            1,
            presenter.frames[frame].scratch.address
        )
        presenter.frames[frame].scratch.storeI64(0, 0)
        presenter.frames[frame].scratch.storeI64(
            8,
            swapchain.height * 4294967296 + swapchain.width
        )
        vkCmdSetScissor(
            presenter.frames[frame].command.load(),
            0,
            1,
            presenter.frames[frame].scratch.address
        )
        vkCmdBindPipeline(
            presenter.frames[frame].command.load(),
            0,
            pipeline.handle
        )
        if (descriptorSet != 0) {
            presenter.frames[frame].scratch.storeI64(152, descriptorSet)
            vkCmdBindDescriptorSets(
                presenter.frames[frame].command.load(),
                0,
                pipeline.layout,
                0,
                1,
                nativePointerFromAddress(
                    nativePointerAddress(
                        presenter.frames[frame].scratch.address
                    ) + 152
                ),
                0,
                nativeNullPointer()
            )
        }
        if (pipeline.vertexStride > 0) {
            presenter.frames[frame].scratch.storeI64(136, vertexBuffer)
            presenter.frames[frame].scratch.storeI64(144, 0)
            vkCmdBindVertexBuffers(
                presenter.frames[frame].command.load(),
                0,
                1,
                nativePointerFromAddress(
                    nativePointerAddress(
                        presenter.frames[frame].scratch.address
                    ) + 136
                ),
                nativePointerFromAddress(
                    nativePointerAddress(
                        presenter.frames[frame].scratch.address
                    ) + 144
                )
            )
        }
        if (indexCount > 0) {
            vkCmdBindIndexBuffer(
                presenter.frames[frame].command.load(),
                indexBuffer,
                0,
                1
            )
            vkCmdDrawIndexed(
                presenter.frames[frame].command.load(),
                indexCount,
                instanceCount,
                0,
                0,
                0
            )
        } else {
            vkCmdDraw(
                presenter.frames[frame].command.load(),
                vertexCount,
                instanceCount,
                0,
                0
            )
        }
        vkCmdEndRenderPass(presenter.frames[frame].command.load())
        succeeded = vkEndCommandBuffer(
            presenter.frames[frame].command.load()
        ) == vulkanSuccess
    }
    if (succeeded) {
        succeeded = vkResetFences(
            this.handle,
            1,
            nativePointerFromAddress(
                nativePointerAddress(
                    presenter.frames[frame].scratch.address
                ) + 96
            )
        ) == vulkanSuccess
    }
    if (succeeded) {
        presenter.frames[frame].scratch.storeI64(104, 1024)
        presenter.frames[frame].scratch.storeI64(0, 4)
        presenter.frames[frame].scratch.storePointer(8, nativeNullPointer())
        presenter.frames[frame].scratch.storeI64(16, 1)
        presenter.frames[frame].scratch.storePointer(
            24,
            nativePointerFromAddress(
                nativePointerAddress(
                    presenter.frames[frame].scratch.address
                ) + 72
            )
        )
        presenter.frames[frame].scratch.storePointer(
            32,
            nativePointerFromAddress(
                nativePointerAddress(
                    presenter.frames[frame].scratch.address
                ) + 104
            )
        )
        presenter.frames[frame].scratch.storeI64(40, 1)
        presenter.frames[frame].scratch.storePointer(
            48,
            presenter.frames[frame].command.address
        )
        presenter.frames[frame].scratch.storeI64(56, 1)
        presenter.frames[frame].scratch.storePointer(
            64,
            nativePointerFromAddress(
                nativePointerAddress(
                    presenter.frames[frame].scratch.address
                ) + 88
            )
        )
        succeeded = vkQueueSubmit(
            this.queue,
            1,
            presenter.frames[frame].scratch.address,
            presenter.frames[frame].fence
        ) == vulkanSuccess
        if (succeeded) {
            presenter.frames[frame].inFlight = true
            submitted = true
        }
    }
    if (succeeded) {
        presenter.frames[frame].scratch.storeI64(112, swapchain.handle)
        presenter.frames[frame].scratch.storeI64(0, 1000001001)
        presenter.frames[frame].scratch.storePointer(8, nativeNullPointer())
        presenter.frames[frame].scratch.storeI64(16, 1)
        presenter.frames[frame].scratch.storePointer(
            24,
            nativePointerFromAddress(
                nativePointerAddress(
                    presenter.frames[frame].scratch.address
                ) + 88
            )
        )
        presenter.frames[frame].scratch.storeI64(32, 1)
        presenter.frames[frame].scratch.storePointer(
            40,
            nativePointerFromAddress(
                nativePointerAddress(
                    presenter.frames[frame].scratch.address
                ) + 112
            )
        )
        presenter.frames[frame].scratch.storePointer(
            48,
            nativePointerFromAddress(
                nativePointerAddress(
                    presenter.frames[frame].scratch.address
                ) + 80
            )
        )
        presenter.frames[frame].scratch.storePointer(56, nativeNullPointer())
        status = vkQueuePresentKHR(
            this.queue,
            presenter.frames[frame].scratch.address
        )
        val outcome = vulkanPresentStatus(status)
        succeeded = vulkanPresentSucceeded(outcome)
        recreateSwapchain = recreateSwapchain ||
            vulkanPresentNeedsRecreation(outcome)
    }
    if (submitted) {
        presenter.frameIndex = if (frame + 1 == presenter.frames.size)
            0 else frame + 1
    }
    vulkanPresentOutcome(
        succeeded,
        recreateSwapchain,
        status,
        submitted
    )
}

trusted fun VulkanDevice.presentPixelFrameOutcome(
    swapchain: VulkanSwapchain,
    var frame: VulkanPixelFrame,
    renderedSemaphores: array<int>,
    pixels: PixelBuffer
): int {
    var succeeded = this.valid() && swapchain.valid() && frame.valid() &&
        pixels.width == swapchain.width && pixels.height == swapchain.height
    var recreateSwapchain = false
    var status = if (succeeded) vulkanSuccess else -1
    var submitted = false
    frame.scratch.storeI64(96, frame.fence)
    val fence = nativePointerFromAddress(
        nativePointerAddress(frame.scratch.address) + 96
    )
    if (succeeded && frame.inFlight) {
        succeeded = vkWaitForFences(
            this.handle,
            1,
            fence,
            1,
            18446744073709551615
        ) == vulkanSuccess
        if (succeeded) frame.inFlight = false
    }
    if (succeeded) {
        succeeded = frame.staging.writePixels(pixels, swapchain.format)
    }
    frame.scratch.storeI64(72, frame.acquired)
    frame.scratch.storeI64(80, 0)
    val acquired = nativePointerFromAddress(
        nativePointerAddress(frame.scratch.address) + 72
    )
    val imageIndex = nativePointerFromAddress(
        nativePointerAddress(frame.scratch.address) + 80
    )
    if (succeeded) {
        status = vkAcquireNextImageKHR(
            this.handle,
            swapchain.handle,
            9223372036854775807,
            frame.acquired,
            0,
            imageIndex
        )
        val outcome = vulkanPresentStatus(status)
        succeeded = vulkanPresentSucceeded(outcome)
        recreateSwapchain = vulkanPresentNeedsRecreation(outcome)
    }
    val selectedIndex = frame.scratch.loadI64(80) & 4294967295
    if (selectedIndex < 0 || selectedIndex >= swapchain.images.size) {
        succeeded = false
    }
    if (selectedIndex < 0 || selectedIndex >= renderedSemaphores.size) {
        succeeded = false
    }
    frame.scratch.storeI64(
        88,
        if (succeeded) renderedSemaphores[selectedIndex] else 0
    )
    val rendered = nativePointerFromAddress(
        nativePointerAddress(frame.scratch.address) + 88
    )
    if (succeeded) {
        succeeded = vkResetCommandPool(
            this.handle,
            frame.commandPool,
            0
        ) == vulkanSuccess
    }
    if (succeeded) {
        frame.scratch.storeI64(0, 42)
        frame.scratch.storePointer(8, nativeNullPointer())
        frame.scratch.storeI64(16, 1)
        frame.scratch.storePointer(24, nativeNullPointer())
        succeeded = vkBeginCommandBuffer(
            frame.command.load(),
            frame.scratch.address
        ) == vulkanSuccess
    }
    if (succeeded) {
        val image = swapchain.images[selectedIndex]
        vulkanStoreImageBarrier(
            frame.scratch.address,
            image,
            0,
            7,
            0,
            4096
        )
        vkCmdPipelineBarrier(
            frame.command.load(),
            1,
            4096,
            0,
            0,
            nativeNullPointer(),
            0,
            nativeNullPointer(),
            1,
            frame.scratch.address
        )
        frame.scratch.storeI64(0, 0)
        frame.scratch.storeI64(8, 0)
        frame.scratch.storeI64(16, 1)
        frame.scratch.storeI64(24, 4294967296)
        frame.scratch.storeI64(32, 0)
        frame.scratch.storeI64(40, swapchain.width * 4294967296)
        frame.scratch.storeI64(48, 4294967296 + swapchain.height)
        vkCmdCopyBufferToImage(
            frame.command.load(),
            frame.staging.handle,
            image,
            7,
            1,
            frame.scratch.address
        )
        vulkanStoreImageBarrier(
            frame.scratch.address,
            image,
            7,
            1000001002,
            4096,
            0
        )
        vkCmdPipelineBarrier(
            frame.command.load(),
            4096,
            8192,
            0,
            0,
            nativeNullPointer(),
            0,
            nativeNullPointer(),
            1,
            frame.scratch.address
        )
        succeeded = vkEndCommandBuffer(
            frame.command.load()
        ) == vulkanSuccess
    }
    if (succeeded) {
        succeeded = vkResetFences(
            this.handle,
            1,
            fence
        ) == vulkanSuccess
    }
    if (succeeded) {
        frame.scratch.storeI64(104, 4096)
        frame.scratch.storeI64(0, 4)
        frame.scratch.storePointer(8, nativeNullPointer())
        frame.scratch.storeI64(16, 1)
        frame.scratch.storePointer(24, acquired)
        frame.scratch.storePointer(
            32,
            nativePointerFromAddress(
                nativePointerAddress(frame.scratch.address) + 104
            )
        )
        frame.scratch.storeI64(40, 1)
        frame.scratch.storePointer(48, frame.command.address)
        frame.scratch.storeI64(56, 1)
        frame.scratch.storePointer(64, rendered)
        succeeded = vkQueueSubmit(
            this.queue,
            1,
            frame.scratch.address,
            frame.fence
        ) == vulkanSuccess
        if (succeeded) {
            frame.inFlight = true
            submitted = true
        }
    }
    if (succeeded) {
        frame.scratch.storeI64(112, swapchain.handle)
        frame.scratch.storeI64(0, 1000001001)
        frame.scratch.storePointer(8, nativeNullPointer())
        frame.scratch.storeI64(16, 1)
        frame.scratch.storePointer(24, rendered)
        frame.scratch.storeI64(32, 1)
        frame.scratch.storePointer(
            40,
            nativePointerFromAddress(
                nativePointerAddress(frame.scratch.address) + 112
            )
        )
        frame.scratch.storePointer(48, imageIndex)
        frame.scratch.storePointer(56, nativeNullPointer())
        status = vkQueuePresentKHR(this.queue, frame.scratch.address)
        val outcome = vulkanPresentStatus(status)
        succeeded = vulkanPresentSucceeded(outcome)
        recreateSwapchain = recreateSwapchain ||
            vulkanPresentNeedsRecreation(outcome)
    }
    vulkanPresentOutcome(
        succeeded,
        recreateSwapchain,
        status,
        submitted
    )
}

trusted fun VulkanDevice.presentPixelsOutcome(
    swapchain: VulkanSwapchain,
    var presenter: VulkanPixelPresenter,
    pixels: PixelBuffer
): int {
    var succeeded = this.valid() && swapchain.valid() && presenter.valid() &&
        pixels.width == presenter.width && pixels.height == presenter.height &&
        presenter.width == swapchain.width &&
        presenter.height == swapchain.height &&
        presenter.format == swapchain.format
    var outcome = vulkanPresentOutcome(false, false, -1)
    if (succeeded) {
        outcome = this.presentPixelFrameOutcome(
            swapchain,
            presenter.frames[presenter.frameIndex],
            presenter.rendered,
            pixels
        )
    }
    if (vulkanPresentWasSubmitted(outcome)) {
        presenter.frameIndex = if (
            presenter.frameIndex + 1 == presenter.frames.size
        ) 0 else presenter.frameIndex + 1
    }
    outcome
}

trusted fun VulkanDevice.presentPixels(
    swapchain: VulkanSwapchain,
    var presenter: VulkanPixelPresenter,
    pixels: PixelBuffer
): bool = vulkanPresentSucceeded(
    this.presentPixelsOutcome(
        swapchain,
        presenter,
        pixels
    )
)
