fun vulkanVersionMajor(version: int): int = (version >>> 22) & 127
fun vulkanVersionMinor(version: int): int = (version >>> 12) & 1023
fun vulkanVersionPatch(version: int): int = version & 4095

trusted fun vulkanLoaderVersion(): int {
    val output = nativeI64Cell(0)
    val status = vkEnumerateInstanceVersion(output.address)
    if (status == vulkanSuccess) output.load() & 4294967295
    else vulkanApiVersion10
}

trusted fun vulkanBufferPointer(
    buffer: NativeByteBuffer,
    offset: int
): i64* = NativePointerCell(buffer.pointerAt(offset), false, false).load()

trusted fun vulkanCopyCString(
    source: NativeByteBuffer,
    offset: int,
    maximum: int
): string {
    var length = 0
    while (length < maximum && source.load(offset + length) != 0) {
        length = length + 1
    }
    val output = nativeByteBuffer(length + 1)
    var index = 0
    while (index < length) {
        output.store(index, source.load(offset + index))
        index = index + 1
    }
    output.store(length, 0)
    output.adoptString(length)
}

trusted fun vulkanApplicationInfo(
    name: string,
    requestedVersion: int
): NativeByteBuffer {
    val info = nativeByteBuffer(48)
    info.storeI64(0, vulkanStructureApplicationInfo)
    info.storePointer(8, nativeNullPointer())
    info.storePointer(
        16,
        nativePointerFromAddress(nativeCStringAddress(name))
    )
    info.storeI64(24, 1)
    info.storePointer(
        32,
        nativePointerFromAddress(nativeCStringAddress("abla-graphics"))
    )
    info.storeI64(
        40,
        (requestedVersion & 4294967295) * 4294967296 + 1
    )
    info
}

trusted fun vulkanInstanceCreateInfo(
    application: NativeByteBuffer
): NativeByteBuffer {
    val info = nativeByteBuffer(64)
    info.storeI64(0, vulkanStructureInstanceCreateInfo)
    info.storePointer(8, nativeNullPointer())
    info.storeI64(16, 0)
    info.storePointer(24, application.address)
    info.storeI64(32, 0)
    info.storePointer(40, nativeNullPointer())
    info.storeI64(48, 0)
    info.storePointer(56, nativeNullPointer())
    info
}

trusted fun vulkanX11InstanceCreateInfo(
    application: NativeByteBuffer,
    extensions: NativeByteBuffer
): NativeByteBuffer {
    val info = vulkanInstanceCreateInfo(application)
    info.storeI64(48, 2)
    info.storePointer(56, extensions.address)
    info
}

resource class VulkanInstance(var handle: i64*, val apiVersion: int) {
    trusted fun valid(): bool = !pointerIsNull(this.handle)

    trusted fun drop(): void {
        if (this.valid()) {
            vkDestroyInstance(this.handle, nativeNullPointer())
            this.handle = nativeNullPointer()
        }
        return
    }
}

trusted fun vulkanInstance(
    applicationName: string = "Abla Graphics",
    requestedVersion: int = vulkanApiVersion14
): VulkanInstance {
    val loaderVersion = vulkanLoaderVersion()
    var selectedVersion = requestedVersion
    if (selectedVersion > loaderVersion) selectedVersion = loaderVersion
    if (selectedVersion < vulkanApiVersion10) {
        selectedVersion = vulkanApiVersion10
    }
    val application = vulkanApplicationInfo(
        applicationName,
        selectedVersion
    )
    val createInfo = vulkanInstanceCreateInfo(application)
    val output = nativePointerCell(nativeNullPointer())
    val status = vkCreateInstance(
        createInfo.address,
        nativeNullPointer(),
        output.address
    )
    val handle = if (status == vulkanSuccess)
        output.load()
    else nativeNullPointer()
    VulkanInstance(handle, selectedVersion)
}

trusted fun vulkanX11Instance(
    applicationName: string = "Abla Graphics",
    requestedVersion: int = vulkanApiVersion14
): VulkanInstance {
    val loaderVersion = vulkanLoaderVersion()
    var selectedVersion = requestedVersion
    if (selectedVersion > loaderVersion) selectedVersion = loaderVersion
    if (selectedVersion < vulkanApiVersion10) {
        selectedVersion = vulkanApiVersion10
    }
    val application = vulkanApplicationInfo(
        applicationName,
        selectedVersion
    )
    val extensions = nativeByteBuffer(16)
    extensions.storePointer(
        0,
        nativePointerFromAddress(nativeCStringAddress("VK_KHR_surface"))
    )
    extensions.storePointer(
        8,
        nativePointerFromAddress(nativeCStringAddress("VK_KHR_xlib_surface"))
    )
    val createInfo = vulkanX11InstanceCreateInfo(application, extensions)
    val output = nativePointerCell(nativeNullPointer())
    val status = vkCreateInstance(
        createInfo.address,
        nativeNullPointer(),
        output.address
    )
    val handle = if (status == vulkanSuccess)
        output.load()
    else nativeNullPointer()
    VulkanInstance(handle, selectedVersion)
}

resource class VulkanX11Surface(
    var handle: int,
    var nativeDisplay: i64*,
    var instance: i64*,
    val visual: int,
    var width: int,
    var height: int
) {
    trusted fun valid(): bool =
        this.handle != 0 &&
        !pointerIsNull(this.nativeDisplay) &&
        !pointerIsNull(this.instance)

    trusted fun drop(): void {
        if (this.handle != 0 && !pointerIsNull(this.instance)) {
            vkDestroySurfaceKHR(
                this.instance,
                this.handle,
                nativeNullPointer()
            )
        }
        if (!pointerIsNull(this.nativeDisplay)) {
            XCloseDisplay(this.nativeDisplay)
        }
        this.handle = 0
        this.nativeDisplay = nativeNullPointer()
        this.instance = nativeNullPointer()
        return
    }
}

trusted fun vulkanX11Surface(
    instance: VulkanInstance,
    window: X11Window
): VulkanX11Surface {
    var nativeDisplay = nativeNullPointer()
    var surface = 0
    if (instance.valid() && window.valid() && window.visual != 0) {
        nativeDisplay = XOpenDisplay(nativeNullPointer())
    }
    if (!pointerIsNull(nativeDisplay)) {
        val createInfo = nativeByteBuffer(40)
        createInfo.storeI64(0, 1000004000)
        createInfo.storePointer(8, nativeNullPointer())
        createInfo.storeI64(16, 0)
        createInfo.storePointer(24, nativeDisplay)
        createInfo.storeI64(32, window.identifier)
        val output = nativeI64Cell(0)
        if (vkCreateXlibSurfaceKHR(
            instance.handle,
            createInfo.address,
            nativeNullPointer(),
            output.address
        ) == vulkanSuccess) {
            surface = output.load()
        }
    }
    if (surface == 0 && !pointerIsNull(nativeDisplay)) {
        XCloseDisplay(nativeDisplay)
        nativeDisplay = nativeNullPointer()
    }
    VulkanX11Surface(
        surface,
        nativeDisplay,
        instance.handle,
        window.visual,
        window.width,
        window.height
    )
}

class VulkanSurfaceCapabilities(
    val valid: bool,
    val minimumImages: int,
    val maximumImages: int,
    val width: int,
    val height: int,
    val supportedUsage: int,
    val currentTransform: int,
    val supportedCompositeAlpha: int
)

trusted fun VulkanAdapter.supportsSurface(
    surface: VulkanX11Surface,
    queueFamily: int = this.graphicsQueueFamily()
): bool {
    var supported = false
    var xlibSupported = 0
    if (surface.valid() && queueFamily >= 0) {
        xlibSupported = vkGetPhysicalDeviceXlibPresentationSupportKHR(
            this.handle,
            queueFamily,
            surface.nativeDisplay,
            surface.visual
        )
    }
    if (surface.valid() && queueFamily >= 0 && xlibSupported != 0) {
        val output = nativeI64Cell(0)
        supported = vkGetPhysicalDeviceSurfaceSupportKHR(
            this.handle,
            queueFamily,
            surface.handle,
            output.address
        ) == vulkanSuccess && (output.load() & 4294967295) != 0
    }
    supported
}

trusted fun VulkanAdapter.surfaceCapabilities(
    surface: VulkanX11Surface
): VulkanSurfaceCapabilities {
    val bytes = nativeByteBuffer(64)
    var status = -1
    if (surface.valid()) {
        status = vkGetPhysicalDeviceSurfaceCapabilitiesKHR(
            this.handle,
            surface.handle,
            bytes.address
        )
    }
    VulkanSurfaceCapabilities(
        status == vulkanSuccess,
        bytes.loadI64(0) & 4294967295,
        (bytes.loadI64(0) >>> 32) & 4294967295,
        bytes.loadI64(8) & 4294967295,
        (bytes.loadI64(8) >>> 32) & 4294967295,
        bytes.loadI64(48) & 4294967295,
        bytes.loadI64(40) & 4294967295,
        (bytes.loadI64(40) >>> 32) & 4294967295
    )
}

class VulkanAdapter(
    val handle: i64*,
    val name: string,
    val apiVersion: int,
    val driverVersion: int,
    val vendor: int,
    val device: int,
    val kind: int
)

trusted fun VulkanInstance.adapters(): array<VulkanAdapter> {
    val result: array<VulkanAdapter> = []
    if (this.valid()) {
        val count = nativeI64Cell(0)
        var status = vkEnumeratePhysicalDevices(
            this.handle,
            count.address,
            nativeNullPointer()
        )
        var measured = count.load() & 4294967295
        if (measured > 256) measured = 0
        if (status == vulkanSuccess && measured > 0) {
            val handles = nativeByteBuffer(measured * 8)
            status = vkEnumeratePhysicalDevices(
                this.handle,
                count.address,
                handles.address
            )
            measured = count.load() & 4294967295
            var index = 0
            while (status == vulkanSuccess && index < measured) {
                val handle = vulkanBufferPointer(handles, index * 8)
                val properties = nativeByteBuffer(1024)
                vkGetPhysicalDeviceProperties(
                    handle,
                    properties.address
                )
                result.append(VulkanAdapter(
                    handle,
                    vulkanCopyCString(properties, 20, 256),
                    properties.loadI64(0) & 4294967295,
                    (properties.loadI64(0) >>> 32) & 4294967295,
                    properties.loadI64(8) & 4294967295,
                    (properties.loadI64(8) >>> 32) & 4294967295,
                    properties.loadI64(16) & 4294967295
                ))
                index = index + 1
            }
        }
    }
    result
}

trusted fun VulkanAdapter.graphicsQueueFamily(): int {
    val count = nativeI64Cell(0)
    vkGetPhysicalDeviceQueueFamilyProperties(
        this.handle,
        count.address,
        nativeNullPointer()
    )
    var measured = count.load() & 4294967295
    if (measured > 256) measured = 0
    var selected = -1
    if (measured > 0) {
        val properties = nativeByteBuffer(measured * 24)
        vkGetPhysicalDeviceQueueFamilyProperties(
            this.handle,
            count.address,
            properties.address
        )
        measured = count.load() & 4294967295
        var index = 0
        while (selected < 0 && index < measured) {
            val flags = properties.loadI64(index * 24) & 4294967295
            val queues =
                (properties.loadI64(index * 24) >>> 32) & 4294967295
            if ((flags & 1) != 0 && queues > 0) selected = index
            index = index + 1
        }
    }
    selected
}

trusted fun VulkanAdapter.queueFamilyFlags(queueFamily: int): int {
    val count = nativeI64Cell(0)
    vkGetPhysicalDeviceQueueFamilyProperties(
        this.handle,
        count.address,
        nativeNullPointer()
    )
    var measured = count.load() & 4294967295
    var flags = 0
    if (queueFamily >= 0 && queueFamily < measured && measured <= 256) {
        val properties = nativeByteBuffer(measured * 24)
        vkGetPhysicalDeviceQueueFamilyProperties(
            this.handle,
            count.address,
            properties.address
        )
        measured = count.load() & 4294967295
        if (queueFamily < measured) {
            flags = properties.loadI64(queueFamily * 24) & 4294967295
        }
    }
    flags
}

trusted fun VulkanAdapter.capabilities(): GraphicsCapabilities {
    val properties = nativeByteBuffer(1024)
    val deviceFeatures = nativeByteBuffer(224)
    vkGetPhysicalDeviceProperties(this.handle, properties.address)
    vkGetPhysicalDeviceFeatures(this.handle, deviceFeatures.address)
    val queueFamily = this.graphicsQueueFamily()
    val queueFlags = this.queueFamilyFlags(queueFamily)
    var features = graphicsFeatureSampledTextures |
        graphicsFeatureDepthTextures | graphicsFeatureComparisonSamplers |
        graphicsFeatureViewFormatReinterpretation
    if ((queueFlags & 2) != 0) {
        features = features | graphicsFeatureCompute |
            graphicsFeatureStorageBuffers
    }
    val maximumAnisotropy = graphicsPositiveF32Floor(
        properties.loadI64(568) & 4294967295
    )
    if (((deviceFeatures.loadI64(72) >>> 32) & 4294967295) != 0 &&
        maximumAnisotropy > 1) {
        features = features | graphicsFeatureSamplerAnisotropy
    }
    GraphicsCapabilities(
        features,
        GraphicsLimits(
            // VkPhysicalDeviceProperties::limits begins at byte 296 on the
            // supported 64-bit ABI; these are uint32 fields within it.
            properties.loadI64(300) & 4294967295,
            properties.loadI64(324) & 4294967295,
            properties.loadI64(516) & 4294967295,
            properties.loadI64(532) & 4294967295,
            properties.loadI64(528) & 4294967295,
            maximumAnisotropy,
            properties.loadI64(520) & 4294967295,
            properties.loadI64(524) & 4294967295,
            properties.loadI64(536) & 4294967295,
            properties.loadI64(540) & 4294967295
        ),
        GraphicsVersion(
            vulkanVersionMajor(this.apiVersion),
            vulkanVersionMinor(this.apiVersion),
            vulkanVersionPatch(this.apiVersion)
        )
    )
}

trusted fun VulkanAdapter.enabledDeviceFeatures(): NativeByteBuffer {
    val available = nativeByteBuffer(224)
    val enabled = nativeByteBuffer(224)
    vkGetPhysicalDeviceFeatures(this.handle, available.address)
    var index = 0
    while (index < enabled.capacity) {
        enabled.store(index, 0)
        index = index + 1
    }
    if (((available.loadI64(72) >>> 32) & 4294967295) != 0) {
        enabled.store(76, 1)
    }
    enabled
}

resource class VulkanDevice(
    var handle: i64*,
    var queue: i64*,
    val queueFamily: int,
    val apiVersion: int,
    val physicalDevice: i64*,
    var transferPool: int,
    val transferCommand: NativePointerCell,
    val transferScratch: NativeByteBuffer
) {
    trusted fun valid(): bool =
        !pointerIsNull(this.handle) && !pointerIsNull(this.queue)

    trusted fun waitIdle(): bool =
        this.valid() && vkDeviceWaitIdle(this.handle) == vulkanSuccess

    trusted fun transferValid(): bool = this.valid() &&
        this.transferPool != 0 &&
        !pointerIsNull(this.transferCommand.load()) &&
        !this.transferScratch.closed && this.transferScratch.capacity >= 72

    trusted fun initializeTransfer(): bool {
        var succeeded = this.valid() && this.transferPool == 0 &&
            !this.transferCommand.closed && !this.transferScratch.closed
        if (succeeded) {
            val poolInfo = nativeByteBuffer(24)
            poolInfo.storeI64(0, 39)
            poolInfo.storePointer(8, nativeNullPointer())
            poolInfo.storeI64(
                16,
                (this.queueFamily & 4294967295) * 4294967296 + 2
            )
            val output = nativeI64Cell(0)
            succeeded = vkCreateCommandPool(
                this.handle,
                poolInfo.address,
                nativeNullPointer(),
                output.address
            ) == vulkanSuccess
            if (succeeded) this.transferPool = output.load()
        }
        if (succeeded) {
            val allocateInfo = nativeByteBuffer(32)
            allocateInfo.storeI64(0, 40)
            allocateInfo.storePointer(8, nativeNullPointer())
            allocateInfo.storeI64(16, this.transferPool)
            allocateInfo.storeI64(24, 4294967296)
            succeeded = vkAllocateCommandBuffers(
                this.handle,
                allocateInfo.address,
                this.transferCommand.address
            ) == vulkanSuccess
        }
        if (!succeeded && this.transferPool != 0) {
            vkDestroyCommandPool(
                this.handle,
                this.transferPool,
                nativeNullPointer()
            )
            this.transferPool = 0
            this.transferCommand.store(nativeNullPointer())
        }
        succeeded
    }

    trusted fun beginTransfer(): bool {
        var succeeded = this.transferValid() && vkResetCommandPool(
            this.handle,
            this.transferPool,
            0
        ) == vulkanSuccess
        if (succeeded) {
            this.transferScratch.storeI64(0, 42)
            this.transferScratch.storePointer(8, nativeNullPointer())
            this.transferScratch.storeI64(16, 1)
            this.transferScratch.storePointer(24, nativeNullPointer())
            succeeded = vkBeginCommandBuffer(
                this.transferCommand.load(),
                this.transferScratch.address
            ) == vulkanSuccess
        }
        succeeded
    }

    trusted fun submitTransfer(): bool {
        var succeeded = this.transferValid() && vkEndCommandBuffer(
            this.transferCommand.load()
        ) == vulkanSuccess
        if (succeeded) {
            this.transferScratch.storeI64(0, 4)
            this.transferScratch.storePointer(8, nativeNullPointer())
            this.transferScratch.storeI64(16, 0)
            this.transferScratch.storePointer(24, nativeNullPointer())
            this.transferScratch.storePointer(32, nativeNullPointer())
            this.transferScratch.storeI64(40, 1)
            this.transferScratch.storePointer(
                48,
                this.transferCommand.address
            )
            this.transferScratch.storeI64(56, 0)
            this.transferScratch.storePointer(64, nativeNullPointer())
            succeeded = vkQueueSubmit(
                this.queue,
                1,
                this.transferScratch.address,
                0
            ) == vulkanSuccess
        }
        if (succeeded) {
            succeeded = vkQueueWaitIdle(this.queue) == vulkanSuccess
        }
        succeeded
    }

    trusted fun copyBuffer(
        source: VulkanBuffer,
        destination: VulkanBuffer,
        copy: BufferCopyDescriptor
    ): bool {
        var succeeded = this.transferValid() && source.valid() &&
            destination.valid() && source.device == this.handle &&
            destination.device == this.handle &&
            copy.valid(source.size, destination.size) && this.beginTransfer()
        if (succeeded) {
            this.transferScratch.storeI64(0, copy.sourceOffset)
            this.transferScratch.storeI64(8, copy.destinationOffset)
            this.transferScratch.storeI64(16, copy.resolvedSize(source.size))
            vkCmdCopyBuffer(
                this.transferCommand.load(),
                source.handle,
                destination.handle,
                1,
                this.transferScratch.address
            )
            this.transferScratch.storeI64(0, 46)
            this.transferScratch.storePointer(8, nativeNullPointer())
            this.transferScratch.storeI64(16, 8192 * 4294967296 + 4096)
            vkCmdPipelineBarrier(
                this.transferCommand.load(),
                4096,
                16384,
                0,
                1,
                this.transferScratch.address,
                0,
                nativeNullPointer(),
                0,
                nativeNullPointer()
            )
            succeeded = this.submitTransfer()
        }
        succeeded
    }

    trusted fun fillBuffer(
        buffer: VulkanBuffer,
        descriptor: BufferFillDescriptor
    ): bool {
        var succeeded = this.transferValid() && buffer.valid() &&
            buffer.device == this.handle && descriptor.valid(buffer.size) &&
            this.beginTransfer()
        if (succeeded) {
            vkCmdFillBuffer(
                this.transferCommand.load(),
                buffer.handle,
                descriptor.offset,
                descriptor.resolvedSize(buffer.size),
                descriptor.value
            )
            this.transferScratch.storeI64(0, 46)
            this.transferScratch.storePointer(8, nativeNullPointer())
            this.transferScratch.storeI64(16, 8192 * 4294967296 + 4096)
            vkCmdPipelineBarrier(
                this.transferCommand.load(),
                4096,
                16384,
                0,
                1,
                this.transferScratch.address,
                0,
                nativeNullPointer(),
                0,
                nativeNullPointer()
            )
            succeeded = this.submitTransfer()
        }
        succeeded
    }

    trusted fun copyTexture(
        source: VulkanTexture,
        sourceDescriptor: TextureDescriptor,
        destination: VulkanTexture,
        destinationDescriptor: TextureDescriptor,
        copy: TextureCopyDescriptor
    ): bool {
        var succeeded = this.transferValid() && source.valid() &&
            destination.valid() && source.device == this.handle &&
            destination.device == this.handle &&
            copy.valid(sourceDescriptor, destinationDescriptor) &&
            copy.sourceMipLevel * 8 < source.layouts.capacity &&
            copy.destinationMipLevel * 8 < destination.layouts.capacity &&
            this.beginTransfer()
        var sourceFinalLayout = 1
        var destinationFinalLayout = 1
        if (succeeded) {
            val sourceOldLayout = source.layouts.loadI64(
                copy.sourceMipLevel * 8
            )
            val destinationOldLayout =
                destination.layouts.loadI64(copy.destinationMipLevel * 8)
            sourceFinalLayout = if (sourceOldLayout != 0) sourceOldLayout
                else if ((sourceDescriptor.usage & textureUsageSampled) != 0)
                    5
                else 1
            destinationFinalLayout = if (
                (destinationDescriptor.usage & textureUsageSampled) != 0
            ) 5 else 1
            vulkanStoreImageBarrier(
                this.transferScratch.address,
                source.image,
                sourceOldLayout,
                6,
                if (sourceOldLayout == 0) 0 else
                    vulkanTextureRestingAccess(
                        sourceDescriptor,
                        sourceOldLayout
                    ),
                2048,
                vulkanTextureAspect(sourceDescriptor.format, textureAspectAll),
                copy.sourceMipLevel
            )
            vkCmdPipelineBarrier(
                this.transferCommand.load(),
                if (sourceOldLayout == 0) 1 else 65536,
                4096,
                0,
                0,
                nativeNullPointer(),
                0,
                nativeNullPointer(),
                1,
                this.transferScratch.address
            )
            vulkanStoreImageBarrier(
                this.transferScratch.address,
                destination.image,
                destinationOldLayout,
                7,
                if (destinationOldLayout == 0) 0 else
                    vulkanTextureRestingAccess(
                        destinationDescriptor,
                        destinationOldLayout
                    ),
                4096,
                vulkanTextureAspect(
                    destinationDescriptor.format,
                    textureAspectAll
                ),
                copy.destinationMipLevel
            )
            vkCmdPipelineBarrier(
                this.transferCommand.load(),
                if (destinationOldLayout == 0) 1 else 65536,
                4096,
                0,
                0,
                nativeNullPointer(),
                0,
                nativeNullPointer(),
                1,
                this.transferScratch.address
            )
            val aspect = vulkanTextureAspect(
                sourceDescriptor.format,
                textureAspectAll
            )
            this.transferScratch.storeI64(
                0,
                copy.sourceMipLevel * 4294967296 + aspect
            )
            this.transferScratch.storeI64(8, 4294967296)
            this.transferScratch.storeI64(
                16,
                copy.sourceY * 4294967296 + copy.sourceX
            )
            this.transferScratch.storeI64(24, aspect * 4294967296)
            this.transferScratch.storeI64(32, copy.destinationMipLevel)
            this.transferScratch.storeI64(
                40,
                copy.destinationX * 4294967296 + 1
            )
            this.transferScratch.storeI64(48, copy.destinationY)
            this.transferScratch.storeI64(
                56,
                copy.resolvedHeight(sourceDescriptor) * 4294967296 +
                    copy.resolvedWidth(sourceDescriptor)
            )
            this.transferScratch.storeI64(64, 1)
            vkCmdCopyImage(
                this.transferCommand.load(),
                source.image,
                6,
                destination.image,
                7,
                1,
                this.transferScratch.address
            )
            vulkanStoreImageBarrier(
                this.transferScratch.address,
                source.image,
                6,
                sourceFinalLayout,
                2048,
                vulkanTextureRestingAccess(
                    sourceDescriptor,
                    sourceFinalLayout
                ),
                aspect,
                copy.sourceMipLevel
            )
            vkCmdPipelineBarrier(
                this.transferCommand.load(),
                4096,
                65536,
                0,
                0,
                nativeNullPointer(),
                0,
                nativeNullPointer(),
                1,
                this.transferScratch.address
            )
            vulkanStoreImageBarrier(
                this.transferScratch.address,
                destination.image,
                7,
                destinationFinalLayout,
                4096,
                vulkanTextureRestingAccess(
                    destinationDescriptor,
                    destinationFinalLayout
                ),
                aspect,
                copy.destinationMipLevel
            )
            vkCmdPipelineBarrier(
                this.transferCommand.load(),
                4096,
                65536,
                0,
                0,
                nativeNullPointer(),
                0,
                nativeNullPointer(),
                1,
                this.transferScratch.address
            )
            succeeded = this.submitTransfer()
            if (succeeded) {
                source.storeLayout(
                    copy.sourceMipLevel,
                    sourceFinalLayout
                )
                destination.storeLayout(
                    copy.destinationMipLevel,
                    destinationFinalLayout
                )
            }
        }
        succeeded
    }

    trusted fun drop(): void {
        if (!pointerIsNull(this.handle)) {
            vkDeviceWaitIdle(this.handle)
            if (this.transferPool != 0) {
                vkDestroyCommandPool(
                    this.handle,
                    this.transferPool,
                    nativeNullPointer()
                )
                this.transferPool = 0
                this.transferCommand.store(nativeNullPointer())
            }
            vkDestroyDevice(this.handle, nativeNullPointer())
            this.handle = nativeNullPointer()
            this.queue = nativeNullPointer()
        }
        this.transferCommand.close()
        this.transferScratch.close()
        return
    }
}

trusted fun VulkanAdapter.device(): VulkanDevice {
    val queueFamily = this.graphicsQueueFamily()
    var handle = nativeNullPointer()
    var queue = nativeNullPointer()
    if (queueFamily >= 0) {
        val enabledFeatures = this.enabledDeviceFeatures()
        val priority = nativeByteBuffer(8)
        priority.storeI64(0, 1065353216)
        val queueInfo = nativeByteBuffer(40)
        queueInfo.storeI64(0, 2)
        queueInfo.storePointer(8, nativeNullPointer())
        queueInfo.storeI64(
            16,
            (queueFamily & 4294967295) * 4294967296
        )
        queueInfo.storeI64(24, 1)
        queueInfo.storePointer(32, priority.address)

        val createInfo = nativeByteBuffer(72)
        createInfo.storeI64(0, 3)
        createInfo.storePointer(8, nativeNullPointer())
        createInfo.storeI64(16, 4294967296)
        createInfo.storePointer(24, queueInfo.address)
        createInfo.storeI64(32, 0)
        createInfo.storePointer(40, nativeNullPointer())
        createInfo.storeI64(48, 0)
        createInfo.storePointer(56, nativeNullPointer())
        createInfo.storePointer(64, enabledFeatures.address)

        val output = nativePointerCell(nativeNullPointer())
        val status = vkCreateDevice(
            this.handle,
            createInfo.address,
            nativeNullPointer(),
            output.address
        )
        if (status == vulkanSuccess) {
            handle = output.load()
            val queueOutput = nativePointerCell(nativeNullPointer())
            vkGetDeviceQueue(
                handle,
                queueFamily,
                0,
                queueOutput.address
            )
            queue = queueOutput.load()
        }
    }
    val result = VulkanDevice(
        handle,
        queue,
        queueFamily,
        this.apiVersion,
        this.handle,
        0,
        nativePointerCell(nativeNullPointer()),
        nativeByteBuffer(72)
    )
    if (result.valid()) result.initializeTransfer()
    result
}

resource class VulkanBuffer(
    val device: i64*,
    val physicalDevice: i64*,
    val queue: i64*,
    val queueFamily: int,
    var handle: int,
    var memory: int,
    val size: int,
    val mapped: NativePointerCell
) {
    fun valid(): bool =
        this.handle != 0 && this.memory != 0 && this.size > 0

    trusted fun readI64(offset: int = 0): int {
        var result = 0
        if (this.valid() && offset >= 0 && offset <= this.size - 8) {
            if (vkMapMemory(
                this.device,
                this.memory,
                0,
                this.size,
                0,
                this.mapped.address
            ) == vulkanSuccess) {
                result = ablaUnsafeLoadI64(
                    ablaUnsafePointerOffset(this.mapped.load(), offset)
                )
                vkUnmapMemory(this.device, this.memory)
            }
        }
        result
    }

    trusted fun writeI64(value: int, offset: int = 0): bool {
        var succeeded = false
        if (this.valid() && offset >= 0 && offset <= this.size - 8) {
            if (vkMapMemory(
                this.device,
                this.memory,
                0,
                this.size,
                0,
                this.mapped.address
            ) == vulkanSuccess) {
                ablaUnsafeStoreI64(
                    ablaUnsafePointerOffset(this.mapped.load(), offset),
                    value
                )
                vkUnmapMemory(this.device, this.memory)
                succeeded = true
            }
        }
        succeeded
    }

    trusted fun writePixels(
        pixels: PixelBuffer,
        format: int
    ): bool {
        val required = pixels.width * pixels.height * 4
        var succeeded = this.valid() && pixels.valid() &&
            required <= this.size &&
            (format == 37 || format == 43 || format == 44 || format == 50)
        if (succeeded) {
            succeeded = vkMapMemory(
                this.device,
                this.memory,
                0,
                required,
                0,
                this.mapped.address
            ) == vulkanSuccess
        }
        val destination = this.mapped.load()
        var pixel = 0
        val swapRedBlue = format == 44 || format == 50
        while (succeeded && pixel < pixels.width * pixels.height) {
            val offset = pixel * 4
            val red = pixels.storage.load(offset)
            val green = pixels.storage.load(offset + 1)
            val blue = pixels.storage.load(offset + 2)
            val alpha = pixels.storage.load(offset + 3)
            ablaUnsafeStoreU8(
                ablaUnsafePointerOffset(destination, offset),
                if (swapRedBlue) blue else red
            )
            ablaUnsafeStoreU8(
                ablaUnsafePointerOffset(destination, offset + 1),
                green
            )
            ablaUnsafeStoreU8(
                ablaUnsafePointerOffset(destination, offset + 2),
                if (swapRedBlue) red else blue
            )
            ablaUnsafeStoreU8(
                ablaUnsafePointerOffset(destination, offset + 3),
                alpha
            )
            pixel = pixel + 1
        }
        if (succeeded) {
            vkUnmapMemory(this.device, this.memory)
        }
        succeeded
    }

    trusted fun rgba8(format: int): int {
        var result = -1
        if (this.valid() && this.size >= 4 &&
            vkMapMemory(
                this.device,
                this.memory,
                0,
                4,
                0,
                this.mapped.address
            ) == vulkanSuccess) {
            val source = this.mapped.load()
            var red = ablaUnsafeLoadU8(source)
            val green = ablaUnsafeLoadU8(
                ablaUnsafePointerOffset(source, 1)
            )
            var blue = ablaUnsafeLoadU8(
                ablaUnsafePointerOffset(source, 2)
            )
            val alpha = ablaUnsafeLoadU8(
                ablaUnsafePointerOffset(source, 3)
            )
            if (format == 44 || format == 50) {
                val swap = red
                red = blue
                blue = swap
            }
            result = red + green * 256 + blue * 65536 +
                alpha * 16777216
            vkUnmapMemory(this.device, this.memory)
        }
        result
    }

    trusted fun writeBytes(
        source: BufferBytes,
        copy: BufferCopyDescriptor
    ): bool {
        var succeeded = this.valid() && source.valid() &&
            copy.valid(source.size, this.size)
        if (succeeded) {
            succeeded = vkMapMemory(
                this.device,
                this.memory,
                0,
                this.size,
                0,
                this.mapped.address
            ) == vulkanSuccess
        }
        if (succeeded) {
            ablaUnsafeCopyMemory(
                ablaUnsafePointerOffset(
                    this.mapped.load(),
                    copy.destinationOffset
                ),
                source.storage.pointerAt(copy.sourceOffset),
                copy.resolvedSize(source.size)
            )
            vkUnmapMemory(this.device, this.memory)
        }
        succeeded
    }

    trusted fun readBytes(
        var destination: BufferBytes,
        copy: BufferCopyDescriptor
    ): bool {
        var succeeded = this.valid() && destination.valid() &&
            copy.valid(this.size, destination.size)
        if (succeeded) {
            succeeded = vkMapMemory(
                this.device,
                this.memory,
                0,
                this.size,
                0,
                this.mapped.address
            ) == vulkanSuccess
        }
        if (succeeded) {
            ablaUnsafeCopyMemory(
                destination.storage.pointerAt(copy.destinationOffset),
                ablaUnsafePointerOffset(
                    this.mapped.load(),
                    copy.sourceOffset
                ),
                copy.resolvedSize(this.size)
            )
            vkUnmapMemory(this.device, this.memory)
        }
        succeeded
    }

    trusted fun drop(): void {
        if (this.handle != 0) {
            vkDestroyBuffer(
                this.device,
                this.handle,
                nativeNullPointer()
            )
            this.handle = 0
        }
        if (this.memory != 0) {
            vkFreeMemory(
                this.device,
                this.memory,
                nativeNullPointer()
            )
            this.memory = 0
        }
        this.mapped.close()
        return
    }
}

fun vulkanSamplerAddress(value: int): int {
    var result = 2
    if (value == samplerAddressRepeat) result = 0
    else if (value == samplerAddressMirrorRepeat) result = 1
    result
}

resource class VulkanSampler(
    val device: i64*,
    var handle: int
) {
    fun valid(): bool = !pointerIsNull(this.device) && this.handle != 0

    trusted fun drop(): void {
        if (this.handle != 0 && !pointerIsNull(this.device)) {
            vkDestroySampler(this.device, this.handle, nativeNullPointer())
            this.handle = 0
        }
        return
    }
}

resource class VulkanTextureBinding(
    val device: i64*,
    var descriptorSetLayout: int,
    var descriptorPool: int,
    var descriptorSet: int,
    val view: VulkanTextureView
) {
    fun valid(): bool = !pointerIsNull(this.device) &&
        this.descriptorSetLayout != 0 && this.descriptorPool != 0 &&
        this.descriptorSet != 0 && this.view.valid()

    trusted fun drop(): void {
        if (this.descriptorPool != 0 && !pointerIsNull(this.device)) {
            vkDestroyDescriptorPool(
                this.device,
                this.descriptorPool,
                nativeNullPointer()
            )
            this.descriptorPool = 0
            this.descriptorSet = 0
        }
        if (this.descriptorSetLayout != 0 &&
            !pointerIsNull(this.device)) {
            vkDestroyDescriptorSetLayout(
                this.device,
                this.descriptorSetLayout,
                nativeNullPointer()
            )
            this.descriptorSetLayout = 0
        }
        this.view.drop()
        return
    }
}

trusted fun VulkanDevice.sampler(
    descriptor: SamplerDescriptor
): VulkanSampler {
    var handle = 0
    var capabilities = GraphicsCapabilities()
    if (this.valid()) {
        capabilities = VulkanAdapter(
            this.physicalDevice,
            "",
            this.apiVersion,
            0,
            0,
            0,
            0
        ).capabilities()
    }
    if (this.valid() && descriptor.valid() &&
        graphicsSamplerAnisotropySupported(
            capabilities,
            descriptor.maximumAnisotropy
        )) {
        val createInfo = nativeByteBuffer(80)
        createInfo.storeI64(0, 31)
        createInfo.storePointer(8, nativeNullPointer())
        createInfo.storeI64(16, descriptor.magFilter * 4294967296)
        createInfo.storeI64(
            24,
            descriptor.mipmapFilter * 4294967296 + descriptor.minFilter
        )
        createInfo.storeI64(
            32,
            vulkanSamplerAddress(descriptor.addressV) * 4294967296 +
                vulkanSamplerAddress(descriptor.addressU)
        )
        createInfo.storeI64(40, vulkanSamplerAddress(descriptor.addressW))
        createInfo.storeI64(
            48,
            graphicsUnsignedIntegerF32Bits(
                descriptor.maximumAnisotropy
            ) * 4294967296 +
                (if (descriptor.maximumAnisotropy > 1) 1 else 0)
        )
        var compareEnable = 0
        var compareOperation = 0
        if (descriptor.compare != compareFunctionUndefined) {
            compareEnable = 1
            compareOperation = descriptor.compare - 1
        }
        createInfo.storeI64(
            56,
            compareOperation * 4294967296 + compareEnable
        )
        createInfo.storeI64(
            64,
            graphicsUnsignedIntegerF32Bits(descriptor.lodMaximum) *
                4294967296 +
                graphicsUnsignedIntegerF32Bits(descriptor.lodMinimum)
        )
        createInfo.storeI64(72, 0)
        val output = nativeI64Cell(0)
        if (vkCreateSampler(
            this.handle,
            createInfo.address,
            nativeNullPointer(),
            output.address
        ) == vulkanSuccess) handle = output.load()
    }
    VulkanSampler(this.handle, handle)
}

resource class VulkanShaderModule(
    val device: i64*,
    var handle: int
) {
    fun valid(): bool = !pointerIsNull(this.device) && this.handle != 0

    trusted fun drop(): void {
        if (this.handle != 0 && !pointerIsNull(this.device)) {
            vkDestroyShaderModule(
                this.device,
                this.handle,
                nativeNullPointer()
            )
            this.handle = 0
        }
        return
    }
}

trusted fun VulkanDevice.shaderModule(
    module: SpirvModule
): VulkanShaderModule {
    var handle = 0
    if (this.valid() && module.valid()) {
        val code = nativeByteBuffer(module.words.size * 4)
        var index = 0
        while (index < module.words.size) {
            val word = module.words[index]
            code.store(index * 4, word & 255)
            code.store(index * 4 + 1, (word >> 8) & 255)
            code.store(index * 4 + 2, (word >> 16) & 255)
            code.store(index * 4 + 3, (word >> 24) & 255)
            index = index + 1
        }
        val createInfo = nativeByteBuffer(40)
        createInfo.storeI64(0, 16)
        createInfo.storePointer(8, nativeNullPointer())
        createInfo.storeI64(16, 0)
        createInfo.storeI64(24, module.words.size * 4)
        createInfo.storePointer(32, code.address)
        val output = nativeI64Cell(0)
        if (vkCreateShaderModule(
            this.handle,
            createInfo.address,
            nativeNullPointer(),
            output.address
        ) == vulkanSuccess) handle = output.load()
    }
    VulkanShaderModule(this.handle, handle)
}

resource class VulkanComputePipeline(
    val device: i64*,
    val queue: i64*,
    val queueFamily: int,
    var layout: int,
    var handle: int,
    var commandPool: int,
    val command: NativePointerCell,
    val scratch: NativeByteBuffer,
    var descriptorSetLayout: int,
    var descriptorPool: int,
    var descriptorSet: int
) {
    fun valid(): bool = !pointerIsNull(this.device) &&
        !pointerIsNull(this.queue) && this.queueFamily >= 0 &&
        this.layout != 0 && this.handle != 0 && this.commandPool != 0 &&
        !this.command.closed && !pointerIsNull(this.command.load()) &&
        !this.scratch.closed && this.scratch.capacity >= 72

    trusted fun dispatch(x: int, y: int = 1, z: int = 1): bool {
        var succeeded = this.valid() && x > 0 && y > 0 && z > 0 &&
            x <= 65535 && y <= 65535 && z <= 65535
        if (succeeded) succeeded = vkResetCommandPool(
            this.device,
            this.commandPool,
            0
        ) == vulkanSuccess
        if (succeeded) {
            this.scratch.storeI64(0, 42)
            this.scratch.storePointer(8, nativeNullPointer())
            this.scratch.storeI64(16, 1)
            this.scratch.storePointer(24, nativeNullPointer())
            succeeded = vkBeginCommandBuffer(
                this.command.load(),
                this.scratch.address
            ) == vulkanSuccess
        }
        if (succeeded) {
            vkCmdBindPipeline(this.command.load(), 1, this.handle)
            if (this.descriptorSet != 0) {
                this.scratch.storeI64(0, this.descriptorSet)
                vkCmdBindDescriptorSets(
                    this.command.load(),
                    1,
                    this.layout,
                    0,
                    1,
                    this.scratch.address,
                    0,
                    nativeNullPointer()
                )
            }
            vkCmdDispatch(this.command.load(), x, y, z)
            succeeded = vkEndCommandBuffer(
                this.command.load()
            ) == vulkanSuccess
        }
        if (succeeded) {
            this.scratch.storeI64(0, 4)
            this.scratch.storePointer(8, nativeNullPointer())
            this.scratch.storeI64(16, 0)
            this.scratch.storePointer(24, nativeNullPointer())
            this.scratch.storePointer(32, nativeNullPointer())
            this.scratch.storeI64(40, 1)
            this.scratch.storePointer(48, this.command.address)
            this.scratch.storeI64(56, 0)
            this.scratch.storePointer(64, nativeNullPointer())
            succeeded = vkQueueSubmit(
                this.queue,
                1,
                this.scratch.address,
                0
            ) == vulkanSuccess
        }
        if (succeeded) succeeded =
            vkQueueWaitIdle(this.queue) == vulkanSuccess
        succeeded
    }

    trusted fun drop(): void {
        if (!pointerIsNull(this.queue)) vkQueueWaitIdle(this.queue)
        if (this.handle != 0 && !pointerIsNull(this.device)) {
            vkDestroyPipeline(this.device, this.handle, nativeNullPointer())
            this.handle = 0
        }
        if (this.commandPool != 0 && !pointerIsNull(this.device)) {
            vkDestroyCommandPool(
                this.device,
                this.commandPool,
                nativeNullPointer()
            )
            this.commandPool = 0
            this.command.store(nativeNullPointer())
        }
        if (this.descriptorPool != 0 && !pointerIsNull(this.device)) {
            vkDestroyDescriptorPool(
                this.device,
                this.descriptorPool,
                nativeNullPointer()
            )
            this.descriptorPool = 0
            this.descriptorSet = 0
        }
        if (this.layout != 0 && !pointerIsNull(this.device)) {
            vkDestroyPipelineLayout(
                this.device,
                this.layout,
                nativeNullPointer()
            )
            this.layout = 0
        }
        if (this.descriptorSetLayout != 0 && !pointerIsNull(this.device)) {
            vkDestroyDescriptorSetLayout(
                this.device,
                this.descriptorSetLayout,
                nativeNullPointer()
            )
            this.descriptorSetLayout = 0
        }
        this.command.close()
        this.scratch.close()
        return
    }
}

trusted fun VulkanDevice.computePipelineNative(
    shader: VulkanShaderModule,
    storageHandle: int = 0,
    storageSize: int = 0
): VulkanComputePipeline {
    var layout = 0
    var pipeline = 0
    var commandPool = 0
    var command = nativePointerCell(nativeNullPointer())
    var scratch = nativeByteBuffer(72)
    var descriptorSetLayout = 0
    var descriptorPool = 0
    var descriptorSet = 0
    if (this.valid() && storageHandle != 0 && storageSize > 0) {
        val binding = nativeByteBuffer(24)
        binding.storeI64(0, 7 * 4294967296)
        binding.storeI64(8, 32 * 4294967296 + 1)
        binding.storePointer(16, nativeNullPointer())
        val createInfo = nativeByteBuffer(32)
        createInfo.storeI64(0, 32)
        createInfo.storePointer(8, nativeNullPointer())
        createInfo.storeI64(16, 4294967296)
        createInfo.storePointer(24, binding.address)
        val output = nativeI64Cell(0)
        if (vkCreateDescriptorSetLayout(
            this.handle,
            createInfo.address,
            nativeNullPointer(),
            output.address
        ) == vulkanSuccess) descriptorSetLayout = output.load()
    }
    if (this.valid() && shader.valid() && shader.device == this.handle) {
        val layoutInfo = nativeByteBuffer(48)
        layoutInfo.storeI64(0, 30)
        layoutInfo.storePointer(8, nativeNullPointer())
        layoutInfo.storeI64(
            16,
            if (descriptorSetLayout != 0) 4294967296 else 0
        )
        val setLayout = nativeI64Cell(descriptorSetLayout)
        layoutInfo.storePointer(
            24,
            if (descriptorSetLayout != 0) setLayout.address
            else nativeNullPointer()
        )
        layoutInfo.storeI64(32, 0)
        layoutInfo.storePointer(40, nativeNullPointer())
        val output = nativeI64Cell(0)
        if (vkCreatePipelineLayout(
            this.handle,
            layoutInfo.address,
            nativeNullPointer(),
            output.address
        ) == vulkanSuccess) layout = output.load()
    }
    if (layout != 0) {
        val createInfo = nativeByteBuffer(96)
        createInfo.storeI64(0, 29)
        createInfo.storePointer(8, nativeNullPointer())
        createInfo.storeI64(16, 0)
        createInfo.storeI64(24, 18)
        createInfo.storePointer(32, nativeNullPointer())
        createInfo.storeI64(40, 32 * 4294967296)
        createInfo.storeI64(48, shader.handle)
        createInfo.storePointer(
            56,
            nativePointerFromAddress(nativeCStringAddress("main"))
        )
        createInfo.storePointer(64, nativeNullPointer())
        createInfo.storeI64(72, layout)
        createInfo.storeI64(80, 0)
        createInfo.storeI64(88, 4294967295)
        val output = nativeI64Cell(0)
        if (vkCreateComputePipelines(
            this.handle,
            0,
            1,
            createInfo.address,
            nativeNullPointer(),
            output.address
        ) == vulkanSuccess) pipeline = output.load()
    }
    if (pipeline == 0 && layout != 0) {
        vkDestroyPipelineLayout(this.handle, layout, nativeNullPointer())
        layout = 0
    }
    if (pipeline != 0 && descriptorSetLayout != 0) {
        val poolSize = nativeByteBuffer(8)
        poolSize.storeI64(0, 4294967296 + 7)
        val poolInfo = nativeByteBuffer(40)
        poolInfo.storeI64(0, 33)
        poolInfo.storePointer(8, nativeNullPointer())
        poolInfo.storeI64(16, 4294967296)
        poolInfo.storeI64(24, 1)
        poolInfo.storePointer(32, poolSize.address)
        val output = nativeI64Cell(0)
        if (vkCreateDescriptorPool(
            this.handle,
            poolInfo.address,
            nativeNullPointer(),
            output.address
        ) == vulkanSuccess) descriptorPool = output.load()
    }
    if (descriptorPool != 0) {
        val setLayout = nativeI64Cell(descriptorSetLayout)
        val allocateInfo = nativeByteBuffer(40)
        allocateInfo.storeI64(0, 34)
        allocateInfo.storePointer(8, nativeNullPointer())
        allocateInfo.storeI64(16, descriptorPool)
        allocateInfo.storeI64(24, 1)
        allocateInfo.storePointer(32, setLayout.address)
        val output = nativeI64Cell(0)
        if (vkAllocateDescriptorSets(
            this.handle,
            allocateInfo.address,
            output.address
        ) == vulkanSuccess) descriptorSet = output.load()
    }
    if (descriptorSet != 0) {
        val bufferInfo = nativeByteBuffer(24)
        bufferInfo.storeI64(0, storageHandle)
        bufferInfo.storeI64(8, 0)
        bufferInfo.storeI64(16, storageSize)
        val write = nativeByteBuffer(64)
        write.storeI64(0, 35)
        write.storePointer(8, nativeNullPointer())
        write.storeI64(16, descriptorSet)
        write.storeI64(24, 0)
        write.storeI64(32, 7 * 4294967296 + 1)
        write.storePointer(40, nativeNullPointer())
        write.storePointer(48, bufferInfo.address)
        write.storePointer(56, nativeNullPointer())
        vkUpdateDescriptorSets(
            this.handle,
            1,
            write.address,
            0,
            nativeNullPointer()
        )
    }
    if (pipeline != 0) {
        val poolInfo = nativeByteBuffer(24)
        poolInfo.storeI64(0, 39)
        poolInfo.storePointer(8, nativeNullPointer())
        poolInfo.storeI64(
            16,
            (this.queueFamily & 4294967295) * 4294967296 + 1
        )
        val output = nativeI64Cell(0)
        if (vkCreateCommandPool(
            this.handle,
            poolInfo.address,
            nativeNullPointer(),
            output.address
        ) == vulkanSuccess) commandPool = output.load()
    }
    if (commandPool != 0) {
        val allocateInfo = nativeByteBuffer(32)
        allocateInfo.storeI64(0, 40)
        allocateInfo.storePointer(8, nativeNullPointer())
        allocateInfo.storeI64(16, commandPool)
        allocateInfo.storeI64(24, 4294967296)
        if (vkAllocateCommandBuffers(
            this.handle,
            allocateInfo.address,
            command.address
        ) != vulkanSuccess) command.store(nativeNullPointer())
    }
    val descriptorFailed = storageHandle != 0 && descriptorSet == 0
    if ((pointerIsNull(command.load()) || descriptorFailed) && pipeline != 0) {
        vkDestroyPipeline(this.handle, pipeline, nativeNullPointer())
        if (commandPool != 0) vkDestroyCommandPool(
            this.handle,
            commandPool,
            nativeNullPointer()
        )
        if (descriptorPool != 0) vkDestroyDescriptorPool(
            this.handle,
            descriptorPool,
            nativeNullPointer()
        )
        vkDestroyPipelineLayout(this.handle, layout, nativeNullPointer())
        if (descriptorSetLayout != 0) vkDestroyDescriptorSetLayout(
            this.handle,
            descriptorSetLayout,
            nativeNullPointer()
        )
        pipeline = 0
        commandPool = 0
        layout = 0
        descriptorPool = 0
        descriptorSet = 0
        descriptorSetLayout = 0
    }
    if (pipeline == 0 && descriptorSetLayout != 0) {
        if (descriptorPool != 0) vkDestroyDescriptorPool(
            this.handle,
            descriptorPool,
            nativeNullPointer()
        )
        vkDestroyDescriptorSetLayout(
            this.handle,
            descriptorSetLayout,
            nativeNullPointer()
        )
        descriptorPool = 0
        descriptorSet = 0
        descriptorSetLayout = 0
    }
    VulkanComputePipeline(
        this.handle,
        this.queue,
        this.queueFamily,
        layout,
        pipeline,
        commandPool,
        move(command),
        move(scratch),
        descriptorSetLayout,
        descriptorPool,
        descriptorSet
    )
}

trusted fun VulkanDevice.computePipeline(
    shader: VulkanShaderModule
): VulkanComputePipeline = this.computePipelineNative(shader)

trusted fun VulkanDevice.computeStoragePipeline(
    shader: VulkanShaderModule,
    storage: VulkanBuffer
): VulkanComputePipeline = if (storage.valid() && storage.device == this.handle)
    this.computePipelineNative(shader, storage.handle, storage.size)
else VulkanComputePipeline(
    nativeNullPointer(), nativeNullPointer(), -1, 0, 0, 0,
    nativePointerCell(nativeNullPointer()), nativeByteBuffer(0), 0, 0, 0
)

fun vulkanTextureFormat(format: int): int {
    var result = 0
    if (format == textureFormatR8Unorm) result = 9
    else if (format == textureFormatRg8Unorm) result = 16
    else if (format == textureFormatRgba8Unorm) result = 37
    else if (format == textureFormatRgba8UnormSrgb) result = 43
    else if (format == textureFormatBgra8Unorm) result = 44
    else if (format == textureFormatBgra8UnormSrgb) result = 50
    else if (format == textureFormatR16Float) result = 76
    else if (format == textureFormatRg16Float) result = 83
    else if (format == textureFormatRgba16Float) result = 97
    else if (format == textureFormatR32Float) result = 100
    else if (format == textureFormatRg32Float) result = 103
    else if (format == textureFormatRgba32Float) result = 109
    else if (format == textureFormatDepth16Unorm) result = 124
    else if (format == textureFormatDepth24Stencil8) result = 129
    else if (format == textureFormatDepth32Float) result = 126
    else if (format == textureFormatDepth32FloatStencil8) result = 130
    result
}

fun vulkanTextureUsage(usage: int, format: int): int {
    var result = 0
    if ((usage & textureUsageCopySource) != 0) result = result | 1
    if ((usage & textureUsageCopyDestination) != 0) result = result | 2
    if ((usage & textureUsageSampled) != 0) result = result | 4
    if ((usage & textureUsageStorage) != 0) result = result | 8
    if ((usage & textureUsageRenderAttachment) != 0) {
        if (textureFormatHasDepth(format)) result = result | 32
        else result = result | 16
    }
    result
}

fun vulkanTextureFlags(format: int): int =
    if (format == textureFormatRgba8Unorm ||
        format == textureFormatRgba8UnormSrgb ||
        format == textureFormatBgra8Unorm ||
        format == textureFormatBgra8UnormSrgb) 8 else 0

fun vulkanTextureAspect(format: int, aspect: int): int {
    var result = 1
    if (aspect == textureAspectDepth) result = 2
    else if (aspect == textureAspectStencil) result = 4
    else if (textureFormatHasDepth(format)) {
        result = 2
        if (textureFormatHasStencil(format)) result = result | 4
    }
    result
}

resource class VulkanTexture(
    val device: i64*,
    val physicalDevice: i64*,
    val queue: i64*,
    val queueFamily: int,
    var image: int,
    var memory: int,
    val staging: VulkanBuffer,
    var commandPool: int,
    val command: NativePointerCell,
    val scratch: NativeByteBuffer,
    val layouts: NativeByteBuffer
) {
    fun valid(): bool = !pointerIsNull(this.device) &&
        this.image != 0 && this.memory != 0

    trusted fun transferValid(): bool = this.valid() &&
        this.staging.valid() && this.commandPool != 0 &&
        !this.command.closed && !pointerIsNull(this.command.load()) &&
        !this.scratch.closed && this.scratch.capacity >= 72 &&
        !pointerIsNull(this.queue) && this.queueFamily >= 0 &&
        !this.layouts.closed

    trusted fun storeLayout(mipLevel: int, layout: int): void {
        ablaUnsafeStoreI64(
            ablaUnsafePointerOffset(this.layouts.address, mipLevel * 8),
            layout
        )
        return
    }

    trusted fun beginTransfer(): bool {
        var succeeded = this.transferValid() && vkResetCommandPool(
            this.device,
            this.commandPool,
            0
        ) == vulkanSuccess
        if (succeeded) {
            this.scratch.storeI64(0, 42)
            this.scratch.storePointer(8, nativeNullPointer())
            this.scratch.storeI64(16, 1)
            this.scratch.storePointer(24, nativeNullPointer())
            succeeded = vkBeginCommandBuffer(
                this.command.load(),
                this.scratch.address
            ) == vulkanSuccess
        }
        succeeded
    }

    trusted fun submitTransfer(): bool {
        var succeeded = this.transferValid() &&
            vkEndCommandBuffer(this.command.load()) == vulkanSuccess
        if (succeeded) {
            this.scratch.storeI64(0, 4)
            this.scratch.storePointer(8, nativeNullPointer())
            this.scratch.storeI64(16, 0)
            this.scratch.storePointer(24, nativeNullPointer())
            this.scratch.storePointer(32, nativeNullPointer())
            this.scratch.storeI64(40, 1)
            this.scratch.storePointer(48, this.command.address)
            this.scratch.storeI64(56, 0)
            this.scratch.storePointer(64, nativeNullPointer())
            succeeded = vkQueueSubmit(
                this.queue,
                1,
                this.scratch.address,
                0
            ) == vulkanSuccess
        }
        if (succeeded) {
            succeeded = vkQueueWaitIdle(this.queue) == vulkanSuccess
        }
        succeeded
    }

    trusted fun drop(): void {
        if (this.commandPool != 0 && !pointerIsNull(this.device)) {
            if (!pointerIsNull(this.queue)) vkQueueWaitIdle(this.queue)
            vkDestroyCommandPool(
                this.device,
                this.commandPool,
                nativeNullPointer()
            )
            this.commandPool = 0
            this.command.store(nativeNullPointer())
        }
        this.staging.drop()
        this.command.close()
        this.scratch.close()
        if (this.image != 0 && !pointerIsNull(this.device)) {
            vkDestroyImage(this.device, this.image, nativeNullPointer())
            this.image = 0
        }
        if (this.memory != 0 && !pointerIsNull(this.device)) {
            vkFreeMemory(this.device, this.memory, nativeNullPointer())
            this.memory = 0
        }
        this.layouts.close()
        return
    }
}

fun vulkanTextureRestingAccess(
    texture: TextureDescriptor,
    layout: int
): int {
    var access = 0
    if (layout == 5) access = 32
    else {
        if ((texture.usage & textureUsageCopySource) != 0) {
            access = access | 2048
        }
        if ((texture.usage & textureUsageCopyDestination) != 0) {
            access = access | 4096
        }
    }
    access
}

trusted fun VulkanTexture.writePixels(
    texture: TextureDescriptor,
    pixels: PixelBuffer,
    write: TextureWriteDescriptor
): bool {
    val format = vulkanTextureFormat(texture.format)
    var succeeded = write.valid(texture, pixels.width, pixels.height) &&
        this.transferValid() &&
        write.mipLevel * 8 < this.layouts.capacity &&
        this.staging.writePixels(pixels, format) && this.beginTransfer()
    if (succeeded) {
        val oldLayout = this.layouts.loadI64(write.mipLevel * 8)
        val oldAccess = if (oldLayout == 0) 0
            else vulkanTextureRestingAccess(texture, oldLayout)
        vulkanStoreImageBarrier(
            this.scratch.address,
            this.image,
            oldLayout,
            7,
            oldAccess,
            4096,
            1,
            write.mipLevel
        )
        vkCmdPipelineBarrier(
            this.command.load(),
            if (oldLayout == 0) 1 else 65536,
            4096,
            0,
            0,
            nativeNullPointer(),
            0,
            nativeNullPointer(),
            1,
            this.scratch.address
        )
        this.scratch.storeI64(0, 0)
        this.scratch.storeI64(8, 0)
        this.scratch.storeI64(16, write.mipLevel * 4294967296 + 1)
        this.scratch.storeI64(24, 4294967296)
        this.scratch.storeI64(32, write.y * 4294967296 + write.x)
        this.scratch.storeI64(40, pixels.width * 4294967296)
        this.scratch.storeI64(48, 4294967296 + pixels.height)
        vkCmdCopyBufferToImage(
            this.command.load(),
            this.staging.handle,
            this.image,
            7,
            1,
            this.scratch.address
        )
        val finalLayout = if ((texture.usage & textureUsageSampled) != 0)
            5 else 1
        val finalAccess = vulkanTextureRestingAccess(texture, finalLayout)
        vulkanStoreImageBarrier(
            this.scratch.address,
            this.image,
            7,
            finalLayout,
            4096,
            finalAccess,
            1,
            write.mipLevel
        )
        vkCmdPipelineBarrier(
            this.command.load(),
            4096,
            65536,
            0,
            0,
            nativeNullPointer(),
            0,
            nativeNullPointer(),
            1,
            this.scratch.address
        )
        succeeded = this.submitTransfer()
        if (succeeded) this.storeLayout(write.mipLevel, finalLayout)
    }
    succeeded
}

trusted fun VulkanTexture.rgba8(
    texture: TextureDescriptor,
    x: int,
    y: int,
    mipLevel: int = 0
): int {
    val format = vulkanTextureFormat(texture.format)
    var succeeded = texture.valid() &&
        (texture.usage & textureUsageCopySource) != 0 &&
        textureFormatAcceptsRgba8Pixels(texture.format) &&
        mipLevel >= 0 && mipLevel < texture.mipLevels &&
        x >= 0 && y >= 0 &&
        x < textureMipDimension(texture.size.width, mipLevel) &&
        y < textureMipDimension(texture.size.height, mipLevel) &&
        this.transferValid() &&
        mipLevel * 8 < this.layouts.capacity && this.beginTransfer()
    var finalLayout = 1
    if (succeeded) {
        val oldLayout = this.layouts.loadI64(mipLevel * 8)
        val oldAccess = if (oldLayout == 0) 0
            else vulkanTextureRestingAccess(texture, oldLayout)
        finalLayout = if (oldLayout != 0) oldLayout
            else if ((texture.usage & textureUsageSampled) != 0) 5
            else 1
        vulkanStoreImageBarrier(
            this.scratch.address,
            this.image,
            oldLayout,
            6,
            oldAccess,
            2048,
            1,
            mipLevel
        )
        vkCmdPipelineBarrier(
            this.command.load(),
            if (oldLayout == 0) 1 else 65536,
            4096,
            0,
            0,
            nativeNullPointer(),
            0,
            nativeNullPointer(),
            1,
            this.scratch.address
        )
        this.scratch.storeI64(0, 0)
        this.scratch.storeI64(8, 0)
        this.scratch.storeI64(16, mipLevel * 4294967296 + 1)
        this.scratch.storeI64(24, 4294967296)
        this.scratch.storeI64(32, y * 4294967296 + x)
        this.scratch.storeI64(40, 4294967296)
        this.scratch.storeI64(48, 4294967297)
        vkCmdCopyImageToBuffer(
            this.command.load(),
            this.image,
            6,
            this.staging.handle,
            1,
            this.scratch.address
        )
        vulkanStoreImageBarrier(
            this.scratch.address,
            this.image,
            6,
            finalLayout,
            2048,
            vulkanTextureRestingAccess(texture, finalLayout),
            1,
            mipLevel
