        val color = nativeByteBuffer(16)
        color.storeI64(
            0,
            (graphicsScalarF32Bits(clear.green) & 4294967295) *
                4294967296 +
                (graphicsScalarF32Bits(clear.red) & 4294967295)
        )
        color.storeI64(
            8,
            (graphicsScalarF32Bits(clear.alpha) & 4294967295) *
                4294967296 +
                (graphicsScalarF32Bits(clear.blue) & 4294967295)
        )
        vkCmdClearColorImage(
            command.load(),
            image,
            7,
            color.address,
            1,
            nativePointerFromAddress(
                nativePointerAddress(toTransfer.address) + 48
            )
        )
        val toPresent = vulkanImageBarrier(
            image,
            7,
            1000001002,
            4096,
            0
        )
        vkCmdPipelineBarrier(
            command.load(),
            4096,
            8192,
            0,
            0,
            nativeNullPointer(),
            0,
            nativeNullPointer(),
            1,
            toPresent.address
