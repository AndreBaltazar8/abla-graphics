trusted fun VulkanDevice.presentPixels(
    swapchain: VulkanSwapchain,
    presenter: VulkanPixelPresenter,
    pixels: PixelBuffer
): bool {
    var succeeded = this.valid() && swapchain.valid() && presenter.valid() &&
        pixels.width == swapchain.width && pixels.height == swapchain.height &&
        presenter.width == swapchain.width &&
        presenter.height == swapchain.height &&
        presenter.format == swapchain.format &&
        presenter.staging.writePixels(pixels, swapchain.format)
    val acquired = nativeI64Cell(presenter.acquired)
    val rendered = nativeI64Cell(presenter.rendered)
    val imageIndex = nativeI64Cell(0)
    if (succeeded) {
        val status = vkAcquireNextImageKHR(
            this.handle,
            swapchain.handle,
            9223372036854775807,
            acquired.load(),
            0,
            imageIndex.address
        )
        succeeded = status == vulkanSuccess || status == 1000001003
    }
    val selectedIndex = imageIndex.load() & 4294967295
    if (selectedIndex < 0 || selectedIndex >= swapchain.images.size) {
        succeeded = false
    }

    val command = nativePointerCell(presenter.commandBuffer)
    if (succeeded) {
        succeeded = vkResetCommandPool(
            this.handle,
            presenter.commandPool,
            0
        ) == vulkanSuccess
    }
    if (succeeded) {
        val beginInfo = nativeByteBuffer(32)
        beginInfo.storeI64(0, 42)
        beginInfo.storePointer(8, nativeNullPointer())
        beginInfo.storeI64(16, 1)
        beginInfo.storePointer(24, nativeNullPointer())
        succeeded = vkBeginCommandBuffer(
            command.load(),
            beginInfo.address
        ) == vulkanSuccess
    }
    if (succeeded) {
        val image = swapchain.images[selectedIndex]
        val toTransfer = vulkanImageBarrier(image, 0, 7, 0, 4096)
        vkCmdPipelineBarrier(
            command.load(),
            1,
            4096,
            0,
            0,
            nativeNullPointer(),
            0,
            nativeNullPointer(),
            1,
            toTransfer.address
        )
        val copy = nativeByteBuffer(56)
        copy.storeI64(0, 0)
        copy.storeI64(8, 0)
        copy.storeI64(16, 1)
        copy.storeI64(24, 4294967296)
        copy.storeI64(32, 0)
        copy.storeI64(40, swapchain.width * 4294967296)
        copy.storeI64(48, 4294967296 + swapchain.height)
        vkCmdCopyBufferToImage(
            command.load(),
            presenter.staging.handle,
            image,
            7,
            1,
            copy.address
        )
        val toPresent = vulkanImageBarrier(
            image,
            7,
            1000001002,
            4096,
            0
        )
        vkCmdPipelineBarrier(
            command.load(),
            4096,
            8192,
            0,
            0,
            nativeNullPointer(),
            0,
            nativeNullPointer(),
            1,
            toPresent.address
        )
        succeeded = vkEndCommandBuffer(command.load()) == vulkanSuccess
    }
    if (succeeded) {
        val waitStage = nativeI64Cell(4096)
        val submitInfo = nativeByteBuffer(72)
        submitInfo.storeI64(0, 4)
        submitInfo.storePointer(8, nativeNullPointer())
        submitInfo.storeI64(16, 1)
        submitInfo.storePointer(24, acquired.address)
        submitInfo.storePointer(32, waitStage.address)
        submitInfo.storeI64(40, 1)
        submitInfo.storePointer(48, command.address)
        submitInfo.storeI64(56, 1)
        submitInfo.storePointer(64, rendered.address)
        succeeded = vkQueueSubmit(
            this.queue,
            1,
            submitInfo.address,
            0
        ) == vulkanSuccess
    }
    if (succeeded) {
        val swapchainCell = nativeI64Cell(swapchain.handle)
        val presentInfo = nativeByteBuffer(64)
        presentInfo.storeI64(0, 1000001001)
        presentInfo.storePointer(8, nativeNullPointer())
        presentInfo.storeI64(16, 1)
        presentInfo.storePointer(24, rendered.address)
        presentInfo.storeI64(32, 1)
        presentInfo.storePointer(40, swapchainCell.address)
        presentInfo.storePointer(48, imageIndex.address)
        presentInfo.storePointer(56, nativeNullPointer())
        val status = vkQueuePresentKHR(this.queue, presentInfo.address)
        succeeded = status == vulkanSuccess || status == 1000001003
    }
    if (succeeded) succeeded = vkQueueWaitIdle(this.queue) == vulkanSuccess
    succeeded
}
