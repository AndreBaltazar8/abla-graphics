        val waitStage = nativeI64Cell(4096)
        val submitInfo = nativeByteBuffer(72)
        submitInfo.storeI64(0, 4)
        submitInfo.storePointer(8, nativeNullPointer())
        submitInfo.storeI64(16, 1)
        submitInfo.storePointer(24, acquired.address)
        submitInfo.storePointer(32, waitStage.address)
        submitInfo.storeI64(40, 1)
        submitInfo.storePointer(48, command.address)
        submitInfo.storeI64(56, 1)
        submitInfo.storePointer(64, rendered.address)
        succeeded = vkQueueSubmit(
            this.queue,
            1,
            submitInfo.address,
            0
        ) == vulkanSuccess
    }
    if (succeeded) {
        val swapchainCell = nativeI64Cell(swapchain.handle)
        val presentInfo = nativeByteBuffer(64)
        presentInfo.storeI64(0, 1000001001)
        presentInfo.storePointer(8, nativeNullPointer())
        presentInfo.storeI64(16, 1)
        presentInfo.storePointer(24, rendered.address)
        presentInfo.storeI64(32, 1)
        presentInfo.storePointer(40, swapchainCell.address)
        presentInfo.storePointer(48, imageIndex.address)
        presentInfo.storePointer(56, nativeNullPointer())
