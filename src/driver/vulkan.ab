    trusted fun drop(): void {
        if (this.handle != 0) {
            vkDestroyBuffer(
                this.device,
                this.handle,
                nativeNullPointer()
            )
            this.handle = 0
        }
        if (this.memory != 0) {
            vkFreeMemory(
                this.device,
                this.memory,
                nativeNullPointer()
            )
            this.memory = 0
        }
        return
    }
}

fun vulkanSamplerAddress(value: int): int {
    var result = 2
    if (value == samplerAddressRepeat) result = 0
    else if (value == samplerAddressMirrorRepeat) result = 1
    result
}

