trusted fun VulkanDevice.texture(
    descriptor: TextureDescriptor
): VulkanTexture {
    var image = 0
    var memory = 0
    val format = vulkanTextureFormat(descriptor.format)
    val usage = vulkanTextureUsage(descriptor.usage, descriptor.format)
    if (this.valid() && descriptor.valid() && format != 0 && usage != 0) {
        val createInfo = nativeByteBuffer(88)
        createInfo.storeI64(0, 14)
        createInfo.storePointer(8, nativeNullPointer())
        createInfo.storeI64(
            16,
            (descriptor.dimension - 1) * 4294967296 +
                vulkanTextureFlags(descriptor.format)
        )
        createInfo.storeI64(
            24,
            descriptor.size.width * 4294967296 + format
        )
        createInfo.storeI64(
            32,
            descriptor.size.depth * 4294967296 + descriptor.size.height
        )
        createInfo.storeI64(
            40,
            4294967296 + descriptor.mipLevels
        )
        createInfo.storeI64(48, descriptor.samples)
        createInfo.storeI64(56, usage)
        createInfo.storeI64(64, 0)
        createInfo.storePointer(72, nativeNullPointer())
        createInfo.storeI64(80, 0)
        val output = nativeI64Cell(0)
        if (vkCreateImage(
            this.handle,
            createInfo.address,
            nativeNullPointer(),
            output.address
        ) == vulkanSuccess) image = output.load()
    }
    if (image != 0) {
        val requirements = nativeByteBuffer(24)
        vkGetImageMemoryRequirements(this.handle, image, requirements.address)
