trusted fun VulkanDevice.shaderModule(
    module: SpirvModule
): VulkanShaderModule {
    var handle = 0
    if (this.valid() && module.valid()) {
        val code = nativeByteBuffer(module.words.size * 4)
        var index = 0
        while (index < module.words.size) {
            val word = module.words[index]
            code.store(index * 4, word & 255)
            code.store(index * 4 + 1, (word >> 8) & 255)
            code.store(index * 4 + 2, (word >> 16) & 255)
            code.store(index * 4 + 3, (word >> 24) & 255)
            index = index + 1
        }
        val createInfo = nativeByteBuffer(
            vulkanDriverSizeVkShaderModuleCreateInfo
        )
        val packed = vulkanDriverShaderModuleCreateInfoAt(
            createInfo, 0, module.words.size * 4, code.address
        )
        val output = nativeI64Cell(0)
        if (packed && vkCreateShaderModule(
            this.handle,
            createInfo.address,
            nativeNullPointer(),
            output.address
        ) == vulkanSuccess) handle = output.load()
    }
    VulkanShaderModule(this.handle, handle)
}

resource class VulkanComputePipeline(
    val device: i64*,
    val queue: i64*,
    val queueFamily: int,
    var layout: int,
    var handle: int,
    var commandPool: int,
    val command: NativePointerCell,
    val scratch: NativeByteBuffer,
    var descriptorSetLayout: int,
    var descriptorPool: int,
    var descriptorSet: int,
    val requiresBinding: bool,
    val storageBuffer: int,
    var healthy: bool,
    var submissionAccepted: bool,
    val pushConstantSize: int,
    val pushConstantStageMask: int
) {
    fun valid(): bool = this.healthy && !pointerIsNull(this.device) &&
        !pointerIsNull(this.queue) && this.queueFamily >= 0 &&
        this.layout != 0 && this.handle != 0 && this.commandPool != 0 &&
        !this.command.closed && !pointerIsNull(this.command.load()) &&
        !this.scratch.closed && this.scratch.capacity >= 72 &&
        ((!this.requiresBinding && this.descriptorSet == 0 &&
          this.storageBuffer == 0) ||
         (this.requiresBinding &&
          ((this.descriptorSet == 0 && this.storageBuffer == 0) ||
           (this.descriptorSet != 0 && this.storageBuffer != 0)))) &&
        this.pushConstantSize >= 0 && this.pushConstantSize <= 128 &&
        ((this.pushConstantSize == 0 && this.pushConstantStageMask == 0) ||
         (this.pushConstantSize > 0 && this.pushConstantStageMask != 0))

    trusted fun recordDispatch(
        commandBuffer: i64*,
        x: int,
        y: int = 1,
        z: int = 1,
        pushConstantData: i64* = nativeNullPointer(),
        pushConstantSize: int = 0,
        descriptorSet: int = 0
    ): bool {
        val resolvedDescriptorSet = if (descriptorSet != 0)
            descriptorSet else this.descriptorSet
        var succeeded = this.valid() && !pointerIsNull(commandBuffer) &&
            x > 0 && y > 0 && z > 0 &&
            x <= 65535 && y <= 65535 && z <= 65535 &&
            ((this.pushConstantSize == 0 && pushConstantSize == 0 &&
              pointerIsNull(pushConstantData)) ||
             (this.pushConstantSize > 0 &&
              pushConstantSize == this.pushConstantSize &&
              !pointerIsNull(pushConstantData))) &&
            this.requiresBinding == (resolvedDescriptorSet != 0)
        if (succeeded) {
            vkCmdBindPipeline(commandBuffer, 1, this.handle)
            if (this.pushConstantSize > 0) vkCmdPushConstants(
                commandBuffer,
                this.layout,
                this.pushConstantStageMask,
                0,
                this.pushConstantSize,
                pushConstantData
            )
            if (resolvedDescriptorSet != 0) {
                this.scratch.storeI64(0, resolvedDescriptorSet)
                vkCmdBindDescriptorSets(
                    commandBuffer,
                    1,
                    this.layout,
                    0,
                    1,
                    this.scratch.address,
                    0,
                    nativeNullPointer()
                )
            }
            vkCmdDispatch(commandBuffer, x, y, z)
        }
        succeeded
    }

    trusted fun dispatch(
        x: int,
        y: int = 1,
        z: int = 1,
        pushConstantData: i64* = nativeNullPointer(),
        pushConstantSize: int = 0,
        descriptorSet: int = 0
    ): bool {
        this.submissionAccepted = false
        val accepted = this.valid() && x > 0 && y > 0 && z > 0 &&
            x <= 65535 && y <= 65535 && z <= 65535 &&
            ((this.pushConstantSize == 0 && pushConstantSize == 0 &&
              pointerIsNull(pushConstantData)) ||
             (this.pushConstantSize > 0 &&
              pushConstantSize == this.pushConstantSize &&
              !pointerIsNull(pushConstantData))) &&
            this.requiresBinding ==
                ((descriptorSet != 0) || (this.descriptorSet != 0))
        var succeeded = accepted && vkResetCommandPool(
            this.device,
            this.commandPool,
            0
        ) == vulkanSuccess
        if (succeeded) {
            succeeded = vulkanDriverCommandBufferBeginInfoAt(
                this.scratch, 0, 1
            ) && vkBeginCommandBuffer(
                this.command.load(),
                this.scratch.address
            ) == vulkanSuccess
        }
        if (succeeded) {
            succeeded = this.recordDispatch(
                this.command.load(),
                x,
                y,
                z,
                pushConstantData,
                pushConstantSize,
                descriptorSet
            )
        }
        if (succeeded) {
            succeeded = vkEndCommandBuffer(
                this.command.load()
            ) == vulkanSuccess
        }
        if (succeeded) {
            succeeded = vulkanDriverSubmitInfoAt(
                this.scratch, 0, 1, this.command.address
            ) && vkQueueSubmit(
                this.queue,
                1,
                this.scratch.address,
                0
            ) == vulkanSuccess
            this.submissionAccepted = succeeded
        }
        if (succeeded) succeeded =
            vkQueueWaitIdle(this.queue) == vulkanSuccess
        if (accepted && !succeeded) this.healthy = false
        succeeded
    }

    trusted fun drop(): void {
        if (!pointerIsNull(this.queue)) vkQueueWaitIdle(this.queue)
        if (this.handle != 0 && !pointerIsNull(this.device)) {
            vkDestroyPipeline(this.device, this.handle, nativeNullPointer())
            this.handle = 0
        }
        if (this.commandPool != 0 && !pointerIsNull(this.device)) {
            vkDestroyCommandPool(
                this.device,
                this.commandPool,
                nativeNullPointer()
            )
            this.commandPool = 0
            this.command.store(nativeNullPointer())
        }
        if (this.descriptorPool != 0 && !pointerIsNull(this.device)) {
            vkDestroyDescriptorPool(
                this.device,
                this.descriptorPool,
                nativeNullPointer()
            )
            this.descriptorPool = 0
            this.descriptorSet = 0
        }
        if (this.layout != 0 && !pointerIsNull(this.device)) {
            vkDestroyPipelineLayout(
                this.device,
                this.layout,
                nativeNullPointer()
            )
            this.layout = 0
        }
        if (this.descriptorSetLayout != 0 && !pointerIsNull(this.device)) {
            vkDestroyDescriptorSetLayout(
                this.device,
                this.descriptorSetLayout,
                nativeNullPointer()
            )
            this.descriptorSetLayout = 0
        }
        this.command.close()
        this.scratch.close()
        return
    }
}

trusted fun VulkanDevice.computePipelineNative(
    shader: VulkanShaderModule,
    storageHandle: int = 0,
    storageSize: int = 0,
    specialization: ShaderSpecialization = ShaderSpecialization(),
    pushConstantSize: int = 0,
    pushConstantStageMask: int = 0,
    externalDescriptorSetLayout: int = 0
): VulkanComputePipeline {
    var layout = 0
    var pipeline = 0
    var commandPool = 0
    var command = nativePointerCell(nativeNullPointer())
    var scratch = nativeByteBuffer(72)
    var descriptorSetLayout = 0
    var descriptorPool = 0
    var descriptorSet = 0
    val specializationStorage = vulkanSpecializationStorage(specialization)
    val storageRequested = storageHandle != 0 && storageSize > 0
    val bindingRequestValid =
        ((storageHandle == 0 && storageSize == 0) || storageRequested) &&
        !(storageRequested && externalDescriptorSetLayout != 0)
    if (this.valid() && bindingRequestValid && storageRequested) {
        val binding = vulkanDriverZeroedStructure(
            "VkDescriptorSetLayoutBinding"
        )
        vulkanDriverStoreI32(
            binding, "VkDescriptorSetLayoutBinding", "descriptorType", 7
        )
        vulkanDriverStoreI32(
            binding, "VkDescriptorSetLayoutBinding", "descriptorCount", 1
        )
        vulkanDriverStoreI32(
            binding, "VkDescriptorSetLayoutBinding", "stageFlags", 32
        )
        val createInfo = vulkanDriverZeroedStructure(
            "VkDescriptorSetLayoutCreateInfo"
        )
        vulkanDriverStoreI32(
            createInfo, "VkDescriptorSetLayoutCreateInfo", "bindingCount", 1
        )
        vulkanDriverStorePointer(
            createInfo, "VkDescriptorSetLayoutCreateInfo", "pBindings",
            binding.address
        )
        val output = nativeI64Cell(0)
        if (vkCreateDescriptorSetLayout(
            this.handle,
            createInfo.address,
            nativeNullPointer(),
            output.address
        ) == vulkanSuccess) descriptorSetLayout = output.load()
    }
    val pushConstantsValid =
        (pushConstantSize == 0 && pushConstantStageMask == 0) ||
        (pushConstantSize > 0 && pushConstantSize <= 128 &&
         pushConstantStageMask != 0)
    val pipelineDescriptorSetLayout = if (descriptorSetLayout != 0)
        descriptorSetLayout else externalDescriptorSetLayout
    if (this.valid() && shader.valid() && shader.device == this.handle &&
        pushConstantsValid && bindingRequestValid) {
        val layoutInfo = nativeByteBuffer(
            vulkanDriverSizeVkPipelineLayoutCreateInfo
        )
        val setLayout = nativeI64Cell(pipelineDescriptorSetLayout)
        val pushRange = nativeByteBuffer(vulkanDriverSizeVkPushConstantRange)
        val packed = vulkanDriverPushConstantRangeAt(
            pushRange, 0, pushConstantStageMask, 0, pushConstantSize
        ) && vulkanDriverPipelineLayoutCreateInfoAt(
            layoutInfo, 0,
            if (pipelineDescriptorSetLayout != 0) 1 else 0,
            if (pipelineDescriptorSetLayout != 0) setLayout.address
            else nativeNullPointer(),
            if (pushConstantSize > 0) 1 else 0,
            if (pushConstantSize > 0) pushRange.address
            else nativeNullPointer()
        )
        val output = nativeI64Cell(0)
        if (packed && vkCreatePipelineLayout(
            this.handle,
            layoutInfo.address,
            nativeNullPointer(),
            output.address
        ) == vulkanSuccess) layout = output.load()
    }
    if (layout != 0 && specialization.structurallyValid()) {
        val createInfo = nativeByteBuffer(
            vulkanDriverSizeVkComputePipelineCreateInfo
        )
        val packed = vulkanDriverComputePipelineCreateInfoAt(
            createInfo, 0, shader.handle,
            nativePointerFromAddress(nativeCStringAddress("main")), layout,
            if (specialization.empty()) nativeNullPointer()
            else specializationStorage.address
        )
        val output = nativeI64Cell(0)
        if (packed && vkCreateComputePipelines(
            this.handle,
            0,
            1,
            createInfo.address,
            nativeNullPointer(),
            output.address
        ) == vulkanSuccess) pipeline = output.load()
    }
    if (pipeline == 0 && layout != 0) {
        vkDestroyPipelineLayout(this.handle, layout, nativeNullPointer())
        layout = 0
    }
    if (pipeline != 0 && descriptorSetLayout != 0) {
        val poolSize = vulkanDriverZeroedStructure("VkDescriptorPoolSize")
        vulkanDriverStoreI32(
            poolSize, "VkDescriptorPoolSize", "type", 7
        )
        vulkanDriverStoreI32(
            poolSize, "VkDescriptorPoolSize", "descriptorCount", 1
        )
        val poolInfo = vulkanDriverZeroedStructure(
            "VkDescriptorPoolCreateInfo"
        )
        vulkanDriverStoreI32(
            poolInfo, "VkDescriptorPoolCreateInfo", "maxSets", 1
        )
        vulkanDriverStoreI32(
            poolInfo, "VkDescriptorPoolCreateInfo", "poolSizeCount", 1
        )
        vulkanDriverStorePointer(
            poolInfo, "VkDescriptorPoolCreateInfo", "pPoolSizes",
            poolSize.address
        )
        val output = nativeI64Cell(0)
        if (vkCreateDescriptorPool(
            this.handle,
            poolInfo.address,
            nativeNullPointer(),
            output.address
        ) == vulkanSuccess) descriptorPool = output.load()
    }
    if (descriptorPool != 0) {
        val setLayout = nativeI64Cell(descriptorSetLayout)
        val allocateInfo = vulkanDriverZeroedStructure(
            "VkDescriptorSetAllocateInfo"
        )
        vulkanDriverStoreI64(
            allocateInfo, "VkDescriptorSetAllocateInfo", "descriptorPool",
            descriptorPool
        )
        vulkanDriverStoreI32(
            allocateInfo, "VkDescriptorSetAllocateInfo",
            "descriptorSetCount", 1
        )
        vulkanDriverStorePointer(
            allocateInfo, "VkDescriptorSetAllocateInfo", "pSetLayouts",
            setLayout.address
        )
        val output = nativeI64Cell(0)
        if (vkAllocateDescriptorSets(
            this.handle,
            allocateInfo.address,
            output.address
        ) == vulkanSuccess) descriptorSet = output.load()
    }
    if (descriptorSet != 0) {
        val bufferInfo = vulkanDriverZeroedStructure("VkDescriptorBufferInfo")
        vulkanDriverStoreI64(
            bufferInfo, "VkDescriptorBufferInfo", "buffer", storageHandle
        )
        vulkanDriverStoreI64(
            bufferInfo, "VkDescriptorBufferInfo", "range", storageSize
        )
        val write = vulkanDriverZeroedStructure("VkWriteDescriptorSet")
        vulkanDriverStoreI64(
            write, "VkWriteDescriptorSet", "dstSet", descriptorSet
        )
        vulkanDriverStoreI32(
            write, "VkWriteDescriptorSet", "descriptorCount", 1
        )
        vulkanDriverStoreI32(
            write, "VkWriteDescriptorSet", "descriptorType", 7
        )
        vulkanDriverStorePointer(
            write, "VkWriteDescriptorSet", "pBufferInfo", bufferInfo.address
        )
        vkUpdateDescriptorSets(
            this.handle,
            1,
            write.address,
            0,
            nativeNullPointer()
        )
    }
    if (pipeline != 0) {
        val poolInfo = vulkanDriverZeroedBytes(
            vulkanDriverStructureSize("VkCommandPoolCreateInfo")
        )
        vulkanDriverCommandPoolCreateInfoAt(
            poolInfo, 0, this.queueFamily, 1
        )
        val output = nativeI64Cell(0)
        if (vkCreateCommandPool(
            this.handle,
            poolInfo.address,
            nativeNullPointer(),
            output.address
        ) == vulkanSuccess) commandPool = output.load()
    }
    if (commandPool != 0) {
        val allocateInfo = vulkanDriverZeroedBytes(
            vulkanDriverStructureSize("VkCommandBufferAllocateInfo")
        )
        vulkanDriverCommandBufferAllocateInfoAt(
            allocateInfo, 0, commandPool, 1
        )
        if (vkAllocateCommandBuffers(
            this.handle,
            allocateInfo.address,
            command.address
        ) != vulkanSuccess) command.store(nativeNullPointer())
    }
    val descriptorFailed = storageHandle != 0 && descriptorSet == 0
    if ((pointerIsNull(command.load()) || descriptorFailed) && pipeline != 0) {
        vkDestroyPipeline(this.handle, pipeline, nativeNullPointer())
        if (commandPool != 0) vkDestroyCommandPool(
            this.handle,
            commandPool,
            nativeNullPointer()
        )
        if (descriptorPool != 0) vkDestroyDescriptorPool(
            this.handle,
            descriptorPool,
            nativeNullPointer()
        )
        vkDestroyPipelineLayout(this.handle, layout, nativeNullPointer())
        if (descriptorSetLayout != 0) vkDestroyDescriptorSetLayout(
            this.handle,
            descriptorSetLayout,
            nativeNullPointer()
        )
        pipeline = 0
        commandPool = 0
        layout = 0
        descriptorPool = 0
        descriptorSet = 0
        descriptorSetLayout = 0
    }
    if (pipeline == 0 && descriptorSetLayout != 0) {
        if (descriptorPool != 0) vkDestroyDescriptorPool(
            this.handle,
            descriptorPool,
            nativeNullPointer()
        )
        vkDestroyDescriptorSetLayout(
            this.handle,
            descriptorSetLayout,
            nativeNullPointer()
        )
        descriptorPool = 0
        descriptorSet = 0
        descriptorSetLayout = 0
    }
    VulkanComputePipeline(
        this.handle,
        this.queue,
        this.queueFamily,
        layout,
        pipeline,
        commandPool,
        move(command),
        move(scratch),
        descriptorSetLayout,
        descriptorPool,
        descriptorSet,
        pipelineDescriptorSetLayout != 0,
        storageHandle,
        true,
        false,
        pushConstantSize,
        pushConstantStageMask
    )
}

trusted fun VulkanDevice.computePipeline(
    shader: VulkanShaderModule,
    specialization: ShaderSpecialization = ShaderSpecialization()
): VulkanComputePipeline = this.computePipelineNative(
    shader,
    specialization = specialization
)

trusted fun VulkanDevice.computeStoragePipeline(
    shader: VulkanShaderModule,
    storage: VulkanBuffer,
    specialization: ShaderSpecialization = ShaderSpecialization(),
    pushConstantSize: int = 0,
    pushConstantStageMask: int = 0
): VulkanComputePipeline = if (storage.valid() && storage.device == this.handle)
    this.computePipelineNative(
        shader,
        storage.handle,
        storage.size,
        specialization,
        pushConstantSize,
        pushConstantStageMask
    )
else VulkanComputePipeline(
    nativeNullPointer(), nativeNullPointer(), -1, 0, 0, 0,
    nativePointerCell(nativeNullPointer()), nativeByteBuffer(0), 0, 0, 0,
    false, 0, true, false, 0, 0
)

fun vulkanTextureFormat(format: int): int {
    var result = 0
    if (format == textureFormatR8Unorm) result = 9
    else if (format == textureFormatRg8Unorm) result = 16
    else if (format == textureFormatRgba8Unorm) result = 37
    else if (format == textureFormatRgba8UnormSrgb) result = 43
    else if (format == textureFormatBgra8Unorm) result = 44
    else if (format == textureFormatBgra8UnormSrgb) result = 50
    else if (format == textureFormatR16Float) result = 76
    else if (format == textureFormatRg16Float) result = 83
    else if (format == textureFormatRgba16Float) result = 97
    else if (format == textureFormatR32Float) result = 100
    else if (format == textureFormatRg32Float) result = 103
    else if (format == textureFormatRgba32Float) result = 109
    else if (format == textureFormatDepth16Unorm) result = 124
    else if (format == textureFormatDepth24Stencil8) result = 129
    else if (format == textureFormatDepth32Float) result = 126
    else if (format == textureFormatDepth32FloatStencil8) result = 130
    else if (format == textureFormatBc1RgbaUnorm) result = 133
    else if (format == textureFormatBc1RgbaUnormSrgb) result = 134
    result
}

fun vulkanTextureUsage(usage: int, format: int): int {
    var result = 0
    if ((usage & textureUsageCopySource) != 0) result = result | 1
    if ((usage & textureUsageCopyDestination) != 0) result = result | 2
    if ((usage & textureUsageSampled) != 0) result = result | 4
    if ((usage & textureUsageStorage) != 0) result = result | 8
    if ((usage & textureUsageRenderAttachment) != 0) {
        if (textureFormatHasDepth(format)) result = result | 32
        else result = result | 16
    }
    result
}

fun vulkanTextureFlags(format: int, dimension: int): int {
    var result = if (format == textureFormatRgba8Unorm ||
        format == textureFormatRgba8UnormSrgb ||
        format == textureFormatBgra8Unorm ||
        format == textureFormatBgra8UnormSrgb ||
        format == textureFormatBc1RgbaUnorm ||
        format == textureFormatBc1RgbaUnormSrgb) 8 else 0
    if (dimension == textureDimensionCube) result = result | 16
    result
}

fun vulkanTextureImageType(dimension: int): int {
    var result = -1
    if (dimension == textureDimension1D) result = 0
    else if (dimension == textureDimension2D ||
        dimension == textureDimension2DArray ||
        dimension == textureDimensionCube) result = 1
    else if (dimension == textureDimension3D) result = 2
    result
}

fun vulkanTextureViewType(dimension: int): int {
    var result = -1
    if (dimension == textureDimension1D) result = 0
    else if (dimension == textureDimension2D) result = 1
    else if (dimension == textureDimension3D) result = 2
    else if (dimension == textureDimensionCube) result = 3
    else if (dimension == textureDimension2DArray) result = 5
    result
}

fun vulkanTextureAspect(format: int, aspect: int): int {
    var result = 1
    if (aspect == textureAspectDepth) result = 2
    else if (aspect == textureAspectStencil) result = 4
    else if (textureFormatHasDepth(format)) {
        result = 2
        if (textureFormatHasStencil(format)) result = result | 4
    }
    result
}

resource class VulkanTexture(
    val device: i64*,
    val physicalDevice: i64*,
    val queue: i64*,
    val queueFamily: int,
    var image: int,
    var memory: int,
    val staging: VulkanBuffer,
    var commandPool: int,
    val command: NativePointerCell,
    val scratch: NativeByteBuffer,
    val layouts: NativeByteBuffer
) {
    fun valid(): bool = !pointerIsNull(this.device) &&
        this.image != 0 && this.memory != 0

    trusted fun transferValid(): bool = this.valid() &&
        this.staging.valid() && this.commandPool != 0 &&
        !this.command.closed && !pointerIsNull(this.command.load()) &&
        !this.scratch.closed && this.scratch.capacity >= 80 &&
        !pointerIsNull(this.queue) && this.queueFamily >= 0 &&
        !this.layouts.closed

    trusted fun storeLayout(mipLevel: int, layout: int): void {
        ablaUnsafeStoreI64(
            ablaUnsafePointerOffset(this.layouts.address, mipLevel * 8),
            layout
        )
        return
    }

    fun layoutOffset(
        texture: TextureDescriptor,
        mipLevel: int,
        arrayLayer: int
    ): int = (arrayLayer * texture.mipLevels + mipLevel) * 8

    trusted fun loadLayout(
        texture: TextureDescriptor,
        mipLevel: int,
        arrayLayer: int
    ): int {
        val offset = this.layoutOffset(texture, mipLevel, arrayLayer)
        if (offset >= 0 && offset <= this.layouts.capacity - 8)
            this.layouts.loadI64(offset)
        else -1
    }

    trusted fun storeSubresourceLayout(
        texture: TextureDescriptor,
        mipLevel: int,
        arrayLayer: int,
        layout: int
    ): void {
        val offset = this.layoutOffset(texture, mipLevel, arrayLayer)
        if (offset >= 0 && offset <= this.layouts.capacity - 8) {
            ablaUnsafeStoreI64(
                ablaUnsafePointerOffset(this.layouts.address, offset),
                layout
            )
        }
        return
    }

    trusted fun beginTransfer(): bool {
        var succeeded = this.transferValid() && vkResetCommandPool(
            this.device,
            this.commandPool,
            0
        ) == vulkanSuccess
        if (succeeded) {
            succeeded = vulkanDriverCommandBufferBeginInfoAt(
                this.scratch, 0, 1
            ) && vkBeginCommandBuffer(
                this.command.load(),
                this.scratch.address
            ) == vulkanSuccess
        }
        succeeded
    }

    trusted fun submitTransfer(): bool {
        var succeeded = this.transferValid() &&
            vkEndCommandBuffer(this.command.load()) == vulkanSuccess
        if (succeeded) {
            succeeded = vulkanDriverSubmitInfoAt(
                this.scratch, 0, 1, this.command.address
            ) && vkQueueSubmit(
                this.queue,
                1,
                this.scratch.address,
                0
            ) == vulkanSuccess
        }
        if (succeeded) {
            succeeded = vkQueueWaitIdle(this.queue) == vulkanSuccess
        }
        succeeded
    }

    trusted fun drop(): void {
        if (this.commandPool != 0 && !pointerIsNull(this.device)) {
            if (!pointerIsNull(this.queue)) vkQueueWaitIdle(this.queue)
            vkDestroyCommandPool(
                this.device,
                this.commandPool,
                nativeNullPointer()
            )
            this.commandPool = 0
            this.command.store(nativeNullPointer())
        }
        this.staging.drop()
        this.command.close()
        this.scratch.close()
        if (this.image != 0 && !pointerIsNull(this.device)) {
            vkDestroyImage(this.device, this.image, nativeNullPointer())
            this.image = 0
        }
        if (this.memory != 0 && !pointerIsNull(this.device)) {
            vkFreeMemory(this.device, this.memory, nativeNullPointer())
            this.memory = 0
        }
        this.layouts.close()
        return
    }
}

fun vulkanTextureRestingAccess(
    texture: TextureDescriptor,
    layout: int
): int = vulkanTextureRestingAccessForUsage(texture.usage, layout)

fun vulkanTextureRestingAccessForUsage(
    usage: int,
    layout: int
): int {
    var access = 0
    if (layout == 5) access = 32
    else if (layout == 2) access = 384
    else if (layout == 3) access = 1536
    else {
        if (layout == 1 &&
            (usage & (textureUsageSampled | textureUsageStorage)) != 0) {
            access = access | 32
        }
        if (layout == 1 && (usage & textureUsageStorage) != 0) {
            access = access | 64
        }
        if ((usage & textureUsageCopySource) != 0) {
            access = access | 2048
        }
        if ((usage & textureUsageCopyDestination) != 0) {
            access = access | 4096
        }
    }
    access
}

trusted fun VulkanTexture.generateMipmaps(
    texture: TextureDescriptor
): bool {
    var succeeded = texture.valid() && this.transferValid() &&
        texture.dimension == textureDimension2D && texture.samples == 1 &&
        texture.mipLevels > 1 &&
        textureFormatAcceptsRgba8Pixels(texture.format) &&
        (texture.usage & textureUsageCopySource) != 0 &&
        (texture.usage & textureUsageCopyDestination) != 0 &&
        texture.mipLevels * 8 <= this.layouts.capacity && this.beginTransfer()
    val finalLayout = if ((texture.usage & textureUsageSampled) != 0) 5 else 1
    var destinationLevel = 1
    while (succeeded && destinationLevel < texture.mipLevels) {
        val sourceLevel = destinationLevel - 1
        val sourceOldLayout = if (sourceLevel == 0)
            this.layouts.loadI64(0) else 7
        val destinationOldLayout = this.layouts.loadI64(
            destinationLevel * 8
        )
        vulkanStoreImageBarrier(
            this.scratch.address,
            this.image,
            sourceOldLayout,
            6,
            if (sourceOldLayout == 0) 0
            else if (sourceOldLayout == 7) 4096
            else vulkanTextureRestingAccess(texture, sourceOldLayout),
            2048,
            1,
            sourceLevel
        )
        vkCmdPipelineBarrier(
            this.command.load(),
            if (sourceOldLayout == 0) 1
            else if (sourceOldLayout == 7) 4096 else 65536,
            4096,
            0,
            0,
            nativeNullPointer(),
            0,
            nativeNullPointer(),
            1,
            this.scratch.address
        )
        vulkanStoreImageBarrier(
            this.scratch.address,
            this.image,
            destinationOldLayout,
            7,
            if (destinationOldLayout == 0) 0
            else vulkanTextureRestingAccess(texture, destinationOldLayout),
            4096,
            1,
            destinationLevel
        )
        vkCmdPipelineBarrier(
            this.command.load(),
            if (destinationOldLayout == 0) 1 else 65536,
            4096,
            0,
            0,
            nativeNullPointer(),
            0,
            nativeNullPointer(),
            1,
            this.scratch.address
        )
        val sourceWidth = textureMipDimension(
            texture.size.width,
            sourceLevel
        )
        val sourceHeight = textureMipDimension(
            texture.size.height,
            sourceLevel
        )
        val destinationWidth = textureMipDimension(
            texture.size.width,
            destinationLevel
        )
        val destinationHeight = textureMipDimension(
            texture.size.height,
            destinationLevel
        )
        succeeded = vulkanDriverImageBlitAt(
            this.scratch, 0,
            1, sourceLevel, 0, 1,
            0, 0, 0, sourceWidth, sourceHeight, 1,
            1, destinationLevel, 0, 1,
            0, 0, 0, destinationWidth, destinationHeight, 1
        )
        if (succeeded) vkCmdBlitImage(
                this.command.load(),
                this.image,
                6,
                this.image,
                7,
                1,
                this.scratch.address,
                1
            )
        vulkanStoreImageBarrier(
            this.scratch.address,
            this.image,
            6,
            finalLayout,
            2048,
            vulkanTextureRestingAccess(texture, finalLayout),
            1,
            sourceLevel
        )
        vkCmdPipelineBarrier(
            this.command.load(),
            4096,
            65536,
            0,
            0,
            nativeNullPointer(),
            0,
            nativeNullPointer(),
            1,
            this.scratch.address
        )
        destinationLevel = destinationLevel + 1
    }
    if (succeeded) {
        val lastLevel = texture.mipLevels - 1
        vulkanStoreImageBarrier(
            this.scratch.address,
            this.image,
            7,
            finalLayout,
            4096,
            vulkanTextureRestingAccess(texture, finalLayout),
            1,
            lastLevel
        )
        vkCmdPipelineBarrier(
            this.command.load(),
            4096,
            65536,
            0,
            0,
            nativeNullPointer(),
            0,
            nativeNullPointer(),
            1,
            this.scratch.address
        )
        succeeded = this.submitTransfer()
        if (succeeded) {
            var level = 0
            while (level < texture.mipLevels) {
                this.storeLayout(level, finalLayout)
                level = level + 1
            }
        }
    }
    succeeded
}

trusted fun VulkanTexture.writePixels(
    texture: TextureDescriptor,
    pixels: PixelBuffer,
    write: TextureWriteDescriptor
): bool {
    val format = vulkanTextureFormat(texture.format)
    var succeeded = write.valid(texture, pixels.width, pixels.height) &&
        this.transferValid() &&
        write.mipLevel * 8 < this.layouts.capacity &&
        this.staging.writePixels(pixels, format) && this.beginTransfer()
    if (succeeded) {
        val oldLayout = this.layouts.loadI64(write.mipLevel * 8)
        val oldAccess = if (oldLayout == 0) 0
            else vulkanTextureRestingAccess(texture, oldLayout)
        vulkanStoreImageBarrier(
            this.scratch.address,
            this.image,
            oldLayout,
            7,
            oldAccess,
            4096,
            1,
            write.mipLevel
        )
        vkCmdPipelineBarrier(
            this.command.load(),
            if (oldLayout == 0) 1 else 65536,
            4096,
            0,
            0,
            nativeNullPointer(),
            0,
            nativeNullPointer(),
            1,
            this.scratch.address
        )
        succeeded = vulkanDriverBufferImageCopyAt(
            this.scratch, 0, 0, 0, 0,
            1, write.mipLevel, 0, 1,
            write.x, write.y, 0, pixels.width, pixels.height, 1
        )
        if (succeeded) vkCmdCopyBufferToImage(
                this.command.load(),
                this.staging.handle,
                this.image,
                7,
                1,
                this.scratch.address
            )
        val finalLayout = if ((texture.usage & textureUsageSampled) != 0)
            5 else 1
        val finalAccess = vulkanTextureRestingAccess(texture, finalLayout)
        vulkanStoreImageBarrier(
            this.scratch.address,
            this.image,
            7,
            finalLayout,
            4096,
            finalAccess,
            1,
            write.mipLevel
        )
        vkCmdPipelineBarrier(
            this.command.load(),
            4096,
            65536,
            0,
            0,
            nativeNullPointer(),
            0,
            nativeNullPointer(),
            1,
            this.scratch.address
        )
        succeeded = this.submitTransfer()
        if (succeeded) this.storeLayout(write.mipLevel, finalLayout)
    }
    succeeded
}

trusted fun VulkanTexture.rgba8(
    texture: TextureDescriptor,
    x: int,
    y: int,
    mipLevel: int = 0
): int {
    val format = vulkanTextureFormat(texture.format)
    var succeeded = texture.valid() &&
        (texture.usage & textureUsageCopySource) != 0 &&
        textureFormatAcceptsRgba8Pixels(texture.format) &&
        mipLevel >= 0 && mipLevel < texture.mipLevels &&
        x >= 0 && y >= 0 &&
        x < textureMipDimension(texture.size.width, mipLevel) &&
        y < textureMipDimension(texture.size.height, mipLevel) &&
        this.transferValid() &&
        mipLevel * 8 < this.layouts.capacity && this.beginTransfer()
    var finalLayout = 1
    if (succeeded) {
        val oldLayout = this.layouts.loadI64(mipLevel * 8)
        val oldAccess = if (oldLayout == 0) 0
            else vulkanTextureRestingAccess(texture, oldLayout)
        finalLayout = if (oldLayout != 0) oldLayout
            else if ((texture.usage & textureUsageSampled) != 0) 5
            else 1
        vulkanStoreImageBarrier(
            this.scratch.address,
            this.image,
            oldLayout,
            6,
            oldAccess,
            2048,
            1,
            mipLevel
        )
        vkCmdPipelineBarrier(
            this.command.load(),
            if (oldLayout == 0) 1 else 65536,
            4096,
            0,
            0,
            nativeNullPointer(),
            0,
            nativeNullPointer(),
            1,
            this.scratch.address
        )
        succeeded = vulkanDriverBufferImageCopyAt(
            this.scratch, 0, 0, 0, 0,
            1, mipLevel, 0, 1,
            x, y, 0, 1, 1, 1
        )
        if (succeeded) vkCmdCopyImageToBuffer(
                this.command.load(),
                this.image,
                6,
                this.staging.handle,
                1,
                this.scratch.address
            )
        vulkanStoreImageBarrier(
            this.scratch.address,
            this.image,
            6,
            finalLayout,
            2048,
            vulkanTextureRestingAccess(texture, finalLayout),
            1,
            mipLevel
        )
        vkCmdPipelineBarrier(
            this.command.load(),
            4096,
            65536,
            0,
            0,
            nativeNullPointer(),
            0,
            nativeNullPointer(),
            1,
            this.scratch.address
        )
        succeeded = this.submitTransfer()
        if (succeeded) this.storeLayout(mipLevel, finalLayout)
    }
    if (succeeded) this.staging.rgba8(format) else -1
}

trusted fun VulkanTexture.copyBytesToStaging(
    texture: TextureDescriptor,
    source: BufferBytes,
    selection: TextureRegion,
    layout: TextureDataLayout
): bool {
    val tightLayout = TextureDataLayout()
    val tight = tightLayout.requiredBytes(texture, selection)
    val blockWidth = textureFormatBlockWidth(texture.format)
    val blockHeight = textureFormatBlockHeight(texture.format)
    val blockBytes = textureFormatBytesPerBlock(texture.format)
    val widthBlocks = textureBlockCount(
        selection.resolvedWidth(texture),
        blockWidth
    )
    val heightBlocks = textureBlockCount(
        selection.resolvedHeight(texture),
        blockHeight
    )
    val rowBytes = widthBlocks * blockBytes
    val sourceRowBytes = layout.resolvedBytesPerRow(texture, selection)
    val sourceImageRows = layout.resolvedRowsPerImage(texture, selection) /
        blockHeight
    var succeeded = tight.succeeded && tight.value > 0 &&
        tight.value <= this.staging.size && this.staging.mapRange(
            0,
            tight.value,
            2
        )
    var image = 0
    while (succeeded && image < selection.resolvedDepth(texture)) {
        var row = 0
        while (succeeded && row < heightBlocks) {
            succeeded = this.staging.writeMappedRange(
                source,
                layout.offset +
                    (image * sourceImageRows + row) * sourceRowBytes,
                (image * heightBlocks + row) * rowBytes,
                rowBytes
            )
            row = row + 1
        }
        image = image + 1
    }
    if (this.staging.mappedActive()) {
        val unmapped = this.staging.unmap()
        if (succeeded && !unmapped) succeeded = false
    }
    succeeded
}

trusted fun VulkanTexture.copyBytesFromStaging(
    texture: TextureDescriptor,
    var destination: BufferBytes,
    selection: TextureRegion,
    layout: TextureDataLayout
): bool {
    val tightLayout = TextureDataLayout()
    val tight = tightLayout.requiredBytes(texture, selection)
    val blockWidth = textureFormatBlockWidth(texture.format)
    val blockHeight = textureFormatBlockHeight(texture.format)
    val blockBytes = textureFormatBytesPerBlock(texture.format)
    val widthBlocks = textureBlockCount(
        selection.resolvedWidth(texture),
        blockWidth
    )
    val heightBlocks = textureBlockCount(
        selection.resolvedHeight(texture),
        blockHeight
    )
    val rowBytes = widthBlocks * blockBytes
    val destinationRowBytes = layout.resolvedBytesPerRow(texture, selection)
    val destinationImageRows = layout.resolvedRowsPerImage(
        texture,
        selection
    ) / blockHeight
    var succeeded = tight.succeeded && tight.value > 0 &&
        tight.value <= this.staging.size && this.staging.mapRange(
            0,
            tight.value,
            1
        )
    var image = 0
    while (succeeded && image < selection.resolvedDepth(texture)) {
        var row = 0
        while (succeeded && row < heightBlocks) {
            succeeded = this.staging.readMappedRange(
                destination,
                (image * heightBlocks + row) * rowBytes,
                layout.offset +
                    (image * destinationImageRows + row) *
                        destinationRowBytes,
                rowBytes
            )
            row = row + 1
        }
        image = image + 1
    }
    if (this.staging.mappedActive()) {
        val unmapped = this.staging.unmap()
        if (succeeded && !unmapped) succeeded = false
    }
    succeeded
}

trusted fun VulkanTexture.storeBufferImageCopy(
    texture: TextureDescriptor,
    selection: TextureRegion
): void {
    val arrayed = textureDimensionArrayed(texture.dimension)
    val baseArrayLayer = if (arrayed) selection.z else 0
    val arrayLayers = if (arrayed) selection.resolvedDepth(texture) else 1
    val imageZ = if (texture.dimension == textureDimension3D)
        selection.z else 0
    val imageDepth = if (texture.dimension == textureDimension3D)
        selection.resolvedDepth(texture) else 1
    vulkanDriverBufferImageCopyAt(
        this.scratch, 0, 0, 0, 0,
        vulkanTextureAspect(texture.format, textureAspectAll),
        selection.mipLevel, baseArrayLayer, arrayLayers,
        selection.x, selection.y, imageZ,
        selection.resolvedWidth(texture),
        selection.resolvedHeight(texture), imageDepth
    )
    return
}

trusted fun VulkanTexture.writeBytes(
    texture: TextureDescriptor,
    source: BufferBytes,
    selection: TextureRegion,
    layout: TextureDataLayout
): bool {
    var succeeded = this.transferValid() && source.valid() &&
        selection.valid(texture, textureUsageCopyDestination) &&
        layout.validation(texture, selection, source.size).succeeded &&
        !textureFormatHasDepth(texture.format) &&
        this.copyBytesToStaging(texture, source, selection, layout) &&
        this.beginTransfer()
    val arrayed = textureDimensionArrayed(texture.dimension)
    val baseArrayLayer = if (arrayed) selection.z else 0
    val arrayLayers = if (arrayed) selection.resolvedDepth(texture) else 1
    var layer = 0
    while (succeeded && layer < arrayLayers) {
        val selectedLayer = baseArrayLayer + layer
        val oldLayout = this.loadLayout(
            texture,
            selection.mipLevel,
            selectedLayer
        )
        succeeded = oldLayout >= 0
        if (succeeded) {
            vulkanStoreImageBarrier(
                this.scratch.address,
                this.image,
                oldLayout,
                7,
                if (oldLayout == 0) 0
                else vulkanTextureRestingAccess(texture, oldLayout),
                4096,
                1,
                selection.mipLevel,
                1,
                selectedLayer,
                1
            )
            vkCmdPipelineBarrier(
                this.command.load(),
                if (oldLayout == 0) 1 else 65536,
                4096,
                0,
                0,
                nativeNullPointer(),
                0,
                nativeNullPointer(),
                1,
                this.scratch.address
            )
        }
        layer = layer + 1
    }
    if (succeeded) {
        this.storeBufferImageCopy(texture, selection)
        vkCmdCopyBufferToImage(
            this.command.load(),
            this.staging.handle,
            this.image,
            7,
            1,
            this.scratch.address
        )
    }
    val finalLayout = if ((texture.usage & textureUsageSampled) != 0) 5 else 1
    layer = 0
    while (succeeded && layer < arrayLayers) {
        val selectedLayer = baseArrayLayer + layer
        vulkanStoreImageBarrier(
            this.scratch.address,
            this.image,
            7,
            finalLayout,
            4096,
            vulkanTextureRestingAccess(texture, finalLayout),
            1,
            selection.mipLevel,
            1,
            selectedLayer,
            1
        )
        vkCmdPipelineBarrier(
            this.command.load(),
            4096,
            65536,
            0,
            0,
            nativeNullPointer(),
            0,
            nativeNullPointer(),
            1,
            this.scratch.address
        )
        layer = layer + 1
    }
    if (succeeded) succeeded = this.submitTransfer()
    if (succeeded) {
        layer = 0
        while (layer < arrayLayers) {
            this.storeSubresourceLayout(
                texture,
                selection.mipLevel,
                baseArrayLayer + layer,
                finalLayout
            )
            layer = layer + 1
        }
    }
    succeeded
}

trusted fun VulkanTexture.readBytes(
    texture: TextureDescriptor,
    var destination: BufferBytes,
    selection: TextureRegion,
    layout: TextureDataLayout
): bool {
    var succeeded = this.transferValid() && destination.valid() &&
        selection.valid(texture, textureUsageCopySource) &&
        layout.validation(texture, selection, destination.size).succeeded &&
        !textureFormatHasDepth(texture.format) && this.beginTransfer()
    val arrayed = textureDimensionArrayed(texture.dimension)
    val baseArrayLayer = if (arrayed) selection.z else 0
    val arrayLayers = if (arrayed) selection.resolvedDepth(texture) else 1
    var layer = 0
    while (succeeded && layer < arrayLayers) {
        val selectedLayer = baseArrayLayer + layer
        val oldLayout = this.loadLayout(
            texture,
            selection.mipLevel,
            selectedLayer
        )
        succeeded = oldLayout >= 0
        if (succeeded) {
            vulkanStoreImageBarrier(
                this.scratch.address,
                this.image,
                oldLayout,
                6,
                if (oldLayout == 0) 0
                else vulkanTextureRestingAccess(texture, oldLayout),
                2048,
                1,
                selection.mipLevel,
                1,
                selectedLayer,
                1
            )
            vkCmdPipelineBarrier(
                this.command.load(),
                if (oldLayout == 0) 1 else 65536,
                4096,
                0,
                0,
                nativeNullPointer(),
                0,
                nativeNullPointer(),
                1,
                this.scratch.address
            )
        }
        layer = layer + 1
    }
    if (succeeded) {
        this.storeBufferImageCopy(texture, selection)
        vkCmdCopyImageToBuffer(
            this.command.load(),
            this.image,
            6,
            this.staging.handle,
            1,
            this.scratch.address
        )
        succeeded = vulkanDriverMemoryBarrierAt(
            this.scratch, 0, 4096, 8192
        )
        if (succeeded) vkCmdPipelineBarrier(
            this.command.load(),
            4096,
            16384,
            0,
            1,
            this.scratch.address,
            0,
            nativeNullPointer(),
            0,
            nativeNullPointer()
        )
    }
    val finalLayout = if ((texture.usage & textureUsageSampled) != 0) 5 else 1
    layer = 0
    while (succeeded && layer < arrayLayers) {
        val selectedLayer = baseArrayLayer + layer
        vulkanStoreImageBarrier(
            this.scratch.address,
            this.image,
            6,
            finalLayout,
            2048,
            vulkanTextureRestingAccess(texture, finalLayout),
            1,
            selection.mipLevel,
            1,
            selectedLayer,
            1
        )
        vkCmdPipelineBarrier(
            this.command.load(),
            4096,
            65536,
            0,
            0,
            nativeNullPointer(),
            0,
            nativeNullPointer(),
            1,
            this.scratch.address
        )
        layer = layer + 1
    }
    if (succeeded) succeeded = this.submitTransfer()
    if (succeeded) {
        layer = 0
        while (layer < arrayLayers) {
            this.storeSubresourceLayout(
                texture,
                selection.mipLevel,
                baseArrayLayer + layer,
                finalLayout
            )
            layer = layer + 1
        }
        succeeded = this.copyBytesFromStaging(
            texture,
            destination,
            selection,
            layout
        )
    }
    succeeded
}

trusted fun VulkanTexture.copyBytesToStagingRange(
    texture: TextureDescriptor,
    source: BufferBytes,
    width: int,
    height: int,
    depth: int,
    offset: int,
    bytesPerRow: int,
    rowsPerImage: int
): bool {
    val blockWidth = textureFormatBlockWidth(texture.format)
    val blockHeight = textureFormatBlockHeight(texture.format)
    val blockBytes = textureFormatBytesPerBlock(texture.format)
    val widthBlocks = textureBlockCount(width, blockWidth)
    val heightBlocks = textureBlockCount(height, blockHeight)
    val rowBytes = widthBlocks * blockBytes
    val sourceRowBytes = if (bytesPerRow == 0) rowBytes else bytesPerRow
    val sourceImagePixels = if (rowsPerImage == 0)
        heightBlocks * blockHeight else rowsPerImage
    val sourceImageRows = sourceImagePixels / blockHeight
    val tight = textureDataRequiredBytesRange(texture, width, height, depth)
    var succeeded = tight > 0 && tight <= this.staging.size &&
        this.staging.mapRange(0, tight, 2)
    var image = 0
    while (succeeded && image < depth) {
        var row = 0
        while (succeeded && row < heightBlocks) {
            succeeded = this.staging.writeMappedRange(
                source,
                offset + (image * sourceImageRows + row) * sourceRowBytes,
                (image * heightBlocks + row) * rowBytes,
                rowBytes
            )
            row = row + 1
        }
        image = image + 1
    }
    if (this.staging.mappedActive()) {
        val unmapped = this.staging.unmap()
        if (succeeded && !unmapped) succeeded = false
    }
    succeeded
}

trusted fun VulkanTexture.copyBytesFromStagingRange(
    texture: TextureDescriptor,
    var destination: BufferBytes,
    width: int,
    height: int,
    depth: int,
    offset: int,
    bytesPerRow: int,
    rowsPerImage: int
): bool {
    val blockWidth = textureFormatBlockWidth(texture.format)
    val blockHeight = textureFormatBlockHeight(texture.format)
    val blockBytes = textureFormatBytesPerBlock(texture.format)
    val widthBlocks = textureBlockCount(width, blockWidth)
    val heightBlocks = textureBlockCount(height, blockHeight)
    val rowBytes = widthBlocks * blockBytes
    val destinationRowBytes = if (bytesPerRow == 0) rowBytes else bytesPerRow
    val destinationImagePixels = if (rowsPerImage == 0)
        heightBlocks * blockHeight else rowsPerImage
    val destinationImageRows = destinationImagePixels / blockHeight
    val tight = textureDataRequiredBytesRange(texture, width, height, depth)
    var succeeded = tight > 0 && tight <= this.staging.size &&
        this.staging.mapRange(0, tight, 1)
    var image = 0
    while (succeeded && image < depth) {
        var row = 0
        while (succeeded && row < heightBlocks) {
            succeeded = this.staging.readMappedRange(
                destination,
                (image * heightBlocks + row) * rowBytes,
                offset + (image * destinationImageRows + row) *
                    destinationRowBytes,
                rowBytes
            )
            row = row + 1
        }
        image = image + 1
    }
    if (this.staging.mappedActive()) {
        val unmapped = this.staging.unmap()
        if (succeeded && !unmapped) succeeded = false
    }
    succeeded
}

trusted fun VulkanTexture.storeBufferImageCopyRange(
    texture: TextureDescriptor,
    mipLevel: int,
    x: int,
    y: int,
    z: int,
    width: int,
    height: int,
    depth: int
): void {
    val arrayed = textureDimensionArrayed(texture.dimension)
    val baseArrayLayer = if (arrayed) z else 0
    val arrayLayers = if (arrayed) depth else 1
    val imageZ = if (texture.dimension == textureDimension3D) z else 0
    val imageDepth = if (texture.dimension == textureDimension3D) depth else 1
    vulkanDriverBufferImageCopyAt(
        this.scratch, 0, 0, 0, 0,
        vulkanTextureAspect(texture.format, textureAspectAll),
        mipLevel, baseArrayLayer, arrayLayers,
        x, y, imageZ, width, height, imageDepth
    )
    return
}

trusted fun VulkanTexture.writeBytesRange(
    texture: TextureDescriptor,
    source: BufferBytes,
    mipLevel: int,
    x: int,
    y: int,
    z: int,
    width: int,
    height: int,
    depth: int,
    offset: int,
    bytesPerRow: int,
    rowsPerImage: int
): bool {
    var succeeded = this.transferValid() && source.valid() &&
        textureRegionRangeValid(
            texture,
            mipLevel,
            x,
            y,
            z,
            width,
            height,
            depth,
            textureUsageCopyDestination
        ) && textureDataLayoutRangeValid(
            texture,
            width,
            height,
            depth,
            offset,
            bytesPerRow,
            rowsPerImage,
            source.size
        ) && !textureFormatHasDepth(texture.format) &&
        this.copyBytesToStagingRange(
            texture,
            source,
            width,
            height,
            depth,
            offset,
            bytesPerRow,
            rowsPerImage
        ) && this.beginTransfer()
    val arrayed = textureDimensionArrayed(texture.dimension)
    val baseArrayLayer = if (arrayed) z else 0
    val arrayLayers = if (arrayed) depth else 1
    var layer = 0
    while (succeeded && layer < arrayLayers) {
        val selectedLayer = baseArrayLayer + layer
        val oldLayout = this.loadLayout(texture, mipLevel, selectedLayer)
        succeeded = oldLayout >= 0
        if (succeeded) {
            vulkanStoreImageBarrier(
                this.scratch.address,
                this.image,
                oldLayout,
                7,
                if (oldLayout == 0) 0
                else vulkanTextureRestingAccess(texture, oldLayout),
                4096,
                1,
                mipLevel,
                1,
                selectedLayer,
                1
            )
            vkCmdPipelineBarrier(
                this.command.load(),
                if (oldLayout == 0) 1 else 65536,
                4096,
                0,
                0,
                nativeNullPointer(),
                0,
                nativeNullPointer(),
                1,
                this.scratch.address
            )
        }
        layer = layer + 1
    }
    if (succeeded) {
        this.storeBufferImageCopyRange(
            texture,
            mipLevel,
            x,
            y,
            z,
            width,
            height,
            depth
        )
        vkCmdCopyBufferToImage(
            this.command.load(),
            this.staging.handle,
            this.image,
            7,
            1,
            this.scratch.address
        )
    }
    val finalLayout = if ((texture.usage & textureUsageSampled) != 0) 5 else 1
    layer = 0
    while (succeeded && layer < arrayLayers) {
        val selectedLayer = baseArrayLayer + layer
        vulkanStoreImageBarrier(
            this.scratch.address,
            this.image,
            7,
            finalLayout,
            4096,
            vulkanTextureRestingAccess(texture, finalLayout),
            1,
            mipLevel,
            1,
            selectedLayer,
            1
        )
        vkCmdPipelineBarrier(
            this.command.load(),
            4096,
            65536,
            0,
            0,
            nativeNullPointer(),
            0,
            nativeNullPointer(),
            1,
            this.scratch.address
        )
        layer = layer + 1
    }
    if (succeeded) succeeded = this.submitTransfer()
    if (succeeded) {
        layer = 0
        while (layer < arrayLayers) {
            this.storeSubresourceLayout(
                texture,
                mipLevel,
                baseArrayLayer + layer,
                finalLayout
            )
            layer = layer + 1
        }
    }
    succeeded
}

trusted fun VulkanTexture.readBytesRange(
    texture: TextureDescriptor,
    var destination: BufferBytes,
    mipLevel: int,
    x: int,
    y: int,
    z: int,
    width: int,
    height: int,
    depth: int,
    offset: int,
    bytesPerRow: int,
    rowsPerImage: int
): bool {
    var succeeded = this.transferValid() && destination.valid() &&
        textureRegionRangeValid(
            texture,
            mipLevel,
            x,
            y,
            z,
            width,
            height,
            depth,
            textureUsageCopySource
        ) && textureDataLayoutRangeValid(
            texture,
            width,
            height,
            depth,
            offset,
            bytesPerRow,
            rowsPerImage,
            destination.size
        ) && !textureFormatHasDepth(texture.format) && this.beginTransfer()
    val arrayed = textureDimensionArrayed(texture.dimension)
    val baseArrayLayer = if (arrayed) z else 0
    val arrayLayers = if (arrayed) depth else 1
    var layer = 0
    while (succeeded && layer < arrayLayers) {
        val selectedLayer = baseArrayLayer + layer
        val oldLayout = this.loadLayout(texture, mipLevel, selectedLayer)
        succeeded = oldLayout >= 0
        if (succeeded) {
            vulkanStoreImageBarrier(
                this.scratch.address,
                this.image,
                oldLayout,
                6,
                if (oldLayout == 0) 0
                else vulkanTextureRestingAccess(texture, oldLayout),
                2048,
                1,
                mipLevel,
                1,
                selectedLayer,
                1
            )
            vkCmdPipelineBarrier(
                this.command.load(),
                if (oldLayout == 0) 1 else 65536,
                4096,
                0,
                0,
                nativeNullPointer(),
                0,
                nativeNullPointer(),
                1,
                this.scratch.address
            )
        }
        layer = layer + 1
    }
    if (succeeded) {
        this.storeBufferImageCopyRange(
            texture,
            mipLevel,
            x,
            y,
            z,
            width,
            height,
            depth
        )
        vkCmdCopyImageToBuffer(
            this.command.load(),
            this.image,
            6,
            this.staging.handle,
            1,
            this.scratch.address
        )
        succeeded = vulkanDriverMemoryBarrierAt(
            this.scratch, 0, 4096, 8192
        )
        if (succeeded) vkCmdPipelineBarrier(
            this.command.load(),
            4096,
            16384,
            0,
            1,
            this.scratch.address,
            0,
            nativeNullPointer(),
            0,
            nativeNullPointer()
        )
    }
    val finalLayout = if ((texture.usage & textureUsageSampled) != 0) 5 else 1
    layer = 0
    while (succeeded && layer < arrayLayers) {
        val selectedLayer = baseArrayLayer + layer
        vulkanStoreImageBarrier(
            this.scratch.address,
            this.image,
            6,
            finalLayout,
            2048,
            vulkanTextureRestingAccess(texture, finalLayout),
            1,
            mipLevel,
            1,
            selectedLayer,
            1
        )
        vkCmdPipelineBarrier(
            this.command.load(),
            4096,
            65536,
            0,
            0,
            nativeNullPointer(),
            0,
            nativeNullPointer(),
            1,
            this.scratch.address
        )
        layer = layer + 1
    }
    if (succeeded) succeeded = this.submitTransfer()
    if (succeeded) {
        layer = 0
        while (layer < arrayLayers) {
            this.storeSubresourceLayout(
                texture,
                mipLevel,
                baseArrayLayer + layer,
                finalLayout
            )
            layer = layer + 1
        }
        succeeded = this.copyBytesFromStagingRange(
            texture,
            destination,
            width,
            height,
            depth,
            offset,
            bytesPerRow,
            rowsPerImage
        )
    }
    succeeded
}

resource class VulkanTextureView(
    val device: i64*,
    var handle: int
) {
    fun valid(): bool = !pointerIsNull(this.device) && this.handle != 0

    trusted fun drop(): void {
        if (this.handle != 0 && !pointerIsNull(this.device)) {
            vkDestroyImageView(this.device, this.handle, nativeNullPointer())
            this.handle = 0
        }
        return
    }
}

resource class VulkanRenderTarget(
    val device: i64*,
    var view: int,
    val additionalViews: array<int>,
    val resolveViews: array<int>,
    var depthView: int,
    var renderPass: int,
    var framebuffer: int,
    val image: int,
    val depthImage: int,
    val format: int,
    val depthFormat: int,
    val width: int,
    val height: int,
    val samples: int
) {
    fun resolvesValid(): bool {
        var valid = this.resolveViews.size == 0 || (
            this.samples > 1 &&
            this.resolveViews.size == 1 + this.additionalViews.size
        )
        var index = 0
        while (valid && index < this.resolveViews.size) {
            valid = this.resolveViews[index] != 0
            index = index + 1
        }
        valid
    }

    fun valid(): bool = !pointerIsNull(this.device) && this.view != 0 &&
        this.additionalViews.size <= 7 && this.renderPass != 0 &&
        this.framebuffer != 0 && this.image != 0 &&
        this.format != 0 && this.width > 0 && this.height > 0 &&
        (this.samples == 1 || this.samples == 2 || this.samples == 4 ||
         this.samples == 8 || this.samples == 16) &&
        this.resolvesValid() &&
        ((this.depthView == 0 && this.depthImage == 0 &&
          this.depthFormat == 0) ||
         (this.depthView != 0 && this.depthImage != 0 &&
          this.depthFormat != 0))

    fun hasDepth(): bool = this.depthView != 0

    trusted fun drop(): void {
        if (this.framebuffer != 0 && !pointerIsNull(this.device)) {
            vkDestroyFramebuffer(
                this.device,
                this.framebuffer,
                nativeNullPointer()
            )
            this.framebuffer = 0
        }
        if (this.renderPass != 0 && !pointerIsNull(this.device)) {
            vkDestroyRenderPass(
                this.device,
                this.renderPass,
                nativeNullPointer()
            )
            this.renderPass = 0
        }
        if (this.view != 0 && !pointerIsNull(this.device)) {
            vkDestroyImageView(this.device, this.view, nativeNullPointer())
            this.view = 0
        }
        var colorIndex = 0
        while (colorIndex < this.additionalViews.size) {
            if (this.additionalViews[colorIndex] != 0 &&
                !pointerIsNull(this.device)) vkDestroyImageView(
                    this.device,
                    this.additionalViews[colorIndex],
                    nativeNullPointer()
                )
            this.additionalViews[colorIndex] = 0
            colorIndex = colorIndex + 1
        }
        colorIndex = 0
        while (colorIndex < this.resolveViews.size) {
            if (this.resolveViews[colorIndex] != 0 &&
                !pointerIsNull(this.device)) vkDestroyImageView(
                    this.device,
                    this.resolveViews[colorIndex],
                    nativeNullPointer()
                )
            this.resolveViews[colorIndex] = 0
            colorIndex = colorIndex + 1
        }
        if (this.depthView != 0 && !pointerIsNull(this.device)) {
            vkDestroyImageView(
                this.device,
                this.depthView,
                nativeNullPointer()
            )
            this.depthView = 0
        }
        return
    }
}

resource class VulkanCompatibleRenderPass(
    val device: i64*,
    var handle: int,
    var framebuffer: int
) {
    fun valid(): bool = !pointerIsNull(this.device) && this.handle != 0 &&
        this.framebuffer != 0

    trusted fun drop(): void {
        if (this.framebuffer != 0 && !pointerIsNull(this.device)) {
            vkDestroyFramebuffer(
                this.device,
                this.framebuffer,
                nativeNullPointer()
            )
            this.framebuffer = 0
        }
        if (this.handle != 0 && !pointerIsNull(this.device)) {
            vkDestroyRenderPass(this.device, this.handle, nativeNullPointer())
            this.handle = 0
        }
        return
    }
}

trusted fun VulkanDevice.compatibleRenderTargetPass(
    target: VulkanRenderTarget,
    colorFormats: array<int>,
    colorFinalLayouts: array<int>,
    resolveFinalLayouts: array<int>,
    colorLoadOperations: array<int>,
    colorStoreOperations: array<int>,
    depthLoadOperation: int,
    depthStoreOperation: int,
    depthFinalLayout: int,
    subpassCount: int = 1
): VulkanCompatibleRenderPass {
    val colorCount = 1 + target.additionalViews.size
    val resolveCount = target.resolveViews.size
    val hasDepth = target.hasDepth()
    var handle = 0
    var framebuffer = 0
    var succeeded = this.valid() && target.valid() &&
        target.device == this.handle && colorFormats.size == colorCount &&
        colorFinalLayouts.size == colorCount &&
        resolveFinalLayouts.size == resolveCount &&
        colorLoadOperations.size == colorCount &&
        colorStoreOperations.size == colorCount &&
        subpassCount >= 1 && subpassCount <= 8 &&
        (!hasDepth || (
            depthLoadOperation >= 0 && depthLoadOperation <= 2 &&
            depthStoreOperation >= 0 && depthStoreOperation <= 1 &&
            (depthFinalLayout == 3 || depthFinalLayout == 5)
        ))
    var colorIndex = 0
    while (succeeded && colorIndex < colorCount) {
        succeeded = colorFormats[colorIndex] != 0 &&
            (colorFinalLayouts[colorIndex] == 2 ||
             colorFinalLayouts[colorIndex] == 5) &&
            colorLoadOperations[colorIndex] >= 0 &&
            colorLoadOperations[colorIndex] <= 2 &&
            colorStoreOperations[colorIndex] >= 0 &&
            colorStoreOperations[colorIndex] <= 1
        colorIndex = colorIndex + 1
    }
    var resolveIndex = 0
    while (succeeded && resolveIndex < resolveCount) {
        succeeded = resolveFinalLayouts[resolveIndex] == 2 ||
            resolveFinalLayouts[resolveIndex] == 5
        resolveIndex = resolveIndex + 1
    }
    if (succeeded) {
        val resolveBase = colorCount + (if (hasDepth) 1 else 0)
        val attachmentCount = resolveBase + resolveCount
        val attachments = nativeByteBuffer(
            attachmentCount * vulkanDriverSizeVkAttachmentDescription
        )
        colorIndex = 0
        while (succeeded && colorIndex < colorCount) {
            val offset = colorIndex *
                vulkanDriverSizeVkAttachmentDescription
            val finalLayout = colorFinalLayouts[colorIndex]
            val initialLayout = if (
                colorLoadOperations[colorIndex] == 0
            ) finalLayout else 0
            succeeded = vulkanDriverAttachmentDescriptionAt(
                attachments, offset, colorFormats[colorIndex], target.samples,
                colorLoadOperations[colorIndex],
                colorStoreOperations[colorIndex],
                2, 1, initialLayout, finalLayout
            )
            colorIndex = colorIndex + 1
        }
        if (succeeded && hasDepth) {
            val depthOffset = colorCount *
                vulkanDriverSizeVkAttachmentDescription
            val depthInitialLayout = if (depthLoadOperation == 0)
                depthFinalLayout else 0
            succeeded = vulkanDriverAttachmentDescriptionAt(
                attachments, depthOffset, target.depthFormat, target.samples,
                depthLoadOperation, depthStoreOperation,
                if (textureFormatHasStencil(target.depthFormat))
                    depthLoadOperation else 2,
                if (textureFormatHasStencil(target.depthFormat))
                    depthStoreOperation else 1,
                depthInitialLayout, depthFinalLayout
            )
        }
        resolveIndex = 0
        while (succeeded && resolveIndex < resolveCount) {
            val resolveOffset = (resolveBase + resolveIndex) *
                vulkanDriverSizeVkAttachmentDescription
            succeeded = vulkanDriverAttachmentDescriptionAt(
                attachments, resolveOffset, colorFormats[resolveIndex],
                1, 2, 0, 2, 1, 0,
                resolveFinalLayouts[resolveIndex]
            )
            resolveIndex = resolveIndex + 1
        }
        val colorReferences = nativeByteBuffer(colorCount * 8)
        colorIndex = 0
        while (succeeded && colorIndex < colorCount) {
            succeeded = vulkanDriverAttachmentReferenceAt(
                colorReferences,
                colorIndex * vulkanDriverSizeVkAttachmentReference,
                colorIndex, 2
            )
            colorIndex = colorIndex + 1
        }
        val depthReference = nativeByteBuffer(8)
        if (succeeded && hasDepth) succeeded =
            vulkanDriverAttachmentReferenceAt(
                depthReference, 0, colorCount, 3
            )
        val resolveReferences = nativeByteBuffer(resolveCount * 8)
        resolveIndex = 0
        while (succeeded && resolveIndex < resolveCount) {
            succeeded = vulkanDriverAttachmentReferenceAt(
                resolveReferences,
                resolveIndex * vulkanDriverSizeVkAttachmentReference,
                resolveBase + resolveIndex, 2
            )
            resolveIndex = resolveIndex + 1
        }
        val subpasses = nativeByteBuffer(
            subpassCount * vulkanDriverSizeVkSubpassDescription
        )
        var subpassIndex = 0
        while (succeeded && subpassIndex < subpassCount) {
            val subpassOffset = subpassIndex *
                vulkanDriverSizeVkSubpassDescription
            succeeded = vulkanDriverSubpassDescriptionAt(
                subpasses, subpassOffset, colorCount, colorReferences.address,
                if (resolveCount > 0) resolveReferences.address
                else nativeNullPointer(),
                if (hasDepth) depthReference.address else nativeNullPointer()
            )
            subpassIndex = subpassIndex + 1
        }
        val dependencyCount = subpassCount - 1
        val dependencies = nativeByteBuffer(
            if (dependencyCount > 0)
                dependencyCount * vulkanDriverSizeVkSubpassDependency
            else vulkanDriverSizeVkSubpassDependency
        )
        var dependencyIndex = 0
        while (succeeded && dependencyIndex < dependencyCount) {
            succeeded = vulkanDriverSubpassDependencyAt(
                dependencies,
                dependencyIndex * vulkanDriverSizeVkSubpassDependency,
                dependencyIndex, dependencyIndex + 1,
                1024, 1024, 256, 384, 1
            )
            dependencyIndex = dependencyIndex + 1
        }
        val createInfo = nativeByteBuffer(
            vulkanDriverSizeVkRenderPassCreateInfo
        )
        succeeded = succeeded && vulkanDriverRenderPassCreateInfoAt(
            createInfo, 0, attachmentCount, attachments.address,
            subpassCount, subpasses.address, dependencyCount,
            if (dependencyCount > 0) dependencies.address
            else nativeNullPointer()
        )
        val output = nativeI64Cell(0)
        if (succeeded) succeeded = vkCreateRenderPass(
            this.handle,
            createInfo.address,
            nativeNullPointer(),
            output.address
        ) == vulkanSuccess
        if (succeeded) handle = output.load()
    }
    if (succeeded) {
        val attachmentCount = colorCount + (if (hasDepth) 1 else 0) +
            resolveCount
        val resolveBase = colorCount + (if (hasDepth) 1 else 0)
        val attachments = nativeByteBuffer(attachmentCount * 8)
        attachments.storeI64(0, target.view)
        colorIndex = 0
        while (colorIndex < target.additionalViews.size) {
            attachments.storeI64(
                (colorIndex + 1) * 8,
                target.additionalViews[colorIndex]
            )
            colorIndex = colorIndex + 1
        }
        if (hasDepth) attachments.storeI64(
            colorCount * 8,
            target.depthView
        )
        resolveIndex = 0
        while (resolveIndex < target.resolveViews.size) {
            attachments.storeI64(
                (resolveBase + resolveIndex) * 8,
                target.resolveViews[resolveIndex]
            )
            resolveIndex = resolveIndex + 1
        }
        val createInfo = nativeByteBuffer(
            vulkanDriverSizeVkFramebufferCreateInfo
        )
        succeeded = vulkanDriverFramebufferCreateInfoAt(
            createInfo, 0, handle, attachmentCount, attachments.address,
            target.width, target.height
        )
        val output = nativeI64Cell(0)
        if (succeeded) succeeded = vkCreateFramebuffer(
            this.handle,
            createInfo.address,
            nativeNullPointer(),
            output.address
        ) == vulkanSuccess
        if (succeeded) framebuffer = output.load()
    }
    if (!succeeded && handle != 0) {
        vkDestroyRenderPass(this.handle, handle, nativeNullPointer())
        handle = 0
    }
    VulkanCompatibleRenderPass(this.handle, handle, framebuffer)
}

trusted fun VulkanDevice.renderTarget(
    texture: VulkanTexture,
    descriptor: TextureDescriptor,
    depthImage: int = 0,
    depthDescriptor: TextureDescriptor = TextureDescriptor(),
    additionalImages: array<int> = [],
    additionalDescriptors: array<TextureDescriptor> = [],
    resolveImages: array<int> = [],
    resolveDescriptors: array<TextureDescriptor> = []
): VulkanRenderTarget {
    var view = 0
    val additionalViews: array<int> = []
    val resolveViews: array<int> = []
    var depthView = 0
    var renderPass = 0
    var framebuffer = 0
    val format = vulkanTextureFormat(descriptor.format)
    val hasDepth = depthImage != 0
    val colorCount = 1 + additionalImages.size
    val resolveCount = resolveImages.size
    val depthFormat = if (hasDepth)
        vulkanTextureFormat(depthDescriptor.format) else 0
    var succeeded = this.valid() && texture.valid() &&
        texture.device == this.handle && descriptor.valid() &&
        descriptor.dimension == textureDimension2D &&
        !textureFormatHasDepth(descriptor.format) &&
        (descriptor.usage & textureUsageRenderAttachment) != 0 && format != 0 &&
        additionalImages.size == additionalDescriptors.size &&
        additionalImages.size <= 7 &&
        resolveImages.size == resolveDescriptors.size &&
        (resolveImages.size == 0 || (
            descriptor.samples > 1 && resolveImages.size == colorCount
        )) &&
        (!hasDepth || (
            depthDescriptor.valid() &&
            depthDescriptor.dimension == textureDimension2D &&
            depthDescriptor.samples == descriptor.samples &&
            depthDescriptor.size.width == descriptor.size.width &&
            depthDescriptor.size.height == descriptor.size.height &&
            textureFormatHasDepth(depthDescriptor.format) &&
            (depthDescriptor.usage & textureUsageRenderAttachment) != 0 &&
            depthFormat != 0
        ))
    var additionalIndex = 0
    while (succeeded && additionalIndex < additionalImages.size) {
        val color = additionalDescriptors[additionalIndex]
        succeeded = additionalImages[additionalIndex] != 0 && color.valid() &&
            color.dimension == textureDimension2D &&
            color.samples == descriptor.samples &&
            color.size.width == descriptor.size.width &&
            color.size.height == descriptor.size.height &&
            !textureFormatHasDepth(color.format) &&
            (color.usage & textureUsageRenderAttachment) != 0 &&
            vulkanTextureFormat(color.format) != 0
        additionalIndex = additionalIndex + 1
    }
    var resolveIndex = 0
    while (succeeded && resolveIndex < resolveImages.size) {
        val source = if (resolveIndex == 0) descriptor
            else additionalDescriptors[resolveIndex - 1]
        val resolve = resolveDescriptors[resolveIndex]
        succeeded = resolveImages[resolveIndex] != 0 && resolve.valid() &&
            resolve.dimension == textureDimension2D &&
            resolve.samples == 1 && resolve.format == source.format &&
            resolve.size.width == source.size.width &&
            resolve.size.height == source.size.height &&
            !textureFormatHasDepth(resolve.format) &&
            (resolve.usage & textureUsageRenderAttachment) != 0 &&
            vulkanTextureFormat(resolve.format) != 0
        resolveIndex = resolveIndex + 1
    }
    if (succeeded) {
        view = vulkanTextureViewHandle(
            this.handle,
            texture.image,
            descriptor,
            TextureViewDescriptor()
        )
        succeeded = view != 0
    }
    additionalIndex = 0
    while (succeeded && additionalIndex < additionalImages.size) {
        val additionalView = vulkanTextureViewHandle(
            this.handle,
            additionalImages[additionalIndex],
            additionalDescriptors[additionalIndex],
            TextureViewDescriptor()
        )
        succeeded = additionalView != 0
        if (succeeded) additionalViews.append(additionalView)
        additionalIndex = additionalIndex + 1
    }
    resolveIndex = 0
    while (succeeded && resolveIndex < resolveImages.size) {
        val resolveView = vulkanTextureViewHandle(
            this.handle,
            resolveImages[resolveIndex],
            resolveDescriptors[resolveIndex],
            TextureViewDescriptor()
        )
        succeeded = resolveView != 0
        if (succeeded) resolveViews.append(resolveView)
        resolveIndex = resolveIndex + 1
    }
    if (succeeded && hasDepth) {
        depthView = vulkanTextureViewHandle(
            this.handle,
            depthImage,
            depthDescriptor,
            TextureViewDescriptor(
                aspect = if (textureFormatHasStencil(depthDescriptor.format))
                    textureAspectAll else textureAspectDepth
            )
        )
        succeeded = depthView != 0
    }
    if (succeeded) {
        val attachmentCount = colorCount + (if (hasDepth) 1 else 0) +
            resolveCount
        val attachments = nativeByteBuffer(
            attachmentCount * vulkanDriverSizeVkAttachmentDescription
        )
        var colorIndex = 0
        while (succeeded && colorIndex < colorCount) {
            val color = if (colorIndex == 0) descriptor
                else additionalDescriptors[colorIndex - 1]
            val colorOffset = colorIndex *
                vulkanDriverSizeVkAttachmentDescription
            succeeded = vulkanDriverAttachmentDescriptionAt(
                attachments, colorOffset, vulkanTextureFormat(color.format),
                descriptor.samples, 1, 0, 2, 1, 0,
                if ((color.usage & textureUsageSampled) != 0) 5 else 2
            )
            colorIndex = colorIndex + 1
        }
        if (succeeded && hasDepth) {
            val depthOffset = colorCount *
                vulkanDriverSizeVkAttachmentDescription
            succeeded = vulkanDriverAttachmentDescriptionAt(
                attachments, depthOffset, depthFormat, descriptor.samples,
                1, 1, 1, 1, 0, 3
            )
        }
        val resolveBase = colorCount + (if (hasDepth) 1 else 0)
        var resolveIndex = 0
        while (succeeded && resolveIndex < resolveCount) {
            val resolve = resolveDescriptors[resolveIndex]
            val resolveOffset = (resolveBase + resolveIndex) *
                vulkanDriverSizeVkAttachmentDescription
            succeeded = vulkanDriverAttachmentDescriptionAt(
                attachments, resolveOffset,
                vulkanTextureFormat(resolve.format),
                1, 2, 0, 2, 1, 0,
                if ((resolve.usage & textureUsageSampled) != 0) 5 else 2
            )
            resolveIndex = resolveIndex + 1
        }
        val colorReference = nativeByteBuffer(colorCount * 8)
        colorIndex = 0
        while (succeeded && colorIndex < colorCount) {
            succeeded = vulkanDriverAttachmentReferenceAt(
                colorReference,
                colorIndex * vulkanDriverSizeVkAttachmentReference,
                colorIndex, 2
            )
            colorIndex = colorIndex + 1
        }
        val depthReference = nativeByteBuffer(8)
        if (succeeded && hasDepth) succeeded =
            vulkanDriverAttachmentReferenceAt(
                depthReference, 0, colorCount, 3
            )
        val resolveReferences = nativeByteBuffer(resolveCount * 8)
        resolveIndex = 0
        while (succeeded && resolveIndex < resolveCount) {
            succeeded = vulkanDriverAttachmentReferenceAt(
                resolveReferences,
                resolveIndex * vulkanDriverSizeVkAttachmentReference,
                resolveBase + resolveIndex, 2
            )
            resolveIndex = resolveIndex + 1
        }
        val subpass = nativeByteBuffer(vulkanDriverSizeVkSubpassDescription)
        succeeded = succeeded && vulkanDriverSubpassDescriptionAt(
            subpass, 0, colorCount, colorReference.address,
            if (resolveCount > 0) resolveReferences.address
            else nativeNullPointer(),
            if (hasDepth) depthReference.address else nativeNullPointer()
        )
        val createInfo = nativeByteBuffer(
            vulkanDriverSizeVkRenderPassCreateInfo
        )
        succeeded = succeeded && vulkanDriverRenderPassCreateInfoAt(
            createInfo, 0, attachmentCount, attachments.address,
            1, subpass.address
        )
        val output = nativeI64Cell(0)
        if (succeeded) succeeded = vkCreateRenderPass(
            this.handle,
            createInfo.address,
            nativeNullPointer(),
            output.address
        ) == vulkanSuccess
        if (succeeded) renderPass = output.load()
    }
    if (succeeded) {
        val attachmentCount = colorCount + (if (hasDepth) 1 else 0) +
            resolveCount
        val resolveBase = colorCount + (if (hasDepth) 1 else 0)
        val attachment = nativeByteBuffer(
            attachmentCount * 8
        )
        attachment.storeI64(0, view)
        var colorIndex = 0
        while (colorIndex < additionalViews.size) {
            attachment.storeI64(
                (colorIndex + 1) * 8,
                additionalViews[colorIndex]
            )
            colorIndex = colorIndex + 1
        }
        if (hasDepth) attachment.storeI64(colorCount * 8, depthView)
        var resolveIndex = 0
        while (resolveIndex < resolveViews.size) {
            attachment.storeI64(
                (resolveBase + resolveIndex) * 8,
                resolveViews[resolveIndex]
            )
            resolveIndex = resolveIndex + 1
        }
        val createInfo = nativeByteBuffer(
            vulkanDriverSizeVkFramebufferCreateInfo
        )
        succeeded = vulkanDriverFramebufferCreateInfoAt(
            createInfo, 0, renderPass, attachmentCount, attachment.address,
            descriptor.size.width, descriptor.size.height
        )
        val output = nativeI64Cell(0)
        if (succeeded) succeeded = vkCreateFramebuffer(
            this.handle,
            createInfo.address,
            nativeNullPointer(),
            output.address
        ) == vulkanSuccess
        if (succeeded) framebuffer = output.load()
    }
    if (!succeeded) {
        if (framebuffer != 0) vkDestroyFramebuffer(
            this.handle,
            framebuffer,
            nativeNullPointer()
        )
        if (renderPass != 0) vkDestroyRenderPass(
            this.handle,
            renderPass,
            nativeNullPointer()
        )
        if (view != 0) vkDestroyImageView(
            this.handle,
            view,
            nativeNullPointer()
        )
        if (depthView != 0) vkDestroyImageView(
            this.handle,
            depthView,
            nativeNullPointer()
        )
        additionalIndex = 0
        while (additionalIndex < additionalViews.size) {
            if (additionalViews[additionalIndex] != 0) vkDestroyImageView(
                this.handle,
                additionalViews[additionalIndex],
                nativeNullPointer()
            )
            additionalViews[additionalIndex] = 0
            additionalIndex = additionalIndex + 1
        }
        resolveIndex = 0
        while (resolveIndex < resolveViews.size) {
            if (resolveViews[resolveIndex] != 0) vkDestroyImageView(
                this.handle,
                resolveViews[resolveIndex],
                nativeNullPointer()
            )
            resolveViews[resolveIndex] = 0
            resolveIndex = resolveIndex + 1
        }
        framebuffer = 0
        renderPass = 0
        view = 0
        depthView = 0
    }
    VulkanRenderTarget(
        this.handle,
        view,
        additionalViews,
        resolveViews,
        depthView,
        renderPass,
        framebuffer,
        texture.image,
        depthImage,
        format,
        depthFormat,
        descriptor.size.width,
        descriptor.size.height,
        descriptor.samples
    )
}

trusted fun VulkanDevice.clearRenderTarget(
    target: VulkanRenderTarget,
    clearRed: f64,
    clearGreen: f64,
    clearBlue: f64,
    clearAlpha: f64,
    clearStorage: i64* = nativeNullPointer()
): bool {
    val colorCount = 1 + target.additionalViews.size
    var succeeded = this.transferValid() && target.valid() &&
        graphicsColorScalarsValid(
            clearRed,
            clearGreen,
            clearBlue,
            clearAlpha
        ) &&
        target.device == this.handle && this.beginTransfer()
    if (succeeded) {
        var colorIndex = 0
        while (succeeded && pointerIsNull(clearStorage) &&
            colorIndex < colorCount) {
            val clearOffset = 72 + colorIndex * 16
            succeeded = vulkanDriverClearColorValueAt(
                this.transferScratch, clearOffset,
                graphicsScalarF32Bits(clearRed) & 4294967295,
                graphicsScalarF32Bits(clearGreen) & 4294967295,
                graphicsScalarF32Bits(clearBlue) & 4294967295,
                graphicsScalarF32Bits(clearAlpha) & 4294967295
            )
            colorIndex = colorIndex + 1
        }
        if (succeeded && pointerIsNull(clearStorage) && target.hasDepth())
          succeeded = vulkanDriverClearDepthStencilValueAt(
            this.transferScratch, 72 + colorCount * 16, 1065353216, 0
        )
        if (succeeded) succeeded = vulkanDriverRenderPassBeginInfoAt(
            this.transferScratch, 0, target.renderPass, target.framebuffer,
            target.width, target.height,
            colorCount + (if (target.hasDepth()) 1 else 0),
            if (!pointerIsNull(clearStorage)) clearStorage
            else this.transferScratch.pointerAt(72)
        )
        if (succeeded) vkCmdBeginRenderPass(
            this.transferCommand.load(),
            this.transferScratch.address,
            0
        )
        vkCmdEndRenderPass(this.transferCommand.load())
        succeeded = this.submitTransfer()
    }
    succeeded
}

trusted fun VulkanDevice.renderTargetProgramValid(
    target: VulkanRenderTarget,
    pipeline: VulkanRenderPipeline,
    clearRed: f64,
    clearGreen: f64,
    clearBlue: f64,
    clearAlpha: f64,
    vertexBuffer: int = 0,
    vertexCount: int = 3,
    indexBuffer: int = 0,
    indexCount: int = 0,
    instanceCount: int = 1,
    descriptorSet: int = 0,
    indirectBuffer: int = 0,
    indexedIndirect: bool = false,
    compatibleRenderPass: int = 0,
    pushConstantData: i64* = nativeNullPointer(),
    pushConstantSize: int = 0,
    vertexOffset: int = 0,
    indexOffset: int = 0,
    indirectOffset: int = 0,
    drawCount: int = 1,
    pushConstantStride: int = 0,
    indexedDrawRanges: i64* = nativeNullPointer(),
    indexedDrawRangeCount: int = 0
): bool {
    val indexed = indexCount > 0 || indexedIndirect
    val selectedRenderPass = if (compatibleRenderPass != 0)
        compatibleRenderPass else target.renderPass
    this.transferValid() && target.valid() &&
        pipeline.valid() && graphicsColorScalarsValid(
            clearRed,
            clearGreen,
            clearBlue,
            clearAlpha
        ) && target.device == this.handle &&
        pipeline.device == this.handle &&
        pipeline.depthEnabled == target.hasDepth() &&
        vertexCount > 0 && indexCount >= 0 && instanceCount > 0 &&
        drawCount > 0 && drawCount <= 65536 &&
        ((pipeline.vertexStride == 0 && vertexBuffer == 0) ||
         (pipeline.vertexStride > 0 && vertexBuffer != 0)) &&
        ((!indexed && indexBuffer == 0) ||
         (pipeline.vertexStride > 0 && indexed && indexBuffer != 0)) &&
        (!indexedIndirect || indirectBuffer != 0) &&
        (drawCount == 1 || indirectBuffer == 0) &&
        vertexOffset >= 0 && indexOffset >= 0 && indirectOffset >= 0 &&
        (vertexOffset & 3) == 0 && (indexOffset & 3) == 0 &&
        (indirectOffset & 3) == 0 &&
        ((pipeline.pushConstantSize == 0 && pushConstantSize == 0 &&
          pointerIsNull(pushConstantData)) ||
         (pipeline.pushConstantSize > 0 &&
          pushConstantSize == pipeline.pushConstantSize &&
          !pointerIsNull(pushConstantData))) &&
        ((drawCount == 1 && pushConstantStride == 0) ||
         (drawCount > 1 && pipeline.pushConstantSize > 0 &&
          pushConstantStride >= pipeline.pushConstantSize)) &&
        ((indexedDrawRangeCount == 0 && pointerIsNull(indexedDrawRanges)) ||
         (indexedDrawRangeCount == drawCount &&
          !pointerIsNull(indexedDrawRanges))) &&
        pipeline.requiresBinding == (descriptorSet != 0) &&
        pipeline.renderPass == target.renderPass &&
        selectedRenderPass != 0 &&
        pipeline.framebuffers.size == 1 &&
        pipeline.framebuffers[0] == target.framebuffer &&
        pipeline.width == target.width && pipeline.height == target.height
}

trusted fun VulkanDevice.recordRenderTargetProgram(
    target: VulkanRenderTarget,
    pipeline: VulkanRenderPipeline,
    clearRed: f64,
    clearGreen: f64,
    clearBlue: f64,
    clearAlpha: f64,
    vertexBuffer: int = 0,
    vertexCount: int = 3,
    indexBuffer: int = 0,
    indexCount: int = 0,
    instanceCount: int = 1,
    descriptorSet: int = 0,
    indirectBuffer: int = 0,
    indexedIndirect: bool = false,
    clearStorage: i64* = nativeNullPointer(),
    compatibleRenderPass: int = 0,
    pushConstantData: i64* = nativeNullPointer(),
    pushConstantSize: int = 0,
    vertexOffset: int = 0,
    indexOffset: int = 0,
    indirectOffset: int = 0,
    drawCount: int = 1,
    pushConstantStride: int = 0,
    indexedDrawRanges: i64* = nativeNullPointer(),
    indexedDrawRangeCount: int = 0
): bool {
    val indexed = indexCount > 0 || indexedIndirect
    val colorCount = 1 + target.additionalViews.size
    val selectedRenderPass = if (compatibleRenderPass != 0)
        compatibleRenderPass else target.renderPass
    var succeeded = this.renderTargetProgramValid(
        target,
        pipeline,
        clearRed,
        clearGreen,
        clearBlue,
        clearAlpha,
        vertexBuffer,
        vertexCount,
        indexBuffer,
        indexCount,
        instanceCount,
        descriptorSet,
        indirectBuffer,
        indexedIndirect,
        compatibleRenderPass,
        pushConstantData,
        pushConstantSize,
        vertexOffset,
        indexOffset,
        indirectOffset,
        drawCount,
        pushConstantStride,
        indexedDrawRanges,
        indexedDrawRangeCount
    )
    if (succeeded) {
        var colorIndex = 0
        while (succeeded && pointerIsNull(clearStorage) &&
            colorIndex < colorCount) {
            val clearOffset = 72 + colorIndex * 16
            succeeded = vulkanDriverClearColorValueAt(
                this.transferScratch, clearOffset,
                graphicsScalarF32Bits(clearRed) & 4294967295,
                graphicsScalarF32Bits(clearGreen) & 4294967295,
                graphicsScalarF32Bits(clearBlue) & 4294967295,
                graphicsScalarF32Bits(clearAlpha) & 4294967295
            )
            colorIndex = colorIndex + 1
        }
        if (succeeded && pointerIsNull(clearStorage) && target.hasDepth())
          succeeded = vulkanDriverClearDepthStencilValueAt(
            this.transferScratch, 72 + colorCount * 16, 1065353216, 0
        )
        if (succeeded) succeeded = vulkanDriverRenderPassBeginInfoAt(
            this.transferScratch, 0, selectedRenderPass, target.framebuffer,
            target.width, target.height,
            colorCount + (if (target.hasDepth()) 1 else 0),
            if (!pointerIsNull(clearStorage)) clearStorage
            else this.transferScratch.pointerAt(72)
        )
        if (succeeded) vkCmdBeginRenderPass(
            this.transferCommand.load(),
            this.transferScratch.address,
            0
        )
        this.transferScratch.storeI64(0, 0)
        this.transferScratch.storeI64(
            8,
            (graphicsUnsignedIntegerF32Bits(target.height) & 4294967295) *
                4294967296 +
                (graphicsUnsignedIntegerF32Bits(target.width) & 4294967295)
        )
        this.transferScratch.storeI64(16, 1065353216 * 4294967296)
        vkCmdSetViewport(
            this.transferCommand.load(),
            0,
            1,
            this.transferScratch.address
        )
        this.transferScratch.storeI64(0, 0)
        this.transferScratch.storeI64(
            8,
            target.height * 4294967296 + target.width
        )
        vkCmdSetScissor(
            this.transferCommand.load(),
            0,
            1,
            this.transferScratch.address
        )
        vkCmdBindPipeline(
            this.transferCommand.load(),
            0,
            pipeline.handle
        )
        if (descriptorSet != 0) {
            this.transferScratch.storeI64(88, descriptorSet)
            vkCmdBindDescriptorSets(
                this.transferCommand.load(),
                0,
                pipeline.layout,
                0,
                1,
                this.transferScratch.pointerAt(88),
                0,
                nativeNullPointer()
            )
        }
        if (pipeline.vertexStride > 0) {
            this.transferScratch.storeI64(72, vertexBuffer)
            this.transferScratch.storeI64(80, vertexOffset)
            vkCmdBindVertexBuffers(
                this.transferCommand.load(),
                0,
                1,
                this.transferScratch.pointerAt(72),
                this.transferScratch.pointerAt(80)
            )
        }
        if (indexed) {
            vkCmdBindIndexBuffer(
                this.transferCommand.load(),
                indexBuffer,
                if (indirectBuffer != 0 || indexedDrawRangeCount > 0)
                    0 else indexOffset,
                1
            )
        }
        var drawIndex = 0
        while (succeeded && drawIndex < drawCount) {
            val selectedIndexCount = if (indexedDrawRangeCount == drawCount)
                graphicsPackedIndexedDrawCount(indexedDrawRanges, drawIndex)
                else indexCount
            val selectedIndexOffset = if (indexedDrawRangeCount == drawCount)
                graphicsPackedIndexedDrawOffset(indexedDrawRanges, drawIndex)
                else indexOffset
            succeeded = !indexed || (selectedIndexCount > 0 &&
                selectedIndexOffset >= 0 &&
                (selectedIndexOffset & 3) == 0)
            if (pipeline.pushConstantSize > 0) vkCmdPushConstants(
                this.transferCommand.load(),
                pipeline.layout,
                pipeline.pushConstantStageMask,
                0,
                pipeline.pushConstantSize,
                nativePointerFromAddress(
                    nativePointerAddress(pushConstantData) +
                        drawIndex * pushConstantStride
                )
            )
            if (indexed && indirectBuffer != 0) vkCmdDrawIndexedIndirect(
                this.transferCommand.load(),
                indirectBuffer,
                indirectOffset,
                1,
                20
            )
            else if (indexed) vkCmdDrawIndexed(
                this.transferCommand.load(),
                selectedIndexCount,
                instanceCount,
                selectedIndexOffset / 4,
                0,
                0
            )
            else if (indirectBuffer != 0) vkCmdDrawIndirect(
                this.transferCommand.load(),
                indirectBuffer,
                indirectOffset,
                1,
                16
            )
            else vkCmdDraw(
                this.transferCommand.load(),
                vertexCount,
                instanceCount,
                0,
                0
            )
            drawIndex = drawIndex + 1
        }
        vkCmdEndRenderPass(this.transferCommand.load())
    }
    succeeded
}

trusted fun VulkanDevice.renderTargetProgram(
    target: VulkanRenderTarget,
    pipeline: VulkanRenderPipeline,
    clearRed: f64,
    clearGreen: f64,
    clearBlue: f64,
    clearAlpha: f64,
    vertexBuffer: int = 0,
    vertexCount: int = 3,
    indexBuffer: int = 0,
    indexCount: int = 0,
    instanceCount: int = 1,
    descriptorSet: int = 0,
    indirectBuffer: int = 0,
    indexedIndirect: bool = false,
    clearStorage: i64* = nativeNullPointer(),
    compatibleRenderPass: int = 0,
    pushConstantData: i64* = nativeNullPointer(),
    pushConstantSize: int = 0,
    vertexOffset: int = 0,
    indexOffset: int = 0,
    indirectOffset: int = 0,
    drawCount: int = 1,
    pushConstantStride: int = 0,
    indexedDrawRanges: i64* = nativeNullPointer(),
    indexedDrawRangeCount: int = 0
): bool {
    this.transferSubmissionAccepted = false
    var succeeded = this.renderTargetProgramValid(
        target,
        pipeline,
        clearRed,
        clearGreen,
        clearBlue,
        clearAlpha,
        vertexBuffer,
        vertexCount,
        indexBuffer,
        indexCount,
        instanceCount,
        descriptorSet,
        indirectBuffer,
        indexedIndirect,
        compatibleRenderPass,
        pushConstantData,
        pushConstantSize,
        vertexOffset,
        indexOffset,
        indirectOffset,
        drawCount,
        pushConstantStride,
        indexedDrawRanges,
        indexedDrawRangeCount
    ) && this.beginTransfer()
    if (succeeded) succeeded = this.recordRenderTargetProgram(
        target,
        pipeline,
        clearRed,
        clearGreen,
        clearBlue,
        clearAlpha,
        vertexBuffer,
        vertexCount,
        indexBuffer,
        indexCount,
        instanceCount,
        descriptorSet,
        indirectBuffer,
        indexedIndirect,
        clearStorage,
        compatibleRenderPass,
        pushConstantData,
        pushConstantSize,
        vertexOffset,
        indexOffset,
        indirectOffset,
        drawCount,
        pushConstantStride,
        indexedDrawRanges,
        indexedDrawRangeCount
    )
    if (succeeded) succeeded = this.submitTransfer()
    succeeded
}

val vulkanNoSubpassPushConstants: array<int> = []

trusted fun VulkanDevice.renderTargetSubpasses(
    target: VulkanRenderTarget,
    compatibleRenderPass: int,
    compatibleFramebuffer: int,
    pipelineHandles: array<int>,
    pipelineLayouts: array<int>,
    pipelineDepthEnabled: array<bool>,
    pipelineRequiresBinding: array<bool>,
    descriptorSets: array<int>,
    clearStorage: i64*,
    pushConstantOffsets: array<int>,
    pushConstantSizes: array<int>,
    pushConstantStageMasks: array<int>,
    pushConstantData: i64*,
    pushConstantCapacity: int,
    recordOnly: bool = false
): bool {
    val colorCount = 1 + target.additionalViews.size
    var succeeded = this.transferValid() && target.valid() &&
        target.device == this.handle && compatibleRenderPass != 0 &&
        compatibleFramebuffer != 0 &&
        !pointerIsNull(clearStorage) && pipelineHandles.size >= 2 &&
        pipelineHandles.size <= 8 &&
        pipelineLayouts.size == pipelineHandles.size &&
        pipelineDepthEnabled.size == pipelineHandles.size &&
        pipelineRequiresBinding.size == pipelineHandles.size &&
        descriptorSets.size == pipelineHandles.size &&
        ((pushConstantOffsets.size == 0 &&
          pushConstantSizes.size == 0 &&
          pushConstantStageMasks.size == 0 &&
          pointerIsNull(pushConstantData) && pushConstantCapacity == 0) ||
         (pushConstantOffsets.size == pipelineHandles.size &&
          pushConstantSizes.size == pipelineHandles.size &&
          pushConstantStageMasks.size == pipelineHandles.size &&
          !pointerIsNull(pushConstantData) && pushConstantCapacity > 0))
    val hasPushConstants = pushConstantSizes.size > 0
    var pipelineIndex = 0
    while (succeeded && pipelineIndex < pipelineHandles.size) {
        succeeded = pipelineHandles[pipelineIndex] != 0 &&
            pipelineLayouts[pipelineIndex] != 0 &&
            pipelineDepthEnabled[pipelineIndex] == target.hasDepth() &&
            pipelineRequiresBinding[pipelineIndex] ==
                (descriptorSets[pipelineIndex] != 0) &&
            (!hasPushConstants ||
             (pushConstantOffsets[pipelineIndex] >= 0 &&
              pushConstantSizes[pipelineIndex] > 0 &&
              pushConstantSizes[pipelineIndex] <= 128 &&
              pushConstantStageMasks[pipelineIndex] != 0 &&
              pushConstantOffsets[pipelineIndex] <=
                pushConstantCapacity - pushConstantSizes[pipelineIndex]))
        pipelineIndex = pipelineIndex + 1
    }
    if (succeeded && !recordOnly) succeeded = this.beginTransfer()
    if (succeeded) {
        succeeded = vulkanDriverRenderPassBeginInfoAt(
            this.transferScratch, 0,
            compatibleRenderPass, compatibleFramebuffer,
            target.width, target.height,
            colorCount + (if (target.hasDepth()) 1 else 0), clearStorage
        )
        if (succeeded) vkCmdBeginRenderPass(
                this.transferCommand.load(),
                this.transferScratch.address,
                0
            )
        this.transferScratch.storeI64(0, 0)
        this.transferScratch.storeI64(
            8,
            (graphicsUnsignedIntegerF32Bits(target.height) & 4294967295) *
                4294967296 +
                (graphicsUnsignedIntegerF32Bits(target.width) & 4294967295)
        )
        this.transferScratch.storeI64(16, 1065353216 * 4294967296)
        vkCmdSetViewport(
            this.transferCommand.load(),
            0,
            1,
            this.transferScratch.address
        )
        this.transferScratch.storeI64(0, 0)
        this.transferScratch.storeI64(
            8,
            target.height * 4294967296 + target.width
        )
        vkCmdSetScissor(
            this.transferCommand.load(),
            0,
            1,
            this.transferScratch.address
        )
        pipelineIndex = 0
        while (pipelineIndex < pipelineHandles.size) {
            vkCmdBindPipeline(
                this.transferCommand.load(),
                0,
                pipelineHandles[pipelineIndex]
            )
            if (hasPushConstants) vkCmdPushConstants(
                this.transferCommand.load(),
                pipelineLayouts[pipelineIndex],
                pushConstantStageMasks[pipelineIndex],
                0,
                pushConstantSizes[pipelineIndex],
                nativePointerFromAddress(
                    nativePointerAddress(pushConstantData) +
                        pushConstantOffsets[pipelineIndex]
                )
            )
            if (descriptorSets[pipelineIndex] != 0) {
                this.transferScratch.storeI64(
                    88,
                    descriptorSets[pipelineIndex]
                )
                vkCmdBindDescriptorSets(
                    this.transferCommand.load(),
                    0,
                    pipelineLayouts[pipelineIndex],
                    0,
                    1,
                    this.transferScratch.pointerAt(88),
                    0,
                    nativeNullPointer()
                )
            }
            vkCmdDraw(this.transferCommand.load(), 3, 1, 0, 0)
            if (pipelineIndex + 1 < pipelineHandles.size) {
                vkCmdNextSubpass(this.transferCommand.load(), 0)
            }
            pipelineIndex = pipelineIndex + 1
        }
        vkCmdEndRenderPass(this.transferCommand.load())
        if (!recordOnly) succeeded = this.submitTransfer()
    }
    succeeded
}

trusted fun VulkanDevice.texture(
    descriptor: TextureDescriptor
): VulkanTexture {
    var image = 0
    var memory = 0
    var staging = VulkanBuffer(
        nativeNullPointer(),
        nativeNullPointer(),
        nativeNullPointer(),
        -1,
        0,
        0,
        0,
        0,
        nativePointerCell(nativeNullPointer()),
        0,
        0,
        0,
        false
    )
