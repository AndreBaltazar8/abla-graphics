resource class VulkanPixelFrame(
    val staging: VulkanBuffer,
    var commandPool: int,
    val command: NativePointerCell,
    val scratch: NativeByteBuffer,
    var acquired: int,
    var fence: int,
    var inFlight: bool
) {
    trusted fun valid(): bool =
        this.staging.valid() && this.commandPool != 0 &&
        !this.command.closed && !pointerIsNull(this.command.load()) &&
        !this.scratch.closed && this.scratch.capacity >= 160 &&
        this.acquired != 0 && this.fence != 0

    trusted fun drop(): void {
        if (this.fence != 0) {
            vkDestroyFence(
                this.staging.device,
                this.fence,
                nativeNullPointer()
            )
            this.fence = 0
            this.inFlight = false
        }
        if (this.acquired != 0) {
            vkDestroySemaphore(
                this.staging.device,
                this.acquired,
                nativeNullPointer()
            )
            this.acquired = 0
        }
        if (this.commandPool != 0) {
            vkDestroyCommandPool(
                this.staging.device,
                this.commandPool,
                nativeNullPointer()
            )
            this.commandPool = 0
            this.command.store(nativeNullPointer())
        }
        this.command.close()
        this.scratch.close()
        this.staging.drop()
        return
    }
}

resource class VulkanPixelPresenter(
    val frames: array<VulkanPixelFrame>,
    val rendered: array<int>,
    val imageCount: int,
    var frameIndex: int,
    val width: int,
    val height: int,
    val format: int
) {
    trusted fun valid(): bool {
        var validFrames = this.frames.size >= 1 && this.frames.size <= 8
        var index = 0
        while (validFrames && index < this.frames.size) {
            validFrames = this.frames[index].valid()
            index = index + 1
        }
        validFrames && this.imageCount > 0 &&
            this.rendered.size == this.imageCount &&
            this.frameIndex >= 0 && this.frameIndex < this.frames.size &&
            this.width > 0 && this.height > 0 && this.format != 0
    }

    trusted fun drop(): void {
        var inFlight = false
        var index = 0
        while (index < this.frames.size) {
            inFlight = inFlight || this.frames[index].inFlight
            index = index + 1
        }
        if (inFlight) {
            vkDeviceWaitIdle(this.frames[0].staging.device)
        }
        index = 0
        while (index < this.rendered.size) {
            if (this.frames.size > 0 && this.rendered[index] != 0) {
                vkDestroySemaphore(
                    this.frames[0].staging.device,
                    this.rendered[index],
                    nativeNullPointer()
                )
                this.rendered[index] = 0
            }
            index = index + 1
        }
        index = 0
        while (index < this.frames.size) {
            this.frames[index].drop()
            index = index + 1
        }
        this.frameIndex = 0
        return
    }
}

fun vulkanBufferUsage(usage: int): int {
    var result = 0
    if ((usage & bufferUsageMapRead) != 0) result = result | 2
    if ((usage & bufferUsageMapWrite) != 0) result = result | 1
    if ((usage & bufferUsageCopySource) != 0) result = result | 1
    if ((usage & bufferUsageCopyDestination) != 0) result = result | 2
    if ((usage & bufferUsageUniform) != 0) result = result | 16
    if ((usage & bufferUsageStorage) != 0) result = result | 32
    if ((usage & bufferUsageIndex) != 0) result = result | 64
    if ((usage & bufferUsageVertex) != 0) result = result | 128
    if ((usage & bufferUsageIndirect) != 0) result = result | 256
    if ((usage & bufferUsageQueryResolve) != 0) result = result | 2
    result
}

trusted fun VulkanDevice.buffer(
    size: int,
    usage: int = bufferUsageCopySource |
        bufferUsageCopyDestination | bufferUsageStorage
): VulkanBuffer {
    var handle = 0
    var memory = 0
    val nativeUsage = vulkanBufferUsage(usage)
    if (this.valid() && size > 0 && size <= 1073741824 && nativeUsage != 0) {
        val createInfo = nativeByteBuffer(56)
        createInfo.storeI64(0, 12)
        createInfo.storePointer(8, nativeNullPointer())
        createInfo.storeI64(16, 0)
        createInfo.storeI64(24, size)
        createInfo.storeI64(32, nativeUsage)
        createInfo.storeI64(40, 0)
        createInfo.storePointer(48, nativeNullPointer())
        val output = nativeI64Cell(0)
        if (vkCreateBuffer(
            this.handle,
            createInfo.address,
            nativeNullPointer(),
            output.address
        ) == vulkanSuccess) {
            handle = output.load()
        }
    }
    if (handle != 0) {
        val requirements = nativeByteBuffer(24)
        vkGetBufferMemoryRequirements(
            this.handle,
            handle,
            requirements.address
        )
        val allocationSize = requirements.loadI64(0)
        val typeBits = requirements.loadI64(16) & 4294967295
        val properties = nativeByteBuffer(1024)
        vkGetPhysicalDeviceMemoryProperties(
            this.physicalDevice,
            properties.address
        )
        val typeCount = properties.loadI64(0) & 4294967295
        var typeIndex = -1
        var index = 0
        while (typeIndex < 0 && index < typeCount && index < 32) {
            val flags = properties.loadI64(4 + index * 8) & 4294967295
            if ((typeBits & (1 << index)) != 0 &&
                (flags & 6) == 6) typeIndex = index
            index = index + 1
        }
        if (typeIndex >= 0) {
            val allocationInfo = nativeByteBuffer(32)
            allocationInfo.storeI64(0, 5)
            allocationInfo.storePointer(8, nativeNullPointer())
            allocationInfo.storeI64(16, allocationSize)
            allocationInfo.storeI64(24, typeIndex)
            val output = nativeI64Cell(0)
            if (vkAllocateMemory(
                this.handle,
                allocationInfo.address,
                nativeNullPointer(),
                output.address
            ) == vulkanSuccess) {
                memory = output.load()
            }
        }
    }
    if (handle != 0 && memory != 0 &&
        vkBindBufferMemory(
            this.handle,
            handle,
            memory,
            0
        ) != vulkanSuccess) {
        vkFreeMemory(this.handle, memory, nativeNullPointer())
        memory = 0
    }
    if (handle != 0 && memory == 0) {
        vkDestroyBuffer(this.handle, handle, nativeNullPointer())
        handle = 0
    }
    VulkanBuffer(
        this.handle,
        this.physicalDevice,
        this.queue,
        this.queueFamily,
        handle,
        memory,
        size,
        nativePointerCell(nativeNullPointer())
    )
}

trusted fun VulkanDevice.pixelFrame(size: int): VulkanPixelFrame {
    var staging = this.buffer(size)
    val pool = nativeI64Cell(0)
    var command = nativePointerCell(nativeNullPointer())
    var scratch = nativeByteBuffer(160)
    val acquired = nativeI64Cell(0)
    val fence = nativeI64Cell(0)
    var succeeded = staging.valid()
    if (succeeded) {
        val poolInfo = nativeByteBuffer(32)
        poolInfo.storeI64(0, 39)
        poolInfo.storePointer(8, nativeNullPointer())
        poolInfo.storeI64(
            16,
            (this.queueFamily & 4294967295) * 4294967296 + 2
        )
        succeeded = vkCreateCommandPool(
            this.handle,
            poolInfo.address,
            nativeNullPointer(),
            pool.address
        ) == vulkanSuccess
