fun vulkanVersionMajor(version: int): int = (version >>> 22) & 127
fun vulkanVersionMinor(version: int): int = (version >>> 12) & 1023
fun vulkanVersionPatch(version: int): int = version & 4095

trusted fun vulkanSpecializationStorage(
    specialization: ShaderSpecialization
): NativeByteBuffer {
    var dataSize = 0
    var index = 0
    while (index < specialization.values.size) {
        dataSize = dataSize + specialization.values[index].byteSize
        index = index + 1
    }
    val accepted = specialization.structurallyValid() &&
        specialization.values.size > 0
    val storage = nativeByteBuffer(
        if (accepted) vulkanDriverSizeVkSpecializationInfo +
            specialization.values.size *
                vulkanDriverSizeVkSpecializationMapEntry + dataSize
        else 0
    )
    if (accepted) {
        val entriesOffset = vulkanDriverSizeVkSpecializationInfo
        val dataOffset = entriesOffset + specialization.values.size *
            vulkanDriverSizeVkSpecializationMapEntry
        vulkanDriverSpecializationInfoAt(
            storage, 0, specialization.values.size,
            storage.pointerAt(entriesOffset), dataSize,
            storage.pointerAt(dataOffset)
        )
        var packedOffset = 0
        index = 0
        while (index < specialization.values.size) {
            val value = specialization.values[index]
            val entryOffset = entriesOffset + index *
                vulkanDriverSizeVkSpecializationMapEntry
            vulkanDriverSpecializationMapEntryAt(
                storage, entryOffset, value.id, packedOffset, value.byteSize
            )
            if (value.byteSize == 8) {
                storage.storeI64(dataOffset + packedOffset, value.bits)
            } else {
                storage.store(dataOffset + packedOffset, value.bits & 255)
                storage.store(
                    dataOffset + packedOffset + 1,
                    (value.bits >>> 8) & 255
                )
                storage.store(
                    dataOffset + packedOffset + 2,
                    (value.bits >>> 16) & 255
                )
                storage.store(
                    dataOffset + packedOffset + 3,
                    (value.bits >>> 24) & 255
                )
            }
            packedOffset = packedOffset + value.byteSize
            index = index + 1
        }
    }
    storage
}

trusted fun vulkanLoaderVersion(): int {
    val output = nativeI64Cell(0)
    val status = vkEnumerateInstanceVersion(output.address)
    if (status == vulkanSuccess) output.load() & 4294967295
    else vulkanApiVersion10
}

trusted fun vulkanBufferPointer(
    buffer: NativeByteBuffer,
    offset: int
): i64* = NativePointerCell(buffer.pointerAt(offset), false, false).load()

trusted fun vulkanCopyCString(
    source: NativeByteBuffer,
    offset: int,
    maximum: int
): string {
    var length = 0
    while (length < maximum && source.load(offset + length) != 0) {
        length = length + 1
    }
    val output = nativeByteBuffer(length + 1)
    var index = 0
    while (index < length) {
        output.store(index, source.load(offset + index))
        index = index + 1
    }
    output.store(length, 0)
    output.adoptString(length)
}

trusted fun vulkanInstanceExtensionAvailable(name: string): bool {
    val count = nativeI64Cell(0)
    var status = vkEnumerateInstanceExtensionProperties(
        nativeNullPointer(),
        count.address,
        nativeNullPointer()
    )
    var measured = count.load() & 4294967295
    if (measured > 1024) measured = 0
    var found = false
    if (status == vulkanSuccess && measured > 0) {
        val properties = nativeByteBuffer(
            measured * vulkanDriverSizeVkExtensionProperties
        )
        status = vkEnumerateInstanceExtensionProperties(
            nativeNullPointer(),
            count.address,
            properties.address
        )
        measured = count.load() & 4294967295
        var index = 0
        while (status == vulkanSuccess && !found && index < measured) {
            found = vulkanCopyCString(
                properties,
                index * vulkanDriverSizeVkExtensionProperties +
                    vulkanDriverOffsetVkExtensionProperties_extensionName,
                256
            ) == name
            index = index + 1
        }
    }
    found
}

trusted fun vulkanApplicationInfo(
    name: string,
    requestedVersion: int
): NativeByteBuffer {
    val info = nativeByteBuffer(vulkanDriverSizeVkApplicationInfo)
    vulkanDriverApplicationInfoAt(
        info, 0,
        nativePointerFromAddress(nativeCStringAddress(name)), 1,
        nativePointerFromAddress(nativeCStringAddress("abla-graphics")), 1,
        requestedVersion
    )
    info
}

trusted fun vulkanInstanceCreateInfo(
    application: NativeByteBuffer
): NativeByteBuffer {
    val info = nativeByteBuffer(vulkanDriverSizeVkInstanceCreateInfo)
    vulkanDriverInstanceCreateInfoAt(info, 0, application.address)
    info
}

trusted fun vulkanX11InstanceCreateInfo(
    application: NativeByteBuffer,
    extensions: NativeByteBuffer
): NativeByteBuffer {
    val info = vulkanInstanceCreateInfo(application)
    vulkanDriverInstanceCreateInfoAt(
        info, 0, application.address, 2, extensions.address
    )
    info
}

resource class VulkanInstance(
    var handle: i64*,
    val apiVersion: int,
    val debugUtils: bool = false
) {
    trusted fun valid(): bool = !pointerIsNull(this.handle)

    trusted fun drop(): void {
        if (this.valid()) {
            vkDestroyInstance(this.handle, nativeNullPointer())
            this.handle = nativeNullPointer()
        }
        return
    }
}

trusted fun vulkanInstance(
    applicationName: string = "Abla Graphics",
    requestedVersion: int = vulkanApiVersion14,
    enableDebugUtils: bool = true
): VulkanInstance {
    val loaderVersion = vulkanLoaderVersion()
    var selectedVersion = requestedVersion
    if (selectedVersion > loaderVersion) selectedVersion = loaderVersion
    if (selectedVersion < vulkanApiVersion10) {
        selectedVersion = vulkanApiVersion10
    }
    val application = vulkanApplicationInfo(
        applicationName,
        selectedVersion
    )
    val createInfo = vulkanInstanceCreateInfo(application)
    val debugUtils = enableDebugUtils &&
        vulkanInstanceExtensionAvailable("VK_EXT_debug_utils")
    val extensions = nativeByteBuffer(if (debugUtils) 8 else 0)
    if (debugUtils) {
        extensions.storePointer(
            0,
            nativePointerFromAddress(
                nativeCStringAddress("VK_EXT_debug_utils")
            )
        )
        vulkanDriverInstanceCreateInfoAt(
            createInfo, 0, application.address, 1, extensions.address
        )
    }
    val output = nativePointerCell(nativeNullPointer())
    val status = vkCreateInstance(
        createInfo.address,
        nativeNullPointer(),
        output.address
    )
    val handle = if (status == vulkanSuccess)
        output.load()
    else nativeNullPointer()
    VulkanInstance(handle, selectedVersion, debugUtils && status == vulkanSuccess)
}

trusted fun vulkanX11Instance(
    applicationName: string = "Abla Graphics",
    requestedVersion: int = vulkanApiVersion14,
    enableDebugUtils: bool = true
): VulkanInstance {
    val loaderVersion = vulkanLoaderVersion()
    var selectedVersion = requestedVersion
    if (selectedVersion > loaderVersion) selectedVersion = loaderVersion
    if (selectedVersion < vulkanApiVersion10) {
        selectedVersion = vulkanApiVersion10
    }
    val application = vulkanApplicationInfo(
        applicationName,
        selectedVersion
    )
    val debugUtils = enableDebugUtils &&
        vulkanInstanceExtensionAvailable("VK_EXT_debug_utils")
    val extensions = nativeByteBuffer(if (debugUtils) 24 else 16)
    extensions.storePointer(
        0,
        nativePointerFromAddress(nativeCStringAddress("VK_KHR_surface"))
    )
    extensions.storePointer(
        8,
        nativePointerFromAddress(nativeCStringAddress("VK_KHR_xlib_surface"))
    )
    if (debugUtils) extensions.storePointer(
        16,
        nativePointerFromAddress(nativeCStringAddress("VK_EXT_debug_utils"))
    )
    val createInfo = vulkanX11InstanceCreateInfo(application, extensions)
    if (debugUtils) vulkanDriverInstanceCreateInfoAt(
        createInfo, 0, application.address, 3, extensions.address
    )
    val output = nativePointerCell(nativeNullPointer())
    val status = vkCreateInstance(
        createInfo.address,
        nativeNullPointer(),
        output.address
    )
    val handle = if (status == vulkanSuccess)
        output.load()
    else nativeNullPointer()
    VulkanInstance(handle, selectedVersion, debugUtils && status == vulkanSuccess)
}

resource class VulkanX11Surface(
    var handle: int,
    var nativeDisplay: i64*,
    var instance: i64*,
    val visual: int,
    var width: int,
    var height: int
) {
    trusted fun valid(): bool =
        this.handle != 0 &&
        !pointerIsNull(this.nativeDisplay) &&
        !pointerIsNull(this.instance)

    trusted fun drop(): void {
        if (this.handle != 0 && !pointerIsNull(this.instance)) {
            vkDestroySurfaceKHR(
                this.instance,
                this.handle,
                nativeNullPointer()
            )
        }
        if (!pointerIsNull(this.nativeDisplay)) {
            XCloseDisplay(this.nativeDisplay)
        }
        this.handle = 0
        this.nativeDisplay = nativeNullPointer()
        this.instance = nativeNullPointer()
        return
    }
}

trusted fun vulkanX11Surface(
    instance: VulkanInstance,
    window: X11Window
): VulkanX11Surface {
    var nativeDisplay = nativeNullPointer()
    var surface = 0
    if (instance.valid() && window.valid() && window.visual != 0) {
        nativeDisplay = XOpenDisplay(nativeNullPointer())
    }
    if (!pointerIsNull(nativeDisplay)) {
        val createInfo = nativeByteBuffer(
            vulkanDriverSizeVkXlibSurfaceCreateInfoKHR
        )
        vulkanDriverXlibSurfaceCreateInfoAt(
            createInfo, 0, nativeDisplay, window.identifier
        )
        val output = nativeI64Cell(0)
        if (vkCreateXlibSurfaceKHR(
            instance.handle,
            createInfo.address,
            nativeNullPointer(),
            output.address
        ) == vulkanSuccess) {
            surface = output.load()
        }
    }
    if (surface == 0 && !pointerIsNull(nativeDisplay)) {
        XCloseDisplay(nativeDisplay)
        nativeDisplay = nativeNullPointer()
    }
    VulkanX11Surface(
        surface,
        nativeDisplay,
        instance.handle,
        window.visual,
        window.width,
        window.height
    )
}

class VulkanSurfaceCapabilities(
    val valid: bool,
    val minimumImages: int,
    val maximumImages: int,
    val width: int,
    val height: int,
    val supportedUsage: int,
    val currentTransform: int,
    val supportedCompositeAlpha: int
)

trusted fun VulkanAdapter.supportsSurface(
    surface: VulkanX11Surface,
    queueFamily: int = this.graphicsQueueFamily()
): bool {
    var supported = false
    var xlibSupported = 0
    if (surface.valid() && queueFamily >= 0) {
        xlibSupported = vkGetPhysicalDeviceXlibPresentationSupportKHR(
            this.handle,
            queueFamily,
            surface.nativeDisplay,
            surface.visual
        )
    }
    if (surface.valid() && queueFamily >= 0 && xlibSupported != 0) {
        val output = nativeI64Cell(0)
        supported = vkGetPhysicalDeviceSurfaceSupportKHR(
            this.handle,
            queueFamily,
            surface.handle,
            output.address
        ) == vulkanSuccess && (output.load() & 4294967295) != 0
    }
    supported
}

trusted fun VulkanAdapter.surfaceCapabilities(
    surface: VulkanX11Surface
): VulkanSurfaceCapabilities {
    val bytes = nativeByteBuffer(vulkanDriverSizeVkSurfaceCapabilitiesKHR)
    var status = -1
    if (surface.valid()) {
        status = vkGetPhysicalDeviceSurfaceCapabilitiesKHR(
            this.handle,
            surface.handle,
            bytes.address
        )
    }
    VulkanSurfaceCapabilities(
        status == vulkanSuccess,
        vulkanDriverLoadI32Offset(
            bytes, vulkanDriverOffsetVkSurfaceCapabilitiesKHR_minImageCount
        ),
        vulkanDriverLoadI32Offset(
            bytes, vulkanDriverOffsetVkSurfaceCapabilitiesKHR_maxImageCount
        ),
        vulkanDriverLoadI32Offset(
            bytes, vulkanDriverOffsetVkSurfaceCapabilitiesKHR_currentExtent +
                vulkanDriverOffsetVkExtent2D_width
        ),
        vulkanDriverLoadI32Offset(
            bytes, vulkanDriverOffsetVkSurfaceCapabilitiesKHR_currentExtent +
                vulkanDriverOffsetVkExtent2D_height
        ),
        vulkanDriverLoadI32Offset(
            bytes,
            vulkanDriverOffsetVkSurfaceCapabilitiesKHR_supportedUsageFlags
        ),
        vulkanDriverLoadI32Offset(
            bytes, vulkanDriverOffsetVkSurfaceCapabilitiesKHR_currentTransform
        ),
        vulkanDriverLoadI32Offset(
            bytes,
            vulkanDriverOffsetVkSurfaceCapabilitiesKHR_supportedCompositeAlpha
        )
    )
}

class VulkanAdapter(
    val handle: i64*,
    val name: string,
    val apiVersion: int,
    val driverVersion: int,
    val vendor: int,
    val device: int,
    val kind: int
)

trusted fun VulkanInstance.adapters(): array<VulkanAdapter> {
    val result: array<VulkanAdapter> = []
    if (this.valid()) {
        val count = nativeI64Cell(0)
        var status = vkEnumeratePhysicalDevices(
            this.handle,
            count.address,
            nativeNullPointer()
        )
        var measured = count.load() & 4294967295
        if (measured > 256) measured = 0
        if (status == vulkanSuccess && measured > 0) {
            val handles = nativeByteBuffer(measured * 8)
            status = vkEnumeratePhysicalDevices(
                this.handle,
                count.address,
                handles.address
            )
            measured = count.load() & 4294967295
            var index = 0
            while (status == vulkanSuccess && index < measured) {
                val handle = vulkanBufferPointer(handles, index * 8)
                val properties = nativeByteBuffer(
                    vulkanDriverSizeVkPhysicalDeviceProperties
                )
                vkGetPhysicalDeviceProperties(
                    handle,
                    properties.address
                )
                result.append(VulkanAdapter(
                    handle,
                    vulkanCopyCString(
                        properties,
                        vulkanDriverOffsetVkPhysicalDeviceProperties_deviceName,
                        256
                    ),
                    vulkanDriverLoadI32Offset(
                        properties,
                        vulkanDriverOffsetVkPhysicalDeviceProperties_apiVersion
                    ),
                    vulkanDriverLoadI32Offset(
                        properties,
                        vulkanDriverOffsetVkPhysicalDeviceProperties_driverVersion
                    ),
                    vulkanDriverLoadI32Offset(
                        properties,
                        vulkanDriverOffsetVkPhysicalDeviceProperties_vendorID
                    ),
                    vulkanDriverLoadI32Offset(
                        properties,
                        vulkanDriverOffsetVkPhysicalDeviceProperties_deviceID
                    ),
                    vulkanDriverLoadI32Offset(
                        properties,
                        vulkanDriverOffsetVkPhysicalDeviceProperties_deviceType
                    )
                ))
                index = index + 1
            }
        }
    }
    result
}

trusted fun VulkanAdapter.graphicsQueueFamily(): int {
    val count = nativeI64Cell(0)
    vkGetPhysicalDeviceQueueFamilyProperties(
        this.handle,
        count.address,
        nativeNullPointer()
    )
    var measured = count.load() & 4294967295
    if (measured > 256) measured = 0
    var selected = -1
    if (measured > 0) {
        val properties = nativeByteBuffer(
            measured * vulkanDriverSizeVkQueueFamilyProperties
        )
        vkGetPhysicalDeviceQueueFamilyProperties(
            this.handle,
            count.address,
            properties.address
        )
        measured = count.load() & 4294967295
        var index = 0
        while (selected < 0 && index < measured) {
            val baseOffset = index * vulkanDriverSizeVkQueueFamilyProperties
            val flags = vulkanDriverLoadI32Offset(
                properties, baseOffset +
                    vulkanDriverOffsetVkQueueFamilyProperties_queueFlags
            )
            val queues = vulkanDriverLoadI32Offset(
                properties, baseOffset +
                    vulkanDriverOffsetVkQueueFamilyProperties_queueCount
            )
            if ((flags & 1) != 0 && queues > 0) selected = index
            index = index + 1
        }
    }
    selected
}

trusted fun VulkanAdapter.queueFamilyFlags(queueFamily: int): int {
    val count = nativeI64Cell(0)
    vkGetPhysicalDeviceQueueFamilyProperties(
        this.handle,
        count.address,
        nativeNullPointer()
    )
    var measured = count.load() & 4294967295
    var flags = 0
    if (queueFamily >= 0 && queueFamily < measured && measured <= 256) {
        val properties = nativeByteBuffer(
            measured * vulkanDriverSizeVkQueueFamilyProperties
        )
        vkGetPhysicalDeviceQueueFamilyProperties(
            this.handle,
            count.address,
            properties.address
        )
        measured = count.load() & 4294967295
        if (queueFamily < measured) {
            flags = vulkanDriverLoadI32Offset(
                properties,
                queueFamily * vulkanDriverSizeVkQueueFamilyProperties +
                    vulkanDriverOffsetVkQueueFamilyProperties_queueFlags
            )
        }
    }
    flags
}

trusted fun VulkanAdapter.queueFamilyTimestampValidBits(
    queueFamily: int
): int {
    val count = nativeI64Cell(0)
    vkGetPhysicalDeviceQueueFamilyProperties(
        this.handle,
        count.address,
        nativeNullPointer()
    )
    var measured = count.load() & 4294967295
    var bits = 0
    if (queueFamily >= 0 && queueFamily < measured && measured <= 256) {
        val properties = nativeByteBuffer(
            measured * vulkanDriverSizeVkQueueFamilyProperties
        )
        vkGetPhysicalDeviceQueueFamilyProperties(
            this.handle,
            count.address,
            properties.address
        )
        measured = count.load() & 4294967295
        if (queueFamily < measured) {
            bits = vulkanDriverLoadI32Offset(
                properties,
                queueFamily * vulkanDriverSizeVkQueueFamilyProperties +
                    vulkanDriverOffsetVkQueueFamilyProperties_timestampValidBits
            )
        }
    }
    bits
}

trusted fun VulkanAdapter.capabilities(): GraphicsCapabilities {
    val properties = nativeByteBuffer(vulkanDriverSizeVkPhysicalDeviceProperties)
    val deviceFeatures = vulkanDriverZeroedStructure(
        "VkPhysicalDeviceFeatures"
    )
    val memoryProperties = nativeByteBuffer(
        vulkanDriverSizeVkPhysicalDeviceMemoryProperties
    )
    vkGetPhysicalDeviceProperties(this.handle, properties.address)
    vkGetPhysicalDeviceFeatures(this.handle, deviceFeatures.address)
    vkGetPhysicalDeviceMemoryProperties(this.handle, memoryProperties.address)
    val queueFamily = this.graphicsQueueFamily()
    val queueFlags = this.queueFamilyFlags(queueFamily)
    val timestampValidBits = this.queueFamilyTimestampValidBits(queueFamily)
    var features = graphicsFeatureSampledTextures |
        graphicsFeatureDepthTextures | graphicsFeatureComparisonSamplers |
        graphicsFeatureViewFormatReinterpretation
    val memoryTypeCount = vulkanDriverLoadI32Offset(
        memoryProperties,
        vulkanDriverOffsetVkPhysicalDeviceMemoryProperties_memoryTypeCount
    )
    var memoryTypeIndex = 0
    var coherentHostMemory = false
    while (!coherentHostMemory && memoryTypeIndex < memoryTypeCount &&
        memoryTypeIndex < 32) {
        val flags = vulkanDriverLoadI32Offset(
            memoryProperties,
            vulkanDriverOffsetVkPhysicalDeviceMemoryProperties_memoryTypes +
                memoryTypeIndex * vulkanDriverSizeVkMemoryType +
                vulkanDriverOffsetVkMemoryType_propertyFlags
        )
        coherentHostMemory = (flags & 6) == 6
        memoryTypeIndex = memoryTypeIndex + 1
    }
    if (coherentHostMemory) {
        features = features | graphicsFeaturePersistentMapping
    }
    if ((queueFlags & 2) != 0) {
        features = features | graphicsFeatureCompute |
            graphicsFeatureStorageBuffers | graphicsFeatureStorageTextures
    }
    if ((features & graphicsFeatureStorageTextures) != 0 &&
        vulkanDriverLoadI32(
            deviceFeatures, "VkPhysicalDeviceFeatures",
            "fragmentStoresAndAtomics"
        ) != 0) {
        features = features | graphicsFeatureFragmentStorageTextures
    }
    if ((features & graphicsFeatureStorageTextures) != 0 &&
        vulkanDriverLoadI32(
            deviceFeatures, "VkPhysicalDeviceFeatures",
            "shaderStorageImageExtendedFormats"
        ) != 0) {
        features = features | graphicsFeatureStorageTextureExtendedFormats
    }
    if ((features & graphicsFeatureStorageTextures) != 0 &&
        // Required by the SPIR-V ImageCubeArray storage-image capability.
        vulkanDriverLoadI32(
            deviceFeatures, "VkPhysicalDeviceFeatures", "imageCubeArray"
        ) != 0) {
        features = features | graphicsFeatureCubeStorageTextures
    }
    val maximumAnisotropy = graphicsPositiveF32Floor(
        vulkanDriverLoadI32Offset(
            properties,
            vulkanDriverOffsetVkPhysicalDeviceProperties_limits +
                vulkanDriverOffsetVkPhysicalDeviceLimits_maxSamplerAnisotropy
        )
    )
    if (vulkanDriverLoadI32(
        deviceFeatures, "VkPhysicalDeviceFeatures", "samplerAnisotropy"
    ) != 0 &&
        maximumAnisotropy > 1) {
        features = features | graphicsFeatureSamplerAnisotropy
    }
    if (timestampValidBits > 0 &&
        graphicsPositiveF32Value(
            vulkanDriverLoadI32Offset(
                properties,
                vulkanDriverOffsetVkPhysicalDeviceProperties_limits +
                    vulkanDriverOffsetVkPhysicalDeviceLimits_timestampPeriod
            )
        ) > 0.0) {
        features = features | graphicsFeatureTimestampQueries
    }
    GraphicsCapabilities(
        features,
        GraphicsLimits(
            vulkanDriverLoadI32At(
                properties,
                vulkanDriverOffsetVkPhysicalDeviceProperties_limits,
                "VkPhysicalDeviceLimits", "maxImageDimension2D"
            ),
            vulkanDriverLoadI32At(
                properties,
                vulkanDriverOffsetVkPhysicalDeviceProperties_limits,
                "VkPhysicalDeviceLimits", "maxStorageBufferRange"
            ),
            vulkanDriverLoadI32At(
                properties,
                vulkanDriverOffsetVkPhysicalDeviceProperties_limits,
                "VkPhysicalDeviceLimits", "maxComputeWorkGroupCount", 0
            ),
            vulkanDriverLoadI32At(
                properties,
                vulkanDriverOffsetVkPhysicalDeviceProperties_limits,
                "VkPhysicalDeviceLimits", "maxComputeWorkGroupSize", 0
            ),
            vulkanDriverLoadI32At(
                properties,
                vulkanDriverOffsetVkPhysicalDeviceProperties_limits,
                "VkPhysicalDeviceLimits", "maxComputeWorkGroupInvocations"
            ),
            maximumAnisotropy,
            vulkanDriverLoadI32At(
                properties,
                vulkanDriverOffsetVkPhysicalDeviceProperties_limits,
                "VkPhysicalDeviceLimits", "maxComputeWorkGroupCount", 1
            ),
            vulkanDriverLoadI32At(
                properties,
                vulkanDriverOffsetVkPhysicalDeviceProperties_limits,
                "VkPhysicalDeviceLimits", "maxComputeWorkGroupCount", 2
            ),
            vulkanDriverLoadI32At(
                properties,
                vulkanDriverOffsetVkPhysicalDeviceProperties_limits,
                "VkPhysicalDeviceLimits", "maxComputeWorkGroupSize", 1
            ),
            vulkanDriverLoadI32At(
                properties,
                vulkanDriverOffsetVkPhysicalDeviceProperties_limits,
                "VkPhysicalDeviceLimits", "maxComputeWorkGroupSize", 2
            ),
            vulkanDriverLoadI64At(
                properties,
                vulkanDriverOffsetVkPhysicalDeviceProperties_limits,
                "VkPhysicalDeviceLimits", "minUniformBufferOffsetAlignment"
            ),
            vulkanDriverLoadI64At(
                properties,
                vulkanDriverOffsetVkPhysicalDeviceProperties_limits,
                "VkPhysicalDeviceLimits", "minStorageBufferOffsetAlignment"
            ),
            vulkanDriverLoadI32At(
                properties,
                vulkanDriverOffsetVkPhysicalDeviceProperties_limits,
                "VkPhysicalDeviceLimits", "maxImageDimension1D"
            ),
            vulkanDriverLoadI32At(
                properties,
                vulkanDriverOffsetVkPhysicalDeviceProperties_limits,
                "VkPhysicalDeviceLimits", "maxImageDimension3D"
            ),
            vulkanDriverLoadI32At(
                properties,
                vulkanDriverOffsetVkPhysicalDeviceProperties_limits,
                "VkPhysicalDeviceLimits", "maxImageArrayLayers"
            ),
            vulkanDriverLoadI32At(
                properties,
                vulkanDriverOffsetVkPhysicalDeviceProperties_limits,
                "VkPhysicalDeviceLimits", "maxImageDimensionCube"
            )
        ),
        GraphicsVersion(
            vulkanVersionMajor(this.apiVersion),
            vulkanVersionMinor(this.apiVersion),
            vulkanVersionPatch(this.apiVersion)
        )
    )
}

trusted fun VulkanAdapter.enabledDeviceFeatures(): NativeByteBuffer {
    val available = vulkanDriverZeroedStructure("VkPhysicalDeviceFeatures")
    val enabled = vulkanDriverZeroedStructure("VkPhysicalDeviceFeatures")
    vkGetPhysicalDeviceFeatures(this.handle, available.address)
    if (vulkanDriverLoadI32(
        available, "VkPhysicalDeviceFeatures", "samplerAnisotropy"
    ) != 0) {
        vulkanDriverStoreI32(
            enabled, "VkPhysicalDeviceFeatures", "samplerAnisotropy", 1
        )
    }
    if (vulkanDriverLoadI32(
        available, "VkPhysicalDeviceFeatures", "imageCubeArray"
    ) != 0) {
        vulkanDriverStoreI32(
            enabled, "VkPhysicalDeviceFeatures", "imageCubeArray", 1
        )
    }
    if (vulkanDriverLoadI32(
        available, "VkPhysicalDeviceFeatures", "fragmentStoresAndAtomics"
    ) != 0) {
        vulkanDriverStoreI32(
            enabled, "VkPhysicalDeviceFeatures",
            "fragmentStoresAndAtomics", 1
        )
    }
    if (vulkanDriverLoadI32(
        available, "VkPhysicalDeviceFeatures", "shaderStorageImageExtendedFormats"
    ) != 0) {
        vulkanDriverStoreI32(
            enabled, "VkPhysicalDeviceFeatures",
            "shaderStorageImageExtendedFormats", 1
        )
    }
    enabled
}

trusted fun VulkanAdapter.timelineSemaphoreSupported(): bool {
    val features12 = vulkanDriverZeroedStructure(
        "VkPhysicalDeviceVulkan12Features"
    )
    val features2 = vulkanDriverZeroedStructure(
        "VkPhysicalDeviceFeatures2"
    )
    vulkanDriverStorePointer(
        features2, "VkPhysicalDeviceFeatures2", "pNext", features12.address
    )
    if (this.apiVersion >= vulkanApiVersion12) {
        vkGetPhysicalDeviceFeatures2(this.handle, features2.address)
    }
    this.apiVersion >= vulkanApiVersion12 &&
        vulkanDriverLoadI32(
            features12, "VkPhysicalDeviceVulkan12Features",
            "timelineSemaphore"
        ) != 0
}

trusted fun VulkanAdapter.synchronization2Supported(): bool {
    this.vulkan13Features().synchronization2
}

class Vulkan13FeatureSupport(
    val synchronization2: bool,
    val dynamicRendering: bool
)

trusted fun VulkanAdapter.vulkan13Features(): Vulkan13FeatureSupport {
    val features13 = vulkanDriverZeroedStructure(
        "VkPhysicalDeviceVulkan13Features"
    )
    val features2 = vulkanDriverZeroedStructure(
        "VkPhysicalDeviceFeatures2"
    )
    vulkanDriverStorePointer(
        features2, "VkPhysicalDeviceFeatures2", "pNext", features13.address
    )
    if (this.apiVersion >= vulkanApiVersion13) {
        vkGetPhysicalDeviceFeatures2(this.handle, features2.address)
    }
    Vulkan13FeatureSupport(
        this.apiVersion >= vulkanApiVersion13 &&
            vulkanDriverLoadI32(
                features13, "VkPhysicalDeviceVulkan13Features",
                "synchronization2"
            ) != 0,
        this.apiVersion >= vulkanApiVersion13 &&
            vulkanDriverLoadI32(
                features13, "VkPhysicalDeviceVulkan13Features",
                "dynamicRendering"
            ) != 0
    )
}

fun vulkanEnabledTimelineSemaphoreFeatures(
    enabled: bool
): NativeByteBuffer {
    val features = vulkanDriverZeroedStructure(
        "VkPhysicalDeviceVulkan12Features"
    )
    if (enabled) vulkanDriverStoreI32(
        features, "VkPhysicalDeviceVulkan12Features", "timelineSemaphore", 1
    )
    features
}

fun vulkanEnabledVulkan13Features(
    synchronization2: bool,
    dynamicRendering: bool
): NativeByteBuffer {
    val features = vulkanDriverZeroedStructure(
        "VkPhysicalDeviceVulkan13Features"
    )
    if (synchronization2) vulkanDriverStoreI32(
        features, "VkPhysicalDeviceVulkan13Features", "synchronization2", 1
    )
    if (dynamicRendering) vulkanDriverStoreI32(
        features, "VkPhysicalDeviceVulkan13Features", "dynamicRendering", 1
    )
    features
}

resource class VulkanTimestampQuery(
    val device: i64*,
    val queue: i64*,
    var queryPool: int,
    var commandPool: int,
    val command: NativePointerCell,
    val scratch: NativeByteBuffer,
    val result: NativeI64Cell,
    val validBits: int,
    val periodNanoseconds: f64
) {
    fun valid(): bool = !pointerIsNull(this.device) &&
        !pointerIsNull(this.queue) && this.queryPool != 0 &&
        this.commandPool != 0 && !this.command.closed &&
        !pointerIsNull(this.command.load()) && !this.scratch.closed &&
        this.scratch.capacity >= 72 && !this.result.closed &&
        this.validBits > 0 && this.validBits <= 63 &&
        this.periodNanoseconds > 0.0

    trusted fun sampleTicks(): int {
        var succeeded = this.valid() && vkResetCommandPool(
            this.device,
            this.commandPool,
            0
        ) == vulkanSuccess
        if (succeeded) {
            succeeded = vulkanDriverCommandBufferBeginInfoAt(
                this.scratch, 0, 1
            ) && vkBeginCommandBuffer(
                this.command.load(),
                this.scratch.address
            ) == vulkanSuccess
        }
        if (succeeded) {
            vkCmdResetQueryPool(this.command.load(), this.queryPool, 0, 1)
            vkCmdWriteTimestamp(
                this.command.load(),
                8192,
                this.queryPool,
                0
            )
            succeeded = vkEndCommandBuffer(this.command.load()) ==
                vulkanSuccess
        }
        if (succeeded) {
            succeeded = vulkanDriverSubmitInfoAt(
                this.scratch, 0, 1, this.command.address
            ) && vkQueueSubmit(
                this.queue,
                1,
                this.scratch.address,
                0
            ) == vulkanSuccess
        }
        if (succeeded) {
            succeeded = vkQueueWaitIdle(this.queue) == vulkanSuccess &&
                this.result.store(0) && vkGetQueryPoolResults(
                    this.device,
                    this.queryPool,
                    0,
                    1,
                    8,
                    this.result.address,
                    8,
                    3
                ) == vulkanSuccess
        }
        var ticks = -1
        if (succeeded) {
            val mask = if (this.validBits == 63)
                9223372036854775807
            else (1 << this.validBits) - 1
            ticks = this.result.load() & mask
        }
        ticks
    }

    trusted fun drop(): void {
        if (!pointerIsNull(this.queue)) vkQueueWaitIdle(this.queue)
        if (this.queryPool != 0 && !pointerIsNull(this.device)) {
            vkDestroyQueryPool(
                this.device,
                this.queryPool,
                nativeNullPointer()
            )
            this.queryPool = 0
        }
        if (this.commandPool != 0 && !pointerIsNull(this.device)) {
            vkDestroyCommandPool(
                this.device,
                this.commandPool,
                nativeNullPointer()
            )
            this.commandPool = 0
            this.command.store(nativeNullPointer())
        }
        this.command.close()
        this.scratch.close()
        this.result.close()
        return
    }
}

resource class VulkanTimelineSemaphore(
    val device: i64*,
    var handle: int,
    val scratch: NativeByteBuffer
) {
    fun valid(): bool = !pointerIsNull(this.device) && this.handle != 0 &&
        !this.scratch.closed && this.scratch.capacity >= 64

    trusted fun currentValue(): int {
        var value = -1
        if (this.valid() && vkGetSemaphoreCounterValue(
            this.device,
            this.handle,
            this.scratch.pointerAt(56)
        ) == vulkanSuccess) value = this.scratch.loadI64(56)
        value
    }

    trusted fun signal(value: int): bool {
        val current = this.currentValue()
        var succeeded = current >= 0 && value > current
        if (succeeded) {
            succeeded = vulkanDriverSemaphoreSignalInfoAt(
                this.scratch, 0, this.handle, value
            )
        }
        if (succeeded) {
            succeeded = vkSignalSemaphore(
                this.device,
                this.scratch.address
            ) == vulkanSuccess
        }
        succeeded
    }

    trusted fun wait(value: int, timeoutNanoseconds: int): bool {
        var succeeded = this.valid() && value >= 0 &&
            timeoutNanoseconds >= 0
        if (succeeded) {
            this.scratch.storeI64(40, this.handle)
            this.scratch.storeI64(48, value)
