            vkCmdDispatch(this.commandBuffer, x, y, z)
            succeeded = vkEndCommandBuffer(this.commandBuffer) == vulkanSuccess
        }
        if (succeeded) {
            val submit = nativeByteBuffer(72)
            submit.storeI64(0, 4)
            submit.storePointer(8, nativeNullPointer())
            submit.storeI64(16, 0)
            submit.storePointer(24, nativeNullPointer())
            submit.storePointer(32, nativeNullPointer())
            submit.storeI64(40, 1)
            submit.storePointer(48, command.address)
            submit.storeI64(56, 0)
            submit.storePointer(64, nativeNullPointer())
            succeeded = vkQueueSubmit(
                this.queue,
                1,
                submit.address,
                0
            ) == vulkanSuccess
        }
        if (succeeded) succeeded =
            vkQueueWaitIdle(this.queue) == vulkanSuccess
        succeeded
    }

    trusted fun drop(): void {
        if (this.handle != 0 && !pointerIsNull(this.device)) {
            vkDestroyPipeline(this.device, this.handle, nativeNullPointer())
            this.handle = 0
        }
        if (this.commandPool != 0 && !pointerIsNull(this.device)) {
            vkDestroyCommandPool(
                this.device,
                this.commandPool,
                nativeNullPointer()
            )
            this.commandPool = 0
            this.commandBuffer = nativeNullPointer()
        }
        if (this.descriptorPool != 0 && !pointerIsNull(this.device)) {
            vkDestroyDescriptorPool(
                this.device,
                this.descriptorPool,
                nativeNullPointer()
            )
            this.descriptorPool = 0
            this.descriptorSet = 0
        }
        if (this.layout != 0 && !pointerIsNull(this.device)) {
            vkDestroyPipelineLayout(
                this.device,
                this.layout,
                nativeNullPointer()
            )
            this.layout = 0
        }
        if (this.descriptorSetLayout != 0 && !pointerIsNull(this.device)) {
            vkDestroyDescriptorSetLayout(
                this.device,
                this.descriptorSetLayout,
                nativeNullPointer()
            )
            this.descriptorSetLayout = 0
        }
        return
    }
}

trusted fun VulkanDevice.computePipelineNative(
