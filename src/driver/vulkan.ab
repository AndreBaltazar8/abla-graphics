            if (this.descriptorSet != 0) {
                val descriptor = nativeI64Cell(this.descriptorSet)
                vkCmdBindDescriptorSets(
                    this.commandBuffer,
                    1,
                    this.layout,
                    0,
                    1,
                    descriptor.address,
                    0,
                    nativeNullPointer()
                )
