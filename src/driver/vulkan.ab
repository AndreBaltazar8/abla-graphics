trusted fun VulkanDevice.shaderModule(
    module: SpirvModule
): VulkanShaderModule {
    var handle = 0
    if (this.valid() && module.valid()) {
        val code = nativeByteBuffer(module.words.size * 4)
        var index = 0
        while (index < module.words.size) {
            val word = module.words[index]
            code.store(index * 4, word & 255)
            code.store(index * 4 + 1, (word >> 8) & 255)
            code.store(index * 4 + 2, (word >> 16) & 255)
            code.store(index * 4 + 3, (word >> 24) & 255)
            index = index + 1
        }
        val createInfo = nativeByteBuffer(40)
        createInfo.storeI64(0, 16)
        createInfo.storePointer(8, nativeNullPointer())
        createInfo.storeI64(16, 0)
        createInfo.storeI64(24, module.words.size * 4)
        createInfo.storePointer(32, code.address)
        val output = nativeI64Cell(0)
        if (vkCreateShaderModule(
            this.handle,
            createInfo.address,
            nativeNullPointer(),
            output.address
        ) == vulkanSuccess) handle = output.load()
    }
    VulkanShaderModule(this.handle, handle)
}

resource class VulkanComputePipeline(
    val device: i64*,
    val queue: i64*,
    val queueFamily: int,
    var layout: int,
    var handle: int,
    var commandPool: int,
    var commandBuffer: i64*,
    var descriptorSetLayout: int,
    var descriptorPool: int,
    var descriptorSet: int
) {
    fun valid(): bool = !pointerIsNull(this.device) &&
        !pointerIsNull(this.queue) && this.queueFamily >= 0 &&
        this.layout != 0 && this.handle != 0 && this.commandPool != 0 &&
        !pointerIsNull(this.commandBuffer)

    trusted fun dispatch(x: int, y: int = 1, z: int = 1): bool {
        var succeeded = this.valid() && x > 0 && y > 0 && z > 0 &&
            x <= 65535 && y <= 65535 && z <= 65535
        val command = nativePointerCell(this.commandBuffer)
        if (succeeded) succeeded = vkResetCommandPool(
            this.device,
            this.commandPool,
            0
