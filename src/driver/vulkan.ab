// Vulkan loader ABI implemented in Abla.
//
// Driver structures are laid out in bounded Abla native buffers. The only
// external code is the installed Vulkan loader/driver required by the Vulkan
// specification itself; this repository supplies no C shim.

import "abla/unsafe/memory"
import "../core.ab"
import "../resources.ab"
import "../pixels.ab"
import "../shader/spirv.ab"
import "../platform/x11.ab"
import "../platform/x11_wsi.ab"

val vulkanSuccess = 0
val vulkanStructureApplicationInfo = 0
val vulkanStructureInstanceCreateInfo = 1
val vulkanApiVersion10 = 4194304
val vulkanApiVersion14 = 4210688

