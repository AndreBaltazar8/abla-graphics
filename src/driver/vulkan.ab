    semaphoreInfo.storeI64(0, 9)
    semaphoreInfo.storePointer(8, nativeNullPointer())
    semaphoreInfo.storeI64(16, 0)
    if (succeeded) {
        succeeded = vkCreateSemaphore(
            this.handle,
            semaphoreInfo.address,
            nativeNullPointer(),
            acquired.address
        ) == vulkanSuccess
    }
    if (succeeded) {
        val fenceInfo = nativeByteBuffer(24)
        fenceInfo.storeI64(0, 8)
        fenceInfo.storePointer(8, nativeNullPointer())
        fenceInfo.storeI64(16, 0)
        succeeded = vkCreateFence(
            this.handle,
            fenceInfo.address,
            nativeNullPointer(),
            fence.address
        ) == vulkanSuccess
    }
    if (!succeeded) {
        if (fence.load() != 0) {
            vkDestroyFence(
                this.handle,
                fence.load(),
                nativeNullPointer()
            )
            fence.store(0)
        }
        if (acquired.load() != 0) {
            vkDestroySemaphore(
                this.handle,
                acquired.load(),
                nativeNullPointer()
            )
            acquired.store(0)
        }
        if (pool.load() != 0) {
            vkDestroyCommandPool(
                this.handle,
                pool.load(),
                nativeNullPointer()
