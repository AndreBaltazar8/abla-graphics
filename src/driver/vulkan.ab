        val poolInfo = nativeByteBuffer(40)
        poolInfo.storeI64(0, 33)
        poolInfo.storePointer(8, nativeNullPointer())
        poolInfo.storeI64(16, 4294967296)
        poolInfo.storeI64(24, 1)
        poolInfo.storePointer(32, poolSize.address)
        val output = nativeI64Cell(0)
        if (vkCreateDescriptorPool(
            this.handle,
            poolInfo.address,
            nativeNullPointer(),
            output.address
        ) == vulkanSuccess) descriptorPool = output.load()
    }
    if (descriptorPool != 0) {
        val setLayout = nativeI64Cell(descriptorSetLayout)
        val allocateInfo = nativeByteBuffer(40)
        allocateInfo.storeI64(0, 34)
        allocateInfo.storePointer(8, nativeNullPointer())
        allocateInfo.storeI64(16, descriptorPool)
        allocateInfo.storeI64(24, 1)
        allocateInfo.storePointer(32, setLayout.address)
