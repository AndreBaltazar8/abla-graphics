trusted fun VulkanDevice.pixelPresenter(
    swapchain: VulkanSwapchain,
    framesInFlight: int = 2
): VulkanPixelPresenter {
    val size = if (swapchain.valid())
        swapchain.width * swapchain.height * 4
    else 0
    val frames: array<VulkanPixelFrame> = []
    val rendered: array<int> = []
    val semaphoreInfo = nativeByteBuffer(24)
    semaphoreInfo.storeI64(0, 9)
    semaphoreInfo.storePointer(8, nativeNullPointer())
    semaphoreInfo.storeI64(16, 0)
