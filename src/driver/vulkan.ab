        vkDestroySemaphore(
            this.handle,
            rendered.load(),
            nativeNullPointer()
        )
    }
    if (acquired.load() != 0) {
        vkDestroySemaphore(
            this.handle,
            acquired.load(),
            nativeNullPointer()
