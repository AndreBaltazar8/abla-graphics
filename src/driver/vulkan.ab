            submit.storePointer(8, nativeNullPointer())
            submit.storeI64(16, 0)
            submit.storePointer(24, nativeNullPointer())
            submit.storePointer(32, nativeNullPointer())
            submit.storeI64(40, 1)
            submit.storePointer(48, command.address)
            submit.storeI64(56, 0)
            submit.storePointer(64, nativeNullPointer())
