        createInfo.storeI64(0, 29)
        createInfo.storePointer(8, nativeNullPointer())
        createInfo.storeI64(16, 0)
        createInfo.storeI64(24, 18)
        createInfo.storePointer(32, nativeNullPointer())
        createInfo.storeI64(40, 32 * 4294967296)
        createInfo.storeI64(48, shader.handle)
        createInfo.storePointer(
            56,
            nativePointerFromAddress(nativeCStringAddress("main"))
