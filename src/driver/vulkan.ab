// Vulkan loader ABI implemented in Abla.
//
// Driver structures are laid out in bounded Abla native buffers. The only
// external code is the installed Vulkan loader/driver required by the Vulkan
// specification itself; this repository supplies no C shim.

import "abla/unsafe/memory"
import "../core.ab"
import "../resources.ab"
import "../pixels.ab"
import "../bytes.ab"
import "../shader/spirv.ab"
import "../platform/x11.ab"
import "../platform/x11_wsi.ab"

val vulkanSuccess = 0
val vulkanSuboptimal = 1000001003
val vulkanErrorOutOfDate = -1000001004
val vulkanStructureApplicationInfo = 0
val vulkanStructureInstanceCreateInfo = 1
val vulkanApiVersion10 = 4194304
val vulkanApiVersion14 = 4210688

fun vulkanPresentOutcome(
    presented: bool,
    recreateSwapchain: bool,
    status: int,
    submitted: bool = false
): int {
    var outcome = status & 4294967295
    if (presented) outcome = outcome | 4294967296
    if (recreateSwapchain) outcome = outcome | 8589934592
    if (submitted) outcome = outcome | 17179869184
    outcome
}

fun vulkanPresentStatus(status: int): int = vulkanPresentOutcome(
    status == vulkanSuccess || status == vulkanSuboptimal,
    status == vulkanSuboptimal || status == vulkanErrorOutOfDate,
    status
)

fun vulkanPresentSucceeded(outcome: int): bool =
    (outcome & 4294967296) != 0

fun vulkanPresentNeedsRecreation(outcome: int): bool =
    (outcome & 8589934592) != 0

fun vulkanPresentWasSubmitted(outcome: int): bool =
    (outcome & 17179869184) != 0

fun vulkanPresentResult(outcome: int): int {
    val status = outcome & 4294967295
    if (status >= 2147483648) status - 4294967296 else status
}

