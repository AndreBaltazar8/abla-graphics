    }
    if (handle != 0) {
        val requirements = nativeByteBuffer(24)
        vkGetBufferMemoryRequirements(
            this.handle,
            handle,
            requirements.address
        )
        val allocationSize = requirements.loadI64(0)
        val typeBits = requirements.loadI64(16) & 4294967295
        val properties = nativeByteBuffer(1024)
        vkGetPhysicalDeviceMemoryProperties(
            this.physicalDevice,
            properties.address
        )
        val typeCount = properties.loadI64(0) & 4294967295
        var typeIndex = -1
        var index = 0
        while (typeIndex < 0 && index < typeCount && index < 32) {
            val flags = properties.loadI64(4 + index * 8) & 4294967295
            if ((typeBits & (1 << index)) != 0 &&
                (flags & 6) == 6) typeIndex = index
            index = index + 1
        }
        if (typeIndex >= 0) {
            val allocationInfo = nativeByteBuffer(32)
            allocationInfo.storeI64(0, 5)
            allocationInfo.storePointer(8, nativeNullPointer())
            allocationInfo.storeI64(16, allocationSize)
            allocationInfo.storeI64(24, typeIndex)
            val output = nativeI64Cell(0)
            if (vkAllocateMemory(
                this.handle,
                allocationInfo.address,
                nativeNullPointer(),
                output.address
            ) == vulkanSuccess) {
                memory = output.load()
            }
        }
    }
    if (handle != 0 && memory != 0 &&
        vkBindBufferMemory(
            this.handle,
            handle,
            memory,
            0
        ) != vulkanSuccess) {
        vkFreeMemory(this.handle, memory, nativeNullPointer())
        memory = 0
    }
    if (handle != 0 && memory == 0) {
        vkDestroyBuffer(this.handle, handle, nativeNullPointer())
        handle = 0
    }
    VulkanBuffer(
        this.handle,
        this.physicalDevice,
        this.queue,
        this.queueFamily,
        handle,
        memory,
        size
    )
}

trusted fun VulkanAdapter.deviceForSurface(
    surface: VulkanX11Surface
): VulkanDevice {
    val queueFamily = this.graphicsQueueFamily()
    var handle = nativeNullPointer()
    var queue = nativeNullPointer()
    if (queueFamily >= 0 && this.supportsSurface(surface, queueFamily)) {
        val priority = nativeByteBuffer(8)
        priority.storeI64(0, 1065353216)
        val queueInfo = nativeByteBuffer(40)
        queueInfo.storeI64(0, 2)
        queueInfo.storePointer(8, nativeNullPointer())
        queueInfo.storeI64(
            16,
            (queueFamily & 4294967295) * 4294967296
        )
        queueInfo.storeI64(24, 1)
        queueInfo.storePointer(32, priority.address)

        val extensionNames = nativeByteBuffer(8)
        extensionNames.storePointer(
            0,
            nativePointerFromAddress(
                nativeCStringAddress("VK_KHR_swapchain")
            )
        )
        val createInfo = nativeByteBuffer(72)
        createInfo.storeI64(0, 3)
        createInfo.storePointer(8, nativeNullPointer())
        createInfo.storeI64(16, 4294967296)
        createInfo.storePointer(24, queueInfo.address)
        createInfo.storeI64(32, 0)
        createInfo.storePointer(40, nativeNullPointer())
        createInfo.storeI64(48, 1)
        createInfo.storePointer(56, extensionNames.address)
        createInfo.storePointer(64, nativeNullPointer())

        val output = nativePointerCell(nativeNullPointer())
        if (vkCreateDevice(
            this.handle,
            createInfo.address,
            nativeNullPointer(),
            output.address
        ) == vulkanSuccess) {
            handle = output.load()
            val queueOutput = nativePointerCell(nativeNullPointer())
            vkGetDeviceQueue(
                handle,
                queueFamily,
                0,
                queueOutput.address
            )
            queue = queueOutput.load()
        }
    }
    VulkanDevice(
        handle,
        queue,
        queueFamily,
        this.apiVersion,
        this.handle
    )
}

class VulkanSurfaceFormat(
    val valid: bool,
    val format: int,
    val colorSpace: int
)

trusted fun VulkanAdapter.surfaceFormat(
    surface: VulkanX11Surface
): VulkanSurfaceFormat {
    val count = nativeI64Cell(0)
    var status = vkGetPhysicalDeviceSurfaceFormatsKHR(
        this.handle,
        surface.handle,
        count.address,
        nativeNullPointer()
    )
    var measured = count.load() & 4294967295
    if (measured > 256) measured = 0
    var selectedFormat = 0
    var selectedColorSpace = 0
    if (status == vulkanSuccess && measured > 0) {
        val formats = nativeByteBuffer(measured * 8)
        status = vkGetPhysicalDeviceSurfaceFormatsKHR(
            this.handle,
            surface.handle,
            count.address,
            formats.address
        )
        measured = count.load() & 4294967295
        if (status == vulkanSuccess && measured > 0) {
            selectedFormat = formats.loadI64(0) & 4294967295
            selectedColorSpace =
                (formats.loadI64(0) >>> 32) & 4294967295
            var index = 0
            while (index < measured) {
                val format = formats.loadI64(index * 8) & 4294967295
                val colorSpace =
                    (formats.loadI64(index * 8) >>> 32) & 4294967295
                if (format == 44 && colorSpace == 0) {
                    selectedFormat = format
                    selectedColorSpace = colorSpace
                }
                index = index + 1
            }
        }
    }
    VulkanSurfaceFormat(
        selectedFormat != 0,
        selectedFormat,
        selectedColorSpace
    )
}

resource class VulkanSwapchain(
    var handle: int,
    var device: i64*,
    val images: array<int>,
    val format: int,
    val colorSpace: int,
    val width: int,
    val height: int
) {
    trusted fun valid(): bool =
        this.handle != 0 && !pointerIsNull(this.device) &&
        this.images.size > 0 && this.width > 0 && this.height > 0

    trusted fun drop(): void {
        if (this.handle != 0 && !pointerIsNull(this.device)) {
            vkDestroySwapchainKHR(
                this.device,
                this.handle,
                nativeNullPointer()
            )
        }
        this.handle = 0
        this.device = nativeNullPointer()
        return
    }
}

trusted fun VulkanDevice.swapchain(
    adapter: VulkanAdapter,
    surface: VulkanX11Surface
): VulkanSwapchain {
    val images: array<int> = []
    val capabilities = adapter.surfaceCapabilities(surface)
    val selected = adapter.surfaceFormat(surface)
    var width = capabilities.width
    var height = capabilities.height
    if (width == 4294967295 || height == 4294967295) {
        width = surface.width
        height = surface.height
    }
    var imageCount = capabilities.minimumImages + 1
    if (capabilities.maximumImages > 0 &&
        imageCount > capabilities.maximumImages) {
        imageCount = capabilities.maximumImages
    }
    var usage = 0
    if ((capabilities.supportedUsage & 16) != 0) usage = usage | 16
    if ((capabilities.supportedUsage & 2) != 0) usage = usage | 2
    var compositeAlpha = 1
    if ((capabilities.supportedCompositeAlpha & 1) == 0) {
        if ((capabilities.supportedCompositeAlpha & 2) != 0) {
            compositeAlpha = 2
        } else if ((capabilities.supportedCompositeAlpha & 4) != 0) {
            compositeAlpha = 4
        } else compositeAlpha = 8
    }
    var handle = 0
    if (this.valid() && capabilities.valid && selected.valid &&
        width > 0 && height > 0 && imageCount > 0 &&
        (usage & 2) != 0) {
        val createInfo = nativeByteBuffer(104)
        createInfo.storeI64(0, 1000001000)
        createInfo.storePointer(8, nativeNullPointer())
        createInfo.storeI64(16, 0)
        createInfo.storeI64(24, surface.handle)
        createInfo.storeI64(
            32,
            (selected.format & 4294967295) * 4294967296 + imageCount
        )
        createInfo.storeI64(
            40,
            (width & 4294967295) * 4294967296 +
                (selected.colorSpace & 4294967295)
        )
        createInfo.storeI64(
            48,
            (1 * 4294967296) + (height & 4294967295)
        )
        createInfo.storeI64(56, usage)
        createInfo.storeI64(64, 0)
        createInfo.storePointer(72, nativeNullPointer())
        createInfo.storeI64(
            80,
            (compositeAlpha & 4294967295) * 4294967296 +
                (capabilities.currentTransform & 4294967295)
        )
        createInfo.storeI64(88, 4294967298)
        createInfo.storeI64(96, 0)
        val output = nativeI64Cell(0)
        if (vkCreateSwapchainKHR(
            this.handle,
            createInfo.address,
            nativeNullPointer(),
            output.address
        ) == vulkanSuccess) handle = output.load()
    }
    if (handle != 0) {
        val count = nativeI64Cell(0)
        var status = vkGetSwapchainImagesKHR(
            this.handle,
            handle,
            count.address,
            nativeNullPointer()
        )
        var measured = count.load() & 4294967295
        if (measured > 16) measured = 0
        if (status == vulkanSuccess && measured > 0) {
