    }
    if (handle != 0 && memory == 0) {
        vkDestroyBuffer(this.handle, handle, nativeNullPointer())
        handle = 0
    }
    VulkanBuffer(
        this.handle,
        this.physicalDevice,
        this.queue,
        this.queueFamily,
        handle,
        memory,
        size
    )
