trusted fun VulkanDevice.buffer(size: int): VulkanBuffer {
    var handle = 0
    var memory = 0
    if (this.valid() && size > 0 && size <= 1073741824) {
        val createInfo = nativeByteBuffer(56)
        createInfo.storeI64(0, 12)
        createInfo.storePointer(8, nativeNullPointer())
        createInfo.storeI64(16, 0)
        createInfo.storeI64(24, size)
        createInfo.storeI64(32, 35)
        createInfo.storeI64(40, 0)
        createInfo.storePointer(48, nativeNullPointer())
        val output = nativeI64Cell(0)
        if (vkCreateBuffer(
            this.handle,
            createInfo.address,
            nativeNullPointer(),
            output.address
        ) == vulkanSuccess) {
            handle = output.load()
