            )
            glSamplerParameteri(handle, 33082, descriptor.lodMinimum)
            glSamplerParameteri(handle, 33083, descriptor.lodMaximum)
            if (descriptor.compare == compareFunctionUndefined) {
                glSamplerParameteri(handle, 34892, 0)
            } else {
                glSamplerParameteri(handle, 34892, 34894)
