                openGlApplyRasterState(raster)
            if (presented) glDrawArrays(
                openGlPrimitiveMode(raster.topology),
                0,
                3
            )
            presented = presented && glGetError() == 0 &&
                eglSwapBuffers(this.display, this.surface) == eglTrue
        }
        presented
    }

    trusted fun presentProgramVertices(
        program: OpenGlProgram,
        vertices: OpenGlBuffer,
        vertexCount: int,
        instanceCount: int,
        vertexStride: int,
        clear: Color,
        raster: RasterPipelineState,
        depth: DepthStencilState
    ): bool {
        var presented = program.valid() && vertices.valid() &&
            vertexCount > 0 && instanceCount > 0 && vertexStride >= 8 &&
            vertexStride <= 2048 && clear.valid() && raster.valid() &&
            depth.valid() && this.makeCurrent()
        if (presented) {
            openGlStoreI32(
                this.clearScratch,
                0,
                graphicsScalarF32Bits(clear.red)
            )
            openGlStoreI32(
                this.clearScratch,
                1,
                graphicsScalarF32Bits(clear.green)
            )
            openGlStoreI32(
                this.clearScratch,
                2,
                graphicsScalarF32Bits(clear.blue)
            )
            openGlStoreI32(
                this.clearScratch,
                3,
                graphicsScalarF32Bits(clear.alpha)
            )
            glViewport(0, 0, this.width, this.height)
            glClearBufferfv(6144, 0, this.clearScratch.address)
            glUseProgram(program.handle)
            glBindVertexArray(program.vertexArray)
            glBindBuffer(34962, vertices.handle)
            glEnableVertexAttribArray(0)
            glVertexAttribPointer(
                0,
                2,
                5126,
                0,
                vertexStride,
                nativeNullPointer()
            )
            presented = openGlApplyDepthState(depth) &&
                openGlApplyRasterState(raster)
            if (presented) glDrawArraysInstanced(
                openGlPrimitiveMode(raster.topology),
                0,
                vertexCount,
                instanceCount
            )
            presented = presented && glGetError() == 0 &&
                eglSwapBuffers(this.display, this.surface) == eglTrue
        }
        presented
    }

    trusted fun presentProgramIndexed(
        program: OpenGlProgram,
        vertices: OpenGlBuffer,
        indices: OpenGlBuffer,
        indexCount: int,
        instanceCount: int,
        vertexStride: int,
        clear: Color,
        raster: RasterPipelineState,
        depth: DepthStencilState
    ): bool {
        var presented = program.valid() && vertices.valid() &&
            indices.valid() && indexCount > 0 && instanceCount > 0 &&
            vertexStride >= 8 &&
            vertexStride <= 2048 && clear.valid() && raster.valid() &&
            depth.valid() && this.makeCurrent()
        if (presented) {
            openGlStoreI32(
                this.clearScratch,
                0,
                graphicsScalarF32Bits(clear.red)
            )
            openGlStoreI32(
                this.clearScratch,
                1,
                graphicsScalarF32Bits(clear.green)
            )
            openGlStoreI32(
                this.clearScratch,
                2,
                graphicsScalarF32Bits(clear.blue)
            )
            openGlStoreI32(
                this.clearScratch,
                3,
                graphicsScalarF32Bits(clear.alpha)
            )
            glViewport(0, 0, this.width, this.height)
            glClearBufferfv(6144, 0, this.clearScratch.address)
            glUseProgram(program.handle)
            glBindVertexArray(program.vertexArray)
            glBindBuffer(34962, vertices.handle)
            glEnableVertexAttribArray(0)
            glVertexAttribPointer(
                0,
                2,
                5126,
                0,
                vertexStride,
                nativeNullPointer()
            )
            glBindBuffer(34963, indices.handle)
            presented = openGlApplyDepthState(depth) &&
                openGlApplyRasterState(raster)
            if (presented) glDrawElementsInstanced(
                    openGlPrimitiveMode(raster.topology),
                    indexCount,
                    5125,
                    nativeNullPointer(),
                    instanceCount
                )
            presented = presented && glGetError() == 0 &&
                eglSwapBuffers(this.display, this.surface) == eglTrue
        }
        presented
    }

    trusted fun drop(): void {
        if (!pointerIsNull(this.display)) {
            eglMakeCurrent(
                this.display,
                nativeNullPointer(),
                nativeNullPointer(),
                nativeNullPointer()
            )
            if (!pointerIsNull(this.context)) {
                eglDestroyContext(this.display, this.context)
            }
            if (!pointerIsNull(this.surface)) {
                eglDestroySurface(this.display, this.surface)
            }
            eglTerminate(this.display)
        }
        if (!pointerIsNull(this.nativeDisplay)) {
            XCloseDisplay(this.nativeDisplay)
        }
        this.context = nativeNullPointer()
        this.surface = nativeNullPointer()
        this.display = nativeNullPointer()
        this.nativeDisplay = nativeNullPointer()
        this.clearScratch.close()
        return
    }
}

trusted fun openGlWindowContext(
    window: X11Window
): OpenGlWindowContext {
    var nativeDisplay = nativeNullPointer()
    var display = nativeNullPointer()
    var surface = nativeNullPointer()
    var context = nativeNullPointer()
    if (window.valid() && window.visual != 0) {
        nativeDisplay = XOpenDisplay(nativeNullPointer())
    }
    if (!pointerIsNull(nativeDisplay)) {
        display = eglGetPlatformDisplay(
            eglPlatformX11,
            nativeDisplay,
            nativeNullPointer()
        )
    }
    if (!pointerIsNull(display)) {
        val major = nativeI64Cell(0)
        val minor = nativeI64Cell(0)
        if (eglInitialize(display, major.address, minor.address) != eglTrue ||
            eglBindAPI(eglOpenGlApi) != eglTrue) {
            eglTerminate(display)
            display = nativeNullPointer()
        }
    }
    var config = nativeNullPointer()
    if (!pointerIsNull(display)) {
        val attributes = openGlWindowConfigAttributes(window.visual)
        val configOutput = nativePointerCell(nativeNullPointer())
        val configCount = nativeI64Cell(0)
        if (eglChooseConfig(
            display,
            attributes.address,
            configOutput.address,
            1,
            configCount.address
        ) == eglTrue && configCount.load() > 0) {
            config = configOutput.load()
        }
    }
    if (!pointerIsNull(config)) {
        val nativeWindow = nativeI64Cell(window.identifier)
        surface = eglCreatePlatformWindowSurface(
            display,
            config,
            nativeWindow.address,
            nativeNullPointer()
        )
    }
    if (!pointerIsNull(surface)) {
        var attributes = openGlContextAttributes(4, 6)
        context = eglCreateContext(
            display,
            config,
            nativeNullPointer(),
            attributes.address
        )
        if (pointerIsNull(context)) {
            attributes = openGlContextAttributes(4, 5)
            context = eglCreateContext(
                display,
                config,
                nativeNullPointer(),
                attributes.address
            )
        }
        if (pointerIsNull(context)) {
            attributes = openGlContextAttributes(3, 3)
            context = eglCreateContext(
                display,
                config,
                nativeNullPointer(),
                attributes.address
            )
        }
    }
    if (pointerIsNull(context)) {
        if (!pointerIsNull(display)) {
            if (!pointerIsNull(surface)) {
                eglDestroySurface(display, surface)
            }
            eglTerminate(display)
        }
        if (!pointerIsNull(nativeDisplay)) XCloseDisplay(nativeDisplay)
        nativeDisplay = nativeNullPointer()
        display = nativeNullPointer()
        surface = nativeNullPointer()
    }
    OpenGlWindowContext(
        nativeDisplay,
        display,
        surface,
        context,
        window.width,
        window.height,
        nativeByteBuffer(16)
    )
}

trusted fun openGlHeadlessContext(
    width: int = 64,
    height: int = 64
): OpenGlContext {
    var display = nativeNullPointer()
    var surface = nativeNullPointer()
    var context = nativeNullPointer()
    if (width > 0 && width <= 16384 && height > 0 && height <= 16384) {
        display = eglGetPlatformDisplay(
            eglPlatformSurfacelessMesa,
            nativeNullPointer(),
            nativeNullPointer()
        )
    }
    if (!pointerIsNull(display)) {
        val major = nativeI64Cell(0)
        val minor = nativeI64Cell(0)
        if (eglInitialize(display, major.address, minor.address) != eglTrue ||
            eglBindAPI(eglOpenGlApi) != eglTrue) {
            eglTerminate(display)
            display = nativeNullPointer()
        }
    }
    var config = nativeNullPointer()
    if (!pointerIsNull(display)) {
        val attributes = openGlConfigAttributes()
        val configOutput = nativePointerCell(nativeNullPointer())
        val configCount = nativeI64Cell(0)
        if (eglChooseConfig(
            display,
            attributes.address,
            configOutput.address,
            1,
            configCount.address
        ) == eglTrue && configCount.load() > 0) {
            config = configOutput.load()
        }
    }
    if (!pointerIsNull(config)) {
        val attributes = openGlPbufferAttributes(width, height)
        surface = eglCreatePbufferSurface(
            display,
            config,
            attributes.address
        )
    }
    if (!pointerIsNull(surface)) {
        var attributes = openGlContextAttributes(4, 6)
        context = eglCreateContext(
            display,
            config,
            nativeNullPointer(),
            attributes.address
        )
        if (pointerIsNull(context)) {
            attributes = openGlContextAttributes(4, 5)
            context = eglCreateContext(
                display,
                config,
                nativeNullPointer(),
                attributes.address
            )
        }
        if (pointerIsNull(context)) {
            attributes = openGlContextAttributes(3, 3)
            context = eglCreateContext(
                display,
                config,
                nativeNullPointer(),
                attributes.address
            )
        }
    }
    if (pointerIsNull(context) && !pointerIsNull(display)) {
        if (!pointerIsNull(surface)) {
            eglDestroySurface(display, surface)
        }
        eglTerminate(display)
        display = nativeNullPointer()
        surface = nativeNullPointer()
    }
    OpenGlContext(display, surface, context, width, height)
}
