fun openGlStoreI32(
    var buffer: NativeByteBuffer,
    index: int,
    value: int
): void {
    val offset = index * 4
    buffer.store(offset, value & 255)
    buffer.store(offset + 1, (value >>> 8) & 255)
    buffer.store(offset + 2, (value >>> 16) & 255)
    buffer.store(offset + 3, (value >>> 24) & 255)
    return
}

fun openGlPrimitiveMode(topology: int): int {
    var mode = 4
    if (topology == primitiveTopologyPointList) mode = 0
    else if (topology == primitiveTopologyLineList) mode = 1
    else if (topology == primitiveTopologyLineStrip) mode = 3
    else if (topology == primitiveTopologyTriangleStrip) mode = 5
    mode
}

trusted fun openGlApplyRasterState(state: RasterPipelineState): bool {
    var succeeded = state.valid()
    if (succeeded) {
        if (state.cullMode == cullModeNone) glDisable(2884)
        else {
            glEnable(2884)
            glCullFace(if (state.cullMode == cullModeFront) 1028 else 1029)
        }
        glFrontFace(
            if (state.frontFace == frontFaceCounterClockwise) 2305 else 2304
        )
        if (state.alphaBlend) {
            glEnable(3042)
            glBlendEquationSeparate(32774, 32774)
            glBlendFuncSeparate(770, 771, 1, 771)
        } else glDisable(3042)
        succeeded = glGetError() == 0
    }
    succeeded
}

fun openGlCompareOperation(compare: int): int {
    var operation = 513
    if (compare == compareFunctionNever) operation = 512
    else if (compare == compareFunctionEqual) operation = 514
    else if (compare == compareFunctionLessEqual) operation = 515
    else if (compare == compareFunctionGreater) operation = 516
    else if (compare == compareFunctionNotEqual) operation = 517
    else if (compare == compareFunctionGreaterEqual) operation = 518
    else if (compare == compareFunctionAlways) operation = 519
    operation
}

trusted fun openGlApplyDepthState(state: DepthStencilState): bool {
    var succeeded = state.valid()
    if (succeeded) {
        if (state.enabled) {
            glEnable(2929)
            glDepthFunc(openGlCompareOperation(state.compare))
            glDepthMask(if (state.write) 1 else 0)
            glClearDepth(1.0)
            glClear(256)
        } else {
            glDisable(2929)
            glDepthMask(0)
        }
        succeeded = glGetError() == 0
    }
    succeeded
}

trusted fun openGlCurrentCapabilities(): GraphicsCapabilities {
    val major = nativeI64Cell(0)
    val minor = nativeI64Cell(0)
    val texture = nativeI64Cell(0)
    val storage = nativeI64Cell(0)
    val workgroupsX = nativeI64Cell(0)
    val workgroupsY = nativeI64Cell(0)
    val workgroupsZ = nativeI64Cell(0)
    val workgroupSizeX = nativeI64Cell(0)
    val workgroupSizeY = nativeI64Cell(0)
    val workgroupSizeZ = nativeI64Cell(0)
    val invocations = nativeI64Cell(0)
    val anisotropy = nativeI64Cell(0)
    glGetIntegerv(33307, major.address)
    glGetIntegerv(33308, minor.address)
    glGetIntegerv(3379, texture.address)
    val majorValue = major.load() & 4294967295
    val minorValue = minor.load() & 4294967295
    val compute = majorValue > 4 ||
        (majorValue == 4 && minorValue >= 3)
    if (compute) {
        glGetInteger64v(37086, storage.address)
        glGetIntegeri_v(37310, 0, workgroupsX.address)
        glGetIntegeri_v(37310, 1, workgroupsY.address)
        glGetIntegeri_v(37310, 2, workgroupsZ.address)
        glGetIntegeri_v(37311, 0, workgroupSizeX.address)
        glGetIntegeri_v(37311, 1, workgroupSizeY.address)
        glGetIntegeri_v(37311, 2, workgroupSizeZ.address)
        glGetIntegerv(37099, invocations.address)
    }
    val extensionCount = nativeI64Cell(0)
    glGetIntegerv(33309, extensionCount.address)
    var supportsAnisotropy = false
    var extensionIndex = 0
    while (!supportsAnisotropy &&
        extensionIndex < (extensionCount.load() & 4294967295)) {
        val extension = glGetStringi(7939, extensionIndex)
        if (!pointerIsNull(extension)) {
            val name = borrowNativeCString(extension)
            supportsAnisotropy =
                name == "GL_EXT_texture_filter_anisotropic" ||
                name == "GL_ARB_texture_filter_anisotropic"
        }
        extensionIndex = extensionIndex + 1
    }
    var maximumAnisotropy = 1
    if (supportsAnisotropy) {
        glGetFloatv(34047, anisotropy.address)
        maximumAnisotropy = graphicsPositiveF32Floor(
            anisotropy.load() & 4294967295
        )
    }
    var features = graphicsFeatureSampledTextures |
        graphicsFeatureDepthTextures | graphicsFeatureComparisonSamplers
    if (compute) {
        features = features | graphicsFeatureCompute |
            graphicsFeatureStorageBuffers
    }
    if (maximumAnisotropy > 1) {
        features = features | graphicsFeatureSamplerAnisotropy
    }
    GraphicsCapabilities(
        features,
        GraphicsLimits(
            texture.load() & 4294967295,
            storage.load(),
            workgroupsX.load() & 4294967295,
            workgroupSizeX.load() & 4294967295,
            invocations.load() & 4294967295,
            maximumAnisotropy,
            workgroupsY.load() & 4294967295,
            workgroupsZ.load() & 4294967295,
            workgroupSizeY.load() & 4294967295,
            workgroupSizeZ.load() & 4294967295
        ),
        GraphicsVersion(majorValue, minorValue)
    )
}

fun openGlConfigAttributes(): NativeByteBuffer {
    val values = nativeByteBuffer(64)
    openGlStoreI32(values, 0, 12339)
    openGlStoreI32(values, 1, 1)
    openGlStoreI32(values, 2, 12352)
    openGlStoreI32(values, 3, 8)
    openGlStoreI32(values, 4, 12324)
    openGlStoreI32(values, 5, 8)
    openGlStoreI32(values, 6, 12323)
    openGlStoreI32(values, 7, 8)
    openGlStoreI32(values, 8, 12322)
    openGlStoreI32(values, 9, 8)
    openGlStoreI32(values, 10, 12321)
    openGlStoreI32(values, 11, 8)
    openGlStoreI32(values, 12, 12325)
    openGlStoreI32(values, 13, 24)
    openGlStoreI32(values, 14, eglNone)
    values
}

fun openGlWindowConfigAttributes(visual: int): NativeByteBuffer {
    val values = nativeByteBuffer(80)
    openGlStoreI32(values, 0, 12339)
    openGlStoreI32(values, 1, 4)
    openGlStoreI32(values, 2, 12352)
    openGlStoreI32(values, 3, 8)
    openGlStoreI32(values, 4, 12334)
    openGlStoreI32(values, 5, visual)
    openGlStoreI32(values, 6, 12324)
    openGlStoreI32(values, 7, 8)
    openGlStoreI32(values, 8, 12323)
    openGlStoreI32(values, 9, 8)
    openGlStoreI32(values, 10, 12322)
    openGlStoreI32(values, 11, 8)
    openGlStoreI32(values, 12, 12321)
    openGlStoreI32(values, 13, 8)
    openGlStoreI32(values, 14, 12325)
    openGlStoreI32(values, 15, 24)
    openGlStoreI32(values, 16, eglNone)
    values
}

fun openGlPbufferAttributes(width: int, height: int): NativeByteBuffer {
    val values = nativeByteBuffer(24)
    openGlStoreI32(values, 0, 12375)
    openGlStoreI32(values, 1, width)
    openGlStoreI32(values, 2, 12374)
    openGlStoreI32(values, 3, height)
    openGlStoreI32(values, 4, eglNone)
    values
}

fun openGlContextAttributes(major: int, minor: int): NativeByteBuffer {
    val values = nativeByteBuffer(32)
    openGlStoreI32(values, 0, 12440)
    openGlStoreI32(values, 1, major)
    openGlStoreI32(values, 2, 12539)
    openGlStoreI32(values, 3, minor)
    openGlStoreI32(values, 4, 12541)
    openGlStoreI32(values, 5, 1)
    openGlStoreI32(values, 6, eglNone)
    values
}

resource class OpenGlContext(
    var display: i64*,
    var surface: i64*,
    var context: i64*,
    val width: int,
    val height: int
) {
    trusted fun valid(): bool =
        !pointerIsNull(this.display) &&
        !pointerIsNull(this.surface) &&
        !pointerIsNull(this.context)

    trusted fun makeCurrent(): bool =
        this.valid() &&
        eglMakeCurrent(
            this.display,
            this.surface,
            this.surface,
            this.context
        ) == eglTrue

    trusted fun version(): int {
        var version = 0
        if (this.makeCurrent()) {
            val major = nativeI64Cell(0)
            val minor = nativeI64Cell(0)
            glGetIntegerv(33307, major.address)
            glGetIntegerv(33308, minor.address)
            version = (major.load() & 4294967295) * 1000 +
                (minor.load() & 4294967295)
        }
        version
    }

    trusted fun capabilities(): GraphicsCapabilities =
        if (this.makeCurrent()) openGlCurrentCapabilities()
        else GraphicsCapabilities()

    trusted fun clearBlackAndReadRgba8(): int {
        var result = -1
        if (this.makeCurrent()) {
            glViewport(0, 0, this.width, this.height)
            glClear(16384)
            glFinish()
            val pixel = nativeByteBuffer(8)
            glReadPixels(0, 0, 1, 1, 6408, 5121, pixel.address)
            if (glGetError() == 0) {
                result = pixel.loadI64(0) & 4294967295
            }
        }
        result
    }

    trusted fun drop(): void {
        if (!pointerIsNull(this.display)) {
            eglMakeCurrent(
                this.display,
                nativeNullPointer(),
                nativeNullPointer(),
                nativeNullPointer()
            )
            if (!pointerIsNull(this.context)) {
                eglDestroyContext(this.display, this.context)
            }
            if (!pointerIsNull(this.surface)) {
                eglDestroySurface(this.display, this.surface)
            }
            eglTerminate(this.display)
        }
        this.context = nativeNullPointer()
        this.surface = nativeNullPointer()
        this.display = nativeNullPointer()
        return
    }
}

resource class OpenGlProgram(
    var handle: int,
    var vertexArray: int,
    val error: string
) {
    fun valid(): bool = this.handle != 0 && this.vertexArray != 0

    trusted fun drop(): void {
        if (this.handle != 0) glDeleteProgram(this.handle)
        if (this.vertexArray != 0) {
            val array = nativeI64Cell(this.vertexArray)
            glDeleteVertexArrays(1, array.address)
        }
        this.handle = 0
        this.vertexArray = 0
        return
    }
}

resource class OpenGlBuffer(
    var handle: int,
    val size: int,
    val display: i64*,
    val surface: i64*,
    val context: i64*,
    val scratch: NativeByteBuffer
) {
    fun valid(): bool = this.handle != 0 && this.size > 0 &&
        !pointerIsNull(this.display) && !pointerIsNull(this.context) &&
        !this.scratch.closed && this.scratch.capacity >= 8

    trusted fun makeCurrent(): bool = this.valid() && eglMakeCurrent(
        this.display,
        this.surface,
        this.surface,
        this.context
    ) == eglTrue

    trusted fun readI64(offset: int = 0): int {
        var result = 0
        if (offset >= 0 && offset <= this.size - 8 && this.makeCurrent()) {
            glBindBuffer(34962, this.handle)
            val mapped = glMapBufferRange(34962, offset, 8, 1)
            if (!pointerIsNull(mapped)) {
                result = ablaUnsafeLoadI64(mapped)
                glUnmapBuffer(34962)
            }
        }
        result
    }

    trusted fun writeI64(value: int, offset: int = 0): bool {
        var succeeded = offset >= 0 && offset <= this.size - 8 &&
            this.makeCurrent()
        if (succeeded) {
            glBindBuffer(34962, this.handle)
            val mapped = glMapBufferRange(34962, offset, 8, 2)
            succeeded = !pointerIsNull(mapped)
            if (succeeded) {
                ablaUnsafeStoreI64(mapped, value)
                succeeded = glUnmapBuffer(34962) == 1 && glGetError() == 0
            }
        }
        succeeded
    }

    trusted fun writeBytes(
        source: BufferBytes,
        copy: BufferCopyDescriptor
    ): bool {
        var succeeded = this.valid() && source.valid() &&
            copy.valid(source.size, this.size) && this.makeCurrent()
        if (succeeded) {
            val byteCount = copy.resolvedSize(source.size)
            glBindBuffer(34962, this.handle)
            glBufferSubData(
                34962,
                copy.destinationOffset,
                byteCount,
                source.storage.pointerAt(copy.sourceOffset)
            )
            succeeded = glGetError() == 0
        }
        succeeded
    }

    trusted fun readBytes(
        var destination: BufferBytes,
        copy: BufferCopyDescriptor
    ): bool {
        var succeeded = this.valid() && destination.valid() &&
            copy.valid(this.size, destination.size) && this.makeCurrent()
        if (succeeded) {
            val byteCount = copy.resolvedSize(this.size)
            glBindBuffer(34962, this.handle)
            glGetBufferSubData(
                34962,
                copy.sourceOffset,
                byteCount,
                destination.storage.pointerAt(copy.destinationOffset)
            )
            succeeded = glGetError() == 0
        }
        succeeded
    }

    trusted fun copyTo(
        destination: OpenGlBuffer,
        copy: BufferCopyDescriptor
    ): bool {
        var succeeded = this.valid() && destination.valid() &&
            this.context == destination.context &&
            this.display == destination.display &&
            copy.valid(this.size, destination.size) && this.makeCurrent()
        if (succeeded) {
            glBindBuffer(36662, this.handle)
            glBindBuffer(36663, destination.handle)
            glCopyBufferSubData(
                36662,
                36663,
                copy.sourceOffset,
                copy.destinationOffset,
                copy.resolvedSize(this.size)
            )
            succeeded = glGetError() == 0
        }
        succeeded
    }

    trusted fun fill(descriptor: BufferFillDescriptor): bool {
        var succeeded = this.valid() && descriptor.valid(this.size) &&
            this.makeCurrent()
        if (succeeded) {
            ablaUnsafeStoreI64(this.scratch.address, descriptor.value)
            glBindBuffer(36663, this.handle)
            glClearBufferSubData(
                36663,
                33334,
                descriptor.offset,
                descriptor.resolvedSize(this.size),
                36244,
                5125,
                this.scratch.address
            )
            succeeded = glGetError() == 0
        }
        succeeded
    }

    trusted fun drop(): void {
        if (this.handle != 0) {
            if (!pointerIsNull(this.display) && !pointerIsNull(this.context)) {
                eglMakeCurrent(
                    this.display,
                    this.surface,
                    this.surface,
                    this.context
                )
            }
            val output = nativeI64Cell(this.handle)
            glDeleteBuffers(1, output.address)
            this.handle = 0
        }
        this.scratch.close()
        return
    }
}

trusted fun OpenGlWindowContext.buffer(size: int): OpenGlBuffer {
    var handle = 0
    if (size > 0 && size <= 1073741824 && this.makeCurrent()) {
        val output = nativeI64Cell(0)
        glGenBuffers(1, output.address)
        handle = output.load()
        if (handle != 0) {
            glBindBuffer(34962, handle)
            glBufferData(34962, size, nativeNullPointer(), 35048)
            if (glGetError() != 0) {
                glDeleteBuffers(1, output.address)
                handle = 0
            }
        }
    }
    OpenGlBuffer(
        handle,
        size,
        this.display,
        this.surface,
        this.context,
        nativeByteBuffer(8)
    )
}

fun openGlSamplerAddress(value: int): int {
    var result = 33071
    if (value == samplerAddressRepeat) result = 10497
    else if (value == samplerAddressMirrorRepeat) result = 33648
    result
}

fun openGlSamplerMinimumFilter(minimum: int, mipmap: int): int {
    var result = 9984
    if (minimum == samplerFilterLinear && mipmap == samplerFilterNearest) {
        result = 9985
    } else if (minimum == samplerFilterNearest &&
        mipmap == samplerFilterLinear) result = 9986
    else if (minimum == samplerFilterLinear &&
        mipmap == samplerFilterLinear) result = 9987
    result
}

fun openGlCompareFunction(value: int): int {
    var result = 519
    if (value >= compareFunctionNever && value <= compareFunctionAlways) {
        result = 511 + value
    }
    result
}

resource class OpenGlSampler(
    var handle: int,
    val display: i64*,
    val surface: i64*,
    val context: i64*
) {
    fun valid(): bool = this.handle != 0 &&
        !pointerIsNull(this.display) && !pointerIsNull(this.context)

    trusted fun drop(): void {
        if (this.handle != 0) {
            if (!pointerIsNull(this.display) && !pointerIsNull(this.context)) {
                eglMakeCurrent(
                    this.display,
                    this.surface,
                    this.surface,
                    this.context
                )
            }
            val output = nativeI64Cell(this.handle)
            glDeleteSamplers(1, output.address)
            this.handle = 0
        }
        return
    }
}

trusted fun OpenGlWindowContext.sampler(
    descriptor: SamplerDescriptor
): OpenGlSampler {
    var handle = 0
    val capabilities = this.capabilities()
    if (descriptor.valid() && graphicsSamplerAnisotropySupported(
            capabilities,
            descriptor.maximumAnisotropy
        ) && this.makeCurrent()) {
        val output = nativeI64Cell(0)
        glGenSamplers(1, output.address)
        handle = output.load()
        if (handle != 0) {
            glSamplerParameteri(handle, 10242, openGlSamplerAddress(descriptor.addressU))
            glSamplerParameteri(handle, 10243, openGlSamplerAddress(descriptor.addressV))
            glSamplerParameteri(handle, 32882, openGlSamplerAddress(descriptor.addressW))
            glSamplerParameteri(
                handle,
                10240,
                if (descriptor.magFilter == samplerFilterLinear) 9729 else 9728
            )
            glSamplerParameteri(
                handle,
                10241,
                openGlSamplerMinimumFilter(
                    descriptor.minFilter,
                    descriptor.mipmapFilter
                )
            )
            glSamplerParameteri(handle, 33082, descriptor.lodMinimum)
            glSamplerParameteri(handle, 33083, descriptor.lodMaximum)
            if (descriptor.compare == compareFunctionUndefined) {
                glSamplerParameteri(handle, 34892, 0)
            } else {
                glSamplerParameteri(handle, 34892, 34894)
                glSamplerParameteri(
                    handle,
                    34893,
                    openGlCompareFunction(descriptor.compare)
                )
            }
            if (descriptor.maximumAnisotropy > 1) {
                val anisotropy = nativeI64Cell(
                    graphicsUnsignedIntegerF32Bits(
                        descriptor.maximumAnisotropy
                    )
                )
                glSamplerParameterfv(handle, 34046, anisotropy.address)
            }
            if (glGetError() != 0) {
                glDeleteSamplers(1, output.address)
                handle = 0
            }
        }
    }
    OpenGlSampler(handle, this.display, this.surface, this.context)
}

class OpenGlTextureFormat(
    val valid: bool,
    val internalFormat: int,
    val format: int,
    val kind: int
)

fun openGlTextureFormat(format: int): OpenGlTextureFormat {
    var internalFormat = 0
    var baseFormat = 6408
    var kind = 5121
    if (format == textureFormatR8Unorm) {
        internalFormat = 33321
        baseFormat = 6403
    } else if (format == textureFormatRg8Unorm) {
        internalFormat = 33323
        baseFormat = 33319
    } else if (format == textureFormatRgba8Unorm) internalFormat = 32856
    else if (format == textureFormatRgba8UnormSrgb) internalFormat = 35907
    else if (format == textureFormatBgra8Unorm) internalFormat = 32856
    else if (format == textureFormatBgra8UnormSrgb) internalFormat = 35907
    else if (format == textureFormatR16Float) {
        internalFormat = 33325
        baseFormat = 6403
        kind = 5131
    } else if (format == textureFormatRg16Float) {
        internalFormat = 33327
        baseFormat = 33319
        kind = 5131
    } else if (format == textureFormatRgba16Float) {
        internalFormat = 34842
        kind = 5131
    } else if (format == textureFormatR32Float) {
        internalFormat = 33326
        baseFormat = 6403
        kind = 5126
    } else if (format == textureFormatRg32Float) {
        internalFormat = 33328
        baseFormat = 33319
        kind = 5126
    } else if (format == textureFormatRgba32Float) {
        internalFormat = 34836
        kind = 5126
    } else if (format == textureFormatDepth16Unorm) {
        internalFormat = 33189
        baseFormat = 6402
        kind = 5123
    } else if (format == textureFormatDepth24Stencil8) {
        internalFormat = 35056
        baseFormat = 34041
        kind = 34042
    } else if (format == textureFormatDepth32Float) {
        internalFormat = 36012
        baseFormat = 6402
        kind = 5126
    } else if (format == textureFormatDepth32FloatStencil8) {
        internalFormat = 36013
        baseFormat = 34041
        kind = 36269
    }
    OpenGlTextureFormat(internalFormat != 0, internalFormat, baseFormat, kind)
}

resource class OpenGlTexture(
    var handle: int,
    val display: i64*,
    val surface: i64*,
    val context: i64*,
    val readback: NativeByteBuffer
) {
    fun valid(): bool = this.handle != 0 &&
        !pointerIsNull(this.display) && !pointerIsNull(this.context) &&
        !this.readback.closed && this.readback.capacity >= 8

    trusted fun drop(): void {
        if (this.handle != 0) {
            if (!pointerIsNull(this.display) && !pointerIsNull(this.context)) {
                eglMakeCurrent(
                    this.display,
                    this.surface,
                    this.surface,
                    this.context
                )
            }
            val output = nativeI64Cell(this.handle)
            glDeleteTextures(1, output.address)
            this.handle = 0
        }
        this.readback.close()
        return
    }
}

trusted fun OpenGlTexture.copyTo(
    sourceDescriptor: TextureDescriptor,
    destination: OpenGlTexture,
    destinationDescriptor: TextureDescriptor,
    copy: TextureCopyDescriptor
): bool {
    var succeeded = this.valid() && destination.valid() &&
        this.context == destination.context &&
        this.display == destination.display &&
        copy.valid(sourceDescriptor, destinationDescriptor) &&
        eglMakeCurrent(
            this.display,
            this.surface,
            this.surface,
            this.context
        ) == eglTrue
    if (succeeded) {
        glCopyImageSubData(
            this.handle,
            3553,
            copy.sourceMipLevel,
            copy.sourceX,
            copy.sourceY,
            0,
            destination.handle,
            3553,
            copy.destinationMipLevel,
            copy.destinationX,
            copy.destinationY,
            0,
            copy.resolvedWidth(sourceDescriptor),
            copy.resolvedHeight(sourceDescriptor),
            1
        )
        succeeded = glGetError() == 0
    }
    succeeded
}

trusted fun OpenGlTexture.writePixels(
    texture: TextureDescriptor,
    pixels: PixelBuffer,
    write: TextureWriteDescriptor
): bool {
    var succeeded = this.valid() && pixels.valid() && write.valid(
        texture,
        pixels.width,
        pixels.height
    )
    if (succeeded) {
        succeeded = eglMakeCurrent(
            this.display,
            this.surface,
            this.surface,
            this.context
        ) == eglTrue
    }
    if (succeeded) {
        glBindTexture(3553, this.handle)
        glTexSubImage2D(
            3553,
            write.mipLevel,
            write.x,
            write.y,
            pixels.width,
            pixels.height,
            6408,
            5121,
            pixels.storage.address
        )
        succeeded = glGetError() == 0
    }
    succeeded
}

trusted fun OpenGlTexture.rgba8(
    texture: TextureDescriptor,
    x: int,
    y: int,
    mipLevel: int = 0
): int {
    var result = -1
    var succeeded = this.valid() && texture.valid() &&
        (texture.usage & textureUsageCopySource) != 0 &&
        textureFormatAcceptsRgba8Pixels(texture.format) &&
        mipLevel >= 0 && mipLevel < texture.mipLevels &&
        x >= 0 && y >= 0 &&
        x < textureMipDimension(texture.size.width, mipLevel) &&
        y < textureMipDimension(texture.size.height, mipLevel) &&
        eglMakeCurrent(
            this.display,
            this.surface,
            this.surface,
            this.context
        ) == eglTrue
    if (succeeded) {
        glGetTextureSubImage(
            this.handle,
            mipLevel,
            x,
            y,
            0,
            1,
            1,
            1,
            6408,
            5121,
            4,
            this.readback.address
        )
        succeeded = glGetError() == 0
    }
    if (succeeded) {
        result = this.readback.load(0) + this.readback.load(1) * 256 +
            this.readback.load(2) * 65536 +
            this.readback.load(3) * 16777216
    }
    result
}

resource class OpenGlTextureView(var handle: int) {
    fun valid(): bool = this.handle != 0

    fun drop(): void {
        this.handle = 0
        return
    }
}

trusted fun OpenGlWindowContext.texture(
    descriptor: TextureDescriptor
): OpenGlTexture {
    var handle = 0
    val selected = openGlTextureFormat(descriptor.format)
    if (descriptor.valid() && descriptor.dimension == textureDimension2D &&
        descriptor.samples == 1 && selected.valid && this.makeCurrent()) {
        val output = nativeI64Cell(0)
        glGenTextures(1, output.address)
        handle = output.load()
        if (handle != 0) {
            glBindTexture(3553, handle)
            glTexParameteri(3553, 33084, 0)
            glTexParameteri(3553, 33085, descriptor.mipLevels - 1)
            var level = 0
            var width = descriptor.size.width
            var height = descriptor.size.height
            while (level < descriptor.mipLevels) {
                glTexImage2D(
                    3553,
                    level,
                    selected.internalFormat,
                    width,
                    height,
                    0,
                    selected.format,
                    selected.kind,
                    nativeNullPointer()
                )
                if (width > 1) width = width / 2
                if (height > 1) height = height / 2
                level = level + 1
            }
            if (glGetError() != 0) {
                glDeleteTextures(1, output.address)
                handle = 0
            }
        }
    }
    OpenGlTexture(
        handle,
        this.display,
        this.surface,
        this.context,
        nativeByteBuffer(8)
    )
}

fun OpenGlTexture.view(
    texture: TextureDescriptor,
    descriptor: TextureViewDescriptor
): OpenGlTextureView {
    val validation = descriptor.validation(texture)
    val fullView = descriptor.resolvedFormat(texture) == texture.format &&
        descriptor.dimension == texture.dimension &&
        descriptor.baseMipLevel == 0 &&
        descriptor.resolvedMipLevelCount(texture) == texture.mipLevels &&
        descriptor.baseArrayLayer == 0 &&
        descriptor.resolvedArrayLayerCount(texture) == 1
    OpenGlTextureView(
        if (this.valid() && validation.succeeded && fullView)
            this.handle
        else 0
    )
}

resource class OpenGlPixelPresenter(
    val program: OpenGlProgram,
    var texture: int,
    val width: int,
    val height: int
) {
    fun valid(): bool =
        this.program.valid() && this.texture != 0 &&
        this.width > 0 && this.height > 0

    trusted fun present(
        context: OpenGlWindowContext,
        pixels: PixelBuffer
    ): bool {
        var presented = false
        if (this.valid() && context.valid() && pixels.valid() &&
            pixels.width == this.width && pixels.height == this.height &&
            context.makeCurrent()) {
            glBindTexture(3553, this.texture)
            glTexSubImage2D(
                3553,
                0,
                0,
                0,
                this.width,
                this.height,
                6408,
                5121,
                pixels.storage.address
            )
            glViewport(0, 0, context.width, context.height)
            glUseProgram(this.program.handle)
            glBindVertexArray(this.program.vertexArray)
            glDrawArrays(4, 0, 3)
            presented = glGetError() == 0 &&
                eglSwapBuffers(context.display, context.surface) == eglTrue
        }
        presented
    }

    trusted fun drop(): void {
        if (this.texture != 0) {
            val textureCell = nativeI64Cell(this.texture)
            glDeleteTextures(1, textureCell.address)
            this.texture = 0
        }
        return
    }
}

class OpenGlShaderResult(val handle: int, val error: string)

trusted fun openGlShaderLog(shader: int): string {
    val length = nativeI64Cell(0)
    val bytes = nativeByteBuffer(4097)
    glGetShaderInfoLog(shader, 4096, length.address, bytes.address)
    var measured = length.load() & 4294967295
    if (measured > 4096) measured = 4096
    bytes.adoptString(measured)
}

trusted fun openGlProgramLog(program: int): string {
    val length = nativeI64Cell(0)
    val bytes = nativeByteBuffer(4097)
    glGetProgramInfoLog(program, 4096, length.address, bytes.address)
    var measured = length.load() & 4294967295
    if (measured > 4096) measured = 4096
    bytes.adoptString(measured)
}

trusted fun openGlCompileShader(
    kind: int,
    source: string
): OpenGlShaderResult {
    var shader = glCreateShader(kind)
    var error = ""
    if (shader != 0) {
        val sourcePointer = nativePointerCell(
            nativePointerFromAddress(nativeCStringAddress(source))
        )
        glShaderSource(
            shader,
            1,
            sourcePointer.address,
            nativeNullPointer()
        )
        glCompileShader(shader)
        val compiled = nativeI64Cell(0)
        glGetShaderiv(shader, 35713, compiled.address)
        if ((compiled.load() & 4294967295) == 0) {
            error = openGlShaderLog(shader)
            glDeleteShader(shader)
            shader = 0
        }
    } else {
        error = "OpenGL returned shader handle zero"
    }
    OpenGlShaderResult(shader, error)
}

trusted fun openGlProgram(
    vertexSource: string,
    fragmentSource: string
): OpenGlProgram {
    val vertex = openGlCompileShader(35633, vertexSource)
    val fragment = openGlCompileShader(35632, fragmentSource)
    var program = 0
    var vertexArray = 0
    var error = if (vertex.error != "") vertex.error else fragment.error
    if (vertex.handle != 0 && fragment.handle != 0) {
        program = glCreateProgram()
        if (program != 0) {
            glAttachShader(program, vertex.handle)
            glAttachShader(program, fragment.handle)
            glLinkProgram(program)
            val linked = nativeI64Cell(0)
            glGetProgramiv(program, 35714, linked.address)
            if ((linked.load() & 4294967295) == 0) {
                error = openGlProgramLog(program)
                glDeleteProgram(program)
                program = 0
            }
        } else {
            error = "OpenGL returned program handle zero"
        }
    }
    if (vertex.handle != 0) glDeleteShader(vertex.handle)
    if (fragment.handle != 0) glDeleteShader(fragment.handle)
    if (program != 0) {
        val array = nativeI64Cell(0)
        glGenVertexArrays(1, array.address)
        vertexArray = array.load() & 4294967295
        if (vertexArray == 0) {
            glDeleteProgram(program)
            program = 0
        }
    }
    OpenGlProgram(program, vertexArray, error)
}

trusted fun openGlProgramFromPackage(
    shader: ShaderPackage
): OpenGlProgram {
    if (shader.valid) openGlProgram(
        shader.source(shaderStageVertex),
        shader.source(shaderStageFragment)
    ) else OpenGlProgram(0, 0, shader.error)
}

resource class OpenGlComputePipeline(
    var handle: int,
    val display: i64*,
    val surface: i64*,
    val context: i64*,
    val storageBuffer: int,
    val error: string
) {
    fun valid(): bool = this.handle != 0 &&
        !pointerIsNull(this.display) && !pointerIsNull(this.context)

    trusted fun dispatch(x: int, y: int = 1, z: int = 1): bool {
        var succeeded = this.valid() && x > 0 && y > 0 && z > 0 &&
            x <= 65535 && y <= 65535 && z <= 65535 &&
            eglMakeCurrent(
                this.display,
                this.surface,
                this.surface,
                this.context
            ) == eglTrue
        if (succeeded) {
            if (this.storageBuffer != 0) {
                glBindBufferBase(37074, 0, this.storageBuffer)
            }
            glUseProgram(this.handle)
            glDispatchCompute(x, y, z)
            if (this.storageBuffer != 0) glMemoryBarrier(8192)
            succeeded = glGetError() == 0
        }
        succeeded
    }

    trusted fun drop(): void {
        if (this.handle != 0) {
            if (!pointerIsNull(this.display) && !pointerIsNull(this.context)) {
                eglMakeCurrent(
                    this.display,
                    this.surface,
                    this.surface,
                    this.context
                )
            }
            glDeleteProgram(this.handle)
            this.handle = 0
        }
        return
    }
}

trusted fun OpenGlWindowContext.computePipeline(
    shader: ShaderPackage,
    storageBuffer: int = 0
): OpenGlComputePipeline {
    var program = 0
    var error = if (shader.valid) "" else shader.error
    if (shader.valid && shader.stages.size == 1 &&
        shader.stages[0].kind == shaderStageCompute && this.makeCurrent()) {
        val compute = openGlCompileShader(
            37305,
            shader.source(shaderStageCompute)
        )
        error = compute.error
        if (compute.handle != 0) {
            program = glCreateProgram()
            if (program != 0) {
                glAttachShader(program, compute.handle)
                glLinkProgram(program)
                val linked = nativeI64Cell(0)
                glGetProgramiv(program, 35714, linked.address)
                if ((linked.load() & 4294967295) == 0) {
                    error = openGlProgramLog(program)
                    glDeleteProgram(program)
                    program = 0
                }
            }
            glDeleteShader(compute.handle)
        }
    } else if (error == "") {
        error = "OpenGL compute requires one valid compute stage and context"
    }
    OpenGlComputePipeline(
        program,
        this.display,
        this.surface,
        this.context,
        storageBuffer,
        error
    )
}

trusted fun openGlPixelPresenter(
    context: OpenGlWindowContext,
    width: int,
    height: int
): OpenGlPixelPresenter {
    val shader = $glsl {
        vertex {
            #version 330 core
            out vec2 textureCoordinate;
            const vec2 positions[3] = vec2[3](
                vec2(-1.0, -1.0),
                vec2(3.0, -1.0),
                vec2(-1.0, 3.0)
            );
            void main() {
                vec2 position = positions[gl_VertexID];
                vec2 coordinate = position * 0.5 + 0.5;
                textureCoordinate = vec2(coordinate.x, 1.0 - coordinate.y);
                gl_Position = vec4(position, 0.0, 1.0);
            }
        }
        fragment {
            #version 330 core
            in vec2 textureCoordinate;
            out vec4 color;
            uniform sampler2D frameTexture;
            void main() {
                color = texture(frameTexture, textureCoordinate);
            }
        }
    }
    var program = OpenGlProgram(0, 0, "invalid context or dimensions")
    var texture = 0
    if (context.valid() && width > 0 && width <= 16384 &&
        height > 0 && height <= 16384 && context.makeCurrent()) {
        program = openGlProgramFromPackage(shader)
    }
    if (program.valid()) {
        val textureCell = nativeI64Cell(0)
        glGenTextures(1, textureCell.address)
        texture = textureCell.load() & 4294967295
        if (texture != 0) {
            glBindTexture(3553, texture)
            glTexParameteri(3553, 10241, 9728)
            glTexParameteri(3553, 10240, 9728)
            glTexParameteri(3553, 10242, 33071)
            glTexParameteri(3553, 10243, 33071)
            glTexImage2D(
                3553,
                0,
                32856,
                width,
                height,
                0,
                6408,
                5121,
                nativeNullPointer()
            )
            if (glGetError() != 0) {
                glDeleteTextures(1, textureCell.address)
                texture = 0
            }
        }
    }
    OpenGlPixelPresenter(move(program), texture, width, height)
}

resource class OpenGlWindowContext(
    var nativeDisplay: i64*,
    var display: i64*,
    var surface: i64*,
    var context: i64*,
    var width: int,
    var height: int,
    val clearScratch: NativeByteBuffer
) {
    trusted fun valid(): bool =
        !pointerIsNull(this.nativeDisplay) &&
        !pointerIsNull(this.display) &&
        !pointerIsNull(this.surface) &&
        !pointerIsNull(this.context) &&
        !this.clearScratch.closed && this.clearScratch.capacity >= 16

    trusted fun makeCurrent(): bool =
        this.valid() &&
        eglMakeCurrent(
            this.display,
            this.surface,
            this.surface,
            this.context
        ) == eglTrue

    trusted fun capabilities(): GraphicsCapabilities =
        if (this.makeCurrent()) openGlCurrentCapabilities()
        else GraphicsCapabilities()

    trusted fun presentBlack(): bool {
        var presented = false
        if (this.makeCurrent()) {
            glViewport(0, 0, this.width, this.height)
            glClear(16384)
            presented = glGetError() == 0 &&
                eglSwapBuffers(this.display, this.surface) == eglTrue
        }
        presented
    }

    trusted fun presentClear(color: Color): bool {
        var presented = false
        if (color.valid() && this.makeCurrent()) {
            openGlStoreI32(
                this.clearScratch,
                0,
                graphicsScalarF32Bits(color.red)
            )
            openGlStoreI32(
                this.clearScratch,
                1,
                graphicsScalarF32Bits(color.green)
            )
            openGlStoreI32(
                this.clearScratch,
                2,
                graphicsScalarF32Bits(color.blue)
            )
            openGlStoreI32(
                this.clearScratch,
                3,
                graphicsScalarF32Bits(color.alpha)
            )
            glViewport(0, 0, this.width, this.height)
            glClearBufferfv(6144, 0, this.clearScratch.address)
            presented = glGetError() == 0 &&
                eglSwapBuffers(this.display, this.surface) == eglTrue
        }
        presented
    }

    trusted fun drawAndPresent(
        program: OpenGlProgram
    ): int {
        var pixelValue = -1
        if (program.valid() && this.makeCurrent()) {
            glViewport(0, 0, this.width, this.height)
            glClear(16384)
            glUseProgram(program.handle)
            glBindVertexArray(program.vertexArray)
            glDrawArrays(4, 0, 3)
            glFinish()
            val pixel = nativeByteBuffer(8)
            glReadPixels(
                this.width / 2,
                this.height / 2,
                1,
                1,
                6408,
                5121,
                pixel.address
            )
            if (glGetError() == 0 &&
                eglSwapBuffers(this.display, this.surface) == eglTrue) {
                pixelValue = pixel.loadI64(0) & 4294967295
            }
        }
        pixelValue
    }

    trusted fun presentProgram(
        program: OpenGlProgram,
        clear: Color,
        raster: RasterPipelineState,
        depth: DepthStencilState
    ): bool {
        var presented = program.valid() && clear.valid() && raster.valid() &&
            depth.valid() && this.makeCurrent()
        if (presented) {
            openGlStoreI32(
                this.clearScratch,
                0,
                graphicsScalarF32Bits(clear.red)
            )
            openGlStoreI32(
                this.clearScratch,
                1,
                graphicsScalarF32Bits(clear.green)
            )
            openGlStoreI32(
                this.clearScratch,
                2,
                graphicsScalarF32Bits(clear.blue)
            )
            openGlStoreI32(
                this.clearScratch,
                3,
                graphicsScalarF32Bits(clear.alpha)
            )
            glViewport(0, 0, this.width, this.height)
            glClearBufferfv(6144, 0, this.clearScratch.address)
            glUseProgram(program.handle)
            glBindVertexArray(program.vertexArray)
