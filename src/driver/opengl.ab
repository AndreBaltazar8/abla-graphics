    }
    OpenGlBuffer(
        handle,
        size,
        this.display,
        this.surface,
        this.context,
        nativeByteBuffer(8),
        move(mappedAddress),
        mappedOffset,
        mappedSize,
        mappedAccess,
        persistentMapping
