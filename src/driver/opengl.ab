trusted fun openGlApplyBindGroup(
    kinds: array<int>,
    bindings: array<int>,
    resources: array<int>,
    offsets: array<int>,
    sizes: array<int>,
    samplers: array<int>
): bool {
    var succeeded = kinds.size == bindings.size &&
        kinds.size == resources.size && kinds.size == offsets.size &&
        kinds.size == sizes.size && kinds.size == samplers.size
    var index = 0
    while (succeeded && index < kinds.size) {
        val kind = kinds[index]
        val binding = bindings[index]
        val handle = resources[index]
        val offset = offsets[index]
        val size = sizes[index]
