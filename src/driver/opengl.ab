trusted fun openGlTextureDataLayoutRange(
    format: int,
    width: int,
    height: int,
    bytesPerRow: int,
    rowsPerImage: int,
    unpack: bool
): void {
    val alignmentName = if (unpack) 3317 else 3333
    val rowLengthName = if (unpack) 3314 else 3330
    val imageHeightName = if (unpack) 32878 else 32876
    val blockWidthName = if (unpack) 37159 else 37163
    val blockHeightName = if (unpack) 37160 else 37164
    val blockDepthName = if (unpack) 37161 else 37165
    val blockSizeName = if (unpack) 37162 else 37166
    val blockWidth = textureFormatBlockWidth(format)
    val blockHeight = textureFormatBlockHeight(format)
    val blockBytes = textureFormatBytesPerBlock(format)
    val minimumRowBytes = textureBlockCount(width, blockWidth) * blockBytes
    val rowBytes = if (bytesPerRow == 0) minimumRowBytes else bytesPerRow
    val imageRows = if (rowsPerImage == 0)
        textureBlockCount(height, blockHeight) * blockHeight else rowsPerImage
    val rowLength = rowBytes / blockBytes * blockWidth
    glPixelStorei(alignmentName, 1)
    glPixelStorei(rowLengthName, rowLength)
    glPixelStorei(
        imageHeightName,
        imageRows
    )
    if (textureFormatCompressed(format)) {
        glPixelStorei(blockWidthName, blockWidth)
        glPixelStorei(blockHeightName, blockHeight)
        glPixelStorei(blockDepthName, 1)
        glPixelStorei(blockSizeName, blockBytes)
    }
    return
}

trusted fun openGlResetTextureDataLayout(compressed: bool, unpack: bool): void {
    val alignmentName = if (unpack) 3317 else 3333
    val rowLengthName = if (unpack) 3314 else 3330
    val imageHeightName = if (unpack) 32878 else 32876
    glPixelStorei(alignmentName, 4)
    glPixelStorei(rowLengthName, 0)
    glPixelStorei(imageHeightName, 0)
    if (compressed) {
        glPixelStorei(if (unpack) 37159 else 37163, 0)
        glPixelStorei(if (unpack) 37160 else 37164, 0)
        glPixelStorei(if (unpack) 37161 else 37165, 0)
        glPixelStorei(if (unpack) 37162 else 37166, 0)
    }
    return
}

