        mipmap == samplerFilterLinear) result = 9986
    else if (minimum == samplerFilterLinear &&
        mipmap == samplerFilterLinear) result = 9987
    result
}

fun openGlCompareFunction(value: int): int {
    var result = 519
    if (value >= compareFunctionNever && value <= compareFunctionAlways) {
        result = 511 + value
