// Headless EGL/OpenGL context implemented in Abla.
//
// EGL and OpenGL entry points come from the installed graphics driver. All
// configuration arrays, output storage, ownership, and calls are Abla.

import "abla/unsafe/memory"
import "../core.ab"
import "../platform/x11.ab"
import "../platform/x11_wsi.ab"
import "../shader/glsl.ab"

val eglFalse = 0
val eglTrue = 1
val eglNone = 12344
val eglOpenGlApi = 12450
val eglPlatformSurfacelessMesa = 12765
val eglPlatformX11 = 12757

noescape extern:"c" fun eglGetPlatformDisplay(
    platform: i32,
    nativeDisplay: i64*,
    attributes: i64*
): i64*
