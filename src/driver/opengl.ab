        version
    }

    trusted fun capabilities(): GraphicsCapabilities =
        if (this.makeCurrent()) openGlCurrentCapabilities()
        else GraphicsCapabilities()

    trusted fun clearBlackAndReadRgba8(): int {
        var result = -1
        if (this.makeCurrent()) {
            glViewport(0, 0, this.width, this.height)
            glClear(16384)
            glFinish()
