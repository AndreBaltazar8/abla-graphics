fun openGlStoreI32(
    var buffer: NativeByteBuffer,
    index: int,
    value: int
): void {
    val offset = index * 4
    buffer.store(offset, value & 255)
    buffer.store(offset + 1, (value >>> 8) & 255)
    buffer.store(offset + 2, (value >>> 16) & 255)
    buffer.store(offset + 3, (value >>> 24) & 255)
    return
}

fun openGlStoreClearScalars(
    var storage: NativeByteBuffer,
    red: f64,
    green: f64,
    blue: f64,
    alpha: f64
): void {
    openGlStoreI32(storage, 0, graphicsScalarF32Bits(red))
    openGlStoreI32(storage, 1, graphicsScalarF32Bits(green))
    openGlStoreI32(storage, 2, graphicsScalarF32Bits(blue))
    openGlStoreI32(storage, 3, graphicsScalarF32Bits(alpha))
    return
}

fun openGlPrimitiveMode(topology: int): int {
    var mode = 4
    if (topology == primitiveTopologyPointList) mode = 0
    else if (topology == primitiveTopologyLineList) mode = 1
    else if (topology == primitiveTopologyLineStrip) mode = 3
    else if (topology == primitiveTopologyTriangleStrip) mode = 5
    mode
}

fun openGlBlendFactor(factor: int): int {
    var result = factor
    if (factor == blendFactorSourceColor) result = 768
    else if (factor == blendFactorOneMinusSourceColor) result = 769
    else if (factor == blendFactorDestinationColor) result = 774
    else if (factor == blendFactorOneMinusDestinationColor) result = 775
    else if (factor == blendFactorSourceAlpha) result = 770
    else if (factor == blendFactorOneMinusSourceAlpha) result = 771
    else if (factor == blendFactorDestinationAlpha) result = 772
    else if (factor == blendFactorOneMinusDestinationAlpha) result = 773
    result
}

fun openGlBlendOperation(operation: int): int {
    var result = 32774
    if (operation == blendOperationSubtract) result = 32778
    else if (operation == blendOperationReverseSubtract) result = 32779
    else if (operation == blendOperationMinimum) result = 32775
    else if (operation == blendOperationMaximum) result = 32776
    result
}

trusted fun openGlApplyRasterState(
    state: RasterPipelineState,
    targetWidth: int,
    targetHeight: int
): bool {
    var succeeded = state.fits(targetWidth, targetHeight)
    if (succeeded) {
        val blendEnabled = state.blendEnabled()
        val colorSource = state.colorBlendSource()
        val colorDestination = state.colorBlendDestination()
        val colorOperation = state.colorBlendOperation()
        val alphaSource = state.alphaBlendSource()
        val alphaDestination = state.alphaBlendDestination()
        val alphaOperation = state.alphaBlendOperation()
        if (state.viewport.enabled) {
            glViewport(
                state.viewport.x,
                targetHeight - state.viewport.y - state.viewport.height,
                state.viewport.width,
                state.viewport.height
            )
            glDepthRange(
                state.viewport.minimumDepth,
                state.viewport.maximumDepth
            )
        } else {
            glViewport(0, 0, targetWidth, targetHeight)
            glDepthRange(0.0, 1.0)
        }
        if (state.scissor.enabled) {
            glEnable(3089)
            glScissor(
                state.scissor.x,
                targetHeight - state.scissor.y - state.scissor.height,
                state.scissor.width,
                state.scissor.height
            )
        } else glDisable(3089)
        if (state.cullMode == cullModeNone) glDisable(2884)
        else {
            glEnable(2884)
            glCullFace(if (state.cullMode == cullModeFront) 1028 else 1029)
        }
        glFrontFace(
            if (state.frontFace == frontFaceCounterClockwise) 2305 else 2304
        )
        glColorMask(
            if ((state.colorWriteMask() & colorWriteRed) != 0) 1 else 0,
            if ((state.colorWriteMask() & colorWriteGreen) != 0) 1 else 0,
            if ((state.colorWriteMask() & colorWriteBlue) != 0) 1 else 0,
            if ((state.colorWriteMask() & colorWriteAlpha) != 0) 1 else 0
        )
        if (blendEnabled) {
            glEnable(3042)
            glBlendEquationSeparate(
                openGlBlendOperation(colorOperation),
                openGlBlendOperation(alphaOperation)
            )
            glBlendFuncSeparate(
                openGlBlendFactor(colorSource),
                openGlBlendFactor(colorDestination),
                openGlBlendFactor(alphaSource),
                openGlBlendFactor(alphaDestination)
            )
        } else glDisable(3042)
        succeeded = glGetError() == 0
    }
    succeeded
}

fun openGlCompareOperation(compare: int): int {
    var operation = 513
    if (compare == compareFunctionNever) operation = 512
    else if (compare == compareFunctionEqual) operation = 514
    else if (compare == compareFunctionLessEqual) operation = 515
    else if (compare == compareFunctionGreater) operation = 516
    else if (compare == compareFunctionNotEqual) operation = 517
    else if (compare == compareFunctionGreaterEqual) operation = 518
    else if (compare == compareFunctionAlways) operation = 519
    operation
}

fun openGlStencilOperation(operation: int): int {
    var result = 7680
    if (operation == stencilOperationZero) result = 0
    else if (operation == stencilOperationReplace) result = 7681
    else if (operation == stencilOperationIncrementClamp) result = 7682
    else if (operation == stencilOperationDecrementClamp) result = 7683
    else if (operation == stencilOperationInvert) result = 5386
    else if (operation == stencilOperationIncrementWrap) result = 34055
    else if (operation == stencilOperationDecrementWrap) result = 34056
    result
}

trusted fun openGlApplyDepthState(state: DepthStencilState): bool {
    var succeeded = state.valid()
    if (succeeded) {
        if (state.enabled) {
            glEnable(2929)
            glDepthFunc(openGlCompareOperation(state.compare))
            glDepthMask(if (state.write) 1 else 0)
            glClearDepth(1.0)
            glClear(256)
        } else {
            glDisable(2929)
            glDepthMask(0)
        }
        if (state.stencilEnabled()) {
            glEnable(2960)
            glStencilFuncSeparate(
                1028,
                openGlCompareOperation(state.frontStencilCompare()),
                state.stencilReference(),
                state.stencilReadMask()
            )
            glStencilFuncSeparate(
                1029,
                openGlCompareOperation(state.backStencilCompare()),
                state.stencilReference(),
                state.stencilReadMask()
            )
            glStencilOpSeparate(
                1028,
                openGlStencilOperation(state.frontStencilFail()),
                openGlStencilOperation(state.frontStencilDepthFail()),
                openGlStencilOperation(state.frontStencilPass())
            )
            glStencilOpSeparate(
                1029,
                openGlStencilOperation(state.backStencilFail()),
                openGlStencilOperation(state.backStencilDepthFail()),
                openGlStencilOperation(state.backStencilPass())
            )
            glStencilMaskSeparate(1028, state.stencilWriteMask())
            glStencilMaskSeparate(1029, state.stencilWriteMask())
        } else {
            glDisable(2960)
            glStencilMask(255)
        }
        succeeded = glGetError() == 0
    }
    succeeded
}

fun openGlVertexComponents(format: int): int {
    var components = 1
    if (format == vertexFormatFloat32x2) components = 2
    else if (format == vertexFormatFloat32x3) components = 3
    else if (format == vertexFormatFloat32x4) components = 4
    components
}

trusted fun openGlConfigureVertexLayout(
    layout: VertexBufferLayout,
    baseOffset: int = 0
): bool {
    var succeeded = layout.valid() && layout.buffered() && baseOffset >= 0
