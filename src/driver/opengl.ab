                glDeleteSamplers(1, output.address)
                handle = 0
            }
        }
    }
    OpenGlSampler(handle, this.display, this.surface, this.context)
}

class OpenGlTextureFormat(
    val valid: bool,
    val internalFormat: int,
    val format: int,
    val kind: int
)

fun openGlTextureInternalFormat(format: int): int {
    var internalFormat = 0
    if (format == textureFormatR8Unorm) {
        internalFormat = 33321
    } else if (format == textureFormatRg8Unorm) {
        internalFormat = 33323
    } else if (format == textureFormatRgba8Unorm) internalFormat = 32856
    else if (format == textureFormatRgba8UnormSrgb) internalFormat = 35907
    else if (format == textureFormatBgra8Unorm) internalFormat = 32856
    else if (format == textureFormatBgra8UnormSrgb) internalFormat = 35907
    else if (format == textureFormatR16Float) internalFormat = 33325
    else if (format == textureFormatRg16Float) internalFormat = 33327
    else if (format == textureFormatRgba16Float) internalFormat = 34842
    else if (format == textureFormatR32Float) internalFormat = 33326
    else if (format == textureFormatRg32Float) internalFormat = 33328
    else if (format == textureFormatRgba32Float) internalFormat = 34836
    else if (format == textureFormatDepth16Unorm) internalFormat = 33189
    else if (format == textureFormatDepth24Stencil8) internalFormat = 35056
    else if (format == textureFormatDepth32Float) internalFormat = 36012
    else if (format == textureFormatDepth32FloatStencil8) internalFormat = 36013
    else if (format == textureFormatBc1RgbaUnorm) internalFormat = 33777
    else if (format == textureFormatBc1RgbaUnormSrgb) internalFormat = 35917
    internalFormat
}

fun openGlTextureBaseFormat(format: int): int {
    var result = 6408
    if (format == textureFormatR8Unorm || format == textureFormatR16Float ||
        format == textureFormatR32Float) result = 6403
    else if (format == textureFormatRg8Unorm ||
        format == textureFormatRg16Float ||
        format == textureFormatRg32Float) result = 33319
    else if (format == textureFormatBgra8Unorm ||
        format == textureFormatBgra8UnormSrgb) result = 32993
    else if (format == textureFormatDepth16Unorm ||
        format == textureFormatDepth32Float) result = 6402
    else if (format == textureFormatDepth24Stencil8 ||
        format == textureFormatDepth32FloatStencil8) result = 34041
    result
}

fun openGlTextureDataKind(format: int): int {
    var result = 5121
    if (format == textureFormatR16Float || format == textureFormatRg16Float ||
        format == textureFormatRgba16Float) result = 5131
    else if (format == textureFormatR32Float ||
        format == textureFormatRg32Float ||
        format == textureFormatRgba32Float ||
        format == textureFormatDepth32Float) result = 5126
    else if (format == textureFormatDepth16Unorm) result = 5123
    else if (format == textureFormatDepth24Stencil8) result = 34042
    else if (format == textureFormatDepth32FloatStencil8) result = 36269
    result
}

fun openGlTextureFormat(format: int): OpenGlTextureFormat {
    val internalFormat = openGlTextureInternalFormat(format)
    OpenGlTextureFormat(
        internalFormat != 0,
        internalFormat,
        openGlTextureBaseFormat(format),
        openGlTextureDataKind(format)
    )
}

fun openGlTextureTarget(dimension: int, samples: int = 1): int {
    var result = 0
    if (samples > 1 && dimension == textureDimension2D) result = 37120
    else if (samples == 1 && dimension == textureDimension1D) result = 3552
    else if (samples == 1 && dimension == textureDimension2D) result = 3553
    else if (samples == 1 && dimension == textureDimension3D) result = 32879
    else if (samples == 1 && dimension == textureDimension2DArray) {
        result = 35866
    } else if (samples == 1 && dimension == textureDimensionCube) {
        result = 34067
    }
    result
}

