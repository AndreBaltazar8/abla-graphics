fun openGlInvalidateRenderTarget(
    target: OpenGlRenderTarget,
    mask: int,
    var storage: NativeByteBuffer
): void {
    var count = 0
    var colorIndex = 0
    while (colorIndex < 1 + target.additionalTextures.size) {
        if ((mask & (1 << colorIndex)) != 0) {
            openGlStoreI32(storage, count, 36064 + colorIndex)
            count = count + 1
        }
        colorIndex = colorIndex + 1
    }
    if (target.depthTexture != 0 && (mask & (1 << 8)) != 0) {
        openGlStoreI32(storage, count, if (target.stencil) 33306 else 36096)
        count = count + 1
    }
    if (count > 0) glInvalidateFramebuffer(36160, count, storage.address)
    return
}

trusted fun OpenGlWindowContext.renderTarget(
    texture: OpenGlTexture,
    descriptor: TextureDescriptor,
    depthTexture: int = 0,
    additionalTextures: array<int> = [],
    depthStencil: bool = false
): OpenGlRenderTarget {
    var handle = 0
    var resolveFramebuffer = 0
    var succeeded = this.valid() && texture.valid() &&
        texture.display == this.display && texture.context == this.context &&
        descriptor.valid() && descriptor.dimension == textureDimension2D &&
        descriptor.mipLevels >= 1 &&
        !textureFormatHasDepth(descriptor.format) &&
        (descriptor.usage & textureUsageRenderAttachment) != 0 &&
        additionalTextures.size <= 7 &&
        this.makeCurrent()
    if (succeeded) {
        val output = nativeI64Cell(0)
        glGenFramebuffers(1, output.address)
        handle = output.load() & 4294967295
        succeeded = handle != 0
    }
    if (succeeded) {
        glBindFramebuffer(36160, handle)
        glFramebufferTexture2D(
            36160,
            36064,
            texture.target,
            texture.handle,
            0
        )
        var colorIndex = 0
        while (colorIndex < additionalTextures.size) {
            glFramebufferTexture2D(
                36160,
                36065 + colorIndex,
                texture.target,
                additionalTextures[colorIndex],
                0
            )
            colorIndex = colorIndex + 1
        }
        val drawBuffers = nativeByteBuffer(
            (1 + additionalTextures.size) * 4
        )
        colorIndex = 0
        while (colorIndex < 1 + additionalTextures.size) {
            openGlStoreI32(drawBuffers, colorIndex, 36064 + colorIndex)
            colorIndex = colorIndex + 1
        }
        glDrawBuffers(1 + additionalTextures.size, drawBuffers.address)
        if (depthTexture != 0) glFramebufferTexture2D(
            36160,
            if (depthStencil) 33306 else 36096,
            texture.target,
            depthTexture,
            0
        )
        succeeded = glCheckFramebufferStatus(36160) == 36053 &&
            glGetError() == 0
        glBindFramebuffer(36160, 0)
    }
    if (succeeded && descriptor.samples > 1) {
        val output = nativeI64Cell(0)
        glGenFramebuffers(1, output.address)
        resolveFramebuffer = output.load() & 4294967295
        succeeded = resolveFramebuffer != 0 && glGetError() == 0
    }
    if (!succeeded && handle != 0) {
        val output = nativeI64Cell(handle)
        glDeleteFramebuffers(1, output.address)
        handle = 0
    }
    if (!succeeded && resolveFramebuffer != 0) {
        val output = nativeI64Cell(resolveFramebuffer)
        glDeleteFramebuffers(1, output.address)
        resolveFramebuffer = 0
    }
    OpenGlRenderTarget(
        handle,
        resolveFramebuffer,
        texture.handle,
        additionalTextures,
        depthTexture,
        descriptor.size.width,
        descriptor.size.height,
        descriptor.samples,
        this.display,
        this.surface,
        this.context,
        depthStencil
    )
}

trusted fun OpenGlWindowContext.resolveRenderTarget(
    target: OpenGlRenderTarget,
    colorIndex: int,
    destination: OpenGlTexture
): bool {
    var succeeded = this.valid() && target.valid() && destination.valid() &&
        target.samples > 1 && colorIndex >= 0 &&
        colorIndex <= target.additionalTextures.size &&
        target.resolveFramebuffer != 0 && destination.target == 3553 &&
        target.display == this.display && target.context == this.context &&
        destination.display == this.display &&
        destination.context == this.context && this.makeCurrent()
    if (succeeded) {
        glBindFramebuffer(36008, target.handle)
        glReadBuffer(36064 + colorIndex)
        glBindFramebuffer(36009, target.resolveFramebuffer)
        glFramebufferTexture2D(
            36009,
            36064,
            destination.target,
            destination.handle,
            0
        )
        succeeded = glCheckFramebufferStatus(36009) == 36053
        if (succeeded) glBlitFramebuffer(
            0,
            0,
            target.width,
            target.height,
            0,
            0,
            target.width,
            target.height,
            16384,
            9728
        )
        succeeded = succeeded && glGetError() == 0
        glBindFramebuffer(36160, 0)
    }
    succeeded
}

trusted fun OpenGlWindowContext.clearRenderTarget(
    target: OpenGlRenderTarget,
    clearRed: f64,
    clearGreen: f64,
    clearBlue: f64,
    clearAlpha: f64,
    clearStorage: i64* = nativeNullPointer()
): bool {
    var succeeded = this.valid() && target.valid() &&
        graphicsColorScalarsValid(
            clearRed,
            clearGreen,
            clearBlue,
            clearAlpha
        ) &&
        target.display == this.display && target.context == this.context &&
        this.makeCurrent()
    if (succeeded) {
        if (pointerIsNull(clearStorage)) openGlStoreClearScalars(
            this.clearScratch,
            clearRed,
            clearGreen,
            clearBlue,
            clearAlpha
        )
        glBindFramebuffer(36160, target.handle)
        glDisable(3089)
        glViewport(0, 0, target.width, target.height)
        glColorMask(1, 1, 1, 1)
        var colorIndex = 0
        while (colorIndex < 1 + target.additionalTextures.size) {
            if (!pointerIsNull(clearStorage)) glClearBufferfv(
                6144,
                colorIndex,
                nativePointerFromAddress(
                    nativePointerAddress(clearStorage) + colorIndex * 16
                )
            ) else glClearBufferfv(6144, colorIndex, this.clearScratch.address)
            colorIndex = colorIndex + 1
        }
        if (target.depthTexture != 0) {
            if (!pointerIsNull(clearStorage)) glClearBufferfv(
                6145,
                0,
                nativePointerFromAddress(
                    nativePointerAddress(clearStorage) +
                        (1 + target.additionalTextures.size) * 16
                )
            ) else {
                openGlStoreI32(
                    this.clearScratch,
                    0,
                    1065353216
                )
                glClearBufferfv(6145, 0, this.clearScratch.address)
            }
            if (target.stencil) {
                glStencilMask(255)
                if (!pointerIsNull(clearStorage)) glClearBufferiv(
                    6146,
                    0,
                    nativePointerFromAddress(
                        nativePointerAddress(clearStorage) +
                            (1 + target.additionalTextures.size) * 16 + 4
                    )
                ) else {
                    openGlStoreI32(this.clearScratch, 1, 0)
                    glClearBufferiv(
                        6146,
                        0,
                        nativePointerFromAddress(
                            nativePointerAddress(this.clearScratch.address) + 4
                        )
                    )
                }
            }
        }
        succeeded = glGetError() == 0
        glBindFramebuffer(36160, 0)
    }
    succeeded
}

trusted fun OpenGlWindowContext.renderProgramTarget(
    target: OpenGlRenderTarget,
    program: OpenGlProgram,
    clearRed: f64,
    clearGreen: f64,
    clearBlue: f64,
    clearAlpha: f64,
    raster: RasterPipelineState,
    depth: DepthStencilState,
    vertexLayout: VertexBufferLayout,
    vertexBuffer: int,
    vertexCount: int,
    indexBuffer: int,
    indexCount: int,
    instanceCount: int,
    bindingKinds: array<int>,
    bindingNumbers: array<int>,
    bindingResources: array<int>,
    bindingOffsets: array<int>,
    bindingSizes: array<int>,
    bindingSamplers: array<int>,
    indirectBuffer: int = 0,
    indexedIndirect: bool = false,
    clearStorage: i64* = nativeNullPointer(),
    clearMask: int = -1,
    discardBeforeMask: int = 0,
    discardAfterMask: int = 0,
    pushConstantData: i64* = nativeNullPointer(),
    pushConstantSize: int = 0,
    vertexOffset: int = 0,
    indexOffset: int = 0,
    indirectOffset: int = 0
): bool {
    val indexed = indexCount > 0 || indexedIndirect
    var rendered = this.valid() && target.valid() && program.valid() &&
        graphicsColorScalarsValid(
            clearRed,
            clearGreen,
            clearBlue,
            clearAlpha
        ) && raster.fits(target.width, target.height) && depth.valid() &&
        vertexLayout.valid() && vertexCount > 0 && indexCount >= 0 &&
        instanceCount > 0 &&
        ((vertexLayout.buffered() && vertexBuffer != 0) ||
         (!vertexLayout.buffered() && vertexBuffer == 0 && !indexed)) &&
        ((!indexed && indexBuffer == 0) ||
         (vertexLayout.buffered() && indexed && indexBuffer != 0)) &&
        (!indexedIndirect || indirectBuffer != 0) &&
        vertexOffset >= 0 && indexOffset >= 0 && indirectOffset >= 0 &&
        (vertexOffset & 3) == 0 && (indexOffset & 3) == 0 &&
        (indirectOffset & 3) == 0 &&
        ((program.pushConstantSize == 0 && pushConstantSize == 0 &&
          pointerIsNull(pushConstantData)) ||
         (program.pushConstantSize > 0 &&
          pushConstantSize == program.pushConstantSize &&
          !pointerIsNull(pushConstantData))) &&
        target.display == this.display && target.context == this.context &&
        this.makeCurrent()
    if (rendered) {
        glBindFramebuffer(36160, target.handle)
        openGlInvalidateRenderTarget(
            target,
            discardBeforeMask,
            this.clearScratch
        )
        if (pointerIsNull(clearStorage)) openGlStoreClearScalars(
            this.clearScratch,
            clearRed,
            clearGreen,
            clearBlue,
            clearAlpha
        )
        glDisable(3089)
        glViewport(0, 0, target.width, target.height)
        glColorMask(1, 1, 1, 1)
        var colorIndex = 0
        while (colorIndex < 1 + target.additionalTextures.size) {
            if ((clearMask < 0 ||
                (clearMask & (1 << colorIndex)) != 0) &&
                !pointerIsNull(clearStorage)) glClearBufferfv(
                6144,
                colorIndex,
                nativePointerFromAddress(
                    nativePointerAddress(clearStorage) + colorIndex * 16
                )
            ) else if (clearMask < 0 ||
                (clearMask & (1 << colorIndex)) != 0) glClearBufferfv(
                    6144,
                    colorIndex,
                    this.clearScratch.address
                )
            colorIndex = colorIndex + 1
        }
        if (target.depthTexture != 0 &&
            (clearMask < 0 || (clearMask & (1 << 8)) != 0)) {
            if (!pointerIsNull(clearStorage)) glClearBufferfv(
                6145,
                0,
                nativePointerFromAddress(
                    nativePointerAddress(clearStorage) +
                        (1 + target.additionalTextures.size) * 16
                )
            ) else {
                openGlStoreI32(
                    this.clearScratch,
                    0,
                    1065353216
                )
                glClearBufferfv(6145, 0, this.clearScratch.address)
            }
            if (target.stencil) {
                glStencilMask(255)
                if (!pointerIsNull(clearStorage)) glClearBufferiv(
                    6146,
                    0,
                    nativePointerFromAddress(
                        nativePointerAddress(clearStorage) +
                            (1 + target.additionalTextures.size) * 16 + 4
                    )
                ) else {
                    openGlStoreI32(this.clearScratch, 1, 0)
                    glClearBufferiv(
                        6146,
                        0,
                        nativePointerFromAddress(
                            nativePointerAddress(this.clearScratch.address) + 4
                        )
                    )
                }
            }
        }
        glUseProgram(program.handle)
        glBindVertexArray(program.vertexArray)
        if (program.pushConstantSize > 0) {
            glBindBuffer(35345, program.pushConstantBuffer)
            glBufferSubData(
                35345,
                0,
                program.pushConstantSize,
                pushConstantData
            )
            glBindBufferBase(
                35345,
                openGlPushConstantBinding,
                program.pushConstantBuffer
            )
        }
        if (vertexLayout.buffered()) {
            glBindBuffer(34962, vertexBuffer)
            rendered = openGlConfigureVertexLayout(
                vertexLayout,
                vertexOffset
            )
        }
        rendered = rendered && openGlApplyBindGroup(
            bindingKinds,
            bindingNumbers,
            bindingResources,
            bindingOffsets,
            bindingSizes,
            bindingSamplers
        )
        if (indexed) glBindBuffer(34963, indexBuffer)
        rendered = rendered && openGlApplyDepthState(depth) &&
            openGlApplyRasterState(raster, target.width, target.height)
        if (rendered && indexed && indirectBuffer != 0) {
            glBindBuffer(36671, indirectBuffer)
            glDrawElementsIndirect(
                openGlPrimitiveMode(raster.topology),
                5125,
                nativePointerFromAddress(indirectOffset)
            )
        } else if (rendered && indexed && instanceCount == 1) {
            glDrawElements(
                openGlPrimitiveMode(raster.topology),
                indexCount,
                5125,
                nativePointerFromAddress(indexOffset)
            )
        } else if (rendered && indexed) glDrawElementsInstanced(
            openGlPrimitiveMode(raster.topology),
            indexCount,
            5125,
            nativePointerFromAddress(indexOffset),
            instanceCount
        )
        else if (rendered && indirectBuffer != 0) {
            glBindBuffer(36671, indirectBuffer)
            glDrawArraysIndirect(
                openGlPrimitiveMode(raster.topology),
                nativePointerFromAddress(indirectOffset)
            )
        } else if (rendered) glDrawArraysInstanced(
                openGlPrimitiveMode(raster.topology),
                0,
                vertexCount,
                instanceCount
            )
        if (rendered) {
            glDisable(3089)
            glColorMask(1, 1, 1, 1)
            openGlApplyBindGroupWriteBarrier(bindingKinds)
            openGlInvalidateRenderTarget(
                target,
                discardAfterMask,
                this.clearScratch
            )
        }
        rendered = rendered && glGetError() == 0
        glBindFramebuffer(36160, 0)
    }
    rendered
}

trusted fun OpenGlWindowContext.texture(
    descriptor: TextureDescriptor
): OpenGlTexture {
    var handle = 0
    val target = openGlTextureTarget(descriptor.dimension, descriptor.samples)
    val selected = openGlTextureFormat(descriptor.format)
    if (descriptor.valid() && target != 0 && selected.valid &&
        this.makeCurrent()) {
        val output = nativeI64Cell(0)
        glGenTextures(1, output.address)
        handle = output.load()
        if (handle != 0) {
            glBindTexture(target, handle)
            if (descriptor.samples > 1) glTexImage2DMultisample(
                target,
                descriptor.samples,
                selected.internalFormat,
                descriptor.size.width,
                descriptor.size.height,
                1
            ) else {
                glTexParameteri(target, 33084, 0)
                glTexParameteri(target, 33085, descriptor.mipLevels - 1)
                if (descriptor.dimension == textureDimension1D) glTexStorage1D(
                    target,
                    descriptor.mipLevels,
                    selected.internalFormat,
                    descriptor.size.width
                ) else if (descriptor.dimension == textureDimension2D ||
                    descriptor.dimension == textureDimensionCube) {
                    glTexStorage2D(
                        target,
                        descriptor.mipLevels,
                        selected.internalFormat,
                        descriptor.size.width,
                        descriptor.size.height
                    )
                } else glTexStorage3D(
                    target,
                    descriptor.mipLevels,
                    selected.internalFormat,
                    descriptor.size.width,
                    descriptor.size.height,
                    descriptor.size.depth
                )
            }
            if (glGetError() != 0) {
                glDeleteTextures(1, output.address)
                handle = 0
            }
        }
    }
    OpenGlTexture(
        handle,
        target,
        this.display,
        this.surface,
        this.context,
        nativeByteBuffer(8)
    )
}

fun OpenGlTexture.view(
    texture: TextureDescriptor,
    descriptor: TextureViewDescriptor
): OpenGlTextureView {
    val validation = descriptor.validation(texture)
    val fullView = descriptor.resolvedFormat(texture) == texture.format &&
        descriptor.resolvedDimension(texture) == texture.dimension &&
        descriptor.baseMipLevel == 0 &&
        descriptor.resolvedMipLevelCount(texture) == texture.mipLevels &&
        descriptor.baseArrayLayer == 0 &&
        descriptor.resolvedArrayLayerCount(texture) ==
            textureArrayLayerCount(texture)
    var handle = 0
    var owned = false
    if (this.valid() && validation.succeeded && fullView) handle = this.handle
    else if (this.valid() && validation.succeeded && eglMakeCurrent(
        this.display,
        this.surface,
        this.surface,
        this.context
    ) == eglTrue) {
        val selected = openGlTextureFormat(descriptor.resolvedFormat(texture))
        val target = openGlTextureTarget(
            descriptor.resolvedDimension(texture)
        )
        if (selected.valid && target != 0) {
            val output = nativeI64Cell(0)
            glGenTextures(1, output.address)
            handle = output.load()
            if (handle != 0) {
                glTextureView(
                    handle,
                    target,
                    this.handle,
                    selected.internalFormat,
                    descriptor.baseMipLevel,
                    descriptor.resolvedMipLevelCount(texture),
                    if (texture.dimension == textureDimension3D) 0
                    else descriptor.baseArrayLayer,
                    if (texture.dimension == textureDimension3D)
                        textureMipDimension(
                            texture.size.depth,
                            descriptor.baseMipLevel
                        )
                    else descriptor.resolvedArrayLayerCount(texture)
                )
                if (glGetError() == 0) owned = true
                else {
                    glDeleteTextures(1, output.address)
                    handle = 0
                }
            }
        }
    }
    OpenGlTextureView(
        handle,
        this.display,
        this.surface,
        this.context,
        owned
    )
}

resource class OpenGlPixelPresenter(
    val program: OpenGlProgram,
    var texture: int,
    val width: int,
    val height: int
) {
    fun valid(): bool =
        this.program.valid() && this.texture != 0 &&
        this.width > 0 && this.height > 0

    trusted fun present(
        context: OpenGlWindowContext,
        pixels: PixelBuffer
    ): bool {
        var presented = false
        if (this.valid() && context.valid() && pixels.valid() &&
            pixels.width == this.width && pixels.height == this.height &&
            context.makeCurrent()) {
            glBindTexture(3553, this.texture)
            glTexSubImage2D(
                3553,
                0,
                0,
                0,
                this.width,
                this.height,
                6408,
                5121,
                pixels.storage.address
            )
            glViewport(0, 0, context.width, context.height)
            glUseProgram(this.program.handle)
            glBindVertexArray(this.program.vertexArray)
            glDrawArrays(4, 0, 3)
            presented = glGetError() == 0 &&
                eglSwapBuffers(context.display, context.surface) == eglTrue
        }
        presented
    }

    trusted fun drop(): void {
        if (this.texture != 0) {
            val textureCell = nativeI64Cell(this.texture)
            glDeleteTextures(1, textureCell.address)
            this.texture = 0
        }
        return
    }
}

class OpenGlShaderResult(val handle: int, val error: string)

trusted fun openGlShaderLog(shader: int): string {
    val length = nativeI64Cell(0)
    val bytes = nativeByteBuffer(4097)
    glGetShaderInfoLog(shader, 4096, length.address, bytes.address)
    var measured = length.load() & 4294967295
    if (measured > 4096) measured = 4096
    bytes.adoptString(measured)
}

trusted fun openGlProgramLog(program: int): string {
    val length = nativeI64Cell(0)
    val bytes = nativeByteBuffer(4097)
    glGetProgramInfoLog(program, 4096, length.address, bytes.address)
    var measured = length.load() & 4294967295
    if (measured > 4096) measured = 4096
    bytes.adoptString(measured)
}

trusted fun openGlCompileShader(
    kind: int,
    source: string
): OpenGlShaderResult {
    var shader = glCreateShader(kind)
    var error = ""
    if (shader != 0) {
        val sourcePointer = nativePointerCell(
            nativePointerFromAddress(nativeCStringAddress(source))
        )
        glShaderSource(
            shader,
            1,
            sourcePointer.address,
            nativeNullPointer()
        )
        glCompileShader(shader)
        val compiled = nativeI64Cell(0)
        glGetShaderiv(shader, 35713, compiled.address)
        if ((compiled.load() & 4294967295) == 0) {
            error = openGlShaderLog(shader)
            glDeleteShader(shader)
            shader = 0
        }
    } else {
        error = "OpenGL returned shader handle zero"
    }
    OpenGlShaderResult(shader, error)
}

trusted fun openGlSpecializeShader(
    kind: int,
    module: SpirvModule,
    specialization: ShaderSpecialization
): OpenGlShaderResult {
    var accepted = module.valid() && specialization.structurallyValid()
    var index = 0
    while (accepted && index < specialization.values.size) {
        accepted = specialization.values[index].byteSize == 4
        index = index + 1
    }
    var shader = 0
    var error = ""
    if (!accepted) {
        error = "OpenGL specialization requires valid 32-bit scalar values"
    } else if (!openGlExtensionAvailable("GL_ARB_gl_spirv")) {
        error = "OpenGL SPIR-V specialization is unavailable"
    } else {
        shader = glCreateShader(kind)
        if (shader != 0) {
            val code = nativeByteBuffer(module.words.size * 4)
            index = 0
            while (index < module.words.size) {
                openGlStoreI32(code, index, module.words[index])
                index = index + 1
            }
            val shaderCell = nativeI64Cell(shader)
            while (glGetError() != 0) {}
            glShaderBinary(
                1,
                shaderCell.address,
                38225,
                code.address,
                module.words.size * 4
            )
            val binaryError = glGetError()
            var specializeError = 0
            val compiled = nativeI64Cell(0)
            if (binaryError == 0) {
                val indices = nativeByteBuffer(
                    specialization.values.size * 4
                )
                val values = nativeByteBuffer(
                    specialization.values.size * 4
                )
                index = 0
                while (index < specialization.values.size) {
                    openGlStoreI32(
                        indices,
                        index,
                        specialization.values[index].id
                    )
                    openGlStoreI32(
                        values,
                        index,
                        specialization.values[index].bits
                    )
                    index = index + 1
                }
                glSpecializeShader(
                    shader,
                    nativePointerFromAddress(nativeCStringAddress("main")),
                    specialization.values.size,
                    if (specialization.empty()) nativeNullPointer()
                    else indices.address,
                    if (specialization.empty()) nativeNullPointer()
                    else values.address
                )
                specializeError = glGetError()
                glGetShaderiv(shader, 35713, compiled.address)
            }
            if (binaryError != 0 || specializeError != 0 ||
                (compiled.load() & 4294967295) == 0) {
                error = openGlShaderLog(shader)
                if (error == "") {
                    error = if (binaryError != 0)
                        "OpenGL rejected the SPIR-V binary"
                    else if (specializeError != 0)
                        "OpenGL rejected SPIR-V specialization values"
                    else "OpenGL SPIR-V specialization failed"
                }
                glDeleteShader(shader)
                shader = 0
            }
        } else error = "OpenGL returned shader handle zero"
    }
    OpenGlShaderResult(shader, error)
}

trusted fun OpenGlWindowContext.computeSpirvPipeline(
    module: SpirvModule,
    specialization: ShaderSpecialization,
    storageBuffer: int = 0
): OpenGlComputePipeline {
    var program = 0
    var error = ""
    if (this.makeCurrent()) {
        val compute = openGlSpecializeShader(
            37305,
            module,
            specialization
        )
        error = compute.error
        if (compute.handle != 0) {
            program = glCreateProgram()
            if (program != 0) {
                glAttachShader(program, compute.handle)
                glLinkProgram(program)
                val linked = nativeI64Cell(0)
                glGetProgramiv(program, 35714, linked.address)
                if ((linked.load() & 4294967295) == 0) {
                    error = openGlProgramLog(program)
                    glDeleteProgram(program)
                    program = 0
                }
            } else error = "OpenGL returned program handle zero"
            glDeleteShader(compute.handle)
        }
    } else error = "OpenGL specialization requires a current context"
    OpenGlComputePipeline(
        program,
        this.display,
        this.surface,
        this.context,
        storageBuffer,
        0,
        0,
        error
    )
}

trusted fun openGlProgram(
    vertexSource: string,
    fragmentSource: string,
    pushConstantSize: int = 0
): OpenGlProgram {
    val vertex = openGlCompileShader(35633, vertexSource)
    val fragment = openGlCompileShader(35632, fragmentSource)
    var program = 0
    var vertexArray = 0
    var pushConstantBuffer = 0
    var error = if (vertex.error != "") vertex.error else fragment.error
    if (vertex.handle != 0 && fragment.handle != 0) {
        program = glCreateProgram()
        if (program != 0) {
            glAttachShader(program, vertex.handle)
            glAttachShader(program, fragment.handle)
            glLinkProgram(program)
            val linked = nativeI64Cell(0)
            glGetProgramiv(program, 35714, linked.address)
            if ((linked.load() & 4294967295) == 0) {
                error = openGlProgramLog(program)
                glDeleteProgram(program)
                program = 0
            }
        } else {
            error = "OpenGL returned program handle zero"
        }
    }
    if (vertex.handle != 0) glDeleteShader(vertex.handle)
    if (fragment.handle != 0) glDeleteShader(fragment.handle)
    if (program != 0) {
        val array = nativeI64Cell(0)
        glGenVertexArrays(1, array.address)
        vertexArray = array.load() & 4294967295
        if (vertexArray == 0) {
            glDeleteProgram(program)
            program = 0
        }
    }
    if (program != 0 && pushConstantSize > 0 && pushConstantSize <= 128) {
        val output = nativeI64Cell(0)
        glGenBuffers(1, output.address)
        pushConstantBuffer = output.load() & 4294967295
        if (pushConstantBuffer != 0) {
            glBindBuffer(35345, pushConstantBuffer)
            glBufferData(
                35345,
                pushConstantSize,
                nativeNullPointer(),
                35048
            )
            if (glGetError() != 0) {
                glDeleteBuffers(1, output.address)
                pushConstantBuffer = 0
            }
        }
        if (pushConstantBuffer == 0) {
            glDeleteProgram(program)
            val array = nativeI64Cell(vertexArray)
            glDeleteVertexArrays(1, array.address)
            program = 0
            vertexArray = 0
            error = "OpenGL push-constant buffer creation failed"
        }
    } else if (program != 0 &&
        (pushConstantSize < 0 || pushConstantSize > 128)) {
        glDeleteProgram(program)
        val array = nativeI64Cell(vertexArray)
        glDeleteVertexArrays(1, array.address)
        program = 0
        vertexArray = 0
        error = "invalid OpenGL push-constant size"
    }
    OpenGlProgram(
        program,
        vertexArray,
        pushConstantBuffer,
        pushConstantSize,
        error
    )
}

trusted fun openGlProgramFromPackage(
    var shader: ShaderPackage
): OpenGlProgram {
    var bindingAvailable = true
    var index = 0
    while (bindingAvailable && index < shader.bindings.size) {
        bindingAvailable = shader.bindings[index].binding !=
            openGlPushConstantBinding
        index = index + 1
    }
    val vertexSource = shader.openGlSource(shaderStageVertex)
    val fragmentSource = shader.openGlSource(shaderStageFragment)
    val layout = shader.pushConstantLayout()
    if (shader.valid && layout.valid && layout.openGlCompatible() &&
        (layout.size == 0 || bindingAvailable)) openGlProgram(
        vertexSource,
        fragmentSource,
        layout.size
    ) else OpenGlProgram(
        0,
        0,
        0,
        layout.size,
        if (!shader.valid) shader.error
        else if (!layout.valid) layout.error
        else if (!layout.openGlCompatible())
            "OpenGL push-constant emulation requires std140-compatible member strides"
        else "OpenGL push-constant binding collides with binding 15"
    )
}

resource class OpenGlComputePipeline(
    var handle: int,
    val display: i64*,
    val surface: i64*,
    val context: i64*,
    val storageBuffer: int,
    var pushConstantBuffer: int,
    val pushConstantSize: int,
    val error: string
) {
    fun valid(): bool = this.handle != 0 &&
        !pointerIsNull(this.display) && !pointerIsNull(this.context) &&
        this.pushConstantSize >= 0 && this.pushConstantSize <= 128 &&
        ((this.pushConstantSize == 0 && this.pushConstantBuffer == 0) ||
         (this.pushConstantSize > 0 && this.pushConstantBuffer != 0))

    trusted fun dispatch(
        x: int,
        y: int = 1,
        z: int = 1,
        pushConstantData: i64* = nativeNullPointer(),
        pushConstantSize: int = 0
    ): bool {
        var succeeded = this.valid() && x > 0 && y > 0 && z > 0 &&
            x <= 65535 && y <= 65535 && z <= 65535 &&
            ((this.pushConstantSize == 0 && pushConstantSize == 0 &&
              pointerIsNull(pushConstantData)) ||
             (this.pushConstantSize > 0 &&
              pushConstantSize == this.pushConstantSize &&
              !pointerIsNull(pushConstantData))) &&
            eglMakeCurrent(
                this.display,
                this.surface,
                this.surface,
                this.context
            ) == eglTrue
        if (succeeded) {
            if (this.pushConstantSize > 0) {
                glBindBuffer(35345, this.pushConstantBuffer)
                glBufferSubData(
                    35345,
                    0,
                    this.pushConstantSize,
                    pushConstantData
                )
                glBindBufferBase(
                    35345,
                    openGlPushConstantBinding,
                    this.pushConstantBuffer
                )
            }
            if (this.storageBuffer != 0) {
                glBindBufferBase(37074, 0, this.storageBuffer)
            }
            glUseProgram(this.handle)
            glDispatchCompute(x, y, z)
            if (this.storageBuffer != 0) glMemoryBarrier(8192)
            succeeded = glGetError() == 0
        }
        succeeded
    }

    trusted fun dispatchBound(
        x: int,
        y: int,
        z: int,
        pushConstantData: i64*,
        pushConstantSize: int,
        bindingKinds: array<int>,
        bindingNumbers: array<int>,
        bindingResources: array<int>,
        bindingOffsets: array<int>,
        bindingSizes: array<int>,
        bindingSamplers: array<int>
    ): bool {
        var succeeded = this.valid() && x > 0 && y > 0 && z > 0 &&
            x <= 65535 && y <= 65535 && z <= 65535 &&
            ((this.pushConstantSize == 0 && pushConstantSize == 0 &&
              pointerIsNull(pushConstantData)) ||
             (this.pushConstantSize > 0 &&
              pushConstantSize == this.pushConstantSize &&
              !pointerIsNull(pushConstantData))) &&
            eglMakeCurrent(
                this.display,
                this.surface,
                this.surface,
                this.context
            ) == eglTrue
        if (succeeded) {
            succeeded = openGlApplyBindGroup(
                bindingKinds,
                bindingNumbers,
                bindingResources,
                bindingOffsets,
                bindingSizes,
                bindingSamplers
            )
        }
        if (succeeded) {
            if (this.pushConstantSize > 0) {
                glBindBuffer(35345, this.pushConstantBuffer)
                glBufferSubData(
                    35345,
                    0,
                    this.pushConstantSize,
                    pushConstantData
                )
                glBindBufferBase(
                    35345,
                    openGlPushConstantBinding,
                    this.pushConstantBuffer
                )
            }
            if (this.storageBuffer != 0) {
                glBindBufferBase(37074, 0, this.storageBuffer)
            }
            glUseProgram(this.handle)
            glDispatchCompute(x, y, z)
            var barrierBits = if (this.storageBuffer != 0) 8192 else 0
            var bindingIndex = 0
            while (bindingIndex < bindingKinds.size) {
                if (bindingKinds[bindingIndex] == 3) {
                    barrierBits = barrierBits | 8192
                } else if (bindingKinds[bindingIndex] == 4) {
                    barrierBits = barrierBits | 32
                }
                bindingIndex = bindingIndex + 1
            }
            if (barrierBits != 0) glMemoryBarrier(barrierBits)
            succeeded = glGetError() == 0
        }
        succeeded
    }

    trusted fun drop(): void {
        if (this.pushConstantBuffer != 0) {
            if (!pointerIsNull(this.display) && !pointerIsNull(this.context)) {
                eglMakeCurrent(
                    this.display,
                    this.surface,
                    this.surface,
                    this.context
                )
            }
            val output = nativeI64Cell(this.pushConstantBuffer)
            glDeleteBuffers(1, output.address)
            this.pushConstantBuffer = 0
        }
        if (this.handle != 0) {
            if (!pointerIsNull(this.display) && !pointerIsNull(this.context)) {
                eglMakeCurrent(
                    this.display,
                    this.surface,
                    this.surface,
                    this.context
                )
            }
            glDeleteProgram(this.handle)
            this.handle = 0
        }
        return
    }
}

trusted fun OpenGlWindowContext.computePipeline(
    var shader: ShaderPackage,
    storageBuffer: int = 0
): OpenGlComputePipeline {
    var program = 0
    var pushConstantBuffer = 0
    var error = if (shader.valid) "" else shader.error
    var pushBindingAvailable = true
    var bindingIndex = 0
    while (pushBindingAvailable && bindingIndex < shader.bindings.size) {
        pushBindingAvailable = shader.bindings[bindingIndex].binding !=
            openGlPushConstantBinding
        bindingIndex = bindingIndex + 1
    }
    val computeStageValid = shader.valid && shader.stages.size == 1 &&
        shader.stages[0].kind == shaderStageCompute
    val computeSource = shader.openGlSource(shaderStageCompute)
    val pushLayout = shader.pushConstantLayout()
    if (computeStageValid && pushLayout.valid &&
        pushLayout.openGlCompatible() &&
        pushBindingAvailable && this.makeCurrent()) {
        val compute = openGlCompileShader(
            37305,
            computeSource
        )
        error = compute.error
        if (compute.handle != 0) {
            program = glCreateProgram()
            if (program != 0) {
                glAttachShader(program, compute.handle)
                glLinkProgram(program)
                val linked = nativeI64Cell(0)
                glGetProgramiv(program, 35714, linked.address)
                if ((linked.load() & 4294967295) == 0) {
                    error = openGlProgramLog(program)
                    glDeleteProgram(program)
                    program = 0
                }
            }
            glDeleteShader(compute.handle)
        }
        if (program != 0 && pushLayout.size > 0) {
            val output = nativeI64Cell(0)
            glGenBuffers(1, output.address)
            pushConstantBuffer = output.load() & 4294967295
            if (pushConstantBuffer != 0) {
                glBindBuffer(35345, pushConstantBuffer)
                glBufferData(
                    35345,
                    pushLayout.size,
                    nativeNullPointer(),
                    35048
                )
                if (glGetError() != 0) {
                    glDeleteBuffers(1, output.address)
                    pushConstantBuffer = 0
                }
            }
            if (pushConstantBuffer == 0) {
                glDeleteProgram(program)
                program = 0
                error = "OpenGL push-constant buffer creation failed"
            }
        }
    } else if (error == "") {
        error = if (!pushLayout.valid) pushLayout.error
            else if (!pushLayout.openGlCompatible())
                "OpenGL push-constant emulation requires std140-compatible member strides"
            else if (!pushBindingAvailable)
                "OpenGL push-constant binding collides with binding 15"
            else "OpenGL compute requires one valid compute stage and context"
    }
    OpenGlComputePipeline(
        program,
        this.display,
        this.surface,
        this.context,
        storageBuffer,
        pushConstantBuffer,
        pushLayout.size,
        error
    )
}

trusted fun openGlPixelPresenter(
    context: OpenGlWindowContext,
    width: int,
    height: int
): OpenGlPixelPresenter {
    val shader = $glsl {
        vertex {
            #version 330 core
            out vec2 textureCoordinate;
            const vec2 positions[3] = vec2[3](
                vec2(-1.0, -1.0),
                vec2(3.0, -1.0),
                vec2(-1.0, 3.0)
            );
            void main() {
                vec2 position = positions[gl_VertexID];
                vec2 coordinate = position * 0.5 + 0.5;
                textureCoordinate = vec2(coordinate.x, 1.0 - coordinate.y);
                gl_Position = vec4(position, 0.0, 1.0);
            }
        }
        fragment {
            #version 330 core
            in vec2 textureCoordinate;
            out vec4 color;
            uniform sampler2D frameTexture;
            void main() {
                color = texture(frameTexture, textureCoordinate);
            }
        }
    }
    var program = OpenGlProgram(
        0, 0, 0, 0, "invalid context or dimensions"
    )
    var texture = 0
    if (context.valid() && width > 0 && width <= 16384 &&
        height > 0 && height <= 16384 && context.makeCurrent()) {
        program = openGlProgramFromPackage(shader)
    }
    if (program.valid()) {
        val textureCell = nativeI64Cell(0)
        glGenTextures(1, textureCell.address)
        texture = textureCell.load() & 4294967295
        if (texture != 0) {
            glBindTexture(3553, texture)
            glTexParameteri(3553, 10241, 9728)
            glTexParameteri(3553, 10240, 9728)
            glTexParameteri(3553, 10242, 33071)
            glTexParameteri(3553, 10243, 33071)
            glTexImage2D(
                3553,
                0,
                32856,
                width,
                height,
                0,
                6408,
                5121,
                nativeNullPointer()
            )
            if (glGetError() != 0) {
                glDeleteTextures(1, textureCell.address)
                texture = 0
            }
        }
    }
    OpenGlPixelPresenter(move(program), texture, width, height)
}

