// Process-visible OpenGL debug callback implemented entirely in Abla.

import "abla/build"
import "abla/unsafe/memory"

trusted fun openGlDebugCounterIncrement(address: int, offset: int): void {
    nativeAtomicFetchAddI64(nativePointerFromAddress(address + offset), 1)
    return
}

@export("abla_graphics_opengl_debug_callback")
trusted fun openGlDebugCallback(
    source: u32,
    messageType: u32,
    identifier: u32,
    severity: u32,
    length: i32,
    message: int,
    userData: int
): void {
    if (userData > 0) {
        openGlDebugCounterIncrement(userData, 0)
        if (severity == 37190) openGlDebugCounterIncrement(userData, 8)
        if (severity == 37191) openGlDebugCounterIncrement(userData, 16)
        if (severity == 37192) openGlDebugCounterIncrement(userData, 24)
        if (severity == 33387) openGlDebugCounterIncrement(userData, 32)
        if (messageType == 33356) {
            openGlDebugCounterIncrement(userData, 40)
        } else if (messageType == 33357) {
            openGlDebugCounterIncrement(userData, 48)
        } else if (messageType == 33358) {
            openGlDebugCounterIncrement(userData, 56)
        } else if (messageType == 33359) {
            openGlDebugCounterIncrement(userData, 64)
        } else if (messageType == 33360) {
            openGlDebugCounterIncrement(userData, 72)
        } else if (messageType == 33384) {
            openGlDebugCounterIncrement(userData, 80)
        } else {
            openGlDebugCounterIncrement(userData, 88)
        }
    }
    return
}
