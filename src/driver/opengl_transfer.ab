// Reusable asynchronous OpenGL buffer-transfer completion slots.

import "abla/unsafe/memory"
import "../core.ab"
import "../resources.ab"
import "opengl.ab"

resource class OpenGlTransferSlot(
    val display: i64*,
    val surface: i64*,
    val context: i64*,
    var sync: i64*
) {
    trusted fun valid(): bool = !pointerIsNull(this.display) &&
        !pointerIsNull(this.surface) && !pointerIsNull(this.context)

    trusted fun inFlight(): bool = this.valid() &&
        !pointerIsNull(this.sync)

    trusted fun makeCurrent(): bool = this.valid() && eglMakeCurrent(
        this.display,
        this.surface,
        this.surface,
        this.context
    ) == eglTrue

    trusted fun poll(): bool {
        var completed = this.valid() && !this.inFlight()
        if (this.valid() && this.inFlight() && this.makeCurrent()) {
            val status = glClientWaitSync(this.sync, 1, 0)
            completed = status == 37146 || status == 37148
            if (completed) {
                glDeleteSync(this.sync)
                this.sync = nativeNullPointer()
                completed = glGetError() == 0
            }
        }
        completed
    }

    trusted fun wait(timeoutNanoseconds: int = -1): bool {
        var completed = this.valid() && timeoutNanoseconds >= -1 &&
            !this.inFlight()
        if (this.valid() && timeoutNanoseconds >= -1 && this.inFlight() &&
            this.makeCurrent()) {
            val status = glClientWaitSync(
                this.sync,
                1,
                timeoutNanoseconds
            )
            completed = status == 37146 || status == 37148
            if (completed) {
                glDeleteSync(this.sync)
                this.sync = nativeNullPointer()
                completed = glGetError() == 0
            }
        }
        completed
    }

    trusted fun submitBufferCopy(
        source: OpenGlBuffer,
        destination: OpenGlBuffer,
        sourceOffset: int,
        destinationOffset: int,
        size: int
    ): bool {
        val byteCount = bufferCopyResolvedSize(
            sourceOffset,
            size,
            source.size
        )
        var succeeded = this.valid() && !this.inFlight() && source.valid() &&
            destination.valid() &&
            (!source.mapped() || source.persistent) &&
            (!destination.mapped() || destination.persistent) &&
            source.context == this.context &&
            destination.context == this.context &&
            source.display == this.display &&
            destination.display == this.display &&
            bufferCopyRangeValid(
                sourceOffset,
                destinationOffset,
                size,
                source.size,
                destination.size
            ) && this.makeCurrent()
        if (succeeded) {
            if (source.mapped() && source.persistent) glMemoryBarrier(16384)
            glBindBuffer(36662, source.handle)
            glBindBuffer(36663, destination.handle)
            glCopyBufferSubData(
                36662,
                36663,
                sourceOffset,
                destinationOffset,
                byteCount
            )
            if (destination.mapped() && destination.persistent) {
                glMemoryBarrier(16384)
            }
            succeeded = glGetError() == 0
            if (succeeded) {
                this.sync = glFenceSync(37143, 0)
                succeeded = !pointerIsNull(this.sync) && glGetError() == 0
            }
            if (!succeeded && !pointerIsNull(this.sync)) {
                glDeleteSync(this.sync)
                this.sync = nativeNullPointer()
            }
        }
        succeeded
    }

    trusted fun submitTextureUpload(
        staging: OpenGlBuffer,
        stagingOffset: int,
        texture: OpenGlTexture,
        format: int,
        mipLevel: int,
        x: int,
        y: int,
        width: int,
        height: int
    ): bool {
        val byteCount = width * height * 4
        var succeeded = this.valid() && !this.inFlight() &&
            staging.valid() && texture.valid() && staging.persistent &&
            staging.mappedWritable() &&
            staging.context == this.context &&
            texture.context == this.context &&
            staging.display == this.display &&
            texture.display == this.display &&
            staging.mappedContains(stagingOffset, byteCount) &&
            textureFormatAcceptsRgba8Pixels(format) &&
            mipLevel >= 0 && x >= 0 && y >= 0 && width > 0 && height > 0 &&
            this.makeCurrent()
        if (succeeded) {
            glMemoryBarrier(16384)
            glBindBuffer(35052, staging.handle)
            glBindTexture(texture.target, texture.handle)
            glTexSubImage2D(
                texture.target,
                mipLevel,
                x,
                y,
                width,
                height,
                if (format == textureFormatBgra8Unorm ||
                    format == textureFormatBgra8UnormSrgb)
                    32993 else 6408,
                5121,
                nativePointerFromAddress(stagingOffset)
            )
            glBindBuffer(35052, 0)
            succeeded = glGetError() == 0
            if (succeeded) {
                this.sync = glFenceSync(37143, 0)
                succeeded = !pointerIsNull(this.sync) && glGetError() == 0
            }
            if (!succeeded && !pointerIsNull(this.sync)) {
                glDeleteSync(this.sync)
                this.sync = nativeNullPointer()
            }
        }
        succeeded
    }

    trusted fun submitTextureReadback(
        texture: OpenGlTexture,
        format: int,
        mipLevel: int,
        x: int,
        y: int,
        width: int,
        height: int,
        staging: OpenGlBuffer,
        stagingOffset: int
    ): bool {
        val byteCount = width * height * 4
        var succeeded = this.valid() && !this.inFlight() &&
            texture.valid() && staging.valid() && staging.persistent &&
            staging.mappedReadable() &&
            texture.context == this.context &&
            staging.context == this.context &&
            texture.display == this.display &&
            staging.display == this.display &&
            staging.mappedContains(stagingOffset, byteCount) &&
            textureFormatAcceptsRgba8Pixels(format) &&
            mipLevel >= 0 && x >= 0 && y >= 0 && width > 0 && height > 0 &&
            this.makeCurrent()
        if (succeeded) {
            glBindBuffer(35051, staging.handle)
            glGetTextureSubImage(
                texture.handle,
                mipLevel,
                x,
                y,
                0,
                width,
                height,
                1,
                if (format == textureFormatBgra8Unorm ||
                    format == textureFormatBgra8UnormSrgb)
                    32993 else 6408,
                5121,
                byteCount,
                nativePointerFromAddress(stagingOffset)
            )
            glBindBuffer(35051, 0)
            glMemoryBarrier(16384)
            succeeded = glGetError() == 0
            if (succeeded) {
                this.sync = glFenceSync(37143, 0)
                succeeded = !pointerIsNull(this.sync) && glGetError() == 0
            }
            if (!succeeded && !pointerIsNull(this.sync)) {
                glDeleteSync(this.sync)
                this.sync = nativeNullPointer()
            }
        }
        succeeded
    }

    trusted fun submitTextureBytesUpload(
        staging: OpenGlBuffer,
        stagingOffset: int,
        texture: OpenGlTexture,
        descriptor: TextureDescriptor,
        mipLevel: int,
        x: int,
        y: int,
        z: int,
        width: int,
        height: int,
        depth: int
    ): bool {
        val byteCount = textureDataRequiredBytesRange(
            descriptor,
            width,
            height,
            depth
        )
        val internalFormat = openGlTextureInternalFormat(descriptor.format)
        val baseFormat = openGlTextureBaseFormat(descriptor.format)
        val kind = openGlTextureDataKind(descriptor.format)
        var succeeded = this.valid() && !this.inFlight() &&
            staging.valid() && texture.valid() && staging.persistent &&
            staging.mappedWritable() && staging.context == this.context &&
            texture.context == this.context &&
            staging.display == this.display && texture.display == this.display &&
            byteCount > 0 && byteCount <= 2147483647 &&
            staging.mappedContains(stagingOffset, byteCount) &&
            !textureFormatHasDepth(descriptor.format) &&
            internalFormat != 0 && textureRegionRangeValid(
                descriptor,
                mipLevel,
                x,
                y,
                z,
                width,
                height,
                depth,
                textureUsageCopyDestination
            ) && this.makeCurrent()
        if (succeeded) {
            glMemoryBarrier(16384)
            glBindBuffer(35052, staging.handle)
            openGlTextureDataLayoutRange(
                descriptor.format,
                width,
                height,
                0,
                0,
                true
            )
            val pixels = nativePointerFromAddress(stagingOffset)
            if (textureFormatCompressed(descriptor.format)) {
                if (descriptor.dimension == textureDimension1D) {
                    glCompressedTextureSubImage1D(
                        texture.handle, mipLevel, x, width,
                        internalFormat, byteCount, pixels
                    )
                } else if (descriptor.dimension == textureDimension2D) {
                    glCompressedTextureSubImage2D(
                        texture.handle, mipLevel, x, y, width, height,
                        internalFormat, byteCount, pixels
                    )
                } else glCompressedTextureSubImage3D(
                    texture.handle, mipLevel, x, y, z, width, height, depth,
                    internalFormat, byteCount, pixels
                )
            } else if (descriptor.dimension == textureDimension1D) {
                glTextureSubImage1D(
                    texture.handle, mipLevel, x, width,
                    baseFormat, kind, pixels
                )
            } else if (descriptor.dimension == textureDimension2D) {
                glTextureSubImage2D(
                    texture.handle, mipLevel, x, y, width, height,
                    baseFormat, kind, pixels
                )
            } else glTextureSubImage3D(
                texture.handle, mipLevel, x, y, z, width, height, depth,
                baseFormat, kind, pixels
            )
            openGlResetTextureDataLayout(
                textureFormatCompressed(descriptor.format),
                true
            )
            glBindBuffer(35052, 0)
            succeeded = glGetError() == 0
            if (succeeded) {
                this.sync = glFenceSync(37143, 0)
                succeeded = !pointerIsNull(this.sync) && glGetError() == 0
            }
            if (!succeeded && !pointerIsNull(this.sync)) {
                glDeleteSync(this.sync)
                this.sync = nativeNullPointer()
            }
        }
        succeeded
    }

    trusted fun submitTextureBytesReadback(
        texture: OpenGlTexture,
        descriptor: TextureDescriptor,
        mipLevel: int,
        x: int,
        y: int,
        z: int,
        width: int,
        height: int,
        depth: int,
        staging: OpenGlBuffer,
        stagingOffset: int
    ): bool {
        val byteCount = textureDataRequiredBytesRange(
            descriptor,
            width,
            height,
            depth
        )
        val baseFormat = openGlTextureBaseFormat(descriptor.format)
        val kind = openGlTextureDataKind(descriptor.format)
        var succeeded = this.valid() && !this.inFlight() && texture.valid() &&
            staging.valid() && staging.persistent && staging.mappedReadable() &&
            texture.context == this.context && staging.context == this.context &&
            texture.display == this.display && staging.display == this.display &&
            byteCount > 0 && byteCount <= 2147483647 &&
            staging.mappedContains(stagingOffset, byteCount) &&
            !textureFormatHasDepth(descriptor.format) &&
            openGlTextureInternalFormat(descriptor.format) != 0 &&
            textureRegionRangeValid(
                descriptor,
                mipLevel,
                x,
                y,
                z,
                width,
                height,
                depth,
                textureUsageCopySource
            ) && this.makeCurrent()
        if (succeeded) {
            glBindBuffer(35051, staging.handle)
            openGlTextureDataLayoutRange(
                descriptor.format,
                width,
                height,
                0,
                0,
                false
            )
            if (textureFormatCompressed(descriptor.format)) {
                glGetCompressedTextureSubImage(
                    texture.handle, mipLevel, x, y, z, width, height, depth,
                    byteCount, nativePointerFromAddress(stagingOffset)
                )
            } else glGetTextureSubImage(
                texture.handle, mipLevel, x, y, z, width, height, depth,
                baseFormat, kind, byteCount,
                nativePointerFromAddress(stagingOffset)
            )
            openGlResetTextureDataLayout(
                textureFormatCompressed(descriptor.format),
                false
            )
            glBindBuffer(35051, 0)
            glMemoryBarrier(16384)
            succeeded = glGetError() == 0
            if (succeeded) {
                this.sync = glFenceSync(37143, 0)
                succeeded = !pointerIsNull(this.sync) && glGetError() == 0
            }
            if (!succeeded && !pointerIsNull(this.sync)) {
                glDeleteSync(this.sync)
                this.sync = nativeNullPointer()
            }
        }
        succeeded
    }

    trusted fun drop(): void {
        if (this.inFlight()) {
            val completed = this.wait(-1)
            if (!completed && this.makeCurrent() && this.inFlight()) {
                glDeleteSync(this.sync)
                this.sync = nativeNullPointer()
            }
        }
        return
    }
}

trusted fun OpenGlWindowContext.transferSlot(): OpenGlTransferSlot =
    OpenGlTransferSlot(
        this.display,
        this.surface,
        this.context,
        nativeNullPointer()
    )
