trusted fun vulkanDriverStoreI32Offset(
    var bytes: NativeByteBuffer,
    offset: int,
    value: int
): bool = value >= -2147483648 && value <= 4294967295 && offset >= 0 &&
    offset <= bytes.capacity - 4 && bytes.store(offset, value & 255) &&
    bytes.store(offset + 1, (value >>> 8) & 255) &&
    bytes.store(offset + 2, (value >>> 16) & 255) &&
    bytes.store(offset + 3, (value >>> 24) & 255)

trusted fun vulkanDriverStoreI64Offset(
    var bytes: NativeByteBuffer,
    offset: int,
    value: int
): bool = offset >= 0 && offset <= bytes.capacity - 8 &&
    bytes.storeI64(offset, value)

trusted fun vulkanDriverStorePointerOffset(
    var bytes: NativeByteBuffer,
    offset: int,
    value: i64*
): bool = offset >= 0 && offset <= bytes.capacity - 8 &&
    bytes.storePointer(offset, value)

trusted fun vulkanDriverZeroKnownStructureAt(
    var bytes: NativeByteBuffer,
    baseOffset: int,
    size: int,
    structureType: int,
    structureTypeOffset: int = 0
): bool {
    val accepted = size > 0 && baseOffset >= 0 &&
        baseOffset <= bytes.capacity - size
    var index = 0
    while (accepted && index < size) {
        bytes.store(baseOffset + index, 0)
        index = index + 1
    }
    accepted && (structureType < 0 || vulkanDriverStoreI32Offset(
        bytes, baseOffset + structureTypeOffset, structureType
    ))
}

