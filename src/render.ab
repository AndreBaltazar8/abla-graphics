// Backend-neutral triangle render pipeline and allocation-free presentation.

import "abla/unsafe/memory"
import "core.ab"
import "application.ab"
import "buffer.ab"
import "binding.ab"
import "target.ab"
import "shader/glsl.ab"
import "shader/glsl_spirv.ab"
import "push_constants.ab"
import "driver/opengl.ab"
import "driver/vulkan.ab"

resource class GraphicsRenderPipeline(
    val openGl: OpenGlProgram,
    var vulkan: VulkanRenderPipeline,
    val backend: int,
    val vertexLayout: VertexBufferLayout,
    val raster: RasterPipelineState,
    val depth: DepthStencilState,
    val pushConstantLayout: ShaderPushConstantLayout,
    val shader: ShaderPackage,
    val binding: GraphicsBindGroup,
    val targetHandle: int,
    val targetWidth: int,
    val targetHeight: int,
    val targetFormat: int,
    val targetColorCount: int,
    val targetSubpass: int,
    val error: GraphicsError
) {
    fun valid(): bool = !this.error.occurred() && this.vertexLayout.valid() &&
        this.raster.valid() && this.depth.valid() && this.shader.valid &&
        this.pushConstantLayout.valid &&
        (this.binding.empty() || this.binding.valid()) &&
        this.targetSubpass >= 0 && this.targetSubpass <= 7 &&
        ((this.backend == graphicsBackendOpenGl && this.openGl.valid()) ||
         (this.backend == graphicsBackendVulkan && this.vulkan.valid()))

    trusted fun drop(): void {
        this.openGl.drop()
        this.vulkan.drop()
        this.binding.drop()
        return
    }
}

resource class GraphicsSubpassPipelineSequence(
    var pipelines: array<GraphicsRenderPipeline>,
    val vulkanHandles: array<int>,
    val vulkanLayouts: array<int>,
    val vulkanDepthEnabled: array<bool>,
    val vulkanRequiresBinding: array<bool>,
    val vulkanDescriptorSets: array<int>,
    val backend: int,
    val targetHandle: int,
    val renderPassHandle: int,
    val error: GraphicsError
) {
    fun valid(): bool = !this.error.occurred() && this.pipelines.size >= 2 &&
        this.pipelines.size <= 8 &&
        ((this.backend == graphicsBackendOpenGl &&
          this.vulkanHandles.size == 0) ||
         (this.backend == graphicsBackendVulkan &&
          this.renderPassHandle != 0 &&
          this.vulkanHandles.size == this.pipelines.size &&
          this.vulkanLayouts.size == this.pipelines.size &&
          this.vulkanDepthEnabled.size == this.pipelines.size &&
          this.vulkanRequiresBinding.size == this.pipelines.size &&
          this.vulkanDescriptorSets.size == this.pipelines.size))

}

trusted fun GraphicsSubpassPipelineSequence.pushConstants(): GraphicsSubpassPushConstants {
    val layouts: array<ShaderPushConstantLayout> = []
    val offsets: array<int> = []
    val sizes: array<int> = []
    val stageMasks: array<int> = []
    var valid = this.valid()
    var totalSize = 0
    var pipelineIndex = 0
    while (valid && pipelineIndex < this.pipelines.size) {
        val layout = this.pipelines[pipelineIndex].pushConstantLayout
        valid = layout.valid && layout.size > 0 && layout.stageMask != 0 &&
            totalSize <= 1024 - layout.size
        if (valid) {
            layouts.append(layout)
            offsets.append(totalSize)
            sizes.append(layout.size)
            stageMasks.append(layout.stageMask)
            totalSize = totalSize + layout.size
        }
        pipelineIndex = pipelineIndex + 1
    }
    val bytes = bufferBytes(if (valid) totalSize else 0)
    GraphicsSubpassPushConstants(
        layouts,
        offsets,
        sizes,
        stageMasks,
        move(bytes),
        if (valid) ""
        else "every subpass pipeline must have valid push constants"
    )
}

trusted fun GraphicsApplication.renderPipeline(
    var shader: ShaderPackage,
    vertexLayout: VertexBufferLayout = VertexBufferLayout(),
    raster: RasterPipelineState = RasterPipelineState(),
    depth: DepthStencilState = DepthStencilState(),
    own binding: GraphicsBindGroup = emptyGraphicsBindGroup(),
    targetHandle: int = 0,
    targetRenderPass: int = 0,
    targetView: int = 0,
    targetFormat: int = 0,
    targetWidth: int = 0,
    targetHeight: int = 0,
    targetDepthView: int = 0,
    targetColorCount: int = 1,
    targetSamples: int = 1,
    targetSubpass: int = 0
): GraphicsRenderPipeline {
    var openGl = OpenGlProgram(0, 0, 0, 0, "")
    var vulkan = VulkanRenderPipeline(
        nativeNullPointer(),
        nativeNullPointer(),
        0,
        0,
        0,
        [],
        [],
        [],
        [],
        0,
        0,
        0,
        0,
        0,
        0,
        false,
        false,
        false,
        false,
        false
    )
    var error = GraphicsError()
    var pushLayout = ShaderPushConstantLayout(true, 0, 0, [], "")
    val stagesValid = shader.valid && shader.stages.size == 2 &&
        shader.source(shaderStageVertex) != "" &&
        shader.source(shaderStageFragment) != ""
    val offscreen = targetHandle != 0
    val targetValid = (!offscreen && targetRenderPass == 0 &&
        targetView == 0 && targetFormat == 0 && targetDepthView == 0 &&
        targetWidth == 0 && targetHeight == 0 && targetSamples == 1 &&
        targetSubpass == 0) ||
        (offscreen && targetWidth > 0 && targetHeight > 0 &&
         (targetSamples == 1 || targetSamples == 2 || targetSamples == 4 ||
         targetSamples == 8 || targetSamples == 16) &&
         targetSubpass >= 0 && targetSubpass <= 7 &&
         ((this.backend == graphicsBackendOpenGl &&
           targetRenderPass == 0 && targetView == 0) ||
          (this.backend == graphicsBackendVulkan &&
           targetRenderPass != 0 && targetView != 0 && targetFormat != 0)))
    var vertexInputCount = 0
    var fragmentOutputCount = 0
    var fragmentOutputsContiguous = true
    var vertexInputValid = true
    var locationIndex = 0
    while (locationIndex < shader.locations.size) {
        val location = shader.locations[locationIndex]
        if (location.stage == shaderStageVertex &&
            location.direction == "in") {
            vertexInputCount = vertexInputCount + 1
            var matched = false
            if (vertexLayout.attributes.size == 0) {
                matched = location.location == 0 &&
                    location.dataType == "vec2"
            } else {
                var attributeIndex = 0
                while (!matched &&
                    attributeIndex < vertexLayout.attributes.size) {
                    val attribute = vertexLayout.attributes[attributeIndex]
                    matched = attribute.location == location.location &&
                        vertexFormatGlslType(attribute.format) ==
                            location.dataType
                    attributeIndex = attributeIndex + 1
                }
            }
            vertexInputValid = vertexInputValid && matched &&
                location.arraySize == 1
        } else if (location.stage == shaderStageFragment &&
            location.direction == "out") {
            fragmentOutputsContiguous = fragmentOutputsContiguous &&
                location.location == fragmentOutputCount &&
                location.arraySize == 1
            fragmentOutputCount = fragmentOutputCount + 1
        }
        locationIndex = locationIndex + 1
    }
    val layoutMatches = vertexLayout.valid() && raster.valid() &&
        depth.valid() &&
        targetColorCount >= 1 && targetColorCount <= 8 &&
        fragmentOutputCount == targetColorCount &&
        fragmentOutputsContiguous &&
        ((vertexLayout.buffered() &&
          vertexInputCount == vertexLayout.attributeCount() &&
          vertexInputValid) ||
         (!vertexLayout.buffered() && vertexInputCount == 0))
    val shaderBindingMatches =
        (shader.bindings.size == 0 && binding.empty()) ||
        (binding.valid() && binding.matches(shader.bindings))
    val translatable = glslPackage(
        [shaderStageVertex, shaderStageFragment],
        [
            shader.source(shaderStageVertex),
            shader.source(shaderStageFragment)
        ]
    )
    val vertexCode = translatable.spirv(shaderStageVertex)
    val fragmentCode = translatable.spirv(shaderStageFragment)
    pushLayout = shader.pushConstantLayout()

    if (!this.valid() || !stagesValid || !layoutMatches || !targetValid ||
        !shaderBindingMatches) {
        error = GraphicsError(
            graphicsErrorInvalidConfiguration,
            "GraphicsApplication.renderPipeline",
            if (shader.error != "") shader.error else
                "rendering requires matching vertex/fragment stages and vertex layout"
        )
    } else if (!pushLayout.valid) {
        error = GraphicsError(
            graphicsErrorInvalidConfiguration,
            "ShaderPackage.pushConstantLayout",
            pushLayout.error
        )
    } else if (!vertexCode.succeeded || !fragmentCode.succeeded) {
        error = GraphicsError(
            graphicsErrorUnsupportedFeature,
            "ShaderPackage.spirv",
            if (!vertexCode.succeeded) vertexCode.error else
                fragmentCode.error
        )
    } else if (this.backend == graphicsBackendOpenGl) {
        if (this.openGl.makeCurrent()) {
            openGl = openGlProgramFromPackage(shader)
        }
        if (!openGl.valid()) error = GraphicsError(
            graphicsErrorDriverFailure,
            "openGlProgramFromPackage",
            if (openGl.error != "") openGl.error else
                "OpenGL render pipeline creation failed"
        )
    } else if (this.backend == graphicsBackendVulkan) {
        val vertex = this.vulkanDevice.shaderModule(vertexCode.module)
        val fragment = this.vulkanDevice.shaderModule(fragmentCode.module)
        if (vertex.valid() && fragment.valid()) {
            vulkan = this.vulkanDevice.renderPipeline(
                this.vulkanSwapchain,
                vertex,
                fragment,
                vertexLayout,
                raster.topology,
                raster.cullMode,
                raster.frontFace,
                raster.alphaBlend,
                depth.enabled,
                depth.write,
                depth.compare,
                if (binding.valid()) binding.vulkan.descriptorSetLayout else 0,
                targetRenderPass,
                targetView,
                targetHandle,
                targetFormat,
                targetWidth,
                targetHeight,
                targetDepthView,
                targetColorCount,
                targetSamples,
                targetSubpass,
                pushConstantSize = pushLayout.size,
                pushConstantStageMask = pushLayout.stageMask
            )
        }
        if (!vulkan.valid()) error = GraphicsError(
            graphicsErrorDriverFailure,
            "VulkanDevice.renderPipeline",
            "Vulkan render pipeline creation failed"
        )
    }

    GraphicsRenderPipeline(
        move(openGl),
        move(vulkan),
        this.backend,
        vertexLayout,
        raster,
        depth,
        pushLayout,
        shader,
        move(binding),
        targetHandle,
        targetWidth,
        targetHeight,
        targetFormat,
        targetColorCount,
        targetSubpass,
        error
    )
}

trusted fun GraphicsApplication.renderTargetPipeline(
    target: GraphicsRenderTarget,
    var shader: ShaderPackage,
    vertexLayout: VertexBufferLayout = VertexBufferLayout(),
    raster: RasterPipelineState = RasterPipelineState(),
    depth: DepthStencilState = DepthStencilState(),
    own binding: GraphicsBindGroup = emptyGraphicsBindGroup()
): GraphicsRenderPipeline {
    if (!target.valid() || target.backend != this.backend) {
        this.renderPipeline(
            shader,
            vertexLayout,
            raster,
            depth,
            move(binding),
            -1
        )
    } else this.renderPipeline(
        shader,
        vertexLayout,
        raster,
        depth,
        move(binding),
        if (this.backend == graphicsBackendOpenGl) target.openGl.handle
        else target.vulkan.framebuffer,
        if (this.backend == graphicsBackendVulkan) target.vulkan.renderPass
        else 0,
        if (this.backend == graphicsBackendVulkan) target.vulkan.view else 0,
        if (this.backend == graphicsBackendVulkan) target.vulkan.format else 0,
        target.texture.descriptor.size.width,
        target.texture.descriptor.size.height,
        if (this.backend == graphicsBackendVulkan)
            target.vulkan.depthView else 0,
        target.colorCount(),
        target.texture.descriptor.samples
    )
}

trusted fun GraphicsApplication.renderPassPipeline(
    target: GraphicsRenderTarget,
    pass: GraphicsRenderPass,
    subpassIndex: int,
    var shader: ShaderPackage,
    vertexLayout: VertexBufferLayout = VertexBufferLayout(),
    raster: RasterPipelineState = RasterPipelineState(),
    depth: DepthStencilState = DepthStencilState(),
    own binding: GraphicsBindGroup = emptyGraphicsBindGroup()
): GraphicsRenderPipeline {
    val compatible = target.valid() && pass.valid() &&
        target.backend == this.backend && pass.backend == this.backend &&
        pass.targetHandle == (if (this.backend == graphicsBackendOpenGl)
            target.openGl.handle else target.vulkan.framebuffer) &&
        subpassIndex >= 0 && subpassIndex < pass.subpassCount
    if (!compatible) this.renderPipeline(
        shader,
        vertexLayout,
        raster,
        depth,
        move(binding),
        -1
    ) else this.renderPipeline(
        shader,
        vertexLayout,
        raster,
        depth,
        move(binding),
        if (this.backend == graphicsBackendOpenGl) target.openGl.handle
        else target.vulkan.framebuffer,
        if (this.backend == graphicsBackendVulkan) pass.vulkan.handle else 0,
        if (this.backend == graphicsBackendVulkan) target.vulkan.view else 0,
        if (this.backend == graphicsBackendVulkan) target.vulkan.format else 0,
        target.texture.descriptor.size.width,
        target.texture.descriptor.size.height,
        if (this.backend == graphicsBackendVulkan)
            target.vulkan.depthView else 0,
        target.colorCount(),
        target.texture.descriptor.samples,
        subpassIndex
    )
}

trusted fun GraphicsApplication.renderToTarget(
    var target: GraphicsRenderTarget,
    pipeline: GraphicsRenderPipeline,
    clear: Color
): bool {
    var succeeded = this.valid() && target.valid() && pipeline.valid() &&
        clear.valid() && target.backend == this.backend &&
        pipeline.backend == this.backend && pipeline.targetHandle != 0 &&
        pipeline.targetWidth == target.texture.descriptor.size.width &&
        pipeline.targetHeight == target.texture.descriptor.size.height &&
        pipeline.targetColorCount == target.colorCount() &&
        pipeline.pushConstantLayout.size == 0 &&
        !pipeline.vertexLayout.buffered() &&
        pipeline.depth.enabled == target.hasDepth()
    if (succeeded && this.backend == graphicsBackendOpenGl) {
        succeeded = pipeline.targetHandle == target.openGl.handle &&
            this.openGl.renderProgramTarget(
                target.openGl,
                pipeline.openGl,
                clear.red,
                clear.green,
                clear.blue,
                clear.alpha,
                pipeline.raster,
                pipeline.depth,
                pipeline.vertexLayout,
                0,
                3,
                0,
                0,
                1,
                pipeline.binding.openGlKinds,
                pipeline.binding.openGlBindings,
                pipeline.binding.openGlResources,
                pipeline.binding.openGlOffsets,
                pipeline.binding.openGlSizes,
                pipeline.binding.openGlSamplers
            )
    } else if (succeeded && this.backend == graphicsBackendVulkan) {
        succeeded = pipeline.targetHandle == target.vulkan.framebuffer &&
            this.vulkanDevice.renderTargetProgram(
                target.vulkan,
                pipeline.vulkan,
                clear.red,
                clear.green,
                clear.blue,
                clear.alpha,
                0,
                3,
                0,
                0,
                1,
                pipeline.binding.vulkan.descriptorSet
            )
    } else if (succeeded) succeeded = false
    if (succeeded) succeeded = this.finishRenderTarget(target)
    succeeded
}

trusted fun GraphicsApplication.renderPushToTarget(
    var target: GraphicsRenderTarget,
    pipeline: GraphicsRenderPipeline,
    constants: GraphicsPushConstants,
    clear: Color
): bool {
    var succeeded = this.valid() && target.valid() && pipeline.valid() &&
        constants.valid() &&
        constants.layout.matches(pipeline.pushConstantLayout) &&
        clear.valid() && target.backend == this.backend &&
        pipeline.backend == this.backend && pipeline.targetHandle != 0 &&
        pipeline.targetWidth == target.texture.descriptor.size.width &&
        pipeline.targetHeight == target.texture.descriptor.size.height &&
        pipeline.targetColorCount == target.colorCount() &&
        !pipeline.vertexLayout.buffered() &&
        pipeline.depth.enabled == target.hasDepth()
    if (succeeded && this.backend == graphicsBackendOpenGl) {
        succeeded = pipeline.targetHandle == target.openGl.handle &&
            this.openGl.renderProgramTarget(
                target.openGl,
                pipeline.openGl,
                clear.red,
                clear.green,
                clear.blue,
                clear.alpha,
                pipeline.raster,
                pipeline.depth,
                pipeline.vertexLayout,
                0,
                3,
                0,
                0,
                1,
                pipeline.binding.openGlKinds,
                pipeline.binding.openGlBindings,
                pipeline.binding.openGlResources,
                pipeline.binding.openGlOffsets,
                pipeline.binding.openGlSizes,
                pipeline.binding.openGlSamplers,
                0,
                false,
                nativeNullPointer(),
                -1,
                0,
                0,
                constants.bytes.storage.address,
                constants.layout.size
            )
    } else if (succeeded && this.backend == graphicsBackendVulkan) {
        succeeded = pipeline.targetHandle == target.vulkan.framebuffer &&
            this.vulkanDevice.renderTargetProgram(
                target.vulkan,
                pipeline.vulkan,
                clear.red,
                clear.green,
                clear.blue,
                clear.alpha,
                0,
                3,
                0,
                0,
                1,
                pipeline.binding.vulkan.descriptorSet,
                0,
                false,
                nativeNullPointer(),
                0,
                constants.bytes.storage.address,
                constants.layout.size
            )
    } else if (succeeded) succeeded = false
    if (succeeded) succeeded = this.finishRenderTarget(target)
    succeeded
}

trusted fun GraphicsApplication.renderPassToTarget(
    var target: GraphicsRenderTarget,
    pipeline: GraphicsRenderPipeline,
    pass: GraphicsRenderPass
): bool {
    var succeeded = this.renderPassMatchesTarget(
        target,
        pipeline,
        pass,
        false
    )
    if (succeeded && this.backend == graphicsBackendOpenGl) {
        succeeded = pipeline.targetHandle == target.openGl.handle &&
            this.openGl.renderProgramTarget(
                target.openGl,
                pipeline.openGl,
                pass.red,
                pass.green,
                pass.blue,
                pass.alpha,
                pipeline.raster,
                pipeline.depth,
                pipeline.vertexLayout,
                0,
                3,
                0,
                0,
                1,
                pipeline.binding.openGlKinds,
                pipeline.binding.openGlBindings,
                pipeline.binding.openGlResources,
                pipeline.binding.openGlOffsets,
                pipeline.binding.openGlSizes,
                pipeline.binding.openGlSamplers,
                0,
                false,
                pass.clearAddress,
                pass.clearMask,
                pass.discardBeforeMask,
                pass.discardAfterMask
            )
    } else if (succeeded && this.backend == graphicsBackendVulkan) {
        succeeded = pipeline.targetHandle == target.vulkan.framebuffer &&
            this.vulkanDevice.renderTargetProgram(
                target.vulkan,
                pipeline.vulkan,
                pass.red,
                pass.green,
                pass.blue,
                pass.alpha,
                0,
                3,
                0,
                0,
                1,
                pipeline.binding.vulkan.descriptorSet,
                0,
                false,
                pass.clearAddress,
                pass.vulkan.handle
            )
    } else if (succeeded) succeeded = false
    if (succeeded) succeeded = this.finishRenderTarget(target)
    succeeded
}

trusted fun GraphicsApplication.renderPushPassToTarget(
    var target: GraphicsRenderTarget,
    pipeline: GraphicsRenderPipeline,
    constants: GraphicsPushConstants,
    pass: GraphicsRenderPass
): bool {
    var succeeded = constants.valid() &&
        constants.layout.matches(pipeline.pushConstantLayout) &&
        this.renderPassMatchesTarget(target, pipeline, pass, false)
    if (succeeded && this.backend == graphicsBackendOpenGl) {
        succeeded = pipeline.targetHandle == target.openGl.handle &&
            this.openGl.renderProgramTarget(
                target.openGl,
                pipeline.openGl,
                pass.red,
                pass.green,
                pass.blue,
                pass.alpha,
                pipeline.raster,
                pipeline.depth,
                pipeline.vertexLayout,
                0,
                3,
                0,
                0,
                1,
                pipeline.binding.openGlKinds,
                pipeline.binding.openGlBindings,
                pipeline.binding.openGlResources,
                pipeline.binding.openGlOffsets,
                pipeline.binding.openGlSizes,
                pipeline.binding.openGlSamplers,
                0,
                false,
                pass.clearAddress,
                pass.clearMask,
                pass.discardBeforeMask,
                pass.discardAfterMask,
                constants.bytes.storage.address,
                constants.layout.size
            )
    } else if (succeeded && this.backend == graphicsBackendVulkan) {
        succeeded = pipeline.targetHandle == target.vulkan.framebuffer &&
            this.vulkanDevice.renderTargetProgram(
                target.vulkan,
                pipeline.vulkan,
                pass.red,
                pass.green,
                pass.blue,
                pass.alpha,
                0,
                3,
                0,
                0,
                1,
                pipeline.binding.vulkan.descriptorSet,
                0,
                false,
                pass.clearAddress,
                pass.vulkan.handle,
                constants.bytes.storage.address,
                constants.layout.size
            )
    } else if (succeeded) succeeded = false
    if (succeeded) succeeded = this.finishRenderTarget(target)
    succeeded
}

trusted fun GraphicsApplication.renderSubpassesToTarget(
    var target: GraphicsRenderTarget,
    sequence: GraphicsSubpassPipelineSequence,
    pass: GraphicsRenderPass
): bool {
    var succeeded = sequence.valid() && pass.valid() &&
        sequence.backend == this.backend &&
        sequence.targetHandle == pass.targetHandle &&
        sequence.pipelines.size == pass.subpassCount &&
        (this.backend != graphicsBackendVulkan ||
         sequence.renderPassHandle == pass.vulkan.handle)
    var pipelineIndex = 0
    while (succeeded && pipelineIndex < sequence.pipelines.size) {
        val pipeline = sequence.pipelines[pipelineIndex]
        succeeded = this.renderPassMatchesTarget(
            target,
            pipeline,
            pass,
            false,
            pipelineIndex
        ) && pipeline.pushConstantLayout.size == 0 &&
            (this.backend != graphicsBackendVulkan ||
            pipeline.vulkan.renderPass == pass.vulkan.handle)
        pipelineIndex = pipelineIndex + 1
    }
    if (succeeded && this.backend == graphicsBackendOpenGl) {
        pipelineIndex = 0
        while (succeeded && pipelineIndex < sequence.pipelines.size) {
            val pipeline = sequence.pipelines[pipelineIndex]
            succeeded = this.openGl.renderProgramTarget(
                target.openGl,
                pipeline.openGl,
                pass.red,
                pass.green,
                pass.blue,
                pass.alpha,
                pipeline.raster,
                pipeline.depth,
                pipeline.vertexLayout,
                0,
                3,
                0,
                0,
                1,
                pipeline.binding.openGlKinds,
                pipeline.binding.openGlBindings,
                pipeline.binding.openGlResources,
                pipeline.binding.openGlOffsets,
                pipeline.binding.openGlSizes,
                pipeline.binding.openGlSamplers,
                0,
                false,
                pass.clearAddress,
                if (pipelineIndex == 0) pass.clearMask else 0,
                if (pipelineIndex == 0) pass.discardBeforeMask else 0,
                if (pipelineIndex + 1 == sequence.pipelines.size)
                    pass.discardAfterMask else 0
            )
            pipelineIndex = pipelineIndex + 1
        }
    } else if (succeeded && this.backend == graphicsBackendVulkan) {
        succeeded = this.vulkanDevice.renderTargetSubpasses(
            target.vulkan,
            pass.vulkan.handle,
            pass.vulkan.framebuffer,
            sequence.vulkanHandles,
            sequence.vulkanLayouts,
            sequence.vulkanDepthEnabled,
            sequence.vulkanRequiresBinding,
            sequence.vulkanDescriptorSets,
            pass.clearAddress,
            vulkanNoSubpassPushConstants,
            vulkanNoSubpassPushConstants,
            vulkanNoSubpassPushConstants,
            nativeNullPointer(),
            0
        )
    } else if (succeeded) succeeded = false
    if (succeeded) succeeded = this.finishRenderTarget(target)
    succeeded
}

trusted fun GraphicsApplication.renderPushSubpassesToTarget(
    var target: GraphicsRenderTarget,
    sequence: GraphicsSubpassPipelineSequence,
    constants: GraphicsSubpassPushConstants,
    pass: GraphicsRenderPass
): bool {
    var succeeded = sequence.valid() && constants.valid() && pass.valid() &&
        sequence.backend == this.backend &&
        sequence.targetHandle == pass.targetHandle &&
        sequence.pipelines.size == pass.subpassCount &&
        constants.subpassCount() == sequence.pipelines.size &&
        (this.backend != graphicsBackendVulkan ||
         sequence.renderPassHandle == pass.vulkan.handle)
    var pipelineIndex = 0
    while (succeeded && pipelineIndex < sequence.pipelines.size) {
        val pipeline = sequence.pipelines[pipelineIndex]
        succeeded = this.renderPassMatchesTarget(
            target,
            pipeline,
            pass,
            false,
            pipelineIndex
        ) && constants.layouts[pipelineIndex].matches(
            pipeline.pushConstantLayout
        ) && (this.backend != graphicsBackendVulkan ||
            pipeline.vulkan.renderPass == pass.vulkan.handle)
        pipelineIndex = pipelineIndex + 1
    }
    if (succeeded && this.backend == graphicsBackendOpenGl) {
        pipelineIndex = 0
        while (succeeded && pipelineIndex < sequence.pipelines.size) {
            val pipeline = sequence.pipelines[pipelineIndex]
            succeeded = this.openGl.renderProgramTarget(
                target.openGl,
                pipeline.openGl,
                pass.red,
                pass.green,
                pass.blue,
                pass.alpha,
                pipeline.raster,
                pipeline.depth,
                pipeline.vertexLayout,
                0,
                3,
                0,
                0,
                1,
                pipeline.binding.openGlKinds,
                pipeline.binding.openGlBindings,
                pipeline.binding.openGlResources,
                pipeline.binding.openGlOffsets,
                pipeline.binding.openGlSizes,
                pipeline.binding.openGlSamplers,
                0,
                false,
                pass.clearAddress,
                if (pipelineIndex == 0) pass.clearMask else 0,
                if (pipelineIndex == 0) pass.discardBeforeMask else 0,
                if (pipelineIndex + 1 == sequence.pipelines.size)
                    pass.discardAfterMask else 0,
                constants.bytes.storage.pointerAt(
                    constants.offsets[pipelineIndex]
                ),
                constants.sizes[pipelineIndex]
            )
            pipelineIndex = pipelineIndex + 1
        }
    } else if (succeeded && this.backend == graphicsBackendVulkan) {
        succeeded = this.vulkanDevice.renderTargetSubpasses(
            target.vulkan,
            pass.vulkan.handle,
            pass.vulkan.framebuffer,
            sequence.vulkanHandles,
            sequence.vulkanLayouts,
            sequence.vulkanDepthEnabled,
            sequence.vulkanRequiresBinding,
            sequence.vulkanDescriptorSets,
            pass.clearAddress,
            constants.offsets,
            constants.sizes,
            constants.stageMasks,
            constants.bytes.storage.address,
            constants.bytes.size
        )
    } else if (succeeded) succeeded = false
    if (succeeded) succeeded = this.finishRenderTarget(target)
    succeeded
}

trusted fun GraphicsApplication.subpassPipelines(
    target: GraphicsRenderTarget,
    pass: GraphicsRenderPass,
    own pipelines: array<GraphicsRenderPipeline>
): GraphicsSubpassPipelineSequence {
    val handles: array<int> = []
    val layouts: array<int> = []
    val depthEnabled: array<bool> = []
    val requiresBinding: array<bool> = []
    val descriptorSets: array<int> = []
    var valid = this.valid() && target.valid() && pass.valid() &&
        target.backend == this.backend && pass.backend == this.backend &&
        pipelines.size == pass.subpassCount && pipelines.size >= 2 &&
        pipelines.size <= 8
    var pipelineIndex = 0
    while (valid && pipelineIndex < pipelines.size) {
        val pipeline = pipelines[pipelineIndex]
        valid = this.renderPassMatchesTarget(
            target,
            pipeline,
            pass,
            false,
            pipelineIndex
        ) && (this.backend != graphicsBackendVulkan ||
            pipeline.vulkan.renderPass == pass.vulkan.handle)
        if (valid && this.backend == graphicsBackendVulkan) {
            handles.append(pipeline.vulkan.handle)
            layouts.append(pipeline.vulkan.layout)
            depthEnabled.append(pipeline.vulkan.depthEnabled)
            requiresBinding.append(pipeline.vulkan.requiresBinding)
            descriptorSets.append(pipeline.binding.vulkan.descriptorSet)
        }
        pipelineIndex = pipelineIndex + 1
    }
    GraphicsSubpassPipelineSequence(
        move(pipelines),
        handles,
        layouts,
        depthEnabled,
        requiresBinding,
        descriptorSets,
        this.backend,
        if (valid) pass.targetHandle else 0,
        if (valid && this.backend == graphicsBackendVulkan)
            pass.vulkan.handle else 0,
        if (valid) GraphicsError() else GraphicsError(
            graphicsErrorInvalidConfiguration,
            "GraphicsApplication.subpassPipelines",
            "subpass pipelines must match the target, pass, backend, and order"
        )
    )
}

trusted fun GraphicsApplication.renderPassMatchesTarget(
    target: GraphicsRenderTarget,
    pipeline: GraphicsRenderPipeline,
    pass: GraphicsRenderPass,
    buffered: bool,
    subpassIndex: int = 0
): bool = this.valid() && target.valid() && pipeline.valid() &&
    pass.valid() && pass.backend == this.backend &&
    target.backend == this.backend && pipeline.backend == this.backend &&
    pipeline.targetHandle != 0 &&
    pass.targetHandle == pipeline.targetHandle &&
    pass.width == target.texture.descriptor.size.width &&
    pass.height == target.texture.descriptor.size.height &&
    pass.colorCount == target.colorCount() &&
    pass.hasDepth == target.hasDepth() &&
    pipeline.targetWidth == target.texture.descriptor.size.width &&
    pipeline.targetHeight == target.texture.descriptor.size.height &&
    pipeline.targetColorCount == target.colorCount() &&
    pipeline.targetSubpass == subpassIndex &&
    pipeline.vertexLayout.buffered() == buffered &&
    pipeline.depth.enabled == target.hasDepth()

trusted fun GraphicsApplication.renderVerticesToTarget(
    var target: GraphicsRenderTarget,
    pipeline: GraphicsRenderPipeline,
    vertices: GraphicsBuffer,
    vertexCount: int,
    clear: Color,
    instanceCount: int = 1
): bool {
    val stride = pipeline.vertexLayout.stride
    var succeeded = this.valid() && target.valid() && pipeline.valid() &&
        vertices.valid() && clear.valid() && target.backend == this.backend &&
        pipeline.backend == this.backend && pipeline.targetHandle != 0 &&
        pipeline.targetWidth == target.texture.descriptor.size.width &&
        pipeline.targetHeight == target.texture.descriptor.size.height &&
        pipeline.targetColorCount == target.colorCount() &&
        stride > 0 && vertexCount > 0 && instanceCount > 0 &&
        vertexCount <= vertices.descriptor.size / stride &&
        this.ownsBuffer(vertices) &&
        (vertices.descriptor.usage & bufferUsageVertex) != 0 &&
        pipeline.depth.enabled == target.hasDepth()
    if (succeeded && this.backend == graphicsBackendOpenGl) {
        succeeded = pipeline.targetHandle == target.openGl.handle &&
            this.openGl.renderProgramTarget(
                target.openGl,
                pipeline.openGl,
                clear.red,
                clear.green,
                clear.blue,
                clear.alpha,
                pipeline.raster,
                pipeline.depth,
                pipeline.vertexLayout,
                vertices.openGl.handle,
                vertexCount,
                0,
                0,
                instanceCount,
                pipeline.binding.openGlKinds,
                pipeline.binding.openGlBindings,
                pipeline.binding.openGlResources,
                pipeline.binding.openGlOffsets,
                pipeline.binding.openGlSizes,
                pipeline.binding.openGlSamplers
            )
    } else if (succeeded && this.backend == graphicsBackendVulkan) {
        succeeded = pipeline.targetHandle == target.vulkan.framebuffer &&
            this.vulkanDevice.renderTargetProgram(
                target.vulkan,
                pipeline.vulkan,
                clear.red,
                clear.green,
                clear.blue,
                clear.alpha,
                vertices.vulkan.handle,
                vertexCount,
                0,
                0,
                instanceCount,
                pipeline.binding.vulkan.descriptorSet
            )
    } else if (succeeded) succeeded = false
    if (succeeded) succeeded = this.finishRenderTarget(target)
    succeeded
}

