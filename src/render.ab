// Backend-neutral triangle render pipeline and allocation-free presentation.

import "abla/unsafe/memory"
import "core.ab"
import "application.ab"
import "buffer.ab"
import "binding.ab"
import "target.ab"
import "shader/glsl.ab"
import "shader/glsl_spirv.ab"
import "driver/opengl.ab"
import "driver/vulkan.ab"

resource class GraphicsRenderPipeline(
    val openGl: OpenGlProgram,
    var vulkan: VulkanRenderPipeline,
    val backend: int,
    val vertexLayout: VertexBufferLayout,
    val raster: RasterPipelineState,
    val depth: DepthStencilState,
    val shader: ShaderPackage,
    val binding: GraphicsBindGroup,
    val targetHandle: int,
    val targetWidth: int,
    val targetHeight: int,
    val targetFormat: int,
    val targetColorCount: int,
    val error: GraphicsError
) {
    fun valid(): bool = !this.error.occurred() && this.vertexLayout.valid() &&
        this.raster.valid() && this.depth.valid() && this.shader.valid &&
        (this.binding.empty() || this.binding.valid()) &&
        ((this.backend == graphicsBackendOpenGl && this.openGl.valid()) ||
         (this.backend == graphicsBackendVulkan && this.vulkan.valid()))

    trusted fun drop(): void {
        this.openGl.drop()
        this.vulkan.drop()
        this.binding.drop()
        return
    }
}

trusted fun GraphicsApplication.renderPipeline(
    shader: ShaderPackage,
    vertexLayout: VertexBufferLayout = VertexBufferLayout(),
    raster: RasterPipelineState = RasterPipelineState(),
    depth: DepthStencilState = DepthStencilState(),
    own binding: GraphicsBindGroup = emptyGraphicsBindGroup(),
    targetHandle: int = 0,
    targetRenderPass: int = 0,
    targetView: int = 0,
    targetFormat: int = 0,
    targetWidth: int = 0,
    targetHeight: int = 0,
    targetDepthView: int = 0,
    targetColorCount: int = 1,
    targetSamples: int = 1
): GraphicsRenderPipeline {
    var openGl = OpenGlProgram(0, 0, "")
    var vulkan = VulkanRenderPipeline(
        nativeNullPointer(),
        nativeNullPointer(),
        0,
        0,
        0,
        [],
        [],
        [],
        [],
        0,
        0,
        0,
        0,
        false,
        false,
        false,
        false
    )
    var error = GraphicsError()
    val stagesValid = shader.valid && shader.stages.size == 2 &&
        shader.source(shaderStageVertex) != "" &&
        shader.source(shaderStageFragment) != ""
    val offscreen = targetHandle != 0
    val targetValid = (!offscreen && targetRenderPass == 0 &&
        targetView == 0 && targetFormat == 0 && targetDepthView == 0 &&
        targetWidth == 0 && targetHeight == 0 && targetSamples == 1) ||
        (offscreen && targetWidth > 0 && targetHeight > 0 &&
         (targetSamples == 1 || targetSamples == 2 || targetSamples == 4 ||
          targetSamples == 8 || targetSamples == 16) &&
         ((this.backend == graphicsBackendOpenGl &&
           targetRenderPass == 0 && targetView == 0) ||
          (this.backend == graphicsBackendVulkan &&
           targetRenderPass != 0 && targetView != 0 && targetFormat != 0)))
    var vertexInputCount = 0
    var fragmentOutputCount = 0
    var fragmentOutputsContiguous = true
    var vertexInputValid = true
    var locationIndex = 0
    while (locationIndex < shader.locations.size) {
        val location = shader.locations[locationIndex]
        if (location.stage == shaderStageVertex &&
            location.direction == "in") {
            vertexInputCount = vertexInputCount + 1
            var matched = false
            if (vertexLayout.attributes.size == 0) {
                matched = location.location == 0 &&
                    location.dataType == "vec2"
            } else {
                var attributeIndex = 0
                while (!matched &&
                    attributeIndex < vertexLayout.attributes.size) {
                    val attribute = vertexLayout.attributes[attributeIndex]
                    matched = attribute.location == location.location &&
                        vertexFormatGlslType(attribute.format) ==
                            location.dataType
                    attributeIndex = attributeIndex + 1
                }
            }
            vertexInputValid = vertexInputValid && matched &&
                location.arraySize == 1
        } else if (location.stage == shaderStageFragment &&
            location.direction == "out") {
            fragmentOutputsContiguous = fragmentOutputsContiguous &&
                location.location == fragmentOutputCount &&
                location.arraySize == 1
            fragmentOutputCount = fragmentOutputCount + 1
        }
        locationIndex = locationIndex + 1
    }
    val layoutMatches = vertexLayout.valid() && raster.valid() &&
        depth.valid() &&
        targetColorCount >= 1 && targetColorCount <= 8 &&
        fragmentOutputCount == targetColorCount &&
        fragmentOutputsContiguous &&
        ((vertexLayout.buffered() &&
          vertexInputCount == vertexLayout.attributeCount() &&
          vertexInputValid) ||
         (!vertexLayout.buffered() && vertexInputCount == 0))
    val shaderBindingMatches =
        (shader.bindings.size == 0 && binding.empty()) ||
        (binding.valid() && binding.matches(shader.bindings))
    val translatable = glslPackage(
        [shaderStageVertex, shaderStageFragment],
        [
            shader.source(shaderStageVertex),
            shader.source(shaderStageFragment)
        ]
    )
    val vertexCode = translatable.spirv(shaderStageVertex)
    val fragmentCode = translatable.spirv(shaderStageFragment)

    if (!this.valid() || !stagesValid || !layoutMatches || !targetValid ||
        !shaderBindingMatches) {
        error = GraphicsError(
            graphicsErrorInvalidConfiguration,
            "GraphicsApplication.renderPipeline",
            if (shader.error != "") shader.error else
                "rendering requires matching vertex/fragment stages and vertex layout"
        )
    } else if (!vertexCode.succeeded || !fragmentCode.succeeded) {
        error = GraphicsError(
            graphicsErrorUnsupportedFeature,
            "ShaderPackage.spirv",
            if (!vertexCode.succeeded) vertexCode.error else
                fragmentCode.error
        )
    } else if (this.backend == graphicsBackendOpenGl) {
        if (this.openGl.makeCurrent()) {
            openGl = openGlProgramFromPackage(shader)
        }
        if (!openGl.valid()) error = GraphicsError(
            graphicsErrorDriverFailure,
            "openGlProgramFromPackage",
            if (openGl.error != "") openGl.error else
                "OpenGL render pipeline creation failed"
        )
    } else if (this.backend == graphicsBackendVulkan) {
        val vertex = this.vulkanDevice.shaderModule(vertexCode.module)
        val fragment = this.vulkanDevice.shaderModule(fragmentCode.module)
        if (vertex.valid() && fragment.valid()) {
            vulkan = this.vulkanDevice.renderPipeline(
                this.vulkanSwapchain,
                vertex,
                fragment,
                vertexLayout,
                raster.topology,
                raster.cullMode,
                raster.frontFace,
                raster.alphaBlend,
                depth.enabled,
                depth.write,
                depth.compare,
                if (binding.valid()) binding.vulkan.descriptorSetLayout else 0,
                targetRenderPass,
                targetView,
                targetHandle,
                targetFormat,
                targetWidth,
                targetHeight,
                targetDepthView,
                targetColorCount,
                targetSamples
            )
        }
        if (!vulkan.valid()) error = GraphicsError(
            graphicsErrorDriverFailure,
            "VulkanDevice.renderPipeline",
            "Vulkan render pipeline creation failed"
        )
    }

    GraphicsRenderPipeline(
        move(openGl),
        move(vulkan),
        this.backend,
        vertexLayout,
        raster,
        depth,
        shader,
        move(binding),
        targetHandle,
        targetWidth,
        targetHeight,
        targetFormat,
        targetColorCount,
        error
    )
}

trusted fun GraphicsApplication.renderTargetPipeline(
    target: GraphicsRenderTarget,
    shader: ShaderPackage,
    vertexLayout: VertexBufferLayout = VertexBufferLayout(),
    raster: RasterPipelineState = RasterPipelineState(),
    depth: DepthStencilState = DepthStencilState(),
    own binding: GraphicsBindGroup = emptyGraphicsBindGroup()
): GraphicsRenderPipeline {
    if (!target.valid() || target.backend != this.backend) {
        this.renderPipeline(
            shader,
            vertexLayout,
            raster,
            depth,
            move(binding),
            -1
        )
    } else this.renderPipeline(
        shader,
        vertexLayout,
        raster,
        depth,
        move(binding),
        if (this.backend == graphicsBackendOpenGl) target.openGl.handle
        else target.vulkan.framebuffer,
        if (this.backend == graphicsBackendVulkan) target.vulkan.renderPass
        else 0,
        if (this.backend == graphicsBackendVulkan) target.vulkan.view else 0,
        if (this.backend == graphicsBackendVulkan) target.vulkan.format else 0,
        target.texture.descriptor.size.width,
        target.texture.descriptor.size.height,
        if (this.backend == graphicsBackendVulkan)
            target.vulkan.depthView else 0,
        target.colorCount(),
        target.texture.descriptor.samples
    )
}

trusted fun GraphicsApplication.renderToTarget(
    var target: GraphicsRenderTarget,
    pipeline: GraphicsRenderPipeline,
    clear: Color
): bool {
    var succeeded = this.valid() && target.valid() && pipeline.valid() &&
        clear.valid() && target.backend == this.backend &&
        pipeline.backend == this.backend && pipeline.targetHandle != 0 &&
        pipeline.targetWidth == target.texture.descriptor.size.width &&
        pipeline.targetHeight == target.texture.descriptor.size.height &&
        pipeline.targetColorCount == target.colorCount() &&
        !pipeline.vertexLayout.buffered() &&
        pipeline.depth.enabled == target.hasDepth()
    if (succeeded && this.backend == graphicsBackendOpenGl) {
        succeeded = pipeline.targetHandle == target.openGl.handle &&
            this.openGl.renderProgramTarget(
                target.openGl,
                pipeline.openGl,
                clear.red,
                clear.green,
                clear.blue,
                clear.alpha,
                pipeline.raster,
                pipeline.depth,
                pipeline.vertexLayout,
                0,
                3,
                0,
                0,
                1,
                pipeline.binding.openGlKinds,
                pipeline.binding.openGlBindings,
                pipeline.binding.openGlResources,
                pipeline.binding.openGlSamplers
            )
    } else if (succeeded && this.backend == graphicsBackendVulkan) {
        succeeded = pipeline.targetHandle == target.vulkan.framebuffer &&
            this.vulkanDevice.renderTargetProgram(
                target.vulkan,
                pipeline.vulkan,
                clear.red,
                clear.green,
                clear.blue,
                clear.alpha,
                0,
                3,
                0,
                0,
                1,
                pipeline.binding.vulkan.descriptorSet
            )
        if (succeeded) target.storeVulkanLayouts()
    } else if (succeeded) succeeded = false
    succeeded
}

trusted fun GraphicsApplication.renderPassToTarget(
    var target: GraphicsRenderTarget,
    pipeline: GraphicsRenderPipeline,
    pass: GraphicsRenderPass
): bool {
    var succeeded = this.renderPassMatchesTarget(
        target,
        pipeline,
        pass,
        false
    )
    if (succeeded && this.backend == graphicsBackendOpenGl) {
        succeeded = pipeline.targetHandle == target.openGl.handle &&
            this.openGl.renderProgramTarget(
                target.openGl,
                pipeline.openGl,
                pass.red,
                pass.green,
                pass.blue,
                pass.alpha,
                pipeline.raster,
                pipeline.depth,
                pipeline.vertexLayout,
                0,
                3,
                0,
                0,
                1,
                pipeline.binding.openGlKinds,
                pipeline.binding.openGlBindings,
                pipeline.binding.openGlResources,
                pipeline.binding.openGlSamplers,
                0,
                false,
                pass.clearAddress,
                pass.clearMask,
                pass.discardBeforeMask,
                pass.discardAfterMask
            )
    } else if (succeeded && this.backend == graphicsBackendVulkan) {
        succeeded = pipeline.targetHandle == target.vulkan.framebuffer &&
            this.vulkanDevice.renderTargetProgram(
                target.vulkan,
                pipeline.vulkan,
                pass.red,
                pass.green,
                pass.blue,
                pass.alpha,
                0,
                3,
                0,
                0,
                1,
                pipeline.binding.vulkan.descriptorSet,
                0,
                false,
                pass.clearAddress,
                pass.vulkan.handle
            )
        if (succeeded) target.storeVulkanLayouts()
    } else if (succeeded) succeeded = false
    succeeded
}

trusted fun GraphicsApplication.renderPassMatchesTarget(
    target: GraphicsRenderTarget,
    pipeline: GraphicsRenderPipeline,
    pass: GraphicsRenderPass,
    buffered: bool
): bool = this.valid() && target.valid() && pipeline.valid() &&
    pass.valid() && pass.backend == this.backend &&
    target.backend == this.backend && pipeline.backend == this.backend &&
    pipeline.targetHandle != 0 &&
    pass.targetHandle == pipeline.targetHandle &&
    pass.width == target.texture.descriptor.size.width &&
    pass.height == target.texture.descriptor.size.height &&
    pass.colorCount == target.colorCount() &&
    pass.hasDepth == target.hasDepth() &&
    pipeline.targetWidth == target.texture.descriptor.size.width &&
    pipeline.targetHeight == target.texture.descriptor.size.height &&
    pipeline.targetColorCount == target.colorCount() &&
    pipeline.vertexLayout.buffered() == buffered &&
    pipeline.depth.enabled == target.hasDepth()

trusted fun GraphicsApplication.renderVerticesToTarget(
    var target: GraphicsRenderTarget,
    pipeline: GraphicsRenderPipeline,
    vertices: GraphicsBuffer,
    vertexCount: int,
    clear: Color,
    instanceCount: int = 1
): bool {
    val stride = pipeline.vertexLayout.stride
    var succeeded = this.valid() && target.valid() && pipeline.valid() &&
        vertices.valid() && clear.valid() && target.backend == this.backend &&
        pipeline.backend == this.backend && pipeline.targetHandle != 0 &&
        pipeline.targetWidth == target.texture.descriptor.size.width &&
        pipeline.targetHeight == target.texture.descriptor.size.height &&
        pipeline.targetColorCount == target.colorCount() &&
        stride > 0 && vertexCount > 0 && instanceCount > 0 &&
        vertexCount <= vertices.descriptor.size / stride &&
        this.ownsBuffer(vertices) &&
        (vertices.descriptor.usage & bufferUsageVertex) != 0 &&
        pipeline.depth.enabled == target.hasDepth()
    if (succeeded && this.backend == graphicsBackendOpenGl) {
        succeeded = pipeline.targetHandle == target.openGl.handle &&
            this.openGl.renderProgramTarget(
                target.openGl,
                pipeline.openGl,
                clear.red,
                clear.green,
                clear.blue,
                clear.alpha,
                pipeline.raster,
                pipeline.depth,
                pipeline.vertexLayout,
                vertices.openGl.handle,
                vertexCount,
                0,
                0,
                instanceCount,
                pipeline.binding.openGlKinds,
                pipeline.binding.openGlBindings,
                pipeline.binding.openGlResources,
                pipeline.binding.openGlSamplers
            )
    } else if (succeeded && this.backend == graphicsBackendVulkan) {
        succeeded = pipeline.targetHandle == target.vulkan.framebuffer &&
            this.vulkanDevice.renderTargetProgram(
                target.vulkan,
                pipeline.vulkan,
                clear.red,
                clear.green,
                clear.blue,
                clear.alpha,
                vertices.vulkan.handle,
                vertexCount,
                0,
                0,
                instanceCount,
                pipeline.binding.vulkan.descriptorSet
            )
        if (succeeded) target.storeVulkanLayouts()
    } else if (succeeded) succeeded = false
    succeeded
}

trusted fun GraphicsApplication.renderIndexedToTarget(
    var target: GraphicsRenderTarget,
    pipeline: GraphicsRenderPipeline,
    vertices: GraphicsBuffer,
    indices: GraphicsBuffer,
    indexCount: int,
    clear: Color,
    instanceCount: int = 1
): bool {
    val stride = pipeline.vertexLayout.stride
    var succeeded = this.valid() && target.valid() && pipeline.valid() &&
        vertices.valid() && indices.valid() && clear.valid() &&
        target.backend == this.backend && pipeline.backend == this.backend &&
        pipeline.targetHandle != 0 &&
        pipeline.targetWidth == target.texture.descriptor.size.width &&
        pipeline.targetHeight == target.texture.descriptor.size.height &&
        pipeline.targetColorCount == target.colorCount() &&
        stride > 0 && vertices.descriptor.size / stride > 0 &&
        indexCount > 0 && instanceCount > 0 &&
        indexCount <= indices.descriptor.size / 4 &&
        this.ownsBuffer(vertices) && this.ownsBuffer(indices) &&
        (vertices.descriptor.usage & bufferUsageVertex) != 0 &&
        (indices.descriptor.usage & bufferUsageIndex) != 0 &&
        pipeline.depth.enabled == target.hasDepth()
    if (succeeded && this.backend == graphicsBackendOpenGl) {
        succeeded = pipeline.targetHandle == target.openGl.handle &&
            this.openGl.renderProgramTarget(
                target.openGl,
                pipeline.openGl,
                clear.red,
                clear.green,
                clear.blue,
                clear.alpha,
                pipeline.raster,
                pipeline.depth,
                pipeline.vertexLayout,
                vertices.openGl.handle,
                vertices.descriptor.size / stride,
                indices.openGl.handle,
                indexCount,
                instanceCount,
                pipeline.binding.openGlKinds,
                pipeline.binding.openGlBindings,
                pipeline.binding.openGlResources,
                pipeline.binding.openGlSamplers
            )
    } else if (succeeded && this.backend == graphicsBackendVulkan) {
        succeeded = pipeline.targetHandle == target.vulkan.framebuffer &&
            this.vulkanDevice.renderTargetProgram(
                target.vulkan,
                pipeline.vulkan,
                clear.red,
                clear.green,
                clear.blue,
                clear.alpha,
                vertices.vulkan.handle,
                vertices.descriptor.size / stride,
                indices.vulkan.handle,
                indexCount,
                instanceCount,
                pipeline.binding.vulkan.descriptorSet
            )
        if (succeeded) target.storeVulkanLayouts()
    } else if (succeeded) succeeded = false
    succeeded
}

trusted fun GraphicsApplication.renderVerticesIndirectToTarget(
    var target: GraphicsRenderTarget,
    pipeline: GraphicsRenderPipeline,
    vertices: GraphicsBuffer,
    indirect: GraphicsBuffer,
    clear: Color
): bool {
    val stride = pipeline.vertexLayout.stride
    var succeeded = this.valid() && target.valid() && pipeline.valid() &&
        vertices.valid() && indirect.valid() && clear.valid() &&
        target.backend == this.backend && pipeline.backend == this.backend &&
        pipeline.targetHandle != 0 &&
        pipeline.targetWidth == target.texture.descriptor.size.width &&
        pipeline.targetHeight == target.texture.descriptor.size.height &&
        pipeline.targetColorCount == target.colorCount() &&
        stride > 0 && vertices.descriptor.size / stride > 0 &&
        indirect.descriptor.size >= 16 &&
        this.ownsBuffer(vertices) && this.ownsBuffer(indirect) &&
        (vertices.descriptor.usage & bufferUsageVertex) != 0 &&
        (indirect.descriptor.usage & bufferUsageIndirect) != 0 &&
        pipeline.depth.enabled == target.hasDepth()
    if (succeeded && this.backend == graphicsBackendOpenGl) {
        succeeded = pipeline.targetHandle == target.openGl.handle &&
            this.openGl.renderProgramTarget(
                target.openGl,
                pipeline.openGl,
                clear.red,
                clear.green,
                clear.blue,
                clear.alpha,
                pipeline.raster,
                pipeline.depth,
                pipeline.vertexLayout,
                vertices.openGl.handle,
                1,
                0,
                0,
                1,
                pipeline.binding.openGlKinds,
                pipeline.binding.openGlBindings,
                pipeline.binding.openGlResources,
                pipeline.binding.openGlSamplers,
                indirect.openGl.handle
            )
    } else if (succeeded && this.backend == graphicsBackendVulkan) {
        succeeded = pipeline.targetHandle == target.vulkan.framebuffer &&
            this.vulkanDevice.renderTargetProgram(
                target.vulkan,
                pipeline.vulkan,
                clear.red,
                clear.green,
                clear.blue,
                clear.alpha,
                vertices.vulkan.handle,
                1,
                0,
                0,
                1,
                pipeline.binding.vulkan.descriptorSet,
                indirect.vulkan.handle
            )
        if (succeeded) target.storeVulkanLayouts()
    } else if (succeeded) succeeded = false
    succeeded
}

trusted fun GraphicsApplication.renderIndexedIndirectToTarget(
    var target: GraphicsRenderTarget,
    pipeline: GraphicsRenderPipeline,
    vertices: GraphicsBuffer,
    indices: GraphicsBuffer,
    indirect: GraphicsBuffer,
    clear: Color
): bool {
    val stride = pipeline.vertexLayout.stride
    var succeeded = this.valid() && target.valid() && pipeline.valid() &&
        vertices.valid() && indices.valid() && indirect.valid() &&
        clear.valid() && target.backend == this.backend &&
        pipeline.backend == this.backend && pipeline.targetHandle != 0 &&
        pipeline.targetWidth == target.texture.descriptor.size.width &&
        pipeline.targetHeight == target.texture.descriptor.size.height &&
        pipeline.targetColorCount == target.colorCount() &&
        stride > 0 && vertices.descriptor.size / stride > 0 &&
        indices.descriptor.size / 4 > 0 && indirect.descriptor.size >= 20 &&
        this.ownsBuffer(vertices) && this.ownsBuffer(indices) &&
        this.ownsBuffer(indirect) &&
        (vertices.descriptor.usage & bufferUsageVertex) != 0 &&
        (indices.descriptor.usage & bufferUsageIndex) != 0 &&
        (indirect.descriptor.usage & bufferUsageIndirect) != 0 &&
        pipeline.depth.enabled == target.hasDepth()
    if (succeeded && this.backend == graphicsBackendOpenGl) {
        succeeded = pipeline.targetHandle == target.openGl.handle &&
            this.openGl.renderProgramTarget(
                target.openGl,
                pipeline.openGl,
                clear.red,
                clear.green,
                clear.blue,
                clear.alpha,
                pipeline.raster,
                pipeline.depth,
                pipeline.vertexLayout,
                vertices.openGl.handle,
                1,
                indices.openGl.handle,
                0,
                1,
                pipeline.binding.openGlKinds,
                pipeline.binding.openGlBindings,
                pipeline.binding.openGlResources,
                pipeline.binding.openGlSamplers,
                indirect.openGl.handle,
                true
            )
    } else if (succeeded && this.backend == graphicsBackendVulkan) {
        succeeded = pipeline.targetHandle == target.vulkan.framebuffer &&
            this.vulkanDevice.renderTargetProgram(
                target.vulkan,
                pipeline.vulkan,
                clear.red,
                clear.green,
                clear.blue,
                clear.alpha,
                vertices.vulkan.handle,
                1,
                indices.vulkan.handle,
                0,
                1,
                pipeline.binding.vulkan.descriptorSet,
                indirect.vulkan.handle,
                true
            )
        if (succeeded) target.storeVulkanLayouts()
    } else if (succeeded) succeeded = false
    succeeded
}

