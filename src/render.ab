// Backend-neutral triangle render pipeline and allocation-free presentation.

import "abla/unsafe/memory"
import "core.ab"
import "application.ab"
import "buffer.ab"
import "shader/glsl.ab"
import "shader/glsl_spirv.ab"
import "driver/opengl.ab"
import "driver/vulkan.ab"

class VertexBufferLayout(val stride: int = 0) {
    fun valid(): bool = this.stride == 0 ||
        (this.stride >= 8 && this.stride <= 2048)
    fun buffered(): bool = this.stride > 0
}

resource class GraphicsRenderPipeline(
    val openGl: OpenGlProgram,
    var vulkan: VulkanRenderPipeline,
    val backend: int,
    val vertexLayout: VertexBufferLayout,
    val raster: RasterPipelineState,
    val shader: ShaderPackage,
    val error: GraphicsError
) {
    fun valid(): bool = !this.error.occurred() && this.vertexLayout.valid() &&
        this.raster.valid() && this.shader.valid &&
        ((this.backend == graphicsBackendOpenGl && this.openGl.valid()) ||
         (this.backend == graphicsBackendVulkan && this.vulkan.valid()))

    trusted fun drop(): void {
        this.openGl.drop()
        this.vulkan.drop()
        return
    }
}

trusted fun GraphicsApplication.renderPipeline(
    shader: ShaderPackage,
    vertexLayout: VertexBufferLayout = VertexBufferLayout(),
    raster: RasterPipelineState = RasterPipelineState()
): GraphicsRenderPipeline {
    var openGl = OpenGlProgram(0, 0, "")
    var vulkan = VulkanRenderPipeline(
        nativeNullPointer(),
        nativeNullPointer(),
        0,
        0,
        0,
        [],
        [],
        0,
        0,
        0,
        0
    )
    var error = GraphicsError()
    val stagesValid = shader.valid && shader.stages.size == 2 &&
        shader.source(shaderStageVertex) != "" &&
        shader.source(shaderStageFragment) != ""
    var vertexInputCount = 0
    var vertexInputValid = false
    var locationIndex = 0
    while (locationIndex < shader.locations.size) {
        val location = shader.locations[locationIndex]
        if (location.stage == shaderStageVertex &&
            location.direction == "in") {
            vertexInputCount = vertexInputCount + 1
            vertexInputValid = location.location == 0 &&
                location.dataType == "vec2" && location.arraySize == 1
        }
        locationIndex = locationIndex + 1
    }
    val layoutMatches = vertexLayout.valid() && raster.valid() &&
        ((vertexLayout.buffered() && vertexInputCount == 1 &&
          vertexInputValid) ||
         (!vertexLayout.buffered() && vertexInputCount == 0))
    val translatable = glslPackage(
        [shaderStageVertex, shaderStageFragment],
        [
            shader.source(shaderStageVertex),
            shader.source(shaderStageFragment)
        ]
    )
    val vertexCode = translatable.spirv(shaderStageVertex)
    val fragmentCode = translatable.spirv(shaderStageFragment)

    if (!this.valid() || !stagesValid || !layoutMatches) {
        error = GraphicsError(
            graphicsErrorInvalidConfiguration,
            "GraphicsApplication.renderPipeline",
            if (shader.error != "") shader.error else
                "rendering requires matching vertex/fragment stages and vertex layout"
        )
    } else if (!vertexCode.succeeded || !fragmentCode.succeeded) {
        error = GraphicsError(
            graphicsErrorUnsupportedFeature,
            "ShaderPackage.spirv",
            if (!vertexCode.succeeded) vertexCode.error else
                fragmentCode.error
        )
    } else if (this.backend == graphicsBackendOpenGl) {
        if (this.openGl.makeCurrent()) {
            openGl = openGlProgramFromPackage(shader)
        }
        if (!openGl.valid()) error = GraphicsError(
            graphicsErrorDriverFailure,
            "openGlProgramFromPackage",
            if (openGl.error != "") openGl.error else
                "OpenGL render pipeline creation failed"
        )
    } else if (this.backend == graphicsBackendVulkan) {
        val vertex = this.vulkanDevice.shaderModule(vertexCode.module)
        val fragment = this.vulkanDevice.shaderModule(fragmentCode.module)
        if (vertex.valid() && fragment.valid()) {
            vulkan = this.vulkanDevice.renderPipeline(
                this.vulkanSwapchain,
                vertex,
                fragment,
                vertexLayout.stride,
                raster.topology,
                raster.cullMode,
                raster.frontFace,
                raster.alphaBlend
            )
        }
        if (!vulkan.valid()) error = GraphicsError(
            graphicsErrorDriverFailure,
            "VulkanDevice.renderPipeline",
            "Vulkan render pipeline creation failed"
        )
    }

    GraphicsRenderPipeline(
        move(openGl),
        move(vulkan),
        this.backend,
        vertexLayout,
        raster,
        shader,
        error
    )
}

trusted fun GraphicsApplication.recreateRenderTarget(
    var pipeline: GraphicsRenderPipeline,
    width: int,
    height: int
): bool {
    var succeeded = this.backend == graphicsBackendVulkan &&
        pipeline.backend == graphicsBackendVulkan &&
        pipeline.shader.valid && pipeline.vertexLayout.valid() &&
        pipeline.raster.valid() && width > 0 && height > 0
    if (succeeded) {
        pipeline.vulkan.drop()
        succeeded = this.recreateVulkanSwapchain(width, height)
    }
    if (succeeded) {
        val translatable = glslPackage(
            [shaderStageVertex, shaderStageFragment],
            [
                pipeline.shader.source(shaderStageVertex),
                pipeline.shader.source(shaderStageFragment)
            ]
        )
        val vertexCode = translatable.spirv(shaderStageVertex)
        val fragmentCode = translatable.spirv(shaderStageFragment)
        succeeded = vertexCode.succeeded && fragmentCode.succeeded
        if (succeeded) {
            val vertex = this.vulkanDevice.shaderModule(vertexCode.module)
            val fragment = this.vulkanDevice.shaderModule(fragmentCode.module)
            if (vertex.valid() && fragment.valid()) {
                pipeline.vulkan = this.vulkanDevice.renderPipeline(
                    this.vulkanSwapchain,
                    vertex,
                    fragment,
                    pipeline.vertexLayout.stride,
                    pipeline.raster.topology,
                    pipeline.raster.cullMode,
                    pipeline.raster.frontFace,
                    pipeline.raster.alphaBlend
                )
            }
            succeeded = pipeline.vulkan.valid()
        }
    }
    succeeded
}

trusted fun GraphicsApplication.renderTargetReady(
    var pipeline: GraphicsRenderPipeline
): bool {
    var ready = this.backend == graphicsBackendVulkan && pipeline.valid()
    if (ready && (
        this.vulkanSwapchain.width != this.window.width ||
        this.vulkanSwapchain.height != this.window.height ||
        pipeline.vulkan.width != this.vulkanSwapchain.width ||
        pipeline.vulkan.height != this.vulkanSwapchain.height ||
        pipeline.vulkan.format != this.vulkanSwapchain.format
    )) {
        ready = this.recreateRenderTarget(
            pipeline,
            this.window.width,
            this.window.height
        )
    }
    ready
}

trusted fun GraphicsApplication.presentRender(
    var pipeline: GraphicsRenderPipeline,
    clear: Color
): bool {
    if (!this.valid() || !pipeline.valid() || !clear.valid() ||
        pipeline.vertexLayout.buffered() ||
        pipeline.backend != this.backend) false
    else if (this.backend == graphicsBackendOpenGl) {
        this.openGl.presentProgram(
            pipeline.openGl,
            clear,
            pipeline.raster
        )
    } else if (this.backend == graphicsBackendVulkan) {
        var ready = this.renderTargetReady(pipeline)
        var outcome = vulkanPresentOutcome(false, false, -1)
        if (ready) outcome = this.vulkanDevice.presentRenderOutcome(
                this.vulkanSwapchain,
                this.vulkanPixels,
                pipeline.vulkan,
                clear
            )
        var presented = vulkanPresentSucceeded(outcome)
        if (ready && vulkanPresentNeedsRecreation(outcome)) {
            ready = this.recreateRenderTarget(
                pipeline,
                this.window.width,
                this.window.height
            )
            if (ready && !presented) {
                outcome = this.vulkanDevice.presentRenderOutcome(
                    this.vulkanSwapchain,
                    this.vulkanPixels,
                    pipeline.vulkan,
                    clear
                )
                presented = vulkanPresentSucceeded(outcome) &&
                    !vulkanPresentNeedsRecreation(outcome)
            }
        }
        ready && presented
    } else false
}

trusted fun GraphicsApplication.presentRenderVertices(
    var pipeline: GraphicsRenderPipeline,
    vertices: GraphicsBuffer,
    vertexCount: int,
    clear: Color,
    instanceCount: int = 1
): bool {
    val stride = pipeline.vertexLayout.stride
    if (!this.valid() || !pipeline.valid() || !vertices.valid() ||
        !clear.valid() || pipeline.backend != this.backend || stride <= 0 ||
        vertexCount <= 0 || instanceCount <= 0 ||
        vertexCount > vertices.descriptor.size / stride ||
        !this.ownsBuffer(vertices) ||
        (vertices.descriptor.usage & bufferUsageVertex) == 0) false
    else if (this.backend == graphicsBackendOpenGl) {
        this.openGl.presentProgramVertices(
            pipeline.openGl,
            vertices.openGl,
            vertexCount,
            instanceCount,
            stride,
            clear,
            pipeline.raster
        )
    } else if (this.backend == graphicsBackendVulkan) {
        var ready = this.renderTargetReady(pipeline)
        var outcome = vulkanPresentOutcome(false, false, -1)
        if (ready) outcome = this.vulkanDevice.presentRenderOutcome(
                this.vulkanSwapchain,
                this.vulkanPixels,
                pipeline.vulkan,
                clear,
                vertices.vulkan.handle,
                vertexCount,
                0,
                0,
                instanceCount
            )
        var presented = vulkanPresentSucceeded(outcome)
        if (ready && vulkanPresentNeedsRecreation(outcome)) {
            ready = this.recreateRenderTarget(
                pipeline,
                this.window.width,
                this.window.height
            )
            if (ready && !presented) outcome =
                this.vulkanDevice.presentRenderOutcome(
                    this.vulkanSwapchain,
                    this.vulkanPixels,
                    pipeline.vulkan,
                    clear,
                    vertices.vulkan.handle,
                    vertexCount,
                    0,
                    0,
                    instanceCount
                )
            presented = presented ||
                (vulkanPresentSucceeded(outcome) &&
                 !vulkanPresentNeedsRecreation(outcome))
        }
        ready && presented
    } else false
}

trusted fun GraphicsApplication.presentRenderIndexed(
    var pipeline: GraphicsRenderPipeline,
    vertices: GraphicsBuffer,
    indices: GraphicsBuffer,
    indexCount: int,
    clear: Color,
    instanceCount: int = 1
): bool {
    val stride = pipeline.vertexLayout.stride
    if (!this.valid() || !pipeline.valid() || !vertices.valid() ||
        !indices.valid() || !clear.valid() ||
        pipeline.backend != this.backend || stride <= 0 ||
        vertices.descriptor.size / stride <= 0 || indexCount <= 0 ||
        instanceCount <= 0 ||
        indexCount > indices.descriptor.size / 4 ||
        !this.ownsBuffer(vertices) || !this.ownsBuffer(indices) ||
        (vertices.descriptor.usage & bufferUsageVertex) == 0 ||
        (indices.descriptor.usage & bufferUsageIndex) == 0) false
    else if (this.backend == graphicsBackendOpenGl) {
        this.openGl.presentProgramIndexed(
            pipeline.openGl,
            vertices.openGl,
            indices.openGl,
            indexCount,
            instanceCount,
            stride,
            clear,
            pipeline.raster
        )
    } else if (this.backend == graphicsBackendVulkan) {
        var ready = this.renderTargetReady(pipeline)
        var outcome = vulkanPresentOutcome(false, false, -1)
        if (ready) outcome = this.vulkanDevice.presentRenderOutcome(
                this.vulkanSwapchain,
                this.vulkanPixels,
                pipeline.vulkan,
                clear,
                vertices.vulkan.handle,
                vertices.descriptor.size / stride,
                indices.vulkan.handle,
                indexCount,
                instanceCount
            )
        var presented = vulkanPresentSucceeded(outcome)
        if (ready && vulkanPresentNeedsRecreation(outcome)) {
            ready = this.recreateRenderTarget(
                pipeline,
                this.window.width,
                this.window.height
            )
            if (ready && !presented) outcome =
                this.vulkanDevice.presentRenderOutcome(
                    this.vulkanSwapchain,
                    this.vulkanPixels,
                    pipeline.vulkan,
                    clear,
                    vertices.vulkan.handle,
                    vertices.descriptor.size / stride,
                    indices.vulkan.handle,
                    indexCount,
                    instanceCount
                )
            presented = presented ||
                (vulkanPresentSucceeded(outcome) &&
                 !vulkanPresentNeedsRecreation(outcome))
        }
        ready && presented
    } else false
}
