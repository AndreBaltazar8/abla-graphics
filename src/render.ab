        ) ||
        !this.ownsBuffer(vertices) || !this.ownsBuffer(indices) ||
        !this.ownsBuffer(indirect) ||
        (vertices.descriptor.usage & bufferUsageVertex) == 0 ||
        (indices.descriptor.usage & bufferUsageIndex) == 0 ||
        (indirect.descriptor.usage & bufferUsageIndirect) == 0) false
    else if (this.backend == graphicsBackendOpenGl) {
        this.openGl.presentProgramIndexed(
            pipeline.openGl,
            vertices.openGl,
            indices.openGl,
            1,
            1,
            pipeline.vertexLayout,
            clear,
            pipeline.raster,
            pipeline.depth,
            pipeline.binding.openGlKinds,
            pipeline.binding.openGlBindings,
            pipeline.binding.openGlResources,
            pipeline.binding.openGlOffsets,
            pipeline.binding.openGlSizes,
            pipeline.binding.openGlSamplers,
            indirect.openGl.handle,
            constants.bytes.storage.address,
            constants.layout.size,
            vertexOffset,
            indexOffset,
            indirectOffset
        )
    } else if (this.backend == graphicsBackendVulkan) {
        var ready = this.renderTargetReady(pipeline)
        var outcome = vulkanPresentOutcome(false, false, -1)
        if (ready) outcome = this.vulkanDevice.presentRenderOutcome(
                this.vulkanSwapchain,
                this.vulkanPixels,
                pipeline.vulkan,
                clear,
                vertices.vulkan.handle,
                1,
                indices.vulkan.handle,
                0,
                1,
                pipeline.binding.vulkan.descriptorSet,
                indirect.vulkan.handle,
                true,
                constants.bytes.storage.address,
                constants.layout.size,
                vertexOffset,
                indexOffset,
                indirectOffset
            )
        var presented = vulkanPresentSucceeded(outcome)
        if (ready && vulkanPresentNeedsRecreation(outcome)) {
            ready = this.recreateRenderTarget(
                pipeline,
                this.window.width,
                this.window.height
            )
            if (ready && !presented) outcome =
                this.vulkanDevice.presentRenderOutcome(
                    this.vulkanSwapchain,
                    this.vulkanPixels,
                    pipeline.vulkan,
                    clear,
                    vertices.vulkan.handle,
                    1,
                    indices.vulkan.handle,
                    0,
                    1,
                    pipeline.binding.vulkan.descriptorSet,
                    indirect.vulkan.handle,
                    true,
                    constants.bytes.storage.address,
                    constants.layout.size,
                    vertexOffset,
                    indexOffset,
                    indirectOffset
                )
            presented = presented ||
                (vulkanPresentSucceeded(outcome) &&
                 !vulkanPresentNeedsRecreation(outcome))
        }
        ready && presented
    } else false
}
