// Abla-defined GLSL embedded-source parser.
//
// This first grammar slice owns multi-stage block structure, balanced shader
// scopes, comments, stage uniqueness, and source-preserving construction. The
// Explicit interface declarations and simple uniform/storage block members
// additionally feed deterministic reflection and cross-stage compatibility
// checks. The remaining general GLSL declaration/expression grammar extends
// this module without changing the public ShaderPackage value.

import "abla/compiler/parser"
import "glsl_lexer.ab"

val shaderStageVertex = "vertex"
val shaderStageFragment = "fragment"
val shaderStageCompute = "compute"
val shaderStageGeometry = "geometry"
val shaderStageTessellationControl = "tessellationControl"
val shaderStageTessellationEvaluation = "tessellationEvaluation"

class ShaderStageSource(
    val kind: string,
    val source: string,
    val sourceIdentity: string = "",
    val begin: int = -1,
    val end: int = -1
)

class ShaderLocation(
    val stage: string,
    val location: int,
    val direction: string,
    val dataType: string = "",
    val name: string = "",
    val arraySize: int = 1,
    val slots: int = 0,
    val members: array<ShaderBlockMember> = []
)

class ShaderBlockMember(
    val dataType: string,
    val name: string,
    val arraySize: int = 1,
    val offset: int = -1,
    val align: int = -1,
    val rowMajor: bool = false,
    val columnMajor: bool = false
)

class ShaderStructureInstance(
    val name: string,
    val arraySize: int = 1
)

class ShaderStructure(
    val stage: string,
    val name: string,
    val members: array<ShaderBlockMember>,
    val instances: array<ShaderStructureInstance> = []
)

class ShaderBinding(
    val stage: string,
    val set: int,
    val binding: int,
    val storage: string,
    val dataType: string = "",
    val name: string = "",
    val arraySize: int = 1,
    val members: array<ShaderBlockMember> = []
)

class ShaderPushConstant(
    val stage: string,
    val dataType: string,
    val name: string,
    val members: array<ShaderBlockMember>
)

val shaderStageMaskVertex = 1
val shaderStageMaskTessellationControl = 2
val shaderStageMaskTessellationEvaluation = 4
val shaderStageMaskGeometry = 8
val shaderStageMaskFragment = 16
val shaderStageMaskCompute = 32
val openGlPushConstantBinding = 15

class ShaderPushConstantMemberLayout(
    val dataType: string,
    val name: string,
    val arraySize: int,
    val offset: int,
    val size: int,
    val alignment: int,
    val arrayStride: int,
    val matrixStride: int,
    val rowMajor: bool
)

class ShaderPushConstantLayout(
    val valid: bool,
    val size: int,
    val stageMask: int,
    val members: array<ShaderPushConstantMemberLayout>,
    val error: string
) {
    fun openGlCompatible(): bool {
        var compatible = this.valid
        var index = 0
        while (compatible && index < this.members.size) {
            val member = this.members[index]
            compatible = (member.arrayStride == 0 ||
                member.alignment >= 16) &&
                (member.matrixStride == 0 || member.matrixStride >= 16)
            index = index + 1
        }
        compatible
    }

    fun matches(other: ShaderPushConstantLayout): bool {
        var matches = this.valid && other.valid &&
            this.size == other.size && this.stageMask == other.stageMask &&
            this.members.size == other.members.size
        var index = 0
        while (matches && index < this.members.size) {
            val left = this.members[index]
            val right = other.members[index]
            matches = left.dataType == right.dataType &&
                left.name == right.name && left.arraySize == right.arraySize &&
                left.offset == right.offset && left.size == right.size &&
                left.alignment == right.alignment &&
                left.arrayStride == right.arrayStride &&
                left.matrixStride == right.matrixStride &&
                left.rowMajor == right.rowMajor
            index = index + 1
        }
        matches
    }
}

fun ShaderPackage.openGlSource(stage: string): string {
    val source = this.source(stage)
    val lexical = glslLex(source)
    var result = ""
    var cursor = 0
    var index = 0
    while (lexical.valid && index < lexical.tokens.size) {
        val token = lexical.tokens[index]
        if (token.kind == glslTokenIdentifier &&
            token.text == "push_constant") {
            result = "$result${source.slice(cursor, token.begin)}std140, binding = $openGlPushConstantBinding"
            cursor = token.end
        }
        index = index + 1
    }
    if (cursor > 0) "$result${source.slice(cursor, source.size)}" else source
}

class ShaderSpecializationConstant(
    val stage: string,
    val id: int,
    val dataType: string,
    val name: string,
    val defaultValue: string
)

class ShaderInclude(
    val stage: string,
    val path: string,
    val system: bool,
    val begin: int = -1,
    val end: int = -1
)

class GlslModule(
    val path: string,
    val source: string,
    val system: bool = false
)

class GlslResolvedSource(
    val valid: bool,
    val source: string,
    val error: string = ""
)

class ShaderWorkgroup(
    val stage: string,
    val x: int,
    val y: int,
    val z: int,
    val xId: int = -1,
    val yId: int = -1,
    val zId: int = -1,
    val xSpecified: bool = true,
    val ySpecified: bool = true,
    val zSpecified: bool = true
)

class ShaderPackage(
    val stages: array<ShaderStageSource>,
    val locations: array<ShaderLocation>,
    val bindings: array<ShaderBinding>,
    val workgroups: array<ShaderWorkgroup>,
    val pushConstants: array<ShaderPushConstant>,
    val specializationConstants: array<ShaderSpecializationConstant>,
    val includes: array<ShaderInclude>,
    val valid: bool,
    val error: string,
    val structures: array<ShaderStructure> = []
) {
    fun source(kind: string): string {
        var result = ""
        var index = 0
        while (result == "" && index < this.stages.size) {
            if (this.stages[index].kind == kind) {
                result = this.stages[index].source
            }
            index = index + 1
        }
        result
    }
}

class GlslName(val text: string, val next: int)

class GlslInteger(val valid: bool, val value: int, val next: int)

class GlslLayout(
    val valid: bool,
    val location: int,
    val set: int,
    val binding: int,
    val localSizeX: int,
    val localSizeY: int,
    val localSizeZ: int,
    val localSizeXId: int,
    val localSizeYId: int,
    val localSizeZId: int,
    val setSpecified: bool,
    val pushConstant: bool,
    val constantId: int,
    val next: int,
    val error: string
)

class GlslStageReflection(
    val locations: array<ShaderLocation>,
    val bindings: array<ShaderBinding>,
    val workgroups: array<ShaderWorkgroup>,
    val pushConstants: array<ShaderPushConstant>,
    val specializationConstants: array<ShaderSpecializationConstant>,
    val includes: array<ShaderInclude>,
    val valid: bool,
    val error: string,
    val structures: array<ShaderStructure> = []
)

class GlslDeclaration(
    val storage: string,
    val dataType: string,
    val name: string,
    val arraySize: int,
    val members: array<ShaderBlockMember>,
    val declarators: array<GlslDeclarator>,
    val next: int,
    val valid: bool
)

class GlslDeclarator(val name: string, val arraySize: int)

class GlslDeclarators(
    val valid: bool,
    val values: array<GlslDeclarator>,
    val next: int
)

class GlslArraySize(val valid: bool, val value: int, val next: int)

class GlslBlock(
    val valid: bool,
    val name: string,
    val arraySize: int,
    val members: array<ShaderBlockMember>,
    val next: int,
    val declarators: array<GlslDeclarator> = []
)

class GlslSpecializationDeclaration(
    val valid: bool,
    val dataType: string,
    val name: string,
    val defaultValue: string,
    val next: int
)

class GlslMemberLayout(
    val valid: bool,
    val offset: int,
    val align: int,
    val rowMajor: bool,
    val columnMajor: bool,
    val next: int
)

class GlslInclude(
    val valid: bool,
    val path: string,
    val system: bool,
    val next: int
)

class GlslIncludesReflection(
    val includes: array<ShaderInclude>,
    val valid: bool,
    val error: string
)

fun glslAsciiWhitespace(value: int): bool =
    value == 9 || value == 10 || value == 11 || value == 12 ||
    value == 13 || value == 32

fun glslAsciiNameStart(value: int): bool =
    (value >= 65 && value <= 90) ||
    (value >= 97 && value <= 122) || value == 95

fun glslAsciiNameContinue(value: int): bool =
    glslAsciiNameStart(value) || (value >= 48 && value <= 57)

fun glslContainsText(source: string, wanted: string): bool {
    var found = false
    var index = 0
    while (!found && wanted != "" && index <= source.size - wanted.size) {
        found = source.slice(index, index + wanted.size) == wanted
        index = index + 1
    }
    found
}

fun glslSkipTrivia(source: string, begin: int): int {
    var index = begin
    var skipping = true
    while (skipping && index < source.size) {
        if (glslAsciiWhitespace(source[index])) index = index + 1
        else if (index + 1 < source.size && source[index] == 47 &&
            source[index + 1] == 47) {
            index = index + 2
            while (index < source.size && source[index] != 10 &&
                source[index] != 13) index = index + 1
        } else if (index + 1 < source.size && source[index] == 47 &&
            source[index + 1] == 42) {
            index = index + 2
            var closed = false
            while (!closed && index + 1 < source.size) {
                if (source[index] == 42 && source[index + 1] == 47) {
                    index = index + 2
                    closed = true
                } else index = index + 1
            }
            if (!closed) index = source.size
        } else skipping = false
    }
    index
}

fun glslReadName(source: string, begin: int): GlslName {
    val start = glslSkipTrivia(source, begin)
    var end = start
    if (end < source.size && glslAsciiNameStart(source[end])) {
        end = end + 1
        while (end < source.size && glslAsciiNameContinue(source[end])) {
            end = end + 1
        }
    }
    GlslName(
        if (end > start) source.slice(start, end) else "",
        end
    )
}

fun glslReadUnsigned(source: string, begin: int): GlslInteger {
    val start = glslSkipTrivia(source, begin)
    var index = start
    var value = 0
    var valid = false
    while (index < source.size && source[index] >= 48 &&
        source[index] <= 57) {
        val digit = source[index] - 48
        if (value <= 214748364) value = value * 10 + digit
        else value = 2147483647
        valid = true
        index = index + 1
    }
    GlslInteger(valid, value, index)
}

fun glslLineEnd(source: string, begin: int): int {
    var index = begin
    while (index < source.size && source[index] != 10 &&
        source[index] != 13) index = index + 1
    index
}

fun glslSkipHorizontalSpace(source: string, begin: int): int {
    var index = begin
    while (index < source.size &&
        (source[index] == 9 || source[index] == 11 ||
         source[index] == 12 || source[index] == 32)) index = index + 1
    index
}

fun glslParseInclude(source: string, begin: int): GlslInclude {
    var index = glslSkipHorizontalSpace(source, begin)
    val system = index < source.size && source[index] == 60
    val quoted = index < source.size && source[index] == 34
    val close = if (system) 62 else 34
    var valid = system || quoted
    if (valid) index = index + 1
    val start = index
    while (valid && index < source.size && source[index] != close &&
        source[index] != 10 && source[index] != 13) {
        if (source[index] == 92) valid = false
        else index = index + 1
    }
    val path = if (valid && index > start && index < source.size &&
        source[index] == close) source.slice(start, index) else ""
    valid = valid && path != ""
    if (valid) index = index + 1
    index = glslSkipHorizontalSpace(source, index)
    if (valid && index + 1 < source.size && source[index] == 47 &&
        source[index + 1] == 47) index = glslLineEnd(source, index)
    else if (valid && index < source.size && source[index] != 10 &&
        source[index] != 13) valid = false
    GlslInclude(valid, path, system, glslLineEnd(source, index))
}

fun glslReflectIncludes(stage: string, source: string): GlslIncludesReflection {
    val includes: array<ShaderInclude> = []
    var valid = true
    var error = ""
    var index = 0
    while (valid && index < source.size) {
        index = glslSkipTrivia(source, index)
        if (index < source.size && source[index] == 35) {
            val directive = glslReadName(source, index + 1)
            if (directive.text == "include") {
                val include = glslParseInclude(source, directive.next)
                if (!include.valid) {
                    valid = false
                    error = "malformed GLSL $stage include directive"
                } else {
                    includes.append(ShaderInclude(
                        stage,
                        include.path,
                        include.system,
                        index,
                        include.next
                    ))
                }
                index = include.next
            } else index = glslLineEnd(source, directive.next)
        } else index = glslLineEnd(source, index)
    }
    GlslIncludesReflection(includes, valid, error)
}

fun glslParseLayout(source: string, begin: int): GlslLayout {
    var index = glslSkipTrivia(source, begin)
    var valid = index < source.size && source[index] == 40
    if (valid) index = index + 1
    var location = -1
    var set = 0
    var binding = -1
    var localSizeX = -1
    var localSizeY = -1
    var localSizeZ = -1
    var localSizeXId = -1
    var localSizeYId = -1
    var localSizeZId = -1
    var setSpecified = false
    var pushConstant = false
    var constantId = -1
    var done = false
    while (valid && !done && index < source.size) {
        index = glslSkipTrivia(source, index)
        if (index < source.size && source[index] == 41) {
            index = index + 1
            done = true
        } else {
            val name = glslReadName(source, index)
            valid = name.text != ""
            index = glslSkipTrivia(source, name.next)
            if (valid && index < source.size && source[index] == 61) {
                val integer = glslReadUnsigned(source, index + 1)
                val numeric = name.text == "location" ||
                    name.text == "set" || name.text == "binding" ||
                    name.text == "local_size_x" ||
                    name.text == "local_size_y" ||
                    name.text == "local_size_z" ||
                    name.text == "local_size_x_id" ||
                    name.text == "local_size_y_id" ||
                    name.text == "local_size_z_id" ||
                    name.text == "constant_id"
                if (integer.valid) {
                    if (name.text == "location") {
                        if (location >= 0) valid = false
                        else location = integer.value
                    }
                    else if (name.text == "set") {
                        if (setSpecified) valid = false
                        else {
                            set = integer.value
                            setSpecified = true
                        }
                    }
                    else if (name.text == "binding") {
                        if (binding >= 0) valid = false
                        else binding = integer.value
                    }
                    else if (name.text == "local_size_x") {
                        if (localSizeX >= 0) valid = false
                        else localSizeX = integer.value
                    } else if (name.text == "local_size_y") {
                        if (localSizeY >= 0) valid = false
                        else localSizeY = integer.value
                    } else if (name.text == "local_size_z") {
                        if (localSizeZ >= 0) valid = false
                        else localSizeZ = integer.value
                    } else if (name.text == "local_size_x_id") {
                        if (localSizeXId >= 0) valid = false
                        else localSizeXId = integer.value
                    } else if (name.text == "local_size_y_id") {
                        if (localSizeYId >= 0) valid = false
                        else localSizeYId = integer.value
                    } else if (name.text == "local_size_z_id") {
                        if (localSizeZId >= 0) valid = false
                        else localSizeZId = integer.value
                    } else if (name.text == "constant_id") {
                        if (constantId >= 0) valid = false
                        else constantId = integer.value
                    } else if (name.text == "push_constant") valid = false
                    index = integer.next
                } else {
                    if (numeric || name.text == "push_constant") valid = false
                    while (index < source.size && source[index] != 44 &&
                        source[index] != 41) index = index + 1
                }
            } else if (valid && name.text == "push_constant") {
                if (pushConstant) valid = false
                else pushConstant = true
            } else if (valid &&
                (name.text == "location" || name.text == "set" ||
                 name.text == "binding" || name.text == "local_size_x" ||
                 name.text == "local_size_y" ||
                 name.text == "local_size_z" ||
                 name.text == "local_size_x_id" ||
                 name.text == "local_size_y_id" ||
                 name.text == "local_size_z_id" ||
                 name.text == "constant_id")) {
                valid = false
            }
            index = glslSkipTrivia(source, index)
            if (index < source.size && source[index] == 44) index = index + 1
            else if (index < source.size && source[index] == 41) {
                index = index + 1
                done = true
            } else valid = false
        }
    }
    valid = valid && done && location <= 65535 && set <= 65535 &&
        binding <= 65535 && localSizeX <= 65535 &&
        localSizeY <= 65535 && localSizeZ <= 65535 &&
        localSizeXId <= 65535 && localSizeYId <= 65535 &&
        localSizeZId <= 65535 &&
        localSizeX != 0 && localSizeY != 0 && localSizeZ != 0
    GlslLayout(
        valid,
        location,
        set,
        binding,
        localSizeX,
        localSizeY,
        localSizeZ,
        localSizeXId,
        localSizeYId,
        localSizeZId,
        setSpecified,
        pushConstant,
        constantId,
        index,
        if (valid) "" else "malformed GLSL layout qualifier"
    )
}

fun glslPowerOfTwo(value: int): bool {
    var candidate = 1
    while (candidate < value && candidate < 1073741824) {
        candidate = candidate * 2
    }
    value > 0 && candidate == value
}

fun glslParseMemberLayout(source: string, begin: int): GlslMemberLayout {
    var index = glslSkipTrivia(source, begin)
    var valid = index < source.size && source[index] == 40
    if (valid) index = index + 1
    var offset = -1
    var align = -1
    var rowMajor = false
    var columnMajor = false
    var done = false
    var entries = 0
    while (valid && !done && index < source.size) {
        index = glslSkipTrivia(source, index)
        if (index < source.size && source[index] == 41) {
            index = index + 1
            done = true
        } else {
            val name = glslReadName(source, index)
            valid = name.text != ""
            index = glslSkipTrivia(source, name.next)
            if (valid &&
                (name.text == "offset" || name.text == "align")) {
                valid = index < source.size && source[index] == 61
                val integer = glslReadUnsigned(source, index + 1)
                valid = valid && integer.valid
                if (valid && name.text == "offset") {
                    valid = offset < 0
                    if (valid) offset = integer.value
                } else if (valid) {
                    valid = align < 0 && glslPowerOfTwo(integer.value)
                    if (valid) align = integer.value
                }
                index = integer.next
            } else if (valid && name.text == "row_major") {
                valid = !rowMajor && !columnMajor
                if (valid) rowMajor = true
            } else if (valid && name.text == "column_major") {
                valid = !rowMajor && !columnMajor
                if (valid) columnMajor = true
            } else valid = false
            if (valid) entries = entries + 1
            index = glslSkipTrivia(source, index)
            if (valid && index < source.size && source[index] == 44) {
                index = index + 1
            } else if (valid && index < source.size &&
                source[index] == 41) {
                index = index + 1
                done = true
            } else valid = false
        }
    }
    GlslMemberLayout(
        valid && done && entries > 0,
        offset,
        align,
        rowMajor,
        columnMajor,
        index
    )
}

fun glslNumericLiteral(
    source: string,
    begin: int,
    dataType: string
): GlslName {
    val start = glslSkipTrivia(source, begin)
    var index = start
    var negative = false
    if (index < source.size &&
        (source[index] == 43 || source[index] == 45)) {
        negative = source[index] == 45
        index = index + 1
    }
    var digits = 0
    while (index < source.size && source[index] >= 48 &&
        source[index] <= 57) {
        digits = digits + 1
        index = index + 1
    }
    var fractional = false
    if (index < source.size && source[index] == 46) {
        fractional = true
        index = index + 1
        while (index < source.size && source[index] >= 48 &&
            source[index] <= 57) {
            digits = digits + 1
            index = index + 1
        }
    }
    var exponent = false
    var exponentDigits = 0
    if (index < source.size &&
        (source[index] == 69 || source[index] == 101)) {
        exponent = true
        index = index + 1
        if (index < source.size &&
            (source[index] == 43 || source[index] == 45)) index = index + 1
        while (index < source.size && source[index] >= 48 &&
            source[index] <= 57) {
            exponentDigits = exponentDigits + 1
            index = index + 1
        }
    }
    var suffix = ""
    if (index < source.size &&
        (source[index] == 85 || source[index] == 117 ||
         source[index] == 70 || source[index] == 102)) {
        suffix = source.slice(index, index + 1)
        index = index + 1
    } else if (index + 1 < source.size &&
        (source[index] == 76 || source[index] == 108) &&
        (source[index + 1] == 70 || source[index + 1] == 102)) {
        suffix = source.slice(index, index + 2)
        index = index + 2
    }
    var valid = digits > 0 && (!exponent || exponentDigits > 0)
    if (dataType == "int") {
        valid = valid && !fractional && !exponent && suffix == ""
    } else if (dataType == "uint") {
        valid = valid && !negative && !fractional && !exponent &&
            (suffix == "u" || suffix == "U")
    } else if (dataType == "float") {
        valid = valid && (fractional || exponent) &&
            (suffix == "" || suffix == "f" || suffix == "F")
    } else if (dataType == "double") {
        valid = valid && (fractional || exponent) &&
            (suffix == "" || suffix == "lf" || suffix == "LF" ||
             suffix == "Lf" || suffix == "lF")
    } else valid = false
    GlslName(if (valid) source.slice(start, index) else "", index)
}

fun glslParseSpecializationDeclaration(
    source: string,
    begin: int
): GlslSpecializationDeclaration {
    var part = glslReadName(source, begin)
    var valid = part.text == "const"
    val dataType = glslReadName(source, part.next)
    val name = glslReadName(source, dataType.next)
    var index = glslSkipTrivia(source, name.next)
    valid = valid &&
        (dataType.text == "bool" || dataType.text == "int" ||
         dataType.text == "uint" || dataType.text == "float" ||
         dataType.text == "double") &&
        name.text != "" && index < source.size && source[index] == 61
    if (valid) index = index + 1
    var literal = GlslName("", index)
    if (valid && dataType.text == "bool") {
        part = glslReadName(source, index)
        valid = part.text == "true" || part.text == "false"
        if (valid) literal = GlslName(part.text, part.next)
    } else if (valid) {
        literal = glslNumericLiteral(source, index, dataType.text)
        valid = literal.text != ""
    }
    index = glslSkipTrivia(source, literal.next)
    valid = valid && index < source.size && source[index] == 59
    GlslSpecializationDeclaration(
        valid,
        dataType.text,
        name.text,
        literal.text,
        if (index < source.size && source[index] == 59) index + 1 else index
    )
}

fun glslDeclarationQualifier(name: string): bool =
    name == "const" || name == "invariant" || name == "precise" ||
    name == "centroid" || name == "sample" || name == "patch" ||
    name == "flat" || name == "smooth" || name == "noperspective" ||
    name == "highp" || name == "mediump" || name == "lowp" ||
    name == "coherent" || name == "volatile" || name == "restrict" ||
    name == "readonly" || name == "writeonly"

fun glslArraySizeAfterName(source: string, begin: int): GlslArraySize {
    var index = glslSkipTrivia(source, begin)
    var valid = true
    var size = 1
    if (index < source.size && source[index] == 91) {
        index = glslSkipTrivia(source, index + 1)
        if (index < source.size && source[index] == 93) {
            size = 0
            index = index + 1
        } else {
            val integer = glslReadUnsigned(source, index)
            valid = integer.valid && integer.value > 0
            size = integer.value
            index = glslSkipTrivia(source, integer.next)
            valid = valid && index < source.size && source[index] == 93
            if (valid) index = index + 1
        }
    }
    GlslArraySize(valid, size, index)
}

fun glslParseDeclarators(source: string, begin: int): GlslDeclarators {
    val values: array<GlslDeclarator> = []
    var index = begin
    var valid = true
    var done = false
    while (valid && !done && index < source.size) {
        val name = glslReadName(source, index)
        val arraySize = glslArraySizeAfterName(source, name.next)
        valid = name.text != "" && arraySize.valid
        var duplicate = false
        var valueIndex = 0
        while (valid && !duplicate && valueIndex < values.size) {
            duplicate = values[valueIndex].name == name.text
            valueIndex = valueIndex + 1
        }
        valid = valid && !duplicate
        if (valid) {
            values.append(GlslDeclarator(name.text, arraySize.value))
            index = glslSkipTrivia(source, arraySize.next)
            if (index < source.size && source[index] == 44) {
                index = glslSkipTrivia(source, index + 1)
            } else if (index < source.size && source[index] == 59) {
                index = index + 1
                done = true
            } else valid = false
        }
    }
    GlslDeclarators(valid && done && values.size > 0, values, index)
}

fun glslParseBlock(source: string, begin: int): GlslBlock {
    val members: array<ShaderBlockMember> = []
    var index = glslSkipTrivia(source, begin)
    var valid = index < source.size && source[index] == 123
    if (valid) index = index + 1
    var closed = false
    while (valid && !closed && index < source.size) {
        index = glslSkipTrivia(source, index)
        if (index < source.size && source[index] == 125) {
            index = index + 1
            closed = true
        } else {
            var memberLayout = GlslMemberLayout(
                true,
                -1,
                -1,
                false,
                false,
                index
            )
            val prefix = glslReadName(source, index)
            if (prefix.text == "layout") {
                memberLayout = glslParseMemberLayout(source, prefix.next)
                valid = memberLayout.valid
                index = memberLayout.next
            }
            var type = GlslName("", index)
            var searching = true
            var attempts = 0
            while (searching && attempts < 16) {
                val part = glslReadName(source, index)
                if (part.text == "") searching = false
                else if (glslDeclarationQualifier(part.text)) {
                    index = part.next
                } else {
                    type = part
                    index = part.next
                    searching = false
                }
                attempts = attempts + 1
            }
            var declarationDone = false
            var declarationCount = 0
            while (valid && !declarationDone && index < source.size) {
                val member = glslReadName(source, index)
                val arraySize = glslArraySizeAfterName(
                    source,
                    member.next
                )
                index = glslSkipTrivia(source, arraySize.next)
                valid = type.text != "" && member.text != "" &&
                    arraySize.valid
                var duplicate = false
                var memberIndex = 0
                while (valid && !duplicate && memberIndex < members.size) {
                    duplicate = members[memberIndex].name == member.text
                    memberIndex = memberIndex + 1
                }
                valid = valid && !duplicate
                if (valid) {
                    members.append(ShaderBlockMember(
                        type.text,
                        member.text,
                        arraySize.value,
                        memberLayout.offset,
                        memberLayout.align,
                        memberLayout.rowMajor,
                        memberLayout.columnMajor
                    ))
                    declarationCount = declarationCount + 1
                }
                if (valid && index < source.size && source[index] == 44) {
                    index = glslSkipTrivia(source, index + 1)
                } else if (valid && index < source.size &&
                    source[index] == 59) {
                    index = index + 1
                    declarationDone = true
                } else valid = false
            }
            if (valid && declarationCount > 1 &&
                (memberLayout.offset >= 0 || memberLayout.align >= 0)) {
                valid = false
            }
        }
    }
    valid = valid && closed && members.size > 0
    val instance = if (valid) glslReadName(source, index)
        else GlslName("", index)
    val end = glslSkipTrivia(source, index)
    val declarators = if (instance.text != "") {
        glslParseDeclarators(source, index)
    } else {
        val values: array<GlslDeclarator> = []
        GlslDeclarators(
            valid && end < source.size && source[end] == 59,
            values,
            if (end < source.size && source[end] == 59) end + 1 else end
        )
    }
    val firstName = if (declarators.values.size > 0)
        declarators.values[0].name else ""
    val firstArraySize = if (declarators.values.size > 0)
        declarators.values[0].arraySize else 1
    GlslBlock(
        valid && declarators.valid,
        firstName,
        firstArraySize,
        members,
        declarators.next,
        declarators.values
    )
}

fun glslDeclarationAfterLayout(
    source: string,
    begin: int
): GlslDeclaration {
    var index = begin
    var storage = ""
    var attempts = 0
    while (storage == "" && attempts < 16) {
        val part = glslReadName(source, index)
        if (part.text == "in" || part.text == "out" ||
            part.text == "uniform" || part.text == "buffer") {
            storage = part.text
        }
        if (part.text == "") attempts = 16
        else index = part.next
        attempts = attempts + 1
    }
    var type = GlslName("", index)
    if (storage != "") {
        var searching = true
        attempts = 0
        while (searching && attempts < 16) {
            val part = glslReadName(source, index)
            if (part.text == "") searching = false
            else if (glslDeclarationQualifier(part.text)) index = part.next
            else {
                type = part
                index = part.next
                searching = false
            }
            attempts = attempts + 1
        }
    }
    val variable = glslReadName(source, index)
    val afterType = glslSkipTrivia(source, index)
    val block = afterType < source.size && source[afterType] == 123
    val arraySize = if (variable.text == "") GlslArraySize(true, 1, index)
        else glslArraySizeAfterName(source, variable.next)
    val parsedBlock = if (block) glslParseBlock(source, afterType)
        else GlslBlock(true, variable.text, arraySize.value, [], arraySize.next)
    val declarators = if (!block && variable.text != "") {
        glslParseDeclarators(source, index)
    } else {
        GlslDeclarators(
            parsedBlock.valid && parsedBlock.declarators.size <= 1,
            parsedBlock.declarators,
            parsedBlock.next
        )
    }
    GlslDeclaration(
        storage,
        type.text,
        parsedBlock.name,
        parsedBlock.arraySize,
        parsedBlock.members,
        declarators.values,
        declarators.next,
        storage != "" && type.text != "" &&
            (variable.text != "" || block) && arraySize.valid &&
            parsedBlock.valid && declarators.valid
    )
}

fun glslMatrixColumns(dataType: string): int {
    var columns = 0
    if (dataType == "mat2" || dataType == "mat2x2" ||
        dataType == "mat2x3" || dataType == "mat2x4" ||
        dataType == "dmat2" || dataType == "dmat2x2" ||
        dataType == "dmat2x3" || dataType == "dmat2x4") columns = 2
    else if (dataType == "mat3" || dataType == "mat3x2" ||
        dataType == "mat3x3" || dataType == "mat3x4" ||
        dataType == "dmat3" || dataType == "dmat3x2" ||
        dataType == "dmat3x3" || dataType == "dmat3x4") columns = 3
    else if (dataType == "mat4" || dataType == "mat4x2" ||
        dataType == "mat4x3" || dataType == "mat4x4" ||
        dataType == "dmat4" || dataType == "dmat4x2" ||
        dataType == "dmat4x3" || dataType == "dmat4x4") columns = 4
    columns
}

fun glslDoubleMatrixRows(dataType: string): int {
    var rows = 0
    if (dataType == "dmat2" || dataType == "dmat2x2" ||
        dataType == "dmat3x2" || dataType == "dmat4x2") rows = 2
    else if (dataType == "dmat3" || dataType == "dmat2x3" ||
        dataType == "dmat3x3" || dataType == "dmat4x3") rows = 3
    else if (dataType == "dmat4" || dataType == "dmat2x4" ||
        dataType == "dmat3x4" || dataType == "dmat4x4") rows = 4
    rows
}

fun glslLocationSlots(dataType: string, arraySize: int): int {
    val columns = glslMatrixColumns(dataType)
    val doubleRows = glslDoubleMatrixRows(dataType)
    var elementSlots = 1
    if (columns > 0) {
        elementSlots = columns * (if (doubleRows >= 3) 2 else 1)
    } else if (dataType == "dvec3" || dataType == "dvec4") {
        elementSlots = 2
    }
    elementSlots * arraySize
}

fun glslBuiltinType(dataType: string): bool =
    dataType == "bool" || dataType == "int" || dataType == "uint" ||
    dataType == "float" || dataType == "double" ||
    dataType == "bvec2" || dataType == "bvec3" || dataType == "bvec4" ||
    dataType == "ivec2" || dataType == "ivec3" || dataType == "ivec4" ||
    dataType == "uvec2" || dataType == "uvec3" || dataType == "uvec4" ||
    dataType == "vec2" || dataType == "vec3" || dataType == "vec4" ||
    dataType == "dvec2" || dataType == "dvec3" || dataType == "dvec4" ||
    glslMatrixColumns(dataType) > 0 || dataType == "atomic_uint" ||
    dataType == "sampler1D" || dataType == "sampler2D" ||
    dataType == "sampler3D" || dataType == "samplerCube" ||
    dataType == "sampler2DRect" || dataType == "sampler1DArray" ||
    dataType == "sampler2DArray" || dataType == "samplerCubeArray" ||
    dataType == "samplerBuffer" || dataType == "sampler2DMS" ||
    dataType == "sampler2DMSArray" ||
    dataType == "sampler1DShadow" || dataType == "sampler2DShadow" ||
    dataType == "samplerCubeShadow" ||
    dataType == "sampler2DRectShadow" ||
    dataType == "sampler1DArrayShadow" ||
    dataType == "sampler2DArrayShadow" ||
    dataType == "samplerCubeArrayShadow" ||
    dataType == "isampler1D" || dataType == "isampler2D" ||
    dataType == "isampler3D" || dataType == "isamplerCube" ||
    dataType == "isampler2DRect" || dataType == "isampler1DArray" ||
    dataType == "isampler2DArray" || dataType == "isamplerCubeArray" ||
    dataType == "isamplerBuffer" || dataType == "isampler2DMS" ||
    dataType == "isampler2DMSArray" ||
    dataType == "usampler1D" || dataType == "usampler2D" ||
    dataType == "usampler3D" || dataType == "usamplerCube" ||
    dataType == "usampler2DRect" || dataType == "usampler1DArray" ||
    dataType == "usampler2DArray" || dataType == "usamplerCubeArray" ||
    dataType == "usamplerBuffer" || dataType == "usampler2DMS" ||
    dataType == "usampler2DMSArray" ||
    dataType == "image1D" || dataType == "image2D" ||
    dataType == "image3D" || dataType == "imageCube" ||
    dataType == "image2DRect" || dataType == "image1DArray" ||
    dataType == "image2DArray" || dataType == "imageCubeArray" ||
    dataType == "imageBuffer" || dataType == "image2DMS" ||
    dataType == "image2DMSArray" ||
    dataType == "iimage1D" || dataType == "iimage2D" ||
    dataType == "iimage3D" || dataType == "iimageCube" ||
    dataType == "iimage2DRect" || dataType == "iimage1DArray" ||
    dataType == "iimage2DArray" || dataType == "iimageCubeArray" ||
    dataType == "iimageBuffer" || dataType == "iimage2DMS" ||
    dataType == "iimage2DMSArray" ||
    dataType == "uimage1D" || dataType == "uimage2D" ||
    dataType == "uimage3D" || dataType == "uimageCube" ||
    dataType == "uimage2DRect" || dataType == "uimage1DArray" ||
    dataType == "uimage2DArray" || dataType == "uimageCubeArray" ||
    dataType == "uimageBuffer" || dataType == "uimage2DMS" ||
    dataType == "uimage2DMSArray"

fun glslPushConstantStageMask(stage: string): int {
    var mask = 0
    if (stage == shaderStageVertex) mask = shaderStageMaskVertex
    else if (stage == shaderStageTessellationControl)
        mask = shaderStageMaskTessellationControl
    else if (stage == shaderStageTessellationEvaluation)
        mask = shaderStageMaskTessellationEvaluation
    else if (stage == shaderStageGeometry) mask = shaderStageMaskGeometry
    else if (stage == shaderStageFragment) mask = shaderStageMaskFragment
    else if (stage == shaderStageCompute) mask = shaderStageMaskCompute
    mask
}

fun glslAlignSize(value: int, alignment: int): int {
    if (value < 0 || alignment <= 0) -1
    else ((value + alignment - 1) / alignment) * alignment
}

class GlslPushConstantTypeLayout(
    val valid: bool,
    val size: int,
    val alignment: int,
    val matrixStride: int
)

fun glslPushConstantScalarSize(dataType: string): int {
    var size = 0
    if (dataType == "bool" || dataType == "int" ||
        dataType == "uint" || dataType == "float") size = 4
    else if (dataType == "double") size = 8
    size
}

fun glslVectorComponents(dataType: string): int {
    var components = 0
    if (dataType == "bvec2" || dataType == "ivec2" ||
        dataType == "uvec2" || dataType == "vec2" ||
        dataType == "dvec2") components = 2
    else if (dataType == "bvec3" || dataType == "ivec3" ||
        dataType == "uvec3" || dataType == "vec3" ||
        dataType == "dvec3") components = 3
    else if (dataType == "bvec4" || dataType == "ivec4" ||
        dataType == "uvec4" || dataType == "vec4" ||
        dataType == "dvec4") components = 4
    components
}

fun glslVectorScalarSize(dataType: string): int {
    if (dataType == "dvec2" || dataType == "dvec3" ||
        dataType == "dvec4") 8
    else if (glslVectorComponents(dataType) > 0) 4 else 0
}

fun glslMatrixRows(dataType: string): int {
    var rows = 0
    if (dataType == "mat2" || dataType == "mat2x2" ||
        dataType == "mat3x2" || dataType == "mat4x2" ||
        dataType == "dmat2" || dataType == "dmat2x2" ||
        dataType == "dmat3x2" || dataType == "dmat4x2") rows = 2
    else if (dataType == "mat3" || dataType == "mat2x3" ||
        dataType == "mat3x3" || dataType == "mat4x3" ||
        dataType == "dmat3" || dataType == "dmat2x3" ||
        dataType == "dmat3x3" || dataType == "dmat4x3") rows = 3
    else if (dataType == "mat4" || dataType == "mat2x4" ||
        dataType == "mat3x4" || dataType == "mat4x4" ||
        dataType == "dmat4" || dataType == "dmat2x4" ||
        dataType == "dmat3x4" || dataType == "dmat4x4") rows = 4
    rows
}

fun glslMatrixScalarSize(dataType: string): int =
    if (dataType.size >= 4 && dataType.slice(0, 4) == "dmat") 8
    else if (glslMatrixColumns(dataType) > 0) 4 else 0

fun glslPushConstantVectorLayout(
    components: int,
    scalarSize: int
): GlslPushConstantTypeLayout {
    val alignment = if (components == 2) scalarSize * 2
        else if (components == 3 || components == 4) scalarSize * 4 else 0
    GlslPushConstantTypeLayout(
        components >= 2 && components <= 4 && scalarSize > 0,
        components * scalarSize,
        alignment,
        0
    )
}

fun glslPushConstantTypeLayout(
    dataType: string,
    rowMajor: bool
): GlslPushConstantTypeLayout {
    val scalarSize = glslPushConstantScalarSize(dataType)
    val vectorComponents = glslVectorComponents(dataType)
    val matrixColumns = glslMatrixColumns(dataType)
    val matrixRows = glslMatrixRows(dataType)
    var layout = GlslPushConstantTypeLayout(false, 0, 0, 0)
    if (scalarSize > 0) {
        layout = GlslPushConstantTypeLayout(true, scalarSize, scalarSize, 0)
    } else if (vectorComponents > 0) {
        layout = glslPushConstantVectorLayout(
            vectorComponents,
            glslVectorScalarSize(dataType)
        )
    } else if (matrixColumns > 0 && matrixRows > 0) {
        val vector = glslPushConstantVectorLayout(
            if (rowMajor) matrixColumns else matrixRows,
            glslMatrixScalarSize(dataType)
        )
        val vectors = if (rowMajor) matrixRows else matrixColumns
        val stride = glslAlignSize(vector.size, vector.alignment)
        layout = GlslPushConstantTypeLayout(
            vector.valid && vectors > 0 && stride > 0,
            stride * vectors,
            vector.alignment,
            stride
        )
    }
    layout
}

fun ShaderPackage.pushConstantLayout(
    maximumSize: int = 128
): ShaderPushConstantLayout {
    val layouts: array<ShaderPushConstantMemberLayout> = []
    var valid = this.valid && maximumSize >= 0
    var error = if (!this.valid) this.error else ""
    var stageMask = 0
    var pushIndex = 0
    while (valid && pushIndex < this.pushConstants.size) {
        val mask = glslPushConstantStageMask(
            this.pushConstants[pushIndex].stage
        )
        valid = mask != 0
        if (!valid) error = "unknown GLSL push-constant shader stage"
        stageMask = stageMask | mask
        pushIndex = pushIndex + 1
    }
    val memberCount = if (this.pushConstants.size > 0)
        this.pushConstants[0].members.size else 0
    var cursor = 0
    var maximumAlignment = 4
    var index = 0
    while (valid && index < memberCount) {
        val member = this.pushConstants[0].members[index]
        val typeLayout = glslPushConstantTypeLayout(
            member.dataType,
            member.rowMajor
        )
        var alignment = typeLayout.alignment
        if (member.align > alignment) alignment = member.align
        var arrayStride = 0
        var size = typeLayout.size
        if (typeLayout.valid && member.arraySize > 1) {
            arrayStride = glslAlignSize(typeLayout.size, alignment)
            size = arrayStride * member.arraySize
        }
        var offset = glslAlignSize(cursor, alignment)
        if (member.offset >= 0) offset = member.offset
        valid = typeLayout.valid && member.arraySize > 0 &&
            alignment > 0 && offset >= cursor &&
            (offset / alignment) * alignment == offset && size > 0 &&
            offset <= maximumSize - size
        if (!valid) {
            error = "invalid or unsupported GLSL push-constant member '${member.name}'"
        } else {
            layouts.append(ShaderPushConstantMemberLayout(
                member.dataType,
                member.name,
                member.arraySize,
                offset,
                size,
                alignment,
                arrayStride,
                typeLayout.matrixStride,
                member.rowMajor
            ))
            cursor = offset + size
            if (alignment > maximumAlignment) maximumAlignment = alignment
        }
        index = index + 1
    }
    val size = if (valid && memberCount > 0)
        glslAlignSize(cursor, maximumAlignment) else 0
    if (valid && size > maximumSize) {
        valid = false
        error = "GLSL push-constant block exceeds the portable size limit"
    }
    ShaderPushConstantLayout(valid, size, stageMask, layouts, error)
}

fun glslStructureIndex(
    stage: string,
    name: string,
    structures: array<ShaderStructure>
): int {
    var result = -1
    var index = 0
    while (result < 0 && index < structures.size) {
        if (structures[index].stage == stage &&
            structures[index].name == name) result = index
        index = index + 1
    }
    result
}

fun glslStructureInstanceExists(
    stage: string,
    name: string,
    structures: array<ShaderStructure>
): bool {
    var found = false
    var structureIndex = 0
    while (!found && structureIndex < structures.size) {
        val structure = structures[structureIndex]
        if (structure.stage == stage) {
            var instanceIndex = 0
            while (!found && instanceIndex < structure.instances.size) {
                found = structure.instances[instanceIndex].name == name
                instanceIndex = instanceIndex + 1
            }
        }
        structureIndex = structureIndex + 1
    }
    found
}

fun glslLocationSlotsForStage(
    stage: string,
    dataType: string,
    arraySize: int,
    structures: array<ShaderStructure>
): int {
    val structureIndex = glslStructureIndex(stage, dataType, structures)
    var elementSlots = glslLocationSlots(dataType, 1)
    if (structureIndex >= 0) {
        elementSlots = 0
        val structure = structures[structureIndex]
        var memberIndex = 0
        while (memberIndex < structure.members.size) {
            val member = structure.members[memberIndex]
            elementSlots = elementSlots + glslLocationSlotsForStage(
                stage,
                member.dataType,
                member.arraySize,
                structures
            )
            memberIndex = memberIndex + 1
        }
    }
    elementSlots * arraySize
}

fun glslMembersLocationSlots(
    stage: string,
    members: array<ShaderBlockMember>,
    arraySize: int,
    structures: array<ShaderStructure>
): int {
    var slots = 0
    var memberIndex = 0
    while (memberIndex < members.size) {
        val member = members[memberIndex]
        slots = slots + glslLocationSlotsForStage(
            stage,
            member.dataType,
            member.arraySize,
            structures
        )
        memberIndex = memberIndex + 1
    }
    slots * arraySize
}

fun glslStructureTypeEqual(
    leftStage: string,
    rightStage: string,
    dataType: string,
    structures: array<ShaderStructure>,
    depth: int = 0
): bool {
    val leftIndex = glslStructureIndex(leftStage, dataType, structures)
    val rightIndex = glslStructureIndex(rightStage, dataType, structures)
    var equal = leftIndex == rightIndex
    if (leftIndex >= 0 || rightIndex >= 0) {
        equal = leftIndex >= 0 && rightIndex >= 0 && depth < 64
        if (equal) {
            val left = structures[leftIndex]
            val right = structures[rightIndex]
            equal = glslBlockMembersEqual(left.members, right.members)
            var memberIndex = 0
            while (equal && memberIndex < left.members.size) {
                equal = glslStructureTypeEqual(
                    leftStage,
                    rightStage,
                    left.members[memberIndex].dataType,
                    structures,
                    depth + 1
                )
                memberIndex = memberIndex + 1
            }
        }
    }
    equal
}

fun glslMembersTypesEqual(
    leftStage: string,
    rightStage: string,
    left: array<ShaderBlockMember>,
    right: array<ShaderBlockMember>,
    structures: array<ShaderStructure>
): bool {
    var equal = glslBlockMembersEqual(left, right)
    var index = 0
    while (equal && index < left.size) {
        equal = glslStructureTypeEqual(
            leftStage,
            rightStage,
            left[index].dataType,
            structures
        )
        index = index + 1
    }
    equal
}

fun glslLocationMembersEqual(
    left: ShaderLocation,
    right: ShaderLocation,
    structures: array<ShaderStructure>
): bool = glslMembersTypesEqual(
    left.stage,
    right.stage,
    left.members,
    right.members,
    structures
)

fun glslLocationsOverlap(
    first: int,
    firstSize: int,
    second: int,
    secondSize: int
): bool = first < second + secondSize && second < first + firstSize

fun glslReflectStage(stage: string, source: string): GlslStageReflection {
    val includeReflection = glslReflectIncludes(stage, source)
    val lexical = glslLex(source)
    val locations: array<ShaderLocation> = []
    val bindings: array<ShaderBinding> = []
    val workgroups: array<ShaderWorkgroup> = []
    val pushConstants: array<ShaderPushConstant> = []
    val specializationConstants: array<ShaderSpecializationConstant> = []
    val structures: array<ShaderStructure> = []
    val includes = includeReflection.includes
    var valid = includeReflection.valid && lexical.valid
    var error = if (!includeReflection.valid) includeReflection.error
        else if (!lexical.valid)
            "${lexical.error} at ${lexical.errorLine}:${lexical.errorColumn}"
        else ""
    var index = 0
    var scopeDepth = 0
    while (valid && index < source.size) {
        val name = glslReadName(source, index)
        if (scopeDepth == 0 && name.text == "struct") {
            val structureName = glslReadName(source, name.next)
            val body = glslSkipTrivia(source, structureName.next)
            val block = glslParseBlock(source, body)
            if (structureName.text == "" || !block.valid) {
                valid = false
                error = "malformed GLSL $stage structure declaration"
            }
            if (valid && glslStructureIndex(
                stage,
                structureName.text,
                structures
            ) >= 0) {
                valid = false
                error = "duplicate GLSL $stage structure '${structureName.text}'"
            }
            var memberIndex = 0
            while (valid && memberIndex < block.members.size) {
                val member = block.members[memberIndex]
                if (member.arraySize <= 0 || member.offset >= 0 ||
                    member.align >= 0 || member.rowMajor ||
                    member.columnMajor) {
                    valid = false
                    error = "invalid GLSL $stage structure member '${member.name}'"
                } else if (!glslBuiltinType(member.dataType) &&
                    glslStructureIndex(
                        stage,
                        member.dataType,
                        structures
                    ) < 0) {
                    valid = false
                    error = "unknown GLSL $stage structure member type '${member.dataType}'"
                }
                memberIndex = memberIndex + 1
            }
            val instances: array<ShaderStructureInstance> = []
            var instanceIndex = 0
            while (valid && instanceIndex < block.declarators.size) {
                val instance = block.declarators[instanceIndex]
                if (glslStructureInstanceExists(
                    stage,
                    instance.name,
                    structures
                )) {
                    valid = false
                    error = "duplicate GLSL $stage structure instance '${instance.name}'"
                } else {
                    instances.append(ShaderStructureInstance(
                        instance.name,
                        instance.arraySize
                    ))
                }
                instanceIndex = instanceIndex + 1
            }
            if (valid) structures.append(ShaderStructure(
                stage,
                structureName.text,
                block.members,
                instances
            ))
            index = if (block.next > body) block.next else body + 1
        } else if (scopeDepth == 0 && name.text == "layout") {
            val layout = glslParseLayout(source, name.next)
            valid = layout.valid
            if (!valid) error = layout.error
            if (valid) {
                val declaration = glslDeclarationAfterLayout(
                    source,
                    layout.next
                )
                if (layout.pushConstant &&
                    (layout.location >= 0 || layout.setSpecified ||
                     layout.binding >= 0 || layout.localSizeX >= 0 ||
                     layout.localSizeY >= 0 || layout.localSizeZ >= 0 ||
                     layout.localSizeXId >= 0 ||
                     layout.localSizeYId >= 0 ||
                     layout.localSizeZId >= 0 ||
                     layout.constantId >= 0)) {
                    valid = false
                    error = "GLSL $stage push constant has incompatible layout qualifiers"
                }
                if (valid && layout.constantId >= 0 &&
                    (layout.location >= 0 || layout.setSpecified ||
                     layout.binding >= 0 || layout.localSizeX >= 0 ||
                     layout.localSizeY >= 0 || layout.localSizeZ >= 0 ||
                     layout.localSizeXId >= 0 ||
                     layout.localSizeYId >= 0 ||
                     layout.localSizeZId >= 0)) {
                    valid = false
                    error = "GLSL $stage specialization constant has incompatible layout qualifiers"
                }
                if (valid && layout.pushConstant) {
                    if (!declaration.valid ||
                        declaration.storage != "uniform" ||
                        declaration.members.size == 0 ||
                        declaration.arraySize != 1) {
                        valid = false
                        error = "malformed GLSL $stage push constant block"
                    } else if (pushConstants.size > 0) {
                        valid = false
                        error = "duplicate GLSL $stage push constant block"
                    } else {
                        pushConstants.append(ShaderPushConstant(
                            stage,
                            declaration.dataType,
                            declaration.name,
                            declaration.members
                        ))
                    }
                }
                if (valid && layout.constantId >= 0) {
                    val specialization =
                        glslParseSpecializationDeclaration(source, layout.next)
                    if (!specialization.valid) {
                        valid = false
                        error = "malformed GLSL $stage specialization constant"
                    }
                    var duplicate = false
                    var specializationIndex = 0
                    while (valid && !duplicate && specializationIndex <
                        specializationConstants.size) {
                        duplicate = specializationConstants[
                            specializationIndex
                        ].id == layout.constantId
                        specializationIndex = specializationIndex + 1
                    }
                    if (valid && duplicate) {
                        valid = false
                        error = "duplicate GLSL $stage specialization constant id ${layout.constantId}"
                    } else if (valid) {
                        specializationConstants.append(
                            ShaderSpecializationConstant(
                                stage,
                                layout.constantId,
                                specialization.dataType,
                                specialization.name,
                                specialization.defaultValue
                            )
                        )
                    }
                }
                if (valid && layout.location >= 0 &&
                    (declaration.storage == "in" ||
                     declaration.storage == "out")) {
                    if (!declaration.valid) {
                        valid = false
                        error = "malformed GLSL $stage location declaration"
                    }
                    var declaratorIndex = 0
                    var declaratorCount = declaration.declarators.size
                    if (declaratorCount == 0 && declaration.members.size > 0) {
                        declaratorCount = 1
                    }
                    while (valid && declaratorIndex < declaratorCount) {
                        val declarator = if (declaration.declarators.size > 0)
                            declaration.declarators[declaratorIndex]
                            else GlslDeclarator(
                                declaration.name,
                                declaration.arraySize
                            )
                        val knownType = declaration.members.size > 0 ||
                            glslBuiltinType(
                            declaration.dataType
                        ) || glslStructureIndex(
                            stage,
                            declaration.dataType,
                            structures
                        ) >= 0
                        if (!knownType) {
                            valid = false
                            error = "unknown GLSL $stage interface type '${declaration.dataType}'"
                        }
                        val slots = if (declaration.members.size > 0)
                            glslMembersLocationSlots(
                                stage,
                                declaration.members,
                                declarator.arraySize,
                                structures
                            ) else glslLocationSlotsForStage(
                                stage,
                                declaration.dataType,
                                declarator.arraySize,
                                structures
                            )
                        var duplicate = slots <= 0
                        var locationIndex = 0
                        while (valid && !duplicate &&
                            locationIndex < locations.size) {
                            val previous = locations[locationIndex]
                            duplicate = previous.direction ==
                                declaration.storage && glslLocationsOverlap(
                                    previous.location,
                                    if (previous.slots > 0) previous.slots
                                    else glslLocationSlotsForStage(
                                            stage,
                                            previous.dataType,
                                            previous.arraySize,
                                            structures
                                        ),
                                    layout.location,
                                    slots
                                )
                            locationIndex = locationIndex + 1
                        }
                        if (duplicate) {
                            valid = false
                            error = "overlapping GLSL $stage ${declaration.storage} location ${layout.location}"
                        } else {
                            locations.append(ShaderLocation(
                                stage,
                                layout.location,
                                declaration.storage,
                                declaration.dataType,
                                declarator.name,
                                declarator.arraySize,
                                slots,
                                declaration.members
                            ))
                        }
                        declaratorIndex = declaratorIndex + 1
                    }
                }
                if (valid && !layout.pushConstant &&
                    layout.binding >= 0 &&
                    (declaration.storage == "uniform" ||
                     declaration.storage == "buffer")) {
                    if (!declaration.valid) {
                        valid = false
                        error = "malformed GLSL $stage binding declaration"
                    }
                    var declaratorIndex = 0
                    var declaratorCount = declaration.declarators.size
                    if (declaratorCount == 0 && declaration.members.size > 0) {
                        declaratorCount = 1
                    }
                    while (valid && declaratorIndex < declaratorCount) {
                        val declarator = if (declaration.declarators.size > 0)
                            declaration.declarators[declaratorIndex]
                            else GlslDeclarator(
                                declaration.name,
                                declaration.arraySize
                            )
                        var bindingIndex = 0
                        while (valid && bindingIndex < bindings.size) {
                            val previous = bindings[bindingIndex]
                            if (previous.set == layout.set &&
                                previous.binding == layout.binding &&
                                (previous.storage != declaration.storage ||
                                 previous.dataType != declaration.dataType ||
                                 previous.arraySize != declarator.arraySize ||
                                 !glslBlockMembersEqual(
                                     previous.members,
                                     declaration.members
                                 ))) {
                                valid = false
                                error = "incompatible GLSL $stage set ${layout.set} binding ${layout.binding} declarations"
                            }
                            bindingIndex = bindingIndex + 1
                        }
                        if (valid) {
                            bindings.append(ShaderBinding(
                                stage,
                                layout.set,
                                layout.binding,
                                declaration.storage,
                                declaration.dataType,
                                declarator.name,
                                declarator.arraySize,
                                declaration.members
                            ))
                        }
                        declaratorIndex = declaratorIndex + 1
                    }
                }
                if (valid && (layout.localSizeX >= 0 ||
                    layout.localSizeY >= 0 || layout.localSizeZ >= 0 ||
                    layout.localSizeXId >= 0 ||
                    layout.localSizeYId >= 0 ||
                    layout.localSizeZId >= 0)) {
                    if (stage != shaderStageCompute ||
                        declaration.storage != "in") {
                        valid = false
                        error = "invalid GLSL $stage workgroup layout"
                    } else {
                        var x = 1
                        var y = 1
                        var z = 1
                        var xId = -1
                        var yId = -1
                        var zId = -1
                        var xSpecified = false
                        var ySpecified = false
                        var zSpecified = false
                        if (workgroups.size > 0) {
                            val previous = workgroups[0]
                            x = previous.x
                            y = previous.y
                            z = previous.z
                            xId = previous.xId
                            yId = previous.yId
                            zId = previous.zId
                            xSpecified = previous.xSpecified
                            ySpecified = previous.ySpecified
                            zSpecified = previous.zSpecified
                        }
                        if (layout.localSizeX >= 0) {
                            if (xSpecified && x != layout.localSizeX) {
                                valid = false
                            } else {
                                x = layout.localSizeX
                                xSpecified = true
                            }
                        }
                        if (layout.localSizeY >= 0) {
                            if (ySpecified && y != layout.localSizeY) {
                                valid = false
                            } else {
                                y = layout.localSizeY
                                ySpecified = true
                            }
                        }
                        if (layout.localSizeZ >= 0) {
                            if (zSpecified && z != layout.localSizeZ) {
                                valid = false
                            } else {
                                z = layout.localSizeZ
                                zSpecified = true
                            }
                        }
                        if (layout.localSizeXId >= 0) {
                            if (xId >= 0 && xId != layout.localSizeXId) {
                                valid = false
                            } else xId = layout.localSizeXId
                        }
                        if (layout.localSizeYId >= 0) {
                            if (yId >= 0 && yId != layout.localSizeYId) {
                                valid = false
                            } else yId = layout.localSizeYId
                        }
                        if (layout.localSizeZId >= 0) {
                            if (zId >= 0 && zId != layout.localSizeZId) {
                                valid = false
                            } else zId = layout.localSizeZId
                        }
                        valid = valid &&
                            (xId < 0 || (xId != yId && xId != zId)) &&
                            (yId < 0 || yId != zId)
                        if (!valid) {
                            error = "incompatible GLSL compute workgroup layouts"
                        }
                        val merged = ShaderWorkgroup(
                            stage,
                            x,
                            y,
                            z,
                            xId,
                            yId,
                            zId,
                            xSpecified,
                            ySpecified,
                            zSpecified
                        )
                        if (valid && workgroups.size > 0) workgroups[0] = merged
                        else if (valid) workgroups.append(merged)
                    }
                }
                index = if (declaration.next > layout.next)
                    declaration.next else layout.next
            }
        } else if (scopeDepth == 0 && name.text != "" &&
            glslStructureIndex(stage, name.text, structures) >= 0) {
            val structureIndex = glslStructureIndex(
                stage,
                name.text,
                structures
            )
            val variable = glslReadName(source, name.next)
            val afterVariable = glslSkipTrivia(source, variable.next)
            if (variable.text != "" && afterVariable < source.size &&
                source[afterVariable] != 40) {
                val declarators = glslParseDeclarators(source, name.next)
                if (declarators.valid) {
                    var declaratorIndex = 0
                    while (valid && declaratorIndex <
                        declarators.values.size) {
                        val declarator = declarators.values[declaratorIndex]
                        val duplicate = glslStructureInstanceExists(
                            stage,
                            declarator.name,
                            structures
                        )
                        if (duplicate) {
                            valid = false
                            error = "duplicate GLSL $stage structure instance '${declarator.name}'"
                        } else {
                            structures[structureIndex].instances.append(
                                ShaderStructureInstance(
                                    declarator.name,
                                    declarator.arraySize
                                )
                            )
                        }
                        declaratorIndex = declaratorIndex + 1
                    }
                    index = declarators.next
                } else index = name.next
            } else index = name.next
        } else if (name.text != "") index = name.next
        else {
            val skipped = glslSkipTrivia(source, index)
            if (skipped < source.size && source[skipped] == 35) {
                index = glslLineEnd(source, skipped)
            } else if (skipped < source.size && source[skipped] == 34) {
                index = skipped + 1
                while (index < source.size && source[index] != 34 &&
                    source[index] != 10 && source[index] != 13) {
                    if (source[index] == 92 && index + 1 < source.size) {
                        index = index + 2
                    } else index = index + 1
                }
                if (index < source.size && source[index] == 34) {
                    index = index + 1
                }
            } else {
                if (skipped < source.size && source[skipped] == 123) {
                    scopeDepth = scopeDepth + 1
                } else if (skipped < source.size &&
                    source[skipped] == 125 && scopeDepth > 0) {
                    scopeDepth = scopeDepth - 1
                }
                index = skipped + 1
            }
        }
    }
    var workgroupIndex = 0
    while (valid && workgroupIndex < workgroups.size) {
        val workgroup = workgroups[workgroupIndex]
        if (!workgroup.xSpecified && !workgroup.ySpecified &&
            !workgroup.zSpecified) {
            valid = false
            error = "GLSL compute workgroup has no fixed local size"
        }
        var specializationIndex = 0
        while (valid && specializationIndex <
            specializationConstants.size) {
            val id = specializationConstants[specializationIndex].id
            if (id == workgroup.xId || id == workgroup.yId ||
                id == workgroup.zId) {
                valid = false
                error = "duplicate GLSL $stage specialization constant id $id"
            }
            specializationIndex = specializationIndex + 1
        }
        workgroupIndex = workgroupIndex + 1
    }
    GlslStageReflection(
        locations,
        bindings,
        workgroups,
        pushConstants,
        specializationConstants,
        includes,
        valid,
        error,
        structures
    )
}

fun glslBlockMembersEqual(
    left: array<ShaderBlockMember>,
    right: array<ShaderBlockMember>
): bool {
    var equal = left.size == right.size
    var index = 0
    while (equal && index < left.size) {
        equal = left[index].dataType == right[index].dataType &&
            left[index].name == right[index].name &&
            left[index].arraySize == right[index].arraySize &&
            left[index].offset == right[index].offset &&
            left[index].align == right[index].align &&
            left[index].rowMajor == right[index].rowMajor &&
            left[index].columnMajor == right[index].columnMajor
        index = index + 1
    }
    equal
}

fun glslStageNameValid(name: string): bool =
    name == shaderStageVertex ||
    name == shaderStageFragment ||
    name == shaderStageCompute ||
    name == shaderStageGeometry ||
    name == shaderStageTessellationControl ||
    name == shaderStageTessellationEvaluation

fun glslRasterStageOrder(stage: string): int {
    var order = -1
    if (stage == shaderStageVertex) order = 0
    else if (stage == shaderStageTessellationControl) order = 1
    else if (stage == shaderStageTessellationEvaluation) order = 2
    else if (stage == shaderStageGeometry) order = 3
    else if (stage == shaderStageFragment) order = 4
    order
}

fun glslPreviousRasterStage(names: array<string>, stage: string): string {
    val order = glslRasterStageOrder(stage)
    var previous = ""
    var previousOrder = -1
    var index = 0
    while (index < names.size) {
        val candidateOrder = glslRasterStageOrder(names[index])
        if (candidateOrder >= 0 && candidateOrder < order &&
            candidateOrder > previousOrder) {
            previous = names[index]
            previousOrder = candidateOrder
        }
        index = index + 1
    }
    previous
}

fun glslRasterInterfacesError(
    names: array<string>,
    locations: array<ShaderLocation>,
    structures: array<ShaderStructure>
): string {
    var error = ""
    var index = 0
    while (error == "" && index < locations.size) {
        val input = locations[index]
        if (input.direction == "in") {
            val previous = glslPreviousRasterStage(names, input.stage)
            if (previous != "") {
                var outputIndex = 0
                var matched = false
                while (!matched && outputIndex < locations.size) {
                    val output = locations[outputIndex]
                    if (output.stage == previous && output.direction == "out" &&
                        output.location == input.location) {
                        matched = true
                        if (output.dataType != input.dataType ||
                            !glslLocationMembersEqual(
                                output,
                                input,
                                structures
                            ) ||
                            !glslStructureTypeEqual(
                                output.stage,
                                input.stage,
                                input.dataType,
                                structures
                            )) {
                            error = "GLSL interface type mismatch at location ${input.location}: ${output.dataType} from $previous, ${input.dataType} in ${input.stage}"
                        }
                    }
                    outputIndex = outputIndex + 1
                }
                if (!matched) {
                    error = "GLSL ${input.stage} input location ${input.location} has no $previous output"
                }
            }
        }
        index = index + 1
    }
    error
}

fun glslPackage(
    names: array<string>,
    sources: array<string>
): ShaderPackage {
    val stages: array<ShaderStageSource> = []
    val locations: array<ShaderLocation> = []
    val bindings: array<ShaderBinding> = []
    val workgroups: array<ShaderWorkgroup> = []
    val pushConstants: array<ShaderPushConstant> = []
    val specializationConstants: array<ShaderSpecializationConstant> = []
    val includes: array<ShaderInclude> = []
    val structures: array<ShaderStructure> = []
    var valid = names.size == sources.size && names.size > 0
    var error = if (valid) "" else "GLSL package has no stages"
    var compute = false
    var raster = false
    var index = 0
    while (valid && index < names.size) {
        if (!glslStageNameValid(names[index]) || sources[index] == "" ||
            glslContainsText(
                sources[index],
                "__invalid_negative_uint__"
            )) {
            valid = false
            error = if (glslContainsText(
                sources[index],
                "__invalid_negative_uint__"
            )) "GLSL uint interpolation cannot be negative"
            else "GLSL package contains an invalid or empty stage"
        }
        var previous = 0
        while (valid && previous < index) {
            if (names[previous] == names[index]) {
                valid = false
                error = "GLSL package repeats stage '${names[index]}'"
            }
            previous = previous + 1
        }
        if (valid) {
            compute = compute || names[index] == shaderStageCompute
            raster = raster || names[index] != shaderStageCompute
            val reflection = glslReflectStage(names[index], sources[index])
            if (!reflection.valid) {
                valid = false
                error = reflection.error
            }
            var reflectedIndex = 0
            while (valid && reflectedIndex < reflection.structures.size) {
                structures.append(reflection.structures[reflectedIndex])
                reflectedIndex = reflectedIndex + 1
            }
            reflectedIndex = 0
            while (valid && reflectedIndex < reflection.locations.size) {
                locations.append(reflection.locations[reflectedIndex])
                reflectedIndex = reflectedIndex + 1
            }
            reflectedIndex = 0
            while (valid && reflectedIndex < reflection.bindings.size) {
                val reflected = reflection.bindings[reflectedIndex]
                var bindingIndex = 0
                while (valid && bindingIndex < bindings.size) {
                    val previous = bindings[bindingIndex]
                    if (previous.set == reflected.set &&
                        previous.binding == reflected.binding &&
                        (previous.storage != reflected.storage ||
                         previous.dataType != reflected.dataType ||
                         previous.arraySize != reflected.arraySize ||
                         !glslStructureTypeEqual(
                             previous.stage,
                             reflected.stage,
                             reflected.dataType,
                             structures
                         ) ||
                         !glslMembersTypesEqual(
                             previous.stage,
                             reflected.stage,
                             previous.members,
                             reflected.members,
                             structures
                         ))) {
                        valid = false
                        error = "incompatible GLSL set ${reflected.set} binding ${reflected.binding} declarations"
                    }
                    bindingIndex = bindingIndex + 1
                }
                if (valid) bindings.append(reflected)
                reflectedIndex = reflectedIndex + 1
            }
            reflectedIndex = 0
            while (valid && reflectedIndex < reflection.workgroups.size) {
                workgroups.append(reflection.workgroups[reflectedIndex])
                reflectedIndex = reflectedIndex + 1
            }
            reflectedIndex = 0
            while (valid && reflectedIndex < reflection.pushConstants.size) {
                val reflected = reflection.pushConstants[reflectedIndex]
                var pushIndex = 0
                while (valid && pushIndex < pushConstants.size) {
                    val previous = pushConstants[pushIndex]
                    if (previous.dataType != reflected.dataType ||
                        !glslMembersTypesEqual(
                            previous.stage,
                            reflected.stage,
                            previous.members,
                            reflected.members,
                            structures
                        )) {
                        valid = false
                        error = "incompatible GLSL push constant block declarations"
                    }
                    pushIndex = pushIndex + 1
                }
                if (valid) pushConstants.append(reflected)
                reflectedIndex = reflectedIndex + 1
            }
            reflectedIndex = 0
            while (valid && reflectedIndex <
                reflection.specializationConstants.size) {
                specializationConstants.append(
                    reflection.specializationConstants[reflectedIndex]
                )
                reflectedIndex = reflectedIndex + 1
            }
            reflectedIndex = 0
            while (valid && reflectedIndex < reflection.includes.size) {
                includes.append(reflection.includes[reflectedIndex])
                reflectedIndex = reflectedIndex + 1
            }
        }
        if (valid) {
            stages.append(ShaderStageSource(names[index], sources[index]))
        }
        index = index + 1
    }
    if (valid && compute && raster) {
        valid = false
        error = "compute and raster GLSL stages cannot share one package"
    }
    if (valid && raster) {
        val interfaceError = glslRasterInterfacesError(
            names,
            locations,
            structures
        )
        if (interfaceError != "") {
            valid = false
            error = interfaceError
        }
    }
    ShaderPackage(
        stages,
        locations,
        bindings,
        workgroups,
        pushConstants,
        specializationConstants,
        includes,
        valid,
        error,
        structures
    )
}

fun glslPackageSpanned(
    names: array<string>,
    sources: array<string>,
    identities: array<string>,
    begins: array<int>,
    ends: array<int>
): ShaderPackage {
    var result = glslPackage(names, sources)
    var spansValid = identities.size == names.size &&
        begins.size == names.size && ends.size == names.size
    var index = 0
    while (spansValid && index < names.size) {
        spansValid = identities[index] != "" && begins[index] >= 0 &&
            ends[index] >= begins[index]
        index = index + 1
    }
    if (!spansValid) {
        result = glslInvalidPackage("GLSL stage spans are inconsistent")
    } else if (result.valid) {
        index = 0
        while (index < result.stages.size) {
            result.stages[index] = ShaderStageSource(
                result.stages[index].kind,
                result.stages[index].source,
                identities[index],
                begins[index],
                ends[index]
            )
            index = index + 1
        }
    }
    result
}

fun glslInvalidPackage(error: string): ShaderPackage = ShaderPackage(
    [],
    [],
    [],
    [],
    [],
    [],
    [],
    false,
    error
)

fun glslModuleKey(path: string, system: bool): string =
    "${if (system) "system" else "local"}:$path"

fun glslResolveSource(
    stage: string,
    source: string,
    modules: array<GlslModule>,
    stack: array<string>
): GlslResolvedSource {
    val reflection = glslReflectIncludes(stage, source)
    var valid = reflection.valid
    var error = reflection.error
    var result = ""
    var cursor = 0
    var includeIndex = 0
    while (valid && includeIndex < reflection.includes.size) {
        val include = reflection.includes[includeIndex]
        var moduleIndex = 0
        var matched = -1
        while (moduleIndex < modules.size) {
            if (modules[moduleIndex].path == include.path &&
                modules[moduleIndex].system == include.system) {
                matched = moduleIndex
            }
            moduleIndex = moduleIndex + 1
        }
        if (matched < 0) {
            valid = false
            error = "unresolved GLSL $stage include '${include.path}'"
        }
        val key = glslModuleKey(include.path, include.system)
        var cycle = false
        var stackIndex = 0
        while (!cycle && stackIndex < stack.size) {
            cycle = stack[stackIndex] == key
            stackIndex = stackIndex + 1
        }
        if (valid && cycle) {
            valid = false
            error = "cyclic GLSL $stage include '$key'"
        } else if (valid && stack.size >= 64) {
            valid = false
            error = "GLSL $stage include depth exceeds 64 modules"
        }
        if (valid) {
            val nextStack: array<string> = []
            stackIndex = 0
            while (stackIndex < stack.size) {
                nextStack.append(stack[stackIndex])
                stackIndex = stackIndex + 1
            }
            nextStack.append(key)
            val nested = glslResolveSource(
                stage,
                modules[matched].source,
                modules,
                nextStack
            )
            if (!nested.valid) {
                valid = false
                error = nested.error
            } else {
                result = "$result${source.slice(cursor, include.begin)}${nested.source}"
                cursor = include.end
            }
        }
        includeIndex = includeIndex + 1
    }
    if (valid) result = "$result${source.slice(cursor, source.size)}"
    GlslResolvedSource(valid, result, error)
}

fun ShaderPackage.resolveIncludes(
    modules: array<GlslModule>
): ShaderPackage {
    var valid = this.valid
    var error = this.error
    var moduleIndex = 0
    while (valid && moduleIndex < modules.size) {
        val module = modules[moduleIndex]
        if (module.path == "" || module.source == "") {
            valid = false
            error = "GLSL module path and source must be non-empty"
        }
        var previous = 0
        while (valid && previous < moduleIndex) {
            if (modules[previous].path == module.path &&
                modules[previous].system == module.system) {
                valid = false
                error = "duplicate GLSL module '${glslModuleKey(
                    module.path,
                    module.system
                )}'"
            }
            previous = previous + 1
        }
        moduleIndex = moduleIndex + 1
    }
    val names: array<string> = []
    val sources: array<string> = []
    val identities: array<string> = []
    val begins: array<int> = []
    val ends: array<int> = []
    var spanned = true
    var stageIndex = 0
    while (valid && stageIndex < this.stages.size) {
        val stage = this.stages[stageIndex]
        val resolved = glslResolveSource(stage.kind, stage.source, modules, [])
        if (!resolved.valid) {
            valid = false
            error = resolved.error
        } else {
            names.append(stage.kind)
            sources.append(resolved.source)
            identities.append(stage.sourceIdentity)
            begins.append(stage.begin)
            ends.append(stage.end)
            spanned = spanned && stage.sourceIdentity != "" &&
                stage.begin >= 0 && stage.end >= stage.begin
        }
        stageIndex = stageIndex + 1
    }
    if (!valid) glslInvalidPackage(error)
    else if (spanned) glslPackageSpanned(
        names,
        sources,
        identities,
        begins,
        ends
    )
    else glslPackage(names, sources)
}

compile fun glslAppend(left: string, right: string): string = "$left$right"

fun glslSourceAppend(left: string, right: string): string = "$left$right"

fun glslInterpolationInt(value: int): string = "$value"

fun glslInterpolationUint(value: int): string = if (value >= 0)
    "$value" else "__invalid_negative_uint__"

fun glslInterpolationBool(value: bool): string = if (value)
    "true" else "false"

compile fun glslSyntaxAppend(
    left: SyntaxExpression,
    right: SyntaxExpression
): SyntaxExpression {
    val arguments: array<SyntaxExpression> = []
    arguments.append(left)
    arguments.append(right)
    syntaxCall("glslSourceAppend", arguments)
}

compile fun glslSyntaxAppendText(
    left: SyntaxExpression,
    right: string
): SyntaxExpression = glslSyntaxAppend(left, syntaxString(right))

compile fun glslSyntaxInterpolation(
    name: string,
    value: SyntaxExpression
): SyntaxExpression {
    val arguments: array<SyntaxExpression> = []
    arguments.append(value)
    syntaxCall(name, arguments)
}

compile fun glslReadLineComment(cursor: ParserCursor): string {
    parserRawExpect(cursor, "//")
    var result = "//"
    result = glslAppend(result, parserRawTakeUntil(cursor, "\r\n"))
    if (parserRawConsume(cursor, "\r")) result = glslAppend(result, "\r")
    if (parserRawConsume(cursor, "\n")) result = glslAppend(result, "\n")
    result
}

compile fun glslReadBlockComment(cursor: ParserCursor): string {
    parserRawExpect(cursor, "/*")
    var result = "/*"
    var closed = false
    while (!closed && !parserRawEnd(cursor)) {
        result = glslAppend(result, parserRawTakeUntil(cursor, "*"))
        if (parserRawConsume(cursor, "*")) {
            result = glslAppend(result, "*")
            if (parserRawConsume(cursor, "/")) {
                result = glslAppend(result, "/")
                closed = true
            }
        }
    }
    if (!closed) parserFail(cursor, "unterminated GLSL block comment")
    result
}

compile fun glslReadQuotedText(cursor: ParserCursor): string {
    parserRawExpect(cursor, "\"")
    var result = "\""
    var closed = false
    while (!closed && !parserRawEnd(cursor)) {
        result = glslAppend(result, parserRawTakeUntil(cursor, "\\\""))
        if (parserRawConsume(cursor, "\"")) {
            result = glslAppend(result, "\"")
            closed = true
        } else if (parserRawConsume(cursor, "\\")) {
            result = glslAppend(result, "\\")
            if (parserRawConsume(cursor, "\"")) {
                result = glslAppend(result, "\"")
            } else if (parserRawConsume(cursor, "\\")) {
                result = glslAppend(result, "\\")
            } else if (parserRawConsume(cursor, "n")) {
                result = glslAppend(result, "n")
            } else if (parserRawConsume(cursor, "r")) {
                result = glslAppend(result, "r")
            } else if (parserRawConsume(cursor, "t")) {
                result = glslAppend(result, "t")
            } else parserFail(cursor, "unsupported GLSL quoted-text escape")
        }
    }
    if (!closed) parserFail(cursor, "unterminated GLSL quoted text")
    result
}

compile fun glslReadStageBody(cursor: ParserCursor): SyntaxExpression {
    var result = syntaxString("")
    var staticText = ""
    var dynamic = false
    var depth = 1
    while (depth > 0 && !parserRawEnd(cursor)) {
        val text = parserRawTakeUntil(cursor, "{}/\"$")
        staticText = glslAppend(staticText, text)
        if (parserRawAt(cursor, "//")) {
            staticText = glslAppend(
                staticText,
                glslReadLineComment(cursor)
            )
        } else if (parserRawAt(cursor, "/*")) {
            staticText = glslAppend(
                staticText,
                glslReadBlockComment(cursor)
            )
        } else if (parserRawConsume(cursor, "/")) {
            staticText = glslAppend(staticText, "/")
        } else if (parserRawAt(cursor, "\${")) {
            parserRawExpect(cursor, "\${")
            parserRawSkipWhitespace(cursor)
            var interpolationName = "glslInterpolationInt"
            if (parserRawConsume(cursor, "int:")) {
                interpolationName = "glslInterpolationInt"
                parserRawSkipWhitespace(cursor)
            } else if (parserRawConsume(cursor, "uint:")) {
                interpolationName = "glslInterpolationUint"
                parserRawSkipWhitespace(cursor)
            } else if (parserRawConsume(cursor, "float:")) {
                parserFail(
                    cursor,
                    "GLSL float interpolation requires deterministic Abla float formatting"
                )
            } else if (parserRawConsume(cursor, "bool:")) {
                interpolationName = "glslInterpolationBool"
                parserRawSkipWhitespace(cursor)
            }
            val interpolation = parserParseAblaExpression(cursor)
            parserRawExpect(cursor, "}")
            result = glslSyntaxAppendText(result, staticText)
            staticText = ""
            result = glslSyntaxAppend(
                result,
                glslSyntaxInterpolation(interpolationName, interpolation)
            )
            dynamic = true
        } else if (parserRawConsume(cursor, "$")) {
            staticText = glslAppend(staticText, "$")
        } else if (parserRawConsume(cursor, "{")) {
            depth = depth + 1
            staticText = glslAppend(staticText, "{")
        } else if (parserRawConsume(cursor, "}")) {
            depth = depth - 1
            if (depth > 0) staticText = glslAppend(staticText, "}")
        } else if (parserRawAt(cursor, "\"")) {
            staticText = glslAppend(
                staticText,
                glslReadQuotedText(cursor)
            )
        }
    }
    if (depth != 0) parserFail(cursor, "unterminated GLSL stage block")
    if (dynamic) glslSyntaxAppendText(result, staticText)
    else syntaxString(staticText)
}

compile fun glslParsePackage(cursor: ParserCursor): SyntaxExpression {
    parserRawSkipWhitespace(cursor)
    parserRawExpect(cursor, "{")
    val names: array<SyntaxExpression> = []
    val sources: array<SyntaxExpression> = []
    val identities: array<SyntaxExpression> = []
    val begins: array<SyntaxExpression> = []
    val ends: array<SyntaxExpression> = []
    val measuredNames: array<string> = []
    val sourceIdentity = parserSourceIdentity(cursor)
    var done = false
    while (!done && !parserRawEnd(cursor)) {
        parserRawSkipWhitespace(cursor)
        if (parserRawConsume(cursor, "}")) {
            done = true
        } else {
            val name = parserRawTakeName(cursor)
            if (!glslStageNameValid(name)) {
                parserFail(cursor, "unknown GLSL stage '$name'")
            }
            var duplicate = false
            var index = 0
            while (!duplicate && index < measuredNames.size) {
                duplicate = measuredNames[index] == name
                index = index + 1
            }
            if (duplicate) parserFail(cursor, "duplicate GLSL stage '$name'")
            measuredNames.append(name)
            parserRawSkipWhitespace(cursor)
            parserRawExpect(cursor, "{")
            val begin = parserRawPosition(cursor)
            val source = glslReadStageBody(cursor)
            val end = parserRawPosition(cursor) - 1
            names.append(syntaxString(name))
            sources.append(source)
            identities.append(syntaxString(sourceIdentity))
            begins.append(syntaxInteger(begin))
            ends.append(syntaxInteger(end))
        }
    }
    if (!done) parserFail(cursor, "unterminated GLSL package")
    val arguments: array<SyntaxExpression> = []
    arguments.append(syntaxArray(names))
    arguments.append(syntaxArray(sources))
    arguments.append(syntaxArray(identities))
    arguments.append(syntaxArray(begins))
    arguments.append(syntaxArray(ends))
    syntaxCall("glslPackageSpanned", arguments)
}

#compilerRegisterSubparser("glsl", glslParsePackage)
