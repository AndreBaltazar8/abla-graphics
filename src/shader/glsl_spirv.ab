                valid = scanDepth == 0
                body.append(131321)
                body.append(headerId)
                body.append(131320)
                body.append(headerId)
                currentBlockId = headerId
                val localBase = loopDepth * 64
                while (loopLocalPhiIds.size < localBase + 64) {
                    loopLocalPhiIds.append(-1)
                    loopLocalPatchIndices.append(-1)
                    loopEntryLocalIds.append(-1)
                }
                val edgeBase = loopDepth * 64
                while (loopContinuePredecessorIds.size < edgeBase + 64) {
                    loopContinuePredecessorIds.append(-1)
                    loopBreakPredecessorIds.append(-1)
                }
                val edgeLocalBase = loopDepth * 4096
                while (loopContinueLocalIds.size < edgeLocalBase + 4096) {
                    loopContinueLocalIds.append(-1)
                    loopBreakLocalIds.append(-1)
                }
                local = 0
                while (valid && local < localIds.size) {
                    loopLocalPhiIds[localBase + local] = -1
                    loopLocalPatchIndices[localBase + local] = -1
                    loopEntryLocalIds[localBase + local] = localIds[local]
                    if (mutated[local]) {
                        val phiId = nextId
                        nextId = nextId + 1
                        body.append(458997)
                        body.append(if (emittedLocalTypes[local] == 1)
                            booleanTypeId else 3)
                        body.append(phiId)
                        body.append(localIds[local])
                        body.append(predecessorId)
                        val patchIndex = body.size
                        body.append(-1)
                        body.append(continueId)
                        loopLocalPhiIds[localBase + local] = phiId
                        loopLocalPatchIndices[localBase + local] = patchIndex
                        localIds[local] = phiId
                    }
                    local = local + 1
                }
                if (loopDepth < loopHeaderIds.size) {
                    loopHeaderIds[loopDepth] = headerId
                    loopBodyIds[loopDepth] = bodyId
                    loopContinueIds[loopDepth] = continueId
                    loopMergeIds[loopDepth] = mergeId
                    loopConditionEmitted[loopDepth] = false
                    loopLocalCounts[loopDepth] = localIds.size
                    loopContinueEdgeCounts[loopDepth] = 0
                    loopBreakEdgeCounts[loopDepth] = 0
                } else {
                    loopHeaderIds.append(headerId)
                    loopBodyIds.append(bodyId)
                    loopContinueIds.append(continueId)
                    loopMergeIds.append(mergeId)
                    loopConditionEmitted.append(false)
                    loopLocalCounts.append(localIds.size)
                    loopContinueEdgeCounts.append(0)
                    loopBreakEdgeCounts.append(0)
                }
                loopDepth = loopDepth + 1
            }
        } else if (token.kind == glslStorageTokenWhileCondition) {
            pushesResult = false
            valid = loopDepth > 0 && stackSize == 1 &&
