            }
        } else if (token.kind == glslStorageTokenBreak ||
            token.kind == glslStorageTokenContinue) {
            pushesResult = false
            valid = loopDepth > 0 && stackSize == 0
            if (valid) {
                val loopIndex = loopDepth - 1
                val isContinue = token.kind == glslStorageTokenContinue
                val edge = if (isContinue)
                    loopContinueEdgeCounts[loopIndex]
                else loopBreakEdgeCounts[loopIndex]
                valid = edge >= 0 && edge < 64 &&
                    localIds.size == loopLocalCounts[loopIndex]
                if (valid) {
                    val predecessorIndex = loopIndex * 64 + edge
                    val edgeLocalBase = loopIndex * 4096 + edge * 64
                    if (isContinue) {
                        loopContinuePredecessorIds[predecessorIndex] =
                            currentBlockId
                    } else loopBreakPredecessorIds[predecessorIndex] =
                        currentBlockId
                    var local = 0
                    while (local < localIds.size) {
                        if (isContinue) {
                            loopContinueLocalIds[edgeLocalBase + local] =
                                localIds[local]
                        } else loopBreakLocalIds[edgeLocalBase + local] =
                            localIds[local]
