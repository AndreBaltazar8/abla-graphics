                }
                var scan = tokenIndex + 1
                var scanDepth = 1
                while (scan < write.tokens.size && scanDepth > 0) {
                    val found = write.tokens[scan]
                    if (found.kind == glslStorageTokenWhileBegin) {
                        scanDepth = scanDepth + 1
