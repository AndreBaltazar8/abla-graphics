                    body.append(loopHeaderIds[loopIndex])
                    body.append(131320)
                    body.append(loopMergeIds[loopIndex])
                    val breakCount = loopBreakEdgeCounts[loopIndex]
                    local = 0
                    while (valid && local < localIds.size) {
                        val phiId = loopLocalPhiIds[localBase + local]
                        val headerValue = if (phiId >= 0) phiId
                            else loopEntryLocalIds[localBase + local]
                        var resultValue = headerValue
                        var allSame = true
                        var edge = 0
                        while (edge < breakCount) {
                            allSame = allSame && loopBreakLocalIds[
                                loopIndex * 4096 + edge * 64 + local
                            ] == headerValue
