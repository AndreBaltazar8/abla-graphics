    var valid = first.valid
    var index = first.next
    var done = false
    while (valid && !done && tokens.size < 128) {
        val operator = glslSkipTrivia(source, index)
        if (operator < source.size && source[operator] == 124) {
            valid = operator + 1 >= source.size ||
                source[operator + 1] != 124
            if (valid) {
                val right = glslStorageBitwiseXor(
                    source,
                    operator + 1,
                    signed,
                    specializationName,
                    specializationDefault,
                    specializationId
                )
                valid = right.valid
                if (valid) {
                    val copied = glslStorageTokensCopy(right.tokens)
                    var copiedIndex = 0
                    while (copiedIndex < copied.size) {
                        tokens.append(copied[copiedIndex])
                        copiedIndex = copiedIndex + 1
                    }
                    tokens.append(GlslStorageToken(
                        glslStorageTokenOperation,
                        opcode = 327877
                    ))
                    index = right.next
                }
            }
        } else done = true
    }
    GlslStorageExpression(valid && tokens.size < 128, tokens, index)
}

fun glslComputeStorageWrite(source: string): GlslStorageWrite {
    var index = glslSkipTrivia(source, 0)
    var valid = index < source.size && source[index] == 35
    var part = glslReadName(source, index + 1)
    valid = valid && part.text == "version"
    val version = glslReadUnsigned(source, part.next)
    valid = valid && version.valid && version.value == 450
    index = glslSkipLine(source, version.next)

    var specializationName = ""
    var specializationId = -1
    var specializationDefault = 0
    var specializationType = ""
    part = glslReadName(source, index)
    if (part.text == "layout") {
        val specializationLayout = glslParseLayout(source, part.next)
        if (specializationLayout.valid &&
            specializationLayout.constantId >= 0) {
            val specialization = glslParseSpecializationDeclaration(
                source,
                specializationLayout.next
            )
            val default = if (specialization.dataType == "uint" ||
                specialization.dataType == "int") glslIntegerDefault(
                    specialization.defaultValue,
                    specialization.dataType == "int"
                )
                else GlslSpirvDefault(false)
            valid = valid && specialization.valid && default.valid
            if (valid) {
                specializationName = specialization.name
                specializationId = specializationLayout.constantId
                specializationDefault = default.bits
                specializationType = specialization.dataType
                index = specialization.next
                part = glslReadName(source, index)
            }
        }
    }
    valid = valid && part.text == "layout"
    val workgroup = glslParseLayout(source, part.next)
    valid = valid && workgroup.valid && workgroup.localSizeX == 1 &&
        (workgroup.localSizeY < 0 || workgroup.localSizeY == 1) &&
        (workgroup.localSizeZ < 0 || workgroup.localSizeZ == 1)
    part = glslReadName(source, workgroup.next)
    valid = valid && part.text == "in"
    var character = glslExpectCharacter(source, part.next, 59)
    valid = valid && character.valid
    index = character.next

    part = glslReadName(source, index)
    valid = valid && part.text == "layout"
    val binding = glslParseLayout(source, part.next)
    valid = valid && binding.valid && binding.set == 0 &&
        binding.binding == 0
    part = glslReadName(source, binding.next)
    valid = valid && part.text == "buffer"
    part = glslReadName(source, part.next)
    valid = valid && part.text == "Values"
    character = glslExpectCharacter(source, part.next, 123)
    valid = valid && character.valid
    part = glslReadName(source, character.next)
    val signed = part.text == "int"
    valid = valid && (signed || part.text == "uint") &&
        (specializationType == "" ||
         specializationType == (if (signed) "int" else "uint"))
    part = glslReadName(source, part.next)
    valid = valid && part.text == "value"
    character = glslExpectCharacter(source, part.next, 59)
    valid = valid && character.valid
    character = glslExpectCharacter(source, character.next, 125)
    valid = valid && character.valid
    part = glslReadName(source, character.next)
    valid = valid && part.text == "values"
    character = glslExpectCharacter(source, part.next, 59)
    valid = valid && character.valid

    part = glslReadName(source, character.next)
    valid = valid && part.text == "void"
    part = glslReadName(source, part.next)
    valid = valid && part.text == "main"
    character = glslExpectCharacter(source, part.next, 40)
    valid = valid && character.valid
    character = glslExpectCharacter(source, character.next, 41)
    valid = valid && character.valid
    character = glslExpectCharacter(source, character.next, 123)
    valid = valid && character.valid
    part = glslReadName(source, character.next)
    valid = valid && part.text == "values"
    character = glslExpectCharacter(source, part.next, 46)
    valid = valid && character.valid
    part = glslReadName(source, character.next)
    valid = valid && part.text == "value"
    character = glslExpectCharacter(source, part.next, 61)
    valid = valid && character.valid
    val expression = glslStorageBitwiseOr(
        source,
        character.next,
        signed,
        specializationName,
        specializationDefault,
        specializationId
    )
    valid = valid && expression.valid
    character = glslExpectCharacter(source, expression.next, 59)
    valid = valid && character.valid
    character = glslExpectCharacter(source, character.next, 125)
    valid = valid && character.valid &&
        glslSkipTrivia(source, character.next) == source.size
    GlslStorageWrite(
        valid,
        signed,
        expression.tokens,
        specializationName != "" && glslStorageExpressionSpecialized(
            expression.tokens
        )
    )
}

fun glslStorageSpirv(write: GlslStorageWrite): array<int> {
    val tokenIds: array<int> = []
    var tokenIndex = 0
    while (tokenIndex < write.tokens.size) {
        tokenIds.append(-1)
        tokenIndex = tokenIndex + 1
    }
    var nextId = 8
    var specializationResultId = -1
    tokenIndex = 0
    while (tokenIndex < write.tokens.size) {
        val token = write.tokens[tokenIndex]
        if (token.kind == glslStorageTokenLiteral) {
            tokenIds[tokenIndex] = nextId
            nextId = nextId + 1
        } else if (token.kind == glslStorageTokenSpecialization) {
            if (specializationResultId < 0) {
                specializationResultId = nextId
                nextId = nextId + 1
            }
            tokenIds[tokenIndex] = specializationResultId
        }
        tokenIndex = tokenIndex + 1
    }
    val variableId = nextId
    nextId = nextId + 1
    val mainId = nextId
    nextId = nextId + 1
    val labelId = nextId
    nextId = nextId + 1
    val pointerId = nextId
    nextId = nextId + 1
    val body: array<int> = []
    val stack: array<int> = []
    var stackSize = 0
    var valid = write.valid
    tokenIndex = 0
    while (valid && tokenIndex < write.tokens.size) {
        val token = write.tokens[tokenIndex]
        var resultId = tokenIds[tokenIndex]
        if (token.kind == glslStorageTokenLoad) {
            resultId = nextId
            nextId = nextId + 1
            body.append(262205)
            body.append(3)
            body.append(resultId)
            body.append(pointerId)
        } else if (token.kind == glslStorageTokenOperation) {
            valid = (token.arity == 1 || token.arity == 2) &&
                stackSize >= token.arity && token.opcode != 0
            if (valid) {
                resultId = nextId
                nextId = nextId + 1
                body.append(token.opcode)
                body.append(3)
                body.append(resultId)
                if (token.arity == 2) {
                    body.append(stack[stackSize - 2])
                    body.append(stack[stackSize - 1])
                } else body.append(stack[stackSize - 1])
                stackSize = stackSize - token.arity
            }
        }
        if (valid) {
            if (stackSize < stack.size) stack[stackSize] = resultId
            else stack.append(resultId)
            stackSize = stackSize + 1
        }
        tokenIndex = tokenIndex + 1
    }
    valid = valid && stackSize == 1
    if (!valid) {
        val empty: array<int> = []
        return empty
    }
    val words: array<int> = [
        spirvMagic, spirvVersion10, 0, nextId, 0,
        131089, 1,
        196622, 0, 1,
        327695, 5, mainId, 1852399981, 0,
        393232, mainId, 17, 1, 1, 1,
        196679, 4, 3,
        327752, 4, 0, 35, 0,
        262215, variableId, 34, 0,
        262215, variableId, 33, 0
    ]
    if (specializationResultId >= 0) {
        var specializationId = -1
        tokenIndex = 0
        while (specializationId < 0 && tokenIndex < write.tokens.size) {
            if (write.tokens[tokenIndex].kind ==
                glslStorageTokenSpecialization) {
                specializationId = write.tokens[tokenIndex].specializationId
            }
            tokenIndex = tokenIndex + 1
        }
        words.append(262215)
        words.append(specializationResultId)
        words.append(1)
        words.append(specializationId)
    }
    val declarations: array<int> = [
        131091, 1,
        196641, 2, 1,
        262165, 3, 32, if (write.signed) 1 else 0,
        196638, 4, 3,
        262176, 5, 2, 4,
        262176, 6, 2, 3,
        262187, 3, 7, 0
    ]
    var wordIndex = 0
    while (wordIndex < declarations.size) {
        words.append(declarations[wordIndex])
        wordIndex = wordIndex + 1
    }
    var specializationDeclared = false
    tokenIndex = 0
    while (tokenIndex < write.tokens.size) {
        val token = write.tokens[tokenIndex]
        if (token.kind == glslStorageTokenLiteral) {
            words.append(262187)
            words.append(3)
            words.append(tokenIds[tokenIndex])
            words.append(token.value)
        } else if (token.kind == glslStorageTokenSpecialization &&
            !specializationDeclared) {
            words.append(262194)
            words.append(3)
            words.append(specializationResultId)
            words.append(token.value)
            specializationDeclared = true
        }
        tokenIndex = tokenIndex + 1
    }
    val functionPrefix: array<int> = [
        262203, 5, variableId, 2,
        327734, 1, mainId, 0, 2,
        131320, labelId,
        327745, 6, pointerId, variableId, 7
    ]
    wordIndex = 0
    while (wordIndex < functionPrefix.size) {
        words.append(functionPrefix[wordIndex])
        wordIndex = wordIndex + 1
    }
    wordIndex = 0
    while (wordIndex < body.size) {
        words.append(body[wordIndex])
        wordIndex = wordIndex + 1
    }
    words.append(196670)
    words.append(pointerId)
    words.append(stack[0])
    words.append(65789)
    words.append(65592)
    words
}

fun glslSourceMatchesTokens(
    source: string,
    tokens: array<string>
): bool {
    var sourceIndex = 0
    var tokenIndex = 0
    var matches = true
    while (matches && tokenIndex < tokens.size) {
        sourceIndex = glslSkipTrivia(source, sourceIndex)
        val token = tokens[tokenIndex]
        var character = 0
        while (matches && character < token.size) {
            matches = sourceIndex + character < source.size &&
                source[sourceIndex + character] == token[character]
            character = character + 1
        }
        if (matches) sourceIndex = sourceIndex + token.size
        tokenIndex = tokenIndex + 1
    }
    matches && tokenIndex == tokens.size &&
        glslSkipTrivia(source, sourceIndex) == source.size
}

fun glslTriangleVertexSource(source: string): bool =
    glslSourceMatchesTokens(source, [
        "#", "version", "450",
        "const", "vec2", "positions", "[", "3", "]", "=",
        "vec2", "[", "3", "]", "(",
        "vec2", "(", "-0.75", ",", "-0.65", ")", ",",
        "vec2", "(", "0.75", ",", "-0.65", ")", ",",
        "vec2", "(", "0.0", ",", "0.75", ")", ")", ";",
        "void", "main", "(", ")", "{",
        "gl_Position", "=", "vec4", "(", "positions", "[",
        "gl_VertexID", "]", ",", "0.0", ",", "1.0", ")", ";",
        "}"
    ])

fun glslVertexBufferTriangleSource(source: string): bool =
    glslSourceMatchesTokens(source, [
        "#", "version", "450",
        "layout", "(", "location", "=", "0", ")",
        "in", "vec2", "position", ";",
        "void", "main", "(", ")", "{",
        "gl_Position", "=", "vec4", "(",
        "position", ",", "0.0", ",", "1.0", ")", ";",
        "}"
    ])

fun glslColoredVertexSource(source: string): bool =
    glslSourceMatchesTokens(source, [
        "#", "version", "450",
        "layout", "(", "location", "=", "0", ")",
        "in", "vec2", "position", ";",
        "layout", "(", "location", "=", "1", ")",
        "in", "vec4", "tint", ";",
        "layout", "(", "location", "=", "0", ")",
        "out", "vec4", "vertexTint", ";",
        "void", "main", "(", ")", "{",
        "gl_Position", "=", "vec4", "(",
        "position", ",", "0.0", ",", "1.0", ")", ";",
        "vertexTint", "=", "tint", ";", "}"
    ])

fun glslColoredFragmentSource(source: string): bool =
    glslSourceMatchesTokens(source, [
        "#", "version", "450",
        "layout", "(", "location", "=", "0", ")",
        "in", "vec4", "vertexTint", ";",
        "layout", "(", "location", "=", "0", ")",
        "out", "vec4", "color", ";",
        "void", "main", "(", ")", "{",
        "color", "=", "vertexTint", ";", "}"
    ])

fun glslTexturedVertexSource(source: string): bool =
    glslSourceMatchesTokens(source, [
        "#", "version", "450",
        "layout", "(", "location", "=", "0", ")",
        "in", "vec2", "position", ";",
        "layout", "(", "location", "=", "1", ")",
        "in", "vec2", "uv", ";",
        "layout", "(", "location", "=", "0", ")",
        "out", "vec2", "texCoord", ";",
        "void", "main", "(", ")", "{",
        "gl_Position", "=", "vec4", "(",
        "position", ",", "0.0", ",", "1.0", ")", ";",
        "texCoord", "=", "uv", ";", "}"
    ])

fun glslTexturedCubeVertexSource(source: string): bool =
    glslSourceMatchesTokens(source, [
        "#", "version", "450",
        "layout", "(", "location", "=", "0", ")",
        "in", "vec3", "position", ";",
        "layout", "(", "location", "=", "1", ")",
        "in", "vec2", "uv", ";",
        "layout", "(", "location", "=", "0", ")",
        "out", "vec2", "texCoord", ";",
        "void", "main", "(", ")", "{",
        "gl_Position", "=", "vec4", "(",
        "position", ",", "1.0", ")", ";",
        "texCoord", "=", "uv", ";", "}"
    ])

fun glslTransformCubeVertexSource(source: string): bool =
    glslSourceMatchesTokens(source, [
        "#", "version", "450",
        "layout", "(", "location", "=", "0", ")",
        "in", "vec3", "position", ";",
        "layout", "(", "location", "=", "1", ")",
        "in", "vec2", "uv", ";",
        "layout", "(", "location", "=", "0", ")",
        "out", "vec2", "texCoord", ";",
        "layout", "(", "std140", ",", "binding", "=", "1", ")",
        "uniform", "Transform", "{", "mat4", "mvp", ";", "}",
        "transform", ";",
        "void", "main", "(", ")", "{",
        "gl_Position", "=", "transform", ".", "mvp", "*",
        "vec4", "(", "position", ",", "1.0", ")", ";",
        "texCoord", "=", "uv", ";", "}"
    ])

fun glslTexturedFragmentSource(source: string): bool =
    glslSourceMatchesTokens(source, [
        "#", "version", "450",
        "layout", "(", "location", "=", "0", ")",
        "in", "vec2", "texCoord", ";",
        "layout", "(", "location", "=", "0", ")",
        "out", "vec4", "color", ";",
        "layout", "(", "binding", "=", "0", ")",
        "uniform", "sampler2D", "atlas", ";",
        "void", "main", "(", ")", "{",
        "color", "=", "texture", "(",
        "atlas", ",", "texCoord", ")", ";", "}"
    ])

fun glslTriangleFragmentSource(source: string): bool =
    glslSourceMatchesTokens(source, [
        "#", "version", "450",
        "layout", "(", "location", "=", "0", ")",
        "out", "vec4", "color", ";",
        "void", "main", "(", ")", "{",
        "color", "=", "vec4", "(",
        "0.12", ",", "0.54", ",", "0.96", ",", "1.0",
        ")", ";", "}"
    ])

fun glslMultipleColorFragmentSource(source: string): bool =
    glslSourceMatchesTokens(source, [
        "#", "version", "450",
        "layout", "(", "location", "=", "0", ")",
        "out", "vec4", "firstColor", ";",
        "layout", "(", "location", "=", "1", ")",
        "out", "vec4", "secondColor", ";",
        "void", "main", "(", ")", "{",
        "firstColor", "=", "vec4", "(",
        "1.0", ",", "0.0", ",", "0.0", ",", "1.0", ")", ";",
        "secondColor", "=", "vec4", "(",
        "0.0", ",", "1.0", ",", "0.0", ",", "1.0", ")", ";", "}"
    ])

fun ShaderPackage.spirv(stage: string): GlslSpirvResult {
    val computeCommon = this.valid && stage == shaderStageCompute &&
        this.stages.size == 1 && this.stages[0].kind == shaderStageCompute &&
        this.workgroups.size == 1 && this.locations.size == 0
    val specializedWorkgroup = computeCommon &&
        (this.workgroups[0].xId >= 0 || this.workgroups[0].yId >= 0 ||
         this.workgroups[0].zId >= 0)
    val specializedNoOp = specializedWorkgroup && this.bindings.size == 0 &&
        this.pushConstants.size == 0 &&
        this.specializationConstants.size == 0 &&
        glslComputeSpecializedNoOpSource(this.stages[0].source)
    val scalarSpecializedNoOp = computeCommon && !specializedWorkgroup &&
        this.bindings.size == 0 && this.pushConstants.size == 0 &&
        this.specializationConstants.size > 0 &&
        glslComputeGeneralSpecializedNoOpSource(this.stages[0].source)
    val combinedSpecializedNoOp = specializedWorkgroup &&
        this.bindings.size == 0 && this.pushConstants.size == 0 &&
        this.specializationConstants.size > 0 &&
        glslComputeGeneralSpecializedNoOpSource(this.stages[0].source)
    val noOp = computeCommon && !specializedWorkgroup &&
        this.bindings.size == 0 && this.specializationConstants.size == 0 &&
        glslComputeNoOpSource(this.stages[0].source)
    val storageWrite = if (computeCommon && this.bindings.size == 1)
        glslComputeStorageWrite(this.stages[0].source)
    else GlslStorageWrite(false)
    val storage = computeCommon && !specializedWorkgroup &&
        this.bindings.size == 1 &&
        this.bindings[0].set == 0 && this.bindings[0].binding == 0 &&
        this.bindings[0].storage == "buffer" &&
        this.bindings[0].dataType == "Values" && storageWrite.valid
    val graphicsCommon = this.valid && this.stages.size == 2 &&
        this.workgroups.size == 0
    val vertex = graphicsCommon && stage == shaderStageVertex &&
        glslTriangleVertexSource(this.source(shaderStageVertex))
    val vertexBuffer = graphicsCommon && stage == shaderStageVertex &&
        glslVertexBufferTriangleSource(this.source(shaderStageVertex))
    val coloredVertex = graphicsCommon && stage == shaderStageVertex &&
        glslColoredVertexSource(this.source(shaderStageVertex))
    val fragment = graphicsCommon && stage == shaderStageFragment &&
        glslTriangleFragmentSource(this.source(shaderStageFragment))
    val multipleColorFragment = graphicsCommon &&
        stage == shaderStageFragment &&
        glslMultipleColorFragmentSource(this.source(shaderStageFragment))
    val coloredFragment = graphicsCommon && stage == shaderStageFragment &&
        glslColoredFragmentSource(this.source(shaderStageFragment))
    val texturedVertex = graphicsCommon && stage == shaderStageVertex &&
        glslTexturedVertexSource(this.source(shaderStageVertex))
    val texturedCubeVertex = graphicsCommon && stage == shaderStageVertex &&
        glslTexturedCubeVertexSource(this.source(shaderStageVertex))
    val transformCubeVertex = graphicsCommon && stage == shaderStageVertex &&
        glslTransformCubeVertexSource(this.source(shaderStageVertex))
    val texturedFragment = graphicsCommon && stage == shaderStageFragment &&
        glslTexturedFragmentSource(this.source(shaderStageFragment))
    var succeeded = noOp || specializedNoOp || scalarSpecializedNoOp ||
        combinedSpecializedNoOp || storage || vertex ||
        vertexBuffer || fragment ||
        multipleColorFragment ||
        coloredVertex || coloredFragment || texturedVertex ||
        texturedCubeVertex || transformCubeVertex || texturedFragment
    var error = ""
    var words: array<int> = []
    if (specializedNoOp) {
        words = glslSpecializedWorkgroupSpirv(this.workgroups[0])
    } else if (scalarSpecializedNoOp) {
        words = glslScalarSpecializationSpirv(
            this.workgroups[0],
            this.specializationConstants
        )
    } else if (combinedSpecializedNoOp) {
        words = glslCombinedSpecializationSpirv(
            this.workgroups[0],
            this.specializationConstants,
            false
        )
    } else if (noOp) {
        val workgroup = this.workgroups[0]
        words = [
            spirvMagic, spirvVersion10, 0, 6, 0,
            131089, 1,
            196622, 0, 1,
            327695, 5, 4, 1852399981, 0,
            393232, 4, 17, workgroup.x, workgroup.y, workgroup.z,
            131091, 1,
            196641, 2, 1,
            327734, 1, 4, 0, 2,
            131320, 5,
            65789,
            65592
        ]
    } else if (storage) {
        words = glslStorageSpirv(storageWrite)
    } else if (vertex) {
        words = [
            119734787, 65536, 458752, 42, 0,
            131089, 1,
            393227, 1, 1280527431, 1685353262, 808793134, 0,
