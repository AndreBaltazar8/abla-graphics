                        assignmentOperator = glslStorageTokenTextCopy(
                            sourceTokens[index]
                        )
                        valid = assignmentOperator == "=" ||
                            glslStorageTokenCompoundOpcode(
                                assignmentOperator,
                                signed
                            ) != 0
                        index = index + 1
                    } else valid = false

                    val empty: array<GlslStorageToken> = []
                    var expression = GlslStorageExpression(false, empty, index)
                    if (valid) expression = glslStorageTokenExpression(
                        source,
                        sourceTokens,
                        index,
                        1,
                        signed,
                        specializationName,
                        specializationDefault,
                        specializationType == "bool",
                        specializationId,
                        instanceName,
                        memberNames,
                        localNames,
                        localTypes,
                        0
                    )
                    if (expression.valid && assignmentOperator != "=") {
                        val compoundTokens: array<GlslStorageToken> = [
                            GlslStorageToken(
                                glslStorageTokenLoad,
                                memberIndex
                            )
                        ]
                        var compoundIndex = 0
                        while (compoundIndex < expression.tokens.size) {
                            compoundTokens.append(
                                expression.tokens[compoundIndex]
                            )
                            compoundIndex = compoundIndex + 1
                        }
                        compoundTokens.append(GlslStorageToken(
                            glslStorageTokenOperation,
                            opcode = glslStorageTokenCompoundOpcode(
                                assignmentOperator,
                                signed
                            ),
                            line = statementLine,
                            column = statementColumn
                        ))
                        expression = GlslStorageExpression(
                            compoundTokens.size < 128,
                            compoundTokens,
                            expression.next
                        )
                    }
                    valid = valid && expression.valid &&
                        programTokens.size + expression.tokens.size + 1 < 8192
                    if (valid) {
                        var expressionIndex = 0
                        while (expressionIndex < expression.tokens.size) {
                            programTokens.append(
                                expression.tokens[expressionIndex]
                            )
                            expressionIndex = expressionIndex + 1
                        }
                        programTokens.append(GlslStorageToken(
                            glslStorageTokenStore,
                            memberIndex,
                            line = statementLine,
                            column = statementColumn
                        ))
                    }
                    expressionNext = expression.next
                }
            }
            index = expressionNext
            matched = glslStorageTokenTake(
                sourceTokens,
                index,
                glslTokenPunctuation,
                ";"
            )
            valid = valid && matched.valid
            index = matched.next
            statements = statements + 1
        }
    }
    valid = valid && mainClosed && controlDepth == 0 && statements > 0 &&
        firstMemberIndex >= 0 &&
        index < sourceTokens.size &&
        sourceTokens[index].kind == glslTokenEnd
    var parseError = ""
    if (!valid) {
        if (!lexical.valid) {
            parseError = "${lexical.error} at ${lexical.errorLine}:${lexical.errorColumn}"
        } else if (sourceTokens.size > 0) {
            val errorIndex = if (index >= 0 && index < sourceTokens.size)
                index else sourceTokens.size - 1
            val errorToken = sourceTokens[errorIndex]
            parseError = "unsupported compute-storage GLSL syntax at ${errorToken.line}:${errorToken.column}"
        } else parseError = "unsupported compute-storage GLSL syntax"
    }
    GlslStorageWrite(
        valid,
        signed,
        programTokens,
        specializationName != "" && glslStorageExpressionSpecialized(
            programTokens
        ),
        memberCount,
        firstMemberIndex,
        parseError
    )
