    val storageWrite = if (computeCommon && this.bindings.size == 1)
        glslComputeStorageWrite(this.stages[0].source)
    else GlslStorageWrite(false)
    val storage = computeCommon && !specializedWorkgroup &&
        this.bindings.size == 1 &&
        this.bindings[0].set == 0 && this.bindings[0].binding == 0 &&
        this.bindings[0].storage == "buffer" &&
        storageWrite.valid
    val pushStorage = computeCommon && !specializedWorkgroup &&
        this.bindings.size == 1 && this.bindings[0].set == 0 &&
        this.bindings[0].binding == 0 &&
        this.bindings[0].storage == "buffer" &&
        this.pushConstants.size == 1 &&
        this.specializationConstants.size == 0 &&
        glslPushStorageComputeSource(this.stages[0].source)
    val dualStorage = computeCommon && !specializedWorkgroup &&
        this.bindings.size == 2 &&
        this.bindings[0].set == 0 && this.bindings[0].binding == 0 &&
        this.bindings[0].storage == "buffer" &&
        this.bindings[1].set == 0 && this.bindings[1].binding == 1 &&
        this.bindings[1].storage == "buffer" &&
        this.pushConstants.size == 0 &&
        this.specializationConstants.size == 0 &&
