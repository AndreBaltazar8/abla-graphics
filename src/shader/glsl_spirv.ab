                        }
                        if (!allSame) {
                            resultValue = nextId
                            nextId = nextId + 1
                            body.append(
                                (5 + breakCount * 2) * 65536 + 245
                            )
                            body.append(if (emittedLocalTypes[local] == 1)
                                booleanTypeId else 3)
                            body.append(resultValue)
