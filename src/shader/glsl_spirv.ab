            pushesResult = false
            valid = loopDepth > 0 && stackSize == 0
            if (valid) {
                val loopIndex = loopDepth - 1
                valid = loopConditionEmitted[loopIndex] &&
                    localIds.size == loopLocalCounts[loopIndex]
                if (valid) {
                    val localBase = loopIndex * 64
                    if (!currentBlockTerminated) {
                        val edge = loopContinueEdgeCounts[loopIndex]
                        valid = edge >= 0 && edge < 64
                        if (valid) {
                            val predecessorIndex = loopIndex * 64 + edge
                            val edgeLocalBase =
                                loopIndex * 4096 + edge * 64
                            loopContinuePredecessorIds[predecessorIndex] =
                                currentBlockId
                            var local = 0
                            while (local < localIds.size) {
