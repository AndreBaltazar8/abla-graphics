            458832, 10, 40, 38, 39, 25, 31,
            327745, 32, 41, 3, 16,
            196670, 41, 40,
            65789,
            65592
        ]
    } else if (vertexBuffer) {
        words = [
            119734787, 65536, 0, 27, 0,
            131089, 1,
            393227, 1, 1280527431, 1685353262, 808793134, 0,
            196622, 0, 1,
