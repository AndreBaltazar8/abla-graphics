fun glslTexturedVertexSourceWithCoordinates(
    source: string,
    coordinates: string
): bool =
    glslSourceMatchesTokens(source, [
        "#", "version", glslSourceVersionPattern,
        "layout", "(", "location", "=", "0", ")",
        "in", "vec2", "position", ";",
        "layout", "(", "location", "=", "1", ")",
        "in", coordinates, "uv", ";",
        "layout", "(", "location", "=", "0", ")",
        "out", coordinates, "texCoord", ";",
        "void", "main", "(", ")", "{",
        "gl_Position", "=", "vec4", "(",
        "position", ",", "0.0", ",", "1.0", ")", ";",
        "texCoord", "=", "uv", ";", "}"
    ])

fun glslTexturedVertexCoordinates(source: string): int =
    if (glslTexturedVertexSourceWithCoordinates(source, "vec2")) 2
    else if (glslTexturedVertexSourceWithCoordinates(source, "vec3")) 3
    else 0

fun glslTexturedVertexSource(source: string): bool =
    glslTexturedVertexCoordinates(source) == 2

fun glslTexturedCubeVertexSource(source: string): bool =
    glslSourceMatchesTokens(source, [
        "#", "version", glslSourceVersionPattern,
        "layout", "(", "location", "=", "0", ")",
        "in", "vec3", "position", ";",
        "layout", "(", "location", "=", "1", ")",
        "in", "vec2", "uv", ";",
        "layout", "(", "location", "=", "0", ")",
        "out", "vec2", "texCoord", ";",
        "void", "main", "(", ")", "{",
        "gl_Position", "=", "vec4", "(",
        "position", ",", "1.0", ")", ";",
        "texCoord", "=", "uv", ";", "}"
    ])

fun glslTransformCubeVertexSource(source: string): bool =
    glslSourceMatchesTokens(source, [
        "#", "version", glslSourceVersionPattern,
        "layout", "(", "location", "=", "0", ")",
        "in", "vec3", "position", ";",
        "layout", "(", "location", "=", "1", ")",
        "in", "vec2", "uv", ";",
        "layout", "(", "location", "=", "0", ")",
        "out", "vec2", "texCoord", ";",
        "layout", "(", "std140", ",", "binding", "=", "1", ")",
        "uniform", "Transform", "{", "mat4", "mvp", ";", "}",
        "transform", ";",
        "void", "main", "(", ")", "{",
        "gl_Position", "=", "transform", ".", "mvp", "*",
        "vec4", "(", "position", ",", "1.0", ")", ";",
        "texCoord", "=", "uv", ";", "}"
    ])

val glslSampler2D = 1
val glslSampler2DArray = 2
val glslSamplerCube = 3
val glslSampler3D = 4

fun glslTexturedFragmentSourceWithSampler(
    source: string,
    coordinates: string,
    sampler: string
): bool =
    glslSourceMatchesTokens(source, [
        "#", "version", glslSourceVersionPattern,
        "layout", "(", "location", "=", "0", ")",
        "in", coordinates, "texCoord", ";",
        "layout", "(", "location", "=", "0", ")",
        "out", "vec4", "color", ";",
        "layout", "(", "binding", "=", "0", ")",
        "uniform", sampler, "atlas", ";",
        "void", "main", "(", ")", "{",
        "color", "=", "texture", "(",
        "atlas", ",", "texCoord", ")", ";", "}"
    ])

fun glslTexturedFragmentSampler(source: string): int =
    if (glslTexturedFragmentSourceWithSampler(
        source,
        "vec2",
        "sampler2D"
    )) glslSampler2D
    else if (glslTexturedFragmentSourceWithSampler(
        source,
        "vec3",
        "sampler2DArray"
    )) glslSampler2DArray
    else if (glslTexturedFragmentSourceWithSampler(
        source,
        "vec3",
        "samplerCube"
    )) glslSamplerCube
    else if (glslTexturedFragmentSourceWithSampler(
        source,
        "vec3",
        "sampler3D"
    )) glslSampler3D
    else 0

fun glslTexturedFragmentSource(source: string): bool =
    glslTexturedFragmentSampler(source) == glslSampler2D

fun glslSamplerSpirvDimension(sampler: int): int =
    if (sampler == glslSampler3D) 2
    else if (sampler == glslSamplerCube) 3
    else 1

fun glslSamplerSpirvArrayed(sampler: int): int =
    if (sampler == glslSampler2DArray) 1 else 0

fun glslSamplerCoordinateComponents(sampler: int): int =
    if (sampler == glslSampler2D) 2 else 3

