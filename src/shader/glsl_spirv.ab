            if (valid) {
                val loopIndex = loopDepth - 1
                valid = !loopConditionEmitted[loopIndex]
                if (valid) {
                    body.append(262390)
                    body.append(loopMergeIds[loopIndex])
                    body.append(loopContinueIds[loopIndex])
                    body.append(0)
                    body.append(262394)
                    body.append(stack[0])
                    body.append(loopBodyIds[loopIndex])
                    body.append(loopMergeIds[loopIndex])
                    body.append(131320)
                    body.append(loopBodyIds[loopIndex])
                    loopConditionEmitted[loopIndex] = true
                    stackSize = 0
                    currentBlockId = loopBodyIds[loopIndex]
                    currentBlockTerminated = false
