// Deterministic GLSL-to-SPIR-V translation implemented in Abla.
//
// The first executable subset is intentionally strict: a compute package may
// contain a version directive, one local-size layout, and an empty main. Any
// declaration or statement outside that subset is rejected rather than lost.

import "glsl.ab"
import "spirv.ab"

class GlslSpirvResult(
    val module: SpirvModule,
    val succeeded: bool,
    val error: string = ""
)

class GlslStorageWrite(
    val valid: bool,
    val value: int = 0,
    val add: bool = false,
    val multiply: bool = false
)

fun glslSkipLine(source: string, begin: int): int {
    var index = begin
    while (index < source.size && source[index] != 10 &&
        source[index] != 13) index = index + 1
    index
}

fun glslComputeNoOpSource(source: string): bool {
    var index = 0
    var valid = true
    var mainSeen = false
    var workgroupSeen = false
    var versionSeen = false
    while (valid && index < source.size) {
        index = glslSkipTrivia(source, index)
        if (index >= source.size) {
            index = source.size
        } else if (source[index] == 35) {
            val directive = glslReadName(source, index + 1)
            val version = glslReadUnsigned(source, directive.next)
            valid = directive.text == "version" && !mainSeen &&
                !versionSeen && version.valid &&
                (version.value == 450 || version.value == 460)
            if (valid) versionSeen = true
            index = glslSkipLine(source, version.next)
        } else {
            val name = glslReadName(source, index)
            if (name.text == "layout" && !mainSeen && !workgroupSeen) {
                val layout = glslParseLayout(source, name.next)
                val storage = glslReadName(source, layout.next)
                index = glslSkipTrivia(source, storage.next)
                valid = layout.valid && layout.localSizeX > 0 &&
                    storage.text == "in" && index < source.size &&
                    source[index] == 59
                if (valid) {
                    workgroupSeen = true
                    index = index + 1
                }
            } else if (name.text == "void" && !mainSeen) {
                val main = glslReadName(source, name.next)
                index = glslSkipTrivia(source, main.next)
                valid = main.text == "main" && index < source.size &&
                    source[index] == 40
                if (valid) index = glslSkipTrivia(source, index + 1)
                valid = valid && index < source.size && source[index] == 41
                if (valid) index = glslSkipTrivia(source, index + 1)
                valid = valid && index < source.size && source[index] == 123
                if (valid) index = glslSkipTrivia(source, index + 1)
                valid = valid && index < source.size && source[index] == 125
                if (valid) {
                    mainSeen = true
                    index = index + 1
                }
            } else valid = false
        }
    }
    valid && mainSeen && workgroupSeen && versionSeen
}

fun glslExpectCharacter(
    source: string,
    begin: int,
    character: int
): GlslInteger {
    val index = glslSkipTrivia(source, begin)
    GlslInteger(
        index < source.size && source[index] == character,
        character,
        if (index < source.size && source[index] == character)
            index + 1 else index
    )
}

fun glslComputeStorageWrite(source: string): GlslStorageWrite {
    var index = glslSkipTrivia(source, 0)
    var valid = index < source.size && source[index] == 35
    var part = glslReadName(source, index + 1)
    valid = valid && part.text == "version"
    val version = glslReadUnsigned(source, part.next)
    valid = valid && version.valid && version.value == 450
    index = glslSkipLine(source, version.next)

    part = glslReadName(source, index)
    valid = valid && part.text == "layout"
    val workgroup = glslParseLayout(source, part.next)
    valid = valid && workgroup.valid && workgroup.localSizeX == 1 &&
        (workgroup.localSizeY < 0 || workgroup.localSizeY == 1) &&
        (workgroup.localSizeZ < 0 || workgroup.localSizeZ == 1)
    part = glslReadName(source, workgroup.next)
    valid = valid && part.text == "in"
    var character = glslExpectCharacter(source, part.next, 59)
    valid = valid && character.valid
    index = character.next

    part = glslReadName(source, index)
    valid = valid && part.text == "layout"
    val binding = glslParseLayout(source, part.next)
    valid = valid && binding.valid && binding.set == 0 &&
        binding.binding == 0
    part = glslReadName(source, binding.next)
    valid = valid && part.text == "buffer"
    part = glslReadName(source, part.next)
    valid = valid && part.text == "Values"
    character = glslExpectCharacter(source, part.next, 123)
    valid = valid && character.valid
    part = glslReadName(source, character.next)
    valid = valid && part.text == "uint"
    part = glslReadName(source, part.next)
    valid = valid && part.text == "value"
    character = glslExpectCharacter(source, part.next, 59)
    valid = valid && character.valid
    character = glslExpectCharacter(source, character.next, 125)
    valid = valid && character.valid
    part = glslReadName(source, character.next)
    valid = valid && part.text == "values"
    character = glslExpectCharacter(source, part.next, 59)
    valid = valid && character.valid

    part = glslReadName(source, character.next)
    valid = valid && part.text == "void"
    part = glslReadName(source, part.next)
    valid = valid && part.text == "main"
    character = glslExpectCharacter(source, part.next, 40)
    valid = valid && character.valid
    character = glslExpectCharacter(source, character.next, 41)
    valid = valid && character.valid
    character = glslExpectCharacter(source, character.next, 123)
    valid = valid && character.valid
    part = glslReadName(source, character.next)
    valid = valid && part.text == "values"
    character = glslExpectCharacter(source, part.next, 46)
    valid = valid && character.valid
    part = glslReadName(source, character.next)
    valid = valid && part.text == "value"
    character = glslExpectCharacter(source, part.next, 61)
    valid = valid && character.valid
    var add = false
    var multiply = false
    val expression = glslReadName(source, character.next)
    var value = GlslInteger(false, 0, character.next)
    if (expression.text == "values") {
        character = glslExpectCharacter(source, expression.next, 46)
        valid = valid && character.valid
        part = glslReadName(source, character.next)
        valid = valid && part.text == "value"
        val operator = glslSkipTrivia(source, part.next)
        valid = valid && operator < source.size &&
            (source[operator] == 43 || source[operator] == 42)
        if (operator < source.size) {
            add = source[operator] == 43
            multiply = source[operator] == 42
        }
        character = GlslInteger(valid, 0, operator + 1)
        value = glslReadUnsigned(source, character.next)
    } else {
        value = glslReadUnsigned(source, character.next)
    }
    valid = valid && value.valid
    part = glslReadName(source, value.next)
    valid = valid && part.text == "u"
    character = glslExpectCharacter(source, part.next, 59)
    valid = valid && character.valid
    character = glslExpectCharacter(source, character.next, 125)
    valid = valid && character.valid &&
        glslSkipTrivia(source, character.next) == source.size
    GlslStorageWrite(valid, value.value, add, multiply)
}

fun glslSourceMatchesTokens(
    source: string,
    tokens: array<string>
): bool {
    var sourceIndex = 0
    var tokenIndex = 0
    var matches = true
    while (matches && tokenIndex < tokens.size) {
        sourceIndex = glslSkipTrivia(source, sourceIndex)
        val token = tokens[tokenIndex]
        var character = 0
        while (matches && character < token.size) {
            matches = sourceIndex + character < source.size &&
                source[sourceIndex + character] == token[character]
            character = character + 1
        }
        if (matches) sourceIndex = sourceIndex + token.size
        tokenIndex = tokenIndex + 1
    }
    matches && tokenIndex == tokens.size &&
        glslSkipTrivia(source, sourceIndex) == source.size
}

fun glslTriangleVertexSource(source: string): bool =
    glslSourceMatchesTokens(source, [
        "#", "version", "450",
        "const", "vec2", "positions", "[", "3", "]", "=",
        "vec2", "[", "3", "]", "(",
        "vec2", "(", "-0.75", ",", "-0.65", ")", ",",
        "vec2", "(", "0.75", ",", "-0.65", ")", ",",
        "vec2", "(", "0.0", ",", "0.75", ")", ")", ";",
        "void", "main", "(", ")", "{",
        "gl_Position", "=", "vec4", "(", "positions", "[",
        "gl_VertexID", "]", ",", "0.0", ",", "1.0", ")", ";",
        "}"
    ])

fun glslTriangleFragmentSource(source: string): bool =
    glslSourceMatchesTokens(source, [
        "#", "version", "450",
        "layout", "(", "location", "=", "0", ")",
        "out", "vec4", "color", ";",
        "void", "main", "(", ")", "{",
        "color", "=", "vec4", "(",
        "0.12", ",", "0.54", ",", "0.96", ",", "1.0",
        ")", ";", "}"
    ])

fun ShaderPackage.spirv(stage: string): GlslSpirvResult {
    val computeCommon = this.valid && stage == shaderStageCompute &&
        this.stages.size == 1 && this.stages[0].kind == shaderStageCompute &&
        this.workgroups.size == 1 && this.locations.size == 0
    val noOp = computeCommon && this.bindings.size == 0 &&
        glslComputeNoOpSource(this.stages[0].source)
    val storageWrite = if (computeCommon && this.bindings.size == 1)
        glslComputeStorageWrite(this.stages[0].source)
    else GlslStorageWrite(false)
    val storage = computeCommon && this.bindings.size == 1 &&
        this.bindings[0].set == 0 && this.bindings[0].binding == 0 &&
        this.bindings[0].storage == "buffer" &&
        this.bindings[0].dataType == "Values" && storageWrite.valid
    val graphicsCommon = this.valid && this.stages.size == 2 &&
        this.bindings.size == 0 && this.workgroups.size == 0
    val vertex = graphicsCommon && stage == shaderStageVertex &&
        glslTriangleVertexSource(this.source(shaderStageVertex))
    val fragment = graphicsCommon && stage == shaderStageFragment &&
        glslTriangleFragmentSource(this.source(shaderStageFragment))
    var succeeded = noOp || storage || vertex || fragment
    var error = ""
    var words: array<int> = []
    if (noOp) {
        val workgroup = this.workgroups[0]
        words = [
            spirvMagic, spirvVersion10, 0, 6, 0,
            131089, 1,
            196622, 0, 1,
            327695, 5, 4, 1852399981, 0,
            393232, 4, 17, workgroup.x, workgroup.y, workgroup.z,
            131091, 1,
            196641, 2, 1,
            327734, 1, 4, 0, 2,
            131320, 5,
            65789,
            65592
        ]
    } else if (storage) {
        words = [
            spirvMagic, spirvVersion10, 0,
            if (storageWrite.add || storageWrite.multiply) 15 else 13, 0,
            131089, 1,
            196622, 0, 1,
            327695, 5, 10, 1852399981, 0,
            393232, 10, 17, 1, 1, 1,
            196679, 4, 3,
            327752, 4, 0, 35, 0,
            262215, 9, 34, 0,
            262215, 9, 33, 0,
            131091, 1,
            196641, 2, 1,
            262165, 3, 32, 0,
            196638, 4, 3,
            262176, 5, 2, 4,
            262176, 6, 2, 3,
            262187, 3, 7, 0,
            262187, 3, 8, storageWrite.value,
            262203, 5, 9, 2,
            327734, 1, 10, 0, 2,
            131320, 11,
            327745, 6, 12, 9, 7
        ]
        if (storageWrite.add || storageWrite.multiply) {
            words.append(262205)
            words.append(3)
            words.append(13)
            words.append(12)
            words.append(if (storageWrite.add) 327808 else 327812)
            words.append(3)
            words.append(14)
            words.append(13)
            words.append(8)
            words.append(196670)
            words.append(12)
            words.append(14)
        } else {
            words.append(196670)
            words.append(12)
            words.append(8)
        }
        words.append(65789)
        words.append(65592)
    } else if (vertex) {
        words = [
            119734787, 65536, 458752, 42, 0,
            131089, 1,
            393227, 1, 1280527431, 1685353262, 808793134, 0,
            196622, 0, 1,
            524303, 0, 2, 1852399981, 0, 3, 4, 5,
            196679, 6, 2,
            327752, 6, 0, 11, 0,
            327752, 6, 1, 11, 1,
            327752, 6, 2, 11, 3,
            327752, 6, 3, 11, 4,
            262215, 4, 11, 42,
            262215, 5, 11, 43,
            131091, 7,
            196641, 8, 7,
            196630, 9, 32,
            262167, 10, 9, 4,
            262165, 11, 32, 0,
            262187, 11, 12, 1,
            262172, 13, 9, 12,
            393246, 6, 10, 9, 13, 13,
            262176, 14, 3, 6,
            262203, 14, 3, 3,
            262165, 15, 32, 1,
            262187, 15, 16, 0,
            262167, 17, 9, 2,
            262187, 11, 18, 3,
            262172, 19, 17, 18,
            262187, 9, 20, 3208642560,
            262187, 9, 21, 3206964838,
            327724, 17, 22, 20, 21,
            262187, 9, 23, 1061158912,
            327724, 17, 24, 23, 21,
            262187, 9, 25, 0,
            327724, 17, 26, 25, 23,
            393260, 19, 27, 22, 24, 26,
            262176, 28, 1, 15,
            262203, 28, 4, 1,
            262176, 29, 7, 19,
            262176, 30, 7, 17,
            262187, 9, 31, 1065353216,
            262176, 32, 3, 10,
            262203, 28, 5, 1,
            327734, 7, 2, 0, 8,
            131320, 33,
            262203, 29, 34, 7,
            262205, 15, 35, 4,
            196670, 34, 27,
            327745, 30, 36, 34, 35,
            262205, 17, 37, 36,
            327761, 9, 38, 37, 0,
            327761, 9, 39, 37, 1,
            458832, 10, 40, 38, 39, 25, 31,
            327745, 32, 41, 3, 16,
            196670, 41, 40,
            65789,
            65592
        ]
    } else if (fragment) {
        words = [
            119734787, 65536, 458752, 15, 0,
            131089, 1,
            393227, 1, 1280527431, 1685353262, 808793134, 0,
            196622, 0, 1,
            393231, 4, 2, 1852399981, 0, 3,
            196624, 2, 7,
            262215, 3, 30, 0,
            131091, 4,
            196641, 5, 4,
            196630, 6, 32,
            262167, 7, 6, 4,
            262176, 8, 3, 7,
            262203, 8, 3, 3,
            262187, 6, 9, 1039516303,
            262187, 6, 10, 1057635697,
            262187, 6, 11, 1064682127,
            262187, 6, 12, 1065353216,
            458796, 7, 13, 9, 10, 11, 12,
            327734, 4, 2, 0, 5,
            131320, 14,
            196670, 3, 13,
            65789,
            65592
        ]
    } else {
        error = "the deterministic GLSL translator supports the documented compute and fixed triangle graphics subsets"
    }
    val module = spirvModule(words)
    succeeded = succeeded && module.valid()
    if (!succeeded && error == "") error = module.validation.error
    GlslSpirvResult(module, succeeded, error)
}

fun spirvWordsEqual(left: SpirvModule, right: SpirvModule): bool {
    var equal = left.words.size == right.words.size
    var index = 0
    while (equal && index < left.words.size) {
        equal = left.words[index] == right.words[index]
        index = index + 1
    }
    equal
}
