                    } else valid = false
                    valid = valid && memberIndex >= 0 &&
                        programTokens.size + 4 < 8192
                    if (valid && firstMemberIndex < 0) {
                        firstMemberIndex = memberIndex
                    }
                    if (valid) {
                        val updateTokens = glslStorageUpdateTokens(
                            glslStorageTokenLoad,
                            glslStorageTokenStore,
                            memberIndex,
                            0,
                            increment,
                            statementLine,
                            statementColumn
