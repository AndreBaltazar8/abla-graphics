                    val empty: array<GlslStorageToken> = []
                    var expression = GlslStorageExpression(false, empty, index)
                    if (valid) expression = glslStorageTokenExpression(
                        source,
                        sourceTokens,
                        index,
                        1,
                        signed,
                        specializationName,
                        specializationDefault,
