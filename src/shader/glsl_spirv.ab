        valid = valid && matched.valid
        index = matched.next
        var default = GlslStorageTokenParsedDefault(false, next = index)
        if (specializationType == "bool" && index < sourceTokens.size &&
            sourceTokens[index].kind == glslTokenIdentifier &&
            (sourceTokens[index].text == "true" ||
             sourceTokens[index].text == "false")) {
            default = GlslStorageTokenParsedDefault(
                true,
                if (sourceTokens[index].text == "true") 1 else 0,
                index + 1
            )
        } else if (specializationType != "bool") {
