// Deterministic GLSL-to-SPIR-V translation implemented in Abla.
//
// The executable subsets are intentionally strict: compute packages cover
// fixed or specialized local sizes, scalar specialization constants, and the
// documented storage arithmetic forms. Any declaration or statement outside
// those subsets is rejected rather than lost.

import "glsl.ab"
import "spirv.ab"
import "../core.ab"
import "abla/float"

class GlslSpirvResult(
    val module: SpirvModule,
    val succeeded: bool,
    val error: string = ""
)

val glslStorageTokenLoad = 0
val glslStorageTokenLiteral = 1
val glslStorageTokenSpecialization = 2
val glslStorageTokenOperation = 3
val glslStorageTokenStore = 4
val glslStorageTokenLocalLoad = 5
val glslStorageTokenLocalStore = 6
val glslStorageTokenIfBegin = 7
val glslStorageTokenElse = 8
val glslStorageTokenIfEnd = 9
val glslStorageOperationInteger = 0
val glslStorageOperationComparison = 1
val glslStorageOperationLogical = 2
val glslStorageOperationSelect = 3
val glslStorageOperationExtInst = 4

class GlslStorageToken(
    val kind: int,
    val value: int = 0,
    val opcode: int = 0,
    val specializationId: int = -1,
    val arity: int = 2,
    val operationClass: int = glslStorageOperationInteger,
    val valueType: int = 0,
    val line: int = -1,
    val column: int = -1
)

class GlslStorageSpirvEmission(
    val words: array<int>,
    val error: string = ""
)

class GlslStorageExpression(
    val valid: bool,
    val tokens: array<GlslStorageToken>,
    val next: int
)

class GlslStorageWrite(
    val valid: bool,
    val signed: bool = false,
    val tokens: array<GlslStorageToken> = [],
    val specialized: bool = false,
    val memberCount: int = 1,
    val memberIndex: int = 0,
    val error: string = ""
) {
    fun arithmetic(): bool {
        var result = false
        var index = 0
        while (!result && index < this.tokens.size) {
            result = this.tokens[index].kind == glslStorageTokenOperation
            index = index + 1
        }
        result
    }
}

class GlslSpirvDefault(
    val valid: bool,
    val bits: int = 0,
    val width: int = 32
)

fun glslSkipLine(source: string, begin: int): int {
    var index = begin
    while (index < source.size && source[index] != 10 &&
        source[index] != 13) index = index + 1
    index
}

fun glslComputeNoOpSource(source: string): bool {
    var index = 0
    var valid = true
    var mainSeen = false
    var workgroupSeen = false
    var versionSeen = false
    while (valid && index < source.size) {
        index = glslSkipTrivia(source, index)
        if (index >= source.size) {
            index = source.size
        } else if (source[index] == 35) {
            val directive = glslReadName(source, index + 1)
            val version = glslReadUnsigned(source, directive.next)
            valid = directive.text == "version" && !mainSeen &&
                !versionSeen && version.valid &&
                (version.value == 450 || version.value == 460)
            if (valid) versionSeen = true
            index = glslSkipLine(source, version.next)
        } else {
            val name = glslReadName(source, index)
            if (name.text == "layout" && !mainSeen && !workgroupSeen) {
                val layout = glslParseLayout(source, name.next)
                val storage = glslReadName(source, layout.next)
                index = glslSkipTrivia(source, storage.next)
                valid = layout.valid && layout.localSizeX > 0 &&
                    storage.text == "in" && index < source.size &&
                    source[index] == 59
                if (valid) {
                    workgroupSeen = true
                    index = index + 1
                }
            } else if (name.text == "void" && !mainSeen) {
                val main = glslReadName(source, name.next)
                index = glslSkipTrivia(source, main.next)
                valid = main.text == "main" && index < source.size &&
                    source[index] == 40
                if (valid) index = glslSkipTrivia(source, index + 1)
                valid = valid && index < source.size && source[index] == 41
                if (valid) index = glslSkipTrivia(source, index + 1)
                valid = valid && index < source.size && source[index] == 123
                if (valid) index = glslSkipTrivia(source, index + 1)
                valid = valid && index < source.size && source[index] == 125
                if (valid) {
                    mainSeen = true
                    index = index + 1
                }
            } else valid = false
        }
    }
    valid && mainSeen && workgroupSeen && versionSeen
}

fun glslComputeSpecializedNoOpSource(source: string): bool {
    var index = 0
    var valid = true
    var mainSeen = false
    var workgroupSeen = false
    var specializationSeen = false
    var versionSeen = false
    while (valid && index < source.size) {
        index = glslSkipTrivia(source, index)
        if (index >= source.size) {
            index = source.size
        } else if (source[index] == 35) {
            val directive = glslReadName(source, index + 1)
            val version = glslReadUnsigned(source, directive.next)
            valid = directive.text == "version" && !mainSeen &&
                !versionSeen && version.valid &&
                (version.value == 450 || version.value == 460)
            if (valid) versionSeen = true
            index = glslSkipLine(source, version.next)
        } else {
            val name = glslReadName(source, index)
            if (name.text == "layout" && !mainSeen) {
                val layout = glslParseLayout(source, name.next)
                val storage = glslReadName(source, layout.next)
                index = glslSkipTrivia(source, storage.next)
                val workgroup = layout.localSizeX >= 0 ||
                    layout.localSizeY >= 0 || layout.localSizeZ >= 0 ||
                    layout.localSizeXId >= 0 ||
                    layout.localSizeYId >= 0 ||
                    layout.localSizeZId >= 0
                valid = layout.valid && workgroup &&
                    storage.text == "in" && index < source.size &&
                    source[index] == 59
                if (valid) {
                    workgroupSeen = true
                    specializationSeen = specializationSeen ||
                        layout.localSizeXId >= 0 ||
                        layout.localSizeYId >= 0 ||
                        layout.localSizeZId >= 0
                    index = index + 1
                }
            } else if (name.text == "void" && !mainSeen) {
                val main = glslReadName(source, name.next)
                index = glslSkipTrivia(source, main.next)
                valid = main.text == "main" && index < source.size &&
                    source[index] == 40
                if (valid) index = glslSkipTrivia(source, index + 1)
                valid = valid && index < source.size && source[index] == 41
                if (valid) index = glslSkipTrivia(source, index + 1)
                valid = valid && index < source.size && source[index] == 123
                if (valid) index = glslSkipTrivia(source, index + 1)
                valid = valid && index < source.size && source[index] == 125
                if (valid) {
                    mainSeen = true
                    index = index + 1
                }
            } else valid = false
        }
    }
    valid && mainSeen && workgroupSeen && specializationSeen && versionSeen
}

fun glslComputeGeneralSpecializedNoOpSource(source: string): bool {
    var index = 0
    var valid = true
    var mainSeen = false
    var workgroupSeen = false
    var specializationCount = 0
    var versionSeen = false
    while (valid && index < source.size) {
        index = glslSkipTrivia(source, index)
        if (index >= source.size) {
            index = source.size
        } else if (source[index] == 35) {
            val directive = glslReadName(source, index + 1)
            val version = glslReadUnsigned(source, directive.next)
            valid = directive.text == "version" && !mainSeen &&
                !versionSeen && version.valid &&
                (version.value == 450 || version.value == 460)
            if (valid) versionSeen = true
            index = glslSkipLine(source, version.next)
        } else {
            val name = glslReadName(source, index)
            if (name.text == "layout" && !mainSeen) {
                val layout = glslParseLayout(source, name.next)
                if (layout.constantId >= 0) {
                    val specialization = glslParseSpecializationDeclaration(
                        source,
                        layout.next
                    )
                    valid = layout.valid && specialization.valid
                    if (valid) {
                        specializationCount = specializationCount + 1
                        index = specialization.next
                    }
                } else {
                    val storage = glslReadName(source, layout.next)
                    index = glslSkipTrivia(source, storage.next)
                    val workgroup = layout.localSizeX >= 0 ||
                        layout.localSizeY >= 0 || layout.localSizeZ >= 0 ||
                        layout.localSizeXId >= 0 ||
                        layout.localSizeYId >= 0 ||
                        layout.localSizeZId >= 0
                    valid = layout.valid && workgroup &&
                        storage.text == "in" && index < source.size &&
                        source[index] == 59
                    if (valid) {
                        workgroupSeen = true
                        index = index + 1
                    }
                }
            } else if (name.text == "void" && !mainSeen) {
                val main = glslReadName(source, name.next)
                index = glslSkipTrivia(source, main.next)
                valid = main.text == "main" && index < source.size &&
                    source[index] == 40
                if (valid) index = glslSkipTrivia(source, index + 1)
                valid = valid && index < source.size && source[index] == 41
                if (valid) index = glslSkipTrivia(source, index + 1)
                valid = valid && index < source.size && source[index] == 123
                if (valid) index = glslSkipTrivia(source, index + 1)
                valid = valid && index < source.size && source[index] == 125
                if (valid) {
                    mainSeen = true
                    index = index + 1
                }
            } else valid = false
        }
    }
    valid && mainSeen && workgroupSeen && specializationCount > 0 &&
        versionSeen
}

fun glslIntegerDefault(text: string, signed: bool): GlslSpirvDefault {
    var index = 0
    var negative = false
    if (index < text.size && (text[index] == 43 || text[index] == 45)) {
        negative = text[index] == 45
        index = index + 1
    }
    val end = if (!signed && text.size > index &&
        (text[text.size - 1] == 85 || text[text.size - 1] == 117))
        text.size - 1 else text.size
    var value = 0
    var valid = index < end && (signed || !negative)
    val limit = if (signed && negative) 2147483648 else 4294967295
    while (valid && index < end) {
        val digit = text[index] - 48
        valid = digit >= 0 && digit <= 9 &&
            value <= (limit - digit) / 10
        if (valid) value = value * 10 + digit
        index = index + 1
    }
    if (signed && !negative) valid = valid && value <= 2147483647
    val bits = if (valid && negative) (-value) & 4294967295
        else value
    GlslSpirvDefault(valid && index == end, bits)
}

fun glslFloatingDefault(text: string, single: bool): GlslSpirvDefault {
    var index = 0
    var negative = false
    if (index < text.size && (text[index] == 43 || text[index] == 45)) {
        negative = text[index] == 45
        index = index + 1
    }
    var value = 0.0
    var fractionalDigits = 0
    var fractional = false
    var digits = 0
    while (index < text.size &&
        ((text[index] >= 48 && text[index] <= 57) ||
         text[index] == 46)) {
        if (text[index] == 46) {
            fractional = true
        } else {
            value = value * 10.0 + f64FromInt(text[index] - 48)
            if (fractional) fractionalDigits = fractionalDigits + 1
            digits = digits + 1
        }
        index = index + 1
    }
    var exponent = 0
    var exponentNegative = false
    if (index < text.size && (text[index] == 69 || text[index] == 101)) {
        index = index + 1
        if (index < text.size && (text[index] == 43 || text[index] == 45)) {
            exponentNegative = text[index] == 45
            index = index + 1
        }
        while (index < text.size && text[index] >= 48 &&
            text[index] <= 57 && exponent <= 1000) {
            exponent = exponent * 10 + text[index] - 48
            index = index + 1
        }
    }
    if (exponentNegative) exponent = -exponent
    exponent = exponent - fractionalDigits
    var valid = digits > 0 && exponent >= -1000 && exponent <= 1000
    while (valid && exponent > 0) {
        value = value * 10.0
        exponent = exponent - 1
    }
    while (valid && exponent < 0) {
        value = value / 10.0
        exponent = exponent + 1
    }
    if (negative) value = -value
    while (index < text.size &&
        (text[index] == 70 || text[index] == 76 || text[index] == 102 ||
         text[index] == 108)) index = index + 1
    val bits = if (single) graphicsScalarF32Bits(value) else f64ToBits(value)
    if (single) valid = valid && ((bits >>> 23) & 255) != 255
    else valid = valid && ((bits >>> 52) & 2047) != 2047
    GlslSpirvDefault(valid && index == text.size, bits, if (single) 32 else 64)
}

fun glslSpecializationDefault(
    constant: ShaderSpecializationConstant
): GlslSpirvDefault {
    var result = GlslSpirvDefault(false)
    if (constant.dataType == "bool") {
        result = GlslSpirvDefault(
            constant.defaultValue == "true" ||
                constant.defaultValue == "false",
            if (constant.defaultValue == "true") 1 else 0
        )
    } else if (constant.dataType == "int") {
        result = glslIntegerDefault(constant.defaultValue, true)
    } else if (constant.dataType == "uint") {
        result = glslIntegerDefault(constant.defaultValue, false)
    } else if (constant.dataType == "float") {
        result = glslFloatingDefault(constant.defaultValue, true)
    } else if (constant.dataType == "double") {
        result = glslFloatingDefault(constant.defaultValue, false)
    }
    result
}

fun glslScalarSpecializationSpirv(
    workgroup: ShaderWorkgroup,
    constants: array<ShaderSpecializationConstant>
): array<int> {
    var valid = constants.size > 0
    var doubleCapability = false
    var index = 0
    while (valid && index < constants.size) {
        valid = glslSpecializationDefault(constants[index]).valid
        doubleCapability = doubleCapability ||
            constants[index].dataType == "double"
        index = index + 1
    }
    val words: array<int> = []
    if (valid) {
        words.append(spirvMagic)
        words.append(spirvVersion10)
        words.append(0)
        words.append(constants.size * 2 + 6)
        words.append(0)
        words.append(131089)
        words.append(1)
        if (doubleCapability) {
            words.append(131089)
            words.append(10)
        }
        words.append(196622)
        words.append(0)
        words.append(1)
        words.append(327695)
        words.append(5)
        words.append(4)
        words.append(1852399981)
        words.append(0)
        words.append(393232)
        words.append(4)
        words.append(17)
        words.append(workgroup.x)
        words.append(workgroup.y)
        words.append(workgroup.z)
        index = 0
        while (index < constants.size) {
            words.append(262215)
            words.append(7 + index * 2)
            words.append(1)
            words.append(constants[index].id)
            index = index + 1
        }
        words.append(131091)
        words.append(1)
        words.append(196641)
        words.append(2)
        words.append(1)
        index = 0
        while (index < constants.size) {
            val constant = constants[index]
            val default = glslSpecializationDefault(constant)
            val typeId = 6 + index * 2
            val constantId = typeId + 1
            if (constant.dataType == "bool") {
                words.append(131092)
                words.append(typeId)
                words.append(if (default.bits != 0) 196656 else 196657)
                words.append(typeId)
                words.append(constantId)
            } else if (constant.dataType == "int" ||
                constant.dataType == "uint") {
                words.append(262165)
                words.append(typeId)
                words.append(32)
                words.append(if (constant.dataType == "int") 1 else 0)
                words.append(262194)
                words.append(typeId)
                words.append(constantId)
                words.append(default.bits & 4294967295)
            } else {
                words.append(196630)
                words.append(typeId)
                words.append(default.width)
                words.append(if (default.width == 64) 327730 else 262194)
                words.append(typeId)
                words.append(constantId)
                words.append(default.bits & 4294967295)
                if (default.width == 64) {
                    words.append((default.bits >>> 32) & 4294967295)
                }
            }
            index = index + 1
        }
        words.append(327734)
        words.append(1)
        words.append(4)
        words.append(0)
        words.append(2)
        words.append(131320)
        words.append(5)
        words.append(65789)
        words.append(65592)
    }
    words
}

fun glslSpecializedWorkgroupSpirv(workgroup: ShaderWorkgroup): array<int> {
    val words: array<int> = [
        spirvMagic, 66048, 0, 10, 0,
        131089, 1,
        196622, 0, 1,
        327695, 5, 4, 1852399981, 0,
        393547, 4, 38, 7, 8, 9
    ]
    if (workgroup.xId >= 0) {
        words.append(262215)
        words.append(7)
        words.append(1)
        words.append(workgroup.xId)
    }
    if (workgroup.yId >= 0) {
        words.append(262215)
        words.append(8)
        words.append(1)
        words.append(workgroup.yId)
    }
    if (workgroup.zId >= 0) {
        words.append(262215)
        words.append(9)
        words.append(1)
        words.append(workgroup.zId)
    }
    words.append(131091)
    words.append(1)
    words.append(196641)
    words.append(2)
    words.append(1)
    words.append(262165)
    words.append(6)
    words.append(32)
    words.append(0)
    words.append(if (workgroup.xId >= 0) 262194 else 262187)
    words.append(6)
    words.append(7)
    words.append(workgroup.x)
    words.append(if (workgroup.yId >= 0) 262194 else 262187)
    words.append(6)
    words.append(8)
    words.append(workgroup.y)
    words.append(if (workgroup.zId >= 0) 262194 else 262187)
    words.append(6)
    words.append(9)
    words.append(workgroup.z)
    words.append(327734)
    words.append(1)
    words.append(4)
    words.append(0)
    words.append(2)
    words.append(131320)
    words.append(5)
    words.append(65789)
    words.append(65592)
    words
}

// OpenGL 4.6 / ARB_gl_spirv consumes the SPIR-V 1.0 WorkgroupSize built-in
// form. Vulkan uses the SPIR-V 1.2 LocalSizeId execution mode above. Both
// modules expose the same reflected SpecId values and concrete defaults.
fun glslSpecializedWorkgroupOpenGlSpirv(
    workgroup: ShaderWorkgroup
): array<int> {
    val words: array<int> = [
        spirvMagic, spirvVersion10, 0, 11, 0,
        131089, 1,
        196622, 0, 1,
        327695, 5, 5, 1852399981, 0,
        393232, 5, 17, workgroup.x, workgroup.y, workgroup.z
    ]
    if (workgroup.xId >= 0) {
        words.append(262215)
        words.append(7)
        words.append(1)
        words.append(workgroup.xId)
    }
    if (workgroup.yId >= 0) {
        words.append(262215)
        words.append(8)
        words.append(1)
        words.append(workgroup.yId)
    }
    if (workgroup.zId >= 0) {
        words.append(262215)
        words.append(9)
        words.append(1)
        words.append(workgroup.zId)
    }
    words.append(262215)
    words.append(10)
    words.append(11)
    words.append(25)
    words.append(131091)
    words.append(1)
    words.append(196641)
    words.append(2)
    words.append(1)
    words.append(262165)
    words.append(3)
    words.append(32)
    words.append(0)
    words.append(262167)
    words.append(4)
    words.append(3)
    words.append(3)
    words.append(if (workgroup.xId >= 0) 262194 else 262187)
    words.append(3)
    words.append(7)
    words.append(workgroup.x)
    words.append(if (workgroup.yId >= 0) 262194 else 262187)
    words.append(3)
    words.append(8)
    words.append(workgroup.y)
    words.append(if (workgroup.zId >= 0) 262194 else 262187)
    words.append(3)
    words.append(9)
    words.append(workgroup.z)
    words.append(393267)
    words.append(4)
    words.append(10)
    words.append(7)
    words.append(8)
    words.append(9)
    words.append(327734)
    words.append(1)
    words.append(5)
    words.append(0)
    words.append(2)
    words.append(131320)
    words.append(6)
    words.append(65789)
    words.append(65592)
    words
}

fun glslScalarDecorationWords(
    constants: array<ShaderSpecializationConstant>,
    firstConstantId: int
): array<int> {
    val words: array<int> = []
    var index = 0
    while (index < constants.size) {
        words.append(262215)
        words.append(firstConstantId + index * 2)
        words.append(1)
        words.append(constants[index].id)
        index = index + 1
    }
    words
}

fun glslScalarDeclarationWords(
    constants: array<ShaderSpecializationConstant>,
    firstTypeId: int
): array<int> {
    val words: array<int> = []
    var index = 0
    while (index < constants.size) {
        val constant = constants[index]
        val default = glslSpecializationDefault(constant)
        val typeId = firstTypeId + index * 2
        val constantId = typeId + 1
        if (constant.dataType == "bool") {
            words.append(131092)
            words.append(typeId)
            words.append(if (default.bits != 0) 196656 else 196657)
            words.append(typeId)
            words.append(constantId)
        } else if (constant.dataType == "int" ||
            constant.dataType == "uint") {
            words.append(262165)
            words.append(typeId)
            words.append(32)
            words.append(if (constant.dataType == "int") 1 else 0)
            words.append(262194)
            words.append(typeId)
            words.append(constantId)
            words.append(default.bits & 4294967295)
        } else {
            words.append(196630)
            words.append(typeId)
            words.append(default.width)
            words.append(if (default.width == 64) 327730 else 262194)
            words.append(typeId)
            words.append(constantId)
            words.append(default.bits & 4294967295)
            if (default.width == 64) {
                words.append((default.bits >>> 32) & 4294967295)
            }
        }
        index = index + 1
    }
    words
}

fun glslCombinedSpecializationSpirv(
    workgroup: ShaderWorkgroup,
    constants: array<ShaderSpecializationConstant>,
    openGl: bool
): array<int> {
    var valid = constants.size > 0
    var doubleCapability = false
    var index = 0
    while (valid && index < constants.size) {
        valid = glslSpecializationDefault(constants[index]).valid
        doubleCapability = doubleCapability ||
            constants[index].dataType == "double"
        index = index + 1
    }
    val words: array<int> = []
    if (valid) {
        val firstTypeId = if (openGl) 11 else 10
        val functionId = if (openGl) 5 else 4
        val labelId = if (openGl) 6 else 5
        words.append(spirvMagic)
        words.append(if (openGl) spirvVersion10 else 66048)
        words.append(0)
        words.append(firstTypeId + constants.size * 2)
        words.append(0)
        words.append(131089)
        words.append(1)
        if (doubleCapability) {
            words.append(131089)
            words.append(10)
        }
        words.append(196622)
        words.append(0)
        words.append(1)
        words.append(327695)
        words.append(5)
        words.append(functionId)
        words.append(1852399981)
        words.append(0)
        if (openGl) {
            words.append(393232)
            words.append(functionId)
            words.append(17)
            words.append(workgroup.x)
            words.append(workgroup.y)
            words.append(workgroup.z)
        } else {
            words.append(393547)
            words.append(functionId)
            words.append(38)
            words.append(7)
            words.append(8)
            words.append(9)
        }
        if (workgroup.xId >= 0) {
            words.append(262215)
            words.append(7)
            words.append(1)
            words.append(workgroup.xId)
        }
        if (workgroup.yId >= 0) {
            words.append(262215)
            words.append(8)
            words.append(1)
            words.append(workgroup.yId)
        }
        if (workgroup.zId >= 0) {
            words.append(262215)
            words.append(9)
            words.append(1)
            words.append(workgroup.zId)
        }
        if (openGl) {
            words.append(262215)
            words.append(10)
            words.append(11)
            words.append(25)
        }
        val decorations = glslScalarDecorationWords(
            constants,
            firstTypeId + 1
        )
        index = 0
        while (index < decorations.size) {
            words.append(decorations[index])
            index = index + 1
        }
        words.append(131091)
        words.append(1)
        words.append(196641)
        words.append(2)
        words.append(1)
        words.append(262165)
        words.append(if (openGl) 3 else 6)
        words.append(32)
        words.append(0)
        if (openGl) {
            words.append(262167)
            words.append(4)
            words.append(3)
            words.append(3)
        }
        words.append(if (workgroup.xId >= 0) 262194 else 262187)
        words.append(if (openGl) 3 else 6)
        words.append(7)
        words.append(workgroup.x)
        words.append(if (workgroup.yId >= 0) 262194 else 262187)
        words.append(if (openGl) 3 else 6)
        words.append(8)
        words.append(workgroup.y)
        words.append(if (workgroup.zId >= 0) 262194 else 262187)
        words.append(if (openGl) 3 else 6)
        words.append(9)
        words.append(workgroup.z)
        if (openGl) {
            words.append(393267)
            words.append(4)
            words.append(10)
            words.append(7)
            words.append(8)
            words.append(9)
        }
        val declarations = glslScalarDeclarationWords(
            constants,
            firstTypeId
        )
        index = 0
        while (index < declarations.size) {
            words.append(declarations[index])
            index = index + 1
        }
        words.append(327734)
        words.append(1)
        words.append(functionId)
        words.append(0)
        words.append(2)
        words.append(131320)
        words.append(labelId)
        words.append(65789)
        words.append(65592)
    }
    words
}

fun ShaderPackage.spirvOpenGl(stage: string): GlslSpirvResult {
    val specializedNoOp = this.valid && stage == shaderStageCompute &&
        this.stages.size == 1 &&
        this.stages[0].kind == shaderStageCompute &&
        this.workgroups.size == 1 && this.locations.size == 0 &&
        (this.workgroups[0].xId >= 0 || this.workgroups[0].yId >= 0 ||
         this.workgroups[0].zId >= 0) &&
        this.bindings.size == 0 && this.pushConstants.size == 0 &&
        this.specializationConstants.size == 0 &&
        glslComputeSpecializedNoOpSource(this.stages[0].source)
    val scalarSpecializedNoOp = this.valid && stage == shaderStageCompute &&
        this.stages.size == 1 &&
        this.stages[0].kind == shaderStageCompute &&
        this.workgroups.size == 1 && this.locations.size == 0 &&
        this.workgroups[0].xId < 0 && this.workgroups[0].yId < 0 &&
        this.workgroups[0].zId < 0 &&
        this.bindings.size == 0 && this.pushConstants.size == 0 &&
        this.specializationConstants.size > 0 &&
        glslComputeGeneralSpecializedNoOpSource(this.stages[0].source)
    val combinedSpecializedNoOp = this.valid && stage == shaderStageCompute &&
        this.stages.size == 1 &&
        this.stages[0].kind == shaderStageCompute &&
        this.workgroups.size == 1 && this.locations.size == 0 &&
        (this.workgroups[0].xId >= 0 || this.workgroups[0].yId >= 0 ||
         this.workgroups[0].zId >= 0) &&
        this.bindings.size == 0 && this.pushConstants.size == 0 &&
        this.specializationConstants.size > 0 &&
        glslComputeGeneralSpecializedNoOpSource(this.stages[0].source)
    val storageWrite = if (this.valid && stage == shaderStageCompute &&
        this.stages.size == 1 && this.bindings.size == 1)
        glslComputeStorageWrite(this.stages[0].source)
        else GlslStorageWrite(false)
    val specializedStorage = storageWrite.valid &&
        storageWrite.specialized && this.workgroups.size == 1 &&
        this.bindings[0].set == 0 && this.bindings[0].binding == 0 &&
        this.bindings[0].storage == "buffer" &&
        this.specializationConstants.size == 1
    var words: array<int> = []
    if (specializedNoOp) {
        words = glslSpecializedWorkgroupOpenGlSpirv(this.workgroups[0])
    } else if (scalarSpecializedNoOp) {
        words = glslScalarSpecializationSpirv(
            this.workgroups[0],
            this.specializationConstants
        )
    } else if (combinedSpecializedNoOp) {
        words = glslCombinedSpecializationSpirv(
            this.workgroups[0],
            this.specializationConstants,
            true
        )
    } else if (specializedStorage) {
        words = this.spirv(stage).module.words
    }
    val module = spirvModule(words)
    GlslSpirvResult(
        module,
        (specializedNoOp || scalarSpecializedNoOp ||
         combinedSpecializedNoOp || specializedStorage) && module.valid(),
        if (specializedNoOp || scalarSpecializedNoOp ||
            combinedSpecializedNoOp || specializedStorage) "" else
            "GLSL source is outside the deterministic OpenGL SPIR-V subset"
    )
}

fun glslStorageTokensCopy(
    source: array<GlslStorageToken>
): array<GlslStorageToken> {
    val result: array<GlslStorageToken> = []
    var index = 0
    while (index < source.size) {
        result.append(source[index])
        index = index + 1
    }
    result
}

fun glslStorageExpressionSpecialized(
    tokens: array<GlslStorageToken>
): bool {
    var specialized = false
    var index = 0
    while (!specialized && index < tokens.size) {
        specialized = tokens[index].kind == glslStorageTokenSpecialization
        index = index + 1
    }
    specialized
}

fun glslStorageTokenBinaryPrecedence(text: string): int {
    var precedence = 0
    if (text == "*" || text == "/" || text == "%") precedence = 12
    else if (text == "+" || text == "-") precedence = 11
    else if (text == "<<" || text == ">>") precedence = 10
    else if (text == "<" || text == ">" || text == "<=" ||
        text == ">=") precedence = 9
    else if (text == "==" || text == "!=") precedence = 8
    else if (text == "&") precedence = 7
    else if (text == "^") precedence = 6
    else if (text == "|") precedence = 5
    else if (text == "&&") precedence = 4
    else if (text == "^^") precedence = 3
    else if (text == "||") precedence = 2
    precedence
}

fun glslStorageTokenBinaryOpcode(text: string, signed: bool): int {
    var opcode = 0
    if (text == "+") opcode = 327808
    else if (text == "-") opcode = 327810
    else if (text == "*") opcode = 327812
    else if (text == "/") opcode = if (signed) 327815 else 327814
    else if (text == "%") opcode = if (signed) 327818 else 327817
    else if (text == "<<") opcode = 327876
    else if (text == ">>") opcode = if (signed) 327875 else 327874
    else if (text == "|") opcode = 327877
    else if (text == "^") opcode = 327878
    else if (text == "&") opcode = 327879
    else if (text == "==") opcode = 327850
    else if (text == "!=") opcode = 327851
    else if (text == ">") opcode = if (signed) 327853 else 327852
    else if (text == ">=") opcode = if (signed) 327855 else 327854
    else if (text == "<") opcode = if (signed) 327857 else 327856
    else if (text == "<=") opcode = if (signed) 327859 else 327858
    else if (text == "||") opcode = 327846
    else if (text == "&&") opcode = 327847
    else if (text == "^^") opcode = 327845
    opcode
}

fun glslStorageTokenBinaryOperationClass(text: string): int {
    var operationClass = glslStorageOperationInteger
    if (text == "==" || text == "!=" || text == "<" || text == ">" ||
        text == "<=" || text == ">=") {
        operationClass = glslStorageOperationComparison
    } else if (text == "&&" || text == "^^" || text == "||") {
        operationClass = glslStorageOperationLogical
    }
    operationClass
}

fun glslStorageTokenCompoundOpcode(text: string, signed: bool): int {
    var opcode = 0
    if (text == "+=") opcode = 327808
    else if (text == "-=") opcode = 327810
    else if (text == "*=") opcode = 327812
    else if (text == "/=") opcode = if (signed) 327815 else 327814
    else if (text == "%=") opcode = if (signed) 327818 else 327817
    else if (text == "<<=") opcode = 327876
    else if (text == ">>=") opcode = if (signed) 327875 else 327874
    else if (text == "|=") opcode = 327877
    else if (text == "^=") opcode = 327878
    else if (text == "&=") opcode = 327879
    opcode
}

fun glslStorageTokenExpression(
    source: string,
    sourceTokens: array<GlslToken>,
    begin: int,
    minimumPrecedence: int,
    signed: bool,
    specializationName: string,
    specializationDefault: int,
    specializationBoolean: bool,
    specializationId: int,
    storageInstance: string,
    storageMembers: array<string>,
    localNames: array<string>,
    localTypes: array<int>,
    depth: int
): GlslStorageExpression {
    if (depth >= 128) {
        val empty: array<GlslStorageToken> = []
        return GlslStorageExpression(false, empty, begin)
    }
    val first = glslStorageTokenUnary(
        source,
        sourceTokens,
        begin,
        signed,
        specializationName,
        specializationDefault,
        specializationBoolean,
        specializationId,
        storageInstance,
        storageMembers,
        localNames,
        localTypes,
        depth
    )
    val tokens = glslStorageTokensCopy(first.tokens)
    var valid = first.valid
    var index = first.next
    var done = false
    while (valid && !done && tokens.size < 128 &&
        index < sourceTokens.size) {
        val operator = sourceTokens[index]
        val precedence = if (operator.kind == glslTokenOperator)
            glslStorageTokenBinaryPrecedence(operator.text) else 0
        if (precedence >= minimumPrecedence) {
            val right = glslStorageTokenExpression(
                source,
                sourceTokens,
                index + 1,
                precedence + 1,
                signed,
                specializationName,
                specializationDefault,
                specializationBoolean,
                specializationId,
                storageInstance,
                storageMembers,
                localNames,
                localTypes,
                depth + 1
            )
            valid = right.valid
            if (valid) {
                val copied = glslStorageTokensCopy(right.tokens)
                var copiedIndex = 0
                while (copiedIndex < copied.size) {
                    tokens.append(copied[copiedIndex])
                    copiedIndex = copiedIndex + 1
                }
                tokens.append(GlslStorageToken(
                    glslStorageTokenOperation,
                    opcode = glslStorageTokenBinaryOpcode(
                        operator.text,
                        signed
                    ),
                    operationClass =
                        glslStorageTokenBinaryOperationClass(operator.text),
                    line = operator.line,
                    column = operator.column
                ))
                index = right.next
            }
        } else done = true
    }
    if (valid && minimumPrecedence == 1 && tokens.size < 128 &&
        index < sourceTokens.size &&
        sourceTokens[index].is(glslTokenPunctuation, "?")) {
        val conditionalToken = sourceTokens[index]
        val whenTrue = glslStorageTokenExpression(
            source,
            sourceTokens,
            index + 1,
            1,
            signed,
            specializationName,
            specializationDefault,
            specializationBoolean,
            specializationId,
            storageInstance,
            storageMembers,
            localNames,
            localTypes,
            depth + 1
        )
        index = whenTrue.next
        valid = whenTrue.valid && index < sourceTokens.size &&
            sourceTokens[index].is(glslTokenPunctuation, ":")
        var whenFalse = GlslStorageExpression(false, [], index)
        if (valid) whenFalse = glslStorageTokenExpression(
            source,
            sourceTokens,
            index + 1,
            1,
            signed,
            specializationName,
            specializationDefault,
            specializationBoolean,
            specializationId,
            storageInstance,
            storageMembers,
            localNames,
            localTypes,
            depth + 1
        )
        valid = valid && whenFalse.valid
        if (valid) {
            val trueTokens = glslStorageTokensCopy(whenTrue.tokens)
            var copiedIndex = 0
            while (copiedIndex < trueTokens.size) {
                tokens.append(trueTokens[copiedIndex])
                copiedIndex = copiedIndex + 1
            }
            val falseTokens = glslStorageTokensCopy(whenFalse.tokens)
            copiedIndex = 0
            while (copiedIndex < falseTokens.size) {
                tokens.append(falseTokens[copiedIndex])
                copiedIndex = copiedIndex + 1
            }
            tokens.append(GlslStorageToken(
                glslStorageTokenOperation,
                opcode = 393385,
                arity = 3,
                operationClass = glslStorageOperationSelect,
                line = conditionalToken.line,
                column = conditionalToken.column
            ))
            index = whenFalse.next
        }
    }
    GlslStorageExpression(valid && tokens.size < 128, tokens, index)
}

fun glslStorageTokenPrimary(
    source: string,
    sourceTokens: array<GlslToken>,
    begin: int,
    signed: bool,
    specializationName: string,
    specializationDefault: int,
    specializationBoolean: bool,
    specializationId: int,
    storageInstance: string,
    storageMembers: array<string>,
    localNames: array<string>,
    localTypes: array<int>,
    depth: int
): GlslStorageExpression {
    val tokens: array<GlslStorageToken> = []
    var index = begin
    var valid = index < sourceTokens.size
    if (valid && sourceTokens[index].is(glslTokenPunctuation, "(")) {
        val nested = glslStorageTokenExpression(
            source,
            sourceTokens,
            index + 1,
            1,
            signed,
            specializationName,
            specializationDefault,
            specializationBoolean,
            specializationId,
            storageInstance,
            storageMembers,
            localNames,
            localTypes,
            depth + 1
        )
        index = nested.next
        valid = nested.valid && index < sourceTokens.size &&
            sourceTokens[index].is(glslTokenPunctuation, ")")
        if (valid) {
            val copied = glslStorageTokensCopy(nested.tokens)
            var copiedIndex = 0
            while (copiedIndex < copied.size) {
                tokens.append(copied[copiedIndex])
                copiedIndex = copiedIndex + 1
            }
            index = index + 1
        }
    } else if (valid && sourceTokens[index].kind == glslTokenIdentifier) {
        val nameToken = sourceTokens[index]
        val name = nameToken.text
        if ((name == "min" || name == "max" || name == "clamp") &&
            index + 1 < sourceTokens.size &&
            sourceTokens[index + 1].is(glslTokenPunctuation, "(")) {
            val arity = if (name == "clamp") 3 else 2
            index = index + 2
            var argument = 0
            while (valid && argument < arity && tokens.size < 128) {
                val parsed = glslStorageTokenExpression(
                    source,
                    sourceTokens,
                    index,
                    1,
                    signed,
                    specializationName,
                    specializationDefault,
                    specializationBoolean,
                    specializationId,
                    storageInstance,
                    storageMembers,
                    localNames,
                    localTypes,
                    depth + 1
                )
                valid = parsed.valid
                if (valid) {
                    var parsedIndex = 0
                    while (parsedIndex < parsed.tokens.size) {
                        tokens.append(parsed.tokens[parsedIndex])
                        parsedIndex = parsedIndex + 1
                    }
                    index = parsed.next
                    val separator = if (argument + 1 < arity) "," else ")"
                    valid = index < sourceTokens.size &&
                        sourceTokens[index].is(
                            glslTokenPunctuation,
                            separator
                        )
                    if (valid) index = index + 1
                }
                argument = argument + 1
            }
            if (valid && argument == arity) {
                val instruction = if (name == "min") {
                    if (signed) 39 else 38
                } else if (name == "max") {
                    if (signed) 42 else 41
                } else if (signed) 45 else 44
                tokens.append(GlslStorageToken(
                    glslStorageTokenOperation,
                    value = instruction,
                    arity = arity,
                    operationClass = glslStorageOperationExtInst,
                    line = nameToken.line,
                    column = nameToken.column
                ))
            }
        } else if (name == storageInstance) {
            valid = index + 2 < sourceTokens.size &&
                sourceTokens[index + 1].is(glslTokenPunctuation, ".") &&
                sourceTokens[index + 2].kind == glslTokenIdentifier
            var memberIndex = -1
            var reflectedMember = 0
            while (valid && memberIndex < 0 &&
                reflectedMember < storageMembers.size) {
                if (storageMembers[reflectedMember] ==
                    sourceTokens[index + 2].text) {
                    memberIndex = reflectedMember
                }
                reflectedMember = reflectedMember + 1
            }
            valid = valid && memberIndex >= 0
            if (valid) tokens.append(GlslStorageToken(
                glslStorageTokenLoad,
                memberIndex,
                line = nameToken.line,
                column = nameToken.column
            ))
            index = index + 3
        } else if (specializationName != "" && name == specializationName) {
            tokens.append(GlslStorageToken(
                glslStorageTokenSpecialization,
                specializationDefault,
                specializationId = specializationId,
                valueType = if (specializationBoolean) 1 else 0,
                line = nameToken.line,
                column = nameToken.column
            ))
            index = index + 1
        } else if (name == "true" || name == "false") {
            tokens.append(GlslStorageToken(
                glslStorageTokenLiteral,
                if (name == "true") 1 else 0,
                valueType = 1,
                line = nameToken.line,
                column = nameToken.column
            ))
            index = index + 1
        } else {
            val localIndex = glslStorageLocalIndex(localNames, name)
            valid = localIndex >= 0 && localIndex < localTypes.size
            if (valid) tokens.append(GlslStorageToken(
                glslStorageTokenLocalLoad,
                localIndex,
                valueType = localTypes[localIndex],
                line = nameToken.line,
                column = nameToken.column
            ))
            index = index + 1
        }
    } else if (valid && sourceTokens[index].kind == glslTokenInteger) {
        val parsed = glslIntegerDefault(sourceTokens[index].text, signed)
        valid = parsed.valid
        if (valid) tokens.append(GlslStorageToken(
            glslStorageTokenLiteral,
            parsed.bits,
            line = sourceTokens[index].line,
            column = sourceTokens[index].column
        ))
        index = index + 1
    } else valid = false
    GlslStorageExpression(valid && tokens.size > 0, tokens, index)
}

fun glslStorageTokenUnary(
    source: string,
    sourceTokens: array<GlslToken>,
    begin: int,
    signed: bool,
    specializationName: string,
    specializationDefault: int,
    specializationBoolean: bool,
    specializationId: int,
    storageInstance: string,
    storageMembers: array<string>,
    localNames: array<string>,
    localTypes: array<int>,
    depth: int
): GlslStorageExpression {
    if (depth >= 128) {
        val empty: array<GlslStorageToken> = []
        return GlslStorageExpression(false, empty, begin)
    }
    if (begin < sourceTokens.size &&
        sourceTokens[begin].kind == glslTokenOperator &&
        (sourceTokens[begin].text == "+" ||
         sourceTokens[begin].text == "-" ||
         sourceTokens[begin].text == "~" ||
         sourceTokens[begin].text == "!")) {
        val operator = sourceTokens[begin]
        val numeric = (operator.text == "+" || operator.text == "-") &&
            begin + 1 < sourceTokens.size &&
            sourceTokens[begin + 1].kind == glslTokenInteger
        if (numeric) {
            val parsed = glslIntegerDefault(
                source.slice(operator.begin, sourceTokens[begin + 1].end),
                signed
            )
            val tokens: array<GlslStorageToken> = []
            if (parsed.valid) tokens.append(GlslStorageToken(
                glslStorageTokenLiteral,
                parsed.bits,
                line = operator.line,
                column = operator.column
            ))
            return GlslStorageExpression(
                parsed.valid,
                tokens,
                begin + 2
            )
        }
        val operand = glslStorageTokenUnary(
            source,
            sourceTokens,
            begin + 1,
            signed,
            specializationName,
            specializationDefault,
            specializationBoolean,
            specializationId,
            storageInstance,
            storageMembers,
            localNames,
            localTypes,
            depth + 1
        )
        val tokens = glslStorageTokensCopy(operand.tokens)
        var valid = operand.valid && (operator.text != "-" || signed)
        if (valid && operator.text != "+") tokens.append(GlslStorageToken(
            glslStorageTokenOperation,
            opcode = if (operator.text == "-") 262270
                else if (operator.text == "~") 262344 else 262312,
            arity = 1,
            operationClass = if (operator.text == "!")
                glslStorageOperationLogical else glslStorageOperationInteger,
            line = operator.line,
            column = operator.column
        ))
        return GlslStorageExpression(
            valid && tokens.size < 128,
            tokens,
            operand.next
        )
    }
    glslStorageTokenPrimary(
        source,
        sourceTokens,
        begin,
        signed,
        specializationName,
        specializationDefault,
        specializationBoolean,
        specializationId,
        storageInstance,
        storageMembers,
        localNames,
        localTypes,
        depth
    )
}

class GlslStorageTokenMatch(val valid: bool, val next: int)

fun glslStorageTokenTake(
    tokens: array<GlslToken>,
    begin: int,
    kind: int,
    text: string = ""
): GlslStorageTokenMatch {
    val valid = begin < tokens.size && tokens[begin].is(kind, text)
    GlslStorageTokenMatch(valid, if (valid) begin + 1 else begin)
}

fun glslStorageTokenTextCopy(token: GlslToken): string =
    token.text.slice(0, token.text.size)

fun glslStorageLocalIndex(
    localNames: array<string>,
    name: string
): int {
    var found = -1
    var index = 0
    while (found < 0 && index < localNames.size) {
        if (localNames[index] == name) found = index
        index = index + 1
    }
    found
}

fun glslStorageUpdateTokens(
    loadKind: int,
    storeKind: int,
    value: int,
    valueType: int,
    increment: bool,
    line: int = -1,
    column: int = -1
): array<GlslStorageToken> = [
    GlslStorageToken(
        loadKind,
        value,
        valueType = valueType,
        line = line,
        column = column
    ),
    GlslStorageToken(
        glslStorageTokenLiteral,
        1,
        line = line,
        column = column
    ),
    GlslStorageToken(
        glslStorageTokenOperation,
        opcode = if (increment) 327808 else 327810,
        line = line,
        column = column
    ),
    GlslStorageToken(
        storeKind,
        value,
        valueType = valueType,
        line = line,
        column = column
    )
]

class GlslStorageTokenLayout(
    val valid: bool,
    val constantId: int = -1,
    val localSizeX: int = -1,
    val localSizeY: int = -1,
    val localSizeZ: int = -1,
    val set: int = 0,
    val setSpecified: bool = false,
    val binding: int = -1,
    val std430: bool = false,
    val next: int = 0
)

fun glslStorageTokenUnsigned(text: string): GlslInteger {
    var value = 0
    var index = 0
    var valid = text.size > 0
    while (valid && index < text.size) {
        val digit = text[index] - 48
        valid = digit >= 0 && digit <= 9 &&
            value <= (2147483647 - digit) / 10
        if (valid) value = value * 10 + digit
        index = index + 1
    }
    GlslInteger(valid && index == text.size, value, index)
}

fun glslStorageTokenLayout(
    tokens: array<GlslToken>,
    begin: int
): GlslStorageTokenLayout {
    var index = begin
    var matched = glslStorageTokenTake(
        tokens,
        index,
        glslTokenIdentifier,
        "layout"
    )
    var valid = matched.valid
    index = matched.next
    matched = glslStorageTokenTake(
        tokens,
        index,
        glslTokenPunctuation,
        "("
    )
    valid = valid && matched.valid
    index = matched.next
    var constantId = -1
    var localSizeX = -1
    var localSizeY = -1
    var localSizeZ = -1
    var set = 0
    var setSpecified = false
    var binding = -1
    var std430 = false
    var entries = 0
    var done = false
    while (valid && !done && entries < 16 && index < tokens.size) {
        if (tokens[index].is(glslTokenPunctuation, ")")) {
            index = index + 1
            done = true
        } else if (tokens[index].kind == glslTokenIdentifier) {
            val name = tokens[index].text
            index = index + 1
            if (name == "std430") {
                valid = !std430
                std430 = true
            } else {
                matched = glslStorageTokenTake(
                    tokens,
                    index,
                    glslTokenOperator,
                    "="
                )
                valid = matched.valid && matched.next < tokens.size &&
                    tokens[matched.next].kind == glslTokenInteger
                index = matched.next
                var integer = GlslInteger(false, 0, 0)
                if (valid) {
                    integer = glslStorageTokenUnsigned(tokens[index].text)
                    valid = integer.valid && integer.value <= 65535
                    index = index + 1
                }
                if (valid && name == "constant_id") {
                    valid = constantId < 0
                    constantId = integer.value
                } else if (valid && name == "local_size_x") {
                    valid = localSizeX < 0 && integer.value > 0
                    localSizeX = integer.value
                } else if (valid && name == "local_size_y") {
                    valid = localSizeY < 0 && integer.value > 0
                    localSizeY = integer.value
                } else if (valid && name == "local_size_z") {
                    valid = localSizeZ < 0 && integer.value > 0
                    localSizeZ = integer.value
                } else if (valid && name == "set") {
                    valid = !setSpecified
                    set = integer.value
                    setSpecified = true
                } else if (valid && name == "binding") {
                    valid = binding < 0
                    binding = integer.value
                } else valid = false
            }
            entries = entries + 1
            if (valid && index < tokens.size &&
                tokens[index].is(glslTokenPunctuation, ",")) {
                index = index + 1
                valid = index < tokens.size &&
                    !tokens[index].is(glslTokenPunctuation, ")")
            } else if (valid && index < tokens.size &&
                tokens[index].is(glslTokenPunctuation, ")")) {
                index = index + 1
                done = true
            } else valid = false
        } else valid = false
    }
    GlslStorageTokenLayout(
        valid && done && entries > 0,
        constantId,
        localSizeX,
        localSizeY,
        localSizeZ,
        set,
        setSpecified,
        binding,
        std430,
        index
    )
}
class GlslStorageTokenParsedDefault(
    val valid: bool,
    val bits: int = 0,
    val next: int = 0
)

fun glslStorageTokenDefault(
    source: string,
    tokens: array<GlslToken>,
    begin: int,
    signed: bool
): GlslStorageTokenParsedDefault {
    var index = begin
    if (index < tokens.size && tokens[index].kind == glslTokenOperator &&
        (tokens[index].text == "+" || tokens[index].text == "-")) {
        index = index + 1
    }
    val valid = index < tokens.size &&
        tokens[index].kind == glslTokenInteger
    if (valid) {
        val parsed = glslIntegerDefault(
            source.slice(tokens[begin].begin, tokens[index].end),
            signed
        )
        GlslStorageTokenParsedDefault(
            parsed.valid,
            parsed.bits,
            index + 1
        )
    } else GlslStorageTokenParsedDefault(false, next = index)
}

fun glslComputeStorageWrite(source: string): GlslStorageWrite {
    val lexical = glslLex(source)
    val sourceTokens = lexical.tokens
    var index = 0
    var matched = glslStorageTokenTake(
        sourceTokens,
        index,
        glslTokenPreprocessor,
        "#"
    )
    var valid = lexical.valid && matched.valid
    index = matched.next
    matched = glslStorageTokenTake(
        sourceTokens,
        index,
        glslTokenIdentifier,
        "version"
    )
    valid = valid && matched.valid
    index = matched.next
    var versionLine = -1
    if (valid && index < sourceTokens.size &&
        sourceTokens[index].kind == glslTokenInteger &&
        (sourceTokens[index].text == "450" ||
         sourceTokens[index].text == "460")) {
        versionLine = sourceTokens[index].line
        index = index + 1
    } else valid = false
    if (valid && index < sourceTokens.size &&
        sourceTokens[index].line == versionLine &&
        sourceTokens[index].is(glslTokenIdentifier, "core")) {
        index = index + 1
    }
    valid = valid && index < sourceTokens.size &&
        sourceTokens[index].line > versionLine

    var specializationName = ""
    var specializationId = -1
    var specializationDefault = 0
    var specializationType = ""
    val firstLayout = glslStorageTokenLayout(sourceTokens, index)
    index = firstLayout.next
    var workgroup = firstLayout
    if (firstLayout.constantId >= 0) {
        valid = valid && firstLayout.valid &&
            firstLayout.localSizeX < 0 &&
            firstLayout.localSizeY < 0 &&
            firstLayout.localSizeZ < 0 &&
            !firstLayout.setSpecified && firstLayout.binding < 0 &&
            !firstLayout.std430
        matched = glslStorageTokenTake(
            sourceTokens,
            index,
            glslTokenIdentifier,
            "const"
        )
        valid = valid && matched.valid
        index = matched.next
        if (valid && index < sourceTokens.size &&
            sourceTokens[index].kind == glslTokenIdentifier) {
            specializationType = glslStorageTokenTextCopy(
                sourceTokens[index]
            )
            valid = specializationType == "int" ||
                specializationType == "uint" ||
                specializationType == "bool"
            index = index + 1
        } else valid = false
        if (valid && index < sourceTokens.size &&
            sourceTokens[index].kind == glslTokenIdentifier) {
            specializationName = glslStorageTokenTextCopy(
                sourceTokens[index]
