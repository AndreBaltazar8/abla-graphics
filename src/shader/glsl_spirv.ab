                if (valid && firstMemberIndex < 0) {
                    firstMemberIndex = memberIndex
                }
                val postfixUpdate = index < sourceTokens.size &&
                    sourceTokens[index].kind == glslTokenOperator &&
                    (sourceTokens[index].text == "++" ||
