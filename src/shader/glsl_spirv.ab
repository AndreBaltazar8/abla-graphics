        this.bindings[0].set == 0 && this.bindings[0].binding == 0 &&
        this.bindings[0].storage == "uniform" &&
        this.bindings[0].dataType == "image2D" &&
        this.pushConstants.size == 0 &&
        this.specializationConstants.size == 0 &&
        glslStorageImageComputeSource(this.stages[0].source)
    val storageImageReadWrite = computeCommon && !specializedWorkgroup &&
