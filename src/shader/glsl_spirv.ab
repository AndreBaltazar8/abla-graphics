    valid = valid && workgroup.valid &&
        workgroup.constantId < 0 &&
        workgroup.localSizeX == 1 &&
        (workgroup.localSizeY < 0 || workgroup.localSizeY == 1) &&
        (workgroup.localSizeZ < 0 || workgroup.localSizeZ == 1) &&
        !workgroup.setSpecified && workgroup.binding < 0 &&
        !workgroup.std430
    matched = glslStorageTokenTake(
        sourceTokens,
        index,
        glslTokenIdentifier,
        "in"
    )
    valid = valid && matched.valid
    index = matched.next
    matched = glslStorageTokenTake(
        sourceTokens,
        index,
        glslTokenPunctuation,
        ";"
    )
    valid = valid && matched.valid
    index = matched.next

    val binding = glslStorageTokenLayout(sourceTokens, index)
    valid = valid && binding.valid && binding.constantId < 0 &&
        binding.localSizeX < 0 && binding.localSizeY < 0 &&
        binding.localSizeZ < 0 && binding.set == 0 &&
        binding.binding == 0
    index = binding.next
    matched = glslStorageTokenTake(
        sourceTokens,
        index,
        glslTokenIdentifier,
        "buffer"
    )
    valid = valid && matched.valid
    index = matched.next
    if (valid && index < sourceTokens.size &&
        sourceTokens[index].kind == glslTokenIdentifier) {
        index = index + 1
    } else valid = false
    matched = glslStorageTokenTake(
        sourceTokens,
        index,
        glslTokenPunctuation,
        "{"
    )
    valid = valid && matched.valid
    index = matched.next

    var memberCount = 0
    val memberNames: array<string> = []
    var signed = false
    var blockClosed = false
    while (valid && !blockClosed && memberCount <= 64) {
        if (index < sourceTokens.size &&
            sourceTokens[index].is(glslTokenPunctuation, "}")) {
            index = index + 1
            blockClosed = true
        } else {
            valid = memberCount < 64 && index < sourceTokens.size &&
                sourceTokens[index].kind == glslTokenIdentifier
            var memberSigned = false
            if (valid) {
                val memberType = sourceTokens[index].text
                memberSigned = memberType == "int"
                valid = memberSigned || memberType == "uint"
                index = index + 1
            }
            if (valid && memberCount == 0) signed = memberSigned
            else if (valid) valid = signed == memberSigned
            if (valid && index < sourceTokens.size &&
                sourceTokens[index].kind == glslTokenIdentifier) {
                memberNames.append(glslStorageTokenTextCopy(
                    sourceTokens[index]
                ))
                index = index + 1
            } else valid = false
            matched = glslStorageTokenTake(
                sourceTokens,
                index,
                glslTokenPunctuation,
                ";"
            )
            valid = valid && matched.valid
            index = matched.next
            memberCount = memberCount + 1
        }
    }
    valid = valid && blockClosed && memberCount > 0 &&
        (specializationType == "" ||
         specializationType == "bool" ||
         specializationType == (if (signed) "int" else "uint"))

    var instanceName = ""
    if (valid && index < sourceTokens.size &&
        sourceTokens[index].kind == glslTokenIdentifier) {
        instanceName = glslStorageTokenTextCopy(sourceTokens[index])
        index = index + 1
    } else valid = false
    matched = glslStorageTokenTake(
        sourceTokens,
        index,
        glslTokenPunctuation,
        ";"
    )
    valid = valid && matched.valid
    index = matched.next
    matched = glslStorageTokenTake(
        sourceTokens,
        index,
        glslTokenIdentifier,
        "void"
    )
    valid = valid && matched.valid
    index = matched.next
    matched = glslStorageTokenTake(
        sourceTokens,
        index,
        glslTokenIdentifier,
        "main"
    )
    valid = valid && matched.valid
    index = matched.next
    matched = glslStorageTokenTake(
        sourceTokens,
        index,
        glslTokenPunctuation,
        "("
    )
    valid = valid && matched.valid
    index = matched.next
    matched = glslStorageTokenTake(
        sourceTokens,
        index,
        glslTokenPunctuation,
        ")"
    )
    valid = valid && matched.valid
    index = matched.next
    matched = glslStorageTokenTake(
        sourceTokens,
        index,
        glslTokenPunctuation,
        "{"
    )
    valid = valid && matched.valid
    index = matched.next
    val programTokens: array<GlslStorageToken> = []
    val localNames: array<string> = []
    val localTypes: array<int> = []
    val localWritable: array<bool> = []
    val controlBeginTokenIndices: array<int> = []
    val controlElseEntered: array<bool> = []
    var controlDepth = 0
    var firstMemberIndex = -1
    var statements = 0
    var mainClosed = false
    while (valid && !mainClosed && statements <= 64) {
        if (index < sourceTokens.size &&
            sourceTokens[index].is(glslTokenPunctuation, "}")) {
            val closingToken = sourceTokens[index]
            index = index + 1
            if (controlDepth > 0) {
                val controlIndex = controlDepth - 1
                val hasElse = !controlElseEntered[controlIndex] &&
                    index < sourceTokens.size &&
                    sourceTokens[index].is(glslTokenIdentifier, "else")
                if (hasElse) {
                    val elseToken = sourceTokens[index]
                    val beginIndex = controlBeginTokenIndices[controlIndex]
                    val beginToken = programTokens[beginIndex]
                    programTokens[beginIndex] = GlslStorageToken(
                        glslStorageTokenIfBegin,
                        value = 1,
                        valueType = 1,
                        line = beginToken.line,
                        column = beginToken.column
                    )
                    index = index + 1
                    matched = glslStorageTokenTake(
                        sourceTokens,
                        index,
                        glslTokenPunctuation,
                        "{"
                    )
                    valid = matched.valid &&
                        programTokens.size + 1 < 8192
                    index = matched.next
                    if (valid) programTokens.append(GlslStorageToken(
                        glslStorageTokenElse,
                        line = elseToken.line,
                        column = elseToken.column
                    ))
                    controlElseEntered[controlIndex] = true
                } else {
                    valid = programTokens.size + 1 < 8192
                    if (valid) programTokens.append(GlslStorageToken(
                        glslStorageTokenIfEnd,
                        line = closingToken.line,
                        column = closingToken.column
                    ))
                    controlDepth = controlDepth - 1
                }
            } else mainClosed = true
        } else if (index < sourceTokens.size &&
            sourceTokens[index].is(glslTokenIdentifier, "if")) {
            val ifToken = sourceTokens[index]
            valid = statements < 64 && controlDepth < 64
            index = index + 1
            matched = glslStorageTokenTake(
                sourceTokens,
                index,
                glslTokenPunctuation,
                "("
            )
            valid = valid && matched.valid
            index = matched.next
            val empty: array<GlslStorageToken> = []
            var condition = GlslStorageExpression(false, empty, index)
            if (valid) condition = glslStorageTokenExpression(
                source,
                sourceTokens,
                index,
                1,
                signed,
                specializationName,
                specializationDefault,
                specializationType == "bool",
                specializationId,
                instanceName,
                memberNames,
                localNames,
                localTypes,
                0
            )
            valid = valid && condition.valid &&
                programTokens.size + condition.tokens.size + 1 < 8192
            index = condition.next
            matched = glslStorageTokenTake(
                sourceTokens,
                index,
                glslTokenPunctuation,
                ")"
            )
            valid = valid && matched.valid
            index = matched.next
            matched = glslStorageTokenTake(
                sourceTokens,
                index,
                glslTokenPunctuation,
                "{"
            )
            valid = valid && matched.valid
            index = matched.next
            if (valid) {
                var conditionIndex = 0
                while (conditionIndex < condition.tokens.size) {
                    programTokens.append(condition.tokens[conditionIndex])
                    conditionIndex = conditionIndex + 1
                }
                val beginIndex = programTokens.size
                programTokens.append(GlslStorageToken(
                    glslStorageTokenIfBegin,
                    valueType = 1,
                    line = ifToken.line,
                    column = ifToken.column
                ))
                if (controlDepth < controlBeginTokenIndices.size) {
                    controlBeginTokenIndices[controlDepth] = beginIndex
                    controlElseEntered[controlDepth] = false
                } else {
                    controlBeginTokenIndices.append(beginIndex)
                    controlElseEntered.append(false)
                }
                controlDepth = controlDepth + 1
            }
            statements = statements + 1
        } else {
            valid = statements < 64
            val statementLine = if (index < sourceTokens.size)
                sourceTokens[index].line else -1
            val statementColumn = if (index < sourceTokens.size)
                sourceTokens[index].column else -1
            val prefixUpdate = index < sourceTokens.size &&
                sourceTokens[index].kind == glslTokenOperator &&
                (sourceTokens[index].text == "++" ||
                 sourceTokens[index].text == "--")
            val localConst = index < sourceTokens.size &&
                sourceTokens[index].is(glslTokenIdentifier, "const")
            val localTypeIndex = index + if (localConst) 1 else 0
            val localDeclaration = localTypeIndex < sourceTokens.size &&
                sourceTokens[localTypeIndex].kind == glslTokenIdentifier &&
                (sourceTokens[localTypeIndex].text == "int" ||
                 sourceTokens[localTypeIndex].text == "uint" ||
                 sourceTokens[localTypeIndex].text == "bool")
            val statementLocalIndex = if (
                index < sourceTokens.size &&
                sourceTokens[index].kind == glslTokenIdentifier
            ) glslStorageLocalIndex(
                localNames,
