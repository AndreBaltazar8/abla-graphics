                        var updateIndex = 0
                        while (updateIndex < updateTokens.size) {
                            programTokens.append(updateTokens[updateIndex])
                            updateIndex = updateIndex + 1
                        }
                    }
                    expressionNext = index
                }
            } else if (localDeclaration) {
                if (localConst) index = index + 1
                val localTypeName = sourceTokens[index].text
                val localType = if (localTypeName == "bool") 1 else 0
                valid = valid && controlDepth == 0 &&
                    (localType == 1 ||
                     (signed && localTypeName == "int") ||
                     (!signed && localTypeName == "uint"))
                index = index + 1
                var declarationsDone = false
                while (valid && !declarationsDone && localNames.size < 64) {
                    var localName = ""
                    if (index < sourceTokens.size &&
                        sourceTokens[index].kind == glslTokenIdentifier) {
                        localName = glslStorageTokenTextCopy(
                            sourceTokens[index]
