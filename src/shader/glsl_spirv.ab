        ]
    } else if (texturedVertex) {
        words = [
            119734787, 65536, 524299, 31, 0,
            131089, 1,
            393227, 1, 1280527431, 1685353262, 808793134, 0,
            196622, 0, 1,
            589839, 0, 4, 1852399981, 0, 13, 18, 28, 29,
            196679, 11, 2,
            327752, 11, 0, 11, 0,
            327752, 11, 1, 11, 1,
            327752, 11, 2, 11, 3,
            327752, 11, 3, 11, 4,
            262215, 18, 30, 0,
            262215, 28, 30, 0,
            262215, 29, 30, 1,
            131091, 2,
            196641, 3, 2,
