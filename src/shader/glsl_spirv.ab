// Deterministic GLSL-to-SPIR-V translation implemented in Abla.
//
// The executable subsets are intentionally strict: compute packages cover
// fixed or specialized local sizes, scalar specialization constants, and the
// documented storage arithmetic forms. Typed fragment vec4/scalar expressions
// and immutable locals use a bounded postfix IR and generated SPIR-V. Any
// declaration or statement outside those subsets is rejected rather than lost.

import "glsl.ab"
import "spirv.ab"
import "../core.ab"
import "abla/float"

class GlslSpirvResult(
    val module: SpirvModule,
    val succeeded: bool,
    val error: string = ""
)

val glslStorageTokenLoad = 0
val glslStorageTokenLiteral = 1
val glslStorageTokenSpecialization = 2
val glslStorageTokenOperation = 3
val glslStorageTokenStore = 4
val glslStorageTokenLocalLoad = 5
val glslStorageTokenLocalStore = 6
val glslStorageTokenIfBegin = 7
val glslStorageTokenElse = 8
val glslStorageTokenIfEnd = 9
val glslStorageTokenWhileBegin = 10
val glslStorageTokenWhileCondition = 11
val glslStorageTokenWhileEnd = 12
val glslStorageTokenBreak = 13
val glslStorageTokenContinue = 14
val glslStorageTokenReturn = 15
val glslStorageOperationInteger = 0
val glslStorageOperationComparison = 1
val glslStorageOperationLogical = 2
val glslStorageOperationSelect = 3
val glslStorageOperationExtInst = 4

class GlslStorageToken(
    val kind: int,
    val value: int = 0,
    val opcode: int = 0,
    val specializationId: int = -1,
    val arity: int = 2,
    val operationClass: int = glslStorageOperationInteger,
    val valueType: int = 0,
    val line: int = -1,
    val column: int = -1
)

class GlslStorageSpirvEmission(
    val words: array<int>,
    val error: string = ""
)

class GlslStorageExpression(
    val valid: bool,
    val tokens: array<GlslStorageToken>,
    val next: int
)

class GlslStorageWrite(
    val valid: bool,
    val signed: bool = false,
    val tokens: array<GlslStorageToken> = [],
    val specialized: bool = false,
    val memberCount: int = 1,
    val memberIndex: int = 0,
    val error: string = ""
) {
    fun arithmetic(): bool {
        var result = false
        var index = 0
        while (!result && index < this.tokens.size) {
            result = this.tokens[index].kind == glslStorageTokenOperation
            index = index + 1
        }
        result
    }
}

val glslRasterTokenPushMember = 0
val glslRasterTokenVectorLiteral = 1
val glslRasterTokenOperation = 2
val glslRasterTokenScalarLiteral = 3
val glslRasterTokenInput = 4
val glslRasterTokenComponent = 5
val glslRasterTokenSwizzle = 6
val glslRasterTokenConstruct = 7
val glslRasterTokenDot = 8
val glslRasterTokenExtInst = 9
val glslRasterTokenDerivative = 10

val glslRasterTypeInvalid = 0
val glslRasterTypeScalar = 1
val glslRasterTypeVector2 = 2
val glslRasterTypeVector3 = 3
val glslRasterTypeVector = 4

fun glslRasterTypeVectorWidth(valueType: int): int {
    if (valueType == glslRasterTypeVector2) 2
    else if (valueType == glslRasterTypeVector3) 3
    else if (valueType == glslRasterTypeVector) 4 else 0
}

fun glslRasterTypeIsVector(valueType: int): bool =
    glslRasterTypeVectorWidth(valueType) > 0

fun glslRasterTypeForVectorWidth(width: int): int {
    if (width == 2) glslRasterTypeVector2
    else if (width == 3) glslRasterTypeVector3
    else if (width == 4) glslRasterTypeVector else glslRasterTypeInvalid
}

fun glslRasterDataType(dataType: string): int {
    if (dataType == "float") glslRasterTypeScalar
    else if (dataType == "vec2") glslRasterTypeVector2
    else if (dataType == "vec3") glslRasterTypeVector3
    else if (dataType == "vec4") glslRasterTypeVector
    else glslRasterTypeInvalid
}

fun glslRasterSpirvType(
    valueType: int,
    floatType: int,
    vector2Type: int,
    vector3Type: int,
    vector4Type: int
): int {
    if (valueType == glslRasterTypeScalar) floatType
    else if (valueType == glslRasterTypeVector2) vector2Type
    else if (valueType == glslRasterTypeVector3) vector3Type
    else if (valueType == glslRasterTypeVector) vector4Type else 0
}

class GlslRasterToken(
    val kind: int,
    val memberIndex: int = -1,
    val first: int = 0,
    val second: int = 0,
    val third: int = 0,
    val fourth: int = 0,
    val opcode: int = 0
)

class GlslRasterExpression(
    val valid: bool,
    val tokens: array<GlslRasterToken>,
    val next: int
)

class GlslRasterLocal(
    val name: string,
    val valueType: int,
    val tokens: array<GlslRasterToken>,
    val canAssign: bool = false
)

class GlslRasterFragmentProgram(
    val valid: bool,
    val expression: GlslRasterExpression,
    val inputs: array<ShaderLocation> = [],
    val memberCount: int = 0,
    val error: string = "",
    val outputs: array<ShaderLocation> = [],
    val expressions: array<GlslRasterExpression> = []
)

class GlslRasterFloat(
    val valid: bool,
    val bits: int = 0,
    val next: int = 0
)

fun glslRasterLiteralExpression(
    expression: GlslRasterExpression
): GlslRasterFloat {
    var valid = expression.valid && expression.tokens.size > 0 &&
        expression.tokens[0].kind == glslRasterTokenScalarLiteral
    var bits = if (valid) expression.tokens[0].first else 0
    if (valid && expression.tokens.size == 2) {
        valid = expression.tokens[1].kind == glslRasterTokenOperation &&
            expression.tokens[1].opcode == 262271
        if (valid) bits = if (bits >= 2147483648)
            bits - 2147483648 else bits + 2147483648
    } else valid = valid && expression.tokens.size == 1
    GlslRasterFloat(valid, bits)
}

fun glslRasterTokensCopy(
    source: array<GlslRasterToken>
): array<GlslRasterToken> {
    val result: array<GlslRasterToken> = []
    var index = 0
    while (index < source.size) {
        result.append(source[index])
        index = index + 1
    }
    result
}

fun glslRasterFloat(
    sourceTokens: array<GlslToken>,
    begin: int
): GlslRasterFloat {
    var index = begin
    var sign = ""
    if (index < sourceTokens.size &&
        (sourceTokens[index].text == "+" ||
         sourceTokens[index].text == "-")) {
        sign = sourceTokens[index].text
        index = index + 1
    }
    val parsed = if (index < sourceTokens.size)
        glslFloatingDefault("$sign${sourceTokens[index].text}", true)
    else GlslSpirvDefault(false)
    GlslRasterFloat(parsed.valid, parsed.bits, if (parsed.valid) index + 1
        else begin)
}

fun glslRasterBinaryPrecedence(text: string): int {
    if (text == "*" || text == "/") 12
    else if (text == "+" || text == "-") 11 else 0
}

fun glslRasterBinaryOpcode(text: string): int {
    if (text == "+") 327809
    else if (text == "-") 327811
    else if (text == "*") 327813
    else if (text == "/") 327816 else 0
}

fun glslRasterCompoundOpcode(text: string): int {
    if (text == "+=") 327809
    else if (text == "-=") 327811
    else if (text == "*=") 327813
    else if (text == "/=") 327816 else 0
}

fun glslRasterDerivativeOpcode(text: string): int {
    if (text == "dFdx") 262351
    else if (text == "dFdy") 262352
    else if (text == "fwidth") 262353
    else if (text == "dFdxFine") 262354
    else if (text == "dFdyFine") 262355
    else if (text == "fwidthFine") 262356
    else if (text == "dFdxCoarse") 262357
    else if (text == "dFdyCoarse") 262358
    else if (text == "fwidthCoarse") 262359 else 0
}

fun glslRasterComponentIndex(text: string): int {
    if (text == "x" || text == "r" || text == "s") 0
    else if (text == "y" || text == "g" || text == "t") 1
    else if (text == "z" || text == "b" || text == "p") 2
    else if (text == "w" || text == "a" || text == "q") 3 else -1
}

fun glslRasterComponentFamily(text: string): int {
    if (text == "x" || text == "y" || text == "z" || text == "w") 0
    else if (text == "r" || text == "g" || text == "b" || text == "a") 1
    else if (text == "s" || text == "t" || text == "p" || text == "q") 2
    else -1
}

fun glslRasterExtInstruction(text: string): int {
    if (text == "round") 1
    else if (text == "roundEven") 2
    else if (text == "trunc") 3
    else if (text == "abs") 4
    else if (text == "sign") 6
    else if (text == "floor") 8
    else if (text == "ceil") 9
    else if (text == "fract") 10
    else if (text == "radians") 11
    else if (text == "degrees") 12
    else if (text == "sin") 13
    else if (text == "cos") 14
    else if (text == "tan") 15
    else if (text == "asin") 16
    else if (text == "acos") 17
    else if (text == "atan") 18
    else if (text == "sinh") 19
    else if (text == "cosh") 20
    else if (text == "tanh") 21
    else if (text == "asinh") 22
    else if (text == "acosh") 23
    else if (text == "atanh") 24
    else if (text == "pow") 26
    else if (text == "exp") 27
    else if (text == "log") 28
    else if (text == "exp2") 29
    else if (text == "log2") 30
    else if (text == "sqrt") 31
    else if (text == "inversesqrt") 32
    else if (text == "min") 37
    else if (text == "max") 40
    else if (text == "clamp") 43
    else if (text == "mix") 46
    else if (text == "step") 48
    else if (text == "smoothstep") 49
    else if (text == "fma") 50
    else if (text == "length") 66
    else if (text == "distance") 67
    else if (text == "cross") 68
    else if (text == "normalize") 69
    else if (text == "faceforward") 70
    else if (text == "reflect") 71
    else if (text == "refract") 72 else 0
}

fun glslRasterExtArity(instruction: int): int {
    if ((instruction >= 1 && instruction <= 24 && instruction != 5 &&
         instruction != 7) ||
        (instruction >= 27 && instruction <= 32) || instruction == 66 ||
        instruction == 69) 1
    else if (instruction == 25 || instruction == 26 || instruction == 37 ||
        instruction == 40 || instruction == 48 || instruction == 67 ||
        instruction == 68 || instruction == 71) 2
    else if (instruction == 43 || instruction == 46 || instruction == 49 ||
        instruction == 50 || instruction == 70 || instruction == 72) 3
    else 0
}

fun glslRasterExtCallInstruction(
    sourceTokens: array<GlslToken>,
    nameIndex: int
): int {
    val instruction = glslRasterExtInstruction(sourceTokens[nameIndex].text)
    var resolved = instruction
    if (instruction == 18 &&
        glslRasterTokenText(sourceTokens, nameIndex + 1, "(")) {
        var index = nameIndex + 2
        var depth = 0
        var done = false
        while (!done && index < sourceTokens.size) {
            val text = sourceTokens[index].text
            if (text == "(") depth = depth + 1
            else if (text == ")") {
                if (depth == 0) done = true
                else depth = depth - 1
            } else if (text == "," && depth == 0) {
                resolved = 25
                done = true
            }
            index = index + 1
        }
    }
    resolved
}

fun glslRasterExtResultType(
    instruction: int,
    arity: int,
    stack: array<int>,
    stackSize: int
): int {
    var resultType = glslRasterTypeInvalid
    val begin = stackSize - arity
    if (begin >= 0 && instruction == 46) {
        if (arity == 3 && stack[begin] == stack[begin + 1] &&
            (stack[begin] == glslRasterTypeScalar ||
             glslRasterTypeIsVector(stack[begin])) &&
            (stack[begin + 2] == stack[begin] ||
             (glslRasterTypeIsVector(stack[begin]) &&
              stack[begin + 2] == glslRasterTypeScalar))) {
            resultType = stack[begin]
        }
    } else if (begin >= 0 && instruction == 48) {
        if (arity == 2 && stack[begin + 1] == glslRasterTypeScalar &&
            stack[begin] == glslRasterTypeScalar) {
            resultType = glslRasterTypeScalar
        } else if (arity == 2 && glslRasterTypeIsVector(stack[begin + 1]) &&
            (stack[begin] == stack[begin + 1] ||
             stack[begin] == glslRasterTypeScalar)) {
            resultType = stack[begin + 1]
        }
    } else if (begin >= 0 && instruction == 49) {
        if (arity == 3 && stack[begin + 2] == glslRasterTypeScalar &&
            stack[begin] == glslRasterTypeScalar &&
            stack[begin + 1] == glslRasterTypeScalar) {
            resultType = glslRasterTypeScalar
        } else if (arity == 3 && glslRasterTypeIsVector(stack[begin + 2]) &&
            ((stack[begin] == stack[begin + 2] &&
              stack[begin + 1] == stack[begin + 2]) ||
             (stack[begin] == glslRasterTypeScalar &&
              stack[begin + 1] == glslRasterTypeScalar))) {
            resultType = stack[begin + 2]
        }
    } else if (begin >= 0 && (instruction == 37 || instruction == 40)) {
        if (arity == 2 && stack[begin] == glslRasterTypeScalar &&
            stack[begin + 1] == glslRasterTypeScalar) {
            resultType = glslRasterTypeScalar
        } else if (arity == 2 && glslRasterTypeIsVector(stack[begin]) &&
            (stack[begin + 1] == stack[begin] ||
             stack[begin + 1] == glslRasterTypeScalar)) {
            resultType = stack[begin]
        }
    } else if (begin >= 0 && instruction == 43) {
        if (arity == 3 && stack[begin] == glslRasterTypeScalar &&
            stack[begin + 1] == glslRasterTypeScalar &&
            stack[begin + 2] == glslRasterTypeScalar) {
            resultType = glslRasterTypeScalar
        } else if (arity == 3 && glslRasterTypeIsVector(stack[begin]) &&
            ((stack[begin + 1] == stack[begin] &&
              stack[begin + 2] == stack[begin]) ||
             (stack[begin + 1] == glslRasterTypeScalar &&
              stack[begin + 2] == glslRasterTypeScalar))) {
            resultType = stack[begin]
        }
    } else if (begin >= 0 && (instruction == 66 || instruction == 67)) {
        var valid = glslRasterTypeIsVector(stack[begin])
        var argument = 1
        while (valid && argument < arity) {
            valid = stack[begin + argument] == stack[begin]
            argument = argument + 1
        }
        if (valid) resultType = glslRasterTypeScalar
    } else if (begin >= 0 && instruction == 68) {
        if (arity == 2 && stack[begin] == glslRasterTypeVector3 &&
            stack[begin + 1] == glslRasterTypeVector3) {
            resultType = glslRasterTypeVector3
        }
    } else if (begin >= 0 && (instruction == 69 || instruction == 70 ||
        instruction == 71)) {
        var valid = glslRasterTypeIsVector(stack[begin])
        var argument = 1
        while (valid && argument < arity) {
            valid = stack[begin + argument] == stack[begin]
            argument = argument + 1
        }
        if (valid) resultType = stack[begin]
    } else if (begin >= 0 && instruction == 72) {
        if (arity == 3 && glslRasterTypeIsVector(stack[begin]) &&
            stack[begin + 1] == stack[begin] &&
            stack[begin + 2] == glslRasterTypeScalar) {
            resultType = stack[begin]
        }
    } else if (begin >= 0) {
        val candidate = stack[begin]
        var valid = candidate == glslRasterTypeScalar ||
            glslRasterTypeIsVector(candidate)
        var argument = 1
        while (valid && argument < arity) {
            valid = stack[begin + argument] == candidate
            argument = argument + 1
        }
        if (valid) resultType = candidate
    }
    resultType
}

fun glslRasterPrimary(
    sourceTokens: array<GlslToken>,
    begin: int,
    push: ShaderPushConstant,
    inputs: array<ShaderLocation>,
    locals: array<GlslRasterLocal>,
    depth: int
): GlslRasterExpression {
    val tokens: array<GlslRasterToken> = []
    var index = begin
    var valid = depth < 64 && index < sourceTokens.size
    if (valid && (sourceTokens[index].text == "+" ||
        sourceTokens[index].text == "-")) {
        val negate = sourceTokens[index].text == "-"
        val signed = glslRasterPrimary(
            sourceTokens,
            index + 1,
            push,
            inputs,
            locals,
            depth + 1
        )
        valid = signed.valid
        index = signed.next
        if (valid) {
            val copied = glslRasterTokensCopy(signed.tokens)
            var copiedIndex = 0
            while (copiedIndex < copied.size) {
                tokens.append(copied[copiedIndex])
                copiedIndex = copiedIndex + 1
            }
            if (negate) tokens.append(GlslRasterToken(
                glslRasterTokenOperation,
                opcode = 262271
            ))
        }
    } else if (valid && sourceTokens[index].text == "(") {
        val nested = glslRasterExpression(
            sourceTokens,
            index + 1,
            1,
            push,
            inputs,
            locals,
            depth + 1
        )
        index = nested.next
        valid = nested.valid && index < sourceTokens.size &&
            sourceTokens[index].text == ")"
        if (valid) {
            val copied = glslRasterTokensCopy(nested.tokens)
            var copiedIndex = 0
            while (copiedIndex < copied.size) {
                tokens.append(copied[copiedIndex])
                copiedIndex = copiedIndex + 1
            }
            index = index + 1
        }
    } else if (valid &&
        glslRasterExtInstruction(sourceTokens[index].text) > 0) {
        val functionName = sourceTokens[index].text
        val instruction = glslRasterExtCallInstruction(sourceTokens, index)
        val arity = glslRasterExtArity(instruction)
        index = index + 1
        valid = glslRasterTokenText(sourceTokens, index, "(")
        if (valid) index = index + 1
        val arguments: array<GlslRasterExpression> = []
        var argumentIndex = 0
        while (valid && argumentIndex < arity) {
            val argument = glslRasterExpression(
                sourceTokens,
                index,
                1,
                push,
                inputs,
                locals,
                depth + 1
            )
            valid = argument.valid
            index = argument.next
            if (valid) {
                arguments.append(argument)
                val separator = if (argumentIndex + 1 < arity) "," else ")"
                valid = glslRasterTokenText(sourceTokens, index, separator)
                if (valid) index = index + 1
            }
            argumentIndex = argumentIndex + 1
        }
        if (valid) {
            argumentIndex = 0
            while (argumentIndex < arguments.size) {
                val copied =
                    glslRasterTokensCopy(arguments[argumentIndex].tokens)
                var copiedIndex = 0
                while (copiedIndex < copied.size) {
                    tokens.append(copied[copiedIndex])
                    copiedIndex = copiedIndex + 1
                }
                argumentIndex = argumentIndex + 1
            }
            tokens.append(GlslRasterToken(
                glslRasterTokenExtInst,
                memberIndex = instruction,
                first = arity
            ))
        }
    } else if (valid && sourceTokens[index].text == "dot") {
        index = index + 1
        valid = glslRasterTokenText(sourceTokens, index, "(")
        if (valid) index = index + 1
        val left = if (valid) glslRasterExpression(
            sourceTokens,
            index,
            1,
            push,
            inputs,
            locals,
            depth + 1
        ) else GlslRasterExpression(false, [], index)
        index = left.next
        valid = valid && left.valid &&
            glslRasterTokenText(sourceTokens, index, ",")
        if (valid) index = index + 1
        val right = if (valid) glslRasterExpression(
            sourceTokens,
            index,
            1,
            push,
            inputs,
            locals,
            depth + 1
        ) else GlslRasterExpression(false, [], index)
        index = right.next
        valid = valid && right.valid &&
            glslRasterTokenText(sourceTokens, index, ")")
        if (valid) {
            val leftTokens = glslRasterTokensCopy(left.tokens)
            var copiedIndex = 0
            while (copiedIndex < leftTokens.size) {
                tokens.append(leftTokens[copiedIndex])
                copiedIndex = copiedIndex + 1
            }
            val rightTokens = glslRasterTokensCopy(right.tokens)
            copiedIndex = 0
            while (copiedIndex < rightTokens.size) {
                tokens.append(rightTokens[copiedIndex])
                copiedIndex = copiedIndex + 1
            }
            tokens.append(GlslRasterToken(glslRasterTokenDot))
            index = index + 1
        }
    } else if (valid &&
        glslRasterDerivativeOpcode(sourceTokens[index].text) != 0) {
        val opcode = glslRasterDerivativeOpcode(sourceTokens[index].text)
        index = index + 1
        valid = glslRasterTokenText(sourceTokens, index, "(")
        if (valid) index = index + 1
        val argument = if (valid) glslRasterExpression(
            sourceTokens,
            index,
            1,
            push,
            inputs,
            locals,
            depth + 1
        ) else GlslRasterExpression(false, [], index)
        index = argument.next
        valid = valid && argument.valid &&
            glslRasterTokenText(sourceTokens, index, ")")
        if (valid) {
            val copied = glslRasterTokensCopy(argument.tokens)
            var copiedIndex = 0
            while (copiedIndex < copied.size) {
                tokens.append(copied[copiedIndex])
                copiedIndex = copiedIndex + 1
            }
            tokens.append(GlslRasterToken(
                glslRasterTokenDerivative,
                opcode = opcode
            ))
            index = index + 1
        }
    } else if (valid && sourceTokens[index].text == "mod") {
        index = index + 1
        valid = glslRasterTokenText(sourceTokens, index, "(")
        if (valid) index = index + 1
        val left = if (valid) glslRasterExpression(
            sourceTokens,
            index,
            1,
            push,
            inputs,
            locals,
            depth + 1
        ) else GlslRasterExpression(false, [], index)
        index = left.next
        valid = valid && left.valid &&
            glslRasterTokenText(sourceTokens, index, ",")
        if (valid) index = index + 1
        val right = if (valid) glslRasterExpression(
            sourceTokens,
            index,
            1,
            push,
            inputs,
            locals,
            depth + 1
        ) else GlslRasterExpression(false, [], index)
        index = right.next
        valid = valid && right.valid &&
            glslRasterTokenText(sourceTokens, index, ")")
        if (valid) {
            val leftTokens = glslRasterTokensCopy(left.tokens)
            var copiedIndex = 0
            while (copiedIndex < leftTokens.size) {
                tokens.append(leftTokens[copiedIndex])
                copiedIndex = copiedIndex + 1
            }
            val rightTokens = glslRasterTokensCopy(right.tokens)
            copiedIndex = 0
            while (copiedIndex < rightTokens.size) {
                tokens.append(rightTokens[copiedIndex])
                copiedIndex = copiedIndex + 1
            }
            tokens.append(GlslRasterToken(
                glslRasterTokenOperation,
                opcode = 327821
            ))
            index = index + 1
        }
    } else if (valid && (sourceTokens[index].text == "vec2" ||
        sourceTokens[index].text == "vec3" ||
        sourceTokens[index].text == "vec4")) {
        val constructorWidth = if (sourceTokens[index].text == "vec2") 2
            else if (sourceTokens[index].text == "vec3") 3 else 4
        index = index + 1
        valid = index < sourceTokens.size && sourceTokens[index].text == "("
        if (valid) index = index + 1
        val arguments: array<GlslRasterExpression> = []
        var constructorDone = false
        while (valid && !constructorDone && arguments.size < 5) {
            val argument = glslRasterExpression(
                sourceTokens,
                index,
                1,
                push,
                inputs,
                locals,
                depth + 1
            )
            valid = argument.valid
            index = argument.next
            if (valid) {
                arguments.append(argument)
                if (glslRasterTokenText(sourceTokens, index, ",")) {
                    index = index + 1
                } else {
                    valid = glslRasterTokenText(sourceTokens, index, ")")
                    if (valid) {
                        index = index + 1
                        constructorDone = true
                    }
                }
            }
        }
        valid = valid && constructorDone &&
            (arguments.size == 1 || arguments.size == constructorWidth)
        val literalBits = [0, 0, 0, 0]
        var allLiterals = valid && constructorWidth == 4
        var argumentIndex = 0
        while (valid && argumentIndex < arguments.size) {
            valid = glslRasterExpressionType(
                arguments[argumentIndex],
                push,
                inputs
            ) == glslRasterTypeScalar
            val literal =
                glslRasterLiteralExpression(arguments[argumentIndex])
            allLiterals = allLiterals && literal.valid
            if (literal.valid) literalBits[argumentIndex] = literal.bits
            argumentIndex = argumentIndex + 1
        }
        if (valid && allLiterals) {
            if (arguments.size == 1) {
                literalBits[1] = literalBits[0]
                literalBits[2] = literalBits[0]
                literalBits[3] = literalBits[0]
            }
            tokens.append(GlslRasterToken(
                glslRasterTokenVectorLiteral,
                first = literalBits[0],
                second = literalBits[1],
                third = literalBits[2],
                fourth = literalBits[3]
            ))
        } else if (valid) {
            argumentIndex = 0
            while (argumentIndex < arguments.size) {
                val copied =
                    glslRasterTokensCopy(arguments[argumentIndex].tokens)
                var copiedIndex = 0
                while (copiedIndex < copied.size) {
                    tokens.append(copied[copiedIndex])
                    copiedIndex = copiedIndex + 1
                }
                argumentIndex = argumentIndex + 1
            }
            tokens.append(GlslRasterToken(
                glslRasterTokenConstruct,
                memberIndex = arguments.size,
                first = constructorWidth
            ))
        }
    } else if (valid && sourceTokens[index].text == push.name) {
        index = index + 1
        valid = index < sourceTokens.size && sourceTokens[index].text == "."
        if (valid) index = index + 1
        val memberName = if (index < sourceTokens.size)
            sourceTokens[index].text else ""
        var memberIndex = -1
        var candidate = 0
        while (memberIndex < 0 && candidate < push.members.size) {
            if (push.members[candidate].name == memberName &&
                glslRasterDataType(
                    push.members[candidate].dataType
                ) != glslRasterTypeInvalid &&
                push.members[candidate].arraySize == 1) {
                memberIndex = candidate
            }
            candidate = candidate + 1
        }
        valid = valid && memberIndex >= 0
        if (valid) {
            tokens.append(GlslRasterToken(
                glslRasterTokenPushMember,
                memberIndex = memberIndex
            ))
            index = index + 1
        }
    } else if (valid) {
        var inputIndex = -1
        var candidate = 0
        while (inputIndex < 0 && candidate < inputs.size) {
            if (inputs[candidate].name == sourceTokens[index].text) {
                inputIndex = candidate
            }
            candidate = candidate + 1
        }
        if (inputIndex >= 0) {
            tokens.append(GlslRasterToken(
                glslRasterTokenInput,
                memberIndex = inputIndex
            ))
            index = index + 1
        } else {
            var localIndex = -1
            candidate = 0
            while (localIndex < 0 && candidate < locals.size) {
                if (locals[candidate].name == sourceTokens[index].text) {
                    localIndex = candidate
                }
                candidate = candidate + 1
            }
            if (localIndex >= 0) {
                val copied = glslRasterTokensCopy(
                    locals[localIndex].tokens
                )
                var copiedIndex = 0
                while (copiedIndex < copied.size) {
                    tokens.append(copied[copiedIndex])
                    copiedIndex = copiedIndex + 1
                }
                index = index + 1
            } else {
                val scalar = glslRasterFloat(sourceTokens, index)
                valid = scalar.valid
                if (valid) {
                    tokens.append(GlslRasterToken(
                        glslRasterTokenScalarLiteral,
                        first = scalar.bits
                    ))
                    index = scalar.next
                }
            }
        }
    }
    if (valid && index + 1 < sourceTokens.size &&
        sourceTokens[index].text == ".") {
        val selector = sourceTokens[index + 1].text
        val component = glslRasterComponentIndex(selector)
        if (component >= 0) {
            tokens.append(GlslRasterToken(
                glslRasterTokenComponent,
                memberIndex = component
            ))
            index = index + 2
        } else {
            valid = selector.size >= 2 && selector.size <= 4
            val components = [0, 0, 0, 0]
            var family = -1
            var selectorIndex = 0
            while (valid && selectorIndex < selector.size) {
                val selected = selector.slice(
                    selectorIndex,
                    selectorIndex + 1
                )
                val selectedFamily =
                    glslRasterComponentFamily(selected)
                components[selectorIndex] =
                    glslRasterComponentIndex(selected)
                if (family < 0) family = selectedFamily
                valid = selectedFamily >= 0 && selectedFamily == family &&
                    components[selectorIndex] >= 0
                selectorIndex = selectorIndex + 1
            }
            if (valid) {
                tokens.append(GlslRasterToken(
                    glslRasterTokenSwizzle,
                    memberIndex = selector.size,
                    first = components[0],
                    second = components[1],
                    third = components[2],
                    fourth = components[3]
                ))
                index = index + 2
            }
        }
    }
    GlslRasterExpression(valid && tokens.size > 0, tokens, index)
}

fun glslRasterExpression(
    sourceTokens: array<GlslToken>,
    begin: int,
    minimumPrecedence: int,
    push: ShaderPushConstant,
    inputs: array<ShaderLocation>,
    locals: array<GlslRasterLocal>,
    depth: int
): GlslRasterExpression {
    if (depth >= 64) return GlslRasterExpression(false, [], begin)
    val first = glslRasterPrimary(
        sourceTokens, begin, push, inputs, locals, depth
    )
    val tokens = glslRasterTokensCopy(first.tokens)
    var valid = first.valid
    var index = first.next
    var done = false
    while (valid && !done && tokens.size < 64 &&
        index < sourceTokens.size) {
        val precedence = glslRasterBinaryPrecedence(
            sourceTokens[index].text
        )
        if (precedence >= minimumPrecedence) {
            val opcode = glslRasterBinaryOpcode(sourceTokens[index].text)
            val right = glslRasterExpression(
                sourceTokens,
                index + 1,
                precedence + 1,
                push,
                inputs,
                locals,
                depth + 1
            )
            valid = opcode != 0 && right.valid
            if (valid) {
                val copied = glslRasterTokensCopy(right.tokens)
                var copiedIndex = 0
                while (copiedIndex < copied.size) {
                    tokens.append(copied[copiedIndex])
                    copiedIndex = copiedIndex + 1
                }
                tokens.append(GlslRasterToken(
                    glslRasterTokenOperation,
                    opcode = opcode
                ))
                index = right.next
            }
        } else done = true
    }
    GlslRasterExpression(valid && tokens.size > 0 && tokens.size < 64,
        tokens, index)
}

fun glslRasterExpressionType(
    expression: GlslRasterExpression,
    push: ShaderPushConstant,
    inputs: array<ShaderLocation>
): int {
    val stack: array<int> = []
    var stackSize = 0
    var valid = expression.valid
    var tokenIndex = 0
    while (valid && tokenIndex < expression.tokens.size) {
        val token = expression.tokens[tokenIndex]
        var valueType = glslRasterTypeInvalid
        if (token.kind == glslRasterTokenVectorLiteral) {
            valueType = glslRasterTypeVector
        } else if (token.kind == glslRasterTokenInput) {
            valid = token.kind != glslRasterTokenInput ||
                (token.memberIndex >= 0 &&
                 token.memberIndex < inputs.size)
            if (valid) valueType = glslRasterDataType(
                inputs[token.memberIndex].dataType
            )
            valid = valid && valueType != glslRasterTypeInvalid
        } else if (token.kind == glslRasterTokenScalarLiteral) {
            valueType = glslRasterTypeScalar
        } else if (token.kind == glslRasterTokenPushMember) {
            valid = token.memberIndex >= 0 &&
                token.memberIndex < push.members.size
            if (valid) valueType = glslRasterDataType(
                push.members[token.memberIndex].dataType
            )
            valid = valid && valueType != glslRasterTypeInvalid
        } else if (token.kind == glslRasterTokenConstruct) {
            val arity = token.memberIndex
            val constructedType = glslRasterTypeForVectorWidth(token.first)
            valid = constructedType != glslRasterTypeInvalid &&
                (arity == 1 || arity == token.first) && stackSize >= arity
            var argument = 0
            while (valid && argument < arity) {
                valid = stack[stackSize - arity + argument] ==
                    glslRasterTypeScalar
                argument = argument + 1
            }
            if (valid) {
                stackSize = stackSize - arity
                valueType = constructedType
            }
        } else if (token.kind == glslRasterTokenDot) {
            valid = stackSize >= 2 &&
                stack[stackSize - 2] == stack[stackSize - 1] &&
                glslRasterTypeIsVector(stack[stackSize - 2])
            if (valid) {
                stackSize = stackSize - 2
                valueType = glslRasterTypeScalar
            }
        } else if (token.kind == glslRasterTokenExtInst) {
            val arity = token.first
            valid = arity > 0 &&
                arity == glslRasterExtArity(token.memberIndex) &&
                stackSize >= arity
            val resultType = if (valid) glslRasterExtResultType(
                token.memberIndex,
                arity,
                stack,
                stackSize
            ) else glslRasterTypeInvalid
            valid = valid && resultType != glslRasterTypeInvalid
            if (valid) {
                stackSize = stackSize - arity
                valueType = resultType
            }
        } else if (token.kind == glslRasterTokenDerivative) {
            valid = stackSize >= 1 &&
                token.opcode >= 262351 && token.opcode <= 262359
            if (valid) {
                valueType = stack[stackSize - 1]
                stackSize = stackSize - 1
            }
        } else if (token.kind == glslRasterTokenComponent) {
            val sourceType = if (stackSize >= 1) stack[stackSize - 1]
                else glslRasterTypeInvalid
            valid = stackSize >= 1 && token.memberIndex >= 0 &&
                token.memberIndex < glslRasterTypeVectorWidth(sourceType)
            if (valid) {
                stackSize = stackSize - 1
                valueType = glslRasterTypeScalar
            }
        } else if (token.kind == glslRasterTokenSwizzle) {
            val sourceType = if (stackSize >= 1) stack[stackSize - 1]
                else glslRasterTypeInvalid
            val sourceWidth = glslRasterTypeVectorWidth(sourceType)
            val resultType = glslRasterTypeForVectorWidth(token.memberIndex)
            valid = stackSize >= 1 && sourceWidth > 0 &&
                resultType != glslRasterTypeInvalid &&
                token.first >= 0 && token.first < sourceWidth &&
                token.second >= 0 && token.second < sourceWidth &&
                (token.memberIndex < 3 ||
                 (token.third >= 0 && token.third < sourceWidth)) &&
                (token.memberIndex < 4 ||
                 (token.fourth >= 0 && token.fourth < sourceWidth))
            if (valid) {
                stackSize = stackSize - 1
                valueType = resultType
            }
        } else if (token.kind == glslRasterTokenOperation &&
            token.opcode == 262271) {
            valid = stackSize >= 1
            if (valid) {
                valueType = stack[stackSize - 1]
                stackSize = stackSize - 1
            }
        } else if (token.kind == glslRasterTokenOperation) {
            valid = stackSize >= 2
            if (valid) {
                val rightType = stack[stackSize - 1]
                val leftType = stack[stackSize - 2]
                stackSize = stackSize - 2
                if (token.opcode == 327809 || token.opcode == 327811) {
                    valid = leftType == rightType
                    valueType = leftType
                } else if (token.opcode == 327813) {
                    valid = leftType == rightType ||
                        (glslRasterTypeIsVector(leftType) &&
                         rightType == glslRasterTypeScalar) ||
                        (leftType == glslRasterTypeScalar &&
                         glslRasterTypeIsVector(rightType))
                    valueType = if (glslRasterTypeIsVector(leftType)) leftType
                        else if (glslRasterTypeIsVector(rightType)) rightType
                        else glslRasterTypeScalar
                } else if (token.opcode == 327816 ||
                    token.opcode == 327821) {
                    valid = leftType == rightType ||
                        (glslRasterTypeIsVector(leftType) &&
                         rightType == glslRasterTypeScalar)
                    valueType = leftType
                } else valid = false
            }
        } else valid = false
        valid = valid && valueType != glslRasterTypeInvalid
        if (valid) {
            if (stackSize < stack.size) stack[stackSize] = valueType
            else stack.append(valueType)
            stackSize = stackSize + 1
        }
        tokenIndex = tokenIndex + 1
    }
    if (valid && stackSize == 1) stack[0] else glslRasterTypeInvalid
}

fun glslRasterTokenText(
    sourceTokens: array<GlslToken>,
    index: int,
    expected: string
): bool = index >= 0 && index < sourceTokens.size &&
    sourceTokens[index].text == expected

fun ShaderPackage.rasterFragmentProgram(): GlslRasterFragmentProgram {
    val source = this.source(shaderStageFragment)
    val lexical = glslLex(source)
    var pushIndex = -1
    var index = 0
    while (pushIndex < 0 && index < this.pushConstants.size) {
        if (this.pushConstants[index].stage == shaderStageFragment) {
            pushIndex = index
        }
        index = index + 1
    }
    val inputs: array<ShaderLocation> = []
    val outputs: array<ShaderLocation> = []
    index = 0
    while (index < this.locations.size) {
        val location = this.locations[index]
        if (location.stage == shaderStageFragment &&
            location.direction == "out") {
            outputs.append(location)
        } else if (location.stage == shaderStageFragment &&
            location.direction == "in") {
            inputs.append(location)
        }
        index = index + 1
    }
    var valid = this.valid && lexical.valid && inputs.size <= 8 &&
        outputs.size > 0 && outputs.size <= 8
    var inputIndex = 0
    while (valid && inputIndex < inputs.size) {
        valid = glslRasterTypeIsVector(glslRasterDataType(
            inputs[inputIndex].dataType
        )) &&
            inputs[inputIndex].arraySize == 1
        inputIndex = inputIndex + 1
    }
    var outputIndex = 0
    while (valid && outputIndex < outputs.size) {
        valid = outputs[outputIndex].location >= 0 &&
            glslRasterTypeIsVector(glslRasterDataType(
                outputs[outputIndex].dataType
            )) &&
            outputs[outputIndex].arraySize == 1
        outputIndex = outputIndex + 1
    }
    val push = if (pushIndex >= 0) this.pushConstants[pushIndex]
        else ShaderPushConstant("", "", "", [])
    index = 0
    valid = valid && glslRasterTokenText(lexical.tokens, index, "#")
    if (valid) index = index + 1
    valid = valid && glslRasterTokenText(lexical.tokens, index, "version")
    if (valid) index = index + 1
    valid = valid && index < lexical.tokens.size &&
        (lexical.tokens[index].text == "450" ||
         lexical.tokens[index].text == "460")
    if (valid) index = index + 1
    if (valid && glslRasterTokenText(lexical.tokens, index, "core")) {
        index = index + 1
    }
    inputIndex = 0
    while (valid && inputIndex < inputs.size) {
        val input = inputs[inputIndex]
        val inputTokens = [
            "layout", "(", "location", "=", "${input.location}", ")",
            "in", input.dataType, input.name, ";"
        ]
        var inputTokenIndex = 0
        while (valid && inputTokenIndex < inputTokens.size) {
            valid = glslRasterTokenText(
                lexical.tokens,
                index,
                inputTokens[inputTokenIndex]
            )
            if (valid) index = index + 1
            inputTokenIndex = inputTokenIndex + 1
        }
        inputIndex = inputIndex + 1
    }
    outputIndex = 0
    while (valid && outputIndex < outputs.size) {
        val output = outputs[outputIndex]
        val outputTokens = [
            "layout", "(", "location", "=", "${output.location}", ")",
            "out", output.dataType, output.name, ";"
        ]
        var outputTokenIndex = 0
        while (valid && outputTokenIndex < outputTokens.size) {
            valid = glslRasterTokenText(
                lexical.tokens,
                index,
                outputTokens[outputTokenIndex]
            )
            if (valid) index = index + 1
            outputTokenIndex = outputTokenIndex + 1
        }
        outputIndex = outputIndex + 1
    }
    val pushTokens = [
        "layout", "(", "push_constant", ")", "uniform", push.dataType,
        "{"
    ]
    var expectedIndex = 0
    while (valid && pushIndex >= 0 && expectedIndex < pushTokens.size) {
        valid = glslRasterTokenText(
            lexical.tokens,
            index,
            pushTokens[expectedIndex]
        )
        if (valid) index = index + 1
        expectedIndex = expectedIndex + 1
    }
    var memberIndex = 0
    while (valid && memberIndex < push.members.size) {
        val member = push.members[memberIndex]
        valid = glslRasterDataType(member.dataType) !=
                glslRasterTypeInvalid &&
            member.arraySize == 1 &&
            glslRasterTokenText(lexical.tokens, index, member.dataType) &&
            glslRasterTokenText(lexical.tokens, index + 1, member.name) &&
            glslRasterTokenText(lexical.tokens, index + 2, ";")
        if (valid) index = index + 3
        memberIndex = memberIndex + 1
    }
    val pushEndTokens = ["}", push.name, ";"]
    expectedIndex = 0
    while (valid && pushIndex >= 0 &&
        expectedIndex < pushEndTokens.size) {
        valid = glslRasterTokenText(
            lexical.tokens,
            index,
            pushEndTokens[expectedIndex]
        )
        if (valid) index = index + 1
        expectedIndex = expectedIndex + 1
    }
    val mainTokens = ["void", "main", "(", ")", "{"]
    expectedIndex = 0
    while (valid && expectedIndex < mainTokens.size) {
        valid = glslRasterTokenText(
            lexical.tokens,
            index,
            mainTokens[expectedIndex]
        )
        if (valid) index = index + 1
        expectedIndex = expectedIndex + 1
    }
    val locals: array<GlslRasterLocal> = []
    var localStatementCount = 0
    var localDone = false
    while (valid && !localDone && localStatementCount < 32) {
        val tokenText = if (index < lexical.tokens.size)
            lexical.tokens[index].text else ""
        val constantDeclaration = tokenText == "const"
        val declaration = constantDeclaration || tokenText == "float" ||
            tokenText == "vec2" || tokenText == "vec3" ||
            tokenText == "vec4"
        if (declaration) {
            val dataTypeIndex = if (constantDeclaration) index + 1
                else index
            val dataType = if (dataTypeIndex < lexical.tokens.size)
                lexical.tokens[dataTypeIndex].text else ""
            val valueType = if (dataType == "float") glslRasterTypeScalar
                else if (dataType == "vec2") glslRasterTypeVector2
                else if (dataType == "vec3") glslRasterTypeVector3
                else if (dataType == "vec4") glslRasterTypeVector
                else glslRasterTypeInvalid
            index = dataTypeIndex + 1
            valid = valueType != glslRasterTypeInvalid
            var declarationDone = false
            while (valid && !declarationDone) {
                val name = if (index < lexical.tokens.size)
                    lexical.tokens[index].text else ""
                var duplicate = name == "" || name == push.name ||
                    locals.size >= 8
                var localIndex = 0
                while (!duplicate && localIndex < locals.size) {
                    duplicate = locals[localIndex].name == name
                    localIndex = localIndex + 1
                }
                var interfaceIndex = 0
                while (!duplicate && interfaceIndex < inputs.size) {
                    duplicate = inputs[interfaceIndex].name == name
                    interfaceIndex = interfaceIndex + 1
                }
                interfaceIndex = 0
                while (!duplicate && interfaceIndex < outputs.size) {
                    duplicate = outputs[interfaceIndex].name == name
                    interfaceIndex = interfaceIndex + 1
                }
                valid = !duplicate && glslRasterTokenText(
                    lexical.tokens,
                    index + 1,
                    "="
                )
                if (valid) index = index + 2
                val localExpression = if (valid) glslRasterExpression(
                    lexical.tokens,
                    index,
                    1,
                    push,
                    inputs,
                    locals,
                    0
                ) else GlslRasterExpression(false, [], index)
                index = localExpression.next
                valid = valid && localExpression.valid &&
                    glslRasterExpressionType(
                        localExpression,
                        push,
                        inputs
                    ) == valueType
                if (valid) {
                    locals.append(GlslRasterLocal(
                        name,
                        valueType,
                        glslRasterTokensCopy(localExpression.tokens),
                        !constantDeclaration
                    ))
                    if (glslRasterTokenText(
                        lexical.tokens,
                        index,
                        ","
                    )) index = index + 1
                    else {
                        valid = glslRasterTokenText(
                            lexical.tokens,
                            index,
                            ";"
                        )
                        if (valid) {
                            index = index + 1
                            localStatementCount = localStatementCount + 1
                            declarationDone = true
                        }
                    }
                }
            }
        } else {
            val prefixUpdate = tokenText == "++" || tokenText == "--"
            val localName = if (prefixUpdate &&
                index + 1 < lexical.tokens.size)
                lexical.tokens[index + 1].text else tokenText
            var localIndex = -1
            var candidate = 0
            while (localIndex < 0 && candidate < locals.size) {
                if (locals[candidate].name == localName) {
                    localIndex = candidate
                }
                candidate = candidate + 1
            }
            if (localIndex < 0) localDone = true
            else {
                val assignmentText = if (index + 1 < lexical.tokens.size)
                    lexical.tokens[index + 1].text else ""
                val postfixUpdate = assignmentText == "++" ||
                    assignmentText == "--"
                val updateText = if (prefixUpdate) tokenText
                    else if (postfixUpdate) assignmentText else ""
                if (updateText != "") {
                    valid = locals[localIndex].canAssign &&
                        glslRasterTokenText(lexical.tokens, index + 2, ";")
                    val updatedTokens =
                        glslRasterTokensCopy(locals[localIndex].tokens)
                    if (valid &&
                        locals[localIndex].valueType == glslRasterTypeScalar) {
                        updatedTokens.append(GlslRasterToken(
                            glslRasterTokenScalarLiteral,
                            first = 1065353216
                        ))
                    } else if (valid && locals[localIndex].valueType ==
                        glslRasterTypeVector) {
                        updatedTokens.append(GlslRasterToken(
                            glslRasterTokenVectorLiteral,
                            first = 1065353216,
                            second = 1065353216,
                            third = 1065353216,
                            fourth = 1065353216
                        ))
                    } else valid = false
                    if (valid) updatedTokens.append(GlslRasterToken(
                        glslRasterTokenOperation,
                        opcode = if (updateText == "++") 327809 else 327811
                    ))
                    val updatedExpression = GlslRasterExpression(
                        valid && updatedTokens.size < 64,
                        updatedTokens,
                        index + 3
                    )
                    valid = valid && updatedExpression.valid &&
                        glslRasterExpressionType(
                            updatedExpression,
                            push,
                            inputs
                        ) == locals[localIndex].valueType
                    if (valid) {
                        locals[localIndex] = GlslRasterLocal(
                            locals[localIndex].name,
                            locals[localIndex].valueType,
                            glslRasterTokensCopy(updatedExpression.tokens),
                            true
                        )
                        index = index + 3
                        localStatementCount = localStatementCount + 1
                    }
                } else {
                    val compoundOpcode =
                        glslRasterCompoundOpcode(assignmentText)
                    valid = locals[localIndex].canAssign &&
                        (assignmentText == "=" || compoundOpcode != 0)
                    if (valid) index = index + 2
                    val rightExpression = if (valid) glslRasterExpression(
                        lexical.tokens,
                        index,
                        1,
                        push,
                        inputs,
                        locals,
                        0
                    ) else GlslRasterExpression(false, [], index)
                    index = rightExpression.next
                    val assignedTokens: array<GlslRasterToken> = []
                    if (compoundOpcode != 0) {
                        val previous =
                            glslRasterTokensCopy(locals[localIndex].tokens)
                        var previousIndex = 0
                        while (previousIndex < previous.size) {
                            assignedTokens.append(previous[previousIndex])
                            previousIndex = previousIndex + 1
                        }
                    }
                    if (valid) {
                        val copied =
                            glslRasterTokensCopy(rightExpression.tokens)
                        var copiedIndex = 0
                        while (copiedIndex < copied.size) {
                            assignedTokens.append(copied[copiedIndex])
                            copiedIndex = copiedIndex + 1
                        }
                        if (compoundOpcode != 0) {
                            assignedTokens.append(GlslRasterToken(
                                glslRasterTokenOperation,
                                opcode = compoundOpcode
                            ))
                        }
                    }
                    val assignedExpression = GlslRasterExpression(
                        valid && rightExpression.valid &&
                            assignedTokens.size > 0 &&
                            assignedTokens.size < 64,
                        assignedTokens,
                        index
                    )
                    valid = valid && assignedExpression.valid &&
                        glslRasterExpressionType(
                            assignedExpression,
                            push,
                            inputs
                        ) == locals[localIndex].valueType &&
                        glslRasterTokenText(lexical.tokens, index, ";")
                    if (valid) {
                        locals[localIndex] = GlslRasterLocal(
                            locals[localIndex].name,
                            locals[localIndex].valueType,
                            glslRasterTokensCopy(assignedExpression.tokens),
                            true
                        )
                        index = index + 1
                        localStatementCount = localStatementCount + 1
                    }
                }
            }
        }
    }
    val expressions: array<GlslRasterExpression> = []
    outputIndex = 0
    while (valid && outputIndex < outputs.size) {
        valid = glslRasterTokenText(
            lexical.tokens,
            index,
            outputs[outputIndex].name
        ) && glslRasterTokenText(lexical.tokens, index + 1, "=")
        if (valid) index = index + 2
        val expression = if (valid) glslRasterExpression(
            lexical.tokens,
            index,
            1,
            push,
            inputs,
            locals,
            0
        ) else GlslRasterExpression(false, [], index)
        index = expression.next
        valid = valid && expression.valid &&
            glslRasterTokenText(lexical.tokens, index, ";")
        if (valid) {
            expressions.append(expression)
            index = index + 1
        }
        outputIndex = outputIndex + 1
    }
    valid = valid && expressions.size == outputs.size &&
        glslRasterTokenText(lexical.tokens, index, "}") &&
        index + 1 < lexical.tokens.size &&
        lexical.tokens[index + 1].kind == glslTokenEnd
    val expression = if (expressions.size > 0) expressions[0]
        else GlslRasterExpression(false, [], index)
    GlslRasterFragmentProgram(
        valid,
        expression,
        inputs,
        push.members.size,
        if (valid) "" else
            "fragment source is outside the typed raster expression subset",
        outputs,
        expressions
    )
}

fun glslRasterFragmentSpirv(
    program: GlslRasterFragmentProgram,
    layout: ShaderPushConstantLayout
): GlslStorageSpirvEmission {
    val words: array<int> = [
        spirvMagic, spirvVersion10, 0, 0, 0
    ]
    var valid = program.valid && layout.valid &&
        (program.memberCount == 0 ||
