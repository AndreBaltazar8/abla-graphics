                    body.append(131320)
                    body.append(loopContinueIds[loopIndex])
                    var local = 0
                    while (valid && local < localIds.size) {
                        val phiId = loopLocalPhiIds[localBase + local]
                        val patchIndex =
                            loopLocalPatchIndices[localBase + local]
                        if (phiId >= 0) {
                            valid = patchIndex >= 0 && patchIndex < body.size
                            if (valid) {
                                val edgeCount =
                                    loopContinueEdgeCounts[loopIndex]
                                var backEdgeValue =
                                    loopEntryLocalIds[localBase + local]
                                var allSame = edgeCount > 0
                                var edge = 0
                                while (edge < edgeCount) {
                                    val value = loopContinueLocalIds[
