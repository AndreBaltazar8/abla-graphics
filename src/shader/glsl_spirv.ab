                val predecessorId = currentBlockId
                val headerId = nextId
                val bodyId = nextId + 1
                val continueId = nextId + 2
                val mergeId = nextId + 3
                nextId = nextId + 4
                val mutated: array<bool> = []
                var local = 0
                while (local < localIds.size) {
