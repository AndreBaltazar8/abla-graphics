// Immutable backend-neutral GPU resource descriptors.

import "abla/unsafe/memory"
import "core.ab"

val bufferUsageMapRead = 1
val bufferUsageMapWrite = 2
val bufferUsageCopySource = 4
val bufferUsageCopyDestination = 8
val bufferUsageIndex = 16
val bufferUsageVertex = 32
val bufferUsageUniform = 64
val bufferUsageStorage = 128
val bufferUsageIndirect = 256
val bufferUsageQueryResolve = 512
val bufferUsageAll = 1023

val vertexFormatFloat32 = 1
val vertexFormatFloat32x2 = 2
val vertexFormatFloat32x3 = 3
val vertexFormatFloat32x4 = 4
val vertexFormatUint32 = 5

fun vertexFormatSize(format: int): int {
    var size = 0
    if (format == vertexFormatFloat32 || format == vertexFormatUint32) size = 4
    else if (format == vertexFormatFloat32x2) size = 8
    else if (format == vertexFormatFloat32x3) size = 12
    else if (format == vertexFormatFloat32x4) size = 16
    size
}

fun vertexFormatGlslType(format: int): string {
    var dataType = ""
    if (format == vertexFormatFloat32) dataType = "float"
    else if (format == vertexFormatFloat32x2) dataType = "vec2"
    else if (format == vertexFormatFloat32x3) dataType = "vec3"
    else if (format == vertexFormatFloat32x4) dataType = "vec4"
    else if (format == vertexFormatUint32) dataType = "uint"
    dataType
}

class VertexAttribute(
    val location: int = 0,
    val offset: int = 0,
    val format: int = vertexFormatFloat32x2
) {
    fun valid(stride: int): bool {
        val size = vertexFormatSize(this.format)
        stride > 0 && this.location >= 0 && this.location <= 31 &&
            this.offset >= 0 && size > 0 && this.offset <= stride - size
    }
}

class VertexBufferLayout(
    val stride: int = 0,
    val attributes: array<VertexAttribute> = []
) {
    fun valid(): bool {
        var valid = (this.stride == 0 && this.attributes.size == 0) ||
            (this.stride >= 8 && this.stride <= 2048 &&
             this.attributes.size <= 16)
        var index = 0
        while (valid && index < this.attributes.size) {
            valid = this.attributes[index].valid(this.stride)
            var earlier = 0
            while (valid && earlier < index) {
                valid = this.attributes[earlier].location !=
                    this.attributes[index].location
                earlier = earlier + 1
            }
            index = index + 1
        }
        valid
    }

    fun buffered(): bool = this.stride > 0
    fun attributeCount(): int = if (!this.buffered()) 0
        else if (this.attributes.size == 0) 1 else this.attributes.size
}

val textureUsageCopySource = 1
val textureUsageCopyDestination = 2
val textureUsageSampled = 4
val textureUsageStorage = 8
val textureUsageRenderAttachment = 16
val textureUsageAll = 31

val textureDimension1D = 1
val textureDimension2D = 2
val textureDimension3D = 3

val textureFormatUndefined = 0
val textureFormatR8Unorm = 1
val textureFormatRg8Unorm = 2
val textureFormatRgba8Unorm = 3
val textureFormatRgba8UnormSrgb = 4
val textureFormatBgra8Unorm = 5
val textureFormatBgra8UnormSrgb = 6
val textureFormatR16Float = 7
val textureFormatRg16Float = 8
val textureFormatRgba16Float = 9
val textureFormatR32Float = 10
val textureFormatRg32Float = 11
val textureFormatRgba32Float = 12
val textureFormatDepth16Unorm = 13
val textureFormatDepth24Stencil8 = 14
val textureFormatDepth32Float = 15
val textureFormatDepth32FloatStencil8 = 16

val textureAspectAll = 0
val textureAspectColor = 1
val textureAspectDepth = 2
val textureAspectStencil = 3

val samplerAddressClampToEdge = 0
val samplerAddressRepeat = 1
val samplerAddressMirrorRepeat = 2

val samplerFilterNearest = 0
val samplerFilterLinear = 1

val compareFunctionUndefined = 0
val compareFunctionNever = 1
val compareFunctionLess = 2
val compareFunctionEqual = 3
val compareFunctionLessEqual = 4
val compareFunctionGreater = 5
val compareFunctionNotEqual = 6
val compareFunctionGreaterEqual = 7
val compareFunctionAlways = 8

class DepthStencilState(
    val enabled: bool = false,
    val write: bool = false,
    val compare: int = compareFunctionLess
) {
    fun valid(): bool = this.compare >= compareFunctionNever &&
        this.compare <= compareFunctionAlways &&
        (!this.write || this.enabled)
}

val attachmentLoadOperationLoad = 0
val attachmentLoadOperationClear = 1
val attachmentLoadOperationDiscard = 2

val attachmentStoreOperationStore = 0
val attachmentStoreOperationDiscard = 1

class RenderAttachmentOperations(
    val load: int = attachmentLoadOperationClear,
    val store: int = attachmentStoreOperationStore
) {
    fun valid(): bool = this.load >= attachmentLoadOperationLoad &&
        this.load <= attachmentLoadOperationDiscard &&
        this.store >= attachmentStoreOperationStore &&
        this.store <= attachmentStoreOperationDiscard
}

class RenderPassOperations(
    val color: RenderAttachmentOperations = RenderAttachmentOperations(),
    val additionalColors: array<RenderAttachmentOperations> = [],
    val depth: RenderAttachmentOperations = RenderAttachmentOperations()
) {
    fun valid(colorCount: int, hasDepth: bool): bool {
        var valid = colorCount >= 1 && colorCount <= 8 &&
            (this.additionalColors.size == 0 ||
             this.additionalColors.size == colorCount - 1) &&
            this.color.valid() && (!hasDepth || this.depth.valid())
        var index = 0
        while (valid && index < this.additionalColors.size) {
            valid = this.additionalColors[index].valid()
            index = index + 1
        }
        valid
    }
}

resource class RenderPassClearValues(
    val color: Color,
    val additionalColors: array<Color>,
    val colorCount: int,
    val red: f64,
    val green: f64,
    val blue: f64,
    val alpha: f64,
    val depth: f64,
    val stencil: int,
    val colorsValid: bool,
    val address: i64*,
    val capacity: int,
    val storage: NativeByteBuffer
) {
    fun valid(colorCount: int, hasDepth: bool): bool {
        val valid = colorCount >= 1 && colorCount <= 8 &&
            this.colorCount == colorCount &&
            this.colorsValid && graphicsColorScalarsValid(
                this.red,
                this.green,
                this.blue,
                this.alpha
            ) && this.depth >= 0.0 && this.depth <= 1.0 &&
            this.stencil == 0 && !pointerIsNull(this.address) &&
            this.capacity >= colorCount * 16 + 8
        valid && (hasDepth || (this.depth == 1.0 && this.stencil == 0))
    }

    fun drop(): void {
        this.storage.close()
        return
    }
}

trusted fun renderPassClearValues(
    color: Color = Color(0.0, 0.0, 0.0),
    additionalColors: array<Color> = [],
    depth: f64 = 1.0,
    stencil: int = 0
): RenderPassClearValues {
    val storage = nativeByteBuffer((1 + additionalColors.size) * 16 + 8)
    var colorsValid = color.valid()
    var index = 0
    while (index < 1 + additionalColors.size) {
        val selected = if (index == 0) color else additionalColors[index - 1]
        colorsValid = colorsValid && selected.valid()
        val offset = index * 16
        storage.storeI64(
            offset,
            (graphicsScalarF32Bits(selected.green) & 4294967295) *
                4294967296 +
                (graphicsScalarF32Bits(selected.red) & 4294967295)
        )
        storage.storeI64(
            offset + 8,
            (graphicsScalarF32Bits(selected.alpha) & 4294967295) *
                4294967296 +
                (graphicsScalarF32Bits(selected.blue) & 4294967295)
        )
        index = index + 1
    }
    storage.storeI64(
        (1 + additionalColors.size) * 16,
        stencil * 4294967296 +
            (graphicsScalarF32Bits(depth) & 4294967295)
    )
    RenderPassClearValues(
        Color(color.red, color.green, color.blue, color.alpha),
        additionalColors,
        1 + additionalColors.size,
        color.red,
        color.green,
        color.blue,
        color.alpha,
        depth,
        stencil,
        colorsValid,
        storage.address,
        storage.capacity,
        move(storage)
    )
}

class GraphicsDescriptorValidation(
    val succeeded: bool,
    val field: string = "",
    val message: string = ""
)

fun graphicsDescriptorValid(): GraphicsDescriptorValidation =
    GraphicsDescriptorValidation(true)

fun graphicsDescriptorInvalid(
    field: string,
    message: string
): GraphicsDescriptorValidation =
    GraphicsDescriptorValidation(false, field, message)

fun graphicsUsageValid(usage: int, allowed: int): bool =
    usage > 0 && (usage & allowed) == usage

fun textureFormatValid(format: int): bool =
    format >= textureFormatR8Unorm &&
    format <= textureFormatDepth32FloatStencil8

fun textureFormatHasDepth(format: int): bool =
    format >= textureFormatDepth16Unorm &&
    format <= textureFormatDepth32FloatStencil8

fun textureFormatHasStencil(format: int): bool =
    format == textureFormatDepth24Stencil8 ||
    format == textureFormatDepth32FloatStencil8

fun textureFormatsViewCompatible(textureFormat: int, viewFormat: int): bool =
    textureFormat == viewFormat ||
    (textureFormat == textureFormatRgba8Unorm &&
     viewFormat == textureFormatRgba8UnormSrgb) ||
    (textureFormat == textureFormatRgba8UnormSrgb &&
     viewFormat == textureFormatRgba8Unorm) ||
    (textureFormat == textureFormatBgra8Unorm &&
     viewFormat == textureFormatBgra8UnormSrgb) ||
    (textureFormat == textureFormatBgra8UnormSrgb &&
     viewFormat == textureFormatBgra8Unorm)

fun textureMaximumMipLevels(size: Extent3D): int {
    var maximum = size.width
    if (size.height > maximum) maximum = size.height
    if (size.depth > maximum) maximum = size.depth
    var levels = 0
    while (maximum > 0) {
        levels = levels + 1
        maximum = maximum / 2
    }
    levels
}

fun textureMipDimension(base: int, mipLevel: int): int {
    var result = base
    var level = 0
    while (result > 1 && level < mipLevel) {
        result = result / 2
        level = level + 1
    }
    result
}

fun textureFormatAcceptsRgba8Pixels(format: int): bool =
    format == textureFormatRgba8Unorm ||
    format == textureFormatRgba8UnormSrgb ||
    format == textureFormatBgra8Unorm ||
    format == textureFormatBgra8UnormSrgb

class TextureWriteDescriptor(
    val mipLevel: int = 0,
    val x: int = 0,
    val y: int = 0
) {
    fun validation(
        texture: TextureDescriptor,
        width: int,
        height: int,
        requiredUsage: int = textureUsageCopyDestination
    ): GraphicsDescriptorValidation {
        var result = graphicsDescriptorValid()
        if (!texture.valid() || width <= 0 || height <= 0) {
            result = graphicsDescriptorInvalid(
                "pixels",
                "texture transfer requires valid non-empty pixel storage"
            )
        } else if ((texture.usage & requiredUsage) == 0) {
            result = graphicsDescriptorInvalid(
                "usage",
                "texture transfer usage is missing from the texture"
            )
        } else if (!textureFormatAcceptsRgba8Pixels(texture.format)) {
            result = graphicsDescriptorInvalid(
                "format",
                "RGBA8 pixel transfer requires an RGBA8 or BGRA8 texture"
            )
        } else if (this.mipLevel < 0 ||
            this.mipLevel >= texture.mipLevels) {
            result = graphicsDescriptorInvalid(
                "mipLevel",
                "texture transfer mip level is out of range"
            )
        } else {
            val mipWidth = textureMipDimension(
                texture.size.width,
                this.mipLevel
            )
            val mipHeight = textureMipDimension(
                texture.size.height,
                this.mipLevel
            )
            if (this.x < 0 || this.y < 0 || this.x >= mipWidth ||
                this.y >= mipHeight || width > mipWidth - this.x ||
                height > mipHeight - this.y) {
                result = graphicsDescriptorInvalid(
                    "origin",
                    "texture transfer region exceeds the selected mip level"
                )
            }
        }
        result
    }

    fun valid(
        texture: TextureDescriptor,
        width: int,
        height: int,
        requiredUsage: int = textureUsageCopyDestination
    ): bool {
        var succeeded = texture.valid() && width > 0 && height > 0 &&
            (texture.usage & requiredUsage) != 0 &&
            textureFormatAcceptsRgba8Pixels(texture.format) &&
            this.mipLevel >= 0 && this.mipLevel < texture.mipLevels
        if (succeeded) {
            val mipWidth = textureMipDimension(
                texture.size.width,
                this.mipLevel
            )
            val mipHeight = textureMipDimension(
                texture.size.height,
                this.mipLevel
            )
            succeeded = this.x >= 0 && this.y >= 0 &&
                this.x < mipWidth && this.y < mipHeight &&
                width <= mipWidth - this.x && height <= mipHeight - this.y
        }
        succeeded
    }
}

class TextureCopyDescriptor(
    val sourceMipLevel: int = 0,
    val sourceX: int = 0,
    val sourceY: int = 0,
    val destinationMipLevel: int = 0,
    val destinationX: int = 0,
    val destinationY: int = 0,
    val width: int = -1,
    val height: int = -1
) {
    fun resolvedWidth(source: TextureDescriptor): int =
        if (this.width == -1 && this.sourceMipLevel >= 0 &&
            this.sourceMipLevel < source.mipLevels)
            textureMipDimension(
                source.size.width,
                this.sourceMipLevel
            ) - this.sourceX
        else this.width

    fun resolvedHeight(source: TextureDescriptor): int =
        if (this.height == -1 && this.sourceMipLevel >= 0 &&
            this.sourceMipLevel < source.mipLevels)
            textureMipDimension(
                source.size.height,
                this.sourceMipLevel
            ) - this.sourceY
        else this.height

    fun validation(
        source: TextureDescriptor,
        destination: TextureDescriptor
    ): GraphicsDescriptorValidation {
        var result = graphicsDescriptorValid()
        if (!source.valid() || !destination.valid()) {
            result = graphicsDescriptorInvalid(
                "texture",
                "texture copy requires valid source and destination textures"
            )
        } else if ((source.usage & textureUsageCopySource) == 0) {
            result = graphicsDescriptorInvalid(
                "sourceUsage",
                "texture copy source usage is missing"
            )
        } else if ((destination.usage & textureUsageCopyDestination) == 0) {
            result = graphicsDescriptorInvalid(
                "destinationUsage",
                "texture copy destination usage is missing"
            )
        } else if (source.dimension != textureDimension2D ||
            destination.dimension != textureDimension2D ||
            source.samples != 1 || destination.samples != 1) {
            result = graphicsDescriptorInvalid(
                "dimension",
                "portable texture copies require single-sample 2D textures"
            )
        } else if (source.format != destination.format) {
            result = graphicsDescriptorInvalid(
                "format",
                "texture copy formats must match"
            )
        } else if (textureFormatHasDepth(source.format)) {
            result = graphicsDescriptorInvalid(
                "format",
                "portable texture copies currently support color formats"
            )
        } else if (this.sourceMipLevel < 0 ||
            this.sourceMipLevel >= source.mipLevels) {
            result = graphicsDescriptorInvalid(
                "sourceMipLevel",
                "texture copy source mip level is out of range"
            )
        } else if (this.destinationMipLevel < 0 ||
            this.destinationMipLevel >= destination.mipLevels) {
            result = graphicsDescriptorInvalid(
                "destinationMipLevel",
                "texture copy destination mip level is out of range"
            )
        } else {
            val sourceWidth = textureMipDimension(
                source.size.width,
                this.sourceMipLevel
            )
            val sourceHeight = textureMipDimension(
                source.size.height,
                this.sourceMipLevel
            )
            val destinationWidth = textureMipDimension(
                destination.size.width,
                this.destinationMipLevel
            )
            val destinationHeight = textureMipDimension(
                destination.size.height,
                this.destinationMipLevel
            )
            val copyWidth = this.resolvedWidth(source)
            val copyHeight = this.resolvedHeight(source)
            if (this.sourceX < 0 || this.sourceY < 0 ||
                this.sourceX >= sourceWidth ||
                this.sourceY >= sourceHeight || copyWidth <= 0 ||
                copyHeight <= 0 ||
                copyWidth > sourceWidth - this.sourceX ||
                copyHeight > sourceHeight - this.sourceY) {
                result = graphicsDescriptorInvalid(
                    "sourceOrigin",
                    "texture copy region exceeds the source mip level"
                )
            } else if (this.destinationX < 0 || this.destinationY < 0 ||
                this.destinationX >= destinationWidth ||
                this.destinationY >= destinationHeight ||
                copyWidth > destinationWidth - this.destinationX ||
                copyHeight > destinationHeight - this.destinationY) {
                result = graphicsDescriptorInvalid(
                    "destinationOrigin",
                    "texture copy region exceeds the destination mip level"
                )
            }
        }
        result
    }

    fun valid(
        source: TextureDescriptor,
        destination: TextureDescriptor
    ): bool {
        var succeeded = source.valid() && destination.valid() &&
            (source.usage & textureUsageCopySource) != 0 &&
            (destination.usage & textureUsageCopyDestination) != 0 &&
            source.dimension == textureDimension2D &&
            destination.dimension == textureDimension2D &&
            source.samples == 1 && destination.samples == 1 &&
            source.format == destination.format &&
            !textureFormatHasDepth(source.format) &&
            this.sourceMipLevel >= 0 &&
            this.sourceMipLevel < source.mipLevels &&
            this.destinationMipLevel >= 0 &&
            this.destinationMipLevel < destination.mipLevels
        if (succeeded) {
            val sourceWidth = textureMipDimension(
                source.size.width,
                this.sourceMipLevel
            )
            val sourceHeight = textureMipDimension(
                source.size.height,
                this.sourceMipLevel
            )
            val destinationWidth = textureMipDimension(
                destination.size.width,
                this.destinationMipLevel
            )
            val destinationHeight = textureMipDimension(
                destination.size.height,
                this.destinationMipLevel
            )
            val copyWidth = this.resolvedWidth(source)
            val copyHeight = this.resolvedHeight(source)
            succeeded = this.sourceX >= 0 && this.sourceY >= 0 &&
                this.sourceX < sourceWidth && this.sourceY < sourceHeight &&
                this.destinationX >= 0 && this.destinationY >= 0 &&
                this.destinationX < destinationWidth &&
                this.destinationY < destinationHeight &&
                copyWidth > 0 && copyHeight > 0 &&
                copyWidth <= sourceWidth - this.sourceX &&
                copyHeight <= sourceHeight - this.sourceY &&
                copyWidth <= destinationWidth - this.destinationX &&
                copyHeight <= destinationHeight - this.destinationY
        }
        succeeded
    }
}

class BufferDescriptor(
    val label: string = "",
    val size: int = 0,
    val usage: int = 0,
    val mappedAtCreation: bool = false,
    val persistentMapping: bool = false
) {
    fun validation(): GraphicsDescriptorValidation {
        var result = graphicsDescriptorValid()
        if (this.size <= 0) result = graphicsDescriptorInvalid(
            "size",
            "buffer size must be positive"
        )
        else if (!graphicsUsageValid(this.usage, bufferUsageAll)) {
            result = graphicsDescriptorInvalid(
                "usage",
                "buffer usage is empty or contains unknown flags"
            )
        } else if (this.persistentMapping && !this.mappedAtCreation) {
            result = graphicsDescriptorInvalid(
                "persistentMapping",
                "persistent mapping requires mapped-at-creation"
            )
        } else if (this.mappedAtCreation &&
            (this.usage & (bufferUsageMapRead | bufferUsageMapWrite)) == 0) {
            result = graphicsDescriptorInvalid(
                "mappedAtCreation",
                "mapped-at-creation buffers require map-read or map-write usage"
            )
        } else if (this.persistentMapping &&
            (((this.usage & bufferUsageMapWrite) != 0 &&
              (this.usage & bufferUsageCopySource) == 0) ||
             ((this.usage & bufferUsageMapRead) != 0 &&
              (this.usage & bufferUsageCopyDestination) == 0))) {
            result = graphicsDescriptorInvalid(
                "usage",
                "persistent mappings require the matching GPU copy direction"
            )
        } else if ((this.usage & bufferUsageMapRead) != 0 &&
            (this.usage & ~(bufferUsageMapRead | bufferUsageCopyDestination)) != 0) {
            result = graphicsDescriptorInvalid(
                "usage",
                "map-read buffers may only add copy-destination usage"
            )
        } else if ((this.usage & bufferUsageMapWrite) != 0 &&
            (this.usage & ~(bufferUsageMapWrite | bufferUsageCopySource)) != 0) {
            result = graphicsDescriptorInvalid(
                "usage",
                "map-write buffers may only add copy-source usage"
            )
        }
        result
    }

    fun valid(): bool = this.size > 0 &&
        graphicsUsageValid(this.usage, bufferUsageAll) &&
        (!this.persistentMapping || this.mappedAtCreation) &&
        (!this.mappedAtCreation ||
         (this.usage & (bufferUsageMapRead | bufferUsageMapWrite)) != 0) &&
        (!this.persistentMapping ||
         ((this.usage & bufferUsageMapWrite) == 0 ||
          (this.usage & bufferUsageCopySource) != 0)) &&
        (!this.persistentMapping ||
         ((this.usage & bufferUsageMapRead) == 0 ||
          (this.usage & bufferUsageCopyDestination) != 0)) &&
        ((this.usage & bufferUsageMapRead) == 0 ||
         (this.usage & ~(bufferUsageMapRead |
            bufferUsageCopyDestination)) == 0) &&
        ((this.usage & bufferUsageMapWrite) == 0 ||
         (this.usage & ~(bufferUsageMapWrite | bufferUsageCopySource)) == 0)
}

fun bufferCopyResolvedSize(
    sourceOffset: int,
    size: int,
    sourceSize: int
): int = if (size == -1 && sourceOffset >= 0 && sourceOffset <= sourceSize)
    sourceSize - sourceOffset
else size

fun bufferCopyRangeValid(
    sourceOffset: int,
    destinationOffset: int,
    size: int,
    sourceSize: int,
    destinationSize: int
): bool {
    val byteCount = bufferCopyResolvedSize(sourceOffset, size, sourceSize)
    sourceSize > 0 && destinationSize > 0 && sourceOffset >= 0 &&
        sourceOffset < sourceSize && destinationOffset >= 0 &&
        destinationOffset < destinationSize && byteCount > 0 &&
        byteCount <= sourceSize - sourceOffset &&
        byteCount <= destinationSize - destinationOffset
}

class BufferCopyDescriptor(
    val sourceOffset: int = 0,
    val destinationOffset: int = 0,
    val size: int = -1
) {
    fun resolvedSize(sourceSize: int): int = bufferCopyResolvedSize(
        this.sourceOffset,
        this.size,
        sourceSize
    )

    fun valid(sourceSize: int, destinationSize: int): bool =
        bufferCopyRangeValid(
            this.sourceOffset,
            this.destinationOffset,
            this.size,
            sourceSize,
            destinationSize
        )

    fun validation(
        sourceSize: int,
        destinationSize: int
    ): GraphicsDescriptorValidation {
        var result = graphicsDescriptorValid()
        val byteCount = this.resolvedSize(sourceSize)
        if (sourceSize <= 0 || destinationSize <= 0) {
            result = graphicsDescriptorInvalid(
                "buffer",
                "buffer copy requires valid non-empty storage"
            )
        } else if (this.sourceOffset < 0 ||
            this.sourceOffset >= sourceSize) {
            result = graphicsDescriptorInvalid(
                "sourceOffset",
                "buffer copy source offset is out of range"
            )
        } else if (this.destinationOffset < 0 ||
            this.destinationOffset >= destinationSize) {
            result = graphicsDescriptorInvalid(
                "destinationOffset",
                "buffer copy destination offset is out of range"
            )
        } else if (byteCount <= 0) {
            result = graphicsDescriptorInvalid(
                "size",
                "buffer copy size must be positive"
            )
        } else if (byteCount > sourceSize - this.sourceOffset) {
            result = graphicsDescriptorInvalid(
                "sourceOffset",
                "buffer copy exceeds the source range"
            )
        } else if (byteCount > destinationSize - this.destinationOffset) {
            result = graphicsDescriptorInvalid(
                "destinationOffset",
                "buffer copy exceeds the destination range"
            )
        }
        result
    }
}

fun bufferMapResolvedSize(offset: int, size: int, bufferSize: int): int =
    if (size == -1 && offset >= 0 && offset <= bufferSize)
        bufferSize - offset
    else size

fun bufferMapRangeValid(
    offset: int,
    size: int,
    bufferSize: int
): bool {
    val byteCount = bufferMapResolvedSize(offset, size, bufferSize)
    bufferSize > 0 && offset >= 0 && offset < bufferSize &&
        byteCount > 0 && byteCount <= bufferSize - offset
}

class BufferMapDescriptor(
    val offset: int = 0,
    val size: int = -1
) {
    fun resolvedSize(bufferSize: int): int = bufferMapResolvedSize(
        this.offset,
        this.size,
        bufferSize
    )

    fun valid(bufferSize: int): bool = bufferMapRangeValid(
        this.offset,
        this.size,
        bufferSize
    )
}

class BufferFillDescriptor(
    val value: int = 0,
    val offset: int = 0,
    val size: int = -1
) {
    fun resolvedSize(bufferSize: int): int =
        if (this.size == -1 && this.offset >= 0 && this.offset <= bufferSize)
            bufferSize - this.offset
        else this.size

    fun valid(bufferSize: int): bool {
        val byteCount = this.resolvedSize(bufferSize)
        bufferSize > 0 && this.value >= 0 && this.value <= 4294967295 &&
            this.offset >= 0 && this.offset < bufferSize &&
            this.offset - this.offset / 4 * 4 == 0 && byteCount > 0 &&
            byteCount - byteCount / 4 * 4 == 0 &&
            byteCount <= bufferSize - this.offset
    }

    fun validation(bufferSize: int): GraphicsDescriptorValidation {
        var result = graphicsDescriptorValid()
        val byteCount = this.resolvedSize(bufferSize)
        if (bufferSize <= 0) result = graphicsDescriptorInvalid(
            "buffer",
            "buffer fill requires valid non-empty storage"
        ) else if (this.value < 0 || this.value > 4294967295) {
            result = graphicsDescriptorInvalid(
                "value",
                "buffer fill value must fit an unsigned 32-bit pattern"
            )
        } else if (this.offset < 0 || this.offset >= bufferSize) {
            result = graphicsDescriptorInvalid(
                "offset",
                "buffer fill offset is out of range"
            )
        } else if (this.offset - this.offset / 4 * 4 != 0) {
            result = graphicsDescriptorInvalid(
                "offset",
                "buffer fill offset must be aligned to four bytes"
            )
        } else if (byteCount <= 0) {
            result = graphicsDescriptorInvalid(
                "size",
                "buffer fill size must be positive"
            )
        } else if (byteCount - byteCount / 4 * 4 != 0) {
            result = graphicsDescriptorInvalid(
                "size",
                "buffer fill size must be aligned to four bytes"
            )
        } else if (byteCount > bufferSize - this.offset) {
            result = graphicsDescriptorInvalid(
                "size",
                "buffer fill exceeds the destination range"
            )
        }
        result
    }
}

fun bufferUsageAllowsCpuWrite(usage: int): bool =
    (usage & (bufferUsageMapWrite | bufferUsageCopyDestination)) != 0

fun bufferUsageAllowsCpuRead(usage: int): bool =
    (usage & (bufferUsageMapRead | bufferUsageCopySource)) != 0

fun bufferUsageAllowsGpuCopySource(usage: int): bool =
    (usage & bufferUsageCopySource) != 0

fun bufferUsageAllowsGpuCopyDestination(usage: int): bool =
    (usage & bufferUsageCopyDestination) != 0

class TextureDescriptor(
    val label: string = "",
    val size: Extent3D = Extent3D(0, 0, 0),
    val mipLevels: int = 1,
    val samples: int = 1,
    val dimension: int = textureDimension2D,
    val format: int = textureFormatRgba8Unorm,
    val usage: int = 0
) {
    fun validation(): GraphicsDescriptorValidation {
        var result = graphicsDescriptorValid()
        if (!this.size.valid()) result = graphicsDescriptorInvalid(
            "size",
            "texture extent must be positive"
        ) else if (this.size.width > 4294967295 ||
            this.size.height > 4294967295 ||
            this.size.depth > 4294967295 ||
            !this.size.volumeChecked().succeeded) {
            result = graphicsDescriptorInvalid(
                "size",
                "texture extent exceeds the common backend ABI range"
            )
        } else if (this.dimension < textureDimension1D ||
            this.dimension > textureDimension3D) {
            result = graphicsDescriptorInvalid(
                "dimension",
                "texture dimension is unknown"
            )
        } else if (this.dimension == textureDimension1D &&
            (this.size.height != 1 || this.size.depth != 1)) {
            result = graphicsDescriptorInvalid(
                "size",
                "one-dimensional textures require height and depth of one"
            )
        } else if (this.dimension == textureDimension2D && this.size.depth != 1) {
            result = graphicsDescriptorInvalid(
                "size",
                "two-dimensional textures require depth of one"
            )
        } else if (this.mipLevels < 1 ||
            this.mipLevels > textureMaximumMipLevels(this.size)) {
            result = graphicsDescriptorInvalid(
                "mipLevels",
                "texture mip-level count exceeds its extent"
            )
        } else if (this.samples != 1 && this.samples != 2 &&
            this.samples != 4 && this.samples != 8 && this.samples != 16) {
            result = graphicsDescriptorInvalid(
                "samples",
                "texture sample count is unsupported"
            )
        } else if (this.samples > 1 &&
            (this.dimension != textureDimension2D || this.mipLevels != 1)) {
            result = graphicsDescriptorInvalid(
                "samples",
                "multisampled textures must be two-dimensional with one mip level"
            )
        } else if (!textureFormatValid(this.format)) {
            result = graphicsDescriptorInvalid(
                "format",
                "texture format is unknown"
            )
        } else if (!graphicsUsageValid(this.usage, textureUsageAll)) {
            result = graphicsDescriptorInvalid(
                "usage",
                "texture usage is empty or contains unknown flags"
            )
        }
        result
    }

    fun valid(): bool {
        var succeeded = this.size.valid() &&
            this.size.width <= 4294967295 &&
            this.size.height <= 4294967295 &&
            this.size.depth <= 4294967295 &&
            graphicsSizeProductFits(this.size.width, this.size.height)
        if (succeeded) {
            succeeded = graphicsSizeProductFits(
                this.size.width * this.size.height,
                this.size.depth
            )
        }
        succeeded = succeeded &&
            this.dimension >= textureDimension1D &&
            this.dimension <= textureDimension3D &&
            (this.dimension != textureDimension1D ||
             (this.size.height == 1 && this.size.depth == 1)) &&
            (this.dimension != textureDimension2D || this.size.depth == 1) &&
            this.mipLevels >= 1 &&
            this.mipLevels <= textureMaximumMipLevels(this.size) &&
            (this.samples == 1 || this.samples == 2 || this.samples == 4 ||
             this.samples == 8 || this.samples == 16) &&
            (this.samples == 1 ||
             (this.dimension == textureDimension2D && this.mipLevels == 1)) &&
            textureFormatValid(this.format) &&
            graphicsUsageValid(this.usage, textureUsageAll)
        succeeded
    }
}

class TextureViewDescriptor(
    val label: string = "",
    val format: int = textureFormatUndefined,
    val dimension: int = textureDimension2D,
    val aspect: int = textureAspectAll,
    val baseMipLevel: int = 0,
    val mipLevelCount: int = 0,
    val baseArrayLayer: int = 0,
    val arrayLayerCount: int = 0
) {
    fun resolvedFormat(texture: TextureDescriptor): int =
        if (this.format == textureFormatUndefined) texture.format
        else this.format

    fun resolvedMipLevelCount(texture: TextureDescriptor): int =
        if (this.mipLevelCount == 0)
            texture.mipLevels - this.baseMipLevel
        else this.mipLevelCount

    fun resolvedArrayLayerCount(texture: TextureDescriptor): int =
        if (this.arrayLayerCount == 0)
            texture.size.depth - this.baseArrayLayer
        else this.arrayLayerCount

    fun validation(texture: TextureDescriptor): GraphicsDescriptorValidation {
        var result = texture.validation()
        val selectedFormat = this.resolvedFormat(texture)
        val selectedMipLevels = this.resolvedMipLevelCount(texture)
        val selectedArrayLayers = this.resolvedArrayLayerCount(texture)
        if (result.succeeded && !textureFormatValid(selectedFormat)) {
            result = graphicsDescriptorInvalid("format", "view format is unknown")
        } else if (result.succeeded &&
            !textureFormatsViewCompatible(texture.format, selectedFormat)) {
            result = graphicsDescriptorInvalid(
                "format",
                "view format is incompatible with the texture format"
            )
        } else if (result.succeeded &&
            (this.dimension < textureDimension1D ||
             this.dimension > textureDimension3D)) {
            result = graphicsDescriptorInvalid(
                "dimension",
                "view dimension is unknown"
            )
        } else if (result.succeeded &&
            (this.baseMipLevel < 0 ||
             this.baseMipLevel >= texture.mipLevels ||
             this.mipLevelCount < 0 ||
             selectedMipLevels < 1 ||
             selectedMipLevels > texture.mipLevels - this.baseMipLevel)) {
            result = graphicsDescriptorInvalid(
                "mipLevelCount",
                "view mip-level range is outside the texture"
            )
        } else if (result.succeeded &&
            (this.baseArrayLayer < 0 ||
             this.baseArrayLayer >= texture.size.depth ||
             this.arrayLayerCount < 0 ||
             selectedArrayLayers < 1 ||
             selectedArrayLayers > texture.size.depth - this.baseArrayLayer)) {
            result = graphicsDescriptorInvalid(
                "arrayLayerCount",
                "view array-layer range is outside the texture"
            )
        } else if (result.succeeded &&
            (this.aspect < textureAspectAll || this.aspect > textureAspectStencil)) {
            result = graphicsDescriptorInvalid("aspect", "view aspect is unknown")
        } else if (result.succeeded && this.aspect == textureAspectColor &&
            textureFormatHasDepth(selectedFormat)) {
            result = graphicsDescriptorInvalid(
                "aspect",
                "color aspect cannot select a depth format"
            )
        } else if (result.succeeded && this.aspect == textureAspectDepth &&
            !textureFormatHasDepth(selectedFormat)) {
            result = graphicsDescriptorInvalid(
                "aspect",
                "depth aspect requires a depth format"
            )
        } else if (result.succeeded && this.aspect == textureAspectStencil &&
            !textureFormatHasStencil(selectedFormat)) {
            result = graphicsDescriptorInvalid(
                "aspect",
                "stencil aspect requires a stencil format"
            )
        }
        result
    }
}

class SamplerDescriptor(
    val label: string = "",
    val addressU: int = samplerAddressClampToEdge,
    val addressV: int = samplerAddressClampToEdge,
    val addressW: int = samplerAddressClampToEdge,
    val magFilter: int = samplerFilterNearest,
    val minFilter: int = samplerFilterNearest,
    val mipmapFilter: int = samplerFilterNearest,
    val lodMinimum: int = 0,
    val lodMaximum: int = 32,
    val compare: int = compareFunctionUndefined,
    val maximumAnisotropy: int = 1
) {
    fun validation(): GraphicsDescriptorValidation {
        var result = graphicsDescriptorValid()
        if (this.addressU < samplerAddressClampToEdge ||
            this.addressU > samplerAddressMirrorRepeat ||
            this.addressV < samplerAddressClampToEdge ||
            this.addressV > samplerAddressMirrorRepeat ||
            this.addressW < samplerAddressClampToEdge ||
            this.addressW > samplerAddressMirrorRepeat) {
            result = graphicsDescriptorInvalid(
                "addressMode",
                "sampler address mode is unknown"
            )
        } else if (this.magFilter < samplerFilterNearest ||
            this.magFilter > samplerFilterLinear ||
            this.minFilter < samplerFilterNearest ||
            this.minFilter > samplerFilterLinear ||
            this.mipmapFilter < samplerFilterNearest ||
            this.mipmapFilter > samplerFilterLinear) {
            result = graphicsDescriptorInvalid(
                "filter",
                "sampler filter is unknown"
            )
        } else if (this.lodMinimum < 0 || this.lodMaximum < this.lodMinimum) {
            result = graphicsDescriptorInvalid(
                "lodMaximum",
                "sampler LOD range is invalid"
            )
        } else if (this.compare < compareFunctionUndefined ||
            this.compare > compareFunctionAlways) {
            result = graphicsDescriptorInvalid(
                "compare",
                "sampler comparison function is unknown"
            )
        } else if (this.maximumAnisotropy < 1 ||
            this.maximumAnisotropy > 16) {
            result = graphicsDescriptorInvalid(
                "maximumAnisotropy",
                "sampler anisotropy is outside 1 through 16"
            )
        }
        result
    }

    fun valid(): bool = this.validation().succeeded
}
