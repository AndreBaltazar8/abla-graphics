// Generation-checked device-buffer-pool offscreen draw helpers.

import "core.ab"
import "pool.ab"
import "render.ab"
import "push_constants.ab"

trusted fun GraphicsApplication.renderBufferPoolVerticesToTarget(
    var target: GraphicsRenderTarget,
    pipeline: GraphicsRenderPipeline,
    pool: GraphicsBufferPool,
    vertices: int,
    vertexCount: int,
    clear: Color,
    instanceCount: int = 1
): bool = pool.allocationValid(vertices) && this.renderVerticesToTarget(
    target,
    pipeline,
    pool.backing,
    vertexCount,
    clear,
    instanceCount,
    pool.allocationOffset(vertices),
    pool.allocationSize(vertices)
)

trusted fun GraphicsApplication.renderBufferPoolIndexedToTarget(
    var target: GraphicsRenderTarget,
    pipeline: GraphicsRenderPipeline,
    pool: GraphicsBufferPool,
    vertices: int,
    indices: int,
    indexCount: int,
    clear: Color,
    instanceCount: int = 1
): bool = pool.allocationValid(vertices) &&
    pool.allocationValid(indices) && this.renderIndexedToTarget(
        target,
        pipeline,
        pool.backing,
        pool.backing,
        indexCount,
        clear,
        instanceCount,
        pool.allocationOffset(vertices),
        pool.allocationSize(vertices),
        pool.allocationOffset(indices),
        pool.allocationSize(indices)
    )

