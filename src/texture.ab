// Affine backend-neutral texture and texture-view ownership.

import "abla/unsafe/memory"
import "core.ab"
import "resources.ab"
import "pixels.ab"
import "application.ab"
import "driver/opengl.ab"
import "driver/vulkan.ab"

resource class GraphicsTexture(
    val openGl: OpenGlTexture,
    val vulkan: VulkanTexture,
    val descriptor: TextureDescriptor,
    val backend: int,
    val error: GraphicsError
) {
    fun valid(): bool = !this.error.occurred() && this.descriptor.valid() &&
        ((this.backend == graphicsBackendOpenGl && this.openGl.valid()) ||
         (this.backend == graphicsBackendVulkan && this.vulkan.valid()))

    trusted fun writePixels(
        pixels: PixelBuffer,
        write: TextureWriteDescriptor = TextureWriteDescriptor()
    ): bool {
        val validation = write.validation(
            this.descriptor,
            pixels.width,
            pixels.height
        )
        if (!this.valid() || !pixels.valid() || !validation.succeeded) false
        else if (this.backend == graphicsBackendOpenGl) {
            this.openGl.writePixels(this.descriptor, pixels, write)
        } else if (this.backend == graphicsBackendVulkan) {
            this.vulkan.writePixels(this.descriptor, pixels, write)
        } else false
    }

    trusted fun rgba8(
        x: int,
        y: int,
        mipLevel: int = 0
    ): int {
        if (!this.valid()) -1
        else if (this.backend == graphicsBackendOpenGl) {
            this.openGl.rgba8(this.descriptor, x, y, mipLevel)
        } else if (this.backend == graphicsBackendVulkan) {
            this.vulkan.rgba8(this.descriptor, x, y, mipLevel)
        } else -1
    }

    fun sameResource(other: GraphicsTexture): bool =
        this.backend == other.backend &&
        ((this.backend == graphicsBackendOpenGl &&
          this.openGl.handle != 0 &&
          this.openGl.context == other.openGl.context &&
          this.openGl.handle == other.openGl.handle) ||
         (this.backend == graphicsBackendVulkan &&
          this.vulkan.image != 0 &&
          this.vulkan.device == other.vulkan.device &&
          this.vulkan.image == other.vulkan.image))

    trusted fun drop(): void {
        this.openGl.drop()
        this.vulkan.drop()
        return
    }
}

fun GraphicsApplication.ownsTexture(texture: GraphicsTexture): bool =
    this.backend == texture.backend &&
    ((this.backend == graphicsBackendOpenGl &&
      this.openGl.display == texture.openGl.display &&
      this.openGl.context == texture.openGl.context) ||
     (this.backend == graphicsBackendVulkan &&
      this.vulkanDevice.handle == texture.vulkan.device))

trusted fun GraphicsApplication.copyTexture(
    source: GraphicsTexture,
    destination: GraphicsTexture,
    copy: TextureCopyDescriptor
): bool {
    var succeeded = this.valid() && source.valid() && destination.valid() &&
        this.ownsTexture(source) && this.ownsTexture(destination) &&
        !source.sameResource(destination) &&
        copy.valid(source.descriptor, destination.descriptor)
    if (succeeded && this.backend == graphicsBackendOpenGl) {
        succeeded = source.openGl.copyTo(
            source.descriptor,
            destination.openGl,
            destination.descriptor,
            copy
        )
    } else if (succeeded && this.backend == graphicsBackendVulkan) {
        succeeded = this.vulkanDevice.copyTexture(
            source.vulkan,
            source.descriptor,
            destination.vulkan,
            destination.descriptor,
            copy
        )
    } else if (succeeded) succeeded = false
    succeeded
}

resource class GraphicsTextureView(
    val openGl: OpenGlTextureView,
    val vulkan: VulkanTextureView,
    val descriptor: TextureViewDescriptor,
    val backend: int,
    val error: GraphicsError
) {
    fun valid(): bool = !this.error.occurred() &&
        ((this.backend == graphicsBackendOpenGl && this.openGl.valid()) ||
         (this.backend == graphicsBackendVulkan && this.vulkan.valid()))

    trusted fun drop(): void {
        this.openGl.drop()
        this.vulkan.drop()
        return
    }
}

trusted fun GraphicsApplication.texture(
    descriptor: TextureDescriptor
): GraphicsTexture {
    var openGl = OpenGlTexture(
        0,
        nativeNullPointer(),
        nativeNullPointer(),
        nativeNullPointer()
    )
    var vulkan = VulkanTexture(
        nativeNullPointer(),
        nativeNullPointer(),
        nativeNullPointer(),
        -1,
        0,
        0,
        VulkanBuffer(
            nativeNullPointer(),
            nativeNullPointer(),
            nativeNullPointer(),
            -1,
            0,
            0,
            0,
            nativePointerCell(nativeNullPointer())
        ),
        0,
        nativeNullPointer(),
        nativeByteBuffer(0)
    )
    var error = GraphicsError()
    val validation = descriptor.validation()
    if (!this.valid()) {
        error = GraphicsError(
            graphicsErrorInvalidConfiguration,
            "GraphicsApplication.texture",
            "the graphics application is invalid"
        )
    } else if (!validation.succeeded) {
        error = GraphicsError(
            graphicsErrorInvalidConfiguration,
            "GraphicsApplication.texture.${validation.field}",
            validation.message
        )
    } else if (descriptor.dimension != textureDimension2D ||
        descriptor.samples != 1) {
        error = GraphicsError(
            graphicsErrorUnsupportedFeature,
            "GraphicsApplication.texture",
            "the portable texture slice currently supports single-sample 2D textures"
        )
    } else if (((descriptor.usage & textureUsageSampled) != 0 &&
            !this.capabilities.supports(graphicsFeatureSampledTextures)) ||
        (textureFormatHasDepth(descriptor.format) &&
            !this.capabilities.supports(graphicsFeatureDepthTextures))) {
        error = GraphicsError(
            graphicsErrorUnsupportedFeature,
            "GraphicsApplication.texture",
            "the requested texture feature is unavailable on the selected device"
        )
    } else if (descriptor.size.width >
            this.capabilities.limits.maximumTextureDimension2D ||
        descriptor.size.height >
            this.capabilities.limits.maximumTextureDimension2D) {
        error = GraphicsError(
            graphicsErrorLimitExceeded,
            "GraphicsApplication.texture.size",
            "2D texture extent exceeds the selected device limit"
        )
    } else if (this.backend == graphicsBackendOpenGl) {
        openGl = this.openGl.texture(descriptor)
        if (!openGl.valid()) {
            error = GraphicsError(
                graphicsErrorDriverFailure,
                "OpenGlWindowContext.texture",
                "OpenGL texture creation failed"
            )
        }
    } else if (this.backend == graphicsBackendVulkan) {
        vulkan = this.vulkanDevice.texture(descriptor)
        if (!vulkan.valid()) {
            error = GraphicsError(
                graphicsErrorDriverFailure,
                "VulkanDevice.texture",
                "Vulkan image creation or memory binding failed"
            )
        }
    } else {
        error = GraphicsError(
            graphicsErrorBackendUnavailable,
            "GraphicsApplication.texture",
            "the selected backend cannot create textures"
        )
    }
    GraphicsTexture(
        move(openGl),
        move(vulkan),
        descriptor,
        this.backend,
        error
    )
}

trusted fun GraphicsTexture.view(
    descriptor: TextureViewDescriptor = TextureViewDescriptor()
): GraphicsTextureView {
    var openGl = OpenGlTextureView(0)
    var vulkan = VulkanTextureView(nativeNullPointer(), 0)
    var error = GraphicsError()
    val validation = descriptor.validation(this.descriptor)
    if (!this.valid()) {
        error = GraphicsError(
            graphicsErrorInvalidConfiguration,
            "GraphicsTexture.view",
            "the parent texture is invalid"
        )
    } else if (!validation.succeeded) {
        error = GraphicsError(
            graphicsErrorInvalidConfiguration,
            "GraphicsTexture.view.${validation.field}",
            validation.message
        )
    } else if (this.backend == graphicsBackendOpenGl) {
        openGl = this.openGl.view(this.descriptor, descriptor)
        if (!openGl.valid()) {
            error = GraphicsError(
                graphicsErrorUnsupportedFeature,
                "OpenGlTexture.view",
                "OpenGL subresource or format-reinterpreted views require texture-view support"
            )
        }
    } else if (this.backend == graphicsBackendVulkan) {
        vulkan = this.vulkan.view(this.descriptor, descriptor)
        if (!vulkan.valid()) {
            error = GraphicsError(
                graphicsErrorDriverFailure,
                "VulkanTexture.view",
                "Vulkan image-view creation failed"
            )
        }
    }
    GraphicsTextureView(
        move(openGl),
        move(vulkan),
        descriptor,
        this.backend,
        error
    )
}
