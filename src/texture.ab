// Affine backend-neutral texture and texture-view ownership.

import "abla/unsafe/memory"
import "core.ab"
import "resources.ab"
import "pixels.ab"
import "bytes.ab"
import "application.ab"
import "driver/opengl.ab"
import "driver/vulkan.ab"

resource class GraphicsTexture(
    val openGl: OpenGlTexture,
    val vulkan: VulkanTexture,
    val descriptor: TextureDescriptor,
    val backend: int,
    val error: GraphicsError
) {
    fun valid(): bool = !this.error.occurred() && this.descriptor.valid() &&
        ((this.backend == graphicsBackendOpenGl && this.openGl.valid()) ||
         (this.backend == graphicsBackendVulkan && this.vulkan.valid()))

    trusted fun writePixels(
        pixels: PixelBuffer,
        write: TextureWriteDescriptor
    ): bool {
        if (!this.valid() || this.descriptor.dimension != textureDimension2D ||
            !pixels.valid() || !write.valid(
            this.descriptor,
            pixels.width,
            pixels.height
        )) false
        else if (this.backend == graphicsBackendOpenGl) {
            this.openGl.writePixels(this.descriptor, pixels, write)
        } else if (this.backend == graphicsBackendVulkan) {
            this.vulkan.writePixels(this.descriptor, pixels, write)
        } else false
    }

    trusted fun rgba8(
        x: int,
        y: int,
        mipLevel: int = 0
    ): int {
        if (!this.valid() ||
            this.descriptor.dimension != textureDimension2D) -1
        else if (this.backend == graphicsBackendOpenGl) {
            this.openGl.rgba8(this.descriptor, x, y, mipLevel)
        } else if (this.backend == graphicsBackendVulkan) {
            this.vulkan.rgba8(this.descriptor, x, y, mipLevel)
        } else -1
    }

    // Portable inspection coordinates for rendered 2D textures. The existing
    // rgba8 method intentionally retains backend-native row order.
    trusted fun rgba8TopLeft(
        x: int,
        y: int,
        mipLevel: int = 0
    ): int {
        val height = if (mipLevel >= 0 &&
            mipLevel < this.descriptor.mipLevels)
            textureMipDimension(this.descriptor.size.height, mipLevel)
        else 0
        val nativeY = if (this.backend == graphicsBackendOpenGl)
            height - y - 1 else y
        if (height > 0) this.rgba8(x, nativeY, mipLevel) else -1
    }

    trusted fun writeBytes(
        source: BufferBytes,
        selection: TextureRegion = TextureRegion(),
        layout: TextureDataLayout = TextureDataLayout()
    ): bool {
        if (!this.valid() || !source.valid() ||
            !selection.valid(
                this.descriptor,
                textureUsageCopyDestination
            ) || !layout.validation(
                this.descriptor,
                selection,
                source.size
            ).succeeded || textureFormatHasDepth(this.descriptor.format)) false
        else if (this.backend == graphicsBackendOpenGl) {
            this.openGl.writeBytes(
                this.descriptor,
                source,
                selection,
                layout
            )
        } else if (this.backend == graphicsBackendVulkan) {
            this.vulkan.writeBytes(
                this.descriptor,
                source,
                selection,
                layout
            )
        } else false
    }

    trusted fun readBytes(
        var destination: BufferBytes,
        selection: TextureRegion = TextureRegion(),
        layout: TextureDataLayout = TextureDataLayout()
    ): bool {
        if (!this.valid() || !destination.valid() ||
            !selection.valid(this.descriptor, textureUsageCopySource) ||
            !layout.validation(
                this.descriptor,
                selection,
                destination.size
            ).succeeded || textureFormatHasDepth(this.descriptor.format)) false
        else if (this.backend == graphicsBackendOpenGl) {
            this.openGl.readBytes(
                this.descriptor,
                destination,
                selection,
                layout
            )
        } else if (this.backend == graphicsBackendVulkan) {
            this.vulkan.readBytes(
                this.descriptor,
                destination,
                selection,
                layout
            )
        } else false
    }

    trusted fun writeBytesRange(
        source: BufferBytes,
        mipLevel: int,
        x: int,
        y: int,
        z: int,
        width: int,
        height: int,
        depth: int,
        offset: int = 0,
        bytesPerRow: int = 0,
        rowsPerImage: int = 0
    ): bool {
        var succeeded = this.valid() && source.valid() &&
            !textureFormatHasDepth(this.descriptor.format) &&
            textureRegionRangeValid(
                this.descriptor,
                mipLevel,
                x,
                y,
                z,
                width,
                height,
                depth,
                textureUsageCopyDestination
            ) && textureDataLayoutRangeValid(
                this.descriptor,
                width,
                height,
                depth,
                offset,
                bytesPerRow,
                rowsPerImage,
                source.size
            )
        if (succeeded && this.backend == graphicsBackendOpenGl) {
            succeeded = this.openGl.writeBytesRange(
                this.descriptor,
                source,
                mipLevel,
                x,
                y,
                z,
                width,
                height,
                depth,
                offset,
                bytesPerRow,
                rowsPerImage
            )
        } else if (succeeded && this.backend == graphicsBackendVulkan) {
            succeeded = this.vulkan.writeBytesRange(
                this.descriptor,
                source,
                mipLevel,
                x,
                y,
                z,
                width,
                height,
                depth,
                offset,
                bytesPerRow,
                rowsPerImage
            )
        } else if (succeeded) succeeded = false
        succeeded
    }

    trusted fun readBytesRange(
        var destination: BufferBytes,
        mipLevel: int,
        x: int,
        y: int,
        z: int,
        width: int,
        height: int,
        depth: int,
        offset: int = 0,
        bytesPerRow: int = 0,
        rowsPerImage: int = 0
    ): bool {
        var succeeded = this.valid() && destination.valid() &&
            !textureFormatHasDepth(this.descriptor.format) &&
            textureRegionRangeValid(
                this.descriptor,
                mipLevel,
                x,
                y,
                z,
                width,
                height,
                depth,
                textureUsageCopySource
            ) && textureDataLayoutRangeValid(
                this.descriptor,
                width,
                height,
                depth,
                offset,
                bytesPerRow,
                rowsPerImage,
                destination.size
            )
        if (succeeded && this.backend == graphicsBackendOpenGl) {
            succeeded = this.openGl.readBytesRange(
                this.descriptor,
                destination,
                mipLevel,
                x,
                y,
                z,
                width,
                height,
                depth,
                offset,
                bytesPerRow,
                rowsPerImage
            )
        } else if (succeeded && this.backend == graphicsBackendVulkan) {
            succeeded = this.vulkan.readBytesRange(
                this.descriptor,
                destination,
                mipLevel,
                x,
                y,
                z,
                width,
                height,
                depth,
                offset,
                bytesPerRow,
                rowsPerImage
            )
        } else if (succeeded) succeeded = false
        succeeded
    }

    trusted fun generateMipmaps(): bool {
        var succeeded = this.valid() &&
            this.descriptor.dimension == textureDimension2D &&
            this.descriptor.samples == 1 && this.descriptor.mipLevels > 1 &&
            textureFormatAcceptsRgba8Pixels(this.descriptor.format) &&
            (this.descriptor.usage & textureUsageCopySource) != 0 &&
            (this.descriptor.usage & textureUsageCopyDestination) != 0
        if (succeeded && this.backend == graphicsBackendOpenGl) {
            succeeded = this.openGl.generateMipmaps(this.descriptor)
        } else if (succeeded && this.backend == graphicsBackendVulkan) {
            succeeded = this.vulkan.generateMipmaps(this.descriptor)
        } else if (succeeded) succeeded = false
        succeeded
    }

    fun sameResource(other: GraphicsTexture): bool =
        this.backend == other.backend &&
        ((this.backend == graphicsBackendOpenGl &&
          this.openGl.handle != 0 &&
          this.openGl.context == other.openGl.context &&
          this.openGl.handle == other.openGl.handle) ||
         (this.backend == graphicsBackendVulkan &&
          this.vulkan.image != 0 &&
          this.vulkan.device == other.vulkan.device &&
          this.vulkan.image == other.vulkan.image))

    trusted fun drop(): void {
        this.openGl.drop()
        this.vulkan.drop()
        return
    }
}

fun emptyGraphicsTexture(): GraphicsTexture = GraphicsTexture(
    OpenGlTexture(
        0,
        0,
        nativeNullPointer(),
        nativeNullPointer(),
        nativeNullPointer(),
        nativeByteBuffer(0)
    ),
    VulkanTexture(
        nativeNullPointer(),
        nativeNullPointer(),
        nativeNullPointer(),
        -1,
        0,
        0,
        VulkanBuffer(
            nativeNullPointer(),
            nativeNullPointer(),
            nativeNullPointer(),
            -1,
            0,
            0,
            0,
            0,
            nativePointerCell(nativeNullPointer()),
            0,
            0,
            0,
            false
        ),
        0,
        nativePointerCell(nativeNullPointer()),
        nativeByteBuffer(0),
        nativeByteBuffer(0)
    ),
    TextureDescriptor(),
    graphicsBackendAuto,
    GraphicsError()
)

fun GraphicsApplication.ownsTexture(texture: GraphicsTexture): bool =
    this.backend == texture.backend &&
    ((this.backend == graphicsBackendOpenGl &&
      this.openGl.display == texture.openGl.display &&
      this.openGl.context == texture.openGl.context) ||
     (this.backend == graphicsBackendVulkan &&
      this.vulkanDevice.handle == texture.vulkan.device))

trusted fun GraphicsApplication.copyTexture(
    source: GraphicsTexture,
    destination: GraphicsTexture,
    copy: TextureCopyDescriptor
): bool {
    var succeeded = this.valid() && source.valid() && destination.valid() &&
        this.ownsTexture(source) && this.ownsTexture(destination) &&
        !source.sameResource(destination) &&
        copy.valid(source.descriptor, destination.descriptor)
    if (succeeded && this.backend == graphicsBackendOpenGl) {
        succeeded = source.openGl.copyTo(
            source.descriptor,
            destination.openGl,
            destination.descriptor,
            copy
        )
    } else if (succeeded && this.backend == graphicsBackendVulkan) {
        succeeded = this.vulkanDevice.copyTexture(
            source.vulkan,
            source.descriptor,
            destination.vulkan,
            destination.descriptor,
            copy
        )
    } else if (succeeded) succeeded = false
    succeeded
}

trusted fun GraphicsApplication.copyTextureRange(
    source: GraphicsTexture,
    destination: GraphicsTexture,
    sourceMipLevel: int,
    sourceX: int,
    sourceY: int,
    sourceZ: int,
    destinationMipLevel: int,
    destinationX: int,
    destinationY: int,
    destinationZ: int,
    width: int,
    height: int,
    depth: int
): bool {
    var succeeded = this.valid() && source.valid() && destination.valid() &&
        this.ownsTexture(source) && this.ownsTexture(destination) &&
        !source.sameResource(destination) && textureCopyRangeValid(
            source.descriptor,
            destination.descriptor,
            sourceMipLevel,
            sourceX,
            sourceY,
            sourceZ,
            destinationMipLevel,
            destinationX,
            destinationY,
            destinationZ,
            width,
            height,
            depth
        )
    if (succeeded && this.backend == graphicsBackendOpenGl) {
        succeeded = source.openGl.copyRangeTo(
            source.descriptor,
            destination.openGl,
            destination.descriptor,
            sourceMipLevel,
            sourceX,
            sourceY,
            sourceZ,
            destinationMipLevel,
            destinationX,
            destinationY,
            destinationZ,
            width,
            height,
            depth
        )
    } else if (succeeded && this.backend == graphicsBackendVulkan) {
        succeeded = this.vulkanDevice.copyTextureRange(
            source.vulkan,
            source.descriptor,
            destination.vulkan,
            destination.descriptor,
            sourceMipLevel,
            sourceX,
            sourceY,
            sourceZ,
            destinationMipLevel,
            destinationX,
            destinationY,
            destinationZ,
            width,
            height,
            depth
        )
    } else if (succeeded) succeeded = false
    succeeded
}

resource class GraphicsTextureView(
    val openGl: OpenGlTextureView,
    val vulkan: VulkanTextureView,
    val descriptor: TextureViewDescriptor,
    val texture: TextureDescriptor,
    val backend: int,
    val error: GraphicsError
) {
    fun valid(): bool = !this.error.occurred() &&
        ((this.backend == graphicsBackendOpenGl && this.openGl.valid()) ||
         (this.backend == graphicsBackendVulkan && this.vulkan.valid()))

    trusted fun drop(): void {
        this.openGl.drop()
        this.vulkan.drop()
        return
    }
}

fun GraphicsApplication.ownsTextureView(view: GraphicsTextureView): bool =
    this.backend == view.backend &&
    ((this.backend == graphicsBackendOpenGl &&
      this.openGl.display == view.openGl.display &&
      this.openGl.context == view.openGl.context) ||
     (this.backend == graphicsBackendVulkan &&
      this.vulkanDevice.handle == view.vulkan.device))

trusted fun GraphicsApplication.texture(
    descriptor: TextureDescriptor
): GraphicsTexture {
    var openGl = OpenGlTexture(
        0,
        0,
        nativeNullPointer(),
        nativeNullPointer(),
        nativeNullPointer(),
        nativeByteBuffer(0)
    )
    var vulkan = VulkanTexture(
        nativeNullPointer(),
        nativeNullPointer(),
        nativeNullPointer(),
        -1,
        0,
        0,
        VulkanBuffer(
            nativeNullPointer(),
            nativeNullPointer(),
            nativeNullPointer(),
            -1,
            0,
            0,
            0,
            0,
            nativePointerCell(nativeNullPointer()),
            0,
            0,
            0,
            false
        ),
        0,
        nativePointerCell(nativeNullPointer()),
        nativeByteBuffer(0),
        nativeByteBuffer(0)
    )
    var error = GraphicsError()
    val validation = descriptor.validation()
    if (!this.valid()) {
        error = GraphicsError(
            graphicsErrorInvalidConfiguration,
            "GraphicsApplication.texture",
            "the graphics application is invalid"
        )
    } else if (!validation.succeeded) {
        error = GraphicsError(
            graphicsErrorInvalidConfiguration,
            "GraphicsApplication.texture.${validation.field}",
            validation.message
        )
    } else if (descriptor.samples > 1 &&
        descriptor.usage != textureUsageRenderAttachment) {
        error = GraphicsError(
            graphicsErrorUnsupportedFeature,
            "GraphicsApplication.texture",
            "multisampled textures currently require render-attachment-only usage"
        )
    } else if (((descriptor.usage & textureUsageSampled) != 0 &&
            !this.capabilities.supports(graphicsFeatureSampledTextures)) ||
        ((descriptor.usage & textureUsageStorage) != 0 &&
            !this.capabilities.supports(graphicsFeatureStorageTextures)) ||
        (textureFormatHasDepth(descriptor.format) &&
            !this.capabilities.supports(graphicsFeatureDepthTextures))) {
        error = GraphicsError(
            graphicsErrorUnsupportedFeature,
            "GraphicsApplication.texture",
            "the requested texture feature is unavailable on the selected device"
        )
    } else if ((descriptor.dimension == textureDimension1D &&
            descriptor.size.width >
                this.capabilities.limits.maximumTextureDimension1D) ||
        (descriptor.dimension == textureDimension2D &&
            (descriptor.size.width >
                this.capabilities.limits.maximumTextureDimension2D ||
             descriptor.size.height >
                this.capabilities.limits.maximumTextureDimension2D)) ||
        (descriptor.dimension == textureDimension3D &&
            (descriptor.size.width >
                this.capabilities.limits.maximumTextureDimension3D ||
             descriptor.size.height >
                this.capabilities.limits.maximumTextureDimension3D ||
             descriptor.size.depth >
                this.capabilities.limits.maximumTextureDimension3D)) ||
        (descriptor.dimension == textureDimension2DArray &&
            (descriptor.size.width >
                this.capabilities.limits.maximumTextureDimension2D ||
             descriptor.size.height >
                this.capabilities.limits.maximumTextureDimension2D ||
             descriptor.size.depth >
                this.capabilities.limits.maximumTextureArrayLayers)) ||
        (descriptor.dimension == textureDimensionCube &&
            descriptor.size.width >
                this.capabilities.limits.maximumTextureCubeDimension)) {
        error = GraphicsError(
            graphicsErrorLimitExceeded,
            "GraphicsApplication.texture.size",
            "texture extent exceeds the selected device dimension or layer limit"
        )
    } else if (this.backend == graphicsBackendOpenGl) {
        openGl = this.openGl.texture(descriptor)
        if (!openGl.valid()) {
            error = GraphicsError(
                graphicsErrorDriverFailure,
                "OpenGlWindowContext.texture",
                "OpenGL texture creation failed"
            )
        }
    } else if (this.backend == graphicsBackendVulkan) {
        vulkan = this.vulkanDevice.texture(descriptor)
        if (!vulkan.valid()) {
            error = GraphicsError(
                graphicsErrorDriverFailure,
                "VulkanDevice.texture",
                "Vulkan image creation or memory binding failed"
            )
        }
    } else {
        error = GraphicsError(
            graphicsErrorBackendUnavailable,
            "GraphicsApplication.texture",
            "the selected backend cannot create textures"
        )
    }
    GraphicsTexture(
        move(openGl),
        move(vulkan),
        descriptor,
        this.backend,
        error
    )
}

trusted fun GraphicsTexture.view(
    descriptor: TextureViewDescriptor = TextureViewDescriptor()
): GraphicsTextureView {
    var openGl = OpenGlTextureView(0)
    var vulkan = VulkanTextureView(nativeNullPointer(), 0)
    var error = GraphicsError()
    val validation = descriptor.validation(this.descriptor)
    if (!this.valid()) {
        error = GraphicsError(
            graphicsErrorInvalidConfiguration,
            "GraphicsTexture.view",
            "the parent texture is invalid"
        )
    } else if (!validation.succeeded) {
        error = GraphicsError(
            graphicsErrorInvalidConfiguration,
            "GraphicsTexture.view.${validation.field}",
            validation.message
        )
    } else if (this.backend == graphicsBackendOpenGl) {
        openGl = this.openGl.view(this.descriptor, descriptor)
        if (!openGl.valid()) {
            error = GraphicsError(
                graphicsErrorDriverFailure,
                "OpenGlTexture.view",
                "OpenGL texture-view creation failed"
            )
        }
    } else if (this.backend == graphicsBackendVulkan) {
        vulkan = this.vulkan.view(this.descriptor, descriptor)
        if (!vulkan.valid()) {
            error = GraphicsError(
                graphicsErrorDriverFailure,
                "VulkanTexture.view",
                "Vulkan image-view creation failed"
            )
        }
    }
    GraphicsTextureView(
        move(openGl),
        move(vulkan),
        descriptor,
        this.descriptor,
        this.backend,
        error
    )
}
