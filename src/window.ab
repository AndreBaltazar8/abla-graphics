val pointerButtonUnknown = -1
val pointerButtonLeft = 0
val pointerButtonRight = 1
val pointerButtonMiddle = 2
val pointerButtonBack = 3
val pointerButtonForward = 4

class Monitor(
    val name: string = "",
    val width: int = 0,
    val height: int = 0,
    val widthMillimeters: int = 0,
    val heightMillimeters: int = 0
) {
    fun valid(): bool = this.width > 0 && this.height > 0
    fun physicalSizeKnown(): bool =
        this.widthMillimeters > 0 && this.heightMillimeters > 0

    fun dpiX(): f64 = if (this.widthMillimeters > 0)
        f64FromInt(this.width) * 25.4 / f64FromInt(this.widthMillimeters)
    else 96.0

    fun dpiY(): f64 = if (this.heightMillimeters > 0)
        f64FromInt(this.height) * 25.4 / f64FromInt(this.heightMillimeters)
    else 96.0

    fun contentScaleX(): f64 = this.dpiX() / 96.0
    fun contentScaleY(): f64 = this.dpiY() / 96.0
}

class WindowConfig(
    val title: string = "Abla Graphics",
    val width: int = 1280,
    val height: int = 720,
    val resizable: bool = true,
    val visible: bool = true,
    val decorated: bool = true,
    val transparent: bool = false,
    val fullscreen: bool = false
) {
    fun valid(): bool =
        this.title.size <= 4096 &&
        this.width > 0 && this.width <= 65536 &&
        this.height > 0 && this.height <= 65536
}

class WindowEvent(
    val kind: int = windowEventNone,
    val first: int = 0,
    val second: int = 0,
    val text: string = "",
    val platformCode: int = 0
) {
    fun happened(): bool = this.kind != windowEventNone
    fun key(): int = if (this.kind == windowEventKey) this.first else keyUnknown
    fun keyPressed(): bool = this.kind == windowEventKey && this.second != 0
    fun pointerButton(): int = if (this.kind == windowEventPointerButton)
        this.first else pointerButtonUnknown
    fun pointerButtonPressed(): bool =
        this.kind == windowEventPointerButton && this.second != 0
    fun pointerX(): int = if (this.kind == windowEventPointerMoved)
        this.first else 0
    fun pointerY(): int = if (this.kind == windowEventPointerMoved)
        this.second else 0
    fun scrollX(): int = if (this.kind == windowEventScrolled) this.first else 0
    fun scrollY(): int = if (this.kind == windowEventScrolled) this.second else 0
    fun codepoint(): int = if (this.kind == windowEventText) this.first else 0
}
