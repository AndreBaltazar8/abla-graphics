// Platform-neutral window configuration and copied event values.

import "abla/float"

val windowEventNone = 0
val windowEventCloseRequested = 1
val windowEventResized = 2
val windowEventFramebufferResized = 3
val windowEventFocused = 4
val windowEventKey = 5
val windowEventText = 6
val windowEventPointerMoved = 7
val windowEventPointerButton = 8
val windowEventScrolled = 9
val windowEventFileDropped = 10
val windowEventMonitorChanged = 11

