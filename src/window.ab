// Platform-neutral window configuration and copied event values.

val windowEventNone = 0
val windowEventCloseRequested = 1
val windowEventResized = 2
val windowEventFramebufferResized = 3
val windowEventFocused = 4
val windowEventKey = 5
val windowEventText = 6
val windowEventPointerMoved = 7
val windowEventPointerButton = 8
val windowEventScrolled = 9
val windowEventFileDropped = 10
val windowEventMonitorChanged = 11

class WindowConfig(
    val title: string = "Abla Graphics",
    val width: int = 1280,
    val height: int = 720,
    val resizable: bool = true,
    val visible: bool = true,
    val decorated: bool = true,
    val transparent: bool = false,
    val fullscreen: bool = false
) {
    fun valid(): bool =
        this.title.size <= 4096 &&
        this.width > 0 && this.width <= 65536 &&
        this.height > 0 && this.height <= 65536
}

class WindowEvent(
    val kind: int = windowEventNone,
    val first: int = 0,
    val second: int = 0,
    val text: string = ""
) {
    fun happened(): bool = this.kind != windowEventNone
}
