// Bounded reusable command recording for materialized render graphs.

import "core.ab"
import "resources.ab"
import "application.ab"
import "texture.ab"
import "texture_pool.ab"
import "graph.ab"
import "graph_texture.ab"
import "graph_execute.ab"
import "render.ab"
import "buffer.ab"
import "compute.ab"
import "push_constants.ab"

val graphicsGraphCommandPass = 1
val graphicsGraphCommandTextureCopy = 2
val graphicsGraphCommandRender = 3
val graphicsGraphCommandCompute = 4
val graphicsMaximumGraphCommands = 4096
val graphicsMaximumGraphPushConstantBytes = 128
val graphicsGraphRenderProcedural = 0
val graphicsGraphRenderVertices = 1
val graphicsGraphRenderIndexed = 2
val graphicsGraphRenderVerticesIndirect = 3
val graphicsGraphRenderIndexedIndirect = 4

fun graphicsGraphCommandFingerprintMix(state: int, value: int): int =
    ((state << 7) | (state >>> 57)) ^ value ^ (value >>> 32)

fun graphicsGraphBufferIdentity(buffer: GraphicsBuffer, backend: int): int =
    if (backend == graphicsBackendOpenGl) buffer.openGl.handle
    else if (backend == graphicsBackendVulkan) buffer.vulkan.handle
    else 0

fun graphicsGraphComputePipelineIdentity(
    pipeline: GraphicsComputePipeline,
    backend: int
): int = if (backend == graphicsBackendOpenGl) pipeline.openGl.handle
    else if (backend == graphicsBackendVulkan) pipeline.vulkan.handle
    else 0

fun graphicsGraphComputeBindingFingerprint(
    pipeline: GraphicsComputePipeline
): int {
    var fingerprint = graphicsGraphCommandFingerprintMix(
        1575540038426004389,
        pipeline.binding.backend
    )
    fingerprint = graphicsGraphCommandFingerprintMix(
        fingerprint,
        pipeline.binding.vulkan.descriptorSetLayout
    )
    fingerprint = graphicsGraphCommandFingerprintMix(
        fingerprint,
        pipeline.binding.vulkan.descriptorSet
    )
    var index = 0
    while (index < pipeline.binding.entries.size) {
        val entry = pipeline.binding.entries[index]
        fingerprint = graphicsGraphCommandFingerprintMix(
            fingerprint,
            entry.binding
        )
        fingerprint = graphicsGraphCommandFingerprintMix(
            fingerprint,
            entry.kind
        )
        fingerprint = graphicsGraphCommandFingerprintMix(
            fingerprint,
            entry.visibility
        )
        fingerprint = graphicsGraphCommandFingerprintMix(
            fingerprint,
            entry.openGlResource
        )
        fingerprint = graphicsGraphCommandFingerprintMix(
            fingerprint,
            entry.vulkanResource
        )
        fingerprint = graphicsGraphCommandFingerprintMix(
            fingerprint,
            entry.offset
        )
        fingerprint = graphicsGraphCommandFingerprintMix(
            fingerprint,
            entry.size
        )
        fingerprint = graphicsGraphCommandFingerprintMix(
            fingerprint,
            entry.bufferSize
        )
        if (pipeline.binding.backend == graphicsBackendOpenGl) {
            fingerprint = graphicsGraphCommandFingerprintMix(
                fingerprint,
                pipeline.binding.openGlKinds[index]
            )
            fingerprint = graphicsGraphCommandFingerprintMix(
                fingerprint,
                pipeline.binding.openGlBindings[index]
            )
            fingerprint = graphicsGraphCommandFingerprintMix(
                fingerprint,
                pipeline.binding.openGlResources[index]
            )
            fingerprint = graphicsGraphCommandFingerprintMix(
                fingerprint,
                pipeline.binding.openGlOffsets[index]
            )
            fingerprint = graphicsGraphCommandFingerprintMix(
                fingerprint,
                pipeline.binding.openGlSizes[index]
            )
        }
        index = index + 1
    }
    if (fingerprint == 0) 1 else fingerprint
}

fun graphicsGraphRenderTargetIdentity(
    target: GraphicsRenderTarget,
    backend: int
): int = if (backend == graphicsBackendOpenGl) target.openGl.handle
    else if (backend == graphicsBackendVulkan) target.vulkan.framebuffer
    else 0

fun graphicsGraphRenderPipelineIdentity(
    pipeline: GraphicsRenderPipeline,
    backend: int
): int = if (backend == graphicsBackendOpenGl) pipeline.openGl.handle
    else if (backend == graphicsBackendVulkan) pipeline.vulkan.handle
    else 0

fun graphicsGraphTextureDescriptorFingerprint(
    descriptor: TextureDescriptor
): int {
    var fingerprint = graphicsGraphCommandFingerprintMix(
        4354685564936845355,
        descriptor.size.width
    )
    fingerprint = graphicsGraphCommandFingerprintMix(
        fingerprint,
        descriptor.size.height
    )
    fingerprint = graphicsGraphCommandFingerprintMix(
        fingerprint,
        descriptor.size.depth
    )
    fingerprint = graphicsGraphCommandFingerprintMix(
        fingerprint,
        descriptor.mipLevels
    )
    fingerprint = graphicsGraphCommandFingerprintMix(
        fingerprint,
        descriptor.samples
    )
    fingerprint = graphicsGraphCommandFingerprintMix(
        fingerprint,
        descriptor.dimension
    )
    fingerprint = graphicsGraphCommandFingerprintMix(
        fingerprint,
        descriptor.format
    )
    fingerprint = graphicsGraphCommandFingerprintMix(
        fingerprint,
        descriptor.usage
    )
    if (fingerprint == 0) 1 else fingerprint
}

fun graphicsGraphBufferDescriptorFingerprint(
    descriptor: BufferDescriptor
): int {
    var fingerprint = graphicsGraphCommandFingerprintMix(
        1575540038426004383,
        descriptor.size
    )
    fingerprint = graphicsGraphCommandFingerprintMix(
        fingerprint,
        descriptor.usage
    )
    fingerprint = graphicsGraphCommandFingerprintMix(
        fingerprint,
        if (descriptor.mappedAtCreation) 1 else 0
    )
    fingerprint = graphicsGraphCommandFingerprintMix(
        fingerprint,
        if (descriptor.persistentMapping) 1 else 0
    )
    fingerprint = graphicsGraphCommandFingerprintMix(
        fingerprint,
        descriptor.memory
    )
    if (fingerprint == 0) 1 else fingerprint
}

fun graphicsGraphResourceDescriptorFingerprint(
    graph: GraphicsMaterializedRenderGraph,
    resourceId: int
): int = if (graph.textureResource(resourceId))
    graphicsGraphTextureDescriptorFingerprint(
        graph.textureDescriptor(resourceId)
    )
else if (graph.bufferResource(resourceId))
    graphicsGraphBufferDescriptorFingerprint(
        graph.bufferDescriptor(resourceId)
    )
else 0

fun graphicsGraphDeclaredAccess(
    graph: GraphicsMaterializedRenderGraph,
    passId: int,
    resourceId: int
): int {
    val passIndex = graphicsGraphPassIndex(graph.passes, passId)
    if (passIndex >= 0)
        graphicsGraphAccess(graph.passes[passIndex], resourceId)
    else 0
}

fun graphicsGraphRecordedRenderResourcesValid(
    target: GraphicsRenderTarget,
    pipeline: GraphicsRenderPipeline,
    backend: int,
    buffered: bool = false,
    pushConstantSize: int = 0,
    hasDepth: bool = false,
    hasResolve: bool = false
): bool = target.valid() && pipeline.valid() &&
    target.backend == backend && pipeline.backend == backend &&
    target.colorCount() == 1 && target.hasDepth() == hasDepth &&
    target.hasResolves() == hasResolve &&
    target.resolveTextures.size == (if (hasResolve) 1 else 0) &&
    ((hasResolve && target.texture.descriptor.samples > 1) ||
     (!hasResolve && target.texture.descriptor.samples == 1)) &&
    pipeline.targetHandle == (if (backend == graphicsBackendOpenGl)
        target.openGl.handle else target.vulkan.framebuffer) &&
    pipeline.targetWidth == target.texture.descriptor.size.width &&
    pipeline.targetHeight == target.texture.descriptor.size.height &&
    pipeline.targetColorCount == 1 && pipeline.targetSubpass == 0 &&
    pipeline.pushConstantLayout.size == pushConstantSize &&
    pipeline.vertexLayout.buffered() == buffered &&
    pipeline.depth.enabled == hasDepth &&
    pipeline.binding.empty()

fun graphicsGraphRecordedRenderValid(
    graph: GraphicsMaterializedRenderGraph,
    passId: int,
    resourceId: int,
    target: GraphicsRenderTarget,
    pipeline: GraphicsRenderPipeline,
    backend: int,
    pushConstantSize: int = 0,
    depthResourceId: int = -1,
    resolveResourceId: int = -1
): bool = graphicsGraphRecordedRenderResourcesValid(
    target,
    pipeline,
    backend,
    false,
    pushConstantSize,
    depthResourceId >= 0,
    resolveResourceId >= 0
) && graph.importedResource(resourceId) &&
    (graphicsGraphDeclaredAccess(graph, passId, resourceId) &
        graphAccessWrite) != 0 &&
    textureDescriptorsStorageCompatible(
        graph.textureDescriptor(resourceId),
        target.texture.descriptor
    ) && ((depthResourceId < 0 && !target.hasDepth()) ||
        (depthResourceId >= 0 && target.hasDepth() &&
         graph.importedResource(depthResourceId) &&
         graph.textureResource(depthResourceId) &&
         (graphicsGraphDeclaredAccess(graph, passId, depthResourceId) &
            graphAccessWrite) != 0 &&
         textureDescriptorsStorageCompatible(
            graph.textureDescriptor(depthResourceId),
            target.depthTexture.descriptor
         ))) && ((resolveResourceId < 0 && !target.hasResolves()) ||
        (resolveResourceId >= 0 && target.hasResolves() &&
         resolveResourceId != resourceId &&
         resolveResourceId != depthResourceId &&
         graph.importedResource(resolveResourceId) &&
         graph.textureResource(resolveResourceId) &&
         (graphicsGraphDeclaredAccess(graph, passId, resolveResourceId) &
            graphAccessWrite) != 0 &&
         textureDescriptorsStorageCompatible(
            graph.textureDescriptor(resolveResourceId),
            target.resolveTextures[0].descriptor
         )))

resource class GraphicsGraphRenderResources(
    val form: int,
    val resourceIds: array<int>,
    var buffers: array<GraphicsBuffer>,
    val vertexCount: int,
    val indexCount: int,
    val instanceCount: int,
    val vertexOffset: int,
    val vertexSize: int,
    val indexOffset: int,
    val indexSize: int,
    val indirectOffset: int,
    val indirectSize: int
) {
    fun validFor(
        pipeline: GraphicsRenderPipeline,
        backend: int
    ): bool {
        if (this.form == graphicsGraphRenderProcedural)
            return this.resourceIds.size == 0 && this.buffers.size == 0 &&
                this.vertexCount == 3 && this.indexCount == 0 &&
                this.instanceCount == 1
        val indirect = this.form == graphicsGraphRenderVerticesIndirect ||
            this.form == graphicsGraphRenderIndexedIndirect
        val indexed = this.form == graphicsGraphRenderIndexed ||
            this.form == graphicsGraphRenderIndexedIndirect
        val expectedBuffers = if (indirect)
            (if (indexed) 3 else 2)
        else if (indexed) 2 else 1
        var accepted = (this.form == graphicsGraphRenderVertices ||
            this.form == graphicsGraphRenderIndexed || indirect) &&
            this.resourceIds.size == expectedBuffers &&
            this.buffers.size == this.resourceIds.size &&
            pipeline.valid() && pipeline.backend == backend &&
            pipeline.vertexLayout.buffered() &&
            this.vertexCount > 0 && this.instanceCount > 0 &&
            ((!indexed && this.indexCount == 0) || (indexed && indirect &&
              this.indexCount == 0) || (indexed && !indirect &&
              this.indexCount > 0))
        if (accepted) {
            val vertices = this.buffers[0]
            val vertexBytes = graphicsDrawBufferRangeSize(
                this.vertexOffset,
                this.vertexSize,
                vertices.descriptor.size
            )
            accepted = vertices.valid() && vertices.backend == backend &&
                (vertices.descriptor.usage & bufferUsageVertex) != 0 &&
                pipeline.vertexLayout.stride > 0 &&
                graphicsDrawBufferRangeValid(
                    this.vertexOffset,
                    this.vertexSize,
                    vertices.descriptor.size,
                    pipeline.vertexLayout.stride
                ) && vertexBytes / pipeline.vertexLayout.stride > 0 &&
                (indirect || this.vertexCount <=
                    vertexBytes / pipeline.vertexLayout.stride)
        }
        if (accepted && indexed) {
            val indices = this.buffers[1]
            val indexBytes = graphicsDrawBufferRangeSize(
                this.indexOffset,
                this.indexSize,
                indices.descriptor.size
            )
            accepted = indices.valid() && indices.backend == backend &&
                (indices.descriptor.usage & bufferUsageIndex) != 0 &&
                graphicsDrawBufferRangeValid(
                    this.indexOffset,
                    this.indexSize,
                    indices.descriptor.size,
                    4
                ) && indexBytes / 4 > 0 &&
                (indirect || this.indexCount <= indexBytes / 4)
        }
        if (accepted && indirect) {
            val indirectIndex = if (indexed) 2 else 1
            val indirectBuffer = this.buffers[indirectIndex]
            accepted = indirectBuffer.valid() &&
                indirectBuffer.backend == backend &&
                (indirectBuffer.descriptor.usage & bufferUsageIndirect) != 0 &&
                graphicsDrawBufferRangeValid(
                    this.indirectOffset,
                    this.indirectSize,
                    indirectBuffer.descriptor.size,
                    if (indexed) 20 else 16
                )
        }
        accepted
    }
}

fun graphicsGraphRecordedRenderBufferValid(
    graph: GraphicsMaterializedRenderGraph,
    passId: int,
    resourceId: int,
    buffer: GraphicsBuffer,
    requiredUsage: int
): bool = requiredUsage != 0 && graph.importedResource(resourceId) &&
    graph.bufferResource(resourceId) &&
    (graphicsGraphDeclaredAccess(graph, passId, resourceId) &
        graphAccessRead) != 0 &&
    (buffer.descriptor.usage & requiredUsage) != 0 &&
    graphicsGraphBufferDescriptorsCompatible(
        graph.bufferDescriptor(resourceId),
        buffer.descriptor
    )

fun graphicsGraphRecordedRenderBuffersValid(
    graph: GraphicsMaterializedRenderGraph,
    passId: int,
    resources: GraphicsGraphRenderResources
): bool {
    val count = resources.resourceIds.size
    if (count != resources.buffers.size) return false
    if (resources.form == graphicsGraphRenderVertices && count == 1)
        return graphicsGraphRecordedRenderBufferValid(
            graph, passId, resources.resourceIds[0], resources.buffers[0],
            bufferUsageVertex
        )
    if (resources.form == graphicsGraphRenderIndexed && count == 2)
        return resources.resourceIds[0] != resources.resourceIds[1] &&
            graphicsGraphRecordedRenderBufferValid(
                graph, passId, resources.resourceIds[0], resources.buffers[0],
                bufferUsageVertex
            ) && graphicsGraphRecordedRenderBufferValid(
                graph, passId, resources.resourceIds[1], resources.buffers[1],
                bufferUsageIndex
            )
    if (resources.form == graphicsGraphRenderVerticesIndirect && count == 2)
        return resources.resourceIds[0] != resources.resourceIds[1] &&
            graphicsGraphRecordedRenderBufferValid(
                graph, passId, resources.resourceIds[0], resources.buffers[0],
                bufferUsageVertex
            ) && graphicsGraphRecordedRenderBufferValid(
                graph, passId, resources.resourceIds[1], resources.buffers[1],
                bufferUsageIndirect
            )
    if (resources.form == graphicsGraphRenderIndexedIndirect && count == 3)
        return resources.resourceIds[0] != resources.resourceIds[1] &&
            resources.resourceIds[0] != resources.resourceIds[2] &&
            resources.resourceIds[1] != resources.resourceIds[2] &&
            graphicsGraphRecordedRenderBufferValid(
                graph, passId, resources.resourceIds[0], resources.buffers[0],
                bufferUsageVertex
            ) && graphicsGraphRecordedRenderBufferValid(
                graph, passId, resources.resourceIds[1], resources.buffers[1],
                bufferUsageIndex
            ) && graphicsGraphRecordedRenderBufferValid(
                graph, passId, resources.resourceIds[2], resources.buffers[2],
                bufferUsageIndirect
            )
    false
}

fun graphicsGraphRecordedBufferedRenderValid(
    graph: GraphicsMaterializedRenderGraph,
    passId: int,
    resourceId: int,
    target: GraphicsRenderTarget,
    pipeline: GraphicsRenderPipeline,
    resources: GraphicsGraphRenderResources,
    backend: int,
    pushConstantSize: int = 0,
    depthResourceId: int = -1,
    resolveResourceId: int = -1
): bool = graphicsGraphRecordedRenderResourcesValid(
    target,
    pipeline,
    backend,
    true,
    pushConstantSize,
    depthResourceId >= 0,
    resolveResourceId >= 0
) && graph.importedResource(resourceId) &&
    (graphicsGraphDeclaredAccess(graph, passId, resourceId) &
        graphAccessWrite) != 0 &&
    textureDescriptorsStorageCompatible(
        graph.textureDescriptor(resourceId),
        target.texture.descriptor
    ) && ((depthResourceId < 0 && !target.hasDepth()) ||
        (depthResourceId >= 0 && target.hasDepth() &&
         graph.importedResource(depthResourceId) &&
         graph.textureResource(depthResourceId) &&
         (graphicsGraphDeclaredAccess(graph, passId, depthResourceId) &
            graphAccessWrite) != 0 &&
         textureDescriptorsStorageCompatible(
            graph.textureDescriptor(depthResourceId),
            target.depthTexture.descriptor
         ))) && ((resolveResourceId < 0 && !target.hasResolves()) ||
        (resolveResourceId >= 0 && target.hasResolves() &&
         resolveResourceId != resourceId &&
         resolveResourceId != depthResourceId &&
         graph.importedResource(resolveResourceId) &&
         graph.textureResource(resolveResourceId) &&
         (graphicsGraphDeclaredAccess(graph, passId, resolveResourceId) &
            graphAccessWrite) != 0 &&
         textureDescriptorsStorageCompatible(
            graph.textureDescriptor(resolveResourceId),
            target.resolveTextures[0].descriptor
         ))) && resources.validFor(pipeline, backend) &&
    graphicsGraphRecordedRenderBuffersValid(graph, passId, resources)

fun graphicsGraphRecordedComputeResourcesValid(
    buffers: array<GraphicsBuffer>,
    pipeline: GraphicsComputePipeline,
    backend: int
): bool {
    var accepted = pipeline.valid() && pipeline.backend == backend &&
        buffers.size >= 1 && buffers.size <= 16
    if (accepted && pipeline.binding.empty()) {
        accepted = buffers.size == 1 && buffers[0].valid() &&
            buffers[0].backend == backend &&
            (buffers[0].descriptor.usage & bufferUsageStorage) != 0 &&
            ((backend == graphicsBackendOpenGl &&
              pipeline.openGl.storageBuffer != 0 &&
              pipeline.openGl.storageBuffer == buffers[0].openGl.handle) ||
             (backend == graphicsBackendVulkan &&
              pipeline.vulkan.storageBuffer != 0 &&
              pipeline.vulkan.storageBuffer == buffers[0].vulkan.handle))
    } else if (accepted) {
        accepted = pipeline.binding.valid() &&
            pipeline.binding.entries.size == buffers.size &&
            pipeline.openGl.storageBuffer == 0 &&
            pipeline.vulkan.storageBuffer == 0
        var index = 0
        while (accepted && index < buffers.size) {
            val entry = pipeline.binding.entries[index]
            val buffer = buffers[index]
            val requiredUsage = if (entry.kind ==
                graphicsBindingUniformBuffer) bufferUsageUniform
                else if (entry.kind == graphicsBindingStorageBuffer)
                    bufferUsageStorage else 0
            accepted = requiredUsage != 0 && buffer.valid() &&
                buffer.backend == backend &&
                (buffer.descriptor.usage & requiredUsage) != 0 &&
                entry.bufferSize == buffer.descriptor.size &&
                ((backend == graphicsBackendOpenGl &&
                  entry.openGlResource == buffer.openGl.handle) ||
                 (backend == graphicsBackendVulkan &&
                  entry.vulkanResource == buffer.vulkan.handle))
            index = index + 1
        }
    }
    accepted
}

fun graphicsGraphRecordedComputeValid(
    graph: GraphicsMaterializedRenderGraph,
    passId: int,
    resourceIds: array<int>,
    buffers: array<GraphicsBuffer>,
    pipeline: GraphicsComputePipeline,
    backend: int,
    x: int,
    y: int,
    z: int,
    pushConstantSize: int = 0
): bool = graphicsGraphRecordedComputeResourcesValid(
    buffers,
    pipeline,
    backend
) && resourceIds.size == buffers.size &&
    graphicsGraphRecordedComputeDeclarationsValid(
        graph,
        passId,
        resourceIds,
        buffers,
        pipeline
    ) && pushConstantSize == pipeline.pushConstantLayout.size &&
    x > 0 && y > 0 && z > 0 &&
    x <= pipeline.limits.maximumComputeWorkgroupsX &&
    y <= pipeline.limits.maximumComputeWorkgroupsY &&
    z <= pipeline.limits.maximumComputeWorkgroupsZ

fun graphicsGraphRecordedComputeDeclarationsValid(
    graph: GraphicsMaterializedRenderGraph,
    passId: int,
    resourceIds: array<int>,
    buffers: array<GraphicsBuffer>,
    pipeline: GraphicsComputePipeline
): bool {
    var accepted = resourceIds.size == buffers.size &&
        resourceIds.size >= 1 && resourceIds.size <= 16
    var index = 0
    while (accepted && index < resourceIds.size) {
        val resourceId = resourceIds[index]
        val access = graphicsGraphDeclaredAccess(graph, passId, resourceId)
        val kind = if (pipeline.binding.empty())
            graphicsBindingStorageBuffer
        else pipeline.binding.entries[index].kind
        accepted = graph.importedResource(resourceId) &&
            graph.bufferResource(resourceId) &&
            graphicsGraphBufferDescriptorsCompatible(
                graph.bufferDescriptor(resourceId),
                buffers[index].descriptor
            ) && ((kind == graphicsBindingUniformBuffer &&
                   (access & graphAccessRead) != 0) ||
                  (kind == graphicsBindingStorageBuffer && access != 0))
        var earlier = 0
        while (accepted && earlier < index) {
            accepted = resourceIds[earlier] != resourceId
            earlier = earlier + 1
        }
        index = index + 1
    }
    accepted
}

resource class GraphicsGraphComputeResources(
    val resourceIds: array<int>,
    var buffers: array<GraphicsBuffer>
) {
    fun validFor(
        pipeline: GraphicsComputePipeline,
        backend: int
    ): bool = this.resourceIds.size == this.buffers.size &&
        graphicsGraphRecordedComputeResourcesValid(
            this.buffers,
            pipeline,
            backend
        )
}

fun graphicsGraphRecordedTransientComputeValid(
    graph: GraphicsMaterializedRenderGraph,
    passId: int,
    resourceIds: array<int>,
    pipeline: GraphicsComputePipeline,
    backend: int,
    x: int,
    y: int,
    z: int,
    pushConstantSize: int = 0
): bool {
    var accepted = graph.valid() && pipeline.valid() &&
        pipeline.backend == backend && pipeline.binding.valid() &&
        resourceIds.size >= 1 && resourceIds.size <= 16 &&
        pipeline.binding.entries.size == resourceIds.size &&
        pipeline.openGl.storageBuffer == 0 &&
        pipeline.vulkan.storageBuffer == 0 &&
        pushConstantSize == pipeline.pushConstantLayout.size &&
        x > 0 && y > 0 && z > 0 &&
        x <= pipeline.limits.maximumComputeWorkgroupsX &&
        y <= pipeline.limits.maximumComputeWorkgroupsY &&
        z <= pipeline.limits.maximumComputeWorkgroupsZ
    var index = 0
    while (accepted && index < resourceIds.size) {
        val resourceId = resourceIds[index]
        val entry = pipeline.binding.entries[index]
        val poolIndex = graph.bufferPoolIndex(resourceId)
        val access = graphicsGraphDeclaredAccess(graph, passId, resourceId)
        val requiredUsage = if (entry.kind == graphicsBindingUniformBuffer)
            bufferUsageUniform
        else if (entry.kind == graphicsBindingStorageBuffer)
            bufferUsageStorage else 0
        accepted = graph.transientResource(resourceId) &&
            graph.bufferResource(resourceId) && poolIndex >= 0 &&
            poolIndex < graph.bufferPools.size && requiredUsage != 0 &&
            (graph.bufferDescriptor(resourceId).usage & requiredUsage) != 0 &&
            ((entry.kind == graphicsBindingUniformBuffer &&
              (access & graphAccessRead) != 0) ||
             (entry.kind == graphicsBindingStorageBuffer && access != 0))
        if (accepted) {
            val pool = graph.bufferPools[poolIndex]
            val allocation = graph.bufferAllocations[poolIndex]
            accepted = pool.allocationValid(allocation) &&
                entry.offset == pool.allocationOffset(allocation) &&
                entry.size == graph.bufferDescriptor(resourceId).size &&
                entry.bufferSize == pool.backing.descriptor.size &&
                ((backend == graphicsBackendOpenGl &&
                  entry.openGlResource == pool.backing.openGl.handle) ||
                 (backend == graphicsBackendVulkan &&
                  entry.vulkanResource == pool.backing.vulkan.handle))
        }
        var earlier = 0
        while (accepted && earlier < index) {
            accepted = resourceIds[earlier] != resourceId &&
                graph.resourceSlot(resourceIds[earlier]) !=
                    graph.resourceSlot(resourceId)
            earlier = earlier + 1
        }
        index = index + 1
    }
    accepted
}

resource class GraphicsGraphCommandList(
    val capacity: int,
    val backend: int,
    val passOrder: array<int>,
    val resourceIds: array<int>,
    val resourceSlots: array<int>,
    val resourcePhysicalIdentities: array<int>,
    val resourceDescriptorFingerprints: array<int>,
    var renderTargets: array<GraphicsRenderTarget>,
    var renderPipelines: array<GraphicsRenderPipeline>,
    var renderResources: array<GraphicsGraphRenderResources>,
    var computeResources: array<GraphicsGraphComputeResources>,
    val computeTransientResourceIds: array<array<int>>,
    var computePipelines: array<GraphicsComputePipeline>,
    val kinds: array<int>,
    val passIds: array<int>,
    val sourceResourceIds: array<int>,
    val destinationResourceIds: array<int>,
    val sourceMipLevels: array<int>,
    val sourceXs: array<int>,
    val sourceYs: array<int>,
    val sourceZs: array<int>,
    val destinationMipLevels: array<int>,
    val destinationXs: array<int>,
    val destinationYs: array<int>,
    val destinationZs: array<int>,
    val widths: array<int>,
    val heights: array<int>,
    val depths: array<int>,
    val renderIndices: array<int>,
    val renderResourceIds: array<int>,
    val clearReds: array<f64>,
    val clearGreens: array<f64>,
    val clearBlues: array<f64>,
    val clearAlphas: array<f64>,
    val renderDepthResourceIds: array<int>,
    val renderResolveResourceIds: array<int>,
    val renderPushSizes: array<int>,
    val renderPushStorage: NativeByteBuffer,
    val computeIndices: array<int>,
    val computeResourceKinds: array<int>,
    val computeResourceIndices: array<int>,
    val computeXs: array<int>,
    val computeYs: array<int>,
    val computeZs: array<int>,
    val computePushSizes: array<int>,
    val computePushStorage: NativeByteBuffer,
    val oldSourceLayouts: array<int>,
    val oldDestinationLayouts: array<int>,
    var commandCount: int,
    var recordedPasses: int,
    var sealed: bool,
    var prepared: bool,
    var consolidatedVulkan: bool,
    var sealedFingerprint: int,
    var executions: int,
    var failedExecutions: int,
    var vulkanSubmissions: int,
    val error: GraphicsError
) {
    fun renderResourcesValid(): bool {
        var accepted = this.renderTargets.size == this.renderPipelines.size &&
            this.renderTargets.size == this.renderResources.size &&
            this.renderTargets.size == this.renderDepthResourceIds.size &&
            this.renderTargets.size == this.renderResolveResourceIds.size &&
            this.renderTargets.size <= this.capacity
        var index = 0
        while (accepted && index < this.renderTargets.size) {
            val resources = this.renderResources[index]
            accepted = resources.validFor(
                this.renderPipelines[index],
                this.backend
            ) && graphicsGraphRecordedRenderResourcesValid(
                this.renderTargets[index],
                this.renderPipelines[index],
                this.backend,
                resources.form != graphicsGraphRenderProcedural,
                this.renderPipelines[index].pushConstantLayout.size,
                this.renderDepthResourceIds[index] >= 0,
                this.renderResolveResourceIds[index] >= 0
            )
            index = index + 1
        }
        accepted
    }

    fun computeResourcesValid(): bool {
        var accepted = this.computePipelines.size <= this.capacity &&
            this.computeResources.size <= this.computePipelines.size &&
            this.computeTransientResourceIds.size <=
                this.computePipelines.size
        var index = 0
        while (accepted && index < this.computePipelines.size) {
            val kind = this.computeResourceKinds[index]
            val resourceIndex = this.computeResourceIndices[index]
            if (kind == 1) accepted = resourceIndex >= 0 &&
                resourceIndex < this.computeResources.size &&
                this.computeResources[resourceIndex].validFor(
                    this.computePipelines[index],
                    this.backend
                )
            else if (kind == 2) accepted = resourceIndex >= 0 &&
                resourceIndex < this.computeTransientResourceIds.size &&
                this.computeTransientResourceIds[resourceIndex].size >= 1 &&
                this.computeTransientResourceIds[resourceIndex].size <= 16 &&
                this.computePipelines[index].valid() &&
                this.computePipelines[index].binding.valid() &&
                this.computePipelines[index].binding.entries.size ==
                    this.computeTransientResourceIds[resourceIndex].size
            else accepted = false
            index = index + 1
        }
        accepted
    }

    fun computePushStorageValid(): bool {
        var accepted = !this.computePushStorage.closed &&
            this.computePushStorage.capacity ==
                this.capacity * graphicsMaximumGraphPushConstantBytes &&
            this.commandCount >= 0 && this.commandCount <= this.capacity
        var index = 0
        while (accepted && index < this.commandCount) {
            val pushSize = this.computePushSizes[index]
            accepted = pushSize >= 0 &&
                pushSize <= graphicsMaximumGraphPushConstantBytes &&
                (this.kinds[index] == graphicsGraphCommandCompute ||
                 pushSize == 0)
            index = index + 1
        }
        accepted
    }

    fun renderPushStorageValid(): bool {
        var accepted = !this.renderPushStorage.closed &&
            this.renderPushStorage.capacity ==
                this.capacity * graphicsMaximumGraphPushConstantBytes &&
            this.commandCount >= 0 && this.commandCount <= this.capacity
        var index = 0
        while (accepted && index < this.commandCount) {
            val pushSize = this.renderPushSizes[index]
            accepted = pushSize >= 0 &&
                pushSize <= graphicsMaximumGraphPushConstantBytes &&
                (this.kinds[index] == graphicsGraphCommandRender ||
                 pushSize == 0)
            index = index + 1
        }
        accepted
    }

    fun valid(): bool = !this.error.occurred() &&
        this.capacity >= 1 &&
        this.capacity <= graphicsMaximumGraphCommands &&
        (this.backend == graphicsBackendOpenGl ||
         this.backend == graphicsBackendVulkan) &&
        this.passOrder.size >= 1 &&
        this.passOrder.size <= graphicsMaximumGraphTextureResources &&
        this.resourceIds.size >= 1 &&
        this.resourceIds.size <= graphicsMaximumGraphTextureResources &&
        this.resourceSlots.size == this.resourceIds.size &&
        this.resourcePhysicalIdentities.size == this.resourceIds.size &&
        this.resourceDescriptorFingerprints.size == this.resourceIds.size &&
        this.renderResourcesValid() &&
        this.computeResourcesValid() &&
        this.kinds.size == this.capacity &&
        this.passIds.size == this.capacity &&
        this.sourceResourceIds.size == this.capacity &&
        this.destinationResourceIds.size == this.capacity &&
        this.sourceMipLevels.size == this.capacity &&
        this.sourceXs.size == this.capacity &&
        this.sourceYs.size == this.capacity &&
        this.sourceZs.size == this.capacity &&
        this.destinationMipLevels.size == this.capacity &&
        this.destinationXs.size == this.capacity &&
        this.destinationYs.size == this.capacity &&
        this.destinationZs.size == this.capacity &&
        this.widths.size == this.capacity &&
        this.heights.size == this.capacity &&
        this.depths.size == this.capacity &&
        this.renderIndices.size == this.capacity &&
        this.renderResourceIds.size == this.capacity &&
        this.clearReds.size == this.capacity &&
        this.clearGreens.size == this.capacity &&
        this.clearBlues.size == this.capacity &&
        this.clearAlphas.size == this.capacity &&
        this.renderPushSizes.size == this.capacity &&
        this.renderPushStorageValid() &&
        this.computeIndices.size == this.capacity &&
        this.computeResourceKinds.size == this.capacity &&
        this.computeResourceIndices.size == this.capacity &&
        this.computeXs.size == this.capacity &&
        this.computeYs.size == this.capacity &&
        this.computeZs.size == this.capacity &&
        this.computePushSizes.size == this.capacity &&
        this.computePushStorageValid() &&
        this.oldSourceLayouts.size == this.capacity &&
        this.oldDestinationLayouts.size == this.capacity &&
        this.commandCount >= 0 && this.commandCount <= this.capacity &&
        this.recordedPasses >= 0 &&
        this.recordedPasses <= this.passOrder.size &&
        (!this.prepared || this.sealed) &&
        (!this.prepared || this.sealedFingerprint != 0) &&
        this.executions >= 0 && this.failedExecutions >= 0 &&
        this.vulkanSubmissions >= 0

    fun fingerprint(): int {
        var fingerprint = graphicsGraphCommandFingerprintMix(
            7046029254386353131,
            this.commandCount
        )
        fingerprint = graphicsGraphCommandFingerprintMix(
            fingerprint,
            this.recordedPasses
        )
        fingerprint = graphicsGraphCommandFingerprintMix(
            fingerprint,
            if (this.consolidatedVulkan) 1 else 0
        )
        var commandIndex = 0
        while (commandIndex < this.commandCount) {
            fingerprint = graphicsGraphCommandFingerprintMix(
                fingerprint,
                this.kinds[commandIndex]
            )
            fingerprint = graphicsGraphCommandFingerprintMix(
                fingerprint,
                this.passIds[commandIndex]
            )
            fingerprint = graphicsGraphCommandFingerprintMix(
                fingerprint,
                this.sourceResourceIds[commandIndex]
            )
            fingerprint = graphicsGraphCommandFingerprintMix(
                fingerprint,
                this.destinationResourceIds[commandIndex]
            )
            fingerprint = graphicsGraphCommandFingerprintMix(
                fingerprint,
                this.sourceMipLevels[commandIndex]
            )
            fingerprint = graphicsGraphCommandFingerprintMix(
                fingerprint,
                this.sourceXs[commandIndex]
            )
            fingerprint = graphicsGraphCommandFingerprintMix(
                fingerprint,
                this.sourceYs[commandIndex]
            )
            fingerprint = graphicsGraphCommandFingerprintMix(
                fingerprint,
                this.sourceZs[commandIndex]
            )
            fingerprint = graphicsGraphCommandFingerprintMix(
                fingerprint,
                this.destinationMipLevels[commandIndex]
            )
            fingerprint = graphicsGraphCommandFingerprintMix(
                fingerprint,
                this.destinationXs[commandIndex]
            )
            fingerprint = graphicsGraphCommandFingerprintMix(
                fingerprint,
                this.destinationYs[commandIndex]
            )
            fingerprint = graphicsGraphCommandFingerprintMix(
                fingerprint,
                this.destinationZs[commandIndex]
            )
            fingerprint = graphicsGraphCommandFingerprintMix(
                fingerprint,
                this.widths[commandIndex]
            )
            fingerprint = graphicsGraphCommandFingerprintMix(
                fingerprint,
                this.heights[commandIndex]
            )
            fingerprint = graphicsGraphCommandFingerprintMix(
                fingerprint,
                this.depths[commandIndex]
            )
            fingerprint = graphicsGraphCommandFingerprintMix(
                fingerprint,
                this.renderIndices[commandIndex]
            )
            fingerprint = graphicsGraphCommandFingerprintMix(
                fingerprint,
                this.renderResourceIds[commandIndex]
            )
            fingerprint = graphicsGraphCommandFingerprintMix(
                fingerprint,
                f64ToBits(this.clearReds[commandIndex])
            )
            fingerprint = graphicsGraphCommandFingerprintMix(
                fingerprint,
                f64ToBits(this.clearGreens[commandIndex])
            )
            fingerprint = graphicsGraphCommandFingerprintMix(
                fingerprint,
                f64ToBits(this.clearBlues[commandIndex])
            )
            fingerprint = graphicsGraphCommandFingerprintMix(
                fingerprint,
                f64ToBits(this.clearAlphas[commandIndex])
            )
            val renderPushSize = this.renderPushSizes[commandIndex]
            fingerprint = graphicsGraphCommandFingerprintMix(
                fingerprint,
                renderPushSize
            )
            var renderPushOffset = 0
            while (renderPushOffset < renderPushSize) {
                fingerprint = graphicsGraphCommandFingerprintMix(
                    fingerprint,
                    this.renderPushStorage.load(
                        commandIndex *
                            graphicsMaximumGraphPushConstantBytes +
                            renderPushOffset
                    )
                )
                renderPushOffset = renderPushOffset + 1
            }
            fingerprint = graphicsGraphCommandFingerprintMix(
                fingerprint,
                this.computeIndices[commandIndex]
            )
            fingerprint = graphicsGraphCommandFingerprintMix(
                fingerprint,
                this.computeXs[commandIndex]
            )
            fingerprint = graphicsGraphCommandFingerprintMix(
                fingerprint,
                this.computeYs[commandIndex]
            )
            fingerprint = graphicsGraphCommandFingerprintMix(
                fingerprint,
                this.computeZs[commandIndex]
            )
            val pushSize = this.computePushSizes[commandIndex]
            fingerprint = graphicsGraphCommandFingerprintMix(
                fingerprint,
                pushSize
            )
            var pushOffset = 0
            while (pushOffset < pushSize) {
                fingerprint = graphicsGraphCommandFingerprintMix(
                    fingerprint,
                    this.computePushStorage.load(
                        commandIndex *
                            graphicsMaximumGraphPushConstantBytes +
                            pushOffset
                    )
                )
                pushOffset = pushOffset + 1
            }
            val renderIndex = this.renderIndices[commandIndex]
            if (renderIndex >= 0 && renderIndex < this.renderTargets.size &&
                renderIndex < this.renderPipelines.size) {
                fingerprint = graphicsGraphCommandFingerprintMix(
                    fingerprint,
                    graphicsGraphRenderTargetIdentity(
                        this.renderTargets[renderIndex],
                        this.backend
                    )
                )
                fingerprint = graphicsGraphCommandFingerprintMix(
                    fingerprint,
                    graphicsGraphRenderPipelineIdentity(
                        this.renderPipelines[renderIndex],
                        this.backend
                    )
                )
                if (renderIndex < this.renderDepthResourceIds.size) {
                    fingerprint = graphicsGraphCommandFingerprintMix(
                        fingerprint,
                        this.renderDepthResourceIds[renderIndex]
                    )
                }
                if (renderIndex < this.renderResolveResourceIds.size) {
                    fingerprint = graphicsGraphCommandFingerprintMix(
                        fingerprint,
                        this.renderResolveResourceIds[renderIndex]
                    )
                }
                if (renderIndex < this.renderResources.size) {
                    val resources = this.renderResources[renderIndex]
                    fingerprint = graphicsGraphCommandFingerprintMix(
                        fingerprint,
                        resources.form
                    )
                    fingerprint = graphicsGraphCommandFingerprintMix(
                        fingerprint,
                        resources.vertexCount
                    )
                    fingerprint = graphicsGraphCommandFingerprintMix(
                        fingerprint,
                        resources.indexCount
                    )
                    fingerprint = graphicsGraphCommandFingerprintMix(
                        fingerprint,
                        resources.instanceCount
                    )
                    fingerprint = graphicsGraphCommandFingerprintMix(
                        fingerprint,
                        resources.vertexOffset
                    )
                    fingerprint = graphicsGraphCommandFingerprintMix(
                        fingerprint,
                        resources.vertexSize
                    )
                    fingerprint = graphicsGraphCommandFingerprintMix(
                        fingerprint,
                        resources.indexOffset
                    )
                    fingerprint = graphicsGraphCommandFingerprintMix(
                        fingerprint,
                        resources.indexSize
                    )
                    fingerprint = graphicsGraphCommandFingerprintMix(
                        fingerprint,
                        resources.indirectOffset
                    )
                    fingerprint = graphicsGraphCommandFingerprintMix(
                        fingerprint,
                        resources.indirectSize
                    )
                    var bufferIndex = 0
                    while (bufferIndex < resources.resourceIds.size) {
                        fingerprint = graphicsGraphCommandFingerprintMix(
                            fingerprint,
                            resources.resourceIds[bufferIndex]
                        )
                        if (bufferIndex < resources.buffers.size) {
                            fingerprint = graphicsGraphCommandFingerprintMix(
                                fingerprint,
                                graphicsGraphBufferIdentity(
                                    resources.buffers[bufferIndex],
                                    this.backend
                                )
                            )
                        }
                        bufferIndex = bufferIndex + 1
                    }
                }
            }
            val computeIndex = this.computeIndices[commandIndex]
            if (computeIndex >= 0 &&
                computeIndex < this.computePipelines.size) {
                val resourceKind = this.computeResourceKinds[computeIndex]
                val resourceIndex = this.computeResourceIndices[computeIndex]
                fingerprint = graphicsGraphCommandFingerprintMix(
                    fingerprint,
                    resourceKind
                )
                var bufferIndex = 0
                if (resourceKind == 1 && resourceIndex >= 0 &&
                    resourceIndex < this.computeResources.size) {
                    val resources = this.computeResources[resourceIndex]
                    while (bufferIndex < resources.resourceIds.size) {
                        fingerprint = graphicsGraphCommandFingerprintMix(
                            fingerprint,
                            resources.resourceIds[bufferIndex]
                        )
                        if (bufferIndex < resources.buffers.size) {
                            fingerprint = graphicsGraphCommandFingerprintMix(
                                fingerprint,
                                graphicsGraphBufferIdentity(
                                    resources.buffers[bufferIndex],
                                    this.backend
                                )
                            )
                        }
                        bufferIndex = bufferIndex + 1
                    }
                } else if (resourceKind == 2 && resourceIndex >= 0 &&
                    resourceIndex < this.computeTransientResourceIds.size) {
                    val logicalIds =
                        this.computeTransientResourceIds[resourceIndex]
                    while (bufferIndex < logicalIds.size) {
                        fingerprint = graphicsGraphCommandFingerprintMix(
                            fingerprint,
                            logicalIds[bufferIndex]
                        )
                        bufferIndex = bufferIndex + 1
                    }
                }
                fingerprint = graphicsGraphCommandFingerprintMix(
                    fingerprint,
                    graphicsGraphComputePipelineIdentity(
                        this.computePipelines[computeIndex],
                        this.backend
                    )
                )
                fingerprint = graphicsGraphCommandFingerprintMix(
                    fingerprint,
                    graphicsGraphComputeBindingFingerprint(
                        this.computePipelines[computeIndex]
                    )
                )
            }
            commandIndex = commandIndex + 1
        }
        if (fingerprint == 0) 1 else fingerprint
    }

    fun graphCompatible(graph: GraphicsMaterializedRenderGraph): bool {
        var accepted = this.valid() && graph.valid() &&
            this.backend == graph.backend &&
            this.passOrder.size == graph.plan.order.size &&
            this.resourceIds.size == graph.resources.size
        var passPosition = 0
        while (accepted && passPosition < this.passOrder.size) {
            accepted = this.passOrder[passPosition] ==
                graph.plan.order[passPosition]
            passPosition = passPosition + 1
        }
        var resourceIndex = 0
        while (accepted && resourceIndex < this.resourceIds.size) {
            val resourceId = this.resourceIds[resourceIndex]
            accepted = resourceId == graph.resources[resourceIndex].id &&
                this.resourceSlots[resourceIndex] ==
                    graph.resourceSlot(resourceId) &&
                this.resourceDescriptorFingerprints[resourceIndex] ==
                    graphicsGraphResourceDescriptorFingerprint(
                        graph,
                        resourceId
                    ) && (
                    (graph.transientResource(resourceId) &&
                     this.resourcePhysicalIdentities[resourceIndex] != 0 &&
                     this.resourcePhysicalIdentities[resourceIndex] ==
                        graph.physicalIdentity(resourceId)) ||
                    (graph.importedResource(resourceId) &&
                     this.resourceSlots[resourceIndex] == -1 &&
                     this.resourcePhysicalIdentities[resourceIndex] == 0)
                )
            resourceIndex = resourceIndex + 1
        }
        accepted
    }

    fun commandsValidFor(
        graph: GraphicsMaterializedRenderGraph
    ): bool {
        var accepted = this.graphCompatible(graph) && this.sealed &&
            this.recordedPasses == this.passOrder.size &&
            this.commandCount >= this.recordedPasses
        var commandIndex = 0
        var passPosition = -1
        while (accepted && commandIndex < this.commandCount) {
            val kind = this.kinds[commandIndex]
            if (kind == graphicsGraphCommandPass) {
                passPosition = passPosition + 1
                accepted = passPosition < this.passOrder.size &&
                    this.passIds[commandIndex] ==
                        this.passOrder[passPosition]
            } else if (kind == graphicsGraphCommandTextureCopy) {
                val source = this.sourceResourceIds[commandIndex]
                val destination =
                    this.destinationResourceIds[commandIndex]
                val sourceSlot = graph.resourceSlot(source)
                val destinationSlot = graph.resourceSlot(destination)
                val passId = if (passPosition >= 0 &&
                    passPosition < this.passOrder.size)
                    this.passOrder[passPosition] else -1
                accepted = passId >= 0 &&
                    this.passIds[commandIndex] == passId &&
                    graph.transientResource(source) &&
                    graph.transientResource(destination) &&
                    sourceSlot >= 0 && destinationSlot >= 0 &&
                    sourceSlot != destinationSlot &&
                    (graphicsGraphDeclaredAccess(
                        graph,
                        passId,
                        source
                    ) & graphAccessRead) != 0 &&
                    (graphicsGraphDeclaredAccess(
                        graph,
                        passId,
                        destination
                    ) & graphAccessWrite) != 0 &&
                    textureCopyRangeValid(
                        graph.textureDescriptor(source),
                        graph.textureDescriptor(destination),
                        this.sourceMipLevels[commandIndex],
                        this.sourceXs[commandIndex],
                        this.sourceYs[commandIndex],
                        this.sourceZs[commandIndex],
                        this.destinationMipLevels[commandIndex],
                        this.destinationXs[commandIndex],
                        this.destinationYs[commandIndex],
                        this.destinationZs[commandIndex],
                        this.widths[commandIndex],
                        this.heights[commandIndex],
                        this.depths[commandIndex]
                    )
            } else if (kind == graphicsGraphCommandRender) {
                val renderIndex = this.renderIndices[commandIndex]
                val resourceId = this.renderResourceIds[commandIndex]
                val passId = if (passPosition >= 0 &&
                    passPosition < this.passOrder.size)
                    this.passOrder[passPosition] else -1
                accepted = passId >= 0 &&
                    this.passIds[commandIndex] == passId &&
                    renderIndex >= 0 &&
                    renderIndex < this.renderTargets.size &&
                    renderIndex < this.renderPipelines.size &&
                    renderIndex < this.renderResources.size &&
                    graphicsColorScalarsValid(
                        this.clearReds[commandIndex],
                        this.clearGreens[commandIndex],
                        this.clearBlues[commandIndex],
                        this.clearAlphas[commandIndex]
                    )
                if (accepted) {
                    val resources = this.renderResources[renderIndex]
                    val pushSize = this.renderPushSizes[commandIndex]
                    accepted = if (resources.form ==
                        graphicsGraphRenderProcedural)
                        graphicsGraphRecordedRenderValid(
                            graph,
                            passId,
                            resourceId,
                            this.renderTargets[renderIndex],
                            this.renderPipelines[renderIndex],
                            this.backend,
                            pushSize,
                            this.renderDepthResourceIds[renderIndex],
                            this.renderResolveResourceIds[renderIndex]
                        )
                    else graphicsGraphRecordedBufferedRenderValid(
                        graph,
                        passId,
                        resourceId,
                        this.renderTargets[renderIndex],
                        this.renderPipelines[renderIndex],
                        resources,
                        this.backend,
                        pushSize,
                        this.renderDepthResourceIds[renderIndex],
                        this.renderResolveResourceIds[renderIndex]
                    )
                }
            } else if (kind == graphicsGraphCommandCompute) {
                val computeIndex = this.computeIndices[commandIndex]
                val passId = if (passPosition >= 0 &&
                    passPosition < this.passOrder.size)
                    this.passOrder[passPosition] else -1
                accepted = passId >= 0 &&
                    this.passIds[commandIndex] == passId &&
                    computeIndex >= 0 &&
                    computeIndex < this.computePipelines.size
                if (accepted) {
                    val resourceKind = this.computeResourceKinds[computeIndex]
                    val resourceIndex =
                        this.computeResourceIndices[computeIndex]
                    accepted = if (resourceKind == 2 &&
                        resourceIndex >= 0 && resourceIndex <
                            this.computeTransientResourceIds.size)
                        graphicsGraphRecordedTransientComputeValid(
                            graph,
                            passId,
                            this.computeTransientResourceIds[resourceIndex],
                            this.computePipelines[computeIndex],
                            this.backend,
                            this.computeXs[commandIndex],
                            this.computeYs[commandIndex],
                            this.computeZs[commandIndex],
                            this.computePushSizes[commandIndex]
                        )
                    else if (resourceKind == 1 && resourceIndex >= 0 &&
                        resourceIndex < this.computeResources.size)
                        graphicsGraphRecordedComputeValid(
                        graph,
                        passId,
                        this.computeResources[resourceIndex].resourceIds,
                        this.computeResources[resourceIndex].buffers,
                        this.computePipelines[computeIndex],
                        this.backend,
                        this.computeXs[commandIndex],
                        this.computeYs[commandIndex],
                        this.computeZs[commandIndex],
                        this.computePushSizes[commandIndex]
                    ) else false
                }
            } else accepted = false
            commandIndex = commandIndex + 1
        }
        accepted && passPosition == this.passOrder.size - 1
    }

    fun vulkanCommandsConsolidatable(
        graph: GraphicsMaterializedRenderGraph
    ): bool {
        var accepted = this.backend == graphicsBackendVulkan &&
            this.graphCompatible(graph)
        var commandIndex = 0
        while (accepted && commandIndex < this.commandCount) {
            val kind = this.kinds[commandIndex]
            if (kind == graphicsGraphCommandTextureCopy) {
                val source = graph.textureDescriptor(
                    this.sourceResourceIds[commandIndex]
                )
                val destination = graph.textureDescriptor(
                    this.destinationResourceIds[commandIndex]
                )
                accepted = source.dimension == textureDimension2D &&
                    destination.dimension == textureDimension2D &&
                    this.sourceZs[commandIndex] == 0 &&
                    this.destinationZs[commandIndex] == 0 &&
                    this.depths[commandIndex] == 1
            } else accepted = kind == graphicsGraphCommandPass ||
                kind == graphicsGraphCommandRender ||
                kind == graphicsGraphCommandCompute
            commandIndex = commandIndex + 1
        }
        accepted
    }

    fun directVulkanSubmissionCount(
        graph: GraphicsMaterializedRenderGraph
    ): int {
        if (this.backend != graphicsBackendVulkan) return 0
        var accepted = this.graphCompatible(graph)
        var submissions = 0
        var passPosition = -1
        var commandIndex = 0
        while (accepted && commandIndex < this.commandCount) {
            val kind = this.kinds[commandIndex]
            var submits = false
            if (kind == graphicsGraphCommandPass) {
                passPosition = passPosition + 1
                accepted = passPosition >= 0 &&
                    passPosition < graph.compiledBarrierCounts.size
                submits = accepted &&
                    graph.compiledBarrierCounts[passPosition] > 0
            } else if (kind == graphicsGraphCommandTextureCopy ||
                kind == graphicsGraphCommandRender ||
                kind == graphicsGraphCommandCompute) {
                submits = true
            } else accepted = false
            if (accepted && submits) {
                accepted = submissions < graphicsMaximumInt
                if (accepted) submissions = submissions + 1
            }
            commandIndex = commandIndex + 1
        }
        if (accepted) submissions else -1
    }

    trusted fun recordPass(
        graph: GraphicsMaterializedRenderGraph,
        passId: int
    ): bool {
        val accepted = this.graphCompatible(graph) && !this.sealed &&
            this.commandCount < this.capacity &&
            this.recordedPasses < this.passOrder.size &&
            this.passOrder[this.recordedPasses] == passId
        if (accepted) {
            val index = this.commandCount
            this.kinds[index] = graphicsGraphCommandPass
            this.passIds[index] = passId
            this.commandCount = this.commandCount + 1
            this.recordedPasses = this.recordedPasses + 1
        }
        accepted
    }

    trusted fun recordTextureCopyRange(
        graph: GraphicsMaterializedRenderGraph,
        sourceResourceId: int,
        destinationResourceId: int,
        sourceMipLevel: int,
        sourceX: int,
        sourceY: int,
        sourceZ: int,
        destinationMipLevel: int,
        destinationX: int,
        destinationY: int,
        destinationZ: int,
        width: int,
        height: int,
        depth: int
    ): bool {
        val passId = if (this.recordedPasses > 0)
            this.passOrder[this.recordedPasses - 1] else -1
        val sourceSlot = graph.resourceSlot(sourceResourceId)
        val destinationSlot = graph.resourceSlot(destinationResourceId)
        val accepted = this.graphCompatible(graph) && !this.sealed &&
            this.commandCount < this.capacity && passId >= 0 &&
            graph.transientResource(sourceResourceId) &&
            graph.transientResource(destinationResourceId) &&
            sourceSlot >= 0 && destinationSlot >= 0 &&
            sourceSlot != destinationSlot &&
            (graphicsGraphDeclaredAccess(
                graph,
                passId,
                sourceResourceId
            ) & graphAccessRead) != 0 &&
            (graphicsGraphDeclaredAccess(
                graph,
                passId,
                destinationResourceId
            ) & graphAccessWrite) != 0 &&
            textureCopyRangeValid(
                graph.textureDescriptor(sourceResourceId),
                graph.textureDescriptor(destinationResourceId),
                sourceMipLevel,
                sourceX,
                sourceY,
                sourceZ,
                destinationMipLevel,
                destinationX,
                destinationY,
                destinationZ,
                width,
                height,
                depth
            )
        if (accepted) {
            val index = this.commandCount
            this.kinds[index] = graphicsGraphCommandTextureCopy
            this.passIds[index] = passId
            this.sourceResourceIds[index] = sourceResourceId
            this.destinationResourceIds[index] = destinationResourceId
            this.sourceMipLevels[index] = sourceMipLevel
            this.sourceXs[index] = sourceX
            this.sourceYs[index] = sourceY
            this.sourceZs[index] = sourceZ
            this.destinationMipLevels[index] = destinationMipLevel
            this.destinationXs[index] = destinationX
            this.destinationYs[index] = destinationY
            this.destinationZs[index] = destinationZ
            this.widths[index] = width
            this.heights[index] = height
            this.depths[index] = depth
            this.commandCount = this.commandCount + 1
        }
        accepted
    }

    trusted fun recordTextureCopy(
        graph: GraphicsMaterializedRenderGraph,
        sourceResourceId: int,
        destinationResourceId: int,
        copy: TextureCopyDescriptor = TextureCopyDescriptor()
    ): bool {
        val source = graph.textureDescriptor(sourceResourceId)
        val destination = graph.textureDescriptor(destinationResourceId)
        return copy.valid(source, destination) &&
            this.recordTextureCopyRange(
                graph,
                sourceResourceId,
                destinationResourceId,
                copy.sourceMipLevel,
                copy.sourceX,
                copy.sourceY,
                0,
                copy.destinationMipLevel,
                copy.destinationX,
                copy.destinationY,
                0,
                copy.resolvedWidth(source),
                copy.resolvedHeight(source),
                1
            )
    }

    trusted fun recordRenderResourcesPushInternal(
        graph: GraphicsMaterializedRenderGraph,
        resourceId: int,
        own target: GraphicsRenderTarget,
        own pipeline: GraphicsRenderPipeline,
        own resources: GraphicsGraphRenderResources,
        constants: GraphicsPushConstants,
        clear: Color,
        depthResourceId: int = -1,
        resolveResourceId: int = -1
    ): bool {
        val passId = if (this.recordedPasses > 0)
            this.passOrder[this.recordedPasses - 1] else -1
        val renderIndex = this.renderTargets.size
        val pushSize = if (constants.valid()) constants.layout.size else 0
        val resourcesValid = if (resources.form ==
            graphicsGraphRenderProcedural)
            graphicsGraphRecordedRenderValid(
                graph,
                passId,
                resourceId,
                target,
                pipeline,
                this.backend,
                pushSize,
                depthResourceId,
                resolveResourceId
            )
        else graphicsGraphRecordedBufferedRenderValid(
            graph,
            passId,
            resourceId,
            target,
            pipeline,
            resources,
            this.backend,
            pushSize,
            depthResourceId,
            resolveResourceId
        )
        val accepted = this.graphCompatible(graph) && !this.sealed &&
            this.commandCount < this.capacity && passId >= 0 &&
            renderIndex < this.capacity &&
            renderIndex == this.renderPipelines.size &&
            renderIndex == this.renderResources.size &&
            renderIndex == this.renderDepthResourceIds.size && clear.valid() &&
            renderIndex == this.renderResolveResourceIds.size &&
            constants.valid() &&
            constants.layout.matches(pipeline.pushConstantLayout) &&
            pushSize > 0 &&
            pushSize <= graphicsMaximumGraphPushConstantBytes && resourcesValid
        if (accepted) {
            val index = this.commandCount
            ablaUnsafeCopyMemory(
                this.renderPushStorage.pointerAt(
                    index * graphicsMaximumGraphPushConstantBytes
                ),
                constants.bytes.storage.address,
                pushSize
            )
            this.renderTargets.append(move(target))
            this.renderPipelines.append(move(pipeline))
            this.renderResources.append(move(resources))
            this.renderDepthResourceIds.append(depthResourceId)
            this.renderResolveResourceIds.append(resolveResourceId)
            this.kinds[index] = graphicsGraphCommandRender
            this.passIds[index] = passId
            this.renderIndices[index] = renderIndex
            this.renderResourceIds[index] = resourceId
            this.clearReds[index] = clear.red
            this.clearGreens[index] = clear.green
            this.clearBlues[index] = clear.blue
            this.clearAlphas[index] = clear.alpha
            this.renderPushSizes[index] = pushSize
            this.commandCount = this.commandCount + 1
        }
        accepted
    }

