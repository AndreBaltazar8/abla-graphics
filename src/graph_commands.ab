    trusted fun recordComputeBindings(
        graph: GraphicsMaterializedRenderGraph,
        resourceIds: array<int>,
        own buffers: array<GraphicsBuffer>,
        own pipeline: GraphicsComputePipeline,
        x: int,
        y: int = 1,
        z: int = 1
    ): bool {
        val passId = if (this.recordedPasses > 0)
            this.passOrder[this.recordedPasses - 1] else -1
        val computeIndex = this.computePipelines.size
        val resourceIndex = this.computeResources.size
        val accepted = this.graphCompatible(graph) && !this.sealed &&
            this.commandCount < this.capacity && passId >= 0 &&
            computeIndex < this.capacity &&
            buffers.size >= 1 && buffers.size <= 16 &&
            graphicsGraphRecordedComputeValid(
                graph,
                passId,
                resourceIds,
                buffers,
                pipeline,
                this.backend,
                x,
                y,
                z
            )
        if (accepted) {
            val index = this.commandCount
            val resources = GraphicsGraphComputeResources(
                resourceIds,
                move(buffers)
            )
            this.computeResources.append(move(resources))
            this.computePipelines.append(move(pipeline))
            this.computeResourceKinds[computeIndex] = 1
            this.computeResourceIndices[computeIndex] = resourceIndex
            this.kinds[index] = graphicsGraphCommandCompute
            this.passIds[index] = passId
            this.computeIndices[index] = computeIndex
            this.computeXs[index] = x
            this.computeYs[index] = y
            this.computeZs[index] = z
            this.commandCount = this.commandCount + 1
        }
        accepted
    }

    trusted fun recordTransientComputeBindings(
        graph: GraphicsMaterializedRenderGraph,
        resourceIds: array<int>,
        own pipeline: GraphicsComputePipeline,
        x: int,
        y: int = 1,
        z: int = 1
    ): bool {
        val passId = if (this.recordedPasses > 0)
            this.passOrder[this.recordedPasses - 1] else -1
        val computeIndex = this.computePipelines.size
        val resourceIndex = this.computeTransientResourceIds.size
        val accepted = this.graphCompatible(graph) && !this.sealed &&
            this.commandCount < this.capacity && passId >= 0 &&
            computeIndex < this.capacity &&
            graphicsGraphRecordedTransientComputeValid(
                graph,
                passId,
                resourceIds,
                pipeline,
                this.backend,
                x,
                y,
                z
            )
        if (accepted) {
            val index = this.commandCount
            this.computeTransientResourceIds.append(resourceIds)
            this.computePipelines.append(move(pipeline))
            this.computeResourceKinds[computeIndex] = 2
            this.computeResourceIndices[computeIndex] = resourceIndex
            this.kinds[index] = graphicsGraphCommandCompute
            this.passIds[index] = passId
            this.computeIndices[index] = computeIndex
            this.computeXs[index] = x
            this.computeYs[index] = y
            this.computeZs[index] = z
            this.commandCount = this.commandCount + 1
        }
        accepted
    }

    trusted fun recordComputeStoragePush(
        graph: GraphicsMaterializedRenderGraph,
        resourceId: int,
        own storage: GraphicsBuffer,
        own pipeline: GraphicsComputePipeline,
        constants: GraphicsPushConstants,
        x: int,
        y: int = 1,
        z: int = 1
    ): bool = this.recordComputeBindingsPush(
        graph,
        [resourceId],
        [move(storage)],
        move(pipeline),
        constants,
        x,
        y,
        z
    )

    trusted fun recordComputeBindingsPush(
        graph: GraphicsMaterializedRenderGraph,
        resourceIds: array<int>,
        own buffers: array<GraphicsBuffer>,
        own pipeline: GraphicsComputePipeline,
        constants: GraphicsPushConstants,
        x: int,
        y: int = 1,
        z: int = 1
    ): bool {
        val passId = if (this.recordedPasses > 0)
            this.passOrder[this.recordedPasses - 1] else -1
        val computeIndex = this.computePipelines.size
        val resourceIndex = this.computeResources.size
        val pushSize = if (constants.valid()) constants.layout.size else 0
        val accepted = this.graphCompatible(graph) && !this.sealed &&
            this.commandCount < this.capacity && passId >= 0 &&
            computeIndex < this.capacity &&
            buffers.size >= 1 && buffers.size <= 16 &&
            constants.valid() &&
            constants.layout.matches(pipeline.pushConstantLayout) &&
            pushSize > 0 &&
            pushSize <= graphicsMaximumGraphPushConstantBytes &&
            graphicsGraphRecordedComputeValid(
                graph,
                passId,
                resourceIds,
                buffers,
                pipeline,
                this.backend,
                x,
                y,
                z,
                pushSize
            )
        if (accepted) {
            val index = this.commandCount
            ablaUnsafeCopyMemory(
                this.computePushStorage.pointerAt(
                    index * graphicsMaximumGraphPushConstantBytes
                ),
                constants.bytes.storage.address,
                pushSize
            )
            val resources = GraphicsGraphComputeResources(
                resourceIds,
                move(buffers)
            )
            this.computeResources.append(move(resources))
            this.computePipelines.append(move(pipeline))
            this.computeResourceKinds[computeIndex] = 1
            this.computeResourceIndices[computeIndex] = resourceIndex
            this.kinds[index] = graphicsGraphCommandCompute
            this.passIds[index] = passId
            this.computeIndices[index] = computeIndex
            this.computeXs[index] = x
            this.computeYs[index] = y
            this.computeZs[index] = z
            this.computePushSizes[index] = pushSize
            this.commandCount = this.commandCount + 1
        }
        accepted
    }

    trusted fun recordTransientComputeBindingsPush(
        graph: GraphicsMaterializedRenderGraph,
        resourceIds: array<int>,
        own pipeline: GraphicsComputePipeline,
        constants: GraphicsPushConstants,
        x: int,
        y: int = 1,
        z: int = 1
    ): bool {
        val passId = if (this.recordedPasses > 0)
            this.passOrder[this.recordedPasses - 1] else -1
        val computeIndex = this.computePipelines.size
        val resourceIndex = this.computeTransientResourceIds.size
        val pushSize = if (constants.valid()) constants.layout.size else 0
        val accepted = this.graphCompatible(graph) && !this.sealed &&
            this.commandCount < this.capacity && passId >= 0 &&
            computeIndex < this.capacity &&
            constants.valid() &&
            constants.layout.matches(pipeline.pushConstantLayout) &&
            pushSize > 0 &&
            pushSize <= graphicsMaximumGraphPushConstantBytes &&
            graphicsGraphRecordedTransientComputeValid(
                graph,
                passId,
                resourceIds,
                pipeline,
                this.backend,
                x,
                y,
                z,
                pushSize
            )
        if (accepted) {
            val index = this.commandCount
            ablaUnsafeCopyMemory(
                this.computePushStorage.pointerAt(
                    index * graphicsMaximumGraphPushConstantBytes
                ),
                constants.bytes.storage.address,
                pushSize
            )
            this.computeTransientResourceIds.append(resourceIds)
            this.computePipelines.append(move(pipeline))
            this.computeResourceKinds[computeIndex] = 2
            this.computeResourceIndices[computeIndex] = resourceIndex
            this.kinds[index] = graphicsGraphCommandCompute
            this.passIds[index] = passId
            this.computeIndices[index] = computeIndex
            this.computeXs[index] = x
            this.computeYs[index] = y
            this.computeZs[index] = z
            this.computePushSizes[index] = pushSize
            this.commandCount = this.commandCount + 1
        }
        accepted
    }

    fun seal(graph: GraphicsMaterializedRenderGraph): bool {
        val accepted = this.graphCompatible(graph) && !this.sealed &&
            this.recordedPasses == this.passOrder.size &&
            this.commandCount >= this.recordedPasses
        if (accepted) this.sealed = true
        val prepared = accepted && this.commandsValidFor(graph)
        if (prepared) {
            this.consolidatedVulkan =
                this.vulkanCommandsConsolidatable(graph)
            this.sealedFingerprint = this.fingerprint()
            this.prepared = true
        }
        else if (accepted) this.sealed = false
        prepared
    }

}

trusted fun GraphicsApplication.graphCommandList(
    graph: GraphicsMaterializedRenderGraph,
    capacity: int
): GraphicsGraphCommandList {
    var accepted = this.valid() && graph.valid() &&
        this.backend == graph.backend && capacity >= graph.plan.order.size &&
        capacity <= graphicsMaximumGraphCommands
    val passOrder: array<int> = []
    val resourceIds: array<int> = []
    val resourceSlots: array<int> = []
    val resourcePhysicalIdentities: array<int> = []
    val resourceDescriptorFingerprints: array<int> = []
    val renderTargets: array<GraphicsRenderTarget> = []
    val renderPipelines: array<GraphicsRenderPipeline> = []
    val renderResources: array<GraphicsGraphRenderResources> = []
    val computeResources: array<GraphicsGraphComputeResources> = []
    val computeTransientResourceIds: array<array<int>> = []
    val computePipelines: array<GraphicsComputePipeline> = []
    val kinds: array<int> = []
    val passIds: array<int> = []
    val sourceResourceIds: array<int> = []
    val destinationResourceIds: array<int> = []
    val sourceMipLevels: array<int> = []
    val sourceXs: array<int> = []
    val sourceYs: array<int> = []
    val sourceZs: array<int> = []
    val destinationMipLevels: array<int> = []
    val destinationXs: array<int> = []
    val destinationYs: array<int> = []
    val destinationZs: array<int> = []
    val widths: array<int> = []
    val heights: array<int> = []
    val depths: array<int> = []
    val renderIndices: array<int> = []
    val renderResourceIds: array<int> = []
    val clearReds: array<f64> = []
    val clearGreens: array<f64> = []
    val clearBlues: array<f64> = []
    val clearAlphas: array<f64> = []
    val renderDepthResourceIds: array<int> = []
    val renderResolveResourceIds: array<int> = []
    val renderPushSizes: array<int> = []
    val renderPushStorage = nativeByteBuffer(
        if (capacity > 0 && capacity <= graphicsMaximumGraphCommands)
            capacity * graphicsMaximumGraphPushConstantBytes
        else 0
    )
    val computeIndices: array<int> = []
    val computeResourceKinds: array<int> = []
    val computeResourceIndices: array<int> = []
    val computeXs: array<int> = []
    val computeYs: array<int> = []
    val computeZs: array<int> = []
    val computePushSizes: array<int> = []
    val computePushStorage = nativeByteBuffer(
        if (capacity > 0 && capacity <= graphicsMaximumGraphCommands)
            capacity * graphicsMaximumGraphPushConstantBytes
        else 0
    )
    val oldSourceLayouts: array<int> = []
    val oldDestinationLayouts: array<int> = []
    var index = 0
    while (accepted && index < graph.plan.order.size) {
        passOrder.append(graph.plan.order[index])
        index = index + 1
    }
    index = 0
    while (accepted && index < graph.resources.size) {
        val resourceId = graph.resources[index].id
        val physicalIdentity = graph.physicalIdentity(resourceId)
        if ((graph.transientResource(resourceId) && physicalIdentity != 0) ||
            (graph.importedResource(resourceId) &&
             graph.resourceSlot(resourceId) == -1 &&
             physicalIdentity == 0)) {
            resourceIds.append(resourceId)
            resourceSlots.append(graph.resourceSlot(resourceId))
            resourcePhysicalIdentities.append(physicalIdentity)
            resourceDescriptorFingerprints.append(
                graphicsGraphResourceDescriptorFingerprint(
                    graph,
                    resourceId
                )
            )
        } else accepted = false
        index = index + 1
    }
    index = 0
    while (accepted && index < capacity) {
        kinds.append(0)
        passIds.append(0)
        sourceResourceIds.append(0)
        destinationResourceIds.append(0)
        sourceMipLevels.append(0)
        sourceXs.append(0)
        sourceYs.append(0)
        sourceZs.append(0)
        destinationMipLevels.append(0)
        destinationXs.append(0)
        destinationYs.append(0)
        destinationZs.append(0)
        widths.append(0)
        heights.append(0)
        depths.append(0)
        renderIndices.append(-1)
        renderResourceIds.append(-1)
        clearReds.append(0.0)
        clearGreens.append(0.0)
        clearBlues.append(0.0)
        clearAlphas.append(0.0)
        renderPushSizes.append(0)
        computeIndices.append(-1)
        computeResourceKinds.append(0)
        computeResourceIndices.append(-1)
        computeXs.append(0)
        computeYs.append(0)
        computeZs.append(0)
        computePushSizes.append(0)
        oldSourceLayouts.append(-1)
        oldDestinationLayouts.append(-1)
        index = index + 1
    }
    GraphicsGraphCommandList(
        if (accepted) capacity else 0,
        if (accepted) this.backend else graphicsBackendAuto,
        passOrder,
        resourceIds,
        resourceSlots,
        resourcePhysicalIdentities,
        resourceDescriptorFingerprints,
        move(renderTargets),
        move(renderPipelines),
        move(renderResources),
        move(computeResources),
        computeTransientResourceIds,
        move(computePipelines),
        kinds,
        passIds,
        sourceResourceIds,
        destinationResourceIds,
        sourceMipLevels,
        sourceXs,
        sourceYs,
        sourceZs,
        destinationMipLevels,
        destinationXs,
        destinationYs,
        destinationZs,
        widths,
        heights,
        depths,
        renderIndices,
        renderResourceIds,
        clearReds,
        clearGreens,
        clearBlues,
        clearAlphas,
        renderDepthResourceIds,
        renderResolveResourceIds,
        renderPushSizes,
        move(renderPushStorage),
        computeIndices,
        computeResourceKinds,
        computeResourceIndices,
        computeXs,
        computeYs,
        computeZs,
        computePushSizes,
        move(computePushStorage),
        oldSourceLayouts,
        oldDestinationLayouts,
        0,
        0,
        false,
        false,
        false,
        0,
        0,
        0,
        0,
        if (accepted) GraphicsError() else GraphicsError(
            if (capacity > graphicsMaximumGraphCommands)
                graphicsErrorLimitExceeded
            else graphicsErrorInvalidConfiguration,
            "GraphicsApplication.graphCommandList",
            "graph command lists require a compatible materialized graph and capacity for every pass"
        )
    )
}

trusted fun GraphicsApplication.executeGraphCommands(
    var graph: GraphicsMaterializedRenderGraph,
    var commands: GraphicsGraphCommandList
): bool {
    val ready = this.valid() && !graph.executing &&
        commands.graphCompatible(graph) && commands.sealed &&
        commands.prepared && commands.sealedFingerprint != 0 &&
        commands.sealedFingerprint == commands.fingerprint() &&
        commands.executions < graphicsMaximumInt &&
        commands.failedExecutions < graphicsMaximumInt &&
        commands.vulkanSubmissions < graphicsMaximumInt
    var succeeded = false
    if (ready && commands.consolidatedVulkan) {
        succeeded = this.executeConsolidatedVulkanGraphCommands(
            graph,
            commands
        )
    } else if (ready) {
        succeeded = this.executeDirectGraphCommands(graph, commands)
    }
    if (succeeded) commands.executions = commands.executions + 1
    else if (commands.failedExecutions >= 0 &&
        commands.failedExecutions < graphicsMaximumInt) {
        commands.failedExecutions = commands.failedExecutions + 1
    }
    succeeded
}

trusted fun GraphicsApplication.executeRecordedGraphRender(
    var graph: GraphicsMaterializedRenderGraph,
    token: int,
    resourceId: int,
    var target: GraphicsRenderTarget,
    pipeline: GraphicsRenderPipeline,
    resources: GraphicsGraphRenderResources,
    depthResourceId: int,
    resolveResourceId: int,
    pushConstantData: i64*,
    pushConstantSize: int,
    red: f64,
    green: f64,
    blue: f64,
    alpha: f64
): bool {
    val passId = if (graph.currentPassPosition >= 0 &&
        graph.currentPassPosition < graph.plan.order.size)
        graph.plan.order[graph.currentPassPosition] else -1
    var active = graph.resourceActive(token, resourceId) &&
        (depthResourceId < 0 ||
         graph.resourceActive(token, depthResourceId)) &&
        (resolveResourceId < 0 ||
         graph.resourceActive(token, resolveResourceId))
    var bufferIndex = 0
    while (active && bufferIndex < resources.resourceIds.size) {
        active = graph.resourceActive(
            token,
            resources.resourceIds[bufferIndex]
        ) && this.ownsBuffer(resources.buffers[bufferIndex])
        bufferIndex = bufferIndex + 1
    }
    val resourcesValid = if (resources.form ==
        graphicsGraphRenderProcedural)
        graphicsGraphRecordedRenderValid(
            graph,
            passId,
            resourceId,
            target,
            pipeline,
            this.backend,
            pushConstantSize,
            depthResourceId,
            resolveResourceId
        )
    else graphicsGraphRecordedBufferedRenderValid(
        graph,
        passId,
        resourceId,
        target,
        pipeline,
        resources,
        this.backend,
        pushConstantSize,
        depthResourceId,
        resolveResourceId
    )
    var succeeded = this.valid() && active && passId >= 0 &&
        graphicsColorScalarsValid(red, green, blue, alpha) && resourcesValid
    val buffered = resources.form != graphicsGraphRenderProcedural
    val indexed = resources.form == graphicsGraphRenderIndexed ||
        resources.form == graphicsGraphRenderIndexedIndirect
    val indirect = resources.form == graphicsGraphRenderVerticesIndirect ||
        resources.form == graphicsGraphRenderIndexedIndirect
    val indirectIndex = if (indexed) 2 else 1
    if (succeeded && buffered && this.backend == graphicsBackendOpenGl) {
        succeeded = pipeline.targetHandle == target.openGl.handle &&
            this.openGl.renderProgramTarget(
                target.openGl,
                pipeline.openGl,
                red,
                green,
                blue,
                alpha,
                pipeline.raster,
                pipeline.depth,
                pipeline.vertexLayout,
                resources.buffers[0].openGl.handle,
                resources.vertexCount,
                if (indexed) resources.buffers[1].openGl.handle else 0,
                resources.indexCount,
                resources.instanceCount,
                pipeline.binding.openGlKinds,
                pipeline.binding.openGlBindings,
                pipeline.binding.openGlResources,
                pipeline.binding.openGlOffsets,
                pipeline.binding.openGlSizes,
                pipeline.binding.openGlSamplers,
                if (indirect)
                    resources.buffers[indirectIndex].openGl.handle else 0,
                resources.form == graphicsGraphRenderIndexedIndirect,
                nativeNullPointer(),
                -1,
                0,
                0,
                pushConstantData,
                pushConstantSize,
                resources.vertexOffset,
                resources.indexOffset,
                resources.indirectOffset
            )
    } else if (succeeded && buffered &&
        this.backend == graphicsBackendVulkan) {
        succeeded = pipeline.targetHandle == target.vulkan.framebuffer &&
            this.vulkanDevice.renderTargetProgram(
                target.vulkan,
                pipeline.vulkan,
                red,
                green,
                blue,
                alpha,
                resources.buffers[0].vulkan.handle,
                resources.vertexCount,
                if (indexed) resources.buffers[1].vulkan.handle else 0,
                resources.indexCount,
                resources.instanceCount,
                pipeline.binding.vulkan.descriptorSet,
                if (indirect)
                    resources.buffers[indirectIndex].vulkan.handle else 0,
                resources.form == graphicsGraphRenderIndexedIndirect,
                nativeNullPointer(),
                0,
                pushConstantData,
                pushConstantSize,
                resources.vertexOffset,
                resources.indexOffset,
                resources.indirectOffset
            )
    } else if (succeeded && resources.form ==
        graphicsGraphRenderProcedural &&
        this.backend == graphicsBackendOpenGl) {
        succeeded = this.openGl.renderProgramTarget(
            target.openGl,
            pipeline.openGl,
            red,
            green,
            blue,
            alpha,
            pipeline.raster,
            pipeline.depth,
            pipeline.vertexLayout,
            0,
            3,
            0,
            0,
            1,
            pipeline.binding.openGlKinds,
            pipeline.binding.openGlBindings,
            pipeline.binding.openGlResources,
            pipeline.binding.openGlOffsets,
            pipeline.binding.openGlSizes,
            pipeline.binding.openGlSamplers,
            0,
            false,
            nativeNullPointer(),
            -1,
            0,
            0,
            pushConstantData,
            pushConstantSize
        )
    } else if (succeeded && resources.form ==
        graphicsGraphRenderProcedural &&
        this.backend == graphicsBackendVulkan) {
        succeeded = this.vulkanDevice.renderTargetProgram(
            target.vulkan,
            pipeline.vulkan,
            red,
            green,
            blue,
            alpha,
            descriptorSet = pipeline.binding.vulkan.descriptorSet,
            pushConstantData = pushConstantData,
            pushConstantSize = pushConstantSize
        )
    } else if (succeeded) succeeded = false
    if (succeeded) succeeded = this.finishRenderTarget(target)
    succeeded
}

trusted fun GraphicsApplication.recordVulkanGraphRender(
    var graph: GraphicsMaterializedRenderGraph,
    token: int,
    resourceId: int,
    target: GraphicsRenderTarget,
    pipeline: GraphicsRenderPipeline,
    resources: GraphicsGraphRenderResources,
    depthResourceId: int,
    resolveResourceId: int,
    pushConstantData: i64*,
    pushConstantSize: int,
    red: f64,
    green: f64,
    blue: f64,
    alpha: f64
): bool {
    val passId = if (graph.currentPassPosition >= 0 &&
        graph.currentPassPosition < graph.plan.order.size)
        graph.plan.order[graph.currentPassPosition] else -1
    var active = graph.resourceActive(token, resourceId) &&
        (depthResourceId < 0 ||
         graph.resourceActive(token, depthResourceId)) &&
        (resolveResourceId < 0 ||
         graph.resourceActive(token, resolveResourceId))
    var bufferIndex = 0
    while (active && bufferIndex < resources.resourceIds.size) {
        active = graph.resourceActive(
            token,
            resources.resourceIds[bufferIndex]
        ) && this.ownsBuffer(resources.buffers[bufferIndex])
        bufferIndex = bufferIndex + 1
    }
    val resourcesValid = if (resources.form ==
        graphicsGraphRenderProcedural)
        graphicsGraphRecordedRenderValid(
            graph,
            passId,
            resourceId,
            target,
            pipeline,
            this.backend,
            pushConstantSize,
            depthResourceId,
            resolveResourceId
        )
    else graphicsGraphRecordedBufferedRenderValid(
        graph,
        passId,
        resourceId,
        target,
        pipeline,
        resources,
        this.backend,
        pushConstantSize,
        depthResourceId,
        resolveResourceId
    )
    val vertexBuffer = if (resources.buffers.size >= 1)
        resources.buffers[0].vulkan.handle else 0
    val indexed = resources.form == graphicsGraphRenderIndexed ||
        resources.form == graphicsGraphRenderIndexedIndirect
    val indirect = resources.form == graphicsGraphRenderVerticesIndirect ||
        resources.form == graphicsGraphRenderIndexedIndirect
    val indexBuffer = if (indexed &&
        resources.buffers.size >= 2)
        resources.buffers[1].vulkan.handle else 0
    val indirectIndex = if (indexed) 2 else 1
    val indirectBuffer = if (indirect && resources.buffers.size > indirectIndex)
        resources.buffers[indirectIndex].vulkan.handle else 0
    return this.backend == graphicsBackendVulkan && active && passId >= 0 &&
        graphicsColorScalarsValid(red, green, blue, alpha) && resourcesValid &&
        this.vulkanDevice.recordRenderTargetProgram(
            target.vulkan,
            pipeline.vulkan,
            red,
            green,
            blue,
            alpha,
            vertexBuffer = vertexBuffer,
            vertexCount = resources.vertexCount,
            indexBuffer = indexBuffer,
            indexCount = resources.indexCount,
            instanceCount = resources.instanceCount,
            descriptorSet = pipeline.binding.vulkan.descriptorSet,
            indirectBuffer = indirectBuffer,
            indexedIndirect = resources.form ==
                graphicsGraphRenderIndexedIndirect,
            pushConstantData = pushConstantData,
            pushConstantSize = pushConstantSize,
            vertexOffset = resources.vertexOffset,
            indexOffset = resources.indexOffset,
            indirectOffset = resources.indirectOffset
        )
}

trusted fun GraphicsApplication.executeRecordedGraphCompute(
    var graph: GraphicsMaterializedRenderGraph,
    token: int,
    resourceIds: array<int>,
    buffers: array<GraphicsBuffer>,
    var pipeline: GraphicsComputePipeline,
    x: int,
    y: int,
    z: int,
    pushConstantData: i64*,
    pushConstantSize: int
): bool {
    val passId = if (graph.currentPassPosition >= 0 &&
        graph.currentPassPosition < graph.plan.order.size)
        graph.plan.order[graph.currentPassPosition] else -1
    var resourcesActive = resourceIds.size == buffers.size
    var resourceIndex = 0
    while (resourcesActive && resourceIndex < resourceIds.size) {
        resourcesActive = graph.resourceActive(
            token,
            resourceIds[resourceIndex]
        )
        resourceIndex = resourceIndex + 1
    }
    val resourcesValid = resourcesActive && passId >= 0 &&
        graphicsGraphRecordedComputeValid(
            graph,
            passId,
            resourceIds,
            buffers,
            pipeline,
            this.backend,
            x,
            y,
            z,
            pushConstantSize
        )
    return this.valid() && resourcesValid && pipeline.dispatchRaw(
        x,
        y,
        z,
        pushConstantData,
        pushConstantSize
    )
}

trusted fun GraphicsApplication.recordVulkanGraphCompute(
    var graph: GraphicsMaterializedRenderGraph,
    token: int,
    resourceIds: array<int>,
    buffers: array<GraphicsBuffer>,
    var pipeline: GraphicsComputePipeline,
    x: int,
    y: int,
    z: int,
    pushConstantData: i64*,
    pushConstantSize: int
): bool {
    val passId = if (graph.currentPassPosition >= 0 &&
        graph.currentPassPosition < graph.plan.order.size)
        graph.plan.order[graph.currentPassPosition] else -1
    var resourcesActive = resourceIds.size == buffers.size
    var resourceIndex = 0
    while (resourcesActive && resourceIndex < resourceIds.size) {
        resourcesActive = graph.resourceActive(
            token,
            resourceIds[resourceIndex]
        )
        resourceIndex = resourceIndex + 1
    }
    val resourcesValid = resourcesActive && passId >= 0 &&
        graphicsGraphRecordedComputeValid(
            graph,
            passId,
            resourceIds,
            buffers,
            pipeline,
            this.backend,
            x,
            y,
            z,
            pushConstantSize
        )
    return this.valid() && this.backend == graphicsBackendVulkan &&
    resourcesValid && pipeline.vulkan.recordDispatch(
        this.vulkanDevice.transferCommand.load(),
        x,
        y,
        z,
        pushConstantData,
        pushConstantSize,
        pipeline.binding.vulkan.descriptorSet
    )
}

trusted fun GraphicsApplication.executeRecordedTransientGraphCompute(
    var graph: GraphicsMaterializedRenderGraph,
    token: int,
    resourceIds: array<int>,
    var pipeline: GraphicsComputePipeline,
    x: int,
    y: int,
    z: int,
    pushConstantData: i64*,
    pushConstantSize: int
): bool {
    val passId = if (graph.currentPassPosition >= 0 &&
        graph.currentPassPosition < graph.plan.order.size)
        graph.plan.order[graph.currentPassPosition] else -1
    var resourcesActive = resourceIds.size >= 1
    var index = 0
    while (resourcesActive && index < resourceIds.size) {
        resourcesActive = graph.resourceActive(token, resourceIds[index])
        index = index + 1
    }
    return this.valid() && resourcesActive && passId >= 0 &&
        graphicsGraphRecordedTransientComputeValid(
            graph,
            passId,
            resourceIds,
            pipeline,
            this.backend,
            x,
            y,
            z,
            pushConstantSize
        ) && pipeline.dispatchRaw(
            x,
            y,
            z,
            pushConstantData,
            pushConstantSize
        )
}

trusted fun GraphicsApplication.recordVulkanTransientGraphCompute(
    var graph: GraphicsMaterializedRenderGraph,
    token: int,
    resourceIds: array<int>,
    var pipeline: GraphicsComputePipeline,
    x: int,
    y: int,
    z: int,
    pushConstantData: i64*,
    pushConstantSize: int
): bool {
    val passId = if (graph.currentPassPosition >= 0 &&
        graph.currentPassPosition < graph.plan.order.size)
        graph.plan.order[graph.currentPassPosition] else -1
    var resourcesActive = resourceIds.size >= 1
    var index = 0
    while (resourcesActive && index < resourceIds.size) {
        resourcesActive = graph.resourceActive(token, resourceIds[index])
        index = index + 1
    }
    return this.valid() && this.backend == graphicsBackendVulkan &&
        resourcesActive && passId >= 0 &&
        graphicsGraphRecordedTransientComputeValid(
            graph,
            passId,
            resourceIds,
            pipeline,
            this.backend,
            x,
            y,
            z,
            pushConstantSize
        ) && pipeline.vulkan.recordDispatch(
            this.vulkanDevice.transferCommand.load(),
            x,
            y,
            z,
            pushConstantData,
            pushConstantSize,
            pipeline.binding.vulkan.descriptorSet
        )
}

trusted fun GraphicsApplication.executeDirectGraphCommands(
    var graph: GraphicsMaterializedRenderGraph,
    var commands: GraphicsGraphCommandList
): bool {
    val requiredSubmissions = commands.directVulkanSubmissionCount(graph)
    var succeeded = requiredSubmissions >= 0 &&
        commands.vulkanSubmissions <=
            graphicsMaximumInt - requiredSubmissions
    val token = if (succeeded) graph.beginExecution() else 0
    succeeded = token > 0
    var commandIndex = 0
    while (succeeded && commandIndex < commands.commandCount) {
        val kind = commands.kinds[commandIndex]
        if (kind == graphicsGraphCommandPass) {
            val next = graph.currentPassPosition + 1
            val barrierCount = if (next >= 0 &&
                next < graph.compiledBarrierCounts.size)
                graph.compiledBarrierCounts[next] else 0
            succeeded = this.beginMaterializedRenderGraphPass(
                graph,
                token,
                commands.passIds[commandIndex]
            )
            if (this.backend == graphicsBackendVulkan && barrierCount > 0 &&
                this.vulkanDevice.transferSubmissionAccepted) {
                commands.vulkanSubmissions = commands.vulkanSubmissions + 1
            }
        } else if (kind == graphicsGraphCommandTextureCopy) {
            succeeded = this.copyGraphTextureRange(
                graph,
                token,
                commands.sourceResourceIds[commandIndex],
                commands.destinationResourceIds[commandIndex],
                commands.sourceMipLevels[commandIndex],
                commands.sourceXs[commandIndex],
                commands.sourceYs[commandIndex],
                commands.sourceZs[commandIndex],
                commands.destinationMipLevels[commandIndex],
                commands.destinationXs[commandIndex],
                commands.destinationYs[commandIndex],
                commands.destinationZs[commandIndex],
                commands.widths[commandIndex],
                commands.heights[commandIndex],
                commands.depths[commandIndex]
            )
            if (this.backend == graphicsBackendVulkan &&
                this.vulkanDevice.transferSubmissionAccepted) {
                commands.vulkanSubmissions = commands.vulkanSubmissions + 1
            }
        } else if (kind == graphicsGraphCommandRender) {
            val renderIndex = commands.renderIndices[commandIndex]
            val renderPushSize = commands.renderPushSizes[commandIndex]
            val renderPushData = if (renderPushSize > 0)
                commands.renderPushStorage.pointerAt(
                    commandIndex * graphicsMaximumGraphPushConstantBytes
                ) else nativeNullPointer()
            succeeded = renderIndex >= 0 &&
                renderIndex < commands.renderTargets.size &&
                renderIndex < commands.renderPipelines.size &&
                renderIndex < commands.renderResources.size &&
                this.executeRecordedGraphRender(
                    graph,
                    token,
                    commands.renderResourceIds[commandIndex],
                    commands.renderTargets[renderIndex],
                    commands.renderPipelines[renderIndex],
                    commands.renderResources[renderIndex],
                    commands.renderDepthResourceIds[renderIndex],
                    commands.renderResolveResourceIds[renderIndex],
                    renderPushData,
                    renderPushSize,
                    commands.clearReds[commandIndex],
                    commands.clearGreens[commandIndex],
                    commands.clearBlues[commandIndex],
                    commands.clearAlphas[commandIndex]
                )
            if (this.backend == graphicsBackendVulkan &&
                this.vulkanDevice.transferSubmissionAccepted) {
                commands.vulkanSubmissions = commands.vulkanSubmissions + 1
            }
        } else if (kind == graphicsGraphCommandCompute) {
            val computeIndex = commands.computeIndices[commandIndex]
            val pushSize = commands.computePushSizes[commandIndex]
            val pushData = if (pushSize > 0)
                commands.computePushStorage.pointerAt(
                    commandIndex * graphicsMaximumGraphPushConstantBytes
                ) else nativeNullPointer()
            succeeded = computeIndex >= 0 &&
                computeIndex < commands.computePipelines.size
            if (succeeded) {
                val resourceKind = commands.computeResourceKinds[computeIndex]
                val resourceIndex =
                    commands.computeResourceIndices[computeIndex]
                succeeded = if (resourceKind == 1 && resourceIndex >= 0 &&
                    resourceIndex < commands.computeResources.size)
                    this.executeRecordedGraphCompute(
                        graph,
                        token,
                        commands.computeResources[resourceIndex].resourceIds,
                        commands.computeResources[resourceIndex].buffers,
                        commands.computePipelines[computeIndex],
                        commands.computeXs[commandIndex],
                        commands.computeYs[commandIndex],
                        commands.computeZs[commandIndex],
                        pushData,
                        pushSize
                    )
                else if (resourceKind == 2 && resourceIndex >= 0 &&
                    resourceIndex <
                        commands.computeTransientResourceIds.size)
                    this.executeRecordedTransientGraphCompute(
                        graph,
                        token,
                        commands.computeTransientResourceIds[resourceIndex],
                        commands.computePipelines[computeIndex],
                        commands.computeXs[commandIndex],
                        commands.computeYs[commandIndex],
                        commands.computeZs[commandIndex],
                        pushData,
                        pushSize
                    )
                else false
            }
            if (this.backend == graphicsBackendVulkan && computeIndex >= 0 &&
                computeIndex < commands.computePipelines.size &&
                commands.computePipelines[
                    computeIndex
                ].vulkan.submissionAccepted) {
                commands.vulkanSubmissions = commands.vulkanSubmissions + 1
            }
        } else succeeded = false
        commandIndex = commandIndex + 1
    }
    if (succeeded) succeeded = graph.completeExecution(token)
    if (!succeeded && token > 0 && graph.active(token))
        graph.abortExecution(token)
    succeeded
}

trusted fun GraphicsApplication.executeConsolidatedVulkanGraphCommands(
    var graph: GraphicsMaterializedRenderGraph,
    var commands: GraphicsGraphCommandList
): bool {
    var barrierCalls = 0
    var totalBarriers = 0
    var passPosition = 0
    var countsValid = true
    while (countsValid && passPosition < graph.compiledBarrierCounts.size) {
        val count = graph.compiledBarrierCounts[passPosition]
        countsValid = count >= 0 &&
            totalBarriers <= graphicsMaximumInt - count
        if (countsValid) totalBarriers = totalBarriers + count
        if (countsValid && count > 0) {
            countsValid = barrierCalls < graphicsMaximumInt
            if (countsValid) barrierCalls = barrierCalls + 1
        }
        passPosition = passPosition + 1
    }
    var succeeded = countsValid && this.backend == graphicsBackendVulkan &&
        commands.consolidatedVulkan &&
        graph.totalExecutedBarriers <= graphicsMaximumInt - totalBarriers &&
        graph.backendBarrierCalls <= graphicsMaximumInt - barrierCalls &&
        commands.vulkanSubmissions < graphicsMaximumInt
    val token = if (succeeded) graph.beginExecution() else 0
    succeeded = token > 0 && this.vulkanDevice.beginTransfer()
    var commandIndex = 0
    while (commandIndex < commands.commandCount) {
        commands.oldSourceLayouts[commandIndex] = -1
        commands.oldDestinationLayouts[commandIndex] = -1
        commandIndex = commandIndex + 1
    }
    commandIndex = 0
    while (succeeded && commandIndex < commands.commandCount) {
        val kind = commands.kinds[commandIndex]
        if (kind == graphicsGraphCommandPass) {
            succeeded = this.recordVulkanMaterializedRenderGraphPass(
                graph,
                token,
                commands.passIds[commandIndex]
            )
        } else if (kind == graphicsGraphCommandTextureCopy) {
            val sourceResourceId =
                commands.sourceResourceIds[commandIndex]
            val destinationResourceId =
                commands.destinationResourceIds[commandIndex]
            val sourceSlot = graph.resourceSlot(sourceResourceId)
            val destinationSlot = graph.resourceSlot(destinationResourceId)
            val sourcePool = graph.texturePoolIndex(sourceResourceId)
            val destinationPool = graph.texturePoolIndex(
                destinationResourceId
            )
            val sourceDescriptor = graph.textureDescriptor(sourceResourceId)
            val destinationDescriptor =
                graph.textureDescriptor(destinationResourceId)
            val sourceTextureSlot = if (sourcePool >= 0 &&
                sourcePool < graph.slotLeases.size)
                texturePoolTokenSlot(graph.slotLeases[sourcePool]) else -1
            val destinationTextureSlot = if (destinationPool >= 0 &&
                destinationPool < graph.slotLeases.size)
                texturePoolTokenSlot(
                    graph.slotLeases[destinationPool]
                ) else -1
            succeeded = sourceSlot >= 0 && destinationSlot >= 0 &&
                sourceTextureSlot >= 0 && destinationTextureSlot >= 0 &&
                sourcePool >= 0 && sourcePool < graph.pools.size &&
                destinationPool >= 0 && destinationPool < graph.pools.size &&
                sourceTextureSlot < graph.pools[sourcePool].textures.size &&
                destinationTextureSlot <
                    graph.pools[destinationPool].textures.size
            if (succeeded) {
                commands.oldSourceLayouts[commandIndex] =
                    graph.pools[sourcePool].textures[
                        sourceTextureSlot
                    ].vulkan.loadLayout(
                        sourceDescriptor,
                        commands.sourceMipLevels[commandIndex],
                        0
                    )
                commands.oldDestinationLayouts[commandIndex] =
                    graph.pools[destinationPool].textures[
                        destinationTextureSlot
                    ].vulkan.loadLayout(
                        destinationDescriptor,
                        commands.destinationMipLevels[commandIndex],
                        0
                    )
                succeeded = commands.oldSourceLayouts[commandIndex] >= 0 &&
                    commands.oldDestinationLayouts[commandIndex] >= 0 &&
                    this.vulkanDevice.recordTextureCopyRange(
                        graph.pools[sourcePool].textures[
                            sourceTextureSlot
                        ].vulkan,
                        sourceDescriptor,
                        graph.pools[destinationPool].textures[
                            destinationTextureSlot
                        ].vulkan,
                        destinationDescriptor,
                        commands.sourceMipLevels[commandIndex],
                        commands.sourceXs[commandIndex],
                        commands.sourceYs[commandIndex],
                        0,
                        commands.destinationMipLevels[commandIndex],
                        commands.destinationXs[commandIndex],
                        commands.destinationYs[commandIndex],
                        0,
                        commands.widths[commandIndex],
                        commands.heights[commandIndex],
                        1,
                        true
                    )
            }
        } else if (kind == graphicsGraphCommandRender) {
            val renderIndex = commands.renderIndices[commandIndex]
            val renderPushSize = commands.renderPushSizes[commandIndex]
            val renderPushData = if (renderPushSize > 0)
                commands.renderPushStorage.pointerAt(
                    commandIndex * graphicsMaximumGraphPushConstantBytes
                ) else nativeNullPointer()
            succeeded = renderIndex >= 0 &&
                renderIndex < commands.renderTargets.size &&
                renderIndex < commands.renderPipelines.size &&
                renderIndex < commands.renderResources.size &&
                this.recordVulkanGraphRender(
                    graph,
                    token,
                    commands.renderResourceIds[commandIndex],
                    commands.renderTargets[renderIndex],
                    commands.renderPipelines[renderIndex],
                    commands.renderResources[renderIndex],
                    commands.renderDepthResourceIds[renderIndex],
                    commands.renderResolveResourceIds[renderIndex],
                    renderPushData,
                    renderPushSize,
                    commands.clearReds[commandIndex],
                    commands.clearGreens[commandIndex],
                    commands.clearBlues[commandIndex],
                    commands.clearAlphas[commandIndex]
                )
        } else if (kind == graphicsGraphCommandCompute) {
            val computeIndex = commands.computeIndices[commandIndex]
            val pushSize = commands.computePushSizes[commandIndex]
            val pushData = if (pushSize > 0)
                commands.computePushStorage.pointerAt(
                    commandIndex * graphicsMaximumGraphPushConstantBytes
                ) else nativeNullPointer()
            succeeded = computeIndex >= 0 &&
                computeIndex < commands.computePipelines.size
            if (succeeded) {
                val resourceKind = commands.computeResourceKinds[computeIndex]
                val resourceIndex =
                    commands.computeResourceIndices[computeIndex]
                succeeded = if (resourceKind == 1 && resourceIndex >= 0 &&
                    resourceIndex < commands.computeResources.size)
                    this.recordVulkanGraphCompute(
                        graph,
                        token,
                        commands.computeResources[resourceIndex].resourceIds,
                        commands.computeResources[resourceIndex].buffers,
                        commands.computePipelines[computeIndex],
                        commands.computeXs[commandIndex],
                        commands.computeYs[commandIndex],
                        commands.computeZs[commandIndex],
                        pushData,
                        pushSize
                    )
                else if (resourceKind == 2 && resourceIndex >= 0 &&
                    resourceIndex <
                        commands.computeTransientResourceIds.size)
                    this.recordVulkanTransientGraphCompute(
                        graph,
                        token,
                        commands.computeTransientResourceIds[resourceIndex],
                        commands.computePipelines[computeIndex],
                        commands.computeXs[commandIndex],
                        commands.computeYs[commandIndex],
                        commands.computeZs[commandIndex],
                        pushData,
                        pushSize
                    )
                else false
            }
        } else succeeded = false
        commandIndex = commandIndex + 1
    }
    var submitted = false
    if (succeeded) {
        succeeded = this.vulkanDevice.submitTransfer()
        submitted = this.vulkanDevice.transferSubmissionAccepted
    }
    if (submitted) {
        graph.totalExecutedBarriers =
            graph.totalExecutedBarriers + totalBarriers
        graph.backendBarrierCalls = graph.backendBarrierCalls + barrierCalls
        commands.vulkanSubmissions = commands.vulkanSubmissions + 1
        commandIndex = 0
        while (commandIndex < commands.commandCount) {
            if (commands.kinds[commandIndex] ==
                graphicsGraphCommandRender) {
                commands.renderTargets[
                    commands.renderIndices[commandIndex]
                ].storeVulkanLayouts()
            }
            commandIndex = commandIndex + 1
        }
        if (succeeded) succeeded = graph.completeExecution(token)
    }
    if (!submitted) {
        commandIndex = commands.commandCount - 1
        while (commandIndex >= 0) {
            if (commands.kinds[commandIndex] ==
                graphicsGraphCommandTextureCopy &&
                commands.oldSourceLayouts[commandIndex] >= 0 &&
                commands.oldDestinationLayouts[commandIndex] >= 0) {
                val sourceResourceId =
                    commands.sourceResourceIds[commandIndex]
                val destinationResourceId =
                    commands.destinationResourceIds[commandIndex]
                val sourceSlot = graph.resourceSlot(sourceResourceId)
                val destinationSlot =
                    graph.resourceSlot(destinationResourceId)
                val sourcePool = graph.texturePoolIndex(sourceResourceId)
                val destinationPool = graph.texturePoolIndex(
                    destinationResourceId
                )
                val sourceTextureSlot = texturePoolTokenSlot(
                    graph.slotLeases[sourcePool]
                )
                val destinationTextureSlot = texturePoolTokenSlot(
                    graph.slotLeases[destinationPool]
                )
                graph.pools[sourcePool].textures[
                    sourceTextureSlot
                ].vulkan.storeSubresourceLayout(
                    graph.textureDescriptor(sourceResourceId),
                    commands.sourceMipLevels[commandIndex],
                    0,
                    commands.oldSourceLayouts[commandIndex]
                )
                graph.pools[destinationPool].textures[
                    destinationTextureSlot
                ].vulkan.storeSubresourceLayout(
                    graph.textureDescriptor(destinationResourceId),
                    commands.destinationMipLevels[commandIndex],
                    0,
                    commands.oldDestinationLayouts[commandIndex]
                )
            }
            commandIndex = commandIndex - 1
        }
    }
    if (!succeeded && token > 0 && graph.active(token))
        graph.abortExecution(token)
    succeeded
}
