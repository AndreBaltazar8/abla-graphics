// Render-binding adapters for retained glTF resources.

import "binding.ab"
import "gltf_texture.ab"

trusted fun GraphicsApplication.gltfMaterialTextureEntries(
    table: GltfGpuMaterialTextureTable
): array<GraphicsBindingEntry> {
    val entries: array<GraphicsBindingEntry> = []
    var binding = 0
    var valid = this.valid() && table.valid()
    while (valid && binding < table.slots.size) {
        val slot = table.slots[binding]
        val entry = this.sampledTextureEntry(
            binding,
            shaderVisibilityFragment,
            table.values[slot].texture,
            table.values[slot].sampler
        )
        valid = entry.valid()
        if (valid) entries.append(entry)
        binding = binding + 1
    }
    if (valid) return entries
    []
}
