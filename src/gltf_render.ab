// Render-binding adapters for retained glTF resources.

import "binding.ab"
import "gltf_texture.ab"
import "render.ab"

trusted fun GraphicsApplication.gltfGpuMaterialTextureBatch(
    document: GltfDocument,
    buffers: GltfBufferPayloads,
    plan: GltfMaterialBatchPlan,
    batch: int,
    suppliedImages: array<string> = []
): GltfGpuMaterialTextureTable = this.gltfGpuMaterialTextureTable(
    document,
    buffers,
    plan.batchMaterials(batch),
    suppliedImages
)

trusted fun GraphicsApplication.gltfMaterialTextureEntries(
    table: GltfGpuMaterialTextureTable
): array<GraphicsBindingEntry> {
    val entries: array<GraphicsBindingEntry> = []
    var binding = 0
    var valid = this.valid() && table.valid()
    while (valid && binding < table.slots.size) {
        val slot = table.slots[binding]
        val entry = this.sampledTextureEntry(
            binding,
            shaderVisibilityFragment,
            table.values[slot].texture,
            table.values[slot].sampler
        )
        valid = entry.valid()
        if (valid) entries.append(entry)
        binding = binding + 1
    }
    if (valid) return entries
    []
}

// Submits every planned group in drawable order. The first pass must clear the
// target and following passes must load it, so opaque and transparent order is
// preserved across descriptor/pipeline changes.
trusted fun GraphicsApplication.renderGltfMaterialBatchesToTarget(
    var target: GraphicsRenderTarget,
    plan: GltfMaterialBatchPlan,
    pipelines: array<GraphicsRenderPipeline>,
    batches: array<GraphicsPushConstantBatch>,
    passes: array<GraphicsRenderPass>,
    vertices: GraphicsBuffer,
    indices: GraphicsBuffer,
    indexCount: int
): bool {
    var valid = this.valid() && plan.valid && plan.batchCount() > 0 &&
        pipelines.size == plan.batchCount() &&
        batches.size == plan.batchCount() &&
        passes.size == plan.batchCount() &&
        (passes[0].clearMask & 1) != 0
    var batch = 0
    while (valid && batch < plan.batchCount()) {
        valid = batches[batch].drawCount ==
            plan.batchDrawableCounts[batch] &&
            passes[batch].discardAfterMask == 0 &&
            (batch == 0 || (passes[batch].clearMask == 0 &&
             passes[batch].discardBeforeMask == 0)) &&
            this.renderPushBatchPassIndexedToTarget(
                target,
                pipelines[batch],
                batches[batch],
                passes[batch],
                vertices,
                indices,
                indexCount
            )
        batch = batch + 1
    }
    valid
}
