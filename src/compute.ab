// Affine backend-neutral compute pipeline and dispatch.

import "abla/unsafe/memory"
import "core.ab"
import "application.ab"
import "shader/glsl.ab"
import "shader/glsl_spirv.ab"
import "driver/opengl.ab"
import "driver/vulkan.ab"

resource class GraphicsComputePipeline(
    val openGl: OpenGlComputePipeline,
    val vulkan: VulkanComputePipeline,
    val backend: int,
    val limits: GraphicsLimits,
    val error: GraphicsError
) {
    fun valid(): bool = !this.error.occurred() && this.limits.valid() &&
        ((this.backend == graphicsBackendOpenGl && this.openGl.valid()) ||
         (this.backend == graphicsBackendVulkan && this.vulkan.valid()))

    trusted fun dispatch(x: int, y: int = 1, z: int = 1): bool {
        if (x < 1 || y < 1 || z < 1 ||
            x > this.limits.maximumComputeWorkgroupsX ||
            y > this.limits.maximumComputeWorkgroupsY ||
            z > this.limits.maximumComputeWorkgroupsZ) false
        else if (this.backend == graphicsBackendOpenGl) {
            this.openGl.dispatch(x, y, z)
        } else if (this.backend == graphicsBackendVulkan) {
            this.vulkan.dispatch(x, y, z)
        } else false
    }

    trusted fun drop(): void {
        this.openGl.drop()
        this.vulkan.drop()
        return
    }
}

fun graphicsComputeWorkgroupSupported(
    shader: ShaderPackage,
    limits: GraphicsLimits
): bool {
    var supported = shader.workgroups.size == 1
    if (supported) {
        val workgroup = shader.workgroups[0]
        val xy = graphicsCheckedSizeProduct(workgroup.x, workgroup.y)
        val xyz = if (xy.succeeded)
            graphicsCheckedSizeProduct(xy.value, workgroup.z)
        else GraphicsIntResult(false)
        supported = workgroup.x <= limits.maximumComputeWorkgroupSizeX &&
            workgroup.y <= limits.maximumComputeWorkgroupSizeY &&
            workgroup.z <= limits.maximumComputeWorkgroupSizeZ &&
            xyz.succeeded && xyz.value <= limits.maximumComputeInvocations
    }
    supported
}

trusted fun GraphicsApplication.computePipeline(
    shader: ShaderPackage
): GraphicsComputePipeline {
    var openGl = OpenGlComputePipeline(
        0,
        nativeNullPointer(),
        nativeNullPointer(),
        nativeNullPointer(),
        0,
        ""
    )
    var vulkan = VulkanComputePipeline(
        nativeNullPointer(),
        nativeNullPointer(),
        -1,
        0,
        0,
        0,
        nativePointerCell(nativeNullPointer()),
        nativeByteBuffer(0),
        0,
        0,
        0
    )
    var error = GraphicsError()
    val translatable = glslPackage(
        [shaderStageCompute],
        [shader.source(shaderStageCompute)]
    )
    val emitted = translatable.spirv(shaderStageCompute)
    if (!this.valid() || !shader.valid) {
        error = GraphicsError(
            graphicsErrorInvalidConfiguration,
            "GraphicsApplication.computePipeline",
            if (shader.error != "") shader.error else
                "the application or shader package is invalid"
        )
    } else if (!this.capabilities.supports(graphicsFeatureCompute)) {
        error = GraphicsError(
            graphicsErrorUnsupportedFeature,
            "GraphicsApplication.computePipeline",
            "compute is unavailable on the selected device"
        )
    } else if (!emitted.succeeded) {
        error = GraphicsError(
            graphicsErrorUnsupportedFeature,
            "ShaderPackage.spirv",
            emitted.error
        )
    } else if (!graphicsComputeWorkgroupSupported(
            shader,
            this.capabilities.limits
        )) {
        error = GraphicsError(
            graphicsErrorLimitExceeded,
            "GraphicsApplication.computePipeline.workgroup",
            "compute workgroup dimensions exceed the selected device limits"
        )
    } else if (this.backend == graphicsBackendOpenGl) {
        openGl = this.openGl.computePipeline(shader)
        if (!openGl.valid()) error = GraphicsError(
            graphicsErrorDriverFailure,
            "OpenGlWindowContext.computePipeline",
            openGl.error
        )
    } else if (this.backend == graphicsBackendVulkan) {
        val module = this.vulkanDevice.shaderModule(emitted.module)
        if (module.valid()) {
            vulkan = this.vulkanDevice.computePipeline(module)
        }
        if (!vulkan.valid()) error = GraphicsError(
            graphicsErrorDriverFailure,
            "VulkanDevice.computePipeline",
            "Vulkan compute pipeline creation failed"
        )
    }
    GraphicsComputePipeline(
        move(openGl),
        move(vulkan),
        this.backend,
        this.capabilities.limits,
        error
    )
}

trusted fun GraphicsApplication.computeStoragePipeline(
    shader: ShaderPackage,
    storage: GraphicsBuffer
): GraphicsComputePipeline {
    var openGl = OpenGlComputePipeline(
        0,
        nativeNullPointer(),
        nativeNullPointer(),
        nativeNullPointer(),
        0,
        ""
    )
    var vulkan = VulkanComputePipeline(
        nativeNullPointer(), nativeNullPointer(), -1, 0, 0, 0,
        nativePointerCell(nativeNullPointer()), nativeByteBuffer(0), 0, 0, 0
    )
    var error = GraphicsError()
    val translatable = glslPackage(
        [shaderStageCompute],
        [shader.source(shaderStageCompute)]
    )
    val emitted = translatable.spirv(shaderStageCompute)
    val bindingValid = shader.bindings.size == 1 &&
        shader.bindings[0].set == 0 && shader.bindings[0].binding == 0 &&
        shader.bindings[0].storage == "buffer"
    if (!this.valid() || !shader.valid || !storage.valid() ||
        storage.backend != this.backend || !bindingValid) {
        error = GraphicsError(
            graphicsErrorInvalidConfiguration,
            "GraphicsApplication.computeStoragePipeline",
            "compute storage requires one valid binding-zero buffer on the selected backend"
        )
    } else if (!this.capabilities.supports(
            graphicsFeatureCompute | graphicsFeatureStorageBuffers
        )) {
        error = GraphicsError(
            graphicsErrorUnsupportedFeature,
            "GraphicsApplication.computeStoragePipeline",
            "compute storage is unavailable on the selected device"
        )
    } else if (!emitted.succeeded) {
        error = GraphicsError(
            graphicsErrorUnsupportedFeature,
            "ShaderPackage.spirv",
            emitted.error
        )
    } else if (!graphicsComputeWorkgroupSupported(
            shader,
            this.capabilities.limits
        )) {
        error = GraphicsError(
            graphicsErrorLimitExceeded,
            "GraphicsApplication.computeStoragePipeline.workgroup",
            "compute workgroup dimensions exceed the selected device limits"
        )
    } else if (this.backend == graphicsBackendOpenGl) {
        openGl = this.openGl.computePipeline(shader, storage.openGl.handle)
        if (!openGl.valid()) error = GraphicsError(
            graphicsErrorDriverFailure,
            "OpenGlWindowContext.computePipeline",
            openGl.error
        )
    } else if (this.backend == graphicsBackendVulkan) {
        val module = this.vulkanDevice.shaderModule(emitted.module)
        if (module.valid()) vulkan =
            this.vulkanDevice.computeStoragePipeline(module, storage.vulkan)
        if (!vulkan.valid()) error = GraphicsError(
            graphicsErrorDriverFailure,
            "VulkanDevice.computeStoragePipeline",
            "Vulkan storage compute pipeline creation failed"
        )
    }
    GraphicsComputePipeline(
        move(openGl),
        move(vulkan),
        this.backend,
        this.capabilities.limits,
        error
    )
}
