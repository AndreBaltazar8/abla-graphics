import "abla/io"
import "abla/process/arguments"
import "abla/runtime/memory"
import "../../src/graphics.ab"

trusted fun bufferPoolProbe(requestedBackend: int): bool {
    val app = graphicsApplication(
        GraphicsConfig(
            backend = requestedBackend,
            requiredFeatures = graphicsFeaturePersistentMapping
        ),
        WindowConfig(
            title = "Abla device buffer pool",
            width = 96,
            height = 64
        )
    )
    val pool = app.bufferPool(BufferPoolDescriptor(
        label = "test-device-pool",
        capacity = 128,
        blockSize = 16,
        maximumAllocations = 4,
        usage = bufferUsageCopySource | bufferUsageCopyDestination
    ))
    val descriptorsRejectInvalid = !BufferPoolDescriptor(
        capacity = 127,
        blockSize = 16
    ).valid() && !BufferPoolDescriptor(
        capacity = 128,
        blockSize = 16,
        maximumAllocations = 0
    ).valid() && !BufferPoolDescriptor(
        capacity = 128,
        blockSize = 16,
        usage = bufferUsageCopyDestination
    ).valid()
    val backingHandle = if (app.backend == graphicsBackendOpenGl)
        pool.backing.openGl.handle
    else pool.backing.vulkan.handle

    val first = pool.allocate(24)
    val released = pool.allocate(16)
    val aligned = pool.allocate(24, 64)
    val layoutExact = pool.allocationOffset(first) == 0 &&
        pool.allocationSize(first) == 24 &&
        pool.allocationOffset(released) == 32 &&
        pool.allocationOffset(aligned) == 64
    val releaseAccepted = pool.release(released)
    val replacement = pool.allocate(16)
    val reuseExact = bufferPoolTokenSlot(replacement) ==
        bufferPoolTokenSlot(released) &&
        bufferPoolTokenGeneration(replacement) ==
            bufferPoolTokenGeneration(released) + 1 &&
        pool.allocationOffset(replacement) == 32 &&
        !pool.allocationValid(released) && !pool.release(released)
    val countersBeforeInvalid = pool.allocationCount
    val invalid = pool.allocate(96)
    val invalidRejected = !bufferPoolTokenValid(invalid) &&
        pool.allocationCount == countersBeforeInvalid &&
        pool.activeAllocations == 3 && pool.usedBytes == 80 &&
        pool.availableBytes() == 48

    val source = bufferBytes(32)
    val firstValue = 1234605616436508552
    val replacementValue = 72623859790382856
    val alignedValue = 1161981756646125696
    val sourceReady = source.fill(0) &&
        source.storeI64(firstValue, 0) &&
        source.storeI64(replacementValue, 8) &&
        source.storeI64(alignedValue, 16)
    val directReadback = bufferBytes(8)
    val directCpuAccessRejected = !pool.backing.writeBytes(
        source,
        BufferCopyDescriptor(0, 0, 8)
    ) && !pool.backing.readBytes(
        directReadback,
        BufferCopyDescriptor(0, 0, 8)
    )
    val uploads = app.bufferTransferQueue(BufferTransferQueueDescriptor(
        label = "pool-uploads",
        direction = bufferTransferDirectionUpload,
        slotCapacity = 8,
        slotCount = 3,
        alignment = 8
    ))
    val upload0 = app.enqueueUploadBufferPoolRange(
        uploads, source, pool, first, 0, 4, 8
    )
    val upload1 = app.enqueueUploadBufferPoolRange(
        uploads, source, pool, replacement, 8, 0, 8
    )
    val upload2 = app.enqueueUploadBufferPoolRange(
        uploads, source, pool, aligned, 16, 8, 8
    )
    val uploadsCompleted = bufferTransferTicketValid(upload0) &&
        bufferTransferTicketValid(upload1) &&
        bufferTransferTicketValid(upload2) && uploads.wait(upload0) &&
        uploads.wait(upload1) && uploads.wait(upload2)
    val queuedBeforeBadRange = uploads.queuedCount
    val badRange = app.enqueueUploadBufferPoolRange(
        uploads, source, pool, replacement, 0, 12, 8
    )
    val badRangeRejected = !bufferTransferTicketValid(badRange) &&
        uploads.queuedCount == queuedBeforeBadRange

    val downloads = app.bufferTransferQueue(BufferTransferQueueDescriptor(
        label = "pool-readbacks",
        direction = bufferTransferDirectionReadback,
        slotCapacity = 8,
        slotCount = 3,
        alignment = 8
    ))
    val download0 = app.enqueueReadbackBufferPoolRange(
        downloads, pool, first, 4, 8
    )
    val download1 = app.enqueueReadbackBufferPoolRange(
        downloads, pool, replacement, 0, 8
    )
    val download2 = app.enqueueReadbackBufferPoolRange(
        downloads, pool, aligned, 8, 8
    )
    val result = bufferBytes(24)
    val readbacksCompleted = result.fill(0) && app.waitReadback(
        downloads, download0, result, 0
    ) && app.waitReadback(
        downloads, download1, result, 8
    ) && app.waitReadback(
        downloads, download2, result, 16
    )
    val exact = result.loadI64(0) == firstValue &&
        result.loadI64(8) == replacementValue &&
        result.loadI64(16) == alignedValue

    val uniformAlignment =
        app.capabilities.limits.minimumUniformBufferOffsetAlignment
    val storageAlignment =
        app.capabilities.limits.minimumStorageBufferOffsetAlignment
    val bindingAlignment = if (uniformAlignment > storageAlignment)
        uniformAlignment
    else storageAlignment
    val bindingPool = app.bufferPool(BufferPoolDescriptor(
        label = "test-binding-pool",
        capacity = 4096,
        blockSize = 16,
        maximumAllocations = 4,
        usage = bufferUsageCopySource | bufferUsageCopyDestination |
            bufferUsageUniform | bufferUsageStorage
    ))
    val bindingPrefix = bindingPool.allocate(16)
    val bindingSlice = bindingPool.allocate(64, bindingAlignment)
    val uniformEntry = app.uniformBufferPoolEntry(
        0,
        shaderVisibilityVertex,
        bindingPool,
        bindingSlice,
        0,
        32
    )
    val storageEntry = app.storageBufferPoolEntry(
        1,
        shaderVisibilityFragment,
        bindingPool,
        bindingSlice,
        0,
        32
    )
    val binding = app.bindGroup([uniformEntry, storageEntry])
    val nativeRangeApplied = if (app.backend == graphicsBackendOpenGl)
        openGlApplyBindGroup(
            binding.openGlKinds,
            binding.openGlBindings,
            binding.openGlResources,
            binding.openGlOffsets,
            binding.openGlSizes,
            binding.openGlSamplers
        )
    else binding.vulkan.valid()
    val misaligned = app.uniformBufferRangeEntry(
        2,
        shaderVisibilityVertex,
        bindingPool.backing,
        bindingPool.allocationOffset(bindingSlice) + 1,
        16
    )
    val rangesExact = uniformAlignment > 0 && storageAlignment > 0 &&
        bindingPool.allocationOffset(bindingPrefix) == 0 &&
        bindingPool.allocationOffset(bindingSlice) == bindingAlignment &&
        uniformEntry.valid() && storageEntry.valid() && binding.valid() &&
        uniformEntry.offset == bindingAlignment && uniformEntry.size == 32 &&
        storageEntry.offset == bindingAlignment && storageEntry.size == 32 &&
        nativeRangeApplied && !misaligned.valid()

    val drawPool = app.bufferPool(BufferPoolDescriptor(
        label = "test-draw-pool",
        capacity = 512,
        blockSize = 16,
        maximumAllocations = 8,
        usage = bufferUsageCopySource | bufferUsageCopyDestination |
            bufferUsageVertex | bufferUsageIndex | bufferUsageIndirect
    ))
    val drawPrefix = drawPool.allocate(16)
    val drawVertices = drawPool.allocate(24, 4)
    val drawIndices = drawPool.allocate(12, 4)
    val drawDirect = drawPool.allocate(16, 4)
    val drawIndexed = drawPool.allocate(20, 4)
    val drawVertexBytes = bufferBytes(24)
    val drawVerticesStored = drawVertexBytes.storeF32(-0.7, 0) &&
        drawVertexBytes.storeF32(-0.65, 4) &&
        drawVertexBytes.storeF32(0.7, 8) &&
        drawVertexBytes.storeF32(-0.65, 12) &&
        drawVertexBytes.storeF32(0.0, 16) &&
        drawVertexBytes.storeF32(0.7, 20)
    val drawIndexBytes = bufferBytes(12)
    val drawIndicesStored = drawIndexBytes.storeU32(0, 0) &&
        drawIndexBytes.storeU32(1, 4) && drawIndexBytes.storeU32(2, 8)
    val directBytes = bufferBytes(16)
    val directStored = directBytes.storeI64(4294967299, 0) &&
        directBytes.storeI64(0, 8)
    val indexedBytes = bufferBytes(20)
    val indexedStored = indexedBytes.storeI64(4294967299, 0) &&
        indexedBytes.storeI64(0, 8) && indexedBytes.storeU32(0, 16)
    val drawUploads = app.bufferTransferQueue(
        BufferTransferQueueDescriptor(
            label = "test-pool-draw-uploads",
            direction = bufferTransferDirectionUpload,
            slotCapacity = 32,
            slotCount = 4,
            alignment = 16
        )
    )
    val drawVertexUpload = app.enqueueUploadBufferPoolRange(
        drawUploads, drawVertexBytes, drawPool, drawVertices, 0, 0, 24
    )
    val drawIndexUpload = app.enqueueUploadBufferPoolRange(
        drawUploads, drawIndexBytes, drawPool, drawIndices, 0, 0, 12
    )
    val drawDirectUpload = app.enqueueUploadBufferPoolRange(
        drawUploads, directBytes, drawPool, drawDirect, 0, 0, 16
    )
    val drawIndexedUpload = app.enqueueUploadBufferPoolRange(
        drawUploads, indexedBytes, drawPool, drawIndexed, 0, 0, 20
    )
    val drawUploadsComplete = drawVerticesStored && drawIndicesStored &&
        directStored && indexedStored &&
        bufferTransferTicketValid(drawVertexUpload) &&
        bufferTransferTicketValid(drawIndexUpload) &&
        bufferTransferTicketValid(drawDirectUpload) &&
        bufferTransferTicketValid(drawIndexedUpload) &&
        drawUploads.wait(drawVertexUpload) &&
        drawUploads.wait(drawIndexUpload) &&
        drawUploads.wait(drawDirectUpload) &&
        drawUploads.wait(drawIndexedUpload)
    val drawShader = $glsl {
        vertex {
            #version 450
            layout(location = 0) in vec2 position;
            void main() {
                gl_Position = vec4(position, 0.0, 1.0);
            }
        }
        fragment {
            #version 450
            layout(location = 0) out vec4 color;
            void main() {
                color = vec4(0.2, 0.7, 1.0, 1.0);
            }
        }
    }
    val drawPipeline = app.renderPipeline(
        drawShader,
        VertexBufferLayout(8)
    )
    val pushDrawShader = $glsl {
        vertex {
            #version 450
            layout(location = 0) in vec2 position;
            void main() {
                gl_Position = vec4(position, 0.0, 1.0);
            }
        }
        fragment {
            #version 450
            layout(location = 0) out vec4 color;
            layout(push_constant) uniform PooledDraw {
                vec4 tint;
            } pooled;
            void main() {
                color = pooled.tint;
            }
        }
    }
    val pushDrawPipeline = app.renderPipeline(
        pushDrawShader,
        VertexBufferLayout(8)
    )
    val pushDrawValues = pushDrawShader.pushConstants()
    val pushDrawReady = pushDrawValues.fill() &&
        pushDrawValues.storeMemberF32("tint", 0.2) &&
        pushDrawValues.storeMemberF32("tint", 0.7, 1) &&
        pushDrawValues.storeMemberF32("tint", 1.0, 2) &&
        pushDrawValues.storeMemberF32("tint", 1.0, 3)
    val drawClear = Color(0.01, 0.02, 0.03)
    val directDrawn = app.presentRenderBufferPoolVertices(
        drawPipeline, drawPool, drawVertices, 3, drawClear
    )
    val indexedDrawn = app.presentRenderBufferPoolIndexed(
        drawPipeline,
        drawPool,
        drawVertices,
        drawIndices,
        3,
        drawClear
    )
    val indirectDrawn = app.presentRenderBufferPoolVerticesIndirect(
        drawPipeline,
        drawPool,
        drawVertices,
        drawDirect,
        drawClear
    )
    val indexedIndirectDrawn =
        app.presentRenderBufferPoolIndexedIndirect(
            drawPipeline,
            drawPool,
            drawVertices,
            drawIndices,
            drawIndexed,
            drawClear
        )
    val pushIndexedIndirectDrawn =
        app.presentPushRenderBufferPoolIndexedIndirect(
            pushDrawPipeline,
            pushDrawValues,
            drawPool,
            drawVertices,
            drawIndices,
            drawIndexed,
            drawClear
        )
    val misalignedDrawRejected = !app.presentRenderVertices(
        drawPipeline,
        drawPool.backing,
        3,
        drawClear,
        1,
        drawPool.allocationOffset(drawVertices) + 1,
        drawPool.allocationSize(drawVertices)
    )
    val shortIndexRejected = !app.presentRenderIndexed(
        drawPipeline,
        drawPool.backing,
        drawPool.backing,
        3,
        drawClear,
        1,
        drawPool.allocationOffset(drawVertices),
        drawPool.allocationSize(drawVertices),
        drawPool.allocationOffset(drawIndices),
        8
    )
    val shortDrawRejected = !app.presentRenderIndexedIndirect(
        drawPipeline,
        drawPool.backing,
        drawPool.backing,
        drawPool.backing,
        drawClear,
        drawPool.allocationOffset(drawVertices),
        drawPool.allocationSize(drawVertices),
        drawPool.allocationOffset(drawIndices),
        drawPool.allocationSize(drawIndices),
        drawPool.allocationOffset(drawIndexed),
        19
    )
    val staleDraw = drawPool.allocate(16, 4)
    val staleDrawReleased = drawPool.release(staleDraw)
    val staleDrawRejected = staleDrawReleased &&
        !app.presentRenderBufferPoolVertices(
            drawPipeline, drawPool, staleDraw, 2, drawClear
        )
    val drawBackingHandle = if (app.backend == graphicsBackendOpenGl)
        drawPool.backing.openGl.handle else drawPool.backing.vulkan.handle
    val drawPipelineHandle = if (app.backend == graphicsBackendOpenGl)
        drawPipeline.openGl.handle else drawPipeline.vulkan.handle
    val drawLiveBefore = runtimeMemoryLiveBytes()
    var drawRepeated = true
    var drawFrame = 0
    while (drawRepeated && drawFrame < 4) {
        drawRepeated = app.presentRenderBufferPoolIndexedIndirect(
            drawPipeline,
            drawPool,
            drawVertices,
            drawIndices,
            drawIndexed,
            drawClear
        )
        drawFrame = drawFrame + 1
    }
    val drawLiveAfter = runtimeMemoryLiveBytes()
    val drawHandlesStable = drawBackingHandle != 0 &&
        drawPipelineHandle != 0 &&
        (if (app.backend == graphicsBackendOpenGl)
            drawPool.backing.openGl.handle == drawBackingHandle &&
                drawPipeline.openGl.handle == drawPipelineHandle
         else drawPool.backing.vulkan.handle == drawBackingHandle &&
                drawPipeline.vulkan.handle == drawPipelineHandle)
    val drawRangesExact = drawPool.allocationOffset(drawPrefix) == 0 &&
        drawPool.allocationOffset(drawVertices) == 16 &&
        drawPool.allocationOffset(drawIndices) == 48 &&
        drawPool.allocationOffset(drawDirect) == 64 &&
        drawPool.allocationOffset(drawIndexed) == 80 &&
        directDrawn && indexedDrawn && indirectDrawn &&
        indexedIndirectDrawn && pushDrawPipeline.valid() &&
        pushDrawValues.valid() && pushDrawReady && pushIndexedIndirectDrawn &&
        misalignedDrawRejected && shortIndexRejected &&
        shortDrawRejected && staleDrawRejected && drawRepeated &&
        drawFrame == 4 && drawLiveAfter == drawLiveBefore &&
        drawHandlesStable

    val releasedForLoop = pool.release(replacement)
    val liveBefore = runtimeMemoryLiveBytes()
    var repeated = true
    var repeat = 0
    while (repeated && repeat < 1000) {
        val allocation = pool.allocate(16, 32)
        repeated = bufferPoolTokenValid(allocation) &&
            pool.allocationOffset(allocation) == 32 &&
            pool.release(allocation)
        repeat = repeat + 1
    }
    val liveAfter = runtimeMemoryLiveBytes()
    val handleStable = if (app.backend == graphicsBackendOpenGl)
        pool.backing.openGl.handle == backingHandle
    else pool.backing.vulkan.handle == backingHandle
    val passed = app.valid() && pool.valid() && pool.backing.deviceLocal() &&
        descriptorsRejectInvalid && layoutExact && releaseAccepted &&
        reuseExact && invalidRejected && sourceReady &&
        directCpuAccessRejected && uploads.valid() && downloads.valid() &&
        uploadsCompleted && badRangeRejected && readbacksCompleted && exact &&
        bindingPool.valid() && rangesExact && drawPool.valid() &&
        drawUploads.valid() && drawUploadsComplete && drawPipeline.valid() &&
        drawRangesExact &&
        releasedForLoop && repeated && repeat == 1000 &&
        liveAfter == liveBefore && handleStable &&
        pool.activeAllocations == 2 && pool.usedBytes == 64 &&
        pool.allocationCount == 1004
    println(
        "buffer-pool ${graphicsBackendName(app.backend)}: deviceLocal=${pool.backing.deviceLocal()} layout=$layoutExact reuse=$reuseExact exact=$exact bindings=$rangesExact align=$uniformAlignment/$storageAlignment draws=$drawRangesExact push=$pushIndexedIndirectDrawn rejected=$misalignedDrawRejected/$shortIndexRejected/$shortDrawRejected/$staleDrawRejected offsets=${drawPool.allocationOffset(drawVertices)}/${drawPool.allocationOffset(drawIndices)}/${drawPool.allocationOffset(drawDirect)}/${drawPool.allocationOffset(drawIndexed)} drawLive=${drawLiveAfter - drawLiveBefore} live=${liveAfter - liveBefore} stable=$handleStable/$drawHandlesStable active=${pool.activeAllocations} used=${pool.usedBytes}/${pool.descriptor.capacity}"
    )
    passed
}

fun main: int {
    val requested = if (processArgumentCount() > 0)
        processArgument(0)
    else ""
    val backend = if (requested == "opengl") graphicsBackendOpenGl
        else if (requested == "vulkan") graphicsBackendVulkan
        else graphicsBackendAuto
    if (bufferPoolProbe(backend)) 42 else 1
}
