import "../src/shader/glsl.ab"

fun main: int {
    val injected = "1) in; void injected() {} layout(local_size_x=1"
    val shader = $glsl {
        compute {
            #version 450
            layout(local_size_x = ${injected}) in;
            void main() {}
        }
    }
    if (shader.valid) 1 else 42
}
