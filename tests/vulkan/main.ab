import "abla/runtime/memory"
import "abla/io"
import "../../src/driver/vulkan.ab"
import "../../src/driver/vulkan_debug.ab"
import "../../src/shader/glsl_spirv.ab"

fun main: int {
    val loader = vulkanLoaderVersion()
    val instance = vulkanInstance(
        "Abla-only Vulkan loader test",
        vulkanApiVersion14
    )
    val debug = instance.debugMessenger()
    val debugHandle = debug.handle
    val debugMessage = "Abla Vulkan debug message"
    val debugWarmup = instance.debugUtils && debug.valid() && debug.submit(
        vulkanDebugSeverityInfo,
        vulkanDebugTypeGeneral,
        debugMessage
    )
    val debugLiveBefore = runtimeMemoryLiveBytes()
    var debugPassed = debugWarmup &&
        debug.submit(
            vulkanDebugSeverityInfo,
            vulkanDebugTypeGeneral,
            debugMessage
        ) && debug.submit(
            vulkanDebugSeverityWarning,
            vulkanDebugTypeValidation,
            debugMessage
        ) && debug.submit(
            vulkanDebugSeverityError,
            vulkanDebugTypeValidation | vulkanDebugTypePerformance,
            debugMessage
        )
    var debugRepeat = 0
    while (debugPassed && debugRepeat < 4) {
        debugPassed = debug.submit(
            vulkanDebugSeverityVerbose,
            vulkanDebugTypeGeneral,
            debugMessage
        )
        debugRepeat = debugRepeat + 1
    }
    debugPassed = debugPassed &&
        !debug.submit(8, vulkanDebugTypeGeneral, debugMessage) &&
        !debug.submit(vulkanDebugSeverityInfo, 8, debugMessage) &&
        !debug.submit(vulkanDebugSeverityInfo, vulkanDebugTypeGeneral, "")
    val debugLiveAfter = runtimeMemoryLiveBytes()
    val debugCounts = debug.counts()
    debugPassed = debugPassed && debug.handle == debugHandle &&
        debugLiveAfter == debugLiveBefore && debugCounts.total == 8 &&
        debugCounts.verbose == 4 && debugCounts.info == 2 &&
        debugCounts.warning == 1 && debugCounts.error == 1 &&
        debugCounts.general == 6 && debugCounts.validation == 2 &&
        debugCounts.performance == 1
    val noDebugInstance = vulkanInstance(
        "Abla Vulkan debug-disabled test",
        vulkanApiVersion14,
        enableDebugUtils = false
    )
    val noDebug = noDebugInstance.debugMessenger()
    debugPassed = debugPassed && noDebugInstance.valid() &&
        !noDebugInstance.debugUtils && !noDebug.valid() &&
        !noDebug.submit(
            vulkanDebugSeverityInfo,
            vulkanDebugTypeGeneral,
            debugMessage
        )
    val adapters = instance.adapters()
    val capabilities = if (adapters.size > 0)
        adapters[0].capabilities()
    else GraphicsCapabilities()
    val device = if (adapters.size > 0)
        adapters[0].device()
    else VulkanDevice(
        nativeNullPointer(),
        nativeNullPointer(),
        -1,
        0,
        nativeNullPointer(),
        false,
        false,
        false,
        0,
        0,
        0,
        0,
        nativePointerCell(nativeNullPointer()),
        nativeByteBuffer(0)
    )
    val timeline = device.timelineSemaphore(3)
    val invalidTimeline = device.timelineSemaphore(-1)
    val timelineHandle = timeline.handle
    val timelineInitial = timeline.currentValue()
    val timelineLiveBefore = runtimeMemoryLiveBytes()
    var timelinePassed = timeline.valid() && !invalidTimeline.valid() &&
        timelineInitial == 3 && timeline.signal(4) &&
        timeline.wait(4, 1000000000) && timeline.currentValue() == 4
    var timelineValue = 5
    while (timelinePassed && timelineValue <= 8) {
        timelinePassed = timeline.signal(timelineValue) &&
            timeline.wait(timelineValue, 1000000000) &&
            timeline.currentValue() == timelineValue
        timelineValue = timelineValue + 1
    }
    timelinePassed = timelinePassed && !timeline.signal(8) &&
        !timeline.wait(-1, 1000000000) && !timeline.wait(8, -1) &&
        invalidTimeline.currentValue() == -1
    val timelineLiveAfter = runtimeMemoryLiveBytes()
    val computePackage = $glsl {
        compute {
            #version 450
            layout(local_size_x = 8, local_size_y = 4) in;
            void main() {}
        }
    }
    val computeCode = computePackage.spirv(shaderStageCompute)
    val shader = device.shaderModule(computeCode.module)
    val storagePackage = $glsl {
        compute {
            #version 450
            layout(local_size_x = 1) in;
            layout(std430, binding = 0) buffer Values {
                uint value;
            } values;
            void main() { values.value = values.value * 3u; }
        }
    }
    val storageCode = storagePackage.spirv(shaderStageCompute)
    val storageShader = device.shaderModule(storageCode.module)
    val trianglePackage = $glsl {
        vertex {
            #version 450
            const vec2 positions[3] = vec2[3](
                vec2(-0.75, -0.65),
                vec2(0.75, -0.65),
                vec2(0.0, 0.75)
            );
            void main() {
                gl_Position = vec4(
                    positions[gl_VertexID],
                    0.0,
                    1.0
                );
            }
        }
        fragment {
            #version 450
            layout(location = 0) out vec4 color;
            void main() {
                color = vec4(0.12, 0.54, 0.96, 1.0);
            }
        }
    }
    val triangleVertexCode = trianglePackage.spirv(shaderStageVertex)
    val triangleFragmentCode = trianglePackage.spirv(shaderStageFragment)
    val triangleVertexShader = device.shaderModule(
        triangleVertexCode.module
    )
    val triangleFragmentShader = device.shaderModule(
        triangleFragmentCode.module
    )
    val pipeline = device.computePipeline(shader)
    val commandPool = pipeline.commandPool
    val commandBuffer = nativePointerAddress(pipeline.command.load())
    val dispatched = pipeline.dispatch(2)
    val dispatchedAgain = pipeline.dispatch(3)
    val dispatchLiveBefore = runtimeMemoryLiveBytes()
    var dispatchRepeated = dispatched && dispatchedAgain
    var dispatchRepeat = 0
    while (dispatchRepeated && dispatchRepeat < 4) {
        dispatchRepeated = pipeline.dispatch(2)
        dispatchRepeat = dispatchRepeat + 1
    }
    val dispatchLiveAfter = runtimeMemoryLiveBytes()
    val storageBuffer = device.buffer(8)
    val storageCleared = storageBuffer.writeI64(2)
    val storagePipeline = device.computeStoragePipeline(
        storageShader,
        storageBuffer
    )
    val storageDispatched = storagePipeline.dispatch(1)
    val storageDispatchedAgain = storagePipeline.dispatch(1)
    val storageValue = storageBuffer.readI64()
    val buffer = device.buffer(64)
    val transferTimelineHandle = device.transferTimeline
    val transferValueBefore = device.transferTimelineValue
    val transferBarrier2Before = device.transferBarrier2Count
    val filled = device.fillBuffer(
        buffer,
        BufferFillDescriptor(305419896)
    )
    val transferValueAfter = device.transferTimelineValue
    val transferBarrier2After = device.transferBarrier2Count
    val transferCompleted = device.transferCompletedValue()
    val first = buffer.readI64()
    var result = 42
    if (vulkanVersionMajor(loader) < 1 ||
        vulkanVersionMinor(loader) < 4) result = 2
    else if (!instance.valid()) result = 3
    else if (vulkanVersionMajor(instance.apiVersion) < 1) result = 4
    else if (!debugPassed) result = 15
    else if (adapters.size == 0) result = 5
    else if (adapters[0].name.size == 0) result = 6
    else if (adapters[0].graphicsQueueFamily() < 0) result = 7
    else if (!capabilities.valid() ||
        !capabilities.supports(graphicsFeatureCompute |
            graphicsFeatureStorageBuffers | graphicsFeatureSampledTextures |
            graphicsFeatureDepthTextures |
            graphicsFeatureComparisonSamplers |
            graphicsFeatureViewFormatReinterpretation |
            graphicsFeatureSamplerAnisotropy) ||
        capabilities.limits.maximumTextureDimension2D <= 0 ||
        capabilities.limits.maximumStorageBufferBytes <= 0 ||
        capabilities.limits.maximumComputeWorkgroupsX <= 0 ||
        capabilities.limits.maximumComputeWorkgroupsY <= 0 ||
        capabilities.limits.maximumComputeWorkgroupsZ <= 0 ||
        capabilities.limits.maximumComputeWorkgroupSizeX <= 0 ||
        capabilities.limits.maximumComputeWorkgroupSizeY <= 0 ||
        capabilities.limits.maximumComputeWorkgroupSizeZ <= 0 ||
        capabilities.limits.maximumComputeInvocations <= 0 ||
        capabilities.limits.maximumSamplerAnisotropy < 16) result = 14
    else if (!device.valid() || !device.timelineSemaphores ||
        !device.synchronization2 || !device.dynamicRendering ||
        !timelinePassed || timeline.handle != timelineHandle ||
        timelineLiveAfter != timelineLiveBefore) result = 8
    else if (!computeCode.succeeded || !computeCode.module.valid() ||
        computeCode.module.words[18] != 8 ||
        computeCode.module.words[19] != 4 || !shader.valid() ||
        !storageCode.succeeded || !storageShader.valid() ||
        !triangleVertexCode.succeeded || !triangleFragmentCode.succeeded ||
        !triangleVertexShader.valid() || !triangleFragmentShader.valid() ||
        !storageBuffer.valid() || !storageCleared ||
        !storagePipeline.valid() || !storageDispatched ||
        !storageDispatchedAgain || storageValue != 18 ||
        !pipeline.valid() || !dispatched || !dispatchedAgain ||
        !dispatchRepeated || dispatchLiveAfter != dispatchLiveBefore ||
        pipeline.commandPool != commandPool ||
        nativePointerAddress(pipeline.command.load()) != commandBuffer ||
        pipeline.dispatch(0)) result = 9
    else if (!buffer.valid()) result = 10
    else if (!filled || transferTimelineHandle == 0 ||
        device.transferTimeline != transferTimelineHandle ||
        transferBarrier2After <= transferBarrier2Before ||
        transferValueAfter <= transferValueBefore ||
        transferCompleted != transferValueAfter) result = 11
    else if (first != 1311768465173141112) result = 12
    else if (!device.waitIdle()) result = 13
    if (result == 15) println(
        "Vulkan debug failure supported=${instance.debugUtils} valid=${debug.valid()} handle=$debugHandle/${debug.handle} live=$debugLiveBefore/$debugLiveAfter counts=${debugCounts.total},${debugCounts.verbose},${debugCounts.info},${debugCounts.warning},${debugCounts.error},${debugCounts.general},${debugCounts.validation},${debugCounts.performance}"
    )
    result
}
