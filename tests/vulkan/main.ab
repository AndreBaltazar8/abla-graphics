import "abla/runtime/memory"
import "../../src/driver/vulkan.ab"
import "../../src/shader/glsl_spirv.ab"

fun main: int {
    val loader = vulkanLoaderVersion()
    val instance = vulkanInstance(
        "Abla-only Vulkan loader test",
        vulkanApiVersion14
    )
    val adapters = instance.adapters()
    val capabilities = if (adapters.size > 0)
        adapters[0].capabilities()
    else GraphicsCapabilities()
    val device = if (adapters.size > 0)
        adapters[0].device()
    else VulkanDevice(
        nativeNullPointer(),
        nativeNullPointer(),
        -1,
        0,
        nativeNullPointer(),
        0,
        nativePointerCell(nativeNullPointer()),
        nativeByteBuffer(0)
    )
    val computePackage = $glsl {
        compute {
            #version 450
            layout(local_size_x = 8, local_size_y = 4) in;
            void main() {}
        }
    }
    val computeCode = computePackage.spirv(shaderStageCompute)
    val shader = device.shaderModule(computeCode.module)
    val storagePackage = $glsl {
        compute {
            #version 450
            layout(local_size_x = 1) in;
            layout(std430, binding = 0) buffer Values {
                uint value;
            } values;
            void main() { values.value = values.value * 3u; }
        }
    }
    val storageCode = storagePackage.spirv(shaderStageCompute)
    val storageShader = device.shaderModule(storageCode.module)
    val pipeline = device.computePipeline(shader)
    val commandPool = pipeline.commandPool
    val commandBuffer = nativePointerAddress(pipeline.command.load())
    val dispatched = pipeline.dispatch(2)
    val dispatchedAgain = pipeline.dispatch(3)
    val dispatchLiveBefore = runtimeMemoryLiveBytes()
    var dispatchRepeated = dispatched && dispatchedAgain
    var dispatchRepeat = 0
    while (dispatchRepeated && dispatchRepeat < 4) {
        dispatchRepeated = pipeline.dispatch(2)
        dispatchRepeat = dispatchRepeat + 1
    }
    val dispatchLiveAfter = runtimeMemoryLiveBytes()
    val storageBuffer = device.buffer(8)
    val storageCleared = storageBuffer.writeI64(2)
    val storagePipeline = device.computeStoragePipeline(
        storageShader,
        storageBuffer
    )
    val storageDispatched = storagePipeline.dispatch(1)
    val storageDispatchedAgain = storagePipeline.dispatch(1)
    val storageValue = storageBuffer.readI64()
    val buffer = device.buffer(64)
    val filled = device.fillBuffer(
        buffer,
        BufferFillDescriptor(305419896)
    )
    val first = buffer.readI64()
    var result = 42
    if (vulkanVersionMajor(loader) < 1 ||
        vulkanVersionMinor(loader) < 4) result = 2
    else if (!instance.valid()) result = 3
    else if (vulkanVersionMajor(instance.apiVersion) < 1) result = 4
    else if (adapters.size == 0) result = 5
    else if (adapters[0].name.size == 0) result = 6
    else if (adapters[0].graphicsQueueFamily() < 0) result = 7
    else if (!capabilities.valid() ||
        !capabilities.supports(graphicsFeatureCompute |
            graphicsFeatureStorageBuffers | graphicsFeatureSampledTextures |
            graphicsFeatureDepthTextures |
            graphicsFeatureComparisonSamplers |
            graphicsFeatureViewFormatReinterpretation |
            graphicsFeatureSamplerAnisotropy) ||
        capabilities.limits.maximumTextureDimension2D <= 0 ||
        capabilities.limits.maximumStorageBufferBytes <= 0 ||
        capabilities.limits.maximumComputeWorkgroupsX <= 0 ||
        capabilities.limits.maximumComputeWorkgroupsY <= 0 ||
        capabilities.limits.maximumComputeWorkgroupsZ <= 0 ||
        capabilities.limits.maximumComputeWorkgroupSizeX <= 0 ||
        capabilities.limits.maximumComputeWorkgroupSizeY <= 0 ||
        capabilities.limits.maximumComputeWorkgroupSizeZ <= 0 ||
        capabilities.limits.maximumComputeInvocations <= 0 ||
        capabilities.limits.maximumSamplerAnisotropy < 16) result = 14
    else if (!device.valid()) result = 8
    else if (!computeCode.succeeded || !computeCode.module.valid() ||
        computeCode.module.words[18] != 8 ||
        computeCode.module.words[19] != 4 || !shader.valid() ||
        !storageCode.succeeded || !storageShader.valid() ||
        !storageBuffer.valid() || !storageCleared ||
        !storagePipeline.valid() || !storageDispatched ||
        !storageDispatchedAgain || storageValue != 18 ||
        !pipeline.valid() || !dispatched || !dispatchedAgain ||
        !dispatchRepeated || dispatchLiveAfter != dispatchLiveBefore ||
        pipeline.commandPool != commandPool ||
        nativePointerAddress(pipeline.command.load()) != commandBuffer ||
        pipeline.dispatch(0)) result = 9
    else if (!buffer.valid()) result = 10
    else if (!filled) result = 11
    else if (first != 1311768465173141112) result = 12
    else if (!device.waitIdle()) result = 13
    result
}
