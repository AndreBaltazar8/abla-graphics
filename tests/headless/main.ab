import "../../src/graphics.ab"

fun headlessProbe(backend: int): bool {
    val commonFeatures = graphicsFeatureCompute |
        graphicsFeatureStorageBuffers | graphicsFeatureSampledTextures |
        graphicsFeatureDepthTextures | graphicsFeatureComparisonSamplers |
        graphicsFeatureSamplerAnisotropy
    val requiredFeatures = commonFeatures |
        graphicsFeatureViewFormatReinterpretation
    val app = graphicsHeadlessApplication(
        GraphicsConfig(
            backend = backend,
            requiredFeatures = requiredFeatures
        ),
        32,
        32
    )
    app.valid() && app.backend == backend && app.adapterName != "" &&
        app.capabilities.valid() &&
        app.capabilities.supports(requiredFeatures) &&
        app.capabilities.limits.maximumTextureDimension2D > 0 &&
        app.capabilities.limits.maximumStorageBufferBytes > 0 &&
        app.capabilities.limits.maximumComputeWorkgroupsX > 0 &&
        app.capabilities.limits.maximumComputeWorkgroupsY > 0 &&
        app.capabilities.limits.maximumComputeWorkgroupsZ > 0 &&
        app.capabilities.limits.maximumComputeWorkgroupSizeX > 0 &&
        app.capabilities.limits.maximumComputeWorkgroupSizeY > 0 &&
        app.capabilities.limits.maximumComputeWorkgroupSizeZ > 0 &&
        app.capabilities.limits.maximumComputeInvocations > 0 &&
        app.capabilities.limits.maximumSamplerAnisotropy > 1 && app.probe()
}

fun automaticHeadlessProbe(): bool {
    val app = graphicsHeadlessApplication(
        GraphicsConfig(backend = graphicsBackendHeadless),
        32,
        32
    )
    app.valid() &&
        (app.backend == graphicsBackendVulkan ||
         app.backend == graphicsBackendOpenGl) && app.probe()
}

fun main: int = if (
    headlessProbe(graphicsBackendOpenGl) &&
    headlessProbe(graphicsBackendVulkan) &&
    automaticHeadlessProbe() &&
    graphicsHeadlessApplication(
        GraphicsConfig(),
        0,
        32
    ).error.code == graphicsErrorInvalidConfiguration &&
    graphicsHeadlessApplication(
        GraphicsConfig(
            backend = graphicsBackendOpenGl,
            requiredFeatures = 512
        ),
        32,
        32
    ).error.code == graphicsErrorInvalidConfiguration
) 42 else 1
