fun bufferRangesEqual(
    left: BufferBytes,
    leftOffset: int,
    right: BufferBytes,
    rightOffset: int,
    size: int
): bool {
    var equal = left.valid() && right.valid() && leftOffset >= 0 &&
        rightOffset >= 0 && size >= 0 &&
        size <= left.size - leftOffset && size <= right.size - rightOffset
    var index = 0
    while (equal && index < size) {
        equal = left.load(leftOffset + index) ==
            right.load(rightOffset + index)
        index = index + 1
    }
    equal
}

