import "abla/io"
import "abla/process/arguments"
import "abla/runtime/memory"
import "../../src/graphics.ab"

fun bufferRangesEqual(
    left: BufferBytes,
    leftOffset: int,
    right: BufferBytes,
    rightOffset: int,
    size: int
): bool {
    var equal = left.valid() && right.valid() && leftOffset >= 0 &&
        rightOffset >= 0 && size >= 0 &&
        size <= left.size - leftOffset && size <= right.size - rightOffset
    var index = 0
    while (equal && index < size) {
        equal = left.load(leftOffset + index) ==
            right.load(rightOffset + index)
        index = index + 1
    }
    equal
}

fun applicationBackendProbe(
    requestedBackend: int,
    expectedBackend: int,
    title: string
): bool {
    val commonFeatures = graphicsFeatureCompute |
        graphicsFeatureStorageBuffers | graphicsFeatureSampledTextures |
        graphicsFeatureDepthTextures | graphicsFeatureComparisonSamplers |
        graphicsFeatureSamplerAnisotropy
    val requiredFeatures = if (requestedBackend == graphicsBackendVulkan)
        commonFeatures | graphicsFeatureViewFormatReinterpretation
    else commonFeatures
    val app = graphicsApplication(
        GraphicsConfig(
            backend = requestedBackend,
            framesInFlight = if (
                requestedBackend != graphicsBackendOpenGl
            ) 3 else 2,
            requiredFeatures = requiredFeatures
        ),
        WindowConfig(title = title, width = 320, height = 200)
    )
    val monitor = app.primaryMonitor()
    val valid = app.valid() && app.backend == expectedBackend &&
        app.capabilities.valid() &&
        app.capabilities.supports(requiredFeatures) &&
        app.capabilities.limits.maximumTextureDimension2D > 0 &&
        app.capabilities.limits.maximumStorageBufferBytes > 0 &&
        app.capabilities.limits.maximumComputeWorkgroupsX > 0 &&
        app.capabilities.limits.maximumComputeWorkgroupSizeX > 0 &&
        app.capabilities.limits.maximumComputeInvocations > 0 &&
        app.capabilities.limits.maximumSamplerAnisotropy >= 16 &&
        monitor.valid() && monitor.contentScaleX() > 0.0 &&
        monitor.contentScaleY() > 0.0
    val cursorPassed = app.setCursorVisible(false) &&
        !app.cursorVisible() && app.setCursorVisible(false) &&
        app.setCursorVisible(true) && app.cursorVisible()
    val presented = app.presentClear(Color(
        0.15,
        0.45,
        0.85
    ))
    val pixels = pixelBuffer(320, 200)
    pixels.clearRgba8(18, 35, 64)
    pixels.fillRectRgba8(80, 50, 160, 100, 204, 64, 32)
    val pixelProgramBefore = app.openGlPixels.program.handle
    val pixelTextureBefore = app.openGlPixels.texture
    val pixelPool0Before = if (app.backend == graphicsBackendVulkan)
        app.vulkanPixels.frames[0].commandPool
    else 0
    val pixelPool1Before = if (app.backend == graphicsBackendVulkan)
        app.vulkanPixels.frames[1].commandPool
    else 0
    val pixelPool2Before = if (app.backend == graphicsBackendVulkan)
        app.vulkanPixels.frames[2].commandPool
    else 0
    val pixelCommand0Before = if (app.backend == graphicsBackendVulkan)
        nativePointerAddress(app.vulkanPixels.frames[0].command.load())
    else 0
    val pixelCommand1Before = if (app.backend == graphicsBackendVulkan)
        nativePointerAddress(app.vulkanPixels.frames[1].command.load())
    else 0
    val pixelCommand2Before = if (app.backend == graphicsBackendVulkan)
        nativePointerAddress(app.vulkanPixels.frames[2].command.load())
    else 0
    val pixelLiveBefore = runtimeMemoryLiveBytes()
    val pixelsPresented = app.presentPixels(pixels) &&
        app.presentPixels(pixels) && app.presentPixels(pixels) &&
        app.presentPixels(pixels)
    val pixelLiveAfter = runtimeMemoryLiveBytes()
    val pixelNoGrowth = pixelLiveAfter == pixelLiveBefore
    val pixelHandlesStable = if (app.backend == graphicsBackendOpenGl)
        app.openGlPixels.program.handle == pixelProgramBefore &&
            app.openGlPixels.texture == pixelTextureBefore
    else app.vulkanPixels.frames[0].commandPool == pixelPool0Before &&
        app.vulkanPixels.frames[1].commandPool == pixelPool1Before &&
        app.vulkanPixels.frames[2].commandPool == pixelPool2Before &&
        nativePointerAddress(app.vulkanPixels.frames[0].command.load()) ==
            pixelCommand0Before &&
        nativePointerAddress(app.vulkanPixels.frames[1].command.load()) ==
            pixelCommand1Before &&
        nativePointerAddress(app.vulkanPixels.frames[2].command.load()) ==
            pixelCommand2Before
    val frameSlotsPassed = app.backend != graphicsBackendVulkan ||
        (app.framesInFlight == 3 && app.vulkanPixels.frames.size == 3 &&
         app.vulkanPixels.frameIndex == 2 &&
         app.vulkanPixels.frames[0].inFlight &&
         app.vulkanPixels.frames[1].inFlight &&
         app.vulkanPixels.frames[2].inFlight)
    val buffer = app.buffer(BufferDescriptor(
        label = "common-storage",
        size = 64,
        usage = bufferUsageCopySource |
            bufferUsageCopyDestination | bufferUsageStorage
    ))
    val bufferWritten = buffer.writeI64(1311768465173141112, 8)
    val bufferRead = buffer.readI64(8)
    val uploadBytes = bufferBytes(32)
    val uploadInitialized = uploadBytes.storeI64(81985529216486895, 0) &&
        uploadBytes.storeI64(1311768465173141112, 8) &&
        uploadBytes.storeI64(72623859790382856, 16) &&
        uploadBytes.storeI64(2387509390608836392, 24)
    val rangeUploaded = uploadInitialized && buffer.writeBytes(
        uploadBytes,
        BufferCopyDescriptor(5, 17, 19)
    )
    val downloadBytes = bufferBytes(32)
    val downloadCleared = downloadBytes.fill(0)
    val rangeRead = downloadCleared && buffer.readBytes(
        downloadBytes,
        BufferCopyDescriptor(17, 4, 19)
    )
    val rangeMatches = bufferRangesEqual(
        uploadBytes,
        5,
        downloadBytes,
        4,
        19
    )
    val invalidBufferRangeRejected = !buffer.writeBytes(
        uploadBytes,
        BufferCopyDescriptor(20, 60, 16)
    )
    val wholeUploadBytes = bufferBytes(64)
    val wholeDownloadBytes = bufferBytes(64)
    val wholeBufferTransferred = wholeUploadBytes.fill(41) &&
        wholeUploadBytes.store(37, 199) &&
        buffer.writeAllBytes(wholeUploadBytes) &&
        wholeDownloadBytes.fill(0) &&
        buffer.readAllBytes(wholeDownloadBytes) &&
        wholeDownloadBytes.load(0) == 41 &&
        wholeDownloadBytes.load(37) == 199 &&
        wholeDownloadBytes.load(63) == 41
    val gpuCopyDestination = app.buffer(BufferDescriptor(
        label = "gpu-copy-destination",
        size = 64,
        usage = bufferUsageCopySource | bufferUsageCopyDestination
    ))
    val transferPoolBefore = app.vulkanDevice.transferPool
    val transferCommandBefore = if (
        app.backend == graphicsBackendVulkan &&
        !app.vulkanDevice.transferCommand.closed
    ) nativePointerAddress(app.vulkanDevice.transferCommand.load()) else 0
    val gpuRangeCopied = app.copyBuffer(
        buffer,
        gpuCopyDestination,
        BufferCopyDescriptor(7, 19, 31)
    )
    val gpuCopyReadback = bufferBytes(40)
    val gpuCopyRead = gpuCopyReadback.fill(0) &&
        gpuCopyDestination.readBytes(
            gpuCopyReadback,
            BufferCopyDescriptor(19, 2, 31)
        )
    val gpuCopyMatches = bufferRangesEqual(
        wholeUploadBytes,
        7,
        gpuCopyReadback,
        2,
        31
    )
    val transferStateStable = app.backend != graphicsBackendVulkan ||
        (app.vulkanDevice.transferPool == transferPoolBefore &&
         nativePointerAddress(app.vulkanDevice.transferCommand.load()) ==
            transferCommandBefore)
    val invalidGpuCopyRejected = !app.copyBuffer(
        buffer,
        gpuCopyDestination,
        BufferCopyDescriptor(50, 60, 8)
    )
    val gpuFillBuffer = app.buffer(BufferDescriptor(
        label = "gpu-fill-destination",
        size = 64,
        usage = bufferUsageCopySource | bufferUsageCopyDestination
    ))
    val gpuFillInitialization = bufferBytes(64)
    val gpuFillReadback = bufferBytes(64)
    val gpuFillInitialized = gpuFillInitialization.fill(0) &&
        gpuFillBuffer.writeAllBytes(gpuFillInitialization)
    val gpuFilled = app.fillBuffer(
        gpuFillBuffer,
        BufferFillDescriptor(305419896, 12, 20)
    )
    val gpuFillRead = gpuFillReadback.fill(255) &&
        gpuFillBuffer.readAllBytes(gpuFillReadback)
    val gpuFillMatches = gpuFillReadback.load(11) == 0 &&
        gpuFillReadback.load(12) == 120 &&
        gpuFillReadback.load(13) == 86 &&
        gpuFillReadback.load(14) == 52 &&
        gpuFillReadback.load(15) == 18 &&
        gpuFillReadback.load(28) == 120 &&
        gpuFillReadback.load(31) == 18 &&
        gpuFillReadback.load(32) == 0
    val fillTransferStateStable = app.backend != graphicsBackendVulkan ||
        (app.vulkanDevice.transferPool == transferPoolBefore &&
         nativePointerAddress(app.vulkanDevice.transferCommand.load()) ==
            transferCommandBefore)
    val invalidGpuFillRejected = !app.fillBuffer(
        gpuFillBuffer,
        BufferFillDescriptor(1, 2, 8)
    )
    val usageRestrictedBuffer = app.buffer(BufferDescriptor(
        size = 32,
        usage = bufferUsageStorage
    ))
    val missingWriteUsageRejected = !usageRestrictedBuffer.writeBytes(
        uploadBytes,
        BufferCopyDescriptor()
    )
    val missingReadUsageRejected = !usageRestrictedBuffer.readBytes(
        downloadBytes,
        BufferCopyDescriptor()
    )
    val missingCopySourceUsageRejected = !app.copyBuffer(
        usageRestrictedBuffer,
        gpuCopyDestination,
        BufferCopyDescriptor(size = 8)
    )
    val missingCopyDestinationUsageRejected = !app.copyBuffer(
        buffer,
        usageRestrictedBuffer,
        BufferCopyDescriptor(size = 8)
    )
    val missingFillUsageRejected = !app.fillBuffer(
        usageRestrictedBuffer,
        BufferFillDescriptor(size = 8)
    )
    val invalidBuffer = app.buffer(BufferDescriptor(
        size = 0,
        usage = bufferUsageStorage
    ))
    val oversizedBuffer = app.buffer(BufferDescriptor(
        size = app.capabilities.limits.maximumStorageBufferBytes + 1,
        usage = bufferUsageStorage
    ))
    val mappedBuffer = app.buffer(BufferDescriptor(
        size = 64,
        usage = bufferUsageMapWrite | bufferUsageCopySource,
        mappedAtCreation = true
    ))
    val readbackBuffer = app.buffer(BufferDescriptor(
        size = 64,
        usage = bufferUsageMapRead
    ))
    val sampler = app.sampler(SamplerDescriptor(
        addressU = samplerAddressRepeat,
        addressV = samplerAddressMirrorRepeat,
        magFilter = samplerFilterLinear,
        minFilter = samplerFilterLinear,
        mipmapFilter = samplerFilterLinear,
        compare = compareFunctionLessEqual
    ))
    val anisotropicSampler = app.sampler(SamplerDescriptor(
        maximumAnisotropy = 16
    ))
    val texture = app.texture(TextureDescriptor(
        label = "common-color",
        size = Extent3D(16, 16),
        mipLevels = 4,
        format = textureFormatRgba8Unorm,
        usage = textureUsageSampled | textureUsageCopySource |
            textureUsageCopyDestination
    ))
    val uploadPixels = pixelBuffer(2, 2)
    val uploadCleared = uploadPixels.clearRgba8(31, 43, 59, 79)
    val uploadMarked = uploadPixels.setRgba8(1, 1, 71, 83, 97, 109)
    val textureUploaded = uploadCleared && uploadMarked &&
        texture.writePixels(
            uploadPixels,
            TextureWriteDescriptor(2, 1, 1)
        )
    val uploadedPixel = texture.rgba8(2, 2, 2)
    val uploadChanged = uploadPixels.setRgba8(0, 0, 5, 7, 11, 13)
    val textureReuploaded = uploadChanged && texture.writePixels(
        uploadPixels,
        TextureWriteDescriptor(2, 1, 1)
    )
    val reuploadedPixel = texture.rgba8(1, 1, 2)
    val textureCopyDestination = app.texture(TextureDescriptor(
        label = "gpu-texture-copy-destination",
        size = Extent3D(16, 16),
        mipLevels = 4,
        format = textureFormatRgba8Unorm,
        usage = textureUsageSampled | textureUsageCopySource |
            textureUsageCopyDestination
    ))
    val textureTransferPoolBefore = app.vulkanDevice.transferPool
    val textureTransferCommandBefore = if (
        app.backend == graphicsBackendVulkan &&
        !app.vulkanDevice.transferCommand.closed
    ) nativePointerAddress(app.vulkanDevice.transferCommand.load()) else 0
    val textureCopied = app.copyTexture(
        texture,
        textureCopyDestination,
        TextureCopyDescriptor(2, 1, 1, 1, 3, 4, 2, 2)
    )
    val textureCopyFirstPixel = textureCopyDestination.rgba8(3, 4, 1)
    val textureCopyLastPixel = textureCopyDestination.rgba8(4, 5, 1)
    val textureTransferStateStable = app.backend != graphicsBackendVulkan ||
        (app.vulkanDevice.transferPool == textureTransferPoolBefore &&
         nativePointerAddress(app.vulkanDevice.transferCommand.load()) ==
            textureTransferCommandBefore)
    val invalidTextureCopyRejected = !app.copyTexture(
        texture,
        textureCopyDestination,
        TextureCopyDescriptor(2, 3, 3, 1, 0, 0, 2, 2)
    )
    val sameTextureCopyRejected = !app.copyTexture(
        texture,
        texture,
        TextureCopyDescriptor(2, 0, 0, 2, 2, 2, 1, 1)
    )
    val invalidUploadRejected = !texture.writePixels(
        uploadPixels,
        TextureWriteDescriptor(2, 3, 3)
    )
    val textureView = texture.view()
    val reinterpretedTextureView = texture.view(TextureViewDescriptor(
        format = textureFormatRgba8UnormSrgb
    ))
    val invalidTextureView = texture.view(TextureViewDescriptor(
        baseMipLevel = 4
    ))
    val bgraTexture = app.texture(TextureDescriptor(
        size = Extent3D(4, 4),
        format = textureFormatBgra8Unorm,
        usage = textureUsageCopySource | textureUsageCopyDestination
    ))
    val bgraPixels = pixelBuffer(1, 1)
    val bgraUploaded = bgraPixels.setRgba8(0, 0, 17, 29, 43, 61) &&
        bgraTexture.writePixels(
            bgraPixels,
            TextureWriteDescriptor(0, 2, 3)
        )
    val bgraPixel = bgraTexture.rgba8(2, 3)
    val depthTexture = app.texture(TextureDescriptor(
        label = "common-depth",
        size = Extent3D(16, 16),
        format = textureFormatDepth16Unorm,
        usage = textureUsageSampled | textureUsageRenderAttachment
    ))
    val depthTextureView = depthTexture.view(TextureViewDescriptor(
        aspect = textureAspectDepth
    ))
    val unsupportedTexture = app.texture(TextureDescriptor(
        size = Extent3D(16, 16),
        samples = 4,
        usage = textureUsageRenderAttachment
    ))
    val oversizedTexture = app.texture(TextureDescriptor(
        size = Extent3D(
            app.capabilities.limits.maximumTextureDimension2D + 1,
            1
        ),
        usage = textureUsageSampled
    ))
    val bindUniform = app.buffer(BufferDescriptor(
        label = "bind-uniform",
        size = 64,
        usage = bufferUsageUniform | bufferUsageCopyDestination
    ))
    val sampledEntry = app.sampledTextureEntry(
        3,
        shaderVisibilityFragment,
        texture,
        sampler
    )
    val uniformEntry = app.uniformBufferEntry(
        5,
        shaderVisibilityVertex | shaderVisibilityFragment,
        bindUniform
    )
    val storageEntry = app.storageBufferEntry(
        7,
        shaderVisibilityFragment,
        buffer
    )
    val bindGroup = app.bindGroup([
        sampledEntry,
        uniformEntry,
        storageEntry
    ])
    val bindGroupMatches = bindGroup.matches([
        ShaderBinding(
            shaderStageFragment,
            0,
            3,
            "uniform",
            "sampler2D",
            "atlas"
        ),
        ShaderBinding(
            shaderStageVertex,
            0,
            5,
            "uniform",
            "Transform",
            "transform"
        ),
        ShaderBinding(
            shaderStageFragment,
            0,
            5,
            "uniform",
            "Transform",
            "transform"
        ),
        ShaderBinding(
            shaderStageFragment,
            0,
            7,
            "buffer",
            "Values",
            "values"
        )
    ])
    val duplicateBindGroup = app.bindGroup([
        sampledEntry,
        app.uniformBufferEntry(
            3,
            shaderVisibilityVertex,
            bindUniform
        )
    ])
    val wrongUsageEntry = app.uniformBufferEntry(
        9,
        shaderVisibilityVertex,
        usageRestrictedBuffer
    )
    val wrongUsageBindGroup = app.bindGroup([wrongUsageEntry])
    val computeShader = $glsl {
        compute {
            #version 450
            layout(local_size_x = 8) in;
            void main() {}
        }
    }
    val compute = app.computePipeline(computeShader)
    val computed = compute.dispatch(2) && compute.dispatch(3)
    val unsupportedComputeShader = glslPackage(
        [shaderStageCompute],
        ["#version 450\nlayout(local_size_x=8) in; void main() { uint value = 1; }"]
    )
    val unsupportedCompute = app.computePipeline(unsupportedComputeShader)
    val oversizedWorkgroupShader = glslPackage(
        [shaderStageCompute],
        ["#version 450\nlayout(local_size_x=${app.capabilities.limits.maximumComputeWorkgroupSizeX + 1}) in; void main() {}"]
    )
    val oversizedWorkgroup = app.computePipeline(oversizedWorkgroupShader)
    val excessiveInvocationsShader = glslPackage(
        [shaderStageCompute],
        ["#version 450\nlayout(local_size_x=32, local_size_y=33) in; void main() {}"]
    )
    val excessiveInvocations = app.computePipeline(
        excessiveInvocationsShader
    )
    val storageShader = $glsl {
        compute {
            #version 450
            layout(local_size_x = 1) in;
            layout(std430, binding = 0) buffer Values {
                uint value;
            } values;
            void main() { values.value = values.value * 3u; }
        }
    }
    val computeBuffer = app.buffer(BufferDescriptor(
        size = 8,
        usage = bufferUsageStorage | bufferUsageCopySource |
            bufferUsageCopyDestination
    ))
    val computeBufferCleared = computeBuffer.writeI64(2)
    val storageCompute = app.computeStoragePipeline(
        storageShader,
        computeBuffer
    )
    val storageComputed = storageCompute.dispatch(1)
    val computeCommandPool = compute.vulkan.commandPool
    val computeCommand = if (app.backend == graphicsBackendVulkan)
        nativePointerAddress(compute.vulkan.command.load())
    else 0
    val storageCommandPool = storageCompute.vulkan.commandPool
    val storageCommand = if (app.backend == graphicsBackendVulkan)
        nativePointerAddress(storageCompute.vulkan.command.load())
    else 0
    val computeOpenGlHandle = compute.openGl.handle
    val storageOpenGlHandle = storageCompute.openGl.handle
    val computeLiveBefore = runtimeMemoryLiveBytes()
    var computeRepeated = storageComputed
    var computeRepeat = 0
    while (computeRepeated && computeRepeat < 4) {
        computeRepeated = compute.dispatch(2) &&
            storageCompute.dispatch(1)
        computeRepeat = computeRepeat + 1
    }
    val computeLiveAfter = runtimeMemoryLiveBytes()
    val computeNoGrowth = computeLiveAfter == computeLiveBefore
    val computeHandlesStable = if (app.backend == graphicsBackendOpenGl)
        compute.openGl.handle == computeOpenGlHandle &&
            storageCompute.openGl.handle == storageOpenGlHandle
    else compute.vulkan.commandPool == computeCommandPool &&
        nativePointerAddress(compute.vulkan.command.load()) == computeCommand &&
        storageCompute.vulkan.commandPool == storageCommandPool &&
        nativePointerAddress(storageCompute.vulkan.command.load()) ==
            storageCommand
    val computeValue = computeBuffer.readI64()
    var resizePassed = true
    var recoveryDetail = ""
    if (requestedBackend == graphicsBackendOpenGl) {
        resizePassed = app.resize(360, 240)
        var resizeEvent = WindowEvent()
        var attempts = 0
        while (resizePassed && resizeEvent.kind != windowEventResized &&
            attempts < 32) {
            resizeEvent = app.pollEvent(50)
            attempts = attempts + 1
        }
        resizePassed = resizeEvent.first == 360 &&
            resizeEvent.second == 240 && app.openGl.width == 360 &&
            app.openGl.height == 240
        resizePassed = resizePassed && app.presentClear(Color(
                0.125,
                0.25,
                0.5
            ))
    } else if (requestedBackend == graphicsBackendVulkan) {
        val oldSwapchainWidth = app.vulkanSwapchain.width
        val oldSwapchainHeight = app.vulkanSwapchain.height
        resizePassed = app.resize(360, 240)
        var resizeEvent = WindowEvent()
        var attempts = 0
        while (resizePassed && resizeEvent.kind != windowEventResized &&
            attempts < 32) {
            resizeEvent = app.window.pollEvent(50)
            attempts = attempts + 1
        }
        val staleBeforePresent =
            app.vulkanSwapchain.width == oldSwapchainWidth &&
            app.vulkanSwapchain.height == oldSwapchainHeight
        val recoveryColor = Color(0.125, 0.25, 0.5)
        val recoveredPresent = app.recoverVulkanClearPresentation(
            vulkanPresentStatus(vulkanErrorOutOfDate),
            recoveryColor,
            360,
            240
        )
        val clearRecovered = staleBeforePresent && recoveredPresent &&
            app.vulkanSwapchain.width == 360 &&
            app.vulkanSwapchain.height == 240 &&
            app.vulkanPixels.width == 360 &&
            app.vulkanPixels.height == 240 &&
            app.window.width == 360 && app.window.height == 240
        recoveryDetail = "old=${oldSwapchainWidth}x${oldSwapchainHeight} event=${resizeEvent.first}x${resizeEvent.second} stale=$staleBeforePresent presented=$recoveredPresent clearSize=${app.vulkanSwapchain.width}x${app.vulkanSwapchain.height}"
        resizePassed = clearRecovered && app.resize(400, 260)
        var pixelResizeEvent = WindowEvent()
        attempts = 0
        while (resizePassed &&
            pixelResizeEvent.kind != windowEventResized && attempts < 32) {
            pixelResizeEvent = app.window.pollEvent(50)
            attempts = attempts + 1
        }
        val pixelSwapchainStale = app.vulkanSwapchain.width == 360 &&
            app.vulkanSwapchain.height == 240
        val currentPixels = pixelBuffer(400, 260)
        val currentPixelsCleared = currentPixels.clearRgba8(17, 19, 23)
        val recoveredPixels = currentPixelsCleared &&
            app.recoverVulkanPixelPresentation(
                vulkanPresentStatus(vulkanErrorOutOfDate),
                currentPixels,
                400,
                260
            )
        val pixelRecovered = app.vulkanSwapchain.width == 400 &&
            app.vulkanSwapchain.height == 260 &&
            app.window.width == 400 && app.window.height == 260
        recoveryDetail = "$recoveryDetail clear=$clearRecovered secondEvent=${pixelResizeEvent.first}x${pixelResizeEvent.second} secondStale=$pixelSwapchainStale pixelRecovered=$pixelRecovered pixels=$recoveredPixels swap=${app.vulkanSwapchain.width}x${app.vulkanSwapchain.height}"
        resizePassed = resizePassed && pixelSwapchainStale &&
            pixelRecovered && recoveredPixels &&
            app.vulkanPixels.width == 400 &&
            app.vulkanPixels.height == 260
    }
    val triangleShader = $glsl {
        vertex {
            #version 450
            const vec2 positions[3] = vec2[3](
                vec2(-0.75, -0.65),
                vec2(0.75, -0.65),
                vec2(0.0, 0.75)
            );
            void main() {
                gl_Position = vec4(
                    positions[gl_VertexID],
                    0.0,
                    1.0
                );
            }
        }
        fragment {
            #version 450
            layout(location = 0) out vec4 color;
            void main() {
                color = vec4(0.12, 0.54, 0.96, 1.0);
            }
        }
    }
    val renderPipeline = app.renderPipeline(triangleShader)
    val renderClear = Color(0.02, 0.03, 0.05)
    val rendered = app.presentRender(renderPipeline, renderClear)
    val renderOpenGlHandle = renderPipeline.openGl.handle
    val renderOpenGlArray = renderPipeline.openGl.vertexArray
    val renderVulkanHandle = renderPipeline.vulkan.handle
    val renderPassHandle = renderPipeline.vulkan.renderPass
    val renderFramebuffer0 = if (
        renderPipeline.vulkan.framebuffers.size > 0
    ) renderPipeline.vulkan.framebuffers[0] else 0
    val renderPool0 = if (app.backend == graphicsBackendVulkan)
        app.vulkanPixels.frames[0].commandPool else 0
    val renderCommand0 = if (app.backend == graphicsBackendVulkan)
        nativePointerAddress(app.vulkanPixels.frames[0].command.load())
    else 0
    val renderLiveBefore = runtimeMemoryLiveBytes()
    var renderRepeated = rendered
    var renderIndex = 0
    while (renderRepeated && renderIndex < 4) {
        renderRepeated = app.presentRender(renderPipeline, renderClear)
        renderIndex = renderIndex + 1
    }
    val renderLiveAfter = runtimeMemoryLiveBytes()
    val renderNoGrowth = renderLiveAfter == renderLiveBefore
    val renderHandlesStable = if (app.backend == graphicsBackendOpenGl)
        renderPipeline.openGl.handle == renderOpenGlHandle &&
            renderPipeline.openGl.vertexArray == renderOpenGlArray
    else renderPipeline.vulkan.handle == renderVulkanHandle &&
        renderPipeline.vulkan.renderPass == renderPassHandle &&
        renderPipeline.vulkan.framebuffers[0] == renderFramebuffer0 &&
        app.vulkanPixels.frames[0].commandPool == renderPool0 &&
        nativePointerAddress(app.vulkanPixels.frames[0].command.load()) ==
            renderCommand0
    println(
        "${graphicsBackendName(requestedBackend)}: selected=${graphicsBackendName(app.backend)} valid=$valid version=${app.capabilities.version.text()} features=${app.capabilities.features} texture2d=${app.capabilities.limits.maximumTextureDimension2D} storage=${app.capabilities.limits.maximumStorageBufferBytes} groups=${app.capabilities.limits.maximumComputeWorkgroupsX}x${app.capabilities.limits.maximumComputeWorkgroupsY}x${app.capabilities.limits.maximumComputeWorkgroupsZ} local=${app.capabilities.limits.maximumComputeWorkgroupSizeX}x${app.capabilities.limits.maximumComputeWorkgroupSizeY}x${app.capabilities.limits.maximumComputeWorkgroupSizeZ} invocations=${app.capabilities.limits.maximumComputeInvocations} anisotropy=${app.capabilities.limits.maximumSamplerAnisotropy} presented=$presented pixels=$pixelsPresented pixelLiveDelta=${pixelLiveAfter - pixelLiveBefore} pixelHandlesStable=$pixelHandlesStable render=$rendered renderLiveDelta=${renderLiveAfter - renderLiveBefore} renderHandlesStable=$renderHandlesStable frames=${app.vulkanPixels.frames.size} resize=$resizePassed size=${app.window.width}x${app.window.height} recovery='$recoveryDetail' buffer=${buffer.valid()} adapter='${app.adapterName}' error='${app.error.message}'"
    )
    valid && cursorPassed && presented && pixelsPresented && pixelNoGrowth &&
        pixelHandlesStable && frameSlotsPassed &&
        buffer.valid() && bufferWritten &&
        bufferRead == 1311768465173141112 &&
        !buffer.writeI64(1, 60) && !invalidBuffer.valid() &&
        invalidBuffer.error.code == graphicsErrorInvalidConfiguration &&
        !oversizedBuffer.valid() &&
        oversizedBuffer.error.code == graphicsErrorLimitExceeded &&
        !mappedBuffer.valid() &&
        mappedBuffer.error.operation ==
            "GraphicsApplication.buffer.mappedAtCreation" &&
        readbackBuffer.valid() && rangeUploaded && rangeRead && rangeMatches &&
        invalidBufferRangeRejected && wholeBufferTransferred &&
        gpuCopyDestination.valid() && gpuRangeCopied && gpuCopyRead &&
        gpuCopyMatches && transferStateStable && invalidGpuCopyRejected &&
        gpuFillBuffer.valid() && gpuFillInitialized && gpuFilled &&
        gpuFillRead && gpuFillMatches && fillTransferStateStable &&
        invalidGpuFillRejected &&
        usageRestrictedBuffer.valid() &&
        missingWriteUsageRejected && missingReadUsageRejected &&
        missingCopySourceUsageRejected &&
        missingCopyDestinationUsageRejected &&
        missingFillUsageRejected &&
        sampler.valid() &&
        anisotropicSampler.valid() &&
        texture.valid() && textureUploaded && textureReuploaded &&
        uploadedPixel == 1835094855 && invalidUploadRejected &&
        reuploadedPixel == 218826501 &&
        textureCopyDestination.valid() && textureCopied &&
        textureCopyFirstPixel == 218826501 &&
        textureCopyLastPixel == 1835094855 &&
        textureTransferStateStable && invalidTextureCopyRejected &&
        sameTextureCopyRejected &&
        textureView.valid() &&
        textureView.descriptor.resolvedFormat(texture.descriptor) ==
            textureFormatRgba8Unorm &&
        (if (app.backend == graphicsBackendOpenGl)
            !reinterpretedTextureView.valid() &&
                reinterpretedTextureView.error.code ==
                    graphicsErrorUnsupportedFeature
         else reinterpretedTextureView.valid()) &&
        !invalidTextureView.valid() &&
        invalidTextureView.error.code == graphicsErrorInvalidConfiguration &&
        bgraTexture.valid() && bgraUploaded &&
        bgraPixel == 1026235665 &&
        depthTexture.valid() && depthTextureView.valid() &&
        !unsupportedTexture.valid() &&
        unsupportedTexture.error.code == graphicsErrorUnsupportedFeature &&
        !oversizedTexture.valid() &&
        oversizedTexture.error.code == graphicsErrorLimitExceeded &&
        bindUniform.valid() && sampledEntry.valid() &&
        uniformEntry.valid() && storageEntry.valid() && bindGroup.valid() &&
        bindGroup.entryCount() == 3 && bindGroupMatches &&
        !duplicateBindGroup.valid() &&
        duplicateBindGroup.error.code == graphicsErrorInvalidConfiguration &&
        !wrongUsageEntry.valid() && !wrongUsageBindGroup.valid() &&
        compute.valid() && computed && !compute.dispatch(0) &&
        !compute.dispatch(
            app.capabilities.limits.maximumComputeWorkgroupsX + 1
        ) &&
        !compute.dispatch(
            1,
            app.capabilities.limits.maximumComputeWorkgroupsY + 1
        ) &&
        !compute.dispatch(
            1,
            1,
            app.capabilities.limits.maximumComputeWorkgroupsZ + 1
        ) &&
        !unsupportedCompute.valid() &&
        unsupportedCompute.error.code == graphicsErrorUnsupportedFeature &&
        !oversizedWorkgroup.valid() &&
        oversizedWorkgroup.error.code == graphicsErrorLimitExceeded &&
        !excessiveInvocations.valid() &&
        excessiveInvocations.error.code == graphicsErrorLimitExceeded &&
        computeBuffer.valid() && computeBufferCleared &&
        storageCompute.valid() && storageComputed && computeRepeated &&
        computeNoGrowth && computeHandlesStable && computeValue == 486 &&
        resizePassed && renderPipeline.valid() && rendered &&
        renderRepeated && renderNoGrowth && renderHandlesStable
}

fun applicationUnavailableProbe(): bool {
    val app = graphicsApplication(
        GraphicsConfig(backend = graphicsBackendVulkan),
        WindowConfig(title = "Unavailable Vulkan", width = 320, height = 200)
    )
    val rejected = !app.valid() &&
        app.error.code == graphicsErrorBackendUnavailable
    println("unavailable vulkan: rejected=$rejected")
    rejected
}

fun applicationUnsupportedFeatureProbe(): bool {
    val app = graphicsApplication(
        GraphicsConfig(
            backend = graphicsBackendOpenGl,
            requiredFeatures = graphicsFeatureViewFormatReinterpretation
        ),
        WindowConfig(
            title = "Unsupported OpenGL feature",
            width = 320,
            height = 200
        )
    )
    val rejected = !app.valid() &&
        app.error.code == graphicsErrorUnsupportedFeature
    println("unsupported OpenGL feature: rejected=$rejected")
    rejected
}

fun main: int {
    val requested = if (processArgumentCount() > 0)
        processArgument(0)
    else ""
    if (requested == "unavailable") {
        if (applicationUnavailableProbe()) 42 else 1
    } else if (requested == "unsupported") {
        if (applicationUnsupportedFeatureProbe()) 42 else 1
    } else {
        val requestedBackend = if (requested == "opengl")
            graphicsBackendOpenGl
        else if (requested == "vulkan") graphicsBackendVulkan
        else graphicsBackendAuto
        val expectedBackend = if (
            requestedBackend == graphicsBackendOpenGl ||
            requested == "fallback"
        ) graphicsBackendOpenGl else graphicsBackendVulkan
        if (applicationBackendProbe(
            requestedBackend,
            expectedBackend,
            "Common $requested"
        )) 42 else 1
    }
}
