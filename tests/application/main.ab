import "abla/io"
import "abla/process/arguments"
import "../../src/graphics.ab"

fun applicationBackendProbe(
    requestedBackend: int,
    expectedBackend: int,
    title: string
): bool {
    val app = graphicsApplication(
        GraphicsConfig(backend = requestedBackend),
        WindowConfig(title = title, width = 320, height = 200)
    )
    val monitor = app.primaryMonitor()
    val valid = app.valid() && app.backend == expectedBackend &&
        monitor.valid() && monitor.contentScaleX() > 0.0 &&
        monitor.contentScaleY() > 0.0
    val presented = app.presentClear(Color(
        0.15,
        0.45,
        0.85
    ))
    val pixels = pixelBuffer(320, 200)
    pixels.clearRgba8(18, 35, 64)
    pixels.fillRectRgba8(80, 50, 160, 100, 204, 64, 32)
    val pixelsPresented = app.presentPixels(pixels) &&
        app.presentPixels(pixels) && app.presentPixels(pixels)
    val frameSlotsPassed = app.backend != graphicsBackendVulkan ||
        (app.vulkanPixels.frameIndex == 1 &&
         app.vulkanPixels.first.inFlight &&
         app.vulkanPixels.second.inFlight)
    val buffer = app.buffer(BufferDescriptor(
        label = "common-storage",
        size = 64,
        usage = bufferUsageCopySource |
            bufferUsageCopyDestination | bufferUsageStorage
    ))
    val bufferWritten = buffer.writeI64(1311768465173141112, 8)
    val bufferRead = buffer.readI64(8)
    val invalidBuffer = app.buffer(BufferDescriptor(
        size = 0,
        usage = bufferUsageStorage
    ))
    val mappedBuffer = app.buffer(BufferDescriptor(
        size = 64,
        usage = bufferUsageMapWrite | bufferUsageCopySource,
        mappedAtCreation = true
    ))
    val readbackBuffer = app.buffer(BufferDescriptor(
        size = 64,
        usage = bufferUsageMapRead
    ))
    val sampler = app.sampler(SamplerDescriptor(
        addressU = samplerAddressRepeat,
        addressV = samplerAddressMirrorRepeat,
        magFilter = samplerFilterLinear,
        minFilter = samplerFilterLinear,
        mipmapFilter = samplerFilterLinear,
        compare = compareFunctionLessEqual
    ))
    val unsupportedSampler = app.sampler(SamplerDescriptor(
        maximumAnisotropy = 16
    ))
    val texture = app.texture(TextureDescriptor(
        label = "common-color",
        size = Extent3D(16, 16),
        mipLevels = 4,
        format = textureFormatRgba8Unorm,
        usage = textureUsageSampled | textureUsageCopyDestination
    ))
    val textureView = texture.view()
    val reinterpretedTextureView = texture.view(TextureViewDescriptor(
        format = textureFormatRgba8UnormSrgb
    ))
    val invalidTextureView = texture.view(TextureViewDescriptor(
        baseMipLevel = 4
    ))
    val depthTexture = app.texture(TextureDescriptor(
        label = "common-depth",
        size = Extent3D(16, 16),
        format = textureFormatDepth16Unorm,
        usage = textureUsageSampled | textureUsageRenderAttachment
    ))
    val depthTextureView = depthTexture.view(TextureViewDescriptor(
        aspect = textureAspectDepth
    ))
    val unsupportedTexture = app.texture(TextureDescriptor(
        size = Extent3D(16, 16),
        samples = 4,
        usage = textureUsageRenderAttachment
    ))
    val computeShader = $glsl {
        compute {
            #version 450
            layout(local_size_x = 8) in;
            void main() {}
        }
    }
    val compute = app.computePipeline(computeShader)
    val computed = compute.dispatch(2) && compute.dispatch(3)
    val unsupportedComputeShader = glslPackage(
        [shaderStageCompute],
        ["#version 450\nlayout(local_size_x=8) in; void main() { uint value = 1; }"]
    )
    val unsupportedCompute = app.computePipeline(unsupportedComputeShader)
    val storageShader = $glsl {
        compute {
            #version 450
            layout(local_size_x = 1) in;
            layout(std430, binding = 0) buffer Values {
                uint value;
            } values;
            void main() { values.value = values.value * 3u; }
        }
    }
    val computeBuffer = app.buffer(BufferDescriptor(
        size = 8,
        usage = bufferUsageStorage | bufferUsageCopySource |
            bufferUsageCopyDestination
    ))
    val computeBufferCleared = computeBuffer.writeI64(2)
    val storageCompute = app.computeStoragePipeline(
        storageShader,
        computeBuffer
    )
    val storageComputed = storageCompute.dispatch(1)
    val computeValue = computeBuffer.readI64()
    var resizePassed = true
    if (requestedBackend == graphicsBackendOpenGl ||
        requestedBackend == graphicsBackendVulkan) {
        resizePassed = app.resize(360, 240)
        var resizeEvent = WindowEvent()
        var attempts = 0
        while (resizePassed && resizeEvent.kind != windowEventResized &&
            attempts < 32) {
            resizeEvent = app.pollEvent(50)
            attempts = attempts + 1
        }
        resizePassed = resizeEvent.first == 360 &&
            resizeEvent.second == 240
        if (requestedBackend == graphicsBackendOpenGl) {
            resizePassed = resizePassed && app.openGl.width == 360 &&
                app.openGl.height == 240
        } else {
            resizePassed = resizePassed &&
                app.vulkanSwapchain.width == 360 &&
                app.vulkanSwapchain.height == 240 &&
                app.vulkanPixels.width == 360 &&
                app.vulkanPixels.height == 240
        }
        resizePassed = resizePassed && app.presentClear(Color(
                0.125,
                0.25,
                0.5
            ))
    }
    println(
        "${graphicsBackendName(requestedBackend)}: selected=${graphicsBackendName(app.backend)} valid=$valid presented=$presented pixels=$pixelsPresented buffer=${buffer.valid()} adapter='${app.adapterName}' error='${app.error.message}'"
    )
    valid && presented && pixelsPresented && frameSlotsPassed &&
        buffer.valid() && bufferWritten &&
        bufferRead == 1311768465173141112 &&
        !buffer.writeI64(1, 60) && !invalidBuffer.valid() &&
        invalidBuffer.error.code == graphicsErrorInvalidConfiguration &&
        !mappedBuffer.valid() &&
        mappedBuffer.error.operation ==
            "GraphicsApplication.buffer.mappedAtCreation" &&
        readbackBuffer.valid() && sampler.valid() &&
        !unsupportedSampler.valid() &&
        unsupportedSampler.error.code == graphicsErrorUnsupportedFeature &&
        texture.valid() && textureView.valid() &&
        textureView.descriptor.resolvedFormat(texture.descriptor) ==
            textureFormatRgba8Unorm &&
        (if (app.backend == graphicsBackendOpenGl)
            !reinterpretedTextureView.valid() &&
                reinterpretedTextureView.error.code ==
                    graphicsErrorUnsupportedFeature
         else reinterpretedTextureView.valid()) &&
        !invalidTextureView.valid() &&
        invalidTextureView.error.code == graphicsErrorInvalidConfiguration &&
        depthTexture.valid() && depthTextureView.valid() &&
        !unsupportedTexture.valid() &&
        unsupportedTexture.error.code == graphicsErrorUnsupportedFeature &&
        compute.valid() && computed && !compute.dispatch(0) &&
        !unsupportedCompute.valid() &&
        unsupportedCompute.error.code == graphicsErrorUnsupportedFeature &&
        computeBuffer.valid() && computeBufferCleared &&
        storageCompute.valid() && storageComputed && computeValue == 6 &&
        resizePassed
}

fun applicationUnavailableProbe(): bool {
    val app = graphicsApplication(
        GraphicsConfig(backend = graphicsBackendVulkan),
        WindowConfig(title = "Unavailable Vulkan", width = 320, height = 200)
    )
    val rejected = !app.valid() &&
        app.error.code == graphicsErrorBackendUnavailable
    println("unavailable vulkan: rejected=$rejected")
    rejected
}

fun main: int {
    val requested = if (processArgumentCount() > 0)
        processArgument(0)
    else ""
    if (requested == "unavailable") {
        if (applicationUnavailableProbe()) 42 else 1
    } else {
        val requestedBackend = if (requested == "opengl")
            graphicsBackendOpenGl
        else if (requested == "vulkan") graphicsBackendVulkan
        else graphicsBackendAuto
        val expectedBackend = if (
            requestedBackend == graphicsBackendOpenGl ||
            requested == "fallback"
        ) graphicsBackendOpenGl else graphicsBackendVulkan
        if (applicationBackendProbe(
            requestedBackend,
            expectedBackend,
            "Common $requested"
        )) 42 else 1
    }
}
