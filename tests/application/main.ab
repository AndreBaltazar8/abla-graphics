fun applicationUnavailableProbe(): bool {
    val app = graphicsApplication(
        GraphicsConfig(backend = graphicsBackendVulkan),
        WindowConfig(title = "Unavailable Vulkan", width = 320, height = 200)
    )
    val timestampQuery = app.timestampQuery()
    val rejected = !app.valid() &&
        app.error.code == graphicsErrorBackendUnavailable && !app.waitIdle() &&
        !timestampQuery.valid() && timestampQuery.error.code ==
            graphicsErrorInvalidConfiguration &&
        timestampQuery.sampleTicks() == -1
    println("unavailable vulkan: rejected=$rejected")
    rejected
}

fun applicationUnsupportedFeatureProbe(): bool {
    val app = graphicsApplication(
        GraphicsConfig(
            backend = graphicsBackendOpenGl,
            requiredFeatures = 512
        ),
        WindowConfig(
            title = "Unsupported OpenGL feature",
            width = 320,
            height = 200
        )
    )
    val rejected = !app.valid() &&
        app.error.code == graphicsErrorInvalidConfiguration
    println("unknown graphics feature: rejected=$rejected")
    rejected
}

fun main: int {
    val requested = if (processArgumentCount() > 0)
        processArgument(0)
    else ""
    if (requested == "unavailable") {
        if (applicationUnavailableProbe()) 42 else 1
    } else if (requested == "unsupported") {
        if (applicationUnsupportedFeatureProbe()) 42 else 1
    } else {
        val requestedBackend = if (requested == "opengl")
            graphicsBackendOpenGl
        else if (requested == "vulkan") graphicsBackendVulkan
        else graphicsBackendAuto
        val expectedBackend = if (
            requestedBackend == graphicsBackendOpenGl ||
            requested == "fallback"
        ) graphicsBackendOpenGl else graphicsBackendVulkan
        if (applicationBackendProbe(
            requestedBackend,
            expectedBackend,
            "Common $requested"
        )) 42 else 1
    }
}
