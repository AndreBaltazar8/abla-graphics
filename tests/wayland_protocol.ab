import "../src/platform/wayland.ab"
import "abla/unsafe/memory"

fun waylandTestGlobalPayload(
    name: int,
    interfaceName: string,
    version: int
): string {
    val length = interfaceName.size + 1
    val padded = waylandAligned(length)
    val payload = nativeByteBuffer(13 + padded)
    waylandStoreU32(payload, 0, name)
    waylandStoreU32(payload, 4, length)
    var index = 0
    while (index < interfaceName.size) {
        payload.store(8 + index, interfaceName[index])
        index = index + 1
    }
    payload.store(8 + interfaceName.size, 0)
    waylandStoreU32(payload, 8 + padded, version)
    payload.adoptString(12 + padded)
}

fun waylandTestToplevelConfigurePayload(): string {
    val payload = nativeByteBuffer(21)
    waylandStoreU32(payload, 0, 640)
    waylandStoreU32(payload, 4, 480)
    waylandStoreU32(payload, 8, 8)
    waylandStoreU32(payload, 12, 1)
    waylandStoreU32(payload, 16, 4)
    payload.adoptString(20)
}

fun waylandTestEmbeddedNull(): string {
    val value = nativeByteBuffer(10)
    value.store(0, 98)
    value.store(1, 97)
    value.store(2, 100)
    value.store(3, 0)
    value.store(4, 116)
    value.store(5, 105)
    value.store(6, 116)
    value.store(7, 108)
    value.store(8, 101)
    value.adoptString(9)
}

fun main: int {
    val getRegistry = waylandNewIdentifierRequest(1, 1, 2)
    val getRegistryMessage = waylandDecodeMessage(getRegistry)
    val global = waylandRegistryGlobal(
        waylandTestGlobalPayload(17, "wl_compositor", 6)
    )
    val bind = waylandRegistryBindRequest(2, global, 4, 3)
    val bindMessage = waylandDecodeMessage(bind)
    val bindInterface = waylandString(bindMessage.payload, 4)
    val bindVersion = if (bindInterface.valid)
        waylandU32(bindMessage.payload, bindInterface.next)
    else 0
    val bindIdentifier = if (bindInterface.valid)
        waylandU32(bindMessage.payload, bindInterface.next + 4)
    else 0
    val malformedLength = waylandDecodeMessage(
        "\u{1}\u{0}\u{0}\u{0}\u{0}\u{0}\u{12}\u{0}"
    )
    val malformedString = waylandRegistryGlobal(
        "\u{1}\u{0}\u{0}\u{0}\u{2}\u{0}\u{0}\u{0}x\u{1}\u{0}\u{0}\u{1}\u{0}\u{0}\u{0}"
    )
    val interiorNullString = waylandRegistryGlobal(
        "\u{1}\u{0}\u{0}\u{0}\u{3}\u{0}\u{0}\u{0}x\u{0}\u{0}\u{0}\u{1}\u{0}\u{0}\u{0}"
    )
    val title = waylandStringRequest(8, 2, "Abla")
    val titleMessage = waylandDecodeMessage(title)
    val titleText = waylandString(titleMessage.payload, 0)
    val identifiers = waylandU32PairPayload(11, 12)
    val getXdgSurface = waylandDecodeMessage(
        waylandPacket(5, 2, identifiers)
    )
    val getToplevel = waylandDecodeMessage(
        waylandNewIdentifierRequest(11, 1, 13)
    )
    val initialCommit = waylandDecodeMessage(waylandPacket(12, 6))
    val acknowledge = waylandDecodeMessage(
        waylandPacket(11, 4, waylandU32Payload(99))
    )
    val pong = waylandDecodeMessage(
        waylandPacket(5, 3, waylandU32Payload(101))
    )
    val createBuffer = waylandDecodeMessage(waylandPacket(
        14,
        0,
        waylandU32ArrayPayload([15, 0, 320, 200, 1280, 1])
    ))
    val configured = waylandToplevelConfigure(
        waylandTestToplevelConfigurePayload()
    )
    val malformedConfigure = waylandToplevelConfigure(
        "\u{80}\u{2}\u{0}\u{0}\u{224}\u{1}\u{0}\u{0}\u{3}\u{0}\u{0}\u{0}abc\u{0}"
    )
    if (getRegistry.size == 12 && getRegistryMessage.valid &&
        getRegistryMessage.objectIdentifier == 1 &&
        getRegistryMessage.opcode == 1 &&
        getRegistryMessage.payload.size == 4 &&
        waylandU32(getRegistryMessage.payload, 0) == 2 &&
        global.valid && global.name == 17 &&
        global.interfaceName == "wl_compositor" && global.version == 6 &&
        bindMessage.valid && bindMessage.objectIdentifier == 2 &&
        bindMessage.opcode == 0 &&
        waylandU32(bindMessage.payload, 0) == 17 &&
        bindInterface.valid && bindInterface.text == "wl_compositor" &&
        bindVersion == 4 && bindIdentifier == 3 &&
        title.size == 20 && titleMessage.valid &&
        titleMessage.objectIdentifier == 8 && titleMessage.opcode == 2 &&
        titleText.valid && titleText.text == "Abla" &&
        waylandStringRequest(8, 2, "").size == 16 &&
        waylandStringRequest(8, 2, waylandTestEmbeddedNull()) == "" &&
        identifiers.size == 8 && waylandU32(identifiers, 0) == 11 &&
        waylandU32(identifiers, 4) == 12 &&
        getXdgSurface.valid && getXdgSurface.objectIdentifier == 5 &&
        getXdgSurface.opcode == 2 &&
        waylandU32(getXdgSurface.payload, 0) == 11 &&
        waylandU32(getXdgSurface.payload, 4) == 12 &&
        getToplevel.valid && getToplevel.objectIdentifier == 11 &&
        getToplevel.opcode == 1 &&
        waylandU32(getToplevel.payload, 0) == 13 &&
        initialCommit.valid && initialCommit.objectIdentifier == 12 &&
        initialCommit.opcode == 6 && initialCommit.payload.size == 0 &&
        acknowledge.valid && acknowledge.objectIdentifier == 11 &&
        acknowledge.opcode == 4 && waylandU32(acknowledge.payload, 0) == 99 &&
        pong.valid && pong.objectIdentifier == 5 && pong.opcode == 3 &&
        waylandU32(pong.payload, 0) == 101 &&
        createBuffer.valid && createBuffer.objectIdentifier == 14 &&
        createBuffer.opcode == 0 && createBuffer.payload.size == 24 &&
        waylandU32(createBuffer.payload, 0) == 15 &&
        waylandU32(createBuffer.payload, 8) == 320 &&
        waylandU32(createBuffer.payload, 12) == 200 &&
        waylandU32(createBuffer.payload, 16) == 1280 &&
        waylandU32(createBuffer.payload, 20) == 1 &&
        configured.valid && configured.width == 640 &&
        configured.height == 480 && configured.states.size == 2 &&
        configured.states[0] == 1 && configured.states[1] == 4 &&
        !malformedConfigure.valid &&
        !malformedLength.valid && !malformedString.valid &&
        !interiorNullString.valid &&
        waylandDescriptor("0") == 0 && waylandDescriptor("17") == 17 &&
        waylandDescriptor("2147483647") == 2147483647 &&
        waylandDescriptor("") < 0 && waylandDescriptor("-1") < 0 &&
        waylandDescriptor("2147483648") < 0 &&
        waylandDisplayIdentifier == 1) 42 else 1
}
