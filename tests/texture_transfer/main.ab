import "abla/io"
import "abla/process/arguments"
import "abla/runtime/memory"
import "../../src/graphics.ab"

fun pixelsEqual(left: PixelBuffer, right: PixelBuffer): bool {
    var equal = left.valid() && right.valid() &&
        left.width == right.width && left.height == right.height
    var y = 0
    while (equal && y < left.height) {
        var x = 0
        while (equal && x < left.width) {
            equal = left.rgba8(x, y) == right.rgba8(x, y)
            x = x + 1
        }
        y = y + 1
    }
    equal
}

trusted fun textureTransferProbe(requestedBackend: int): bool {
    val app = graphicsApplication(
        GraphicsConfig(
            backend = requestedBackend,
            requiredFeatures = graphicsFeaturePersistentMapping
        ),
        WindowConfig(
            title = "Abla asynchronous texture transfers",
            width = 96,
            height = 64
        )
    )
    val usage = textureUsageCopySource |
        textureUsageCopyDestination | textureUsageSampled
    val rgba = app.texture(TextureDescriptor(
        label = "async-rgba",
        size = Extent3D(8, 4),
        format = textureFormatRgba8Unorm,
        usage = usage
    ))
    val bgra = app.texture(TextureDescriptor(
        label = "async-bgra",
        size = Extent3D(8, 4),
        format = textureFormatBgra8Unorm,
        usage = usage
    ))
    val source = pixelBuffer(2, 2)
    val sourceReady = source.setRgba8(0, 0, 17, 34, 51, 68) &&
        source.setRgba8(1, 0, 85, 102, 119, 136) &&
        source.setRgba8(0, 1, 153, 170, 187, 204) &&
        source.setRgba8(1, 1, 221, 238, 255, 16)
    val upload = app.textureTransferQueue(TextureTransferQueueDescriptor(
        label = "async-texture-upload",
        direction = textureTransferDirectionUpload,
        slotCapacity = 64,
        slotCount = 2,
        alignment = 16
    ))
    val uploadStagingHandle = if (app.backend == graphicsBackendOpenGl)
        upload.transfers.staging.openGl.handle
    else upload.transfers.staging.vulkan.handle
    val uploadPool0 = if (app.backend == graphicsBackendVulkan)
        upload.transfers.vulkanSlots[0].commandPool else 0
    val uploadPool1 = if (app.backend == graphicsBackendVulkan)
        upload.transfers.vulkanSlots[1].commandPool else 0
    val uploadCommand0 = if (app.backend == graphicsBackendVulkan)
        nativePointerAddress(
            upload.transfers.vulkanSlots[0].command.load()
        )
    else 0
    val uploadCommand1 = if (app.backend == graphicsBackendVulkan)
        nativePointerAddress(
            upload.transfers.vulkanSlots[1].command.load()
        )
    else 0
    val uploadTicket0 = app.enqueueUploadTextureRange(
        upload,
        source,
        rgba,
        0,
        1,
        1
    )
    val uploadTicket1 = app.enqueueUploadTextureRange(
        upload,
        source,
        bgra,
        0,
        4,
        1
    )
    val uploadInFlight = textureTransferTicketValid(uploadTicket0) &&
        textureTransferTicketValid(uploadTicket1) &&
        (if (app.backend == graphicsBackendOpenGl)
            upload.transfers.openGlSlots[0].inFlight() &&
            upload.transfers.openGlSlots[1].inFlight()
         else upload.transfers.vulkanSlots[0].inFlight() &&
            upload.transfers.vulkanSlots[1].inFlight())
    val uploadsCompleted = upload.wait(uploadTicket0) &&
        upload.wait(uploadTicket1)
    val oversized = pixelBuffer(5, 4)
    val queuedBeforeInvalid = upload.transfers.queuedCount
    val invalidUpload = app.enqueueUploadTexture(
        upload,
        oversized,
        rgba,
        TextureWriteDescriptor()
    )
    val invalidUploadRejected = !textureTransferTicketValid(invalidUpload) &&
        upload.transfers.queuedCount == queuedBeforeInvalid
    val uploadLiveBefore = runtimeMemoryLiveBytes()
    var uploadRepeated = true
    var uploadRepeat = 0
    while (uploadRepeated && uploadRepeat < 6) {
        val ticket = app.enqueueUploadTextureRange(
            upload,
            source,
            rgba,
            0,
            1,
            1
        )
        uploadRepeated = textureTransferTicketValid(ticket) &&
            upload.wait(ticket)
        uploadRepeat = uploadRepeat + 1
    }
    val uploadLiveAfter = runtimeMemoryLiveBytes()
    val uploadHandlesStable = if (app.backend == graphicsBackendOpenGl)
        upload.transfers.staging.openGl.handle == uploadStagingHandle
    else upload.transfers.staging.vulkan.handle == uploadStagingHandle &&
        upload.transfers.vulkanSlots[0].commandPool == uploadPool0 &&
        upload.transfers.vulkanSlots[1].commandPool == uploadPool1 &&
        nativePointerAddress(
            upload.transfers.vulkanSlots[0].command.load()
        ) == uploadCommand0 && nativePointerAddress(
            upload.transfers.vulkanSlots[1].command.load()
        ) == uploadCommand1

    val readback = app.textureTransferQueue(TextureTransferQueueDescriptor(
        label = "async-texture-readback",
        direction = textureTransferDirectionReadback,
        slotCapacity = 64,
        slotCount = 2,
        alignment = 16
    ))
    val readbackStagingHandle = if (app.backend == graphicsBackendOpenGl)
        readback.transfers.staging.openGl.handle
    else readback.transfers.staging.vulkan.handle
    val readbackTicket0 = app.enqueueReadbackTextureRange(
        readback,
        rgba,
        0,
        1,
        1,
        2,
        2
    )
    val readbackTicket1 = app.enqueueReadbackTextureRange(
        readback,
        bgra,
        0,
        4,
        1,
        2,
        2
    )
    val readbackInFlight = textureTransferTicketValid(readbackTicket0) &&
        textureTransferTicketValid(readbackTicket1) &&
        (if (app.backend == graphicsBackendOpenGl)
            readback.transfers.openGlSlots[0].inFlight() &&
            readback.transfers.openGlSlots[1].inFlight()
         else readback.transfers.vulkanSlots[0].inFlight() &&
            readback.transfers.vulkanSlots[1].inFlight())
    val rgbaResult = pixelBuffer(2, 2)
    val bgraResult = pixelBuffer(2, 2)
    val readbacksCompleted = app.waitTextureReadback(
        readback,
        readbackTicket0,
        rgbaResult
    ) && app.waitTextureReadback(
        readback,
        readbackTicket1,
        bgraResult
    )
    val readbacksExact = pixelsEqual(source, rgbaResult) &&
        pixelsEqual(source, bgraResult)
    val replacement = app.enqueueReadbackTextureRange(
        readback,
        rgba,
        0,
        1,
        1,
        2,
        2
    )
    val staleRejected = textureTransferTicketValid(replacement) &&
        textureTransferTicketSlot(replacement) ==
            textureTransferTicketSlot(readbackTicket0) &&
        textureTransferTicketGeneration(replacement) ==
            textureTransferTicketGeneration(readbackTicket0) + 1 &&
        !readback.poll(readbackTicket0) &&
        app.waitTextureReadback(readback, replacement, rgbaResult)
    val readbackLiveBefore = runtimeMemoryLiveBytes()
    var readbackRepeated = true
    var readbackRepeat = 0
    while (readbackRepeated && readbackRepeat < 5) {
        val ticket = app.enqueueReadbackTextureRange(
            readback,
            bgra,
            0,
            4,
            1,
            2,
            2
        )
        readbackRepeated = textureTransferTicketValid(ticket) &&
            app.waitTextureReadback(readback, ticket, bgraResult) &&
            pixelsEqual(source, bgraResult)
        readbackRepeat = readbackRepeat + 1
    }
    val readbackLiveAfter = runtimeMemoryLiveBytes()
    val readbackHandleStable = if (app.backend == graphicsBackendOpenGl)
        readback.transfers.staging.openGl.handle == readbackStagingHandle
    else readback.transfers.staging.vulkan.handle == readbackStagingHandle
    val passed = app.valid() && rgba.valid() && bgra.valid() && sourceReady &&
        upload.valid() && uploadInFlight && uploadsCompleted &&
        invalidUploadRejected && uploadRepeated && uploadRepeat == 6 &&
        uploadLiveAfter == uploadLiveBefore && uploadHandlesStable &&
        readback.valid() && readbackInFlight && readbacksCompleted &&
        readbacksExact && staleRejected && readbackRepeated &&
        readbackRepeat == 5 && readbackLiveAfter == readbackLiveBefore &&
        readbackHandleStable && upload.transfers.queuedCount == 8 &&
        upload.transfers.completedCount == 8 &&
        readback.transfers.queuedCount == 8 &&
        readback.transfers.completedCount == 8
    println(
        "async-texture ${graphicsBackendName(app.backend)}: upload=$uploadInFlight/$uploadsCompleted/$uploadRepeated readback=$readbackInFlight/$readbacksCompleted/$readbackRepeated exact=$readbacksExact live=${uploadLiveAfter - uploadLiveBefore}/${readbackLiveAfter - readbackLiveBefore} stable=$uploadHandlesStable/$readbackHandleStable stale=$staleRejected"
    )
    passed
}

fun main: int {
    val requested = if (processArgumentCount() > 0)
        processArgument(0)
    else ""
    val backend = if (requested == "opengl") graphicsBackendOpenGl
        else if (requested == "vulkan") graphicsBackendVulkan
        else graphicsBackendAuto
    if (textureTransferProbe(backend)) 42 else 1
}
