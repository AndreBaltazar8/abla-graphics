    val uniform4F = registryIndex(commands, "glProgramUniform4f")
    val clearDepth = registryIndex(commands, "glClearDepth")
    val depthRange = registryIndex(commands, "glDepthRange")
    val binormal3D = registryIndex(commands, "glBinormal3dEXT")
    val color4D = registryIndex(commands, "glColor4d")
