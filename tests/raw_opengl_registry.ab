import "../src/raw/opengl_registry.ab"

fun registryContains(values: array<string>, wanted: string): bool {
    var found = false
    var index = 0
    while (!found && index < values.size) {
        found = values[index] == wanted
        index = index + 1
    }
    found
}

fun registryIndex(values: array<string>, wanted: string): int {
    var found = -1
    var index = 0
    while (found < 0 && index < values.size) {
        if (values[index] == wanted) found = index
        index = index + 1
    }
    found
}

fun registryParameterIndex(
    owners: array<string>,
    names: array<string>,
    owner: string,
    wanted: string
): int {
    var found = -1
    var index = 0
    while (found < 0 && index < owners.size && index < names.size) {
        if (owners[index] == owner && names[index] == wanted) found = index
        index = index + 1
    }
    found
}

fun main: int {
    val commands = rawOpenGlRegistryCommands()
    val statuses = rawOpenGlRegistryCommandStatuses()
    val constants = rawOpenGlRegistryConstantNames()
    val types = rawOpenGlRegistryTypes()
    val categories = rawOpenGlRegistryTypeCategories()
    val aliases = rawOpenGlRegistryTypeAliases()
    val dependencies = rawOpenGlRegistryTypeDependencies()
    val returns = rawOpenGlRegistryCommandReturnTypes()
    val parameterCounts = rawOpenGlRegistryCommandParameterCounts()
    val owners = rawOpenGlRegistryCommandParameterOwners()
    val names = rawOpenGlRegistryCommandParameterNames()
    val parameterTypes = rawOpenGlRegistryCommandParameterTypes()
    val pointers = rawOpenGlRegistryCommandParameterPointerLevels()
    val constness = rawOpenGlRegistryCommandParameterConstness()
    val callShapes = rawOpenGlRegistryCommandCallShapes()
    val callAbis = rawOpenGlRegistryCommandCallAbis()
    val glEnum = registryIndex(types, "GLenum")
    val glClear = registryIndex(commands, "glClear")
    val mask = registryParameterIndex(owners, names, "glClear", "mask")
    val valid = rawOpenGlRegistryCommandCount == 2892 &&
        rawOpenGlRegistryCoreFeatureCount == 19 &&
        rawOpenGlRegistryExtensionCount == 623 &&
        rawOpenGlRegistryConstantCount == 6271 &&
        rawOpenGlRegistryTypeCount == 43 &&
        constants.size == rawOpenGlRegistryConstantCount &&
        types.size == rawOpenGlRegistryTypeCount &&
        categories.size == types.size && aliases.size == types.size &&
        dependencies.size == types.size && glEnum >= 0 &&
        categories[glEnum] == "declaration" &&
        registryContains(types, "GLDEBUGPROC") &&
        registryContains(constants, "GL_COLOR_BUFFER_BIT") &&
        GL_COLOR_BUFFER_BIT == 0x00004000 &&
        GL_ACTIVE_PROGRAM_EXT == 0x8B8D && GL_TIMEOUT_IGNORED == -1 &&
        commands.size == rawOpenGlRegistryCommandCount &&
        statuses.size == commands.size && returns.size == commands.size &&
        parameterCounts.size == commands.size && owners.size == 9526 &&
        names.size == owners.size && parameterTypes.size == owners.size &&
        pointers.size == owners.size && constness.size == owners.size &&
        glClear >= 0 && returns[glClear] == "void" &&
        parameterCounts[glClear] == "1" && mask >= 0 &&
        parameterTypes[mask] == "GLbitfield" && pointers[mask] == "0" &&
        constness[mask] == "false" && callShapes.size == commands.size &&
        callAbis.size == commands.size &&
        callShapes[glClear] == "void(GLbitfield)" &&
        callAbis[glClear] == "void(i32)" &&
        registryContains(commands, "glQueryCounter") &&
        registryContains(statuses, "common") &&
        registryContains(statuses, "unclassified") &&
        rawOpenGlRegistryAggregates().size == 0 &&
        rawOpenGlRegistryAggregateMemberNames().size == 0
    if (valid) 42 else 1
}
