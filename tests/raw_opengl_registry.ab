        callShapes[glClear] == "void(GLbitfield)" &&
        callAbis[glClear] == "void(i32)" &&
        viewport >= 0 &&
        callAbis[viewport] == "void(i32,i32,i32,i32)" &&
        getInteger >= 0 && callAbis[getInteger] == "void(i32,pointer)" &&
