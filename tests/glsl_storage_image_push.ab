import "../src/shader/glsl.ab"
import "../src/shader/glsl_spirv.ab"

fun spirvContainsSequence(
    module: SpirvModule,
    sequence: array<int>
): bool {
    var found = sequence.size > 0
    var begin = 0
    while (found && begin <= module.words.size - sequence.size) {
        var matches = true
        var index = 0
        while (matches && index < sequence.size) {
            matches = module.words[begin + index] == sequence[index]
            index = index + 1
        }
        if (matches) return true
        begin = begin + 1
    }
    false
}

fun spirvContainsWord(module: SpirvModule, word: int): bool {
    var found = false
    var index = 0
    while (!found && index < module.words.size) {
        found = module.words[index] == word
        index = index + 1
    }
    found
}

fun storageImagePushDimensionValid(
    dataType: string,
    coordinateType: string,
    dimension: int,
    arrayed: int,
    cube: bool
): bool {
    val source = "#version 450\nlayout(local_size_x=1) in; layout(rgba8,binding=0) uniform writeonly $dataType target; layout(push_constant) uniform Dynamic { $coordinateType point; vec4 shade; } parameters; void main(){ imageStore(target,parameters.point,parameters.shade); }"
    val package = glslPackage([shaderStageCompute], [source])
    val emitted = package.spirv(shaderStageCompute)
    package.valid && emitted.succeeded && emitted.module.valid() &&
        emitted.module.bound() == 24 && spirvContainsSequence(
            emitted.module,
            [589849, 4, 3, dimension, 0, arrayed, 0, 2, 4]
        ) && (cube == spirvContainsSequence(
            emitted.module,
            [131089, 44]
        ))
}

fun storageImagePushReadArithmeticDimensionValid(
    dataType: string,
    coordinateType: string,
    dimension: int,
    arrayed: int,
    cube: bool,
    operation: string = "+",
    opcode: int = 327809
): bool {
    val source = "#version 450\nlayout(local_size_x=1) in; layout(rgba8,binding=0) uniform $dataType target; layout(push_constant) uniform Dynamic { $coordinateType point; vec4 shade; } parameters; void main(){ vec4 loaded=imageLoad(target,parameters.point); imageStore(target,parameters.point,loaded$operation parameters.shade); }"
    val package = glslPackage([shaderStageCompute], [source])
    val emitted = package.spirv(shaderStageCompute)
    package.valid && emitted.succeeded && emitted.module.valid() &&
        emitted.module.bound() == 26 && spirvContainsSequence(
            emitted.module,
            [589849, 4, 3, dimension, 0, arrayed, 0, 2, 4]
        ) && spirvContainsSequence(emitted.module, [327778, 9, 24, 19, 21]) &&
        spirvContainsSequence(emitted.module, [opcode, 9, 25, 24, 23]) &&
        (cube == spirvContainsSequence(emitted.module, [131089, 44]))
}

fun storageImagePushInvalidArithmeticRejected(): bool {
    val source = "#version 450\nlayout(local_size_x=1) in; layout(rgba8,binding=0) uniform image2D target; layout(push_constant) uniform Dynamic { ivec2 point; vec4 shade; } parameters; void main(){ vec4 loaded=imageLoad(target,parameters.point); imageStore(target,parameters.point,loaded%parameters.shade); }"
    val package = glslPackage([shaderStageCompute], [source])
    package.valid && !package.spirv(shaderStageCompute).succeeded
}

fun storageImagePushStagedArithmeticValid(): bool {
    val source = "#version 450\nlayout(local_size_x=1) in; layout(rgba8,binding=0) uniform image2DArray target; layout(push_constant) uniform Dynamic { ivec3 point; vec4 shade; } parameters; void main(){ vec4 sampled=imageLoad(target,parameters.point); vec4 composed=sampled+parameters.shade; imageStore(target,parameters.point,composed); }"
    val package = glslPackage([shaderStageCompute], [source])
    val emitted = package.spirv(shaderStageCompute)
    package.valid && emitted.succeeded && emitted.module.valid() &&
        emitted.module.bound() == 26 && spirvContainsSequence(
            emitted.module, [327778, 9, 24, 19, 21]
        ) && spirvContainsSequence(
            emitted.module, [327809, 9, 25, 24, 23]
        ) && spirvContainsSequence(emitted.module, [262243, 19, 21, 25])
}

fun storageImagePushInvalidStagedLocalRejected(): bool {
    val source = "#version 450\nlayout(local_size_x=1) in; layout(rgba8,binding=0) uniform image2D target; layout(push_constant) uniform Dynamic { ivec2 point; vec4 shade; } parameters; void main(){ vec4 sampled=imageLoad(target,parameters.point); vec4 composed=missing+parameters.shade; imageStore(target,parameters.point,composed); }"
    val package = glslPackage([shaderStageCompute], [source])
    package.valid && !package.spirv(shaderStageCompute).succeeded
}

fun storageImagePushNestedLocalChainValid(): bool {
    val source = "#version 450\nlayout(local_size_x=1) in; layout(rgba8,binding=0) uniform image3D target; layout(push_constant) uniform Dynamic { ivec3 point; vec4 shade; } parameters; void main(){ vec4 loaded=imageLoad(target,parameters.point); vec4 first=loaded+parameters.shade; vec4 second=(first*parameters.shade)-loaded; imageStore(target,parameters.point,second/parameters.shade); }"
    val package = glslPackage([shaderStageCompute], [source])
    val emitted = package.spirv(shaderStageCompute)
    package.valid && emitted.succeeded && emitted.module.valid() &&
        emitted.module.bound() == 29 && spirvContainsSequence(
            emitted.module, [327809, 9, 25, 24, 23]
        ) && spirvContainsSequence(
            emitted.module, [327813, 9, 26, 25, 23]
        ) && spirvContainsSequence(
            emitted.module, [327811, 9, 27, 26, 24]
        ) && spirvContainsSequence(
            emitted.module, [327816, 9, 28, 27, 23]
        ) && spirvContainsSequence(emitted.module, [262243, 19, 21, 28])
}

fun storageImagePushMutableLocalValid(): bool {
    val source = "#version 450\nlayout(local_size_x=1) in; layout(rgba8,binding=0) uniform image2D target; layout(push_constant) uniform Dynamic { ivec2 point; vec4 shade; } parameters; void main(){ vec4 loaded=imageLoad(target,parameters.point); vec4 composed=loaded; composed+=parameters.shade; composed-=vec4(0.25); composed*=vec4(0.5); composed/=vec4(0.5); composed=composed+parameters.shade; imageStore(target,parameters.point,composed); }"
    val package = glslPackage([shaderStageCompute], [source])
    val emitted = package.spirv(shaderStageCompute)
    package.valid && emitted.succeeded && emitted.module.valid() &&
        spirvContainsWord(emitted.module, 327809) &&
        spirvContainsWord(emitted.module, 327811) &&
        spirvContainsWord(emitted.module, 327813) &&
        spirvContainsWord(emitted.module, 327816)
}

fun storageImagePushInvalidMutableLocalRejected(): bool {
    val source = "#version 450\nlayout(local_size_x=1) in; layout(rgba8,binding=0) uniform image2D target; layout(push_constant) uniform Dynamic { ivec2 point; vec4 shade; } parameters; void main(){ vec4 loaded=imageLoad(target,parameters.point); loaded%=parameters.shade; imageStore(target,parameters.point,loaded); }"
    val package = glslPackage([shaderStageCompute], [source])
    package.valid && !package.spirv(shaderStageCompute).succeeded
}

fun storageImagePushConstructedBuiltinChainValid(): bool {
    val source = "#version 450\nlayout(local_size_x=1) in; layout(rgba8,binding=0) uniform image2D target; layout(push_constant) uniform Dynamic { ivec2 point; vec4 shade; } parameters; void main(){ vec4 loaded=imageLoad(target,parameters.point); vec4 reversed=loaded.wzyx; vec4 assembled=vec4(reversed.x,parameters.shade.y,loaded.z,1.0); vec4 bounded=clamp(assembled,vec4(0.0),vec4(1.0)); imageStore(target,parameters.point,max(bounded,loaded)); }"
    val package = glslPackage([shaderStageCompute], [source])
    val emitted = package.spirv(shaderStageCompute)
    package.valid && emitted.succeeded && emitted.module.valid() &&
        emitted.module.bound() >= 28 && spirvContainsSequence(
            emitted.module,
            [393227, 24, 1280527431, 1685353262, 808793134, 0]
        ) && spirvContainsSequence(emitted.module, [24, 43]) &&
        spirvContainsSequence(emitted.module, [24, 40])
}

fun storageImageComputedCoordinateValid(
    dataType: string,
    coordinateType: string,
    coordinateValue: string
): bool {
    val coordinateLocals = if (coordinateType == "int")
        "int selected=(parameters.point+1)-1;"
    else "int zero=0; $coordinateType selected=parameters.point+$coordinateValue;"
    val source = "#version 450\nlayout(local_size_x=1) in; layout(rgba8,binding=0) uniform $dataType target; layout(push_constant) uniform Dynamic { $coordinateType point; vec4 shade; } parameters; void main(){ $coordinateLocals vec4 loaded=imageLoad(target,selected); imageStore(target,selected*1,loaded+parameters.shade); }"
    val package = glslPackage([shaderStageCompute], [source])
    val emitted = package.spirv(shaderStageCompute)
    package.valid && emitted.succeeded && emitted.module.valid() &&
        spirvContainsWord(emitted.module, 327808) &&
        spirvContainsWord(emitted.module, 327812) &&
        (coordinateType != "int" ||
         spirvContainsWord(emitted.module, 327810))
}

fun storageImageInvalidCoordinateWidthRejected(): bool {
    val source = "#version 450\nlayout(local_size_x=1) in; layout(rgba8,binding=0) uniform image2D target; layout(push_constant) uniform Dynamic { ivec2 point; vec4 shade; } parameters; void main(){ ivec3 wrong=ivec3(0,0,0); vec4 loaded=imageLoad(target,wrong); imageStore(target,wrong,loaded+parameters.shade); }"
    val package = glslPackage([shaderStageCompute], [source])
    package.valid && !package.spirv(shaderStageCompute).succeeded
}

fun ordinaryStoragePushUnaffected(): bool {
    val source = "#version 450\nlayout(local_size_x=1) in; layout(std430,binding=0) buffer Values { uint value; } values; layout(push_constant) uniform Push { uint addend; } push; void main(){ values.value=values.value+push.addend; }"
    val package = glslPackage([shaderStageCompute], [source])
    val emitted = package.spirv(shaderStageCompute)
    package.valid && package.bindings.size == 1 &&
        package.bindings[0].storage == "buffer" &&
        package.pushConstants.size == 1 &&
        package.pushConstants[0].members.size == 1 &&
        emitted.succeeded && emitted.module.valid()
}

fun main: int {
    val checks = [storageImagePushDimensionValid(
        "image1D", "int", 0, 0, false
    ), storageImagePushDimensionValid(
        "image2D", "ivec2", 1, 0, false
    ), storageImagePushDimensionValid(
        "image2DArray", "ivec3", 1, 1, false
    ), storageImagePushDimensionValid(
        "image3D", "ivec3", 2, 0, false
    ), storageImagePushDimensionValid(
        "imageCube", "ivec3", 3, 0, true
    ), storageImagePushReadArithmeticDimensionValid(
        "image1D", "int", 0, 0, false
    ), storageImagePushReadArithmeticDimensionValid(
        "image2D", "ivec2", 1, 0, false
    ), storageImagePushReadArithmeticDimensionValid(
        "image2DArray", "ivec3", 1, 1, false
    ), storageImagePushReadArithmeticDimensionValid(
        "image3D", "ivec3", 2, 0, false
    ), storageImagePushReadArithmeticDimensionValid(
        "imageCube", "ivec3", 3, 0, true
    ), storageImagePushReadArithmeticDimensionValid(
        "image2D", "ivec2", 1, 0, false, "-", 327811
    ), storageImagePushReadArithmeticDimensionValid(
        "image2D", "ivec2", 1, 0, false, "*", 327813
    ), storageImagePushReadArithmeticDimensionValid(
        "image2D", "ivec2", 1, 0, false, "/", 327816
    ), storageImagePushStagedArithmeticValid(
    ), storageImagePushInvalidArithmeticRejected(
    ), storageImagePushInvalidStagedLocalRejected(
    ), storageImagePushNestedLocalChainValid(
    ), storageImagePushMutableLocalValid(
    ), storageImagePushInvalidMutableLocalRejected(
    ), storageImagePushConstructedBuiltinChainValid(
    ), storageImageComputedCoordinateValid(
        "image1D", "int", "0"
    ), storageImageComputedCoordinateValid(
        "image2D", "ivec2", "ivec2(zero,zero)"
    ), storageImageComputedCoordinateValid(
        "image2DArray", "ivec3", "ivec3(zero,zero,zero)"
    ), storageImageComputedCoordinateValid(
        "image3D", "ivec3", "ivec3(zero,zero,zero)"
    ), storageImageComputedCoordinateValid(
        "imageCube", "ivec3", "ivec3(zero,zero,zero)"
    ), storageImageInvalidCoordinateWidthRejected(
    ), ordinaryStoragePushUnaffected()]
    var index = 0
    while (index < checks.size && checks[index]) index = index + 1
    if (index == checks.size) 42 else index + 1
}
