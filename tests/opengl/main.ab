import "abla/runtime/memory"
import "abla/io"
import "../../src/driver/opengl_debug.ab"

fun main: int {
    val context = openGlHeadlessContext()
    val capabilities = context.capabilities()
    val invalidShader = openGlCompileShader(
        35633,
        "#version 450\nvoid main( { gl_Position = vec4(0.0); }"
    )
    val emptyProgram = glCreateProgram()
    var emptyProgramError = ""
    var emptyProgramRejected = false
    if (emptyProgram != 0) {
        glLinkProgram(emptyProgram)
        val linked = nativeI64Cell(1)
        glGetProgramiv(emptyProgram, 35714, linked.address)
        emptyProgramRejected = (linked.load() & 4294967295) == 0
        emptyProgramError = openGlProgramLog(emptyProgram)
        glDeleteProgram(emptyProgram)
    }
    val validProgram = openGlProgram(
        "#version 450\nlayout(location=0) in vec2 position; void main(){ gl_Position=vec4(position,0.0,1.0); }",
        "#version 450\nlayout(location=0) out vec4 color; void main(){ color=vec4(1.0); }"
    )
    val validProgramHandle = validProgram.handle
    var shaderLifecyclePassed = invalidShader.handle == 0 &&
        invalidShader.error != "" && emptyProgram != 0 &&
        emptyProgramRejected && validProgram.valid()
    if (shaderLifecyclePassed) {
        glUseProgram(validProgram.handle)
        shaderLifecyclePassed = glGetError() == 0
        glUseProgram(0)
        shaderLifecyclePassed = shaderLifecyclePassed && glGetError() == 0
    }
    validProgram.drop()
    shaderLifecyclePassed = shaderLifecyclePassed &&
        validProgramHandle != 0 && !validProgram.valid()
    val debug = context.debugMessenger()
    val debugCallbackAddress = debug.callbackAddress
    val debugMessage = "Abla OpenGL debug message"
    val debugWarmup = debug.valid() && debug.submit(
        openGlDebugTypeMarker,
        openGlDebugSeverityLow,
        debugMessage
    )
    val debugBefore = debug.counts()
    val debugLiveBefore = runtimeMemoryLiveBytes()
    var debugPassed = debugWarmup && debug.submit(
        openGlDebugTypeError,
        openGlDebugSeverityHigh,
        debugMessage
    ) && debug.submit(
        openGlDebugTypePerformance,
        openGlDebugSeverityMedium,
        debugMessage
    ) && debug.submit(
        openGlDebugTypeDeprecatedBehavior,
        openGlDebugSeverityLow,
        debugMessage
    )
    var repeat = 0
    while (debugPassed && repeat < 4) {
        debugPassed = debug.submit(
            openGlDebugTypeMarker,
            openGlDebugSeverityNotification,
            debugMessage
        )
        repeat = repeat + 1
    }
    debugPassed = debugPassed &&
        !debug.submit(0, openGlDebugSeverityLow, debugMessage) &&
        !debug.submit(openGlDebugTypeMarker, 0, debugMessage) &&
        !debug.submit(openGlDebugTypeMarker, openGlDebugSeverityLow, "")
    val debugLiveAfter = runtimeMemoryLiveBytes()
    val debugAfter = debug.counts()
    val noDebug = context.debugMessenger(false)
    debugPassed = debugPassed && debug.callbackAddress ==
        debugCallbackAddress && debugLiveAfter == debugLiveBefore &&
        !noDebug.valid() && !noDebug.submit(
            openGlDebugTypeMarker,
            openGlDebugSeverityLow,
            debugMessage
        ) &&
        debugAfter.total - debugBefore.total == 7 &&
        debugAfter.high - debugBefore.high == 1 &&
        debugAfter.medium - debugBefore.medium == 1 &&
        debugAfter.low - debugBefore.low == 1 &&
        debugAfter.notification - debugBefore.notification == 4 &&
        debugAfter.error - debugBefore.error == 1 &&
        debugAfter.performance - debugBefore.performance == 1 &&
        debugAfter.deprecatedBehavior - debugBefore.deprecatedBehavior == 1 &&
        debugAfter.marker - debugBefore.marker == 4
    debug.drop()
    debugPassed = debugPassed && !debug.valid() && context.makeCurrent()
    var result = 42
    if (!context.valid()) result = 2
    else if (!context.makeCurrent()) result = 3
    else if (context.version() < 3003) result = 4
    else if (context.clearBlackAndReadRgba8() != 0) result = 5
    else if (!capabilities.valid() ||
        !capabilities.supports(graphicsFeatureCompute |
            graphicsFeatureStorageBuffers | graphicsFeatureSampledTextures |
            graphicsFeatureDepthTextures |
            graphicsFeatureComparisonSamplers |
            graphicsFeatureSamplerAnisotropy) ||
        capabilities.supports(graphicsFeatureViewFormatReinterpretation) ||
        capabilities.limits.maximumTextureDimension1D <= 0 ||
        capabilities.limits.maximumTextureDimension2D <= 0 ||
        capabilities.limits.maximumTextureDimension3D <= 0 ||
        capabilities.limits.maximumTextureArrayLayers <= 0 ||
        capabilities.limits.maximumTextureCubeDimension <= 0 ||
        capabilities.limits.maximumComputeWorkgroupsY <= 0 ||
        capabilities.limits.maximumComputeWorkgroupsZ <= 0 ||
        capabilities.limits.maximumComputeWorkgroupSizeY <= 0 ||
        capabilities.limits.maximumComputeWorkgroupSizeZ <= 0 ||
        capabilities.limits.maximumSamplerAnisotropy < 16) result = 6
    else if (!debugPassed) result = 7
    else if (!shaderLifecyclePassed) result = 8
    if (result == 7) println(
        "OpenGL debug failure valid=${debug.valid()} live=$debugLiveBefore/$debugLiveAfter counts=${debugBefore.total}/${debugAfter.total},${debugBefore.high}/${debugAfter.high},${debugBefore.medium}/${debugAfter.medium},${debugBefore.low}/${debugAfter.low},${debugBefore.notification}/${debugAfter.notification}"
    )
    if (result == 8) println(
        "OpenGL shader lifecycle failure invalid=${invalidShader.handle}/'${invalidShader.error}' emptyRejected=$emptyProgramRejected emptyLog='$emptyProgramError' valid=$validProgramHandle/${validProgram.valid()}"
    )
    result
}
