import "../src/graphics.ab"
import "abla/io"
import "abla/runtime/memory"

fun main: int {
    val window = x11Window(WindowConfig(
        title = "Abla-only X11 window",
        width = 320,
        height = 180,
        resizable = false,
        visible = false,
        decorated = false,
        cursorVisible = false
    ))
    val transparentWindow = x11Window(WindowConfig(
        title = "Unsupported transparent X11 window",
        width = 64,
        height = 64,
        transparent = true
    ))
    val clipboardPeer = x11Window(WindowConfig(
        title = "Abla clipboard peer",
        width = 64,
        height = 64,
        visible = false
    ))
    val monitor = window.primaryMonitor
    var passed = window.valid() &&
        !transparentWindow.valid() &&
        clipboardPeer.valid() &&
        window.keyboardMapped() &&
        window.width == 320 &&
        window.height == 180 &&
        !window.visible &&
        !window.cursorVisible && window.invisibleCursor != 0 &&
        window.title == "Abla-only X11 window" &&
        monitor.valid() && monitor.name == "X11 screen 0" &&
        monitor.width == 800 && monitor.height == 600 &&
        window.monitors.size == 1 &&
        window.monitors[0].name == monitor.name &&
        window.monitors[0].width == monitor.width &&
        window.monitors[0].height == monitor.height &&
        monitor.dpiX() > 0.0 && monitor.dpiY() > 0.0 &&
        monitor.contentScaleX() > 0.0 && monitor.contentScaleY() > 0.0 &&
        window.protocolsAtom != 0 &&
        window.deleteAtom != 0
    if (passed) passed = window.setTitle("Abla X11 event test") &&
        window.title == "Abla X11 event test"
    if (passed) passed = window.show() && window.visible
    if (passed) passed = window.setCursorVisible(true) &&
        window.cursorVisible && window.setCursorVisible(true)
    if (passed) passed = window.setCursorVisible(false) &&
        !window.cursorVisible && window.setCursorVisible(false)
    if (passed) passed = window.setCursorVisible(true) &&
        window.cursorVisible
    if (passed) passed = window.show() && window.visible
    if (passed) passed = window.hide() && !window.visible
    if (passed) passed = window.hide() && !window.visible
    if (passed) passed = window.resize(400, 225)
    var event = WindowEvent()
    var attempts = 0
    while (passed && event.kind != windowEventResized && attempts < 32) {
        event = window.pollEvent(50)
        attempts = attempts + 1
    }
    if (passed) passed = event.first == 400 && event.second == 225 &&
        window.width == 400 && window.height == 225
    val wKeycode = window.platformKeycode(keyW)
    if (passed) passed = wKeycode != 0 && window.sendSyntheticKey(wKeycode, true)
    event = WindowEvent()
    attempts = 0
    while (passed && event.kind != windowEventKey &&
        attempts < 32) {
        event = window.pollEvent(50)
        attempts = attempts + 1
    }
    if (passed) passed = event.key() == keyW && event.keyPressed() &&
        event.platformCode == wKeycode
    if (passed) {
        event = window.pollEvent(0)
        passed = event.kind == windowEventText && event.codepoint() == 119 &&
            event.text == "w" && event.platformCode == wKeycode
    }
    if (passed) passed = window.sendSyntheticKey(wKeycode, false)
    event = WindowEvent()
    attempts = 0
    while (passed && event.kind != windowEventKey && attempts < 32) {
        event = window.pollEvent(50)
        attempts = attempts + 1
    }
    if (passed) passed = event.key() == keyW && !event.keyPressed() &&
        event.platformCode == wKeycode
    if (passed) passed = window.sendSyntheticKey(wKeycode, true, 1)
    event = WindowEvent()
    attempts = 0
    while (passed && event.kind != windowEventKey && attempts < 32) {
        event = window.pollEvent(50)
        attempts = attempts + 1
    }
    if (passed) passed = event.key() == keyW && event.keyPressed()
    if (passed) {
        event = window.pollEvent(0)
        passed = event.kind == windowEventText && event.codepoint() == 87 &&
            event.text == "W"
    }
    if (passed) passed = window.sendSyntheticKey(wKeycode, false, 1)
    event = WindowEvent()
    attempts = 0
    while (passed && event.kind != windowEventKey && attempts < 32) {
        event = window.pollEvent(50)
        attempts = attempts + 1
    }
    if (passed) passed = event.key() == keyW && !event.keyPressed()
    if (passed) passed = window.sendSyntheticPointerMove(-3, 17)
    event = WindowEvent()
    attempts = 0
    while (passed && event.kind != windowEventPointerMoved && attempts < 32) {
        event = window.pollEvent(50)
        attempts = attempts + 1
    }
    if (passed) passed = event.pointerX() == -3 && event.pointerY() == 17
    if (passed) passed = window.show() && window.visible
    if (passed) passed = window.setPointerPosition(23, 29)
    event = WindowEvent()
    attempts = 0
    while (passed && event.kind != windowEventPointerMoved && attempts < 32) {
        event = window.pollEvent(50)
        attempts = attempts + 1
    }
    if (passed) passed = event.pointerX() == 23 && event.pointerY() == 29
    if (passed) passed = window.sendSyntheticPointerMove(31, 37)
    if (passed) passed = window.setPointerCaptured(true) &&
        window.pointerCaptured && window.setPointerCaptured(true)
    if (passed) passed = window.setPointerCaptured(false) &&
        !window.pointerCaptured && window.setPointerCaptured(false)
    event = WindowEvent()
    attempts = 0
    while (passed && event.kind != windowEventPointerMoved && attempts < 32) {
        event = window.pollEvent(50)
        attempts = attempts + 1
    }
    if (passed) passed = event.pointerX() == 31 && event.pointerY() == 37
    if (passed) passed = window.sendSyntheticPointerButton(1, true)
    event = WindowEvent()
    attempts = 0
    while (passed && event.kind != windowEventPointerButton && attempts < 32) {
        event = window.pollEvent(50)
        attempts = attempts + 1
    }
    if (passed) passed = event.pointerButton() == pointerButtonLeft &&
        event.pointerButtonPressed() && event.platformCode == 1
    if (passed) passed = window.sendSyntheticPointerButton(4, true)
    event = WindowEvent()
    attempts = 0
    while (passed && event.kind != windowEventScrolled && attempts < 32) {
        event = window.pollEvent(50)
        attempts = attempts + 1
    }
    if (passed) passed = event.scrollX() == 0 && event.scrollY() == 1 &&
        event.platformCode == 4
    if (passed) passed = window.setClipboard("Abla clipboard ✓") &&
        clipboardPeer.requestClipboardFormats()
    event = WindowEvent()
    attempts = 0
    while (passed && event.kind != windowEventClipboard && attempts < 32) {
        window.pollEvent(50)
        event = clipboardPeer.pollEvent(50)
        attempts = attempts + 1
    }
    if (passed) passed = event.clipboardSucceeded() &&
        event.clipboardTextAvailable()
    if (passed) passed = clipboardPeer.requestClipboard()
    event = WindowEvent()
    attempts = 0
    while (passed && event.kind != windowEventClipboard && attempts < 32) {
        window.pollEvent(50)
        event = clipboardPeer.pollEvent(50)
        attempts = attempts + 1
    }
    if (passed) passed = event.clipboardSucceeded() &&
        event.clipboardTextAvailable() &&
        event.clipboardText() == "Abla clipboard ✓"
    if (passed) passed = window.requestClose()
    event = WindowEvent()
    attempts = 0
    while (passed && event.kind != windowEventCloseRequested &&
        attempts < 32) {
        event = window.pollEvent(50)
        attempts = attempts + 1
    }
    if (passed) passed = event.kind == windowEventCloseRequested
    val pollScratchBefore = nativePointerAddress(window.pollScratch.address)
    val idleLiveBefore = runtimeMemoryLiveBytes()
    var idlePolls = passed
    var idleIndex = 0
    while (idlePolls && idleIndex < 8) {
        idlePolls = !window.pollEvent(0).happened()
        idleIndex = idleIndex + 1
    }
    val idleLiveAfter = runtimeMemoryLiveBytes()
    if (passed) passed = idlePolls && idleLiveAfter == idleLiveBefore &&
        nativePointerAddress(window.pollScratch.address) == pollScratchBefore
    if (!passed) {
        println(
            "X11 event test valid=${window.valid()} keyboard=${window.keyboardMapped()} w=$wKeycode protocols=${window.protocolsAtom} delete=${window.deleteAtom} clipboard=${window.clipboardAtom}/${window.clipboardOwned} peer=${clipboardPeer.valid()} event=${event.kind}/${event.first} text='${event.text}'"
        )
    }
    if (passed) 42 else 1
}
