import "../src/graphics.ab"

fun main: int {
    val window = x11Window(WindowConfig(
        title = "Abla-only X11 window",
        width = 320,
        height = 180,
        visible = false
    ))
    val event = window.pollEvent(250)
    if (window.valid() &&
        window.width == 320 &&
        window.height == 180 &&
        (event.kind == windowEventNone ||
         event.kind == windowEventResized ||
         event.kind == windowEventFocused)) 42 else 1
}
