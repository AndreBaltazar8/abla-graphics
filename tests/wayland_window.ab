import "../src/platform/wayland.ab"
import "abla/io"

fun main: int {
    val window = waylandXdgWindow(
        "Abla Graphics Wayland test",
        "io.abla.graphics.test",
        320,
        200
    )
    var succeeded = window.valid() && window.configured
    val viewporterAvailable = window.connection.global(
        "wp_viewporter"
    ).valid
    val viewportEnabled = if (succeeded) window.enableViewport() else false
    succeeded = succeeded && viewportEnabled == viewporterAvailable &&
        window.connection.valid()
    val bufferWidth = if (viewportEnabled) 640 else 320
    val bufferHeight = if (viewportEnabled) 400 else 200
    if (succeeded && viewportEnabled) succeeded =
        window.setPreferredViewportDestination() &&
        window.setViewportSource(0, 0, bufferWidth, bufferHeight) &&
        window.viewportSourceSet()
    succeeded = succeeded &&
        window.createSharedBuffers(bufferWidth, bufferHeight, 2) &&
        window.clearSharedPixels(32, 48, 72) &&
        window.presentSharedPixels() && window.waitFrame()
    val firstSerial = window.lastConfigureSerial
    if (succeeded) succeeded = window.setFullscreen(true)
    var attempts = 0
    while (succeeded && attempts < 100 &&
        !(window.lastConfigureSerial != firstSerial &&
          window.hasToplevelState(waylandToplevelStateFullscreen))) {
        succeeded = window.pollProtocol(50)
        attempts = attempts + 1
    }
    val fullscreenSerial = window.lastConfigureSerial
    succeeded = succeeded &&
        window.hasToplevelState(waylandToplevelStateFullscreen) &&
        window.width == 1024 && window.height == 768 &&
        window.commit() &&
        window.setFullscreen(false)
    attempts = 0
    while (succeeded && attempts < 100 &&
        !(window.lastConfigureSerial != fullscreenSerial &&
          !window.hasToplevelState(waylandToplevelStateFullscreen))) {
        succeeded = window.pollProtocol(50)
        attempts = attempts + 1
    }
    if (succeeded && viewportEnabled) succeeded =
        window.setPreferredViewportDestination() &&
        window.viewportDestinationSet() &&
        window.viewportDestinationWidth == window.width &&
        window.viewportDestinationHeight == window.height &&
        !window.setViewportDestination(-1, window.height) &&
        !window.setViewportSourceFixed(-1, 0, 256, 256) &&
        window.setViewportSourceFixed(
            128,
            128,
            639 * 256,
            399 * 256
        ) &&
        window.viewportSourceXFixed == 128 &&
        window.viewportSourceYFixed == 128 &&
        window.waitSharedBuffer() &&
        window.clearSharedPixels(40, 56, 80) &&
        window.presentSharedPixels() && window.waitFrame() &&
        window.unsetViewportSource() && !window.viewportSourceSet() &&
        window.unsetViewportDestination() &&
        !window.viewportDestinationSet() && window.commit()
    val fractionalAvailable = window.connection.global(
        "wp_fractional_scale_manager_v1"
    ).valid
    val fractionalEnabled = if (succeeded)
        window.enableFractionalScale()
    else false
    succeeded = succeeded && fractionalEnabled == fractionalAvailable &&
        window.connection.valid()
    attempts = 0
    while (succeeded && fractionalEnabled &&
        window.preferredFractionalScale == 0 && attempts < 100) {
        succeeded = window.pollProtocol(50)
        attempts = attempts + 1
    }
    if (succeeded && fractionalEnabled) succeeded =
        window.preferredFractionalScale > 0 &&
        window.preferredFramebufferWidth() > 0 &&
        window.preferredFramebufferHeight() > 0
    if (succeeded && !fractionalAvailable) {
        window.fractionalScaleIdentifier = 999
        succeeded = window.dispatchFractionalScale(waylandDecodeMessage(
            waylandPacket(999, 0, waylandU32Payload(180))
        )) == 1
        val framebufferEvent = window.nextInputEvent()
        succeeded = succeeded &&
            framebufferEvent.kind == windowEventFramebufferResized &&
            framebufferEvent.first == 1536 &&
            framebufferEvent.second == 1152 &&
            framebufferEvent.platformCode == 180
        window.fractionalScaleIdentifier = 0
        window.preferredFractionalScale = 0
    }
    succeeded = succeeded &&
        !window.hasToplevelState(waylandToplevelStateFullscreen) &&
        window.setResizable(false) && window.setResizable(true) &&
        window.requestClose()
    var closeEvent = window.nextInputEvent()
    while (closeEvent.happened() &&
        closeEvent.kind != windowEventCloseRequested) {
        closeEvent = window.nextInputEvent()
    }
    succeeded = succeeded && closeEvent.kind == windowEventCloseRequested
    println(
        "wayland-window-test: succeeded=$succeeded size=${window.width}x${window.height} framebuffer=${window.preferredFramebufferWidth()}x${window.preferredFramebufferHeight()} buffer=${window.bufferWidth}x${window.bufferHeight} viewport=$viewporterAvailable/$viewportEnabled/${window.viewportDestinationWidth}x${window.viewportDestinationHeight}/${window.viewportSourceWidthFixed}x${window.viewportSourceHeightFixed} fractional=$fractionalAvailable/$fractionalEnabled/${window.preferredFractionalScale} states=${window.states.size} fullscreen=${window.hasToplevelState(waylandToplevelStateFullscreen)} serial=$firstSerial/$fullscreenSerial/${window.lastConfigureSerial} error=${window.connection.error}"
    )
    if (succeeded &&
        window.width > 0 && window.height > 0 &&
        window.title == "Abla Graphics Wayland test" &&
        window.appId == "io.abla.graphics.test" &&
        window.compositorIdentifier != window.wmBaseIdentifier &&
        window.surfaceIdentifier != window.xdgSurfaceIdentifier &&
        window.xdgSurfaceIdentifier != window.toplevelIdentifier &&
        window.closeRequested) 42 else 1
}
