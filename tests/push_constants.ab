import "../src/push_constants.ab"

fun main: int {
    val shader = glslPackage(
        [shaderStageVertex, shaderStageFragment],
        [
            "layout(push_constant) uniform Draw { mat4 transform; vec4 tint; } draw; void main() {}",
            "layout(push_constant) uniform Draw { mat4 transform; vec4 tint; } draw; void main() {}"
        ]
    )
    val values = shader.pushConstants()
    val tint = bufferBytes(16)
    tint.storeF32(0.25, 0)
    tint.storeF32(0.5, 4)
    tint.storeF32(0.75, 8)
    tint.storeF32(1.0, 12)
    val shortTint = bufferBytes(12)
    val noConstants = glslPackage(
        [shaderStageVertex],
        ["void main() {}"]
    ).pushConstants()
    val typedShader = glslPackage(
        [shaderStageCompute],
        ["layout(push_constant) uniform Typed { float scalar; vec3 floats; int signedValue; uvec2 unsigneds; bvec2 flags; vec2 samples[2]; } typed; void main() {}"]
    )
    val typedValues = typedShader.pushConstants()
    val subpassBytes = bufferBytes(128)
    val subpassValues = GraphicsSubpassPushConstants(
        [typedValues.layout, typedValues.layout],
        [0, 64],
        [64, 64],
        [shaderStageMaskCompute, shaderStageMaskCompute],
        move(subpassBytes),
        ""
    )
    val wideShader = glslPackage(
        [shaderStageCompute],
        ["layout(push_constant) uniform Wide { double scalar; dvec2 vector; mat2 basis[2]; layout(row_major) dmat2 wideMatrix; } wide; void main() {}"]
    )
    val wideValues = wideShader.pushConstants()
    val wideSubpassBytes = bufferBytes(192)
    val wideSubpassValues = GraphicsSubpassPushConstants(
        [wideValues.layout, wideValues.layout],
        [0, 96],
        [96, 96],
        [shaderStageMaskCompute, shaderStageMaskCompute],
        move(wideSubpassBytes),
        ""
    )
    val passed = values.valid() && values.layout.size == 80 &&
        values.memberOffset("transform") == 0 &&
        values.memberSize("transform") == 64 &&
        values.memberOffset("tint") == 64 &&
        values.memberSize("tint") == 16 &&
        values.memberOffset("missing") == -1 &&
        values.fill() && values.storeU32(4294967295, 0) &&
        values.bytes.load(0) == 255 && values.bytes.load(3) == 255 &&
        values.writeMember("tint", tint) &&
        values.bytes.load(64) == 0 && values.bytes.load(65) == 0 &&
        values.bytes.load(66) == 128 && values.bytes.load(67) == 62 &&
        values.bytes.load(76) == 0 && values.bytes.load(77) == 0 &&
        values.bytes.load(78) == 128 && values.bytes.load(79) == 63 &&
        !values.writeMember("tint", shortTint) &&
        !values.writeMember("missing", tint) &&
        !values.writeBytes(tint, 70) &&
        !values.storeU32(1, 78) && !noConstants.valid() &&
        typedValues.valid() && typedValues.layout.size == 64 &&
        typedValues.fill() &&
        typedValues.storeMemberF32("scalar", 0.25) &&
        typedValues.storeMemberF32("floats", 0.75, 2) &&
        typedValues.storeMemberI32("signedValue", -2) &&
        typedValues.storeMemberU32("unsigneds", 4294967295, 1) &&
        typedValues.storeMemberBool("flags", true, 1) &&
        typedValues.storeMemberF32("samples", 0.5, 1, 1) &&
        typedValues.bytes.load(2) == 128 &&
        typedValues.bytes.load(3) == 62 &&
        typedValues.bytes.load(26) == 64 &&
        typedValues.bytes.load(27) == 63 &&
        typedValues.bytes.load(28) == 254 &&
        typedValues.bytes.load(31) == 255 &&
        typedValues.bytes.load(36) == 255 &&
        typedValues.bytes.load(39) == 255 &&
        typedValues.bytes.load(44) == 1 &&
        typedValues.bytes.load(60) == 0 &&
        typedValues.bytes.load(63) == 63 &&
        !typedValues.storeMemberF32("signedValue", 1.0) &&
        !typedValues.storeMemberI32("unsigneds", 1) &&
        !typedValues.storeMemberU32("signedValue", 1) &&
        !typedValues.storeMemberBool("flags", true, 2) &&
        !typedValues.storeMemberF32("missing", 1.0) &&
        !typedValues.storeMemberF32("floats", 1.0, 3) &&
        !typedValues.storeMemberF32("samples", 1.0, 0, 2) &&
        !typedValues.storeMemberF32("scalar", 1.0, 0, 1) &&
        !typedValues.storeMemberU32("unsigneds", -1) &&
        !typedValues.storeMemberI32("signedValue", 2147483648) &&
        subpassValues.valid() && subpassValues.fill() &&
        subpassValues.storeMemberF32(1, "samples", 0.5, 1, 1) &&
        subpassValues.storeMemberI32(0, "signedValue", -2) &&
        subpassValues.storeMemberU32(1, "unsigneds", 4294967295, 1) &&
        subpassValues.storeMemberBool(0, "flags", true, 1) &&
        subpassValues.bytes.load(124) == 0 &&
        subpassValues.bytes.load(127) == 63 &&
        subpassValues.bytes.load(28) == 254 &&
        subpassValues.bytes.load(31) == 255 &&
        subpassValues.bytes.load(100) == 255 &&
        subpassValues.bytes.load(103) == 255 &&
        subpassValues.bytes.load(44) == 1 &&
        !subpassValues.storeMemberF32(2, "scalar", 1.0) &&
        !subpassValues.storeMemberBool(0, "floats", true) &&
        !subpassValues.storeMemberU32(1, "unsigneds", -1) &&
        wideValues.valid() && wideValues.layout.size == 96 &&
        wideValues.layout.members[2].arrayStride == 16 &&
        wideValues.layout.members[2].matrixStride == 8 &&
        !wideValues.layout.members[2].rowMajor &&
        wideValues.layout.members[3].matrixStride == 16 &&
        wideValues.layout.members[3].rowMajor && wideValues.fill() &&
        wideValues.storeMemberF64("scalar", 1.0) &&
        wideValues.storeMemberF64("vector", 0.5, 1) &&
        wideValues.storeMemberMatrixF32("basis", 0.5, 1, 0, 1) &&
        wideValues.storeMemberMatrixF64("wideMatrix", 0.5, 1, 0) &&
        wideValues.storeMemberMatrixF64("wideMatrix", 1.0, 0, 1) &&
        wideValues.bytes.load(6) == 240 &&
        wideValues.bytes.load(7) == 63 &&
        wideValues.bytes.load(30) == 224 &&
        wideValues.bytes.load(31) == 63 &&
        wideValues.bytes.load(58) == 0 &&
        wideValues.bytes.load(59) == 63 &&
        wideValues.bytes.load(78) == 224 &&
        wideValues.bytes.load(79) == 63 &&
        wideValues.bytes.load(86) == 240 &&
        wideValues.bytes.load(87) == 63 &&
        !wideValues.storeMemberF64("vector", 1.0, 2) &&
        !wideValues.storeMemberF64("scalar", 1.0, 0, 1) &&
        !wideValues.storeMemberF64("basis", 1.0) &&
        !wideValues.storeMemberF32("scalar", 1.0) &&
        !wideValues.storeMemberMatrixF32("wideMatrix", 1.0, 0, 0) &&
        !wideValues.storeMemberMatrixF64("basis", 1.0, 0, 0) &&
        !wideValues.storeMemberMatrixF32("basis", 1.0, 2, 0) &&
        !wideValues.storeMemberMatrixF32("basis", 1.0, 0, 2) &&
        !wideValues.storeMemberMatrixF32("basis", 1.0, 0, 0, 2) &&
        wideSubpassValues.valid() && wideSubpassValues.fill() &&
        wideSubpassValues.storeMemberF64(1, "scalar", 1.0) &&
        wideSubpassValues.storeMemberMatrixF32(
            0, "basis", 0.5, 1, 0, 1
        ) && wideSubpassValues.storeMemberMatrixF64(
            1, "wideMatrix", 0.5, 1, 0
        ) && wideSubpassValues.bytes.load(102) == 240 &&
        wideSubpassValues.bytes.load(103) == 63 &&
        wideSubpassValues.bytes.load(58) == 0 &&
        wideSubpassValues.bytes.load(59) == 63 &&
        wideSubpassValues.bytes.load(174) == 224 &&
        wideSubpassValues.bytes.load(175) == 63 &&
        !wideSubpassValues.storeMemberF64(2, "scalar", 1.0) &&
        !wideSubpassValues.storeMemberMatrixF32(
            0, "wideMatrix", 1.0, 0, 0
        )
    if (passed) 42 else 1
}
