import "../src/graphics.ab"

fun main: int {
    val automatic = graphicsSelectBackend(
        GraphicsConfig(),
        GraphicsBackendSupport(true, true)
    )
    val fallback = graphicsSelectBackend(
        GraphicsConfig(
            backend = graphicsBackendAuto,
            allowHeadlessFallback = true
        ),
        GraphicsBackendSupport(false, false)
    )
    val unavailable = graphicsSelectBackend(
        GraphicsConfig(backend = graphicsBackendVulkan),
        GraphicsBackendSupport(false, true)
    )
    val invalid = graphicsSelectBackend(
        GraphicsConfig(framesInFlight = 0),
        GraphicsBackendSupport(true, true)
    )
    val invalidFeatureMask = graphicsSelectBackend(
        GraphicsConfig(requiredFeatures = 256),
        GraphicsBackendSupport(true, true)
    )
    val featureFallback = graphicsSelectBackend(
        GraphicsConfig(
            requiredFeatures = graphicsFeatureViewFormatReinterpretation
        ),
        GraphicsBackendSupport(
            true,
            true,
            vulkanFeatures = graphicsFeatureAll,
            openGlFeatures = graphicsFeatureAll &
                ~graphicsFeatureViewFormatReinterpretation
        )
    )
    val explicitUnsupported = graphicsSelectBackend(
        GraphicsConfig(
            backend = graphicsBackendOpenGl,
            requiredFeatures = graphicsFeatureViewFormatReinterpretation
        ),
        GraphicsBackendSupport(
            true,
            true,
            openGlFeatures = graphicsFeatureAll &
                ~graphicsFeatureViewFormatReinterpretation
        )
    )
    val automaticUnsupported = graphicsSelectBackend(
        GraphicsConfig(requiredFeatures = graphicsFeatureCompute),
        GraphicsBackendSupport(
            true,
            true,
            vulkanFeatures = graphicsFeatureSampledTextures,
            openGlFeatures = graphicsFeatureSampledTextures
        )
    )
    val capabilities = GraphicsCapabilities(
        graphicsFeatureCompute | graphicsFeatureStorageBuffers |
            graphicsFeatureSampledTextures |
            graphicsFeatureSamplerAnisotropy,
        GraphicsLimits(
            16384,
            134217728,
            65535,
            1024,
            1024,
            8,
            65535,
            65535,
            1024,
            64
        ),
        GraphicsVersion(1, 4)
    )
    val noAnisotropy = GraphicsCapabilities(
        graphicsFeatureSampledTextures,
        GraphicsLimits(16384),
        GraphicsVersion(4, 5)
    )
    val incompleteComputeLimits = GraphicsCapabilities(
        graphicsFeatureCompute,
        GraphicsLimits(16384, 0, 65535, 1024, 1024),
        GraphicsVersion(4, 5)
    )
    val virtualMonitor = Monitor("virtual", 1920, 1080)
    val rectangle = Rect2D(Offset2D(10, 20), Extent2D(30, 40))
    val boundaryRectangle = Rect2D(
        Offset2D(graphicsMaximumInt - 2, graphicsMinimumInt),
        Extent2D(2, 2)
    )
    val overflowingRectangle = Rect2D(
        Offset2D(graphicsMaximumInt - 1, 0),
        Extent2D(2, 1)
    )
    val largeArea = Extent2D(graphicsMaximumInt, 2).areaChecked()
    val volume = Extent3D(2, 3, 4).volumeChecked()
    val vector = Vec2(2.0, 3.0).plus(Vec2(4.0, 5.0)).scaled(2.0)
    val transform = mat4Translation(Vec3(3.0, 5.0, 7.0)).multiplied(
        mat4Scaling(Vec3(2.0, 3.0, 4.0))
    )
    val transformedPoint = transform.transformPoint(Vec3(1.0, 1.0, 1.0))
    val transformedDirection = transform.transformDirection(Vec3(1.0, 1.0, 1.0))
    val identityPoint = mat4Identity().transformPoint(Vec3(2.0, 4.0, 8.0))
    val color = Color(0.5, 0.25, 1.0, 0.5).premultiplied()
    val pixels = pixelBuffer(2, 2)
    val pixelsCleared = pixels.clearRgba8(3, 5, 7, 11)
    val pixelStored = pixels.setRgba8(1, 1, 13, 17, 19, 23)
    val invalidPixelRejected = !pixels.setRgba8(2, 1, 0, 0, 0)
    val vertexBuffer = BufferDescriptor(
        label = "vertices",
        size = 96,
        usage = bufferUsageVertex | bufferUsageCopyDestination
    )
    val readbackBuffer = BufferDescriptor(
        size = 4096,
        usage = bufferUsageMapRead | bufferUsageCopyDestination
    )
    val invalidMappedBuffer = BufferDescriptor(
        size = 64,
        usage = bufferUsageMapRead | bufferUsageVertex
