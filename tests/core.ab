    if (automatic.succeeded &&
        graph.valid() && graph.order.size == 4 &&
        graph.order[0] == 10 && graph.order[1] == 20 &&
        graph.order[2] == 30 && graph.order[3] == 40 &&
        graph.lifetimes.size == 3 &&
        graph.lifetimes[0].firstPass == 0 &&
        graph.lifetimes[0].lastPass == 1 &&
        graph.lifetimes[0].allocationSlot == 0 &&
        graph.lifetimes[1].firstPass == 2 &&
        graph.lifetimes[1].lastPass == 3 &&
        graph.lifetimes[1].allocationSlot == 0 &&
        graph.lifetimes[2].allocationSlot == -1 &&
        graph.allocations.size == 1 &&
        graph.allocations[0].capacity == 128 &&
        graph.barriers.size == 3 &&
        graph.barriers[0].resourceId == 0 &&
        graph.barriers[0].sourcePass == 10 &&
        graph.barriers[0].destinationPass == 20 &&
        graph.barriers[0].sourceAccess == graphAccessWrite &&
        graph.barriers[0].destinationAccess == graphAccessRead &&
        graph.barriers[1].resourceId == 2 &&
        graph.barriers[2].resourceId == 1 &&
        prunedGraph.valid() && prunedGraph.barriers.size == 2 &&
        prunedGraph.barriers[0].sourcePass == 1 &&
        prunedGraph.barriers[0].destinationPass == 2 &&
        prunedGraph.barriers[1].sourcePass == 2 &&
        prunedGraph.barriers[1].destinationPass == 3 &&
        !cyclicGraph.valid() && cyclicGraph.error.message != "" &&
        !invalidGraphUse.valid() && invalidGraphUse.error.message != "" &&
        automatic.backend == graphicsBackendVulkan &&
        fallback.succeeded &&
        fallback.backend == graphicsBackendHeadless &&
        !unavailable.succeeded &&
        unavailable.error.code == graphicsErrorBackendUnavailable &&
        !invalid.succeeded &&
        invalid.error.code == graphicsErrorInvalidConfiguration &&
        !invalidFeatureMask.succeeded &&
        invalidFeatureMask.error.code == graphicsErrorInvalidConfiguration &&
        featureFallback.succeeded &&
        featureFallback.backend == graphicsBackendVulkan &&
        !explicitUnsupported.succeeded &&
        explicitUnsupported.error.code == graphicsErrorUnsupportedFeature &&
        !automaticUnsupported.succeeded &&
        automaticUnsupported.error.code == graphicsErrorUnsupportedFeature &&
        capabilities.valid() &&
        capabilities.supports(graphicsFeatureCompute |
            graphicsFeatureStorageBuffers) &&
        !capabilities.supports(graphicsFeatureDepthTextures) &&
        !incompleteComputeLimits.valid() &&
        graphicsSamplerAnisotropySupported(capabilities, 8) &&
        !graphicsSamplerAnisotropySupported(capabilities, 16) &&
        !graphicsSamplerAnisotropySupported(noAnisotropy, 2) &&
        graphicsPositiveF32Floor(0) == 0 &&
        graphicsPositiveF32Floor(1065353216) == 1 &&
        graphicsPositiveF32Floor(1090519040) == 8 &&
        graphicsPositiveF32Floor(1098907648) == 16 &&
        graphicsPositiveF32Value(0) == 0.0 &&
        graphicsPositiveF32Value(1065353216) == 1.0 &&
        graphicsPositiveF32Value(1073741824) == 2.0 &&
        graphicsPositiveF32Value(1056964608) == 0.5 &&
        graphicsPositiveF32Value(1) > 0.0 &&
        graphicsTimestampTickDelta(10, 25, 8) == 15 &&
