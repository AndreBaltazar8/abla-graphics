        transformedDirection.x == 2.0 && transformedDirection.y == 3.0 &&
        transformedDirection.z == 4.0 &&
        identityPoint.x == 2.0 && identityPoint.y == 4.0 &&
        identityPoint.z == 8.0 &&
        color.red == 0.25 && color.alpha == 0.5 &&
        graphicsScalarF32Bits(0.0) == 0 &&
        graphicsScalarF32Bits(0.25) == 1048576000 &&
        graphicsScalarF32Bits(0.5) == 1056964608 &&
        graphicsScalarF32Bits(1.0) == 1065353216 &&
        graphicsScalarF32Bits(-1.0) == 3212836864 &&
        graphicsScalarF32Bits(-0.0) == 2147483648 &&
        graphicsScalarF32Bits(1.0e-50) == 0 &&
        graphicsScalarF32Bits(1.401298464324817e-45) == 1 &&
        graphicsUnsignedIntegerF32Bits(0) == 0 &&
        graphicsUnsignedIntegerF32Bits(16) == 1098907648 &&
        graphicsUnsignedIntegerF32Bits(32) == 1107296256 &&
        specializedShader.valid && specialization.structurallyValid() &&
        specialization.validFor(specializedShader, shaderStageCompute) &&
        specialization.value(12, 2) == 4 &&
        specialization.value(8, 2) == 2 &&
        !duplicateSpecialization.structurallyValid() &&
        !mismatchedSpecialization.validFor(
            specializedShader,
            shaderStageCompute
        ) &&
        !unknownSpecialization.validFor(
            specializedShader,
            shaderStageCompute
        ) &&
        scalarSpecializationShader.valid &&
        scalarSpecialization.validFor(
            scalarSpecializationShader,
            shaderStageCompute
        ) &&
        scalarSpecialization.values[0].bits == 1056964608 &&
        shaderSpecializationBool(0, true).bits == 1 &&
        shaderSpecializationDouble(0, 1.0).bits ==
            4607182418800017408 &&
        !shaderSpecializationInt(0, 2147483648).valid() &&
        !shaderSpecializationUint(0, -1).valid() &&
        VertexBufferLayout().valid() &&
        !VertexBufferLayout().buffered() &&
        VertexBufferLayout(8).valid() &&
        VertexBufferLayout(8).buffered() &&
        VertexBufferLayout(24, [
            VertexAttribute(0, 0, vertexFormatFloat32x2),
            VertexAttribute(1, 8, vertexFormatFloat32x4)
        ]).valid() &&
        VertexBufferLayout(24, [
            VertexAttribute(0, 0, vertexFormatFloat32x2),
            VertexAttribute(1, 8, vertexFormatFloat32x4)
        ]).attributeCount() == 2 &&
        !VertexBufferLayout(16, [
            VertexAttribute(0, 0, vertexFormatFloat32x2),
            VertexAttribute(0, 8, vertexFormatFloat32x2)
        ]).valid() &&
        !VertexBufferLayout(16, [
            VertexAttribute(0, 12, vertexFormatFloat32x2)
        ]).valid() &&
        !VertexBufferLayout(16, [
            VertexAttribute(0, 0, 99)
        ]).valid() &&
        vertexFormatSize(vertexFormatFloat32x4) == 16 &&
        vertexFormatGlslType(vertexFormatUint32) == "uint" &&
        !VertexBufferLayout(4).valid() &&
        !VertexBufferLayout(2049).valid() &&
        RasterPipelineState().valid() &&
        RasterPipelineState(
            topology = primitiveTopologyLineStrip,
            cullMode = cullModeFront,
            frontFace = frontFaceClockwise,
            alphaBlend = true
        ).valid() &&
        !RasterPipelineState(topology = -1).valid() &&
        !RasterPipelineState(topology = 5).valid() &&
        !RasterPipelineState(cullMode = 3).valid() &&
