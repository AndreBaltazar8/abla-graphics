        graphicsTimestampTickDelta(-1, 5, 8) == -1 &&
        virtualMonitor.valid() && !virtualMonitor.physicalSizeKnown() &&
        virtualMonitor.dpiX() == 96.0 &&
        virtualMonitor.contentScaleX() == 1.0 &&
        rectangle.contains(10, 20) &&
        rectangle.contains(39, 59) &&
        !rectangle.contains(40, 60) &&
        boundaryRectangle.contains(
