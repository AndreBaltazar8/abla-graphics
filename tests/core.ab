        ["#version 450\nlayout(local_size_x=1) in; layout(constant_id=5) const float scale=1.0; void main() {}"]
    )
    val scalarSpecialization = ShaderSpecialization([
        shaderSpecializationFloat(5, 0.5)
    ])
    val graphResources = [
        GraphicsGraphResource(0, "gbuffer", true, 64, 1),
        GraphicsGraphResource(1, "post", true, 128, 1),
        GraphicsGraphResource(2, "output", false, 0, 2)
    ]
    val graph = graphicsRenderGraph(graphResources, [
        GraphicsGraphPass(10, "geometry", [
            GraphicsGraphUse(0, graphAccessWrite)
        ]),
        GraphicsGraphPass(20, "lighting", [
            GraphicsGraphUse(0, graphAccessRead),
            GraphicsGraphUse(2, graphAccessWrite)
        ]),
        GraphicsGraphPass(30, "post", [
            GraphicsGraphUse(2, graphAccessRead),
            GraphicsGraphUse(1, graphAccessWrite)
        ]),
        GraphicsGraphPass(40, "present", [
            GraphicsGraphUse(1, graphAccessRead)
        ])
    ])
    val cyclicGraph = graphicsRenderGraph([
        GraphicsGraphResource(0, "value", true, 4, 0)
    ], [
        GraphicsGraphPass(1, "write", [
            GraphicsGraphUse(0, graphAccessWrite)
        ], [2]),
        GraphicsGraphPass(2, "read", [
            GraphicsGraphUse(0, graphAccessRead)
        ])
    ])
    val invalidGraphUse = graphicsRenderGraph(graphResources, [
        GraphicsGraphPass(1, "duplicate", [
            GraphicsGraphUse(0, graphAccessRead),
            GraphicsGraphUse(0, graphAccessWrite)
        ])
    ])
    val prunedGraph = graphicsRenderGraph([
        GraphicsGraphResource(0, "chain", true, 4, 0)
    ], [
        GraphicsGraphPass(1, "produce", [
            GraphicsGraphUse(0, graphAccessWrite)
        ]),
        GraphicsGraphPass(2, "consume", [
            GraphicsGraphUse(0, graphAccessRead)
        ]),
        GraphicsGraphPass(3, "replace", [
            GraphicsGraphUse(0, graphAccessWrite)
        ])
    ])

    val xkbFixture = "xkb_keymap {\nxkb_keycodes test { <AD02> = 25; <AE01> = 10; <I18N> = 40; };\nxkb_types test { };\nxkb_symbols test {\nkey <AD02> { type= \"ALPHABETIC\", symbols[Group1]= [ w, W ] };\nkey <AE01> { [ 1, exclam ] };\nkey <I18N> { [ U00e9, U00c9 ] };\n};\n};"
    val xkb = xkbParseKeymap(xkbFixture)
    val outputGeometryFixed = waylandU32ArrayPayload([
        4294967286,
