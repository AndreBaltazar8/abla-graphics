        shaderSpecializationUint(12, 8)
    ])
    val mismatchedSpecialization = ShaderSpecialization([
        shaderSpecializationInt(12, 4)
    ])
    val unknownSpecialization = ShaderSpecialization([
        shaderSpecializationUint(99, 4)
    ])
    val scalarSpecializationShader = glslPackage(
