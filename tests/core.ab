        usage = textureUsageRenderAttachment
    ).validation()
    val overflowingTexture = TextureDescriptor(
        size = Extent3D(4294967296, 1),
        usage = textureUsageSampled
    ).validation()
    val invalidDepthAspect = TextureViewDescriptor(
        format = textureFormatRgba8Unorm,
        aspect = textureAspectDepth
    ).validation(TextureDescriptor(
        size = Extent3D(16, 16),
        usage = textureUsageSampled
    ))
    val invalidViewFormat = TextureViewDescriptor(
        format = textureFormatR32Float
    ).validation(TextureDescriptor(
        size = Extent3D(16, 16),
        usage = textureUsageSampled
    ))
    val sampler = SamplerDescriptor(
        magFilter = samplerFilterLinear,
        minFilter = samplerFilterLinear,
        mipmapFilter = samplerFilterLinear,
        maximumAnisotropy = 16
    )
    val invalidSpirv = spirvModule([
        spirvMagic, spirvVersion10, 0, 1, 0, 0
    ])
    val presentSuccess = vulkanPresentStatus(vulkanSuccess)
    val presentSuboptimal = vulkanPresentStatus(vulkanSuboptimal)
    val presentOutOfDate = vulkanPresentStatus(vulkanErrorOutOfDate)
    val presentDeviceLost = vulkanPresentStatus(-4)
    val schedule = graphicsFrameSchedule(60)
    val firstFrameDelay = schedule.delayForNextFrame(1000000)
    val secondFrameDelay = schedule.delayForNextFrame(
        1000000 + firstFrameDelay
    )
    val thirdFrameDelay = schedule.delayForNextFrame(
        1000000 + firstFrameDelay + secondFrameDelay
    )
    val lateSchedule = graphicsFrameSchedule(60)
    val lateFirstDelay = lateSchedule.delayForNextFrame(2000000)
    val lateDelay = lateSchedule.delayForNextFrame(
        52000000
    )
    val exactSchedule = graphicsFrameSchedule(60)
    var exactNow = 0
    var exactTotal = 0
    var exactFrames = 0
    var exactPassed = true
    while (exactPassed && exactFrames < 60) {
        val delay = exactSchedule.delayForNextFrame(exactNow)
        exactPassed = delay >= 0
        if (exactPassed) {
            exactNow = exactNow + delay
            exactTotal = exactTotal + delay
        }
        exactFrames = exactFrames + 1
    }
    val overflowSchedule = graphicsFrameSchedule(60)
    val overflowDelay = overflowSchedule.delayForNextFrame(
        graphicsMaximumInt
    )
    val specializedShader = glslPackage(
        [shaderStageCompute],
        ["#version 450\nlayout(local_size_x=2, local_size_x_id=12) in; void main() {}"]
    )
    val specialization = ShaderSpecialization([
        shaderSpecializationUint(12, 4)
    ])
    val duplicateSpecialization = ShaderSpecialization([
