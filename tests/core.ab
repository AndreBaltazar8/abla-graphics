    val validBufferMap = BufferMapDescriptor(3, 7)
    val defaultBufferMap = BufferMapDescriptor(offset = 4)
    val invalidBufferMapOffset = BufferMapDescriptor(offset = -1)
    val invalidBufferMapSize = BufferMapDescriptor(size = 0)
    val overflowingBufferMap = BufferMapDescriptor(offset = 12, size = 5)
    val validBufferFill = BufferFillDescriptor(
        305419896,
        4,
        8
    ).validation(16)
    val defaultBufferFill = BufferFillDescriptor(offset = 4)
    val invalidBufferFillValue = BufferFillDescriptor(
        value = 4294967296
    ).validation(16)
    val invalidBufferFillOffset = BufferFillDescriptor(
        offset = 2,
        size = 4
    ).validation(16)
    val invalidBufferFillSize = BufferFillDescriptor(
        offset = 4,
        size = 6
    ).validation(16)
    val overflowingBufferFill = BufferFillDescriptor(
        offset = 12,
        size = 8
    ).validation(16)
    val colorTexture = TextureDescriptor(
        label = "color",
        size = Extent3D(1280, 720),
        mipLevels = 11,
        format = textureFormatRgba8UnormSrgb,
        usage = textureUsageSampled | textureUsageCopyDestination
    )
    val colorView = TextureViewDescriptor()
    val textureWrite = TextureWriteDescriptor(2, 1, 1)
    val textureWriteTarget = TextureDescriptor(
        size = Extent3D(16, 16),
        mipLevels = 5,
        format = textureFormatRgba8Unorm,
        usage = textureUsageCopySource | textureUsageCopyDestination
    )
    val validTextureWrite = textureWrite.validation(
        textureWriteTarget,
        2,
        2
    )
    val invalidTextureWrite = TextureWriteDescriptor(
        2,
        3,
        3
    ).validation(textureWriteTarget, 2, 2)
    val missingTextureWriteUsage = TextureWriteDescriptor().validation(
