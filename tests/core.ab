            graphicsMinimumInt + 1
        ) &&
        !overflowingRectangle.contains(graphicsMaximumInt, 0) &&
        !graphicsCheckedAdd(graphicsMaximumInt, 1).succeeded &&
        !graphicsCheckedAdd(graphicsMinimumInt, -1).succeeded &&
        graphicsCheckedAdd(20, -7).value == 13 &&
        !largeArea.succeeded && Extent2D(graphicsMaximumInt, 2).area() == 0 &&
        volume.succeeded && volume.value == 24 &&
        vector.x == 12.0 && vector.y == 16.0 &&
