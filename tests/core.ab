            format = textureFormatBgra8Unorm,
            usage = textureUsageCopyDestination
        )
    )
    val invalidTextureCopyDepth = TextureCopyDescriptor().validation(
        TextureDescriptor(
            size = Extent3D(16, 16),
            format = textureFormatDepth16Unorm,
            usage = textureUsageCopySource
        ),
        TextureDescriptor(
            size = Extent3D(16, 16),
            format = textureFormatDepth16Unorm,
            usage = textureUsageCopyDestination
        )
    )
    val invalidMultisample = TextureDescriptor(
        size = Extent3D(1280, 720),
        mipLevels = 2,
