import "../src/graphics.ab"

fun main: int {
    val automatic = graphicsSelectBackend(
        GraphicsConfig(),
        GraphicsBackendSupport(true, true)
    )
    val fallback = graphicsSelectBackend(
        GraphicsConfig(
            backend = graphicsBackendAuto,
            allowHeadlessFallback = true
        ),
        GraphicsBackendSupport(false, false)
    )
    val unavailable = graphicsSelectBackend(
        GraphicsConfig(backend = graphicsBackendVulkan),
        GraphicsBackendSupport(false, true)
    )
    val invalid = graphicsSelectBackend(
        GraphicsConfig(framesInFlight = 0),
        GraphicsBackendSupport(true, true)
    )
    val rectangle = Rect2D(Offset2D(10, 20), Extent2D(30, 40))
    val vector = Vec2(
        graphicsScalar(2),
        graphicsScalar(3)
    ).plus(Vec2(
        graphicsScalar(4),
        graphicsScalar(5)
    )).scaled(graphicsScalar(2))
    val color = Color(
        graphicsScalar(1, 2),
        graphicsScalar(1, 4),
        graphicsScalar(1),
        graphicsScalar(1, 2)
    ).premultiplied()
    val pixels = pixelBuffer(2, 2)
    val pixelsCleared = pixels.clearRgba8(3, 5, 7, 11)
    val pixelStored = pixels.setRgba8(1, 1, 13, 17, 19, 23)
    val invalidPixelRejected = !pixels.setRgba8(2, 1, 0, 0, 0)
    val vertexBuffer = BufferDescriptor(
        label = "vertices",
        size = 96,
        usage = bufferUsageVertex | bufferUsageCopyDestination
    )
    val readbackBuffer = BufferDescriptor(
        size = 4096,
        usage = bufferUsageMapRead | bufferUsageCopyDestination
    )
    val invalidMappedBuffer = BufferDescriptor(
        size = 64,
        usage = bufferUsageMapRead | bufferUsageVertex
    ).validation()
    val colorTexture = TextureDescriptor(
        label = "color",
        size = Extent3D(1280, 720),
        mipLevels = 11,
        format = textureFormatRgba8UnormSrgb,
        usage = textureUsageSampled | textureUsageCopyDestination
    )
    val colorView = TextureViewDescriptor(
        mipLevelCount = 11
    )
    val invalidMultisample = TextureDescriptor(
        size = Extent3D(1280, 720),
        mipLevels = 2,
        samples = 4,
        usage = textureUsageRenderAttachment
    ).validation()
    val invalidDepthAspect = TextureViewDescriptor(
        format = textureFormatRgba8Unorm,
        aspect = textureAspectDepth
    ).validation(TextureDescriptor(
        size = Extent3D(16, 16),
        usage = textureUsageSampled
    ))
    val invalidViewFormat = TextureViewDescriptor(
        format = textureFormatR32Float
    ).validation(TextureDescriptor(
        size = Extent3D(16, 16),
        usage = textureUsageSampled
    ))
    val sampler = SamplerDescriptor(
        magFilter = samplerFilterLinear,
        minFilter = samplerFilterLinear,
        mipmapFilter = samplerFilterLinear,
        maximumAnisotropy = 16
    )

    if (automatic.succeeded &&
        automatic.backend == graphicsBackendVulkan &&
        fallback.succeeded &&
        fallback.backend == graphicsBackendHeadless &&
        !unavailable.succeeded &&
        unavailable.error.code == graphicsErrorBackendUnavailable &&
        !invalid.succeeded &&
        invalid.error.code == graphicsErrorInvalidConfiguration &&
        rectangle.contains(10, 20) &&
        rectangle.contains(39, 59) &&
        !rectangle.contains(40, 60) &&
        vector.x == graphicsScalar(12) &&
        vector.y == graphicsScalar(16) &&
        color.red == graphicsScalar(1, 4) &&
        color.alpha == graphicsScalar(1, 2) &&
        graphicsScalarF32Bits(0) == 0 &&
        graphicsScalarF32Bits(graphicsScalar(1, 4)) == 1048576000 &&
        graphicsScalarF32Bits(graphicsScalar(1, 2)) == 1056964608 &&
        graphicsScalarF32Bits(graphicsScalar(1)) == 1065353216 &&
        graphicsUnsignedIntegerF32Bits(0) == 0 &&
        graphicsUnsignedIntegerF32Bits(16) == 1098907648 &&
        graphicsUnsignedIntegerF32Bits(32) == 1107296256 &&
        pixelsCleared && pixelStored && invalidPixelRejected &&
        pixels.rgba8(0, 0) == 185009411 &&
        pixels.rgba8(1, 1) == 387125517 &&
        vertexBuffer.valid() && readbackBuffer.valid() &&
        !invalidMappedBuffer.succeeded &&
        invalidMappedBuffer.field == "usage" &&
        colorTexture.valid() &&
        colorView.resolvedFormat(colorTexture) == textureFormatRgba8UnormSrgb &&
        colorView.validation(colorTexture).succeeded &&
        !invalidMultisample.succeeded &&
        invalidMultisample.field == "samples" &&
        !invalidDepthAspect.succeeded &&
        invalidDepthAspect.field == "aspect" &&
        !invalidViewFormat.succeeded &&
        invalidViewFormat.field == "format" && sampler.valid() &&
        x11KeyFromKeysym(119) == keyW &&
        x11KeyFromKeysym(65307) == keyEscape &&
        x11KeyFromKeysym(65361) == keyLeft &&
        x11KeyFromKeysym(65505) == keyLeftShift &&
        x11KeyFromKeysym(123456) == keyUnknown &&
        x11PointerButton(1) == pointerButtonLeft &&
        x11PointerButton(2) == pointerButtonMiddle &&
        x11PointerButton(3) == pointerButtonRight &&
        x11PointerButton(8) == pointerButtonBack &&
        x11PointerButton(9) == pointerButtonForward &&
        x11PointerButton(4) == pointerButtonUnknown &&
        x11CodepointFromKeysym(97) == 97 &&
        x11CodepointFromKeysym(16778252) == 1036 &&
        x11Utf8(97) == "a" &&
        x11Utf8(163) == "£" &&
        x11Utf8(128512) == "😀") 42 else 1
}
