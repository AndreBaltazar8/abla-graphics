import "../src/graphics.ab"

fun main: int {
    val automatic = graphicsSelectBackend(
        GraphicsConfig(),
        GraphicsBackendSupport(true, true)
    )
    val fallback = graphicsSelectBackend(
        GraphicsConfig(
            backend = graphicsBackendAuto,
            allowHeadlessFallback = true
        ),
        GraphicsBackendSupport(false, false)
    )
    val unavailable = graphicsSelectBackend(
        GraphicsConfig(backend = graphicsBackendVulkan),
        GraphicsBackendSupport(false, true)
    )
    val invalid = graphicsSelectBackend(
        GraphicsConfig(framesInFlight = 0),
        GraphicsBackendSupport(true, true)
    )
    val invalidFeatureMask = graphicsSelectBackend(
        GraphicsConfig(requiredFeatures = 128),
        GraphicsBackendSupport(true, true)
    )
    val featureFallback = graphicsSelectBackend(
        GraphicsConfig(
            requiredFeatures = graphicsFeatureViewFormatReinterpretation
        ),
        GraphicsBackendSupport(
            true,
            true,
            vulkanFeatures = graphicsFeatureAll,
            openGlFeatures = graphicsFeatureAll &
                ~graphicsFeatureViewFormatReinterpretation
        )
    )
    val explicitUnsupported = graphicsSelectBackend(
        GraphicsConfig(
            backend = graphicsBackendOpenGl,
            requiredFeatures = graphicsFeatureViewFormatReinterpretation
        ),
        GraphicsBackendSupport(
            true,
            true,
            openGlFeatures = graphicsFeatureAll &
                ~graphicsFeatureViewFormatReinterpretation
        )
    )
    val automaticUnsupported = graphicsSelectBackend(
        GraphicsConfig(requiredFeatures = graphicsFeatureCompute),
        GraphicsBackendSupport(
            true,
            true,
            vulkanFeatures = graphicsFeatureSampledTextures,
            openGlFeatures = graphicsFeatureSampledTextures
        )
    )
    val capabilities = GraphicsCapabilities(
        graphicsFeatureCompute | graphicsFeatureStorageBuffers |
            graphicsFeatureSampledTextures |
            graphicsFeatureSamplerAnisotropy,
        GraphicsLimits(16384, 134217728, 65535, 1024, 1024, 8),
        GraphicsVersion(1, 4)
    )
    val noAnisotropy = GraphicsCapabilities(
        graphicsFeatureSampledTextures,
        GraphicsLimits(16384),
        GraphicsVersion(4, 5)
    )
    val virtualMonitor = Monitor("virtual", 1920, 1080)
    val rectangle = Rect2D(Offset2D(10, 20), Extent2D(30, 40))
    val boundaryRectangle = Rect2D(
        Offset2D(graphicsMaximumInt - 2, graphicsMinimumInt),
        Extent2D(2, 2)
    )
    val overflowingRectangle = Rect2D(
        Offset2D(graphicsMaximumInt - 1, 0),
        Extent2D(2, 1)
    )
    val largeArea = Extent2D(graphicsMaximumInt, 2).areaChecked()
    val volume = Extent3D(2, 3, 4).volumeChecked()
    val vector = Vec2(2.0, 3.0).plus(Vec2(4.0, 5.0)).scaled(2.0)
    val transform = mat4Translation(Vec3(3.0, 5.0, 7.0)).multiplied(
        mat4Scaling(Vec3(2.0, 3.0, 4.0))
    )
    val transformedPoint = transform.transformPoint(Vec3(1.0, 1.0, 1.0))
    val transformedDirection = transform.transformDirection(Vec3(1.0, 1.0, 1.0))
    val identityPoint = mat4Identity().transformPoint(Vec3(2.0, 4.0, 8.0))
    val color = Color(0.5, 0.25, 1.0, 0.5).premultiplied()
    val pixels = pixelBuffer(2, 2)
    val pixelsCleared = pixels.clearRgba8(3, 5, 7, 11)
    val pixelStored = pixels.setRgba8(1, 1, 13, 17, 19, 23)
    val invalidPixelRejected = !pixels.setRgba8(2, 1, 0, 0, 0)
    val vertexBuffer = BufferDescriptor(
        label = "vertices",
        size = 96,
        usage = bufferUsageVertex | bufferUsageCopyDestination
    )
    val readbackBuffer = BufferDescriptor(
        size = 4096,
        usage = bufferUsageMapRead | bufferUsageCopyDestination
    )
    val invalidMappedBuffer = BufferDescriptor(
        size = 64,
        usage = bufferUsageMapRead | bufferUsageVertex
    ).validation()
    val colorTexture = TextureDescriptor(
        label = "color",
        size = Extent3D(1280, 720),
        mipLevels = 11,
        format = textureFormatRgba8UnormSrgb,
        usage = textureUsageSampled | textureUsageCopyDestination
    )
    val colorView = TextureViewDescriptor()
    val invalidMultisample = TextureDescriptor(
        size = Extent3D(1280, 720),
        mipLevels = 2,
        samples = 4,
        usage = textureUsageRenderAttachment
    ).validation()
    val overflowingTexture = TextureDescriptor(
        size = Extent3D(4294967296, 1),
        usage = textureUsageSampled
    ).validation()
    val invalidDepthAspect = TextureViewDescriptor(
        format = textureFormatRgba8Unorm,
        aspect = textureAspectDepth
    ).validation(TextureDescriptor(
        size = Extent3D(16, 16),
        usage = textureUsageSampled
    ))
    val invalidViewFormat = TextureViewDescriptor(
        format = textureFormatR32Float
    ).validation(TextureDescriptor(
        size = Extent3D(16, 16),
        usage = textureUsageSampled
    ))
    val sampler = SamplerDescriptor(
        magFilter = samplerFilterLinear,
        minFilter = samplerFilterLinear,
        mipmapFilter = samplerFilterLinear,
        maximumAnisotropy = 16
    )
    val invalidSpirv = spirvModule([
        spirvMagic, spirvVersion10, 0, 1, 0, 0
    ])
    val presentSuccess = vulkanPresentStatus(vulkanSuccess)
    val presentSuboptimal = vulkanPresentStatus(vulkanSuboptimal)
    val presentOutOfDate = vulkanPresentStatus(vulkanErrorOutOfDate)
    val presentDeviceLost = vulkanPresentStatus(-4)
    val schedule = graphicsFrameSchedule(60)
    val firstFrameDelay = schedule.delayForNextFrame(1000000)
    val secondFrameDelay = schedule.delayForNextFrame(
        1000000 + firstFrameDelay
    )
    val thirdFrameDelay = schedule.delayForNextFrame(
        1000000 + firstFrameDelay + secondFrameDelay
    )
    val lateSchedule = graphicsFrameSchedule(60)
    val lateFirstDelay = lateSchedule.delayForNextFrame(2000000)
    val lateDelay = lateSchedule.delayForNextFrame(
        52000000
    )
    val exactSchedule = graphicsFrameSchedule(60)
    var exactNow = 0
    var exactTotal = 0
    var exactFrames = 0
    var exactPassed = true
    while (exactPassed && exactFrames < 60) {
        val delay = exactSchedule.delayForNextFrame(exactNow)
        exactPassed = delay >= 0
        if (exactPassed) {
            exactNow = exactNow + delay
            exactTotal = exactTotal + delay
        }
        exactFrames = exactFrames + 1
    }
    val overflowSchedule = graphicsFrameSchedule(60)
    val overflowDelay = overflowSchedule.delayForNextFrame(
        graphicsMaximumInt
    )

    if (automatic.succeeded &&
        automatic.backend == graphicsBackendVulkan &&
        fallback.succeeded &&
        fallback.backend == graphicsBackendHeadless &&
        !unavailable.succeeded &&
        unavailable.error.code == graphicsErrorBackendUnavailable &&
        !invalid.succeeded &&
        invalid.error.code == graphicsErrorInvalidConfiguration &&
        !invalidFeatureMask.succeeded &&
        invalidFeatureMask.error.code == graphicsErrorInvalidConfiguration &&
        featureFallback.succeeded &&
        featureFallback.backend == graphicsBackendVulkan &&
        !explicitUnsupported.succeeded &&
        explicitUnsupported.error.code == graphicsErrorUnsupportedFeature &&
        !automaticUnsupported.succeeded &&
        automaticUnsupported.error.code == graphicsErrorUnsupportedFeature &&
        capabilities.valid() &&
        capabilities.supports(graphicsFeatureCompute |
            graphicsFeatureStorageBuffers) &&
        !capabilities.supports(graphicsFeatureDepthTextures) &&
        graphicsSamplerAnisotropySupported(capabilities, 8) &&
        !graphicsSamplerAnisotropySupported(capabilities, 16) &&
        !graphicsSamplerAnisotropySupported(noAnisotropy, 2) &&
        graphicsPositiveF32Floor(0) == 0 &&
        graphicsPositiveF32Floor(1065353216) == 1 &&
        graphicsPositiveF32Floor(1090519040) == 8 &&
        graphicsPositiveF32Floor(1098907648) == 16 &&
        virtualMonitor.valid() && !virtualMonitor.physicalSizeKnown() &&
        virtualMonitor.dpiX() == 96.0 &&
        virtualMonitor.contentScaleX() == 1.0 &&
        rectangle.contains(10, 20) &&
        rectangle.contains(39, 59) &&
        !rectangle.contains(40, 60) &&
        boundaryRectangle.contains(
            graphicsMaximumInt - 1,
            graphicsMinimumInt + 1
        ) &&
        !overflowingRectangle.contains(graphicsMaximumInt, 0) &&
        !graphicsCheckedAdd(graphicsMaximumInt, 1).succeeded &&
        !graphicsCheckedAdd(graphicsMinimumInt, -1).succeeded &&
        graphicsCheckedAdd(20, -7).value == 13 &&
        !largeArea.succeeded && Extent2D(graphicsMaximumInt, 2).area() == 0 &&
        volume.succeeded && volume.value == 24 &&
        vector.x == 12.0 && vector.y == 16.0 &&
        transformedPoint.x == 5.0 && transformedPoint.y == 8.0 &&
        transformedPoint.z == 11.0 &&
        transformedDirection.x == 2.0 && transformedDirection.y == 3.0 &&
        transformedDirection.z == 4.0 &&
        identityPoint.x == 2.0 && identityPoint.y == 4.0 &&
        identityPoint.z == 8.0 &&
        color.red == 0.25 && color.alpha == 0.5 &&
        graphicsScalarF32Bits(0.0) == 0 &&
        graphicsScalarF32Bits(0.25) == 1048576000 &&
        graphicsScalarF32Bits(0.5) == 1056964608 &&
        graphicsScalarF32Bits(1.0) == 1065353216 &&
        graphicsScalarF32Bits(-1.0) == 3212836864 &&
        graphicsScalarF32Bits(-0.0) == 2147483648 &&
        graphicsScalarF32Bits(1.0e-50) == 0 &&
        graphicsScalarF32Bits(1.401298464324817e-45) == 1 &&
        graphicsUnsignedIntegerF32Bits(0) == 0 &&
        graphicsUnsignedIntegerF32Bits(16) == 1098907648 &&
        graphicsUnsignedIntegerF32Bits(32) == 1107296256 &&
        pixelsCleared && pixelStored && invalidPixelRejected &&
        pixels.rgba8(0, 0) == 185009411 &&
        pixels.rgba8(1, 1) == 387125517 &&
        vertexBuffer.valid() && readbackBuffer.valid() &&
        !invalidMappedBuffer.succeeded &&
        invalidMappedBuffer.field == "usage" &&
        colorTexture.valid() &&
        colorView.resolvedFormat(colorTexture) == textureFormatRgba8UnormSrgb &&
        colorView.resolvedMipLevelCount(colorTexture) == 11 &&
        colorView.validation(colorTexture).succeeded &&
        !invalidMultisample.succeeded &&
        invalidMultisample.field == "samples" &&
        !overflowingTexture.succeeded && overflowingTexture.field == "size" &&
        !invalidDepthAspect.succeeded &&
        invalidDepthAspect.field == "aspect" &&
        !invalidViewFormat.succeeded &&
        invalidViewFormat.field == "format" && sampler.valid() &&
        !invalidSpirv.valid() && invalidSpirv.validation.word == 5 &&
        presentSuccess.presented && !presentSuccess.recreateSwapchain &&
        presentSuboptimal.presented &&
        presentSuboptimal.recreateSwapchain &&
        !presentOutOfDate.presented &&
        presentOutOfDate.recreateSwapchain &&
        !presentDeviceLost.presented &&
        !presentDeviceLost.recreateSwapchain &&
        schedule.valid() && firstFrameDelay == 16666666 &&
        secondFrameDelay == 16666667 && thirdFrameDelay == 16666667 &&
        firstFrameDelay + secondFrameDelay + thirdFrameDelay == 50000000 &&
        !graphicsFrameSchedule(0).valid() &&
        !graphicsFrameSchedule(1001).valid() &&
        !GraphicsFrameSchedule(
            1000,
            graphicsMaximumInt,
            0
        ).valid() &&
        lateFirstDelay == 16666666 && lateDelay == 0 &&
        lateSchedule.deadlineNanoseconds == 52000000 &&
        exactPassed && exactFrames == 60 &&
        exactTotal == graphicsNanosecondsPerSecond &&
        overflowDelay == 0 && overflowSchedule.deadlineNanoseconds ==
            graphicsMaximumInt && !overflowSchedule.resetAt(-1) &&
        x11KeyFromKeysym(119) == keyW &&
        x11KeyFromKeysym(65307) == keyEscape &&
        x11KeyFromKeysym(65361) == keyLeft &&
        x11KeyFromKeysym(65505) == keyLeftShift &&
        x11KeyFromKeysym(123456) == keyUnknown &&
        x11PointerButton(1) == pointerButtonLeft &&
        x11PointerButton(2) == pointerButtonMiddle &&
        x11PointerButton(3) == pointerButtonRight &&
        x11PointerButton(8) == pointerButtonBack &&
        x11PointerButton(9) == pointerButtonForward &&
        x11PointerButton(4) == pointerButtonUnknown &&
        x11CodepointFromKeysym(97) == 97 &&
        x11CodepointFromKeysym(16778252) == 1036 &&
        x11Utf8(97) == "a" &&
        x11Utf8(163) == "£" &&
        x11Utf8(128512) == "😀") 42 else 1
}
