    )
    val textureCopyDestination = TextureDescriptor(
        size = Extent3D(32, 16),
        mipLevels = 5,
        format = textureFormatRgba8Unorm,
        usage = textureUsageCopySource | textureUsageCopyDestination
    )
    val textureCopy = TextureCopyDescriptor(2, 1, 1, 1, 3, 4, 2, 2)
    val validTextureCopy = textureCopy.validation(
        textureWriteTarget,
        textureCopyDestination
    )
    val defaultTextureCopy = TextureCopyDescriptor(
        sourceMipLevel = 2,
        sourceX = 1,
        sourceY = 1,
        destinationMipLevel = 2
    )
    val invalidTextureCopySource = TextureCopyDescriptor(
        sourceMipLevel = 2,
        sourceX = 3,
