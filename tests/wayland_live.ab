import "../src/platform/wayland.ab"

fun main: int {
    val connection = waylandConnection()
    val compositor = connection.global("wl_compositor")
    val sharedMemory = connection.global("wl_shm")
    val shell = connection.global("xdg_wm_base")
    val boundCompositor = connection.bind("wl_compositor", 4)
    val synchronized = boundCompositor.valid && connection.roundtrip()
    if (connection.valid() && connection.globals.size >= 3 &&
        compositor.valid && compositor.version >= 4 &&
        sharedMemory.valid && shell.valid &&
        boundCompositor.interfaceName == "wl_compositor" &&
        boundCompositor.version == 4 && synchronized) 42 else 1
}
