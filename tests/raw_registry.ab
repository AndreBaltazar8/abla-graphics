import "../src/driver/vulkan_builder.ab"

fun registryContains(values: array<string>, wanted: string): bool {
    var found = false
    var index = 0
    while (!found && index < values.size) {
        found = values[index] == wanted
        index = index + 1
    }
    found
}

fun registryIndex(values: array<string>, wanted: string): int {
    var found = -1
    var index = 0
    while (found < 0 && index < values.size) {
        if (values[index] == wanted) found = index
        index = index + 1
    }
    found
}

fun registryCount(values: array<string>, wanted: string): int {
    var count = 0
    var index = 0
    while (index < values.size) {
        if (values[index] == wanted) count = count + 1
        index = index + 1
    }
    count
}

fun registrySupportedCandidatesMatch(
    abis: array<string>,
    candidates: array<string>
): bool {
    var valid = abis.size == candidates.size
    var index = 0
    while (valid && index < abis.size) {
        if (abis[index] != "unsupported" &&
            abis[index] != candidates[index]) valid = false
        index = index + 1
    }
    valid
}

fun registryParameterIndex(
    owners: array<string>,
    names: array<string>,
    owner: string,
    wanted: string
): int {
    var found = -1
    var index = 0
    while (found < 0 && index < owners.size && index < names.size) {
        if (owners[index] == owner && names[index] == wanted) found = index
        index = index + 1
    }
    found
}

