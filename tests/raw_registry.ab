import "../src/raw/vulkan_registry.ab"

fun registryContains(values: array<string>, wanted: string): bool {
    var found = false
    var index = 0
    while (!found && index < values.size) {
        found = values[index] == wanted
        index = index + 1
    }
    found
}

fun registryIndex(values: array<string>, wanted: string): int {
    var found = -1
    var index = 0
    while (found < 0 && index < values.size) {
        if (values[index] == wanted) found = index
        index = index + 1
    }
    found
}

fun registryParameterIndex(
    owners: array<string>,
    names: array<string>,
    owner: string,
    wanted: string
): int {
    var found = -1
    var index = 0
    while (found < 0 && index < owners.size && index < names.size) {
        if (owners[index] == owner && names[index] == wanted) found = index
        index = index + 1
    }
    found
}

fun main: int {
    val vulkanCommands = rawVulkanRegistryCommands()
    val vulkanStatuses = rawVulkanRegistryCommandStatuses()
    val vulkanConstants = rawVulkanRegistryConstantNames()
    val vulkanTypes = rawVulkanRegistryTypes()
    val vulkanTypeCategories = rawVulkanRegistryTypeCategories()
    val vulkanTypeAliases = rawVulkanRegistryTypeAliases()
    val vulkanTypeDependencies = rawVulkanRegistryTypeDependencies()
    val vulkanReturnTypes = rawVulkanRegistryCommandReturnTypes()
    val vulkanParameterCounts = rawVulkanRegistryCommandParameterCounts()
    val vulkanParameterOwners = rawVulkanRegistryCommandParameterOwners()
    val vulkanParameterNames = rawVulkanRegistryCommandParameterNames()
    val vulkanParameterTypes = rawVulkanRegistryCommandParameterTypes()
    val vulkanParameterPointers =
        rawVulkanRegistryCommandParameterPointerLevels()
    val vulkanParameterConstness =
        rawVulkanRegistryCommandParameterConstness()
    val vulkanCallShapes = rawVulkanRegistryCommandCallShapes()
    val vulkanCallAbis = rawVulkanRegistryCommandCallAbis()
    val vulkanAggregates = rawVulkanRegistryAggregates()
    val vulkanAggregateKinds = rawVulkanRegistryAggregateKinds()
    val vulkanMemberOwners = rawVulkanRegistryAggregateMemberOwners()
    val vulkanMemberNames = rawVulkanRegistryAggregateMemberNames()
    val vulkanMemberTypes = rawVulkanRegistryAggregateMemberTypes()
    val vulkanMemberPointers =
        rawVulkanRegistryAggregateMemberPointerLevels()
    val vulkanMemberConstness =
        rawVulkanRegistryAggregateMemberConstness()
    val vulkanMemberArrayShapes =
        rawVulkanRegistryAggregateMemberArrayShapes()
    val vulkanMemberBitWidths =
        rawVulkanRegistryAggregateMemberBitWidths()
    val applicationInfoIndex = registryIndex(vulkanTypes, "VkApplicationInfo")
    val featuresAliasIndex = registryIndex(
        vulkanTypes,
        "VkPhysicalDeviceFeatures2KHR"
    )
    val createInstanceIndex = registryIndex(
        vulkanCommands,
        "vkCreateInstance"
    )
    val setDeviceMaskIndex = registryIndex(
        vulkanCommands,
        "vkCmdSetDeviceMask"
    )
    val createInfoIndex = registryParameterIndex(
        vulkanParameterOwners,
        vulkanParameterNames,
        "vkCreateInstance",
        "pCreateInfo"
    )
    val blendConstantsIndex = registryParameterIndex(
        vulkanParameterOwners,
        vulkanParameterNames,
        "vkCmdSetBlendConstants",
        "blendConstants"
    )
    val applicationNameIndex = registryParameterIndex(
        vulkanMemberOwners,
        vulkanMemberNames,
        "VkApplicationInfo",
        "pApplicationName"
    )
    val deviceNameIndex = registryParameterIndex(
        vulkanMemberOwners,
        vulkanMemberNames,
        "VkPhysicalDeviceProperties",
        "deviceName"
    )
    val matrixIndex = registryParameterIndex(
        vulkanMemberOwners,
        vulkanMemberNames,
        "VkTransformMatrixKHR",
        "matrix"
    )
    val customIndexIndex = registryParameterIndex(
        vulkanMemberOwners,
        vulkanMemberNames,
        "VkAccelerationStructureInstanceKHR",
        "instanceCustomIndex"
    )
    val valid = rawVulkanRegistryCommandCount == 842 &&
        rawVulkanRegistryCoreFeatureCount == 5 &&
        rawVulkanRegistryExtensionCount == 473 &&
        rawVulkanRegistryConstantCount == 5633 &&
        rawVulkanRegistryTypeCount == 2497 &&
        vulkanConstants.size == rawVulkanRegistryConstantCount &&
        vulkanTypes.size == rawVulkanRegistryTypeCount &&
        vulkanTypeCategories.size == vulkanTypes.size &&
        vulkanTypeAliases.size == vulkanTypes.size &&
        vulkanTypeDependencies.size == vulkanTypes.size &&
        applicationInfoIndex >= 0 &&
        vulkanTypeCategories[applicationInfoIndex] == "struct" &&
        featuresAliasIndex >= 0 &&
        vulkanTypeAliases[featuresAliasIndex] ==
            "VkPhysicalDeviceFeatures2" &&
        registryContains(vulkanConstants, "VK_TRUE") &&
        registryContains(vulkanConstants, "VK_STENCIL_FRONT_AND_BACK") &&
        !registryContains(vulkanConstants, "VK_SC_CONSTANT") &&
        !registryContains(
            vulkanConstants,
            "VK_ACCESS_2_RESERVED_63_BIT_EXT"
        ) &&
        VK_TRUE == 1 &&
        VK_WHOLE_SIZE == -1 &&
        VK_LOD_CLAMP_NONE == 1000.0 &&
        VK_ACCESS_2_SHADER_SAMPLED_READ_BIT == 0x100000000 &&
        VK_ERROR_OUT_OF_DATE_KHR == -1000001004 &&
        VK_KHR_SURFACE_EXTENSION_NAME == "VK_KHR_surface" &&
        VK_STENCIL_FRONT_AND_BACK == 0x00000003 &&
        vulkanCommands.size == rawVulkanRegistryCommandCount &&
        vulkanStatuses.size == vulkanCommands.size &&
        vulkanReturnTypes.size == vulkanCommands.size &&
        vulkanParameterCounts.size == vulkanCommands.size &&
        vulkanParameterOwners.size == 2845 &&
        vulkanParameterNames.size == vulkanParameterOwners.size &&
        vulkanParameterTypes.size == vulkanParameterOwners.size &&
        vulkanParameterPointers.size == vulkanParameterOwners.size &&
        vulkanParameterConstness.size == vulkanParameterOwners.size &&
        vulkanCallShapes.size == vulkanCommands.size &&
        vulkanCallAbis.size == vulkanCommands.size &&
        createInstanceIndex >= 0 &&
        vulkanCallShapes[createInstanceIndex] ==
            "VkResult(const VkInstanceCreateInfo*,const VkAllocationCallbacks*,VkInstance*)" &&
        vulkanCallAbis[createInstanceIndex] == "unsupported" &&
        setDeviceMaskIndex >= 0 &&
        vulkanCallShapes[setDeviceMaskIndex] ==
            "void(VkCommandBuffer,uint32_t)" &&
        vulkanCallAbis[setDeviceMaskIndex] == "void(pointer,i32)" &&
        vulkanReturnTypes[createInstanceIndex] == "VkResult" &&
        vulkanParameterCounts[createInstanceIndex] == "3" &&
        createInfoIndex >= 0 &&
        vulkanParameterTypes[createInfoIndex] == "VkInstanceCreateInfo" &&
        vulkanParameterPointers[createInfoIndex] == "1" &&
        vulkanParameterConstness[createInfoIndex] == "true" &&
        blendConstantsIndex >= 0 &&
        vulkanParameterTypes[blendConstantsIndex] == "float" &&
        vulkanParameterPointers[blendConstantsIndex] == "1" &&
        vulkanParameterConstness[blendConstantsIndex] == "true" &&
        vulkanAggregates.size == 1450 &&
        vulkanAggregateKinds.size == vulkanAggregates.size &&
        vulkanMemberOwners.size == 7413 &&
        vulkanMemberNames.size == vulkanMemberOwners.size &&
        vulkanMemberTypes.size == vulkanMemberOwners.size &&
        vulkanMemberPointers.size == vulkanMemberOwners.size &&
        vulkanMemberConstness.size == vulkanMemberOwners.size &&
        vulkanMemberArrayShapes.size == vulkanMemberOwners.size &&
        vulkanMemberBitWidths.size == vulkanMemberOwners.size &&
        applicationNameIndex >= 0 &&
        vulkanMemberTypes[applicationNameIndex] == "char" &&
        vulkanMemberPointers[applicationNameIndex] == "1" &&
        vulkanMemberConstness[applicationNameIndex] == "true" &&
        deviceNameIndex >= 0 &&
        vulkanMemberArrayShapes[deviceNameIndex] ==
            "VK_MAX_PHYSICAL_DEVICE_NAME_SIZE" &&
        matrixIndex >= 0 &&
        vulkanMemberArrayShapes[matrixIndex] == "3,4" &&
        customIndexIndex >= 0 &&
        vulkanMemberBitWidths[customIndexIndex] == "24" &&
        registryContains(vulkanCommands, "vkCmdWriteTimestamp") &&
        registryContains(vulkanStatuses, "common") &&
        registryContains(vulkanStatuses, "unclassified")
    if (valid) 42 else 1
}
