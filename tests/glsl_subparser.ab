        transformCubeVertex.module.valid() &&
        transformCubeVertex.module.words.size == 254 &&
        transformCubeVertex.module.bound() == 41 &&
        spirvWordsEqual(
            transformCubeVertex.module,
            transformCubeVertexAgain.module
        ) &&
        pushStorage.valid && pushStorage.pushConstants.size == 1 &&
        pushStorageSpirv.succeeded && pushStorageSpirv.module.valid() &&
        pushStorageSpirv.module.bound() == 26 &&
        spirvWordsEqual(pushStorageSpirv.module, pushStorageSpirvAgain.module) &&
        spirvInstructionOperand(pushStorageSpirv.module, 32, 2, 9) &&
        glslContainsText(
            pushStorageOpenGlSource,
            "layout(std140, binding = 15)"
        ) &&
        !glslContainsText(pushStorageOpenGlSource, "push_constant") &&
        !unsupportedTriangle.succeeded && unsupportedTriangle.error != "" &&
        shader.source(shaderStageVertex) != "" &&
        shader.source(shaderStageFragment) != "") 42 else 1
}
