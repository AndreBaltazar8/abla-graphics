import "../src/shader/glsl.ab"
import "../src/shader/glsl_spirv.ab"

fun spirvWordsOrdered(
    module: SpirvModule,
    first: int,
    second: int
): bool {
    var firstIndex = -1
    var secondIndex = -1
    var index = 0
    while (index < module.words.size) {
        if (firstIndex < 0 && module.words[index] == first) firstIndex = index
        if (secondIndex < 0 && module.words[index] == second) {
            secondIndex = index
        }
        index = index + 1
    }
    firstIndex >= 0 && secondIndex > firstIndex
}

fun spirvContainsWord(module: SpirvModule, word: int): bool {
    var found = false
    var index = 0
    while (!found && index < module.words.size) {
        found = module.words[index] == word
        index = index + 1
    }
    found
}

