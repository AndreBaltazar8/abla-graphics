            #version 450
            // ${interpolatedSize} remains inert inside comments.
            layout(local_size_x = ${uint: interpolatedSize}) in;
            layout(constant_id = 3) const int scale = ${int: interpolatedScale};
            layout(constant_id = 4) const bool enabled = ${bool: interpolatedEnabled};
            void main() {}
        }
    }
    val frozenInterpolated = #$glsl {
        compute {
