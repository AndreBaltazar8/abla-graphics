import "../src/shader/glsl.ab"
import "../src/shader/glsl_spirv.ab"

fun main: int {
    val shader = $glsl {
        vertex {
            #version 330 core
            // Nested scopes remain source text.
            layout(location = 0) in vec2 position;
            layout(location = 1) flat out highp vec3 tint;
            void main() {
                gl_Position = vec4(0.0, 0.0, 0.0, 1.0);
            }
        }
        fragment {
            #version 330 core
            /* Braces in comments do not alter depth: { } */
            layout(location = 1) flat in highp vec3 interpolatedTint;
            layout(location = 0) out vec4 color;
            layout(set = 1, binding = 2) uniform sampler2D atlas[4];
            void main() {
                color = vec4(0.1, 0.5, 0.9, 1.0);
            }
        }
    }
    val frozen = #$glsl {
        compute {
            #version 450 core
            layout(local_size_x = 8) in;
            void main() {}
        }
    }
    val duplicate = glslPackage(
        [shaderStageVertex, shaderStageFragment],
        [
            "layout(location=3) in vec2 first; layout(location=3) in vec2 second;",
            "layout(location=0) out vec4 color;"
        ]
    )
    val malformed = glslPackage(
        [shaderStageVertex],
        ["layout(location = 0 in vec2 broken;"]
    )
    val duplicateBinding = glslPackage(
        [shaderStageFragment],
        ["layout(set=0,binding=1) uniform sampler2D first; layout(set=0,binding=1) uniform sampler2D second;"]
    )
    val mismatchedInterface = glslPackage(
        [shaderStageVertex, shaderStageFragment],
        [
            "layout(location=2) out vec3 value; void main() {}",
            "layout(location=2) in vec2 value; void main() {}"
        ]
    )
    val missingInterface = glslPackage(
        [shaderStageVertex, shaderStageFragment],
        [
            "void main() {}",
            "layout(location=4) in vec4 missing; void main() {}"
        ]
    )
    val missingWorkgroupX = glslPackage(
        [shaderStageCompute],
        ["layout(local_size_y=4) in; void main() {}"]
    )
    val repeatedWorkgroup = glslPackage(
        [shaderStageCompute],
        ["layout(local_size_x=8) in; layout(local_size_x=4) in; void main() {}"]
    )
    val invalidBindingArray = glslPackage(
        [shaderStageCompute],
        ["layout(set=0,binding=0) uniform sampler2D images[0]; void main() {}"]
    )
    val emitted = frozen.spirv(shaderStageCompute)
    val emittedAgain = frozen.spirv(shaderStageCompute)
    val unsupportedCompute = glslPackage(
        [shaderStageCompute],
        ["#version 450\nlayout(local_size_x=8) in; void main() { uint value = 1; }"]
    ).spirv(shaderStageCompute)
    val unsupportedVersion = glslPackage(
        [shaderStageCompute],
        ["#version 430\nlayout(local_size_x=8) in; void main() {}"]
    ).spirv(shaderStageCompute)
    val storage = $glsl {
        compute {
            #version 450
            layout(local_size_x = 1) in;
            layout(std430, binding = 0) buffer Values {
                uint value;
            } values;
            void main() { values.value = 42u; }
        }
    }
    val storageSpirv = storage.spirv(shaderStageCompute)
    val storageSpirvAgain = storage.spirv(shaderStageCompute)
    val storage77 = glslPackage(
        [shaderStageCompute],
        ["#version 450\nlayout(local_size_x=1) in; layout(binding=0) buffer Values { uint value; } values; void main(){ values.value=77u; }"]
    ).spirv(shaderStageCompute)
    val storageIncrement = glslPackage(
        [shaderStageCompute],
        ["#version 450\nlayout(local_size_x=1) in; layout(binding=0) buffer Values { uint value; } values; void main(){ values.value=values.value+1u; }"]
    ).spirv(shaderStageCompute)
    val storageMultiply = glslPackage(
        [shaderStageCompute],
        ["#version 450\nlayout(local_size_x=1) in; layout(binding=0) buffer Values { uint value; } values; void main(){ values.value=values.value*3u; }"]
    ).spirv(shaderStageCompute)
    val unsupportedStorageSubtract = glslPackage(
        [shaderStageCompute],
        ["#version 450\nlayout(local_size_x=1) in; layout(binding=0) buffer Values { uint value; } values; void main(){ values.value=values.value-1u; }"]
    ).spirv(shaderStageCompute)
    val triangle = $glsl {
        vertex {
            #version 450
            const vec2 positions[3] = vec2[3](
                vec2(-0.75, -0.65),
                vec2(0.75, -0.65),
                vec2(0.0, 0.75)
            );
            void main() {
                gl_Position = vec4(
                    positions[gl_VertexID],
                    0.0,
                    1.0
                );
            }
        }
        fragment {
            #version 450
            layout(location = 0) out vec4 color;
            void main() {
                color = vec4(0.12, 0.54, 0.96, 1.0);
            }
        }
    }
    val triangleVertex = triangle.spirv(shaderStageVertex)
    val triangleVertexAgain = triangle.spirv(shaderStageVertex)
    val triangleFragment = triangle.spirv(shaderStageFragment)
    val triangleFragmentAgain = triangle.spirv(shaderStageFragment)
    val vertexBufferTriangle = $glsl {
        vertex {
            #version 450
            layout(location = 0) in vec2 position;
            void main() {
                gl_Position = vec4(position, 0.0, 1.0);
            }
        }
        fragment {
            #version 450
            layout(location = 0) out vec4 color;
            void main() {
                color = vec4(0.12, 0.54, 0.96, 1.0);
            }
        }
    }
    val vertexBufferSpirv = vertexBufferTriangle.spirv(shaderStageVertex)
    val vertexBufferSpirvAgain =
        vertexBufferTriangle.spirv(shaderStageVertex)
    val unsupportedTriangle = glslPackage(
        [shaderStageVertex, shaderStageFragment],
        [
            "#version 450\nvoid main() { gl_Position = vec4(0.0); }",
            "#version 450\nlayout(location=0) out vec4 color; void main(){ color=vec4(1.0); }"
        ]
    ).spirv(shaderStageVertex)
    if (shader.valid && frozen.valid && frozen.stages.size == 1 &&
        frozen.stages[0].kind == shaderStageCompute &&
        shader.stages.size == 2 &&
        shader.locations.size == 4 &&
        shader.locations[0].stage == shaderStageVertex &&
        shader.locations[0].location == 0 &&
        shader.locations[0].direction == "in" &&
        shader.locations[0].dataType == "vec2" &&
        shader.locations[0].name == "position" &&
        shader.locations[1].stage == shaderStageVertex &&
        shader.locations[1].direction == "out" &&
        shader.locations[1].dataType == "vec3" &&
        shader.locations[2].stage == shaderStageFragment &&
        shader.locations[2].direction == "in" &&
        shader.locations[2].dataType == "vec3" &&
        shader.locations[3].stage == shaderStageFragment &&
        shader.locations[3].direction == "out" &&
        shader.bindings.size == 1 &&
        shader.bindings[0].set == 1 && shader.bindings[0].binding == 2 &&
        shader.bindings[0].storage == "uniform" &&
        shader.bindings[0].dataType == "sampler2D" &&
        shader.bindings[0].name == "atlas" &&
        shader.bindings[0].arraySize == 4 &&
        frozen.workgroups.size == 1 &&
        frozen.workgroups[0].stage == shaderStageCompute &&
        frozen.workgroups[0].x == 8 && frozen.workgroups[0].y == 1 &&
        frozen.workgroups[0].z == 1 &&
        !duplicate.valid && duplicate.error != "" &&
        !malformed.valid && malformed.error != "" &&
        !duplicateBinding.valid && duplicateBinding.error != "" &&
        !mismatchedInterface.valid && mismatchedInterface.error != "" &&
        !missingInterface.valid && missingInterface.error != "" &&
        !missingWorkgroupX.valid && missingWorkgroupX.error != "" &&
        !repeatedWorkgroup.valid && repeatedWorkgroup.error != "" &&
        !invalidBindingArray.valid && invalidBindingArray.error != "" &&
        emitted.succeeded && emitted.module.valid() &&
        emitted.module.words.size == 35 &&
        emitted.module.words[18] == 8 && emitted.module.words[19] == 1 &&
        emitted.module.words[20] == 1 &&
        spirvWordsEqual(emitted.module, emittedAgain.module) &&
        !unsupportedCompute.succeeded && unsupportedCompute.error != "" &&
        !unsupportedVersion.succeeded && unsupportedVersion.error != "" &&
        storage.valid && storage.bindings.size == 1 &&
        storage.bindings[0].storage == "buffer" &&
        storageSpirv.succeeded && storageSpirv.module.valid() &&
        storageSpirv.module.words.size == 86 &&
        spirvWordsEqual(storageSpirv.module, storageSpirvAgain.module) &&
        storage77.succeeded && storage77.module.words[64] == 77 &&
        storageIncrement.succeeded && storageIncrement.module.valid() &&
        storageIncrement.module.words.size == 95 &&
        storageMultiply.succeeded && storageMultiply.module.valid() &&
        storageMultiply.module.words.size == 95 &&
        storageMultiply.module.words[85] == 327812 &&
        !unsupportedStorageSubtract.succeeded &&
        unsupportedStorageSubtract.error != "" &&
        triangle.valid && triangle.locations.size == 1 &&
        triangleVertex.succeeded && triangleVertex.module.valid() &&
        triangleVertex.module.words.size == 232 &&
        triangleVertex.module.bound() == 42 &&
        spirvWordsEqual(
            triangleVertex.module,
            triangleVertexAgain.module
        ) &&
        triangleFragment.succeeded && triangleFragment.module.valid() &&
        triangleFragment.module.words.size == 84 &&
        triangleFragment.module.bound() == 15 &&
        spirvWordsEqual(
            triangleFragment.module,
            triangleFragmentAgain.module
        ) &&
        vertexBufferTriangle.valid &&
        vertexBufferTriangle.locations.size == 2 &&
        vertexBufferSpirv.succeeded && vertexBufferSpirv.module.valid() &&
        vertexBufferSpirv.module.words.size == 158 &&
        vertexBufferSpirv.module.bound() == 27 &&
        spirvWordsEqual(
            vertexBufferSpirv.module,
            vertexBufferSpirvAgain.module
        ) &&
        !unsupportedTriangle.succeeded && unsupportedTriangle.error != "" &&
        shader.source(shaderStageVertex) != "" &&
        shader.source(shaderStageFragment) != "") 42 else 1
}
