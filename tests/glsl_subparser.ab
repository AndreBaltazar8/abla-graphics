import "../src/shader/glsl.ab"
import "../src/shader/glsl_spirv.ab"

fun spirvWordsOrdered(
    module: SpirvModule,
    first: int,
    second: int
): bool {
    var firstIndex = -1
    var secondIndex = -1
    var index = 0
    while (index < module.words.size) {
        if (firstIndex < 0 && module.words[index] == first) firstIndex = index
        if (secondIndex < 0 && module.words[index] == second) {
            secondIndex = index
        }
        index = index + 1
    }
    firstIndex >= 0 && secondIndex > firstIndex
}

fun spirvContainsWord(module: SpirvModule, word: int): bool {
    var found = false
    var index = 0
    while (!found && index < module.words.size) {
        found = module.words[index] == word
        index = index + 1
    }
    found
}

fun spirvWordCount(module: SpirvModule, word: int): int {
    var count = 0
    var index = 0
    while (index < module.words.size) {
        if (module.words[index] == word) count = count + 1
        index = index + 1
    }
    count
}

fun spirvInstructionOperand(
    module: SpirvModule,
    opcode: int,
    operand: int,
    value: int
): bool {
    var found = false
    var index = 5
    while (!found && index < module.words.size) {
        val instruction = module.words[index]
        val count = (instruction >> 16) & 65535
        found = (instruction & 65535) == opcode && operand < count &&
            module.words[index + operand] == value
        index = index + if (count > 0) count else 1
    }
    found
}

fun spirvContainsWords(
    module: SpirvModule,
    wanted: array<int>
): bool {
    var found = false
    var begin = 0
    while (!found && wanted.size > 0 &&
        begin <= module.words.size - wanted.size) {
        var matches = true
        var index = 0
        while (matches && index < wanted.size) {
            matches = module.words[begin + index] == wanted[index]
            index = index + 1
        }
        found = matches
        begin = begin + 1
    }
    found
}

