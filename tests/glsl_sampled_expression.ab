            queriedSecond.module
        )) 49
        else if (invalidQueryWidth.succeeded ||
            invalidQueryWidth.error == "") 50
        else if (invalidQueryLod.succeeded ||
            invalidQueryLod.error == "") 51
        else if (invalidFloatingQuery.succeeded ||
            invalidFloatingQuery.error == "") 54
        else if (invalidSignedConversion.succeeded ||
            invalidSignedConversion.error == "") 55
        else if (invalidIntegerAssignment.succeeded ||
            invalidIntegerAssignment.error == "") 56
        else if (invalidIntegerUpdate.succeeded ||
            invalidIntegerUpdate.error == "") 57
        else 42
    val gatherResult = if (!gathered.valid) 60
        else if (!gatheredProgram.valid) 61
        else if (!gatheredFirst.succeeded) 62
        else if (!gatheredFirst.module.valid()) 63
        else if (sampledInstructionFormCount(
            gatheredFirst.module, 393312
        ) != 3) 64
        else if (sampledInstructionFormCount(
            gatheredFirst.module, 524384
        ) != 4) 65
        else if (sampledImageOperandCount(
            gatheredFirst.module, 524384, 16
        ) != 2) 73
        else if (sampledImageOperandCount(
            gatheredFirst.module, 524384, 32
        ) != 2) 74
        else if (!sampledCapability(gatheredFirst.module, 25)) 66
        else if (!sampledWordsEqual(
            gatheredFirst.module,
            gatheredSecond.module
        )) 67
        else if (!plainGather.succeeded ||
            !plainGather.module.valid() ||
            sampledCapability(plainGather.module, 25)) 68
        else if (invalidGatherVolume.succeeded ||
            invalidGatherVolume.error == "") 69
        else if (invalidGatherCubeOffset.succeeded ||
            invalidGatherCubeOffset.error == "") 70
        else if (invalidGatherWidth.succeeded ||
            invalidGatherWidth.error == "") 71
        else if (invalidGatherComponent.succeeded ||
            invalidGatherComponent.error == "") 72
        else if (invalidGatherOffsetsRuntime.succeeded ||
            invalidGatherOffsetsRuntime.error == "") 75
        else if (invalidGatherOffsetsCount.succeeded ||
            invalidGatherOffsetsCount.error == "") 76
        else 42
    val biasResult = if (!biased.valid) 80
        else if (!biasedProgram.valid) 81
        else if (!biasedFirst.succeeded) 82
        else if (!biasedFirst.module.valid()) 83
        else if (sampledInstructionFormCount(
            biasedFirst.module, 458839
        ) != 4) 84
        else if (sampledInstructionFormCount(
            biasedFirst.module, 524375
        ) != 3) 85
        else if (!projectedBiased.valid ||
            !projectedBiasedProgram.valid ||
            !projectedBiasedFirst.succeeded ||
            !projectedBiasedFirst.module.valid()) 86
        else if (sampledInstructionFormCount(
            projectedBiasedFirst.module, 458843
        ) != 2) 87
        else if (sampledInstructionFormCount(
            projectedBiasedFirst.module, 524379
        ) != 2) 88
        else if (!sampledWordsEqual(
            biasedFirst.module,
            biasedSecond.module
        ) || !sampledWordsEqual(
            projectedBiasedFirst.module,
            projectedBiasedSecond.module
        )) 91
        else if (invalidBiasWidth.succeeded ||
            invalidBiasWidth.error == "") 89
        else if (invalidExplicitBias.succeeded ||
            invalidExplicitBias.error == "") 90
        else 42
    if (fetchResult != 42) fetchResult
    else if (offsetResult != 42) offsetResult
    else if (queryResult != 42) queryResult
    else if (gatherResult != 42) gatherResult
    else if (biasResult != 42) biasResult
    else if (shader.valid && shader.bindings.size == 2 && program.valid &&
        program.samplers.size == 2 && program.samplers[0].binding == 0 &&
        program.samplers[1].binding == 1 && first.succeeded &&
        first.module.valid() && sampledWordCount(first.module, 327767) == 0 &&
        sampledWordCount(first.module, 458840) == 1 &&
        sampledWordCount(first.module, 524376) == 1 &&
        sampledWordsEqual(first.module, second.module) &&
        !invalid.succeeded && invalid.error != "" && wider.valid &&
        widerProgram.valid && widerProgram.samplers.size == 3 &&
        widerProgram.samplers[0].coordinateType == glslRasterTypeVector3 &&
        widerFirst.succeeded && widerFirst.module.valid() &&
        sampledWordCount(widerFirst.module, 327767) == 0 &&
        sampledWordCount(widerFirst.module, 458840) == 1 &&
        sampledWordCount(widerFirst.module, 524376) == 2 &&
        sampledImageType(widerFirst.module, 1, 1) &&
        sampledImageType(widerFirst.module, 3, 0) &&
        sampledImageType(widerFirst.module, 2, 0) &&
        sampledWordsEqual(widerFirst.module, widerSecond.module) &&
        !invalidWider.succeeded && invalidWider.error != "" &&
        projected.valid && projectedFirst.succeeded &&
        projectedFirst.module.valid() &&
        sampledWordCount(projectedFirst.module, 327771) == 1 &&
        sampledWordCount(projectedFirst.module, 458844) == 1 &&
        sampledWordCount(projectedFirst.module, 524380) == 1 &&
        sampledWordsEqual(projectedFirst.module, projectedSecond.module) &&
        !invalidProjected.succeeded && invalidProjected.error != "")
        42 else 1
}
