import "../src/shader/glsl.ab"
import "../src/shader/glsl_spirv.ab"

fun sampledWordsEqual(left: SpirvModule, right: SpirvModule): bool {
    var equal = left.words.size == right.words.size
    var index = 0
    while (equal && index < left.words.size) {
        equal = left.words[index] == right.words[index]
        index = index + 1
    }
    equal
}

fun sampledWordCount(module: SpirvModule, word: int): int {
    var count = 0
    var index = 0
    while (index < module.words.size) {
        if (module.words[index] == word) count = count + 1
        index = index + 1
    }
    count
}

fun sampledInstructionFormCount(
    module: SpirvModule,
    instruction: int
): int {
    var count = 0
    var index = 5
    while (index < module.words.size) {
        val current = module.words[index]
        val wordCount = (current >> 16) & 65535
        if (current == instruction) count = count + 1
        index = index + if (wordCount > 0) wordCount else 1
    }
    count
}

fun sampledCapability(module: SpirvModule, capability: int): bool {
    var found = false
    var index = 5
    while (!found && index < module.words.size) {
        val instruction = module.words[index]
        val wordCount = (instruction >> 16) & 65535
        found = instruction == 131089 && index + 1 < module.words.size &&
            module.words[index + 1] == capability
        index = index + if (wordCount > 0) wordCount else 1
    }
    found
}

fun sampledImageType(
    module: SpirvModule,
    dimension: int,
    arrayed: int
): bool {
    var found = false
    var index = 5
    while (!found && index < module.words.size) {
        val instruction = module.words[index]
        val count = (instruction >> 16) & 65535
        found = (instruction & 65535) == 25 && count == 9 &&
            module.words[index + 3] == dimension &&
            module.words[index + 5] == arrayed
        index = index + if (count > 0) count else 1
    }
    found
}

trusted fun main: int {
    val shader = glslPackage(
        [shaderStageVertex, shaderStageFragment],
        [
            "#version 450\nlayout(location=0) in vec2 position; layout(location=1) in vec2 uv; layout(location=0) out vec2 texCoord; void main(){ gl_Position=vec4(position,0.0,1.0); texCoord=uv; }",
            "#version 450\nlayout(location=0) in vec2 texCoord; layout(location=0) out vec4 color; layout(set=0,binding=0) uniform sampler2D albedo; layout(binding=1) uniform sampler2D detail; void main(){ vec2 shifted=texCoord*0.5+vec2(0.25); vec4 base=textureLod(albedo,shifted,0.0); color=mix(base.bgra,textureGrad(detail,texCoord,dFdx(texCoord),dFdy(texCoord)).rgba,0.25); }"
        ]
    )
    val program = shader.rasterFragmentProgram()
    val first = shader.spirv(shaderStageFragment)
    val second = shader.spirv(shaderStageFragment)
