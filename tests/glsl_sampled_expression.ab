import "../src/shader/glsl.ab"
import "../src/shader/glsl_spirv.ab"

fun sampledWordsEqual(left: SpirvModule, right: SpirvModule): bool {
    var equal = left.words.size == right.words.size
    var index = 0
    while (equal && index < left.words.size) {
        equal = left.words[index] == right.words[index]
        index = index + 1
    }
    equal
}

fun sampledWordCount(module: SpirvModule, word: int): int {
    var count = 0
    var index = 0
    while (index < module.words.size) {
        if (module.words[index] == word) count = count + 1
        index = index + 1
    }
    count
}

fun sampledImageType(
    module: SpirvModule,
    dimension: int,
    arrayed: int
): bool {
    var found = false
    var index = 5
    while (!found && index < module.words.size) {
        val instruction = module.words[index]
        val count = (instruction >> 16) & 65535
        found = (instruction & 65535) == 25 && count == 9 &&
            module.words[index + 3] == dimension &&
            module.words[index + 5] == arrayed
        index = index + if (count > 0) count else 1
    }
    found
}

trusted fun main: int {
    val shader = glslPackage(
        [shaderStageVertex, shaderStageFragment],
        [
            "#version 450\nlayout(location=0) in vec2 position; layout(location=1) in vec2 uv; layout(location=0) out vec2 texCoord; void main(){ gl_Position=vec4(position,0.0,1.0); texCoord=uv; }",
            "#version 450\nlayout(location=0) in vec2 texCoord; layout(location=0) out vec4 color; layout(set=0,binding=0) uniform sampler2D albedo; layout(binding=1) uniform sampler2D detail; void main(){ vec2 shifted=texCoord*0.5+vec2(0.25); vec4 base=textureLod(albedo,shifted,0.0); color=mix(base.bgra,textureGrad(detail,texCoord,dFdx(texCoord),dFdy(texCoord)).rgba,0.25); }"
        ]
    )
    val program = shader.rasterFragmentProgram()
    val first = shader.spirv(shaderStageFragment)
    val second = shader.spirv(shaderStageFragment)
    val invalid = glslPackage(
        [shaderStageVertex, shaderStageFragment],
        [
            "#version 450\nvoid main(){ gl_Position=vec4(0.0); }",
            "#version 450\nlayout(location=0) out vec4 color; layout(binding=0) uniform sampler2D atlas; void main(){ color=texture(atlas,vec3(0.5)); }"
        ]
    ).spirv(shaderStageFragment)
    val wider = glslPackage(
        [shaderStageVertex, shaderStageFragment],
        [
            "#version 450\nlayout(location=0) out vec3 texCoord; void main(){ gl_Position=vec4(0.0,0.0,0.0,1.0); texCoord=vec3(0.25,0.25,0.75); }",
            "#version 450\nlayout(location=0) in vec3 texCoord; layout(location=0) out vec4 color; layout(binding=0) uniform sampler2DArray layers; layout(binding=1) uniform samplerCube sky; layout(binding=2) uniform sampler3D volume; void main(){ vec3 shifted=texCoord*0.5+vec3(0.25); vec4 layer=textureGrad(layers,shifted,dFdx(shifted.xy),dFdy(shifted.xy)); vec3 direction=normalize(texCoord); vec4 cube=textureGrad(sky,direction,dFdx(direction),dFdy(direction)); vec4 voxel=textureLod(volume,vec3(texCoord.x,texCoord.y,0.75),0.0); color=mix(layer+cube,voxel.bgra,0.5); }"
        ]
    )
    val widerProgram = wider.rasterFragmentProgram()
    val widerFirst = wider.spirv(shaderStageFragment)
    val widerSecond = wider.spirv(shaderStageFragment)
    val invalidWider = glslPackage(
        [shaderStageVertex, shaderStageFragment],
        [
            "#version 450\nlayout(location=0) out vec3 texCoord; void main(){ gl_Position=vec4(0.0); texCoord=vec3(0.5); }",
            "#version 450\nlayout(location=0) in vec3 texCoord; layout(location=0) out vec4 color; layout(binding=0) uniform sampler2DArray layers; void main(){ color=textureGrad(layers,texCoord,vec3(0.0),vec3(0.0)); }"
        ]
    ).spirv(shaderStageFragment)
    val projected = glslPackage(
        [shaderStageVertex, shaderStageFragment],
        [
            "#version 450\nlayout(location=0) out vec3 texCoord; void main(){ gl_Position=vec4(0.0,0.0,0.0,1.0); texCoord=vec3(0.25,0.25,0.75); }",
            "#version 450\nlayout(location=0) in vec3 texCoord; layout(location=0) out vec4 color; layout(binding=0) uniform sampler2D surface; layout(binding=1) uniform sampler3D volume; void main(){ vec3 p2=vec3(texCoord.x,texCoord.y,1.0); vec4 implicit=textureProj(surface,p2); vec4 lod=textureProjLod(surface,vec4(texCoord.x,texCoord.y,0.0,1.0),0.0); vec4 grad=textureProjGrad(volume,vec4(texCoord.x,texCoord.y,texCoord.z,1.0),dFdx(texCoord),dFdy(texCoord)); color=mix(implicit+lod,grad,0.5); }"
        ]
    )
    val projectedFirst = projected.spirv(shaderStageFragment)
    val projectedSecond = projected.spirv(shaderStageFragment)
    val invalidProjected = glslPackage(
        [shaderStageVertex, shaderStageFragment],
        [
            "#version 450\nvoid main(){ gl_Position=vec4(0.0); }",
            "#version 450\nlayout(location=0) out vec4 color; layout(binding=0) uniform samplerCube sky; void main(){ color=textureProj(sky,vec4(0.0,0.0,1.0,1.0)); }"
        ]
    ).spirv(shaderStageFragment)
    val fetched = glslPackage(
        [shaderStageVertex, shaderStageFragment],
        [
            "#version 450\nvoid main(){ gl_Position=vec4(0.0,0.0,0.0,1.0); }",
            "#version 450\nlayout(location=0) out vec4 color; layout(binding=0) uniform sampler2D surface; layout(binding=1) uniform sampler2DArray layers; layout(binding=2) uniform sampler3D volume; void main(){ int lod=0; ivec2 p2=ivec2(0,0); ivec3 p3=ivec3(p2.x,p2.y,1); vec4 a=texelFetch(surface,p2+ivec2(1,1)*0,lod); vec4 b=texelFetch(layers,p3,lod); vec4 c=texelFetch(volume,p3,lod); color=a+b+c; }"
        ]
    )
    val fetchedProgram = fetched.rasterFragmentProgram()
    val fetchedFirst = fetched.spirv(shaderStageFragment)
    val fetchedSecond = fetched.spirv(shaderStageFragment)
    val invalidFetchedCube = glslPackage(
        [shaderStageVertex, shaderStageFragment],
        [
            "#version 450\nvoid main(){ gl_Position=vec4(0.0); }",
            "#version 450\nlayout(location=0) out vec4 color; layout(binding=0) uniform samplerCube sky; void main(){ color=texelFetch(sky,ivec3(0,0,0),0); }"
        ]
    ).spirv(shaderStageFragment)
    val invalidFetchedWidth = glslPackage(
        [shaderStageVertex, shaderStageFragment],
        [
            "#version 450\nvoid main(){ gl_Position=vec4(0.0); }",
            "#version 450\nlayout(location=0) out vec4 color; layout(binding=0) uniform sampler2D surface; void main(){ color=texelFetch(surface,ivec3(0,0,0),0); }"
        ]
    ).spirv(shaderStageFragment)
    val fetchResult = if (!fetched.valid) 2
        else if (!fetchedProgram.valid) 3
        else if (fetchedProgram.integerExpressions.size != 6) 4
        else if (!fetchedFirst.succeeded) 5
        else if (!fetchedFirst.module.valid()) 6
        else if (sampledWordCount(fetchedFirst.module, 262244) != 3) 7
        else if (sampledWordCount(fetchedFirst.module, 458847) != 3) 8
        else if (!sampledWordsEqual(
            fetchedFirst.module,
            fetchedSecond.module
        )) 9
        else if (invalidFetchedCube.succeeded ||
            invalidFetchedCube.error == "") 10
        else if (invalidFetchedWidth.succeeded ||
            invalidFetchedWidth.error == "") 11
        else 42
    if (fetchResult != 42) fetchResult
    else if (shader.valid && shader.bindings.size == 2 && program.valid &&
        program.samplers.size == 2 && program.samplers[0].binding == 0 &&
        program.samplers[1].binding == 1 && first.succeeded &&
        first.module.valid() && sampledWordCount(first.module, 327767) == 0 &&
        sampledWordCount(first.module, 458840) == 1 &&
        sampledWordCount(first.module, 524376) == 1 &&
        sampledWordsEqual(first.module, second.module) &&
        !invalid.succeeded && invalid.error != "" && wider.valid &&
        widerProgram.valid && widerProgram.samplers.size == 3 &&
        widerProgram.samplers[0].coordinateType == glslRasterTypeVector3 &&
        widerFirst.succeeded && widerFirst.module.valid() &&
        sampledWordCount(widerFirst.module, 327767) == 0 &&
        sampledWordCount(widerFirst.module, 458840) == 1 &&
        sampledWordCount(widerFirst.module, 524376) == 2 &&
        sampledImageType(widerFirst.module, 1, 1) &&
        sampledImageType(widerFirst.module, 3, 0) &&
        sampledImageType(widerFirst.module, 2, 0) &&
        sampledWordsEqual(widerFirst.module, widerSecond.module) &&
        !invalidWider.succeeded && invalidWider.error != "" &&
        projected.valid && projectedFirst.succeeded &&
        projectedFirst.module.valid() &&
        sampledWordCount(projectedFirst.module, 327771) == 1 &&
        sampledWordCount(projectedFirst.module, 458844) == 1 &&
        sampledWordCount(projectedFirst.module, 524380) == 1 &&
        sampledWordsEqual(projectedFirst.module, projectedSecond.module) &&
        !invalidProjected.succeeded && invalidProjected.error != "")
        42 else 1
}
