import "../src/shader/glsl.ab"
import "../src/shader/glsl_spirv.ab"

fun sampledWordsEqual(left: SpirvModule, right: SpirvModule): bool {
    var equal = left.words.size == right.words.size
    var index = 0
    while (equal && index < left.words.size) {
        equal = left.words[index] == right.words[index]
        index = index + 1
    }
    equal
}

fun sampledWordCount(module: SpirvModule, word: int): int {
    var count = 0
    var index = 0
    while (index < module.words.size) {
        if (module.words[index] == word) count = count + 1
        index = index + 1
    }
    count
}

fun sampledInstructionFormCount(
    module: SpirvModule,
    instruction: int
): int {
    var count = 0
    var index = 5
    while (index < module.words.size) {
        val current = module.words[index]
        val wordCount = (current >> 16) & 65535
        if (current == instruction) count = count + 1
        index = index + if (wordCount > 0) wordCount else 1
    }
    count
}

fun sampledImageOperandCount(
    module: SpirvModule,
    instruction: int,
    operandMask: int
): int {
    var count = 0
    var index = 5
    while (index < module.words.size) {
        val current = module.words[index]
        val wordCount = (current >> 16) & 65535
        if (current == instruction && wordCount >= 8 &&
            index + 6 < module.words.size &&
            module.words[index + 6] == operandMask) {
            count = count + 1
        }
        index = index + if (wordCount > 0) wordCount else 1
    }
    count
}

fun sampledCapability(module: SpirvModule, capability: int): bool {
    var found = false
    var index = 5
    while (!found && index < module.words.size) {
        val instruction = module.words[index]
        val wordCount = (instruction >> 16) & 65535
        found = instruction == 131089 && index + 1 < module.words.size &&
            module.words[index + 1] == capability
        index = index + if (wordCount > 0) wordCount else 1
    }
    found
}

fun sampledImageType(
    module: SpirvModule,
    dimension: int,
    arrayed: int
): bool {
    var found = false
    var index = 5
    while (!found && index < module.words.size) {
        val instruction = module.words[index]
        val count = (instruction >> 16) & 65535
        found = (instruction & 65535) == 25 && count == 9 &&
            module.words[index + 3] == dimension &&
            module.words[index + 5] == arrayed
        index = index + if (count > 0) count else 1
    }
    found
}

