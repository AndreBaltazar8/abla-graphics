        ]
    )
    val fetchedProgram = fetched.rasterFragmentProgram()
    val fetchedFirst = fetched.spirv(shaderStageFragment)
    val fetchedSecond = fetched.spirv(shaderStageFragment)
    val invalidFetchedCube = glslPackage(
        [shaderStageVertex, shaderStageFragment],
        [
