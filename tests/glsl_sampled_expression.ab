import "../src/shader/glsl.ab"
import "../src/shader/glsl_spirv.ab"

fun sampledWordsEqual(left: SpirvModule, right: SpirvModule): bool {
    var equal = left.words.size == right.words.size
    var index = 0
    while (equal && index < left.words.size) {
        equal = left.words[index] == right.words[index]
        index = index + 1
    }
    equal
}

fun sampledWordCount(module: SpirvModule, word: int): int {
    var count = 0
    var index = 0
    while (index < module.words.size) {
        if (module.words[index] == word) count = count + 1
        index = index + 1
    }
    count
}

trusted fun main: int {
    val shader = glslPackage(
        [shaderStageVertex, shaderStageFragment],
        [
            "#version 450\nlayout(location=0) in vec2 position; layout(location=1) in vec2 uv; layout(location=0) out vec2 texCoord; void main(){ gl_Position=vec4(position,0.0,1.0); texCoord=uv; }",
            "#version 450\nlayout(location=0) in vec2 texCoord; layout(location=0) out vec4 color; layout(set=0,binding=0) uniform sampler2D albedo; layout(binding=1) uniform sampler2D detail; void main(){ vec2 shifted=texCoord*0.5+vec2(0.25); vec4 base=texture(albedo,shifted); color=mix(base.bgra,texture(detail,texCoord).rgba,0.25); }"
        ]
    )
    val program = shader.rasterFragmentProgram()
    val first = shader.spirv(shaderStageFragment)
    val second = shader.spirv(shaderStageFragment)
    val invalid = glslPackage(
        [shaderStageVertex, shaderStageFragment],
        [
            "#version 450\nvoid main(){ gl_Position=vec4(0.0); }",
            "#version 450\nlayout(location=0) out vec4 color; layout(binding=0) uniform sampler2D atlas; void main(){ color=texture(atlas,vec3(0.5)); }"
        ]
    ).spirv(shaderStageFragment)
    if (shader.valid && shader.bindings.size == 2 && program.valid &&
        program.samplers.size == 2 && program.samplers[0].binding == 0 &&
        program.samplers[1].binding == 1 && first.succeeded &&
        first.module.valid() && sampledWordCount(first.module, 327767) == 2 &&
        sampledWordsEqual(first.module, second.module) &&
        !invalid.succeeded && invalid.error != "") 42 else 1
}
