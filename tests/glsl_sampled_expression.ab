            "#version 450\nvoid main(){ gl_Position=vec4(0.0); }",
            "#version 450\nlayout(location=0) out vec4 color; layout(binding=0) uniform samplerCube sky; void main(){ color=textureProj(sky,vec4(0.0,0.0,1.0,1.0)); }"
        ]
    ).spirv(shaderStageFragment)
    val fetched = glslPackage(
