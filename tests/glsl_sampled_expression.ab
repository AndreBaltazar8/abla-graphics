        ]
    ).spirv(shaderStageFragment)
    val invalidOffsetRuntime = glslPackage(
        [shaderStageVertex, shaderStageFragment],
        [
            "#version 450\nvoid main(){ gl_Position=vec4(0.0); }",
            "#version 450\nlayout(location=0) out vec4 color; layout(binding=0) uniform sampler2D surface; void main(){ ivec2 offset=ivec2(0,0); color=textureOffset(surface,vec2(0.25),offset); }"
        ]
    ).spirv(shaderStageFragment)
    val queried = glslPackage(
        [shaderStageVertex, shaderStageFragment],
        [
            "#version 450\nvoid main(){ gl_Position=vec4(0.0,0.0,0.0,1.0); }",
            "#version 450\nlayout(location=0) out vec4 color; layout(binding=0) uniform sampler2D surface; layout(binding=1) uniform sampler2DArray layers; layout(binding=2) uniform samplerCube sky; layout(binding=3) uniform sampler3D volume; void main(){ int lod=0; ivec2 surfaceSize=textureSize(surface,lod); ivec3 layerSize=textureSize(layers,lod); ivec2 cubeSize=textureSize(sky,lod); ivec3 volumeSize=textureSize(volume,lod); int levels=textureQueryLevels(volume); ivec2 p2=surfaceSize-surfaceSize+cubeSize-cubeSize; ivec3 p3=layerSize-layerSize+volumeSize-volumeSize+ivec3(0,0,levels-levels); lod+=1; lod-=1; p2+=ivec2(1,1); p2=p2-ivec2(1,1); p3+=ivec3(1,1,1); p3-=ivec3(1,1,1); float levelValue=float(levels); vec2 surfaceValue=vec2(surfaceSize); vec3 volumeValue=vec3(volumeSize); vec2 queriedLod=textureQueryLod(surface,vec2(0.25)); vec4 a=texelFetch(surface,p2,lod+levels-levels); vec4 b=texelFetch(layers,p3,lod+levels-levels); vec4 c=texelFetch(volume,p3,lod+levels-levels); color=(a+b+c)*(queriedLod.x-queriedLod.x+levelValue-levelValue+surfaceValue.x-surfaceValue.x+volumeValue.z-volumeValue.z+1.0); }"
        ]
