import "../src/platform/wayland.ab"
import "abla/io"

trusted fun main: int {
    val window = waylandXdgWindow(
        "Abla Graphics input test",
        "io.abla.graphics.input-test",
        600,
        400
    )
    var succeeded = window.valid() &&
        window.enableOutputs() &&
        window.createSharedBuffers(600, 400, 2) &&
        window.clearSharedPixels(14, 22, 40) &&
        window.fillSharedRect(100, 100, 400, 200, 44, 202, 224) &&
        window.presentSharedPixels() && window.waitFrame() &&
        window.enableInput() && window.enableCursor() &&
        window.setCursorVisible(false)
    var sawFocus = false
    var sawMonitor = false
    var sawMotion = false
    var sawButtonPress = false
    var sawButtonRelease = false
    var lastButtonCode = 0
    var sawWPress = false
    var sawWRelease = false
    var sawWRepeat = false
    var sawWText = false
    var sawUpperWText = false
    var cursorShown = false
    var attempts = 0
    while (succeeded && attempts < 100 &&
        !(window.keyboardMapped() && sawFocus && sawMotion &&
          sawWPress && sawWRelease && sawWRepeat && sawWText &&
          sawUpperWText && sawMonitor)) {
        val event = window.pollInputEvent(50)
        if (event.kind == windowEventMonitorChanged &&
            event.monitorWidth() == 800 && event.monitorHeight() == 600 &&
            event.monitorName() != "") {
            sawMonitor = true
        } else if (event.kind == windowEventFocused && event.first != 0) {
            sawFocus = true
        } else if (event.kind == windowEventPointerMoved) {
            sawMotion = true
        } else if (event.kind == windowEventPointerButton) {
            lastButtonCode = event.platformCode
            if (event.platformCode == 272) {
                if (event.pointerButtonPressed()) sawButtonPress = true
                else sawButtonRelease = true
            }
        } else if (event.kind == windowEventKey &&
            event.platformCode == 17 && event.key() == keyW) {
            if (event.keyRepeated()) sawWRepeat = true
            else if (event.keyPressed()) sawWPress = true
            else if (sawWRepeat) sawWRelease = true
        } else if (event.kind == windowEventText &&
            event.platformCode == 17 && event.codepoint() == 119 &&
            event.text == "w") {
            sawWText = true
        } else if (event.kind == windowEventText &&
            event.platformCode == 17 && event.codepoint() == 87 &&
            event.text == "W") {
            sawUpperWText = true
        }
        if (succeeded && window.pointerFocused && !cursorShown) {
            succeeded = window.pointerEnterSerial > 0 &&
                !window.cursorVisible && window.setCursorVisible(true)
            if (succeeded) cursorShown = window.cursorVisible
        }
        succeeded = succeeded && window.connection.valid()
        attempts = attempts + 1
    }
    if (succeeded) succeeded = window.dispatchPointerButtonInput(
        waylandDecodeMessage(waylandPacket(
            window.pointerIdentifier,
            3,
            waylandU32ArrayPayload([1, 2, 272, 1])
        ))
    ) == 1 && window.dispatchPointerButtonInput(
        waylandDecodeMessage(waylandPacket(
            window.pointerIdentifier,
            3,
            waylandU32ArrayPayload([3, 4, 272, 0])
        ))
    ) == 1
    var queued = window.nextInputEvent()
    while (queued.happened()) {
        if (queued.kind == windowEventPointerButton &&
            queued.platformCode == 272) {
            lastButtonCode = queued.platformCode
            if (queued.pointerButtonPressed()) sawButtonPress = true
            else sawButtonRelease = true
        }
        queued = window.nextInputEvent()
    }
    succeeded = succeeded &&
        (window.seatCapabilities & waylandSeatCapabilityPointer) != 0 &&
        (window.seatCapabilities & waylandSeatCapabilityKeyboard) != 0 &&
        window.pointerIdentifier >= 2 && window.keyboardIdentifier >= 2 &&
        window.keyboardMapped() && window.keyboardTextMapped() &&
        window.keymap.size > 100 && window.parsedKeymap.parsedKeys > 50 &&
        window.outputs.size == 1 && window.outputsReady() &&
        window.primaryMonitor().width == 800 &&
        window.primaryMonitor().height == 600 &&
        window.primaryOutputScale() == 1 && sawMonitor &&
        sawFocus && sawMotion && sawButtonPress && sawButtonRelease &&
        sawWPress && sawWRelease && sawWRepeat && sawWText && sawUpperWText &&
        window.repeatDeadlineNanoseconds < 0 && cursorShown &&
        window.cursorSurfaceIdentifier >= 2 &&
        window.cursorBufferIdentifier >= 2 &&
        window.cursorMappedLength ==
            waylandCursorWidth * waylandCursorHeight * 4 &&
        window.cursorMappedBytes.load(3) == 255 &&
        window.cursorMappedBytes.load(window.cursorMappedLength - 1) == 0 &&
        window.setCursorVisible(false) && !window.cursorVisible &&
        window.setCursorVisible(false) &&
        window.setCursorVisible(true) && window.cursorVisible &&
        window.setCursorVisible(true) && window.pollProtocol(20)
    println(
        "wayland-input-test: succeeded=$succeeded output=${window.primaryMonitor().name}/${window.primaryMonitor().width}x${window.primaryMonitor().height}@${window.primaryOutputScale()} monitorEvent=$sawMonitor seat=${window.seatName} caps=${window.seatCapabilities} cursor=$cursorShown/${window.cursorVisible}/${window.cursorSurfaceIdentifier}/${window.cursorBufferReleased} keymap=${window.keymap.size}/${window.parsedKeymap.parsedKeys} focus=$sawFocus motion=$sawMotion button=$sawButtonPress/$sawButtonRelease/$lastButtonCode key=$sawWPress/$sawWRepeat/$sawWRelease text=$sawWText/$sawUpperWText repeat=${window.repeatRate}/${window.repeatDelay} error=${window.connection.error}"
    )
    if (succeeded) 42 else 1
}
