import "../src/platform/wayland.ab"
import "abla/io"

trusted fun main: int {
    val window = waylandXdgWindow(
        "Abla Graphics input test",
        "io.abla.graphics.input-test",
        600,
        400
    )
    var succeeded = window.valid() &&
        window.enableOutputs() &&
        window.createSharedBuffers(600, 400, 2) &&
        window.clearSharedPixels(14, 22, 40) &&
        window.fillSharedRect(100, 100, 400, 200, 44, 202, 224) &&
        window.presentSharedPixels() && window.waitFrame() &&
        window.enableInput() && window.enableCursor() &&
        window.setCursorVisible(false)
    var sawFocus = false
    var sawMonitor = false
    var sawMotion = false
    var sawButtonPress = false
    var sawButtonRelease = false
    var lastButtonCode = 0
    var sawWPress = false
    var sawWRelease = false
    var sawWRepeat = false
    var sawWText = false
    var sawUpperWText = false
    var cursorShown = false
    val captureAvailable = window.pointerCaptureAvailable()
    val confinementAvailable = window.pointerConfinementAvailable()
    var captureRequested = false
    var sawRelativeMotion = false
    var attempts = 0
    while (succeeded && attempts < 100 &&
        !(window.keyboardMapped() && sawFocus && sawMotion &&
          sawWPress && sawWRelease && sawWRepeat && sawWText &&
          sawUpperWText && sawMonitor)) {
        val event = window.pollInputEvent(50)
        if (event.kind == windowEventMonitorChanged &&
            event.monitorWidth() == 800 && event.monitorHeight() == 600 &&
            event.monitorName() != "") {
            sawMonitor = true
        } else if (event.kind == windowEventFocused && event.first != 0) {
            sawFocus = true
        } else if (event.kind == windowEventPointerMoved) {
            if (event.platformCode == 1) sawRelativeMotion = true
            else sawMotion = true
        } else if (event.kind == windowEventPointerButton) {
            lastButtonCode = event.platformCode
            if (event.platformCode == 272) {
                if (event.pointerButtonPressed()) sawButtonPress = true
                else sawButtonRelease = true
            }
        } else if (event.kind == windowEventKey &&
            event.platformCode == 17 && event.key() == keyW) {
            if (event.keyRepeated()) sawWRepeat = true
            else if (event.keyPressed()) sawWPress = true
            else if (sawWRepeat) sawWRelease = true
        } else if (event.kind == windowEventText &&
            event.platformCode == 17 && event.codepoint() == 119 &&
            event.text == "w") {
            sawWText = true
        } else if (event.kind == windowEventText &&
            event.platformCode == 17 && event.codepoint() == 87 &&
            event.text == "W") {
            sawUpperWText = true
        }
        if (succeeded && window.pointerFocused && !cursorShown) {
            succeeded = window.pointerEnterSerial > 0 &&
                !window.cursorVisible && window.setCursorVisible(true)
            if (succeeded) cursorShown = window.cursorVisible
        }
        if (succeeded && captureAvailable && cursorShown &&
            !captureRequested) {
            succeeded = window.setPointerCaptured(true)
            if (succeeded) captureRequested = window.pointerCaptured
        }
        succeeded = succeeded && window.connection.valid()
        attempts = attempts + 1
    }
    if (succeeded && captureAvailable && captureRequested &&
        !window.pointerCaptureActive) succeeded =
        window.dispatchLockedPointer(waylandDecodeMessage(waylandPacket(
            window.lockedPointerIdentifier,
            0
        ))) == 1
    if (succeeded && captureAvailable && captureRequested &&
        window.relativeMotionEvents == 0) succeeded =
        window.dispatchRelativePointer(waylandDecodeMessage(waylandPacket(
            window.relativePointerIdentifier,
            0,
            waylandU32ArrayPayload([1, 2, 384, -256, 512, -128])
        ))) == 1
    if (succeeded) succeeded = window.dispatchPointerButtonInput(
        waylandDecodeMessage(waylandPacket(
            window.pointerIdentifier,
            3,
            waylandU32ArrayPayload([1, 2, 272, 1])
        ))
    ) == 1 && window.dispatchPointerButtonInput(
        waylandDecodeMessage(waylandPacket(
            window.pointerIdentifier,
            3,
            waylandU32ArrayPayload([3, 4, 272, 0])
        ))
    ) == 1
    var queued = window.nextInputEvent()
    while (queued.happened()) {
        if (queued.kind == windowEventPointerButton &&
            queued.platformCode == 272) {
            lastButtonCode = queued.platformCode
            if (queued.pointerButtonPressed()) sawButtonPress = true
            else sawButtonRelease = true
        } else if (queued.kind == windowEventPointerMoved &&
            queued.platformCode == 1) {
            sawRelativeMotion = true
        }
        queued = window.nextInputEvent()
    }
    val captureExclusionPassed = if (captureAvailable &&
        window.pointerCaptured)
            !window.setPointerConfined(true) && !window.pointerConfined
        else true
    val capturePassed = if (captureAvailable)
        captureRequested && window.pointerCaptured &&
        window.pointerCaptureActive && sawRelativeMotion &&
        window.relativeMotionEvents > 0 &&
        captureExclusionPassed &&
        window.setPointerPositionHint(window.width / 2, window.height / 2) &&
        window.setPointerCaptured(false) && !window.pointerCaptured &&
        !window.pointerCaptureActive
    else !captureRequested && !window.pointerCaptured
    var confinementRequested = false
    var confinementActivatedByCompositor = false
    var confinementPassed = !confinementAvailable
    if (succeeded && capturePassed && confinementAvailable) {
        succeeded = window.setPointerConfined(true)
        confinementRequested = succeeded && window.pointerConfined
        if (succeeded) succeeded = !window.setPointerCaptured(true) &&
            !window.pointerCaptured && window.pointerConfined
        attempts = 0
        while (succeeded && !window.pointerConfinementActive &&
            attempts < 10) {
            succeeded = window.pollProtocol(10)
            attempts = attempts + 1
        }
        confinementActivatedByCompositor =
            window.pointerConfinementActive
        if (succeeded && !window.pointerConfinementActive) succeeded =
            window.dispatchConfinedPointer(waylandDecodeMessage(
                waylandPacket(window.confinedPointerIdentifier, 0)
            )) == 1
        confinementPassed = succeeded && confinementRequested &&
            window.pointerConfinementActive &&
            window.setPointerConfined(false) &&
            !window.pointerConfined && !window.pointerConfinementActive
    }
    val syntheticTouch = window.touchIdentifier == 0
    if (succeeded && syntheticTouch) window.touchIdentifier = 999
    val queuedBeforeTouch = window.pendingInputEvents.size -
        window.pendingInputIndex
    if (succeeded) succeeded = window.dispatchTouchInput(
        waylandDecodeMessage(waylandPacket(
            window.touchIdentifier,
            0,
            waylandU32ArrayPayload([
                501,
                1000,
                window.surfaceIdentifier,
                7,
                32896,
                16448
            ])
        ))
    ) == 1 && window.dispatchTouchInput(waylandDecodeMessage(waylandPacket(
        window.touchIdentifier,
        5,
        waylandU32ArrayPayload([7, 3072, 2048])
    ))) == 1 && window.dispatchTouchInput(waylandDecodeMessage(waylandPacket(
        window.touchIdentifier,
        6,
        waylandU32PairPayload(7, -11520)
    ))) == 1 && window.dispatchTouchInput(waylandDecodeMessage(waylandPacket(
        window.touchIdentifier,
        2,
        waylandU32ArrayPayload([1001, 7, 33280, 16896])
    ))) == 1 && window.pendingTouchEvents.size == 2 &&
        window.pendingInputEvents.size - window.pendingInputIndex ==
            queuedBeforeTouch &&
        window.dispatchTouchInput(waylandDecodeMessage(waylandPacket(
            window.touchIdentifier,
            3
        ))) == 1
    val activeTouch = window.touchPoint(7)
    var sawTouchBegin = false
    var sawTouchMove = false
    var sawTouchEnd = false
    var sawTouchCancel = false
    var touchEvent = window.nextInputEvent()
    while (touchEvent.happened()) {
        if (touchEvent.kind == windowEventTouchBegan &&
            touchEvent.touchId() == 7 && touchEvent.touchX() == 128 &&
            touchEvent.touchY() == 64) sawTouchBegin = true
        else if (touchEvent.kind == windowEventTouchMoved &&
            touchEvent.touchId() == 7 && touchEvent.touchX() == 130 &&
            touchEvent.touchY() == 66) sawTouchMove = true
        touchEvent = window.nextInputEvent()
    }
    if (succeeded) succeeded = sawTouchBegin && sawTouchMove &&
        activeTouch.identifier == 7 && activeTouch.xFixed == 33280 &&
        activeTouch.yFixed == 16896 && activeTouch.majorFixed == 3072 &&
        activeTouch.minorFixed == 2048 &&
        activeTouch.orientationFixed == -11520 &&
        window.dispatchTouchInput(waylandDecodeMessage(waylandPacket(
            window.touchIdentifier,
            1,
            waylandU32ArrayPayload([502, 1002, 7])
        ))) == 1 && window.dispatchTouchInput(waylandDecodeMessage(
            waylandPacket(window.touchIdentifier, 3)
        )) == 1
    touchEvent = window.nextInputEvent()
    while (touchEvent.happened()) {
        if (touchEvent.kind == windowEventTouchEnded &&
            touchEvent.touchId() == 7 && touchEvent.touchX() == 130 &&
            touchEvent.touchY() == 66) sawTouchEnd = true
        touchEvent = window.nextInputEvent()
    }
    if (succeeded) succeeded = sawTouchEnd &&
        window.touchPointIndex(7) < 0 &&
        window.dispatchTouchInput(waylandDecodeMessage(waylandPacket(
            window.touchIdentifier,
            0,
            waylandU32ArrayPayload([
                503,
                1003,
                window.surfaceIdentifier,
                9,
                2560,
                5120
            ])
        ))) == 1 && window.dispatchTouchInput(waylandDecodeMessage(
            waylandPacket(window.touchIdentifier, 3)
        )) == 1 && window.dispatchTouchInput(waylandDecodeMessage(
            waylandPacket(window.touchIdentifier, 4)
        )) == 1
    touchEvent = window.nextInputEvent()
    while (touchEvent.happened()) {
        if (touchEvent.kind == windowEventTouchCancelled &&
            touchEvent.touchId() == 9 && touchEvent.touchX() == 10 &&
            touchEvent.touchY() == 20) sawTouchCancel = true
        touchEvent = window.nextInputEvent()
    }
    val touchPassed = succeeded && sawTouchBegin && sawTouchMove &&
        sawTouchEnd && sawTouchCancel && window.touchPoints.size == 0 &&
        window.pendingTouchEvents.size == 0 && !window.touchFramePending &&
        window.touchFrames == 3 && window.touchCancels == 1
    if (syntheticTouch) window.touchIdentifier = 0
    succeeded = succeeded &&
        (window.seatCapabilities & waylandSeatCapabilityPointer) != 0 &&
        (window.seatCapabilities & waylandSeatCapabilityKeyboard) != 0 &&
        window.pointerIdentifier >= 2 && window.keyboardIdentifier >= 2 &&
        window.keyboardMapped() && window.keyboardTextMapped() &&
        window.keymap.size > 100 && window.parsedKeymap.parsedKeys > 50 &&
        window.outputs.size == 1 && window.outputsReady() &&
        window.primaryMonitor().width == 800 &&
        window.primaryMonitor().height == 600 &&
        window.primaryOutputScale() == 1 && sawMonitor &&
        sawFocus && sawMotion && sawButtonPress && sawButtonRelease &&
        sawWPress && sawWRelease && sawWRepeat && sawWText && sawUpperWText &&
        window.repeatDeadlineNanoseconds < 0 && capturePassed &&
        confinementPassed && touchPassed && cursorShown &&
        window.cursorSurfaceIdentifier >= 2 &&
        window.cursorBufferIdentifier >= 2 &&
        window.cursorMappedLength ==
            waylandCursorWidth * waylandCursorHeight * 4 &&
        window.cursorMappedBytes.load(3) == 255 &&
        window.cursorMappedBytes.load(window.cursorMappedLength - 1) == 0 &&
        window.setCursorVisible(false) && !window.cursorVisible &&
        window.setCursorVisible(false) &&
        window.setCursorVisible(true) && window.cursorVisible &&
        window.setCursorVisible(true)
    attempts = 0
    while (succeeded &&
        (window.retiredLockedPointerIdentifiers.size > 0 ||
         window.retiredConfinedPointerIdentifiers.size > 0) &&
        attempts < 100) {
        succeeded = window.pollProtocol(10)
        attempts = attempts + 1
    }
    succeeded = succeeded &&
        window.retiredLockedPointerIdentifiers.size == 0 &&
        window.retiredConfinedPointerIdentifiers.size == 0
    println(
        "wayland-input-test: succeeded=$succeeded output=${window.primaryMonitor().name}/${window.primaryMonitor().width}x${window.primaryMonitor().height}@${window.primaryOutputScale()} monitorEvent=$sawMonitor seat=${window.seatName} caps=${window.seatCapabilities} cursor=$cursorShown/${window.cursorVisible}/${window.cursorSurfaceIdentifier}/${window.cursorBufferReleased} capture=$captureAvailable/$captureRequested/$capturePassed/${window.relativeMotionEvents}/${window.lastRelativeXFixed},${window.lastRelativeYFixed} confine=$confinementAvailable/$confinementRequested/$confinementActivatedByCompositor/$confinementPassed touch=$syntheticTouch/$touchPassed/${window.touchFrames}/${window.touchCancels} keymap=${window.keymap.size}/${window.parsedKeymap.parsedKeys} focus=$sawFocus motion=$sawMotion/$sawRelativeMotion button=$sawButtonPress/$sawButtonRelease/$lastButtonCode key=$sawWPress/$sawWRepeat/$sawWRelease text=$sawWText/$sawUpperWText repeat=${window.repeatRate}/${window.repeatDelay} error=${window.connection.error}"
    )
    if (succeeded) 42 else 1
}
