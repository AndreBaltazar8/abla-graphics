        constants.storeF32(1, 0.12, 0) &&
        constants.storeF32(1, 0.54, 4) &&
        constants.storeF32(1, 0.96, 8) &&
        constants.storeF32(1, 1.0, 12)
    val commands = app.graphCommandList(graph, 2)
    val recorded = graph.valid() && shader.valid && target.valid() &&
        pass.valid() && sequence.valid() && constants.valid() && initialized &&
        commands.valid() && commands.recordPass(graph, 961) &&
        commands.recordRenderPushSubpasses(
            graph, [152], [], 153,
            move(target), move(pass), move(sequence), constants
        ) && commands.seal(graph) && commands.prepared &&
        commands.subpassPushIndices[1] == 0 &&
        constants.storeF32(1, 0.0, 0) &&
        constants.storeF32(1, 1.0, 4) &&
        constants.storeF32(1, 0.0, 8)
    val firstSize = commands.subpassPushConstants[0].sizes[0]
    commands.subpassPushConstants[0].sizes[0] = firstSize + 4
    val tamperRejected = recorded &&
        !app.executeGraphCommands(graph, commands) && !graph.executing &&
        commands.failedExecutions == 1
    commands.subpassPushConstants[0].sizes[0] = firstSize
    val liveBefore = runtimeMemoryLiveBytes()
    var succeeded = tamperRejected
    var iteration = 0
    while (succeeded && iteration < 1001) {
