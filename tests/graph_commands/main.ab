import "abla/io"
import "abla/process/arguments"
import "abla/runtime/memory"
import "../../src/graphics.ab"

fun fillGraphCommandBytes(var bytes: BufferBytes, value: int): bool {
    var stored = bytes.valid() && (bytes.size & 3) == 0
    var offset = 0
    while (stored && offset < bytes.size) {
        stored = bytes.storeU32(value, offset)
        offset = offset + 4
    }
    stored
}

fun graphCommandBytesEqual(bytes: BufferBytes, value: int): bool {
    var exact = bytes.valid() && (bytes.size & 3) == 0
    var offset = 0
    while (exact && offset < bytes.size) {
        exact = bytes.load(offset) + bytes.load(offset + 1) * 256 +
            bytes.load(offset + 2) * 65536 +
            bytes.load(offset + 3) * 16777216 == value
        offset = offset + 4
    }
    exact
}

trusted fun graphCommandProbe(requestedBackend: int): bool {
    val app = graphicsApplication(
        GraphicsConfig(backend = requestedBackend, validation = true),
        WindowConfig(
            title = "Abla recorded graph copy",
            width = 96,
            height = 64
        )
    )
    val sourceDescriptor = TextureDescriptor(
        label = "recorded-copy-source",
        size = Extent3D(2, 2),
        format = textureFormatRgba8Unorm,
        usage = textureUsageCopySource | textureUsageCopyDestination
    )
    val destinationDescriptor = TextureDescriptor(
        label = "recorded-copy-destination",
        size = Extent3D(2, 2),
        format = textureFormatRgba8Unorm,
        usage = textureUsageCopySource | textureUsageCopyDestination
    )
    val graph = app.materializeRenderGraphTextures([
        GraphicsGraphResource(0, "recorded-source", true, 16, 10),
        GraphicsGraphResource(1, "recorded-destination", true, 16, 11)
    ], [
        GraphicsGraphPass(10, "prepare", [
            GraphicsGraphUse(0, graphAccessWrite)
        ]),
        GraphicsGraphPass(20, "recorded-copy", [
            GraphicsGraphUse(0, graphAccessRead),
            GraphicsGraphUse(1, graphAccessWrite)
        ]),
        GraphicsGraphPass(30, "inspect", [
            GraphicsGraphUse(1, graphAccessRead)
        ])
    ], [
        GraphicsGraphTextureDeclaration(0, sourceDescriptor),
        GraphicsGraphTextureDeclaration(1, destinationDescriptor)
    ])
    val mismatchGraph = app.materializeRenderGraphTextures([
        GraphicsGraphResource(0, "mismatch-source", true, 16, 20),
        GraphicsGraphResource(1, "mismatch-destination", true, 16, 21)
    ], [
        GraphicsGraphPass(10, "mismatch-prepare", [
            GraphicsGraphUse(0, graphAccessWrite)
        ]),
        GraphicsGraphPass(20, "mismatch-copy", [
            GraphicsGraphUse(0, graphAccessRead),
            GraphicsGraphUse(1, graphAccessWrite)
        ]),
        GraphicsGraphPass(30, "mismatch-inspect", [
            GraphicsGraphUse(1, graphAccessRead)
        ])
    ], [
        GraphicsGraphTextureDeclaration(0, sourceDescriptor),
        GraphicsGraphTextureDeclaration(1, destinationDescriptor)
    ])
    val tooSmall = app.graphCommandList(graph, 2)
    val commands = app.graphCommandList(graph, 4)
    val recorded = app.valid() && graph.valid() && mismatchGraph.valid() &&
        !tooSmall.valid() && commands.valid() &&
        !commands.recordPass(graph, 20) && commands.commandCount == 0 &&
        commands.recordPass(graph, 10) &&
        !commands.recordTextureCopy(graph, 0, 1) &&
        commands.recordPass(graph, 20) &&
        commands.recordTextureCopy(graph, 0, 1) &&
        !commands.recordTextureCopy(graph, 0, 0) &&
        commands.recordPass(graph, 30) && commands.seal(graph) &&
        commands.prepared && commands.commandCount == 4 &&
        commands.recordedPasses == 3 &&
        !commands.recordPass(graph, 30)

    val abortedToken = graph.beginExecution()
    val abortPassed = abortedToken > 0 &&
        app.beginMaterializedRenderGraphPass(graph, abortedToken, 10) &&
        graph.abortExecution(abortedToken) && !graph.executing &&
        graph.abortedExecutions == 1 &&
        !graph.completeExecution(abortedToken)

    val value = 4280427042
    val sourceBytes = bufferBytes(16)
    val destinationBytes = bufferBytes(16)
    val initializationToken = graph.beginExecution()
    val initialized = abortPassed && initializationToken > abortedToken &&
        app.beginMaterializedRenderGraphPass(
            graph,
            initializationToken,
            10
        ) && fillGraphCommandBytes(sourceBytes, value) &&
        app.writeGraphTextureBytes(
            graph,
            initializationToken,
            0,
            sourceBytes
        ) && app.beginMaterializedRenderGraphPass(
            graph,
            initializationToken,
            20
        ) && app.beginMaterializedRenderGraphPass(
            graph,
            initializationToken,
            30
        ) && graph.completeExecution(initializationToken)

    val mismatchRejected = initialized &&
        !app.executeGraphCommands(mismatchGraph, commands) &&
        !mismatchGraph.executing && mismatchGraph.completedExecutions == 0 &&
        commands.failedExecutions == 1
    commands.widths[2] = 1
    val tamperRejected = mismatchRejected &&
        !app.executeGraphCommands(graph, commands) && !graph.executing &&
        commands.failedExecutions == 2
    commands.widths[2] = 2
    val copied = tamperRejected &&
        app.executeGraphCommands(graph, commands) && commands.executions == 1
    val inspectionToken = graph.beginExecution()
    val exact = copied && inspectionToken > 0 &&
        app.beginMaterializedRenderGraphPass(graph, inspectionToken, 10) &&
        app.beginMaterializedRenderGraphPass(graph, inspectionToken, 20) &&
        app.beginMaterializedRenderGraphPass(graph, inspectionToken, 30) &&
        destinationBytes.fill(0) && app.readGraphTextureBytes(
            graph,
            inspectionToken,
            1,
            destinationBytes
        ) && graphCommandBytesEqual(destinationBytes, value) &&
        graph.completeExecution(inspectionToken)

    val sourceIdentity = graph.physicalIdentity(0)
    val destinationIdentity = graph.physicalIdentity(1)
    val liveBefore = runtimeMemoryLiveBytes()
    var iteration = 0
    var steady = recorded && exact
    while (steady && iteration < 1000) {
        steady = app.executeGraphCommands(graph, commands)
        iteration = iteration + 1
    }
    val liveAfter = runtimeMemoryLiveBytes()
    val stable = steady && iteration == 1000 &&
        liveAfter == liveBefore && sourceIdentity != 0 &&
        destinationIdentity != 0 && sourceIdentity != destinationIdentity &&
        graph.physicalIdentity(0) == sourceIdentity &&
        graph.physicalIdentity(1) == destinationIdentity &&
        commands.executions == 1001 && commands.failedExecutions == 2 &&
        graph.completedExecutions == 1003 && graph.abortedExecutions == 1 &&
        graph.lastExecutionBarriers == 2 &&
        graph.totalExecutedBarriers == 2006 &&
        graph.backendBarrierCalls == 2006 &&
        graph.pools[0].acquisitionCount == 1 &&
        graph.pools[1].acquisitionCount == 1 &&
        commands.consolidatedVulkan ==
            (app.backend == graphicsBackendVulkan) &&
        commands.vulkanSubmissions ==
            (if (app.backend == graphicsBackendVulkan) 1001 else 0)
    val passed = recorded && abortPassed && mismatchRejected &&
        tamperRejected && exact && stable
    println(
        "graph-commands ${graphicsBackendName(app.backend)}: recorded=$recorded commands=${commands.commandCount}/${commands.capacity} exact=$exact mismatch=$mismatchRejected tamper=$tamperRejected aborted=${graph.abortedExecutions} executions=${commands.executions}/${graph.completedExecutions} barriers=${graph.lastExecutionBarriers}/${graph.totalExecutedBarriers}/${graph.backendBarrierCalls} submissions=${commands.vulkanSubmissions} live=${liveAfter - liveBefore} stable=$stable handles=$sourceIdentity/$destinationIdentity"
    )
    passed && graphRenderCommandProbe(app)
}

trusted fun graphRenderCommandProbe(var app: GraphicsApplication): bool {
    val targetDescriptor = TextureDescriptor(
        label = "recorded-render-target",
        size = Extent3D(16, 16),
        format = textureFormatRgba8Unorm,
        usage = textureUsageRenderAttachment | textureUsageCopySource
    )
    val copySourceDescriptor = TextureDescriptor(
        label = "recorded-render-copy-source",
        size = Extent3D(2, 2),
        format = textureFormatRgba8Unorm,
        usage = textureUsageCopySource | textureUsageCopyDestination
    )
    val copyDestinationDescriptor = TextureDescriptor(
        label = "recorded-render-copy-destination",
        size = Extent3D(2, 2),
        format = textureFormatRgba8Unorm,
        usage = textureUsageCopySource | textureUsageCopyDestination
    )
    val graph = app.materializeRenderGraphTextures([
        GraphicsGraphResource(10, "recorded-target", false, 0, 30),
        GraphicsGraphResource(11, "recorded-copy-source", true, 16, 31),
        GraphicsGraphResource(12, "recorded-copy-destination", true, 16, 32)
    ], [
        GraphicsGraphPass(100, "recorded-prepare", [
            GraphicsGraphUse(11, graphAccessWrite)
        ]),
        GraphicsGraphPass(200, "recorded-copy", [
            GraphicsGraphUse(11, graphAccessRead),
            GraphicsGraphUse(12, graphAccessWrite)
        ]),
        GraphicsGraphPass(300, "recorded-render", [
            GraphicsGraphUse(12, graphAccessRead),
            GraphicsGraphUse(10, graphAccessWrite)
        ]),
        GraphicsGraphPass(400, "recorded-inspect", [
            GraphicsGraphUse(10, graphAccessRead),
            GraphicsGraphUse(12, graphAccessRead)
        ])
    ], [
        GraphicsGraphTextureDeclaration(10, targetDescriptor),
        GraphicsGraphTextureDeclaration(11, copySourceDescriptor),
        GraphicsGraphTextureDeclaration(12, copyDestinationDescriptor)
    ])
    val incompatibleGraph = app.materializeRenderGraphTextures([
        GraphicsGraphResource(10, "incompatible-target", false, 0, 30),
        GraphicsGraphResource(11, "incompatible-source", true, 16, 31),
        GraphicsGraphResource(12, "incompatible-destination", true, 16, 32)
    ], [
        GraphicsGraphPass(100, "incompatible-prepare", [
            GraphicsGraphUse(11, graphAccessWrite)
        ]),
        GraphicsGraphPass(200, "incompatible-copy", [
            GraphicsGraphUse(11, graphAccessRead),
            GraphicsGraphUse(12, graphAccessWrite)
        ]),
        GraphicsGraphPass(300, "incompatible-render", [
            GraphicsGraphUse(12, graphAccessRead),
            GraphicsGraphUse(10, graphAccessWrite)
        ]),
        GraphicsGraphPass(400, "incompatible-inspect", [
            GraphicsGraphUse(10, graphAccessRead),
            GraphicsGraphUse(12, graphAccessRead)
        ])
    ], [
        GraphicsGraphTextureDeclaration(10, TextureDescriptor(
            label = "incompatible-recorded-render-target",
            size = Extent3D(8, 8),
            format = textureFormatRgba8Unorm,
            usage = targetDescriptor.usage
        )),
        GraphicsGraphTextureDeclaration(11, copySourceDescriptor),
        GraphicsGraphTextureDeclaration(12, copyDestinationDescriptor)
    ])
    val shader = $glsl {
        vertex {
            #version 450
            const vec2 positions[3] = vec2[3](
                vec2(-0.75, -0.65),
                vec2(0.75, -0.65),
                vec2(0.0, 0.75)
            );
            void main() {
                gl_Position = vec4(
                    positions[gl_VertexID],
                    0.0,
                    1.0
                );
            }
        }
        fragment {
            #version 450
            layout(location = 0) out vec4 color;
            void main() {
                color = vec4(0.12, 0.54, 0.96, 1.0);
            }
        }
    }
    val wrongTexture = app.texture(TextureDescriptor(
        label = "wrong-recorded-render-target",
        size = Extent3D(8, 8),
        format = textureFormatRgba8Unorm,
        usage = targetDescriptor.usage
    ))
    val wrongTarget = app.renderTarget(move(wrongTexture))
    val wrongPipeline = app.renderTargetPipeline(wrongTarget, shader)
    val targetTexture = app.texture(targetDescriptor)
    val target = app.renderTarget(move(targetTexture))
    val pipeline = app.renderTargetPipeline(target, shader)
    val commands = app.graphCommandList(graph, 6)
    val timelineBeforeInvalid = if (app.backend == graphicsBackendVulkan)
        app.vulkanDevice.transferTimelineValue else 0
    val invalidDirectRejected = if (app.backend == graphicsBackendVulkan)
        !app.vulkanDevice.renderTargetProgram(
            target.vulkan,
            pipeline.vulkan,
            0.0,
            0.0,
            0.0,
            1.0,
            vertexCount = 0
        ) && app.vulkanDevice.valid() &&
            !app.vulkanDevice.transferSubmissionAccepted &&
            app.vulkanDevice.transferTimelineValue == timelineBeforeInvalid
    else true
    val incompatibleRecordRejected = app.valid() && graph.valid() &&
        incompatibleGraph.valid() && shader.valid && wrongTarget.valid() &&
        wrongPipeline.valid() && target.valid() && pipeline.valid() &&
        commands.valid() && invalidDirectRejected &&
        commands.recordPass(graph, 100) &&
        !commands.recordRenderTarget(
            graph,
            10,
            move(wrongTarget),
            move(wrongPipeline),
            Color(0.0, 0.0, 1.0)
        ) && commands.commandCount == 1
    val recorded = incompatibleRecordRejected &&
        commands.recordPass(graph, 200) &&
        commands.recordTextureCopy(graph, 11, 12) &&
        commands.recordPass(graph, 300) && commands.recordRenderTarget(
            graph,
            10,
            move(target),
            move(pipeline),
            Color(0.0, 0.0, 1.0)
        ) && commands.recordPass(graph, 400) && commands.seal(graph) &&
        commands.prepared && commands.commandCount == 6 &&
        commands.renderTargets.size == 1 &&
        commands.renderPipelines.size == 1 &&
        commands.resourceDescriptorFingerprints[0] ==
            graphicsGraphTextureDescriptorFingerprint(targetDescriptor) &&
        commands.consolidatedVulkan ==
            (app.backend == graphicsBackendVulkan)
    val incompatibleReplayRejected = recorded &&
        !app.executeGraphCommands(incompatibleGraph, commands) &&
        !incompatibleGraph.executing &&
        incompatibleGraph.completedExecutions == 0 &&
        commands.failedExecutions == 1
    val copyValue = 4280427042
    val sourceBytes = bufferBytes(16)
    val destinationBytes = bufferBytes(16)
    val initializationToken = graph.beginExecution()
    val initialized = incompatibleReplayRejected &&
        initializationToken > 0 &&
        app.beginMaterializedRenderGraphPass(
            graph,
            initializationToken,
            100
        ) && fillGraphCommandBytes(sourceBytes, copyValue) &&
        app.writeGraphTextureBytes(
            graph,
            initializationToken,
            11,
            sourceBytes
        ) && app.beginMaterializedRenderGraphPass(
            graph,
            initializationToken,
            200
        ) && app.beginMaterializedRenderGraphPass(
            graph,
            initializationToken,
            300
        ) && app.beginMaterializedRenderGraphPass(
            graph,
            initializationToken,
            400
        ) && graph.completeExecution(initializationToken)
    val rendered = initialized && app.executeGraphCommands(graph, commands) &&
        commands.renderTargets[0].texture.rgba8(8, 8) == 4294281759
    val inspectionToken = graph.beginExecution()
    val copied = rendered && inspectionToken > 0 &&
        app.beginMaterializedRenderGraphPass(graph, inspectionToken, 100) &&
        app.beginMaterializedRenderGraphPass(graph, inspectionToken, 200) &&
        app.beginMaterializedRenderGraphPass(graph, inspectionToken, 300) &&
        app.beginMaterializedRenderGraphPass(graph, inspectionToken, 400) &&
        destinationBytes.fill(0) && app.readGraphTextureBytes(
            graph,
            inspectionToken,
            12,
            destinationBytes
        ) && graphCommandBytesEqual(destinationBytes, copyValue) &&
        graph.completeExecution(inspectionToken)
    val targetIdentity = if (app.backend == graphicsBackendOpenGl)
        commands.renderTargets[0].texture.openGl.handle
    else commands.renderTargets[0].texture.vulkan.image
    val pipelineIdentity = if (app.backend == graphicsBackendOpenGl)
        commands.renderPipelines[0].openGl.handle
    else commands.renderPipelines[0].vulkan.handle
    val liveBefore = runtimeMemoryLiveBytes()
    val sourceIdentity = graph.physicalIdentity(11)
    val destinationIdentity = graph.physicalIdentity(12)
    var steady = copied
    var iteration = 0
    while (steady && iteration < 1000) {
        steady = app.executeGraphCommands(graph, commands)
        iteration = iteration + 1
    }
    val liveAfter = runtimeMemoryLiveBytes()
    val finalPixel = commands.renderTargets[0].texture.rgba8(8, 8)
    val stable = steady && iteration == 1000 &&
        liveAfter == liveBefore && finalPixel == 4294281759 &&
        targetIdentity != 0 && pipelineIdentity != 0 &&
        sourceIdentity != 0 && destinationIdentity != 0 &&
        sourceIdentity != destinationIdentity &&
        graph.physicalIdentity(11) == sourceIdentity &&
        graph.physicalIdentity(12) == destinationIdentity &&
        (if (app.backend == graphicsBackendOpenGl)
            commands.renderTargets[0].texture.openGl.handle == targetIdentity &&
            commands.renderPipelines[0].openGl.handle == pipelineIdentity
         else commands.renderTargets[0].texture.vulkan.image == targetIdentity &&
            commands.renderPipelines[0].vulkan.handle == pipelineIdentity) &&
        commands.executions == 1001 && commands.failedExecutions == 1 &&
        graph.completedExecutions == 1003 && graph.abortedExecutions == 0 &&
        graph.lastExecutionBarriers == 4 &&
        graph.totalExecutedBarriers == 4012 &&
        graph.backendBarrierCalls == 3009 &&
        graph.pools[0].acquisitionCount == 1 &&
        graph.pools[1].acquisitionCount == 1 &&
        commands.vulkanSubmissions ==
            (if (app.backend == graphicsBackendVulkan) 1001 else 0)
    val passed = invalidDirectRejected && incompatibleRecordRejected && recorded &&
        incompatibleReplayRejected && initialized && rendered && copied && stable
    println(
        "graph-render-commands ${graphicsBackendName(app.backend)}: recorded=$recorded commands=${commands.commandCount}/${commands.capacity} render=${finalPixel == 4294281759} copy=$copied rejected=$invalidDirectRejected/$incompatibleRecordRejected/$incompatibleReplayRejected executions=${commands.executions}/${graph.completedExecutions} barriers=${graph.lastExecutionBarriers}/${graph.totalExecutedBarriers}/${graph.backendBarrierCalls} submissions=${commands.vulkanSubmissions} live=${liveAfter - liveBefore} stable=$stable handles=$sourceIdentity/$destinationIdentity/$targetIdentity/$pipelineIdentity"
    )
    passed && graphBufferedRenderCommandProbe(app)
}

trusted fun graphBufferedRenderCommandProbe(
    var app: GraphicsApplication
): bool {
    val targetDescriptor = TextureDescriptor(
        label = "recorded-buffered-render-target",
        size = Extent3D(16, 16),
        format = textureFormatRgba8Unorm,
        usage = textureUsageRenderAttachment | textureUsageCopySource
    )
    val vertexDescriptor = BufferDescriptor(
        size = 24,
        usage = bufferUsageVertex | bufferUsageCopyDestination
    )
    val indexDescriptor = BufferDescriptor(
        size = 12,
        usage = bufferUsageIndex | bufferUsageCopyDestination
    )
    val graph = app.materializeRenderGraphResources([
        GraphicsGraphResource(60, "vertex-target", false, 0, 60),
        GraphicsGraphResource(61, "vertex-data", false, 24, 61),
        GraphicsGraphResource(70, "indexed-target", false, 0, 70),
        GraphicsGraphResource(71, "indexed-vertices", false, 24, 71),
        GraphicsGraphResource(72, "indexed-indices", false, 12, 72)
    ], [
        GraphicsGraphPass(900, "recorded-vertices", [
            GraphicsGraphUse(60, graphAccessWrite),
            GraphicsGraphUse(61, graphAccessRead)
        ]),
        GraphicsGraphPass(901, "recorded-indexed", [
            GraphicsGraphUse(70, graphAccessWrite),
            GraphicsGraphUse(71, graphAccessRead),
            GraphicsGraphUse(72, graphAccessRead)
        ])
    ], [
        GraphicsGraphTextureDeclaration(60, targetDescriptor),
        GraphicsGraphTextureDeclaration(70, targetDescriptor)
    ], [
        GraphicsGraphBufferDeclaration(61, vertexDescriptor),
        GraphicsGraphBufferDeclaration(71, vertexDescriptor),
        GraphicsGraphBufferDeclaration(72, indexDescriptor)
    ])
    val shader = $glsl {
        vertex {
            #version 450
            layout(location = 0) in vec2 position;
            void main() {
                gl_Position = vec4(position, 0.0, 1.0);
            }
        }
        fragment {
            #version 450
            layout(location = 0) out vec4 color;
            void main() {
                color = vec4(0.12, 0.54, 0.96, 1.0);
            }
        }
    }
    val layout = VertexBufferLayout(8, [
        VertexAttribute(0, 0, vertexFormatFloat32x2)
    ])
    val vertexTargetTexture = app.texture(targetDescriptor)
    val vertexTarget = app.renderTarget(move(vertexTargetTexture))
    val vertexPipeline = app.renderTargetPipeline(
        vertexTarget,
        shader,
        layout
    )
    val indexedTargetTexture = app.texture(targetDescriptor)
    val indexedTarget = app.renderTarget(move(indexedTargetTexture))
    val indexedPipeline = app.renderTargetPipeline(
        indexedTarget,
        shader,
        layout
    )
    val vertexBuffer = app.buffer(vertexDescriptor)
    val indexedVertexBuffer = app.buffer(vertexDescriptor)
    val indexBuffer = app.buffer(indexDescriptor)
    val vertexBytes = bufferBytes(24)
    val indexBytes = bufferBytes(12)
    val uploaded = vertexBytes.storeF32(-0.75, 0) &&
        vertexBytes.storeF32(-0.65, 4) &&
        vertexBytes.storeF32(0.75, 8) &&
        vertexBytes.storeF32(-0.65, 12) &&
        vertexBytes.storeF32(0.0, 16) &&
        vertexBytes.storeF32(0.75, 20) &&
        indexBytes.storeU32(0, 0) && indexBytes.storeU32(1, 4) &&
        indexBytes.storeU32(2, 8) &&
        vertexBuffer.writeAllBytes(vertexBytes) &&
        indexedVertexBuffer.writeAllBytes(vertexBytes) &&
        indexBuffer.writeAllBytes(indexBytes)
    val commands = app.graphCommandList(graph, 4)
    val recorded = app.valid() && graph.valid() && shader.valid && uploaded &&
        vertexTarget.valid() && vertexPipeline.valid() &&
        indexedTarget.valid() && indexedPipeline.valid() &&
        commands.valid() && commands.recordPass(graph, 900) &&
        commands.recordRenderVertices(
            graph,
            60,
            61,
            move(vertexTarget),
            move(vertexPipeline),
            move(vertexBuffer),
            3,
            Color(0.01, 0.02, 0.03)
        ) && commands.recordPass(graph, 901) &&
        commands.recordRenderIndexed(
            graph,
            70,
            71,
            72,
            move(indexedTarget),
            move(indexedPipeline),
            move(indexedVertexBuffer),
            move(indexBuffer),
            3,
            Color(0.03, 0.02, 0.01)
        ) && commands.seal(graph) && commands.prepared &&
        commands.commandCount == 4 && commands.renderTargets.size == 2 &&
        commands.renderResources.size == 2 &&
        commands.renderResources[0].form == graphicsGraphRenderVertices &&
        commands.renderResources[1].form == graphicsGraphRenderIndexed &&
        commands.consolidatedVulkan ==
            (app.backend == graphicsBackendVulkan)
    val originalBufferIdentity = if (app.backend == graphicsBackendOpenGl)
        commands.renderResources[0].buffers[0].openGl.handle
    else commands.renderResources[0].buffers[0].vulkan.handle
    if (recorded && app.backend == graphicsBackendOpenGl)
        commands.renderResources[0].buffers[0].openGl.handle =
            originalBufferIdentity + 1
    else if (recorded)
        commands.renderResources[0].buffers[0].vulkan.handle =
            originalBufferIdentity + 1
    val tamperRejected = recorded &&
        !app.executeGraphCommands(graph, commands) && !graph.executing &&
        commands.failedExecutions == 1
    if (recorded && app.backend == graphicsBackendOpenGl)
        commands.renderResources[0].buffers[0].openGl.handle =
            originalBufferIdentity
    else if (recorded)
        commands.renderResources[0].buffers[0].vulkan.handle =
            originalBufferIdentity
    val liveBefore = runtimeMemoryLiveBytes()
    var succeeded = tamperRejected
    var iteration = 0
    while (succeeded && iteration < 1001) {
        succeeded = app.executeGraphCommands(graph, commands)
        iteration = iteration + 1
    }
    val liveAfter = runtimeMemoryLiveBytes()
    val vertexExact = commands.renderTargets[0].texture.rgba8(8, 8) ==
        4294281759
    val indexedExact = commands.renderTargets[1].texture.rgba8(8, 8) ==
        4294281759
    val stable = succeeded && iteration == 1001 && vertexExact &&
        indexedExact && liveAfter == liveBefore &&
        originalBufferIdentity != 0 &&
        (if (app.backend == graphicsBackendOpenGl)
            commands.renderResources[0].buffers[0].openGl.handle ==
                originalBufferIdentity
         else commands.renderResources[0].buffers[0].vulkan.handle ==
                originalBufferIdentity) &&
        commands.executions == 1001 && commands.failedExecutions == 1 &&
        graph.completedExecutions == 1001 &&
        commands.vulkanSubmissions ==
            (if (app.backend == graphicsBackendVulkan) 1001 else 0)
    println(
        "graph-buffered-render ${graphicsBackendName(app.backend)}: recorded=$recorded forms=${commands.renderResources[0].form}/${commands.renderResources[1].form} exact=$vertexExact/$indexedExact tamper=$tamperRejected executions=${commands.executions}/${graph.completedExecutions} submissions=${commands.vulkanSubmissions} live=${liveAfter - liveBefore} stable=$stable"
    )
    recorded && tamperRejected && stable &&
        graphIndirectRenderCommandProbe(app)
}

trusted fun graphIndirectRenderCommandProbe(
    var app: GraphicsApplication
): bool {
    val targetDescriptor = TextureDescriptor(
        label = "recorded-indirect-render-target",
        size = Extent3D(16, 16),
        format = textureFormatRgba8Unorm,
        usage = textureUsageRenderAttachment | textureUsageCopySource
    )
    val vertexDescriptor = BufferDescriptor(
        size = 24,
        usage = bufferUsageVertex | bufferUsageCopyDestination
    )
    val indexDescriptor = BufferDescriptor(
        size = 12,
        usage = bufferUsageIndex | bufferUsageCopyDestination
    )
    val drawDescriptor = BufferDescriptor(
        size = 16,
        usage = bufferUsageIndirect | bufferUsageCopyDestination
    )
    val indexedDrawDescriptor = BufferDescriptor(
        size = 20,
        usage = bufferUsageIndirect | bufferUsageCopyDestination
    )
    val graph = app.materializeRenderGraphResources([
        GraphicsGraphResource(80, "indirect-target", false, 0, 80),
        GraphicsGraphResource(81, "indirect-vertices", false, 24, 81),
        GraphicsGraphResource(82, "indirect-command", false, 16, 82),
        GraphicsGraphResource(90, "indexed-indirect-target", false, 0, 90),
        GraphicsGraphResource(91, "indexed-indirect-vertices", false, 24, 91),
        GraphicsGraphResource(92, "indexed-indirect-indices", false, 12, 92),
        GraphicsGraphResource(93, "indexed-indirect-command", false, 20, 93)
    ], [
        GraphicsGraphPass(910, "recorded-indirect", [
            GraphicsGraphUse(80, graphAccessWrite),
            GraphicsGraphUse(81, graphAccessRead),
            GraphicsGraphUse(82, graphAccessRead)
        ]),
        GraphicsGraphPass(911, "recorded-indexed-indirect", [
            GraphicsGraphUse(90, graphAccessWrite),
            GraphicsGraphUse(91, graphAccessRead),
            GraphicsGraphUse(92, graphAccessRead),
            GraphicsGraphUse(93, graphAccessRead)
        ])
    ], [
        GraphicsGraphTextureDeclaration(80, targetDescriptor),
        GraphicsGraphTextureDeclaration(90, targetDescriptor)
    ], [
        GraphicsGraphBufferDeclaration(81, vertexDescriptor),
