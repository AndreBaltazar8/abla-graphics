        format = textureFormatRgba8Unorm,
        usage = textureUsageRenderAttachment
    )
    val resolveDescriptor = TextureDescriptor(
        label = "recorded-resolve-output",
        size = Extent3D(16, 16),
        format = textureFormatRgba8Unorm,
        usage = textureUsageRenderAttachment |
            textureUsageCopyDestination | textureUsageCopySource
    )
    val graph = app.materializeRenderGraphTextures([
        GraphicsGraphResource(130, "resolve-msaa", false, 0, 130),
        GraphicsGraphResource(131, "resolve-output", false, 0, 131)
    ], [
        GraphicsGraphPass(940, "resolve-render", [
            GraphicsGraphUse(130, graphAccessWrite),
            GraphicsGraphUse(131, graphAccessWrite)
        ])
    ], [
        GraphicsGraphTextureDeclaration(130, colorDescriptor),
        GraphicsGraphTextureDeclaration(131, resolveDescriptor)
    ])
    val shader = $glsl {
        vertex {
            #version 450
            const vec2 positions[3] = vec2[3](
                vec2(-0.75, -0.65),
                vec2(0.75, -0.65),
                vec2(0.0, 0.75)
            );
            void main() {
                gl_Position = vec4(positions[gl_VertexID], 0.0, 1.0);
            }
        }
        fragment {
            #version 450
            layout(location = 0) out vec4 color;
            layout(push_constant) uniform Draw {
                vec3 tint;
                float alpha;
            } draw;
            void main() {
                color = vec4(draw.tint.x, draw.tint.y, draw.tint.z, draw.alpha);
            }
        }
    }
    val color = app.texture(colorDescriptor)
    val resolve = app.texture(resolveDescriptor)
    val target = app.renderTarget(move(color), [move(resolve)])
    val pipeline = app.renderTargetPipeline(target, shader)
    val values = shader.pushConstants()
    val initialized = values.storeF32(1.0, 0) &&
        values.storeF32(0.0, 4) && values.storeF32(0.0, 8) &&
        values.storeF32(1.0, 12)
    val commands = app.graphCommandList(graph, 2)
    val recorded = graph.valid() && shader.valid && target.valid() &&
        pipeline.valid() && initialized && commands.valid() &&
        commands.recordPass(graph, 940) &&
        commands.recordRenderTargetResolvePush(
            graph, 130, 131, move(target), move(pipeline), values
        ) && commands.seal(graph) && commands.prepared &&
        commands.renderResolveResourceIds[0] == 131 &&
        commands.renderPushSizes[1] == 16 &&
        values.storeF32(0.0, 0) && values.storeF32(1.0, 4)
    commands.renderResolveResourceIds[0] = 999
    val tamperRejected = recorded &&
        !app.executeGraphCommands(graph, commands) && !graph.executing &&
        commands.failedExecutions == 1
    commands.renderResolveResourceIds[0] = 131
    val liveBefore = runtimeMemoryLiveBytes()
    var succeeded = tamperRejected
    var iteration = 0
    while (succeeded && iteration < 1001) {
        succeeded = app.executeGraphCommands(graph, commands)
        iteration = iteration + 1
    }
    val liveAfter = runtimeMemoryLiveBytes()
    val exact = commands.renderTargets[0].resolveTextures[0].rgba8(8, 8) ==
        4278190335
    val stable = succeeded && iteration == 1001 && exact &&
        liveAfter == liveBefore && commands.executions == 1001 &&
        commands.failedExecutions == 1 && graph.completedExecutions == 1001 &&
        commands.vulkanSubmissions ==
            (if (app.backend == graphicsBackendVulkan) 1001 else 0)
    println(
        "graph-resolve-render ${graphicsBackendName(app.backend)}: samples=${commands.renderTargets[0].texture.descriptor.samples} resolve=${commands.renderResolveResourceIds[0]} exact=$exact snapshot=$exact tamper=$tamperRejected executions=${commands.executions}/${graph.completedExecutions} submissions=${commands.vulkanSubmissions} live=${liveAfter - liveBefore} stable=$stable"
    )
    recorded && tamperRejected && stable && graphMrtRenderCommandProbe(app)
}

trusted fun graphMrtRenderCommandProbe(var app: GraphicsApplication): bool {
    val colorDescriptor = TextureDescriptor(
        size = Extent3D(16, 16), samples = 4,
        format = textureFormatRgba8Unorm,
        usage = textureUsageRenderAttachment
    )
    val depthDescriptor = TextureDescriptor(
        size = Extent3D(16, 16), samples = 4,
        format = textureFormatDepth32Float,
        usage = textureUsageRenderAttachment
    )
    val resolveDescriptor = TextureDescriptor(
        size = Extent3D(16, 16), format = textureFormatRgba8Unorm,
        usage = textureUsageRenderAttachment |
            textureUsageCopyDestination | textureUsageCopySource
    )
    val vertexDescriptor = BufferDescriptor(
        size = 24, usage = bufferUsageVertex | bufferUsageCopyDestination
    )
    val indexDescriptor = BufferDescriptor(
        size = 12, usage = bufferUsageIndex | bufferUsageCopyDestination
    )
    val drawDescriptor = BufferDescriptor(
        size = 20, usage = bufferUsageIndirect | bufferUsageCopyDestination
    )
    val graph = app.materializeRenderGraphResources([
        GraphicsGraphResource(140, "mrt-color-zero", false, 0, 140),
        GraphicsGraphResource(141, "mrt-color-one", false, 0, 141),
        GraphicsGraphResource(142, "mrt-depth", false, 0, 142),
        GraphicsGraphResource(143, "mrt-resolve-zero", false, 0, 143),
        GraphicsGraphResource(144, "mrt-resolve-one", false, 0, 144),
        GraphicsGraphResource(145, "mrt-vertices", false, 24, 145),
        GraphicsGraphResource(146, "mrt-indices", false, 12, 146),
        GraphicsGraphResource(147, "mrt-draw", false, 20, 147)
    ], [
        GraphicsGraphPass(950, "mrt-render", [
            GraphicsGraphUse(140, graphAccessWrite),
            GraphicsGraphUse(141, graphAccessWrite),
            GraphicsGraphUse(142, graphAccessWrite),
            GraphicsGraphUse(143, graphAccessWrite),
            GraphicsGraphUse(144, graphAccessWrite),
            GraphicsGraphUse(145, graphAccessRead),
            GraphicsGraphUse(146, graphAccessRead),
            GraphicsGraphUse(147, graphAccessRead)
        ])
    ], [
        GraphicsGraphTextureDeclaration(140, colorDescriptor),
        GraphicsGraphTextureDeclaration(141, colorDescriptor),
        GraphicsGraphTextureDeclaration(142, depthDescriptor),
        GraphicsGraphTextureDeclaration(143, resolveDescriptor),
        GraphicsGraphTextureDeclaration(144, resolveDescriptor)
    ], [
        GraphicsGraphBufferDeclaration(145, vertexDescriptor),
        GraphicsGraphBufferDeclaration(146, indexDescriptor),
        GraphicsGraphBufferDeclaration(147, drawDescriptor)
    ])
    val shader = $glsl {
        vertex {
            #version 450
            layout(location = 0) in vec2 position;
            void main() { gl_Position = vec4(position, 0.0, 1.0); }
        }
        fragment {
            #version 450
            layout(location = 0) out vec4 firstColor;
            layout(location = 1) out vec4 secondColor;
            layout(push_constant) uniform Draw {
                vec3 tint;
                float alpha;
            } draw;
            void main() {
                firstColor = vec4(draw.tint.x, draw.tint.y, draw.tint.z,
                    draw.alpha);
                secondColor = vec4(0.0, 1.0, 0.0, 1.0);
            }
        }
    }
    val first = app.texture(colorDescriptor)
    val second = app.texture(colorDescriptor)
    val depth = app.texture(depthDescriptor)
    val firstResolve = app.texture(resolveDescriptor)
    val secondResolve = app.texture(resolveDescriptor)
    val target = app.renderTargetWithColorsAndDepth(
        move(first), [move(second)], move(depth),
        [move(firstResolve), move(secondResolve)]
    )
    val pipeline = app.renderTargetPipeline(
        target, shader, VertexBufferLayout(8, [
            VertexAttribute(0, 0, vertexFormatFloat32x2)
        ]), RasterPipelineState(),
        DepthStencilState(enabled = true, write = true,
            compare = compareFunctionLess)
    )
    val vertices = app.buffer(vertexDescriptor)
    val indices = app.buffer(indexDescriptor)
    val draw = app.buffer(drawDescriptor)
    val vertexBytes = bufferBytes(24)
    val indexBytes = bufferBytes(12)
    val drawBytes = bufferBytes(20)
    val values = shader.pushConstants()
    val initialized = vertexBytes.storeF32(-0.75, 0) &&
        vertexBytes.storeF32(-0.65, 4) &&
        vertexBytes.storeF32(0.75, 8) &&
        vertexBytes.storeF32(-0.65, 12) &&
        vertexBytes.storeF32(0.0, 16) &&
        vertexBytes.storeF32(0.75, 20) &&
        indexBytes.storeU32(0, 0) && indexBytes.storeU32(1, 4) &&
        indexBytes.storeU32(2, 8) &&
        drawBytes.storeI64(4294967299, 0) &&
        drawBytes.storeI64(0, 8) && drawBytes.storeU32(0, 16) &&
        vertices.writeAllBytes(vertexBytes) &&
        indices.writeAllBytes(indexBytes) && draw.writeAllBytes(drawBytes) &&
        values.storeF32(1.0, 0) &&
        values.storeF32(0.0, 4) && values.storeF32(0.0, 8) &&
        values.storeF32(1.0, 12)
    val renderResources = graphRenderIndexedIndirectResources(
        145, 146, 147, move(vertices), move(indices), move(draw)
    )
    val commands = app.graphCommandList(graph, 2)
    val recorded = graph.valid() && shader.valid && target.valid() &&
        pipeline.valid() && initialized && commands.valid() &&
        commands.recordPass(graph, 950) &&
        commands.recordRenderAttachmentsPush(
            graph, [140, 141], [143, 144], 142,
            move(target), move(pipeline), move(renderResources), values
        ) && commands.seal(graph) && commands.prepared &&
        commands.renderAdditionalColorResourceIds[0][0] == 141 &&
        commands.renderAdditionalResolveResourceIds[0][0] == 144 &&
        values.storeF32(0.0, 0) && values.storeF32(1.0, 4)
    commands.renderAdditionalResolveResourceIds[0][0] = 999
    val tamperRejected = recorded &&
        !app.executeGraphCommands(graph, commands) && !graph.executing &&
        commands.failedExecutions == 1
    commands.renderAdditionalResolveResourceIds[0][0] = 144
    val liveBefore = runtimeMemoryLiveBytes()
    var succeeded = tamperRejected
    var iteration = 0
    while (succeeded && iteration < 1001) {
        succeeded = app.executeGraphCommands(graph, commands)
        iteration = iteration + 1
    }
    val liveAfter = runtimeMemoryLiveBytes()
    val firstExact = commands.renderTargets[0].resolveTextures[0].rgba8(
        8, 8
    ) == 4278190335
    val secondExact = commands.renderTargets[0].resolveTextures[1].rgba8(
        8, 8
    ) == 4278255360
    val stable = succeeded && iteration == 1001 && firstExact &&
        secondExact && liveAfter == liveBefore &&
        commands.executions == 1001 && commands.failedExecutions == 1 &&
        graph.completedExecutions == 1001 && commands.vulkanSubmissions ==
            (if (app.backend == graphicsBackendVulkan) 1001 else 0)
    println(
        "graph-mrt-render ${graphicsBackendName(app.backend)}: colors=${commands.renderTargets[0].colorCount()} resolves=${commands.renderTargets[0].resolveTextures.size} depth=${commands.renderDepthResourceIds[0]} exact=$firstExact/$secondExact snapshot=$firstExact tamper=$tamperRejected executions=${commands.executions}/${graph.completedExecutions} submissions=${commands.vulkanSubmissions} live=${liveAfter - liveBefore} stable=$stable"
    )
    recorded && tamperRejected && stable && graphSubpassCommandProbe(app)
}

trusted fun graphSubpassCommandProbe(var app: GraphicsApplication): bool {
    val colorDescriptor = TextureDescriptor(
        size = Extent3D(16, 16),
        format = textureFormatRgba8Unorm,
        usage = textureUsageRenderAttachment | textureUsageCopySource
    )
    val depthDescriptor = TextureDescriptor(
        size = Extent3D(16, 16),
        format = textureFormatDepth32Float,
        usage = textureUsageRenderAttachment
    )
    val graph = app.materializeRenderGraphResources([
        GraphicsGraphResource(150, "subpass-color", false, 0, 150),
        GraphicsGraphResource(151, "subpass-depth", false, 0, 151)
    ], [
        GraphicsGraphPass(960, "recorded-subpasses", [
            GraphicsGraphUse(150, graphAccessWrite),
            GraphicsGraphUse(151, graphAccessWrite)
        ])
    ], [
        GraphicsGraphTextureDeclaration(150, colorDescriptor),
        GraphicsGraphTextureDeclaration(151, depthDescriptor)
    ], [])
    val shader = $glsl {
        vertex {
            #version 450
            const vec2 positions[3] = vec2[3](
                vec2(-0.75, -0.65),
                vec2(0.75, -0.65),
                vec2(0.0, 0.75)
            );
            void main() {
                gl_Position = vec4(positions[gl_VertexID], 0.0, 1.0);
            }
        }
        fragment {
            #version 450
            layout(location = 0) out vec4 color;
            void main() {
                color = vec4(0.12, 0.54, 0.96, 1.0);
            }
        }
    }
    val target = app.renderTargetWithDepth(
        app.texture(colorDescriptor), app.texture(depthDescriptor)
    )
    val pass = app.renderPass(
        target,
        renderPassClearValues(Color(0.0, 0.0, 0.0), [], 1.0),
        RenderPassOperations(),
        2
    )
    val first = app.renderPassPipeline(
        target, pass, 0, shader,
        VertexBufferLayout(), RasterPipelineState(),
        DepthStencilState(
            enabled = true, write = true, compare = compareFunctionNever
        )
    )
    val second = app.renderPassPipeline(
        target, pass, 1, shader,
        VertexBufferLayout(), RasterPipelineState(),
        DepthStencilState(
            enabled = true, write = false, compare = compareFunctionAlways
        )
    )
    val firstIdentity = if (app.backend == graphicsBackendOpenGl)
        first.openGl.handle
    else first.vulkan.handle
    val secondIdentity = if (app.backend == graphicsBackendOpenGl)
        second.openGl.handle
    else second.vulkan.handle
    val sequence = app.subpassPipelines(
        target, pass, [move(first), move(second)]
    )
    val commands = app.graphCommandList(graph, 2)
    val recorded = graph.valid() && shader.valid && target.valid() &&
        pass.valid() && sequence.valid() && commands.valid() &&
        commands.recordPass(graph, 960) && commands.recordRenderSubpasses(
            graph, [150], [], 151,
            move(target), move(pass), move(sequence)
        ) && commands.seal(graph) && commands.prepared &&
        (if (app.backend == graphicsBackendOpenGl)
            commands.subpassSequences[0].pipelines[0].openGl.handle ==
                firstIdentity &&
            commands.subpassSequences[0].pipelines[1].openGl.handle ==
                secondIdentity
         else commands.subpassSequences[0].pipelines[0].vulkan.handle ==
                firstIdentity &&
            commands.subpassSequences[0].pipelines[1].vulkan.handle ==
                secondIdentity)
    commands.subpassDepthResourceIds[0] = 999
    val tamperRejected = recorded &&
        !app.executeGraphCommands(graph, commands) && !graph.executing &&
        commands.failedExecutions == 1
    commands.subpassDepthResourceIds[0] = 151
    val sequenceHandle = if (app.backend == graphicsBackendVulkan)
        commands.subpassSequences[0].vulkanHandles[0] else 0
    if (app.backend == graphicsBackendVulkan)
        commands.subpassSequences[0].vulkanHandles[0] = sequenceHandle + 1
    val nativeTamperRejected = if (app.backend == graphicsBackendVulkan)
        !app.executeGraphCommands(graph, commands) && !graph.executing &&
            commands.failedExecutions == 2
    else true
    if (app.backend == graphicsBackendVulkan)
        commands.subpassSequences[0].vulkanHandles[0] = sequenceHandle
    val liveBefore = runtimeMemoryLiveBytes()
    var succeeded = tamperRejected && nativeTamperRejected
    var iteration = 0
    while (succeeded && iteration < 1001) {
        succeeded = app.executeGraphCommands(graph, commands)
        iteration = iteration + 1
    }
    val liveAfter = runtimeMemoryLiveBytes()
    val exact = commands.subpassTargets[0].texture.rgba8(8, 8) == 4294281759
    val stable = succeeded && iteration == 1001 && exact &&
        liveAfter == liveBefore && commands.executions == 1001 &&
        commands.failedExecutions ==
            (if (app.backend == graphicsBackendVulkan) 2 else 1) &&
        graph.completedExecutions == 1001 &&
        commands.vulkanSubmissions ==
            (if (app.backend == graphicsBackendVulkan) 1001 else 0)
    println(
        "graph-subpasses ${graphicsBackendName(app.backend)}: stages=${commands.subpassSequences[0].pipelines.size} exact=$exact tamper=$tamperRejected/$nativeTamperRejected executions=${commands.executions}/${graph.completedExecutions} submissions=${commands.vulkanSubmissions} live=${liveAfter - liveBefore} stable=$stable"
    )
    recorded && tamperRejected && nativeTamperRejected && stable &&
        graphPushSubpassCommandProbe(app)
}

trusted fun graphPushSubpassCommandProbe(var app: GraphicsApplication): bool {
