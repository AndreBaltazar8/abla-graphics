fun registryVulkanNormalizedCallAbi(
    command: string,
    returnType: string,
    signatures: RegistryCommandSignatures,
    types: RegistryTypes
): string {
    var abi = if (returnType == "void") "void(" else
        if (registryVulkanI32ReturnType(returnType)) "i32(" else
        if (registryVulkanI64Type(types, returnType)) "i64(" else
        if (returnType == "PFN_vkVoidFunction") "pointer(" else ""
    var valid = abi != ""
    var first = true
    var parameterIndex = 0
    while (valid && parameterIndex < signatures.parameterOwners.size) {
        if (signatures.parameterOwners[parameterIndex] == command) {
            val type = signatures.parameterTypes[parameterIndex]
            val pointerLevel = signatures.parameterPointerLevels[parameterIndex]
            var kind = ""
            if (pointerLevel != "0" ||
                registryVulkanAnyDispatchableType(type)) kind = "pointer"
            else if (type == "uint16_t") kind = "i16"
            else if (type == "HANDLE") kind = "pointer"
            else if (type == "int" || type == "zx_handle_t" ||
                type == "xcb_visualid_t") kind = "i32"
            else if (type == "VisualID" || type == "RROutput") kind = "i64"
            else if (registryVulkanI32Type(types, type)) kind = "i32"
            else if (registryVulkanI64Type(types, type)) kind = "i64"
            else if (type == "float") kind = "f32"
            if (kind == "") valid = false
            else {
                if (!first) abi = "$abi,"
                abi = "$abi$kind"
                first = false
            }
        }
        parameterIndex = parameterIndex + 1
    }
    if (valid) abi = "$abi)"
    if (valid) abi else ""
}

fun registryVulkanAdditionalCallAbi(
    command: string,
    returnType: string,
    signatures: RegistryCommandSignatures,
    types: RegistryTypes
): string {
    val abi = registryVulkanNormalizedCallAbi(
        command, returnType, signatures, types
    )
    if (registryVulkanAdditionalCallAbiSupported(abi)) abi else ""
}

fun registryCommandCallAbis(
    api: string,
    inventory: RegistryInventory,
    signatures: RegistryCommandSignatures,
    types: RegistryTypes
): array<string> {
    val abis: array<string> = []
    var commandIndex = 0
    while (commandIndex < inventory.commands.size) {
        val command = inventory.commands[commandIndex]
        var compatible = signatures.returnTypes[commandIndex] == "void"
