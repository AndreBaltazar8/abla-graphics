                else if (count > 0 && count < 4 && (
                    signatures.parameterPointerLevels[parameterIndex] != "0" ||
                    !registryVulkanI64Type(
                        types, signatures.parameterTypes[parameterIndex]
                    ))) vulkanI32PointerI64I64I64 = false
                else if (count > 3) vulkanI32PointerI64I64I64 = false
                if (count == 0 && (
                    signatures.parameterPointerLevels[parameterIndex] != "0" ||
                    !registryVulkanAnyDispatchableType(
                        signatures.parameterTypes[parameterIndex]
                    ))) vulkanVoidPointerI64I64I32Pointer = false
                else if ((count == 1 || count == 2) && (
                    signatures.parameterPointerLevels[parameterIndex] != "0" ||
                    !registryVulkanI64Type(
                        types, signatures.parameterTypes[parameterIndex]
                    ))) vulkanVoidPointerI64I64I32Pointer = false
                else if (count == 3 && (
                    signatures.parameterPointerLevels[parameterIndex] != "0" ||
                    !registryVulkanI32Type(
                        types, signatures.parameterTypes[parameterIndex]
                    ))) vulkanVoidPointerI64I64I32Pointer = false
                else if (count == 4 &&
                    signatures.parameterPointerLevels[parameterIndex] == "0") {
                    vulkanVoidPointerI64I64I32Pointer = false
                } else if (count > 4) {
                    vulkanVoidPointerI64I64I32Pointer = false
                }
                if (count == 0 && (
                    signatures.parameterPointerLevels[parameterIndex] != "0" ||
                    !registryVulkanAnyDispatchableType(
                        signatures.parameterTypes[parameterIndex]
                    ))) vulkanVoidPointerI64I64I64I32 = false
                else if (count > 0 && count < 4 && (
                    signatures.parameterPointerLevels[parameterIndex] != "0" ||
                    !registryVulkanI64Type(
                        types, signatures.parameterTypes[parameterIndex]
                    ))) vulkanVoidPointerI64I64I64I32 = false
                else if (count == 4 && (
                    signatures.parameterPointerLevels[parameterIndex] != "0" ||
                    !registryVulkanI32Type(
                        types, signatures.parameterTypes[parameterIndex]
                    ))) vulkanVoidPointerI64I64I64I32 = false
                else if (count > 4) vulkanVoidPointerI64I64I64I32 = false
                if (count == 0 && (
                    signatures.parameterPointerLevels[parameterIndex] != "0" ||
                    !registryVulkanAnyDispatchableType(
                        signatures.parameterTypes[parameterIndex]
                    ))) vulkanVoidPointerI64I64I64Pointer = false
                else if (count > 0 && count < 4 && (
                    signatures.parameterPointerLevels[parameterIndex] != "0" ||
                    !registryVulkanI64Type(
                        types, signatures.parameterTypes[parameterIndex]
                    ))) vulkanVoidPointerI64I64I64Pointer = false
                else if (count == 4 &&
                    signatures.parameterPointerLevels[parameterIndex] == "0") {
                    vulkanVoidPointerI64I64I64Pointer = false
                } else if (count > 4) {
                    vulkanVoidPointerI64I64I64Pointer = false
                }
                if (count == 0 && (
                    signatures.parameterPointerLevels[parameterIndex] != "0" ||
                    !registryVulkanAnyDispatchableType(
                        signatures.parameterTypes[parameterIndex]
                    ))) vulkanVoidPointerI64I64I32I32 = false
                else if ((count == 1 || count == 2) && (
                    signatures.parameterPointerLevels[parameterIndex] != "0" ||
                    !registryVulkanI64Type(
                        types, signatures.parameterTypes[parameterIndex]
                    ))) vulkanVoidPointerI64I64I32I32 = false
                else if ((count == 3 || count == 4) && (
                    signatures.parameterPointerLevels[parameterIndex] != "0" ||
                    !registryVulkanI32Type(
                        types, signatures.parameterTypes[parameterIndex]
                    ))) vulkanVoidPointerI64I64I32I32 = false
                else if (count > 4) vulkanVoidPointerI64I64I32I32 = false
                if (count == 0 && (
                    signatures.parameterPointerLevels[parameterIndex] != "0" ||
                    !registryVulkanAnyDispatchableType(
                        signatures.parameterTypes[parameterIndex]
                    ))) vulkanVoidPointerI64I64I64I64I32I32 = false
                else if (count > 0 && count < 5 && (
                    signatures.parameterPointerLevels[parameterIndex] != "0" ||
                    !registryVulkanI64Type(
                        types, signatures.parameterTypes[parameterIndex]
                    ))) vulkanVoidPointerI64I64I64I64I32I32 = false
                else if ((count == 5 || count == 6) && (
                    signatures.parameterPointerLevels[parameterIndex] != "0" ||
                    !registryVulkanI32Type(
                        types, signatures.parameterTypes[parameterIndex]
                    ))) vulkanVoidPointerI64I64I64I64I32I32 = false
                else if (count > 6) {
                    vulkanVoidPointerI64I64I64I64I32I32 = false
                }
                val scalarPointer = count == 0 &&
                    signatures.parameterPointerLevels[parameterIndex] == "0" &&
                    registryVulkanAnyDispatchableType(
                        signatures.parameterTypes[parameterIndex]
                    )
                val scalarI32 = count > 0 &&
                    signatures.parameterPointerLevels[parameterIndex] == "0" &&
                    registryVulkanI32Type(
                        types, signatures.parameterTypes[parameterIndex]
                    )
                val scalarI64 = count > 0 &&
                    signatures.parameterPointerLevels[parameterIndex] == "0" &&
                    registryVulkanI64Type(
                        types, signatures.parameterTypes[parameterIndex]
                    )
                val scalarAddress = count > 0 &&
                    signatures.parameterPointerLevels[parameterIndex] != "0"
                if (!(scalarPointer || (count == 1 && scalarI64)) || count > 1) {
                    vulkanVoidPointerI64 = false
                }
                if (!(scalarPointer || (count == 1 && scalarI32) ||
                    (count == 2 && scalarI64)) || count > 2) {
                    vulkanVoidPointerI32I64 = false
                }
                if (!(scalarPointer || (count == 1 && scalarI32) ||
                    (count == 2 && scalarI64) ||
                    (count == 3 && scalarI32)) || count > 3) {
                    vulkanVoidPointerI32I64I32 = false
                }
                if (!(scalarPointer || (count > 0 && count < 4 && scalarI32)) ||
                    count > 3) vulkanVoidPointerI32I32I32 = false
                if (!(scalarPointer || (count > 0 && count < 5 && scalarI32)) ||
                    count > 4) vulkanVoidPointerI32I32I32I32 = false
                if (!(scalarPointer || (count > 0 && count < 6 && scalarI32)) ||
                    count > 5) vulkanVoidPointerI32I32I32I32I32 = false
                if (!(scalarPointer || (count > 0 && count < 7 && scalarI32)) ||
                    count > 6) vulkanVoidPointerI32I32I32I32I32I32 = false
                if (!(scalarPointer || (count == 1 && scalarI32) ||
                    ((count == 2 || count == 3) && scalarAddress)) || count > 3) {
                    vulkanVoidPointerI32PointerPointer = false
                }
                if (!(scalarPointer ||
                    ((count == 1 || count == 2) && scalarI32) ||
                    ((count == 3 || count == 4) && scalarAddress)) || count > 4) {
                    vulkanVoidPointerI32I32PointerPointer = false
                }
                if (!(scalarPointer || (count == 1 && scalarI32)) || count > 1) {
                    vulkanI32PointerI32 = false
                }
                if (!(scalarPointer || (count == 1 && scalarI64) ||
                    (count == 2 && scalarI32)) || count > 2) {
                    vulkanI32PointerI64I32 = false
                }
                count = count + 1
            }
            parameterIndex = parameterIndex + 1
        }
        var abi = "unsupported"
        if (compatible && count == 0) abi = "void()"
        else if (compatible && count == 1) abi = "void(i32)"
        else if (compatible && count == 2) abi = "void(i32,i32)"
        else if (vulkanPointerI32 && count == 2) {
            abi = "void(pointer,i32)"
        }
        else if (vulkanPointer && count == 1) {
            abi = "void(pointer)"
        }
        else if (vulkanPointerI32I32 && count == 3) {
            abi = "void(pointer,i32,i32)"
        }
        else if (vulkanI32Pointer && count == 1) {
            abi = "i32(pointer)"
        }
        else if (vulkanI32Pointer4 && count == 4) {
            abi = "i32(pointer,pointer,pointer,pointer)"
        }
        else if (vulkanVoidPointerI64Pointer && count == 3) {
            abi = "void(pointer,i64,pointer)"
        }
        else if (vulkanI32PointerI64 && count == 2) {
            abi = "i32(pointer,i64)"
        }
        else if (vulkanVoidPointerPointer && count == 2) {
            abi = "void(pointer,pointer)"
        }
        else if (vulkanI32Pointer3 && count == 3) {
            abi = "i32(pointer,pointer,pointer)"
        }
        else if (vulkanVoidPointer3 && count == 3) {
            abi = "void(pointer,pointer,pointer)"
        }
        else if (vulkanI32PointerI32Pointer && count == 3) {
            abi = "i32(pointer,i32,pointer)"
        }
        else if (vulkanVoidPointerI32I32Pointer && count == 4) {
            abi = "void(pointer,i32,i32,pointer)"
        }
        else if (vulkanI32PointerPointer && count == 2) {
            abi = "i32(pointer,pointer)"
        }
        else if (vulkanVoidPointerI32Pointer && count == 3) {
            abi = "void(pointer,i32,pointer)"
        }
        else if (vulkanI32PointerI64Pointer && count == 3) {
            abi = "i32(pointer,i64,pointer)"
        }
        else if (vulkanI32PointerI64PointerPointer && count == 4) {
            abi = "i32(pointer,i64,pointer,pointer)"
        }
        else if (vulkanVoidPointerI64I32 && count == 3) {
            abi = "void(pointer,i64,i32)"
        }
        else if (vulkanVoidPointerI64I32I32 && count == 4) {
            abi = "void(pointer,i64,i32,i32)"
        }
        else if (vulkanVoidPointerI64I64 && count == 3) {
            abi = "void(pointer,i64,i64)"
        }
        else if (vulkanVoidPointerI64I64I32 && count == 4) {
            abi = "void(pointer,i64,i64,i32)"
        }
        else if (vulkanI32PointerPointerI64 && count == 3) {
            abi = "i32(pointer,pointer,i64)"
        }
        else if (vulkanI32PointerI32PointerI64 && count == 4) {
            abi = "i32(pointer,i32,pointer,i64)"
        }
        else if (vulkanI64PointerPointer && count == 2) {
            abi = "i64(pointer,pointer)"
        }
        else if (vulkanI32PointerI64I64I64 && count == 4) {
            abi = "i32(pointer,i64,i64,i64)"
        }
        else if (vulkanVoidPointerI64I64I32Pointer && count == 5) {
            abi = "void(pointer,i64,i64,i32,pointer)"
        }
        else if (vulkanVoidPointerI64I64I64I32 && count == 5) {
            abi = "void(pointer,i64,i64,i64,i32)"
        }
        else if (vulkanVoidPointerI64I64I64Pointer && count == 5) {
            abi = "void(pointer,i64,i64,i64,pointer)"
        }
        else if (vulkanVoidPointerI64I64I32I32 && count == 5) {
            abi = "void(pointer,i64,i64,i32,i32)"
        }
        else if (vulkanVoidPointerI64I64I64I64I32I32 && count == 7) {
            abi = "void(pointer,i64,i64,i64,i64,i32,i32)"
        }
        else if (vulkanVoidPointerI64 && count == 2) {
            abi = "void(pointer,i64)"
        }
        else if (vulkanVoidPointerI32I64 && count == 3) {
            abi = "void(pointer,i32,i64)"
        }
        else if (vulkanVoidPointerI32I64I32 && count == 4) {
            abi = "void(pointer,i32,i64,i32)"
        }
        else if (vulkanVoidPointerI32I32I32 && count == 4) {
            abi = "void(pointer,i32,i32,i32)"
        }
        else if (vulkanVoidPointerI32I32I32I32 && count == 5) {
            abi = "void(pointer,i32,i32,i32,i32)"
        }
        else if (vulkanVoidPointerI32I32I32I32I32 && count == 6) {
            abi = "void(pointer,i32,i32,i32,i32,i32)"
        }
        else if (vulkanVoidPointerI32I32I32I32I32I32 && count == 7) {
            abi = "void(pointer,i32,i32,i32,i32,i32,i32)"
        }
        else if (vulkanVoidPointerI32PointerPointer && count == 4) {
            abi = "void(pointer,i32,pointer,pointer)"
        }
        else if (vulkanVoidPointerI32I32PointerPointer && count == 5) {
            abi = "void(pointer,i32,i32,pointer,pointer)"
        }
        else if (vulkanI32PointerI32 && count == 2) {
            abi = "i32(pointer,i32)"
        }
        else if (vulkanI32PointerI64I32 && count == 3) {
            abi = "i32(pointer,i64,i32)"
        }
        if (api == "vulkan" && abi == "unsupported") {
            val additionalAbi = registryVulkanAdditionalCallAbi(
                command,
                signatures.returnTypes[commandIndex],
                signatures,
                types
            )
            if (additionalAbi != "") abi = additionalAbi
        }
        if (api == "opengl" && abi == "unsupported") {
            val additionalAbi = registryOpenGlNormalizedCallAbi(
                command, signatures.returnTypes[commandIndex], signatures
            )
            if (registryOpenGlCallAbiSupported(additionalAbi))
                abi = additionalAbi
        }
        abis.append(abi)
        commandIndex = commandIndex + 1
    }
    abis
}

fun registryCommandCallCandidates(
    api: string,
    inventory: RegistryInventory,
    signatures: RegistryCommandSignatures,
    types: RegistryTypes
): array<string> {
    if (api != "vulkan") return []
    val candidates: array<string> = []
    var commandIndex = 0
    while (commandIndex < inventory.commands.size) {
        var abi = registryVulkanNormalizedCallAbi(
            inventory.commands[commandIndex],
            signatures.returnTypes[commandIndex],
            signatures,
            types
        )
        if (abi == "") abi = "unsupported"
        candidates.append(abi)
        commandIndex = commandIndex + 1
    }
    candidates
}

fun registryCallSourcePrefix(api: string): string =
    if (api == "vulkan") "rawVulkanCall" else "rawOpenGlCall"

fun registryWriteCallSource(
    output: Path,
    api: string,
    revision: string,
    sha256: string,
    inventory: RegistryInventory,
    signatures: RegistryCommandSignatures,
    types: RegistryTypes
): bool {
    val prefix = registryCallSourcePrefix(api)
    val shapes = registryCommandCallShapes(inventory, signatures)
    val abis = registryCommandCallAbis(api, inventory, signatures, types)
    val candidates = registryCommandCallCandidates(
        api, inventory, signatures, types
    )
    var success = output.writeText("")
    var batch = ""
    if (success) batch = registryAppend(
        output,
        batch,
        "// Generated callable-command metadata. Do not edit."
    )
    if (success) batch = registryAppend(output, batch, "")
    if (success) batch = registryAppend(
        output, batch, "val ${prefix}Revision = \"$revision\""
    )
    if (success) batch = registryAppend(
        output, batch, "val ${prefix}Sha256 = \"$sha256\""
    )
    if (success) batch = registryAppend(
        output, batch, "val ${prefix}Count = ${inventory.commands.size}"
    )
    if (success) batch = registryAppend(output, batch, "")
    if (success) batch = registryWriteSourceArray(
        output, batch, "${prefix}Names", inventory.commands
    )
    if (success) batch = registryWriteSourceArray(
        output, batch, "${prefix}Shapes", shapes
    )
    if (success) batch = registryWriteSourceArray(
        output, batch, "${prefix}Abis", abis, false
    )
    if (success && api == "vulkan") batch = registryWriteSourceArray(
        output, batch, "${prefix}CandidateAbis", candidates, false
    )
    if (batch == "#write-failed") success = false
    if (success && batch != "") success = output.appendText(batch)
    success
}

fun registryWriteBuilderSource(
    output: Path,
    revision: string,
    sha256: string,
    constants: RegistryConstants,
    types: RegistryTypes,
    aggregates: RegistryAggregates
): bool {
    val builders = registryVulkanBuilderSchemas(
        aggregates, types, constants
    )
    val typeRecords = registryVulkanBuilderTypeRecords(builders)
    val memberRecords = registryVulkanBuilderMemberRecords(builders)
    var success = output.writeText("")
    var batch = ""
    if (success) batch = registryAppend(
        output, batch,
        "// Generated Vulkan structure-builder metadata. Do not edit."
    )
    if (success) batch = registryAppend(output, batch, "")
    if (success) batch = registryAppend(
        output, batch, "val rawVulkanBuilderRevision = \"$revision\""
    )
    if (success) batch = registryAppend(
        output, batch, "val rawVulkanBuilderSha256 = \"$sha256\""
    )
    if (success) batch = registryAppend(
        output, batch,
        "val rawVulkanBuilderTypeCount = ${builders.typeNames.size}"
    )
    if (success) batch = registryAppend(
        output, batch,
        "val rawVulkanBuilderMemberCount = ${builders.memberNames.size}"
    )
    if (success) batch = registryAppend(output, batch, "")
    if (success) batch = registryWriteCompactSource(
        output, batch, "rawVulkanBuilderTypeSchema", typeRecords
    )
    if (success) batch = registryWriteCompactSource(
        output, batch, "rawVulkanBuilderMemberSchema", memberRecords, false
    )
    if (batch == "#write-failed") success = false
    if (success && batch != "") success = output.appendText(batch)
    success
}

fun registryWriteDriverBuilderSource(
    output: Path,
    revision: string,
    sha256: string,
    requestedTypes: array<string>,
    constants: RegistryConstants,
    types: RegistryTypes,
    aggregates: RegistryAggregates
): bool {
    val builders = registryVulkanBuilderSchemas(
        aggregates, types, constants
    )
    val typeRecords: array<string> = []
    val memberRecords: array<string> = []
    var typeIndex = 0
    while (typeIndex < builders.typeNames.size) {
        if (registryArrayContains(
            requestedTypes, builders.typeNames[typeIndex]
        )) {
            typeRecords.append(
                "${builders.typeNames[typeIndex]}|${builders.sizes[typeIndex]}|${builders.alignments[typeIndex]}|${builders.structureTypes[typeIndex]}|${builders.extendsTypes[typeIndex]}"
            )
        }
        typeIndex = typeIndex + 1
    }
    var memberIndex = 0
    while (memberIndex < builders.memberNames.size) {
        if (registryArrayContains(
            requestedTypes, builders.memberOwners[memberIndex]
        )) {
            memberRecords.append(
                "${builders.memberOwners[memberIndex]}|${builders.memberNames[memberIndex]}|${builders.memberKinds[memberIndex]}|${builders.memberOffsets[memberIndex]}|${builders.memberElementSizes[memberIndex]}|${builders.memberElementCounts[memberIndex]}|${builders.memberBitOffsets[memberIndex]}|${builders.memberBitWidths[memberIndex]}"
            )
        }
        memberIndex = memberIndex + 1
    }
    var valid = requestedTypes.size > 0 &&
        typeRecords.size == requestedTypes.size
    var requestedIndex = 0
    while (valid && requestedIndex < requestedTypes.size) {
        var earlier = 0
        while (valid && earlier < requestedIndex) {
            valid = requestedTypes[earlier] != requestedTypes[requestedIndex]
            earlier = earlier + 1
        }
        requestedIndex = requestedIndex + 1
    }
    if (!valid) return false

    var success = output.writeText("")
    var batch = ""
    if (success) batch = registryAppend(
        output, batch,
        "// Generated production Vulkan driver structure metadata. Do not edit."
    )
    if (success) batch = registryAppend(output, batch, "")
    if (success) batch = registryAppend(
        output, batch, "val vulkanDriverBuilderRevision = \"$revision\""
    )
    if (success) batch = registryAppend(
        output, batch, "val vulkanDriverBuilderSha256 = \"$sha256\""
    )
    if (success) batch = registryAppend(
        output, batch,
        "val vulkanDriverBuilderTypeCount = ${typeRecords.size}"
    )
    if (success) batch = registryAppend(
        output, batch,
        "val vulkanDriverBuilderMemberCount = ${memberRecords.size}"
    )
    if (success) batch = registryAppend(output, batch, "")
    if (success) batch = registryWriteCompactSource(
        output, batch, "vulkanDriverBuilderTypeSchema", typeRecords
    )
    if (success) batch = registryWriteCompactSource(
        output, batch, "vulkanDriverBuilderMemberSchema", memberRecords
    )
    typeIndex = 0
    while (success && typeIndex < builders.typeNames.size) {
        if (registryArrayContains(
            requestedTypes, builders.typeNames[typeIndex]
        )) {
            batch = registryAppend(
                output, batch,
                "val vulkanDriverSize${builders.typeNames[typeIndex]} = ${builders.sizes[typeIndex]}"
            )
            batch = registryAppend(
                output, batch,
                "val vulkanDriverStructureType${builders.typeNames[typeIndex]} = ${builders.structureTypes[typeIndex]}"
            )
        }
        typeIndex = typeIndex + 1
    }
    if (success) batch = registryAppend(output, batch, "")
    memberIndex = 0
    while (success && memberIndex < builders.memberNames.size) {
        if (registryArrayContains(
            requestedTypes, builders.memberOwners[memberIndex]
        )) {
            batch = registryAppend(
                output, batch,
                "val vulkanDriverOffset${builders.memberOwners[memberIndex]}_${builders.memberNames[memberIndex]} = ${builders.memberOffsets[memberIndex]}"
            )
        }
        memberIndex = memberIndex + 1
    }
    if (batch == "#write-failed") success = false
    if (success && batch != "") success = output.appendText(batch)
    success
}

fun registryWriteSource(
    output: Path,
    api: string,
    revision: string,
    sha256: string,
    inventory: RegistryInventory,
    audit: RegistryAudit,
    constants: RegistryConstants,
    types: RegistryTypes,
    signatures: RegistryCommandSignatures,
    aggregates: RegistryAggregates
): bool {
    val prefix = registrySourcePrefix(api)
    val commandStatuses = registryStatuses(
        audit,
        "command",
        inventory.commands
    )
    val featureStatuses = registryStatuses(
        audit,
        "core-feature",
        inventory.features
    )
    val extensionStatuses = registryStatuses(
        audit,
        "extension",
        inventory.extensions
    )
    val commandCallShapes = registryCommandCallShapes(
        inventory,
        signatures
    )
    val commandCallAbis = registryCommandCallAbis(
        api,
        inventory,
        signatures,
        types
    )
    val commandCallCandidates = registryCommandCallCandidates(
        api,
        inventory,
        signatures,
        types
    )
    var success = output.writeText("")
    var batch = ""
    if (success) batch = registryAppend(
        output,
        batch,
        "// Generated from the pinned Khronos registry. Do not edit."
    )
    if (success) batch = registryAppend(output, batch, "")
    if (success) batch = registryAppend(
        output, batch, "val ${prefix}Revision = \"$revision\""
    )
    if (success) batch = registryAppend(
        output, batch, "val ${prefix}Sha256 = \"$sha256\""
    )
    if (success) batch = registryAppend(
        output,
        batch,
        "val ${prefix}CommandCount = ${inventory.commands.size}"
    )
    if (success) batch = registryAppend(
        output,
        batch,
        "val ${prefix}CoreFeatureCount = ${inventory.features.size}"
    )
    if (success) batch = registryAppend(
        output,
        batch,
        "val ${prefix}ExtensionCount = ${inventory.extensions.size}"
    )
    if (success) batch = registryAppend(
        output,
        batch,
        "val ${prefix}ConstantCount = ${constants.names.size}"
    )
    if (success) batch = registryAppend(
        output,
        batch,
        "val ${prefix}TypeCount = ${types.names.size}"
    )
    if (success && constants.names.size > 0) {
        batch = registryAppend(output, batch, "")
        var constantIndex = 0
        while (batch != "#write-failed" &&
            constantIndex < constants.names.size) {
            batch = registryAppend(
                output,
                batch,
                "val ${constants.names[constantIndex]} = ${constants.values[constantIndex]}"
            )
            constantIndex = constantIndex + 1
        }
    }
    if (success) batch = registryAppend(output, batch, "")
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}ConstantNames",
        constants.names
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}Types",
        types.names
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}TypeCategories",
        types.categories
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}TypeAliases",
        types.aliases
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}TypeDependencies",
        types.dependencies
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}TypeUnderlyingTypes",
        types.underlyingTypes
    )
    if (success) batch = registryWriteSourceArray(
        output, batch, "${prefix}Aggregates", aggregates.names
    )
    if (success) batch = registryWriteSourceArray(
        output, batch, "${prefix}AggregateKinds", aggregates.kinds
    )
    if (success) batch = registryWriteSourceArray(
        output, batch, "${prefix}AggregateMemberOwners",
        aggregates.memberOwners
    )
    if (success) batch = registryWriteSourceArray(
        output, batch, "${prefix}AggregateMemberNames",
        aggregates.memberNames
    )
    if (success) batch = registryWriteSourceArray(
        output, batch, "${prefix}AggregateMemberTypes",
        aggregates.memberTypes
    )
    if (success) batch = registryWriteSourceArray(
        output, batch, "${prefix}AggregateMemberPointerLevels",
        aggregates.memberPointerLevels
    )
    if (success) batch = registryWriteSourceArray(
        output, batch, "${prefix}AggregateMemberConstness",
        aggregates.memberConstness
    )
    if (success) batch = registryWriteSourceArray(
        output, batch, "${prefix}AggregateMemberArrayShapes",
        aggregates.memberArrayShapes
    )
    if (success) batch = registryWriteSourceArray(
        output, batch, "${prefix}AggregateMemberBitWidths",
        aggregates.memberBitWidths
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}Commands",
        inventory.commands
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}CommandForms",
        inventory.commandForms
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}CommandReturnTypes",
        signatures.returnTypes
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}CommandParameterCounts",
        signatures.parameterCounts
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}CommandParameterOwners",
        signatures.parameterOwners
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}CommandParameterNames",
        signatures.parameterNames
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}CommandParameterTypes",
        signatures.parameterTypes
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}CommandParameterPointerLevels",
        signatures.parameterPointerLevels
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}CommandParameterConstness",
        signatures.parameterConstness
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}CommandCallShapes",
        commandCallShapes
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}CommandCallAbis",
        commandCallAbis
    )
    if (success && api == "vulkan") batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}CommandCallCandidateAbis",
        commandCallCandidates
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}CommandStatuses",
        commandStatuses
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}CoreFeatures",
        inventory.features
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}CoreFeatureStatuses",
        featureStatuses
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}Extensions",
        inventory.extensions
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}ExtensionStatuses",
        extensionStatuses,
        false
    )
    if (batch == "#write-failed") success = false
    if (success && batch != "") success = output.appendText(batch)
    success
}

fun main: int {
    if (processArgumentCount() != 7 && processArgumentCount() != 8 &&
        processArgumentCount() != 9 && processArgumentCount() != 11) {
        eprintln("usage: registry-generator <vulkan|opengl> <input.xml> <audit.tsv> <coverage.md> <raw.ab> <revision> <sha256> [calls.ab] [builders.ab] [driver-types.txt driver-builders.ab]")
        2
    } else {
        val api = processArgument(0)
        val input = Path(processArgument(1))
        val auditInput = Path(processArgument(2))
        val output = Path(processArgument(3))
        val sourceOutput = Path(processArgument(4))
        if (!input.exists()) {
            eprintln("registry input does not exist: ${input.text}")
            3
        } else if (!auditInput.exists()) {
            eprintln("registry audit does not exist: ${auditInput.text}")
            3
        } else if (processArgumentCount() == 11 &&
            !Path(processArgument(9)).exists()) {
            eprintln(
                "driver structure manifest does not exist: ${processArgument(9)}"
            )
            3
        } else {
            val inventory = registryParse(input.readText(), api)
            val audit = registryParseAudit(auditInput.readText())
            val constants = registryParseConstants(input.readText(), api)
            val types = registryParseTypes(input.readText(), api, inventory)
            val signatures = registryParseCommandSignatures(
                input.readText(), api, inventory
            )
            val aggregates = registryParseAggregates(
                input.readText(), api, types
            )
            if (!inventory.valid) {
                eprintln("registry parse failed: ${inventory.error}")
                4
            } else if (!audit.valid) {
                eprintln("registry audit failed: ${audit.error}")
                4
            } else if (!constants.valid) {
                eprintln("registry constants failed: ${constants.error}")
                4
            } else if (!types.valid) {
                eprintln("registry types failed: ${types.error}")
                4
            } else if (!signatures.valid) {
                eprintln("registry command signatures failed: ${signatures.error}")
                4
            } else if (!aggregates.valid) {
                eprintln("registry aggregates failed: ${aggregates.error}")
                4
            } else if (registryAuditValidate(audit, inventory) != "") {
                eprintln("registry audit failed: ${registryAuditValidate(audit, inventory)}")
                4
            } else if (!registryWrite(
                output, api, processArgument(5), processArgument(6), inventory,
                audit, constants, types, signatures, aggregates
            )) {
                eprintln("failed to write registry inventory: ${output.text}")
                5
            } else if (!registryWriteSource(
                sourceOutput,
                api,
                processArgument(5),
                processArgument(6),
                inventory,
                audit,
                constants,
                types,
                signatures,
                aggregates
            )) {
                eprintln("failed to write raw registry source: ${sourceOutput.text}")
                5
            } else if (processArgumentCount() >= 8 &&
                !registryWriteCallSource(
                    Path(processArgument(7)),
                    api,
                    processArgument(5),
                    processArgument(6),
                    inventory,
                    signatures,
                    types
                )) {
                eprintln("failed to write callable registry source: ${processArgument(7)}")
                5
            } else if (processArgumentCount() == 9 &&
                !registryWriteBuilderSource(
                    Path(processArgument(8)),
                    processArgument(5),
                    processArgument(6),
                    constants,
                    types,
                    aggregates
                )) {
                eprintln("failed to write builder registry source: ${processArgument(8)}")
                5
            } else if (processArgumentCount() == 11 &&
                (!registryWriteBuilderSource(
                    Path(processArgument(8)),
                    processArgument(5),
                    processArgument(6),
                    constants,
                    types,
                    aggregates
                ) || !registryWriteDriverBuilderSource(
                    Path(processArgument(10)),
                    processArgument(5),
                    processArgument(6),
                    registryParseDriverTypes(
                        Path(processArgument(9)).readText()
                    ),
                    constants,
                    types,
                    aggregates
                ))) {
                eprintln(
                    "failed to write production driver builder source: ${processArgument(10)}"
                )
                5
            } else {
                println("$api: ${inventory.commands.size} commands, ${inventory.features.size} core features, ${inventory.extensions.size} extensions")
                0
            }
        }
    }
}
