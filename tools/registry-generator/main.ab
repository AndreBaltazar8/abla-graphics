        var vulkanVoidPointerI64I64 = vulkanVoidPointerI64I32
        var vulkanVoidPointerI64I64I32 = vulkanVoidPointerI64I32
        var vulkanI32PointerPointerI64 = vulkanI32Pointer
        var vulkanI32PointerI32PointerI64 = vulkanI32Pointer
        var vulkanI64PointerPointer = api == "vulkan" &&
            registryVulkanI64Type(
                types, signatures.returnTypes[commandIndex]
            )
