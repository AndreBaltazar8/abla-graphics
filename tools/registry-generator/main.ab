import "abla/fs"
import "abla/io"
import "abla/process/arguments"
import "abla/text"

class RegistryInventory(
    val commands: array<string>,
    val commandForms: array<string>,
    val features: array<string>,
    val extensions: array<string>,
    val valid: bool,
    val error: string
)

class RegistryAudit(
    val kinds: array<string>,
    val names: array<string>,
    val statuses: array<string>,
    val loaders: array<string>,
    val abis: array<string>,
    val positives: array<string>,
    val unsupportedPaths: array<string>,
    val valid: bool,
    val error: string
)

class RegistryConstants(
    val names: array<string>,
    val values: array<string>,
    val valid: bool,
    val error: string
)

class RegistryConstantExpression(
    val value: string,
    val dependency: string,
    val valid: bool,
    val error: string
)

class RegistryTypes(
    val names: array<string>,
    val categories: array<string>,
    val aliases: array<string>,
    val dependencies: array<string>,
    val valid: bool,
    val error: string
)

class RegistryCommandSignatures(
    val returnTypes: array<string>,
    val parameterCounts: array<string>,
    val parameterOwners: array<string>,
    val parameterNames: array<string>,
    val parameterTypes: array<string>,
    val parameterPointerLevels: array<string>,
    val parameterConstness: array<string>,
    val valid: bool,
    val error: string
)

class RegistryAggregates(
    val names: array<string>,
    val kinds: array<string>,
    val memberOwners: array<string>,
    val memberNames: array<string>,
    val memberTypes: array<string>,
    val memberPointerLevels: array<string>,
    val memberConstness: array<string>,
    val memberArrayShapes: array<string>,
    val memberBitWidths: array<string>,
    val valid: bool,
    val error: string
)

fun registryOpeningTagEnd(source: string, begin: int): int =
    textFindByte(source, 62, begin, source.size)

fun registryAttribute(tag: string, name: string): string {
    val marker = "$name=\""
    val markerOffset = textFindSequence(tag, marker)
    var result = ""
    if (markerOffset >= 0) {
        val begin = markerOffset + marker.size
        val end = textFindByte(tag, 34, begin, tag.size)
        if (end >= begin) result = tag.slice(begin, end)
    }
    result
}

fun registryTokenListContains(list: string, wanted: string): bool {
    var found = false
    var begin = 0
    var offset = 0
    while (!found && offset <= list.size) {
        if (offset == list.size || list[offset] == 124 || list[offset] == 44) {
            if (list.slice(begin, offset) == wanted) found = true
            begin = offset + 1
        }
        offset = offset + 1
    }
    found
}

fun registryArrayContains(values: array<string>, wanted: string): bool {
    var found = false
    var index = 0
    while (!found && index < values.size) {
        if (values[index] == wanted) found = true
        index = index + 1
    }
    found
}

fun registryArrayIndex(values: array<string>, wanted: string): int {
    var result = -1
    var index = 0
    while (result < 0 && index < values.size) {
        if (values[index] == wanted) result = index
        index = index + 1
    }
    result
}

fun registryAuditIndex(
    audit: RegistryAudit,
    kind: string,
    name: string
): int {
    var result = -1
    var index = 0
    while (result < 0 && index < audit.names.size) {
        if (audit.kinds[index] == kind && audit.names[index] == name) {
            result = index
        }
        index = index + 1
    }
    result
}

fun registryAuditFieldSafe(field: string): bool =
    field != "" && textFindByte(field, 124) < 0 &&
    textFindByte(field, 96) < 0 && textFindByte(field, 10) < 0 &&
    textFindByte(field, 13) < 0

fun registryParseAudit(source: string): RegistryAudit {
    val kinds: array<string> = []
    val names: array<string> = []
    val statuses: array<string> = []
    val loaders: array<string> = []
    val abis: array<string> = []
    val positives: array<string> = []
    val unsupportedPaths: array<string> = []
    var valid = true
    var error = ""
    var cursor = 0
    var lineNumber = 1
    while (valid && cursor <= source.size) {
        var end = textFindByte(source, 10, cursor, source.size)
        if (end < 0) end = source.size
        var line = source.slice(cursor, end)
        if (line.size > 0 && line[line.size - 1] == 13) {
            line = line.slice(0, line.size - 1)
        }
        if (line != "" && line[0] != 35) {
            val fields: array<string> = []
            var fieldBegin = 0
            var fieldOffset = 0
            while (fieldOffset <= line.size) {
                if (fieldOffset == line.size || line[fieldOffset] == 9) {
                    fields.append(line.slice(fieldBegin, fieldOffset))
                    fieldBegin = fieldOffset + 1
                }
                fieldOffset = fieldOffset + 1
            }
            if (fields.size != 7) {
                valid = false
                error = "audit line $lineNumber must have 7 tab-separated fields"
            } else {
                val kind = fields[0]
                val name = fields[1]
                val status = fields[2]
                val knownKind = kind == "command" || kind == "core-feature" ||
                    kind == "extension"
                val knownStatus = status == "common" || status == "raw" ||
                    status == "unsupported" ||
                    status == "platform-inapplicable"
                var safe = name != "" && registryAuditFieldSafe(fields[3]) &&
                    registryAuditFieldSafe(fields[4]) &&
                    registryAuditFieldSafe(fields[5]) &&
                    registryAuditFieldSafe(fields[6])
                if (textFindByte(name, 124) >= 0 ||
                    textFindByte(name, 96) >= 0) safe = false
                if (!knownKind) {
                    valid = false
                    error = "unknown audit kind on line $lineNumber: $kind"
                } else if (!knownStatus) {
                    valid = false
                    error = "unknown audit status on line $lineNumber: $status"
                } else if (!safe) {
                    valid = false
                    error = "unsafe or incomplete audit evidence on line $lineNumber"
                } else {
                    var duplicate = false
                    var index = 0
                    while (!duplicate && index < names.size) {
                        duplicate = kinds[index] == kind && names[index] == name
                        index = index + 1
                    }
                    if (duplicate) {
                        valid = false
                        error = "duplicate audit row on line $lineNumber: $kind $name"
                    } else {
                        kinds.append(kind)
                        names.append(name)
                        statuses.append(status)
                        loaders.append(fields[3])
                        abis.append(fields[4])
                        positives.append(fields[5])
                        unsupportedPaths.append(fields[6])
                    }
                }
            }
        }
        cursor = end + 1
        lineNumber = lineNumber + 1
        if (end == source.size) cursor = source.size + 1
    }
    RegistryAudit(
        kinds, names, statuses, loaders, abis, positives, unsupportedPaths,
        valid, error
    )
}

fun registryAuditValidate(
    audit: RegistryAudit,
    inventory: RegistryInventory
): string {
    var error = ""
    var index = 0
    while (error == "" && index < audit.names.size) {
        val kind = audit.kinds[index]
        val name = audit.names[index]
        var known = false
        if (kind == "command") {
            known = registryArrayContains(inventory.commands, name)
        } else if (kind == "core-feature") {
            known = registryArrayContains(inventory.features, name)
        } else if (kind == "extension") {
            known = registryArrayContains(inventory.extensions, name)
        }
        if (!known) error = "audit row is absent from selected registry: $kind $name"
        index = index + 1
    }
    error
}

fun registryStringLess(left: string, right: string): bool {
    var offset = 0
    var decided = false
    var less = false
    val shared = if (left.size < right.size) left.size else right.size
    while (!decided && offset < shared) {
        if (left[offset] < right[offset]) {
            less = true
            decided = true
        } else if (left[offset] > right[offset]) {
            decided = true
        }
        offset = offset + 1
    }
    if (!decided) less = left.size < right.size
    less
}

fun registrySortPaired(var names: array<string>, var forms: array<string>): void {
    var index = 1
    while (index < names.size) {
        val name = names[index]
        val form = forms[index]
        var target = index
        while (target > 0 && registryStringLess(name, names[target - 1])) {
            names[target] = names[target - 1]
            forms[target] = forms[target - 1]
            target = target - 1
        }
        names[target] = name
        forms[target] = form
        index = index + 1
    }
}

fun registrySort(var values: array<string>): void {
    var index = 1
    while (index < values.size) {
        val value = values[index]
        var target = index
        while (target > 0 && registryStringLess(value, values[target - 1])) {
            values[target] = values[target - 1]
            target = target - 1
        }
        values[target] = value
        index = index + 1
    }
}

fun registryConstantValueValid(value: string): bool {
    var valid = value.size > 0
    var offset = 0
    if (valid && value[0] == 45) {
        offset = 1
        valid = value.size > 1
    }
    var hexadecimal = false
    if (valid && offset + 2 <= value.size && value[offset] == 48 &&
        value[offset + 1] == 120) {
        hexadecimal = true
        offset = offset + 2
        valid = offset < value.size
    }
    while (valid && offset < value.size) {
        val byte = value[offset]
        if (hexadecimal) {
            valid = (byte >= 48 && byte <= 57) ||
                (byte >= 65 && byte <= 70) ||
                (byte >= 97 && byte <= 102)
        } else valid = byte >= 48 && byte <= 57
        offset = offset + 1
    }
    valid
}

fun registryDecimalValid(value: string): bool {
    var valid = value.size > 0
    var offset = 0
    while (valid && offset < value.size) {
        valid = value[offset] >= 48 && value[offset] <= 57
        offset = offset + 1
    }
    valid
}

fun registryDecimalValue(value: string): int {
    var result = 0
    var offset = 0
    while (offset < value.size) {
        result = result * 10 + value[offset] - 48
        offset = offset + 1
    }
    result
}

fun registryIdentifierValid(value: string): bool {
    var valid = value.size > 0 &&
        ((value[0] >= 65 && value[0] <= 90) ||
        (value[0] >= 97 && value[0] <= 122) || value[0] == 95)
    var offset = 1
    while (valid && offset < value.size) {
        val byte = value[offset]
        valid = (byte >= 65 && byte <= 90) ||
            (byte >= 97 && byte <= 122) ||
            (byte >= 48 && byte <= 57) || byte == 95
        offset = offset + 1
    }
    valid
}

fun registryFloatValue(value: string): string {
    var result = ""
    if (value.size > 2 &&
        (value[value.size - 1] == 70 || value[value.size - 1] == 102)) {
        val body = value.slice(0, value.size - 1)
        var valid = true
        var dots = 0
        var offset = 0
        while (valid && offset < body.size) {
            val byte = body[offset]
            if (byte == 46) dots = dots + 1
            else if (byte < 48 || byte > 57) valid = false
            offset = offset + 1
        }
        if (valid && dots == 1) result = body
    }
    result
}

fun registryStringValue(value: string): string {
    val marker = "&quot;"
    var result = ""
    if (value.size >= marker.size * 2 &&
        value.slice(0, marker.size) == marker &&
        value.slice(value.size - marker.size, value.size) == marker) {
        val body = value.slice(marker.size, value.size - marker.size)
        var valid = body.size > 0
        var offset = 0
        while (valid && offset < body.size) {
            val byte = body[offset]
            valid = byte >= 32 && byte <= 126 && byte != 34 &&
                byte != 38 && byte != 92
            offset = offset + 1
        }
        if (valid) result = "\"$body\""
    }
    result
}

fun registryBitValue(bitpos: string): string {
    var result = ""
    if (registryDecimalValid(bitpos)) {
        val bit = registryDecimalValue(bitpos)
        if (bit <= 63) {
            val digits = "1248"
            val digit = bit - bit / 4 * 4
            result = "0x${digits.slice(digit, digit + 1)}"
            var zeros = bit / 4
            while (zeros > 0) {
                result = "${result}0"
                zeros = zeros - 1
            }
        }
    }
    result
}

fun registryVulkanConstantExpression(
    opening: string,
    inheritedExtensionNumber: string
): RegistryConstantExpression {
    val name = registryAttribute(opening, "name")
    val value = registryAttribute(opening, "value")
    val bitpos = registryAttribute(opening, "bitpos")
    val offset = registryAttribute(opening, "offset")
    val alias = registryAttribute(opening, "alias")
    var forms = 0
    if (value != "") forms = forms + 1
    if (bitpos != "") forms = forms + 1
    if (offset != "") forms = forms + 1
    if (alias != "") forms = forms + 1
    var expression = ""
    var dependency = ""
    var valid = forms <= 1
    var error = if (valid) "" else
        "multiple Vulkan constant expressions: $name"
    if (valid && value != "") {
        if (registryConstantValueValid(value)) expression = value
        else if (value == "(~0U)" || value == "(~0ULL)") expression = "-1"
        else if (value == "(~1U)") expression = "0xFFFFFFFE"
        else if (value == "(~2U)") expression = "0xFFFFFFFD"
        else {
            expression = registryFloatValue(value)
            if (expression == "") expression = registryStringValue(value)
            if (expression == "") {
                valid = false
                error = "unsupported Vulkan constant expression: $name=$value"
            }
        }
    } else if (valid && bitpos != "") {
        expression = registryBitValue(bitpos)
        if (expression == "") {
            valid = false
            error = "unsupported Vulkan bit position: $name=$bitpos"
        }
    } else if (valid && offset != "") {
        var extensionNumber = registryAttribute(opening, "extnumber")
        if (extensionNumber == "") extensionNumber = inheritedExtensionNumber
        val direction = registryAttribute(opening, "dir")
        if (!registryDecimalValid(extensionNumber) ||
            !registryDecimalValid(offset) ||
            (direction != "" && direction != "-")) {
            valid = false
            error = "unsupported Vulkan extension offset: $name"
        } else {
            val number = 1000000000 +
                (registryDecimalValue(extensionNumber) - 1) * 1000 +
                registryDecimalValue(offset)
            expression = if (direction == "-") "-${number}" else "$number"
        }
    } else if (valid && alias != "") {
        if (!registryIdentifierValid(alias) || alias.size < 3 ||
            alias.slice(0, 3) != "VK_") {
            valid = false
            error = "unsupported Vulkan constant alias: $name=$alias"
        } else {
            expression = alias
            dependency = alias
        }
    }
    RegistryConstantExpression(expression, dependency, valid, error)
}

fun registryAddConstant(
    name: string,
    expression: RegistryConstantExpression,
    var requested: array<string>,
    var names: array<string>,
    var values: array<string>
): string {
    var error = expression.error
    if (expression.valid) {
        if (!registryArrayContains(requested, name)) requested.append(name)
        if (expression.dependency != "" &&
            !registryArrayContains(requested, expression.dependency)) {
            requested.append(expression.dependency)
        }
        if (expression.value != "") {
            val existing = registryArrayIndex(names, name)
            if (existing < 0) {
                names.append(name)
                values.append(expression.value)
            } else if (values[existing] != expression.value) {
                error = "conflicting Vulkan constant definition: $name"
            }
        }
    }
    error
}

fun registryResolveConstantAliases(
    names: array<string>,
    var values: array<string>
): string {
    var error = ""
    var changed = true
    while (error == "" && changed) {
        changed = false
        var index = 0
        while (error == "" && index < values.size) {
            val value = values[index]
            if (value.size > 3 && value.slice(0, 3) == "VK_") {
                val target = registryArrayIndex(names, value)
                if (target < 0) {
                    error = "Vulkan constant alias target has no definition: ${names[index]}=$value"
                } else {
                    val resolved = values[target]
                    if (resolved.size <= 3 || resolved.slice(0, 3) != "VK_") {
                        values[index] = resolved
                        changed = true
                    }
                }
            }
            index = index + 1
        }
    }
    if (error == "") {
        var index = 0
        while (error == "" && index < values.size) {
            if (values[index].size > 3 &&
                values[index].slice(0, 3) == "VK_") {
                error = "cyclic Vulkan constant alias: ${names[index]}"
            }
            index = index + 1
        }
    }
    error
}

fun registrySortTypeMetadata(
    var names: array<string>,
    var categories: array<string>,
    var aliases: array<string>,
    var dependencies: array<string>
): void {
    var index = 1
    while (index < names.size) {
        val name = names[index]
        val category = categories[index]
        val alias = aliases[index]
        val dependency = dependencies[index]
        var target = index
        while (target > 0 && registryStringLess(name, names[target - 1])) {
            names[target] = names[target - 1]
            categories[target] = categories[target - 1]
            aliases[target] = aliases[target - 1]
            dependencies[target] = dependencies[target - 1]
            target = target - 1
        }
        names[target] = name
        categories[target] = category
        aliases[target] = alias
        dependencies[target] = dependency
        index = index + 1
    }
}

fun registryAppendRequiredTypeNames(
    source: string,
    begin: int,
    end: int,
    wantedApi: string,
    excludeCompatibility: bool,
    var requested: array<string>
): string {
    var error = ""
    var cursor = begin
    while (error == "") {
        val requireBegin = textFindSequence(source, "<require", cursor, end)
        if (requireBegin < 0) break
        val afterName = requireBegin + 8
        if (afterName < end && source[afterName] != 62 &&
            source[afterName] != 32 && source[afterName] != 9 &&
            source[afterName] != 10 && source[afterName] != 13) {
            cursor = afterName
            continue
        }
        val openEnd = textFindByte(source, 62, afterName, end)
        if (openEnd < 0) error = "unterminated type requirement"
        else {
            val opening = source.slice(requireBegin, openEnd + 1)
            val requireApi = registryAttribute(opening, "api")
            val profile = registryAttribute(opening, "profile")
            val selectedApi = requireApi == "" ||
                registryTokenListContains(requireApi, wantedApi)
            val selectedProfile = !excludeCompatibility ||
                profile != "compatibility"
            if (registryTagSelfClosing(opening)) cursor = openEnd + 1
            else {
                val close = textFindSequence(
                    source, "</require>", openEnd + 1, end
                )
                if (close < 0) error = "unterminated type requirement"
                else {
                    if (selectedApi && selectedProfile) {
                        var typeCursor = openEnd + 1
                        while (error == "") {
                            val typeBegin = textFindSequence(
                                source, "<type", typeCursor, close
                            )
                            if (typeBegin < 0) break
                            val typeAfterName = typeBegin + 5
                            if (typeAfterName < close &&
                                source[typeAfterName] != 62 &&
                                source[typeAfterName] != 32 &&
                                source[typeAfterName] != 9 &&
                                source[typeAfterName] != 10 &&
                                source[typeAfterName] != 13) {
                                typeCursor = typeAfterName
                            } else {
                                val typeEnd = textFindByte(
                                    source, 62, typeAfterName, close
                                )
                                if (typeEnd < 0) {
                                    error = "unterminated required type"
                                } else {
                                    val typeOpening = source.slice(
                                        typeBegin, typeEnd + 1
                                    )
                                    val name = registryAttribute(
                                        typeOpening, "name"
                                    )
                                    if (name != "" &&
                                        !registryArrayContains(
                                            requested, name
                                        )) requested.append(name)
                                    typeCursor = typeEnd + 1
                                }
                            }
                        }
                    }
                    cursor = close + 10
                }
            }
        }
    }
    error
}

fun registryTypeBodyName(source: string, begin: int, end: int): string {
    var result = ""
    val nameOpen = textFindSequence(source, "<name>", begin, end)
    if (nameOpen >= 0) {
        val nameBegin = nameOpen + 6
        val nameEnd = textFindSequence(source, "</name>", nameBegin, end)
        if (nameEnd >= 0) result = source.slice(nameBegin, nameEnd)
    }
    result
}

fun registryTypeDefinitionEnd(source: string, begin: int, end: int): int {
    var result = -1
    var depth = 1
    var cursor = begin
    while (result < 0 && depth > 0) {
        var opening = textFindSequence(source, "<type", cursor, end)
        while (opening >= 0 && opening + 5 < end &&
            source[opening + 5] != 62 && source[opening + 5] != 32 &&
            source[opening + 5] != 9 && source[opening + 5] != 10 &&
            source[opening + 5] != 13) {
            opening = textFindSequence(source, "<type", opening + 5, end)
        }
        val closing = textFindSequence(source, "</type>", cursor, end)
        if (closing < 0) depth = 0
        else if (opening >= 0 && opening < closing) {
            depth = depth + 1
            cursor = opening + 5
        } else {
            depth = depth - 1
            if (depth == 0) result = closing
            else cursor = closing + 7
        }
    }
    result
}

fun registryParseTypes(
    source: string,
    api: string,
    inventory: RegistryInventory
): RegistryTypes {
    val requested: array<string> = []
    val names: array<string> = []
    val categories: array<string> = []
    val aliases: array<string> = []
    val dependencies: array<string> = []
    val priorities: array<int> = []
    val wantedApi = if (api == "opengl") "gl" else "vulkan"
    var valid = api == "vulkan" || api == "opengl"
    var error = if (valid) "" else "API must be vulkan or opengl"
    var cursor = 0
    while (valid) {
        val begin = textFindSequence(source, "<feature", cursor, source.size)
        if (begin < 0) break
        val afterName = begin + 8
        if (afterName < source.size && source[afterName] != 62 &&
            source[afterName] != 32 && source[afterName] != 9 &&
            source[afterName] != 10 && source[afterName] != 13) {
            cursor = afterName
            continue
        }
        val openEnd = registryOpeningTagEnd(source, afterName)
        if (openEnd < 0) {
            valid = false
            error = "unterminated type feature"
        } else {
            val opening = source.slice(begin, openEnd + 1)
            val featureApi = registryAttribute(opening, "api")
            val selected = registryTokenListContains(featureApi, wantedApi) &&
                registryAttribute(opening, "name") != ""
            if (registryTagSelfClosing(opening)) cursor = openEnd + 1
            else {
                val close = textFindSequence(
                    source, "</feature>", openEnd + 1, source.size
                )
                if (close < 0) {
                    valid = false
                    error = "unterminated type feature"
                } else {
                    if (selected) {
                        error = registryAppendRequiredTypeNames(
                            source, openEnd + 1, close, wantedApi,
                            api == "opengl", requested
                        )
                        if (error != "") valid = false
                    }
                    cursor = close + 10
                }
            }
        }
    }
    cursor = 0
    while (valid) {
        val begin = textFindSequence(source, "<extension", cursor, source.size)
        if (begin < 0) break
        val afterName = begin + 10
        if (afterName < source.size && source[afterName] != 62 &&
            source[afterName] != 32 && source[afterName] != 9 &&
            source[afterName] != 10 && source[afterName] != 13) {
            cursor = afterName
            continue
        }
        val openEnd = registryOpeningTagEnd(source, afterName)
        if (openEnd < 0) {
            valid = false
            error = "unterminated type extension"
        } else {
            val opening = source.slice(begin, openEnd + 1)
            val selected = registryArrayContains(
                inventory.extensions,
                registryAttribute(opening, "name")
            )
            if (registryTagSelfClosing(opening)) cursor = openEnd + 1
            else {
                val close = textFindSequence(
                    source, "</extension>", openEnd + 1, source.size
                )
                if (close < 0) {
                    valid = false
                    error = "unterminated type extension"
                } else {
                    if (selected) {
                        error = registryAppendRequiredTypeNames(
                            source, openEnd + 1, close, wantedApi,
                            api == "opengl", requested
                        )
                        if (error != "") valid = false
                    }
                    cursor = close + 12
                }
            }
        }
    }
    val typesBegin = textFindSequence(source, "<types")
    val typesOpenEnd = if (typesBegin >= 0)
        registryOpeningTagEnd(source, typesBegin + 6) else -1
    val typesEnd = if (typesOpenEnd >= 0)
        textFindSequence(source, "</types>", typesOpenEnd + 1, source.size)
    else -1
    if (valid && (typesBegin < 0 || typesOpenEnd < 0 ||
        typesEnd <= typesOpenEnd)) {
        valid = false
        error = "registry has no complete types definition section"
    }
    var previousRequestedSize = -1
    while (valid && previousRequestedSize != requested.size) {
        previousRequestedSize = requested.size
        cursor = typesOpenEnd + 1
        while (valid) {
            val begin = textFindSequence(source, "<type", cursor, typesEnd)
            if (begin < 0) break
            val afterName = begin + 5
            if (afterName < typesEnd && source[afterName] != 62 &&
                source[afterName] != 32 && source[afterName] != 9 &&
                source[afterName] != 10 && source[afterName] != 13) {
                cursor = afterName
                continue
            }
            val openEnd = textFindByte(source, 62, afterName, typesEnd)
            if (openEnd < 0) {
                valid = false
                error = "unterminated type definition"
            } else {
                val opening = source.slice(begin, openEnd + 1)
                val selfClosing = registryTagSelfClosing(opening)
                val close = if (selfClosing) openEnd else
                    registryTypeDefinitionEnd(
                        source, openEnd + 1, typesEnd
                    )
                if (close < 0) {
                    valid = false
                    error = "unterminated type definition"
                } else {
                    var name = registryAttribute(opening, "name")
                    if (name == "" && !selfClosing) name = registryTypeBodyName(
                        source, openEnd + 1, close
                    )
                    val typeApi = registryAttribute(opening, "api")
                    val selectedApi = typeApi == "" ||
                        registryTokenListContains(typeApi, wantedApi) ||
                        (api == "opengl" &&
                        registryTokenListContains(typeApi, "glcore"))
                    if (selectedApi && (api == "opengl" ||
                        registryArrayContains(requested, name))) {
                        if (!registryArrayContains(requested, name)) {
                            requested.append(name)
                        }
                        var category = registryAttribute(opening, "category")
                        if (category == "") category = "declaration"
                        val alias = registryAttribute(opening, "alias")
                        val dependency = registryAttribute(opening, "requires")
                        val priority = if (typeApi == "") 1 else 2
                        val existing = registryArrayIndex(names, name)
                        if (existing < 0) {
                            names.append(name)
                            categories.append(category)
                            aliases.append(alias)
                            dependencies.append(dependency)
                            priorities.append(priority)
                        } else if (priority > priorities[existing]) {
                            categories[existing] = category
                            aliases[existing] = alias
                            dependencies[existing] = dependency
                            priorities[existing] = priority
                        } else if (priority == priorities[existing] &&
                            (categories[existing] != category ||
                            aliases[existing] != alias ||
                            dependencies[existing] != dependency)) {
                            valid = false
                            error = "conflicting registry type definition: $name"
                        }
                        if (alias != "" &&
                            !registryArrayContains(requested, alias)) {
                            requested.append(alias)
                        }
                        if (dependency != "" &&
                            !registryArrayContains(requested, dependency)) {
                            requested.append(dependency)
                        }
                    }
                    cursor = if (selfClosing) openEnd + 1 else close + 7
                }
            }
        }
    }
    var requestedIndex = 0
    while (valid && requestedIndex < requested.size) {
        if (!registryArrayContains(names, requested[requestedIndex])) {
            valid = false
            error = "required registry type has no definition: ${requested[requestedIndex]}"
        }
        requestedIndex = requestedIndex + 1
    }
    if (valid) registrySortTypeMetadata(
        names, categories, aliases, dependencies
    )
    RegistryTypes(names, categories, aliases, dependencies, valid, error)
}

fun registryTaggedText(
    source: string,
    begin: int,
    end: int,
    tag: string
): string {
    var result = ""
    var opening = textFindSequence(source, "<$tag", begin, end)
    val afterTagOffset = tag.size + 1
    while (opening >= 0 && opening + afterTagOffset < end &&
        source[opening + afterTagOffset] != 62 &&
        source[opening + afterTagOffset] != 32 &&
        source[opening + afterTagOffset] != 9 &&
        source[opening + afterTagOffset] != 10 &&
        source[opening + afterTagOffset] != 13) {
        opening = textFindSequence(
            source, "<$tag", opening + afterTagOffset, end
        )
    }
    if (opening >= 0) {
        val openingEnd = textFindByte(
            source, 62, opening + afterTagOffset, end
        )
        if (openingEnd >= 0) {
            val valueBegin = openingEnd + 1
            val close = textFindSequence(
                source, "</$tag>", valueBegin, end
            )
            if (close >= 0) result = source.slice(valueBegin, close)
        }
    }
    result
}

fun registryCommandAbiType(source: string, begin: int, end: int): string {
    var result = registryTaggedText(source, begin, end, "ptype")
    if (result == "") result = registryTaggedText(
        source, begin, end, "type"
    )
    if (result == "" && textFindSequence(
        source, "void", begin, end
    ) >= 0) result = "void"
    result
}

fun registryPointerLevel(source: string, begin: int, end: int): int {
    var result = 0
    var offset = begin
    while (offset < end) {
        if (source[offset] == 42) result = result + 1
        offset = offset + 1
    }
    result
}

fun registryResolveCommandAlias(
    name: string,
    aliases: array<string>,
    targets: array<string>
): string {
    var result = name
    var remaining = aliases.size + 1
    while (remaining > 0) {
        val found = registryArrayIndex(aliases, result)
        if (found < 0) remaining = 0
        else {
            result = targets[found]
            remaining = remaining - 1
        }
    }
    if (registryArrayIndex(aliases, result) >= 0) result = ""
    result
}

fun registryParseCommandSignatures(
    source: string,
    inventory: RegistryInventory
): RegistryCommandSignatures {
    val definitionNames: array<string> = []
    val definitionReturns: array<string> = []
    val aliases: array<string> = []
    val targets: array<string> = []
    val definitionParameterOwners: array<string> = []
    val definitionParameterNames: array<string> = []
    val definitionParameterTypes: array<string> = []
    val definitionParameterPointerLevels: array<string> = []
    val definitionParameterConstness: array<string> = []
    val returnTypes: array<string> = []
    val parameterCounts: array<string> = []
    val parameterOwners: array<string> = []
    val parameterNames: array<string> = []
    val parameterTypes: array<string> = []
    val parameterPointerLevels: array<string> = []
    val parameterConstness: array<string> = []
    var valid = true
    var error = ""
    val commandsBegin = textFindSequence(source, "<commands")
    val commandsOpenEnd = if (commandsBegin >= 0)
        registryOpeningTagEnd(source, commandsBegin + 9) else -1
    val commandsEnd = if (commandsOpenEnd >= 0)
        textFindSequence(
            source, "</commands>", commandsOpenEnd + 1, source.size
        )
    else -1
    if (commandsBegin < 0 || commandsOpenEnd < 0 ||
        commandsEnd <= commandsOpenEnd) {
        valid = false
        error = "registry has no complete command signature section"
    }
    var cursor = commandsOpenEnd + 1
    while (valid) {
        val begin = textFindSequence(source, "<command", cursor, commandsEnd)
        if (begin < 0) break
        val afterName = begin + 8
        if (afterName < commandsEnd && source[afterName] != 62 &&
            source[afterName] != 32 && source[afterName] != 9 &&
            source[afterName] != 10 && source[afterName] != 13) {
            cursor = afterName
            continue
        }
        val openEnd = textFindByte(source, 62, afterName, commandsEnd)
        if (openEnd < 0) {
            valid = false
            error = "unterminated command signature"
        } else {
            val opening = source.slice(begin, openEnd + 1)
            val alias = registryAttribute(opening, "name")
            val target = registryAttribute(opening, "alias")
            if (alias != "" && target != "") {
                aliases.append(alias)
                targets.append(target)
                cursor = openEnd + 1
            } else {
                val close = textFindSequence(
                    source, "</command>", openEnd + 1, commandsEnd
                )
                if (close < 0) {
                    valid = false
                    error = "unterminated command signature"
                } else {
                    val protoBegin = textFindSequence(
                        source, "<proto", openEnd + 1, close
                    )
                    val protoOpenEnd = if (protoBegin >= 0)
                        registryOpeningTagEnd(source, protoBegin + 6) else -1
                    val protoEnd = if (protoOpenEnd >= 0)
                        textFindSequence(
                            source, "</proto>", protoOpenEnd + 1, close
                        )
                    else -1
                    val name = if (protoOpenEnd >= 0 && protoEnd >= 0)
                        registryTaggedText(
                            source, protoOpenEnd + 1, protoEnd, "name"
                        )
                    else ""
                    val returnType = if (protoOpenEnd >= 0 && protoEnd >= 0)
                        registryCommandAbiType(
                            source, protoOpenEnd + 1, protoEnd
                        )
                    else ""
                    if (name == "" || returnType == "") {
                        valid = false
                        error = "command has incomplete ABI signature: $name"
                    } else {
                        definitionNames.append(name)
                        definitionReturns.append(returnType)
                        var parameterCursor = protoEnd + 8
                        while (valid) {
                            val parameterBegin = textFindSequence(
                                source, "<param", parameterCursor, close
                            )
                            if (parameterBegin < 0) break
                            val parameterAfterName = parameterBegin + 6
                            val parameterOpenEnd = textFindByte(
                                source, 62, parameterAfterName, close
                            )
                            val parameterEnd = if (parameterOpenEnd >= 0)
                                textFindSequence(
                                    source, "</param>",
                                    parameterOpenEnd + 1, close
                                )
                            else -1
                            if (parameterOpenEnd < 0 || parameterEnd < 0) {
                                valid = false
                                error = "unterminated command parameter: $name"
                            } else {
                                val parameterName = registryTaggedText(
                                    source,
                                    parameterOpenEnd + 1,
                                    parameterEnd,
                                    "name"
                                )
                                val parameterType = registryCommandAbiType(
                                    source,
                                    parameterOpenEnd + 1,
                                    parameterEnd
                                )
                                if (parameterName == "" &&
                                    parameterType == "") {
                                    // Registry prose may use param tags inside
                                    // implicit synchronization descriptions.
                                } else if (parameterName == "" ||
                                    parameterType == "") {
                                    valid = false
                                    error = "command has incomplete ABI parameter: $name"
                                } else {
                                    var pointerLevel = registryPointerLevel(
                                        source,
                                        parameterOpenEnd + 1,
                                        parameterEnd
                                    )
                                    if (textFindByte(
                                        source,
                                        91,
                                        parameterOpenEnd + 1,
                                        parameterEnd
                                    ) >= 0) pointerLevel = pointerLevel + 1
                                    val isConst = textFindSequence(
                                        source,
                                        "const",
                                        parameterOpenEnd + 1,
                                        parameterEnd
                                    ) >= 0
                                    definitionParameterOwners.append(name)
                                    definitionParameterNames.append(
                                        parameterName
                                    )
                                    definitionParameterTypes.append(
                                        parameterType
                                    )
                                    definitionParameterPointerLevels.append(
                                        "$pointerLevel"
                                    )
                                    definitionParameterConstness.append(
                                        if (isConst) "true" else "false"
                                    )
                                }
                                parameterCursor = parameterEnd + 8
                            }
                        }
                    }
                    cursor = close + 10
                }
            }
        }
    }
    var commandIndex = 0
    while (valid && commandIndex < inventory.commands.size) {
        val command = inventory.commands[commandIndex]
        val canonical = registryResolveCommandAlias(
            command, aliases, targets
        )
        val definition = registryArrayIndex(definitionNames, canonical)
        if (canonical == "") {
            valid = false
            error = "cyclic command alias: $command"
        } else if (definition < 0) {
            valid = false
            error = "command ABI target has no definition: $command=$canonical"
        } else {
            returnTypes.append(definitionReturns[definition])
            var count = 0
            var parameterIndex = 0
            while (parameterIndex < definitionParameterOwners.size) {
                if (definitionParameterOwners[parameterIndex] == canonical) {
                    parameterOwners.append(command)
                    parameterNames.append(
                        definitionParameterNames[parameterIndex]
                    )
                    parameterTypes.append(
                        definitionParameterTypes[parameterIndex]
                    )
                    parameterPointerLevels.append(
                        definitionParameterPointerLevels[parameterIndex]
                    )
                    parameterConstness.append(
                        definitionParameterConstness[parameterIndex]
                    )
                    count = count + 1
                }
                parameterIndex = parameterIndex + 1
            }
            parameterCounts.append("$count")
        }
        commandIndex = commandIndex + 1
    }
    RegistryCommandSignatures(
        returnTypes,
        parameterCounts,
        parameterOwners,
        parameterNames,
        parameterTypes,
        parameterPointerLevels,
        parameterConstness,
        valid,
        error
    )
}

fun registryTrimWhitespace(value: string): string {
    var begin = 0
    var end = value.size
    while (begin < end && (value[begin] == 32 || value[begin] == 9 ||
        value[begin] == 10 || value[begin] == 13)) begin = begin + 1
    while (end > begin && (value[end - 1] == 32 || value[end - 1] == 9 ||
        value[end - 1] == 10 || value[end - 1] == 13)) end = end - 1
    value.slice(begin, end)
}

fun registryMemberArrayShape(
    source: string,
    begin: int,
    end: int
): string {
    var result = ""
    val nameClose = textFindSequence(source, "</name>", begin, end)
    var cursor = if (nameClose >= 0) nameClose + 7 else end
    while (cursor < end) {
        val opening = textFindByte(source, 91, cursor, end)
        if (opening < 0) break
        val closing = textFindByte(source, 93, opening + 1, end)
        if (closing < 0) break
        var dimension = registryTaggedText(
            source, opening + 1, closing, "enum"
        )
        if (dimension == "") dimension = registryTrimWhitespace(
            source.slice(opening + 1, closing)
        )
        if (result == "") result = dimension
        else result = "$result,$dimension"
        cursor = closing + 1
    }
    result
}

fun registryMemberBitWidth(
    source: string,
    begin: int,
    end: int
): string {
    var result = ""
    val nameClose = textFindSequence(source, "</name>", begin, end)
    val colon = if (nameClose >= 0)
        textFindByte(source, 58, nameClose + 7, end) else -1
    if (colon >= 0) {
        var widthEnd = colon + 1
        while (widthEnd < end && source[widthEnd] >= 48 &&
            source[widthEnd] <= 57) widthEnd = widthEnd + 1
        result = source.slice(colon + 1, widthEnd)
    }
    result
}

fun registryParseAggregates(
    source: string,
    api: string,
    types: RegistryTypes
): RegistryAggregates {
    val names: array<string> = []
    val kinds: array<string> = []
    val memberOwners: array<string> = []
    val memberNames: array<string> = []
    val memberTypes: array<string> = []
    val memberPointerLevels: array<string> = []
    val memberConstness: array<string> = []
    val memberArrayShapes: array<string> = []
    val memberBitWidths: array<string> = []
    val wantedApi = if (api == "opengl") "gl" else "vulkan"
    var valid = true
    var error = ""
    val typesBegin = textFindSequence(source, "<types")
    val typesOpenEnd = if (typesBegin >= 0)
        registryOpeningTagEnd(source, typesBegin + 6) else -1
    val typesEnd = if (typesOpenEnd >= 0)
        textFindSequence(source, "</types>", typesOpenEnd + 1, source.size)
    else -1
    if (typesBegin < 0 || typesOpenEnd < 0 || typesEnd <= typesOpenEnd) {
        valid = false
        error = "registry has no complete aggregate definition section"
    }
    var cursor = typesOpenEnd + 1
    while (valid) {
        val begin = textFindSequence(source, "<type", cursor, typesEnd)
        if (begin < 0) break
        val afterName = begin + 5
        if (afterName < typesEnd && source[afterName] != 62 &&
            source[afterName] != 32 && source[afterName] != 9 &&
            source[afterName] != 10 && source[afterName] != 13) {
            cursor = afterName
            continue
        }
        val openEnd = textFindByte(source, 62, afterName, typesEnd)
        if (openEnd < 0) {
            valid = false
            error = "unterminated aggregate definition"
        } else {
            val opening = source.slice(begin, openEnd + 1)
            val selfClosing = registryTagSelfClosing(opening)
            val close = if (selfClosing) openEnd else
                registryTypeDefinitionEnd(source, openEnd + 1, typesEnd)
            if (close < 0) {
                valid = false
                error = "unterminated aggregate definition"
            } else {
                var name = registryAttribute(opening, "name")
                if (name == "" && !selfClosing) name = registryTypeBodyName(
                    source, openEnd + 1, close
                )
                val category = registryAttribute(opening, "category")
                val typeApi = registryAttribute(opening, "api")
                val selectedApi = typeApi == "" ||
                    registryTokenListContains(typeApi, wantedApi) ||
                    (api == "opengl" &&
                    registryTokenListContains(typeApi, "glcore"))
                val selected = selectedApi && !selfClosing &&
                    (category == "struct" || category == "union") &&
                    registryArrayContains(types.names, name)
                if (selected) {
                    names.append(name)
                    kinds.append(category)
                    var memberCursor = openEnd + 1
                    while (valid) {
                        val memberBegin = textFindSequence(
                            source, "<member", memberCursor, close
                        )
                        if (memberBegin < 0) break
                        val memberAfterName = memberBegin + 7
                        val memberOpenEnd = textFindByte(
                            source, 62, memberAfterName, close
                        )
                        val memberEnd = if (memberOpenEnd >= 0)
                            textFindSequence(
                                source, "</member>", memberOpenEnd + 1, close
                            )
                        else -1
                        if (memberOpenEnd < 0 || memberEnd < 0) {
                            valid = false
                            error = "unterminated aggregate member: $name"
                        } else {
                            val memberOpening = source.slice(
                                memberBegin, memberOpenEnd + 1
                            )
                            val memberApi = registryAttribute(
                                memberOpening, "api"
                            )
                            val selectedMember = memberApi == "" ||
                                registryTokenListContains(
                                    memberApi, wantedApi
                                )
                            if (selectedMember) {
                                val fieldName = registryTaggedText(
                                    source, memberOpenEnd + 1,
                                    memberEnd, "name"
                                )
                                val fieldType = registryCommandAbiType(
                                    source, memberOpenEnd + 1, memberEnd
                                )
                                if (fieldName == "" || fieldType == "") {
                                    valid = false
                                    error = "aggregate has incomplete member: $name"
                                } else {
                                    memberOwners.append(name)
                                    memberNames.append(fieldName)
                                    memberTypes.append(fieldType)
                                    memberPointerLevels.append(
                                        "${registryPointerLevel(source, memberOpenEnd + 1, memberEnd)}"
                                    )
                                    memberConstness.append(
                                        if (textFindSequence(
                                            source, "const",
                                            memberOpenEnd + 1,
                                            memberEnd
                                        ) >= 0) "true" else "false"
                                    )
                                    memberArrayShapes.append(
                                        registryMemberArrayShape(
                                            source, memberOpenEnd + 1,
                                            memberEnd
                                        )
                                    )
                                    memberBitWidths.append(
                                        registryMemberBitWidth(
                                            source, memberOpenEnd + 1,
                                            memberEnd
                                        )
                                    )
                                }
                            }
                            memberCursor = memberEnd + 9
                        }
                    }
                }
                cursor = if (selfClosing) openEnd + 1 else close + 7
            }
        }
    }
    RegistryAggregates(
        names, kinds, memberOwners, memberNames, memberTypes,
        memberPointerLevels, memberConstness, memberArrayShapes,
        memberBitWidths, valid, error
    )
}

fun registryAppendRequiredConstants(
    source: string,
    begin: int,
    end: int,
    inheritedExtensionNumber: string,
    var requested: array<string>,
    var names: array<string>,
    var values: array<string>
): string {
    var error = ""
    var cursor = begin
    while (error == "") {
        val requireBegin = textFindSequence(source, "<require", cursor, end)
        if (requireBegin < 0) break
        val afterName = requireBegin + 8
        if (afterName < end && source[afterName] != 62 &&
            source[afterName] != 32 && source[afterName] != 9 &&
            source[afterName] != 10 && source[afterName] != 13) {
            cursor = afterName
            continue
        }
        val openEnd = textFindByte(source, 62, afterName, end)
        if (openEnd < 0) error = "unterminated Vulkan requirement"
        else {
            val opening = source.slice(requireBegin, openEnd + 1)
            val requireApi = registryAttribute(opening, "api")
            val selected = requireApi == "" ||
                registryTokenListContains(requireApi, "vulkan")
            if (registryTagSelfClosing(opening)) cursor = openEnd + 1
            else {
                val close = textFindSequence(
                    source, "</require>", openEnd + 1, end
                )
                if (close < 0) error = "unterminated Vulkan requirement"
                else {
                    if (selected) {
                        var enumCursor = openEnd + 1
                        while (error == "") {
                            val enumBegin = textFindSequence(
                                source, "<enum", enumCursor, close
                            )
                            if (enumBegin < 0) break
                            val enumEnd = registryOpeningTagEnd(
                                source, enumBegin + 5
                            )
                            if (enumEnd < 0 || enumEnd >= close) {
                                error = "unterminated Vulkan enum"
                            } else {
                                val enumOpening = source.slice(
                                    enumBegin, enumEnd + 1
                                )
                                val enumApi = registryAttribute(
                                    enumOpening, "api"
                                )
                                val name = registryAttribute(
                                    enumOpening, "name"
                                )
                                val selectedEnum = (enumApi == "" ||
                                    registryTokenListContains(
                                        enumApi, "vulkan"
                                    )) && name.size > 3 &&
                                    name.slice(0, 3) == "VK_"
                                if (selectedEnum) error = registryAddConstant(
                                    name,
                                    registryVulkanConstantExpression(
                                        enumOpening,
                                        inheritedExtensionNumber
                                    ),
                                    requested,
                                    names,
                                    values
                                )
                                enumCursor = enumEnd + 1
                            }
                        }
                    }
                    cursor = close + 10
                }
            }
        }
    }
    error
}

fun registryParseConstants(source: string, api: string): RegistryConstants {
    val names: array<string> = []
    val values: array<string> = []
    val priorities: array<int> = []
    var valid = api == "vulkan" || api == "opengl"
    var error = if (valid) "" else "API must be vulkan or opengl"
    var cursor = 0
    while (valid && api == "opengl") {
        val begin = textFindSequence(source, "<enum", cursor, source.size)
        if (begin < 0) break
        cursor = begin + 5
        if (cursor < source.size && source[cursor] != 62 &&
            source[cursor] != 32 && source[cursor] != 9 &&
            source[cursor] != 10 && source[cursor] != 13) continue
        val end = registryOpeningTagEnd(source, cursor)
        if (end < 0) {
            valid = false
            error = "unterminated enum opening tag"
        } else {
            val opening = source.slice(begin, end + 1)
            val name = registryAttribute(opening, "name")
            val value = registryAttribute(opening, "value")
            val enumApi = registryAttribute(opening, "api")
            val selected = name.size > 3 && name.slice(0, 3) == "GL_" &&
                value != "" && (enumApi == "" ||
                    registryTokenListContains(enumApi, "gl") ||
                    registryTokenListContains(enumApi, "glcore"))
            val priority = if (enumApi == "") 1 else 2
            if (selected && !registryConstantValueValid(value)) {
                valid = false
                error = "unsupported OpenGL constant expression: $name=$value"
            } else if (selected) {
                val existing = registryArrayIndex(names, name)
                if (existing < 0) {
                    names.append(name)
                    values.append(value)
                    priorities.append(priority)
                } else if (priority > priorities[existing]) {
                    values[existing] = value
                    priorities[existing] = priority
                } else if (priority == priorities[existing] &&
                    values[existing] != value) {
                    valid = false
                    error = "conflicting OpenGL constant definition: $name"
                }
            }
            cursor = end + 1
        }
    }
    if (valid && api == "vulkan") {
        val requested: array<string> = []
        val firstFeature = textFindSequence(source, "<feature")
        cursor = 0
        while (valid && cursor < firstFeature) {
            val begin = textFindSequence(source, "<enum", cursor, firstFeature)
            if (begin < 0) break
            cursor = begin + 5
            if (cursor < source.size && source[cursor] != 62 &&
                source[cursor] != 32 && source[cursor] != 9 &&
                source[cursor] != 10 && source[cursor] != 13) continue
            val end = registryOpeningTagEnd(source, cursor)
            if (end < 0 || end >= firstFeature) {
                valid = false
                error = "unterminated Vulkan base enum"
            } else {
                val opening = source.slice(begin, end + 1)
                val name = registryAttribute(opening, "name")
                val enumApi = registryAttribute(opening, "api")
                val selected = name.size > 3 &&
                    name.slice(0, 3) == "VK_" &&
                    (enumApi == "" || registryTokenListContains(
                        enumApi, "vulkan"
                    ))
                if (selected) {
                    error = registryAddConstant(
                        name,
                        registryVulkanConstantExpression(opening, ""),
                        requested,
                        names,
                        values
                    )
                    if (error != "") valid = false
                }
                cursor = end + 1
            }
        }
        cursor = 0
        while (valid) {
            val begin = textFindSequence(source, "<feature", cursor, source.size)
            if (begin < 0) break
            cursor = begin + 8
            if (cursor < source.size && source[cursor] != 62 &&
                source[cursor] != 32 && source[cursor] != 9 &&
                source[cursor] != 10 && source[cursor] != 13) continue
            val openEnd = registryOpeningTagEnd(source, cursor)
            if (openEnd < 0) {
                valid = false
                error = "unterminated Vulkan feature"
            } else {
                val opening = source.slice(begin, openEnd + 1)
                val featureApi = registryAttribute(opening, "api")
                val selected = registryTokenListContains(
                    featureApi, "vulkan"
                )
                if (registryTagSelfClosing(opening)) cursor = openEnd + 1
                else {
                    val close = textFindSequence(
                        source, "</feature>", openEnd + 1, source.size
                    )
                    if (close < 0) {
                        valid = false
                        error = "unterminated Vulkan feature"
                    } else {
                        if (selected) {
                            error = registryAppendRequiredConstants(
                                source,
                                openEnd + 1,
                                close,
                                "",
                                requested,
                                names,
                                values
                            )
                            if (error != "") valid = false
                        }
                        cursor = close + 10
                    }
                }
            }
        }
        cursor = 0
        while (valid) {
            val begin = textFindSequence(
                source, "<extension", cursor, source.size
            )
            if (begin < 0) break
            cursor = begin + 10
            if (cursor < source.size && source[cursor] != 62 &&
                source[cursor] != 32 && source[cursor] != 9 &&
                source[cursor] != 10 && source[cursor] != 13) continue
            val openEnd = registryOpeningTagEnd(source, cursor)
            if (openEnd < 0) {
                valid = false
                error = "unterminated Vulkan extension"
            } else {
                val opening = source.slice(begin, openEnd + 1)
                val supported = registryAttribute(opening, "supported")
                val selected = registryTokenListContains(
                    supported, "vulkan"
                )
                val extensionNumber = registryAttribute(opening, "number")
                if (registryTagSelfClosing(opening)) cursor = openEnd + 1
                else {
                    val close = textFindSequence(
                        source, "</extension>", openEnd + 1, source.size
                    )
                    if (close < 0) {
                        valid = false
                        error = "unterminated Vulkan extension"
                    } else {
                        if (selected) {
                            error = registryAppendRequiredConstants(
                                source,
                                openEnd + 1,
                                close,
                                extensionNumber,
                                requested,
                                names,
                                values
                            )
                            if (error != "") valid = false
                        }
                        cursor = close + 12
                    }
                }
            }
        }
        var previousRequestedSize = -1
        while (valid && previousRequestedSize != requested.size) {
            previousRequestedSize = requested.size
            cursor = 0
            while (valid) {
                val begin = textFindSequence(
                    source, "<enum", cursor, source.size
                )
                if (begin < 0) break
                cursor = begin + 5
                if (cursor < source.size && source[cursor] != 62 &&
                    source[cursor] != 32 && source[cursor] != 9 &&
                    source[cursor] != 10 && source[cursor] != 13) continue
                val end = registryOpeningTagEnd(source, cursor)
                if (end < 0) {
                    valid = false
                    error = "unterminated Vulkan enum"
                } else {
                    val opening = source.slice(begin, end + 1)
                    val name = registryAttribute(opening, "name")
                    val enumApi = registryAttribute(opening, "api")
                    val selected = registryArrayContains(requested, name) &&
                        !registryArrayContains(names, name) &&
                        (enumApi == "" || registryTokenListContains(
                            enumApi, "vulkan"
                        ))
                    if (selected) {
                        error = registryAddConstant(
                            name,
                            registryVulkanConstantExpression(opening, ""),
                            requested,
                            names,
                            values
                        )
                        if (error != "") valid = false
                    }
                    cursor = end + 1
                }
            }
        }
        var requestedIndex = 0
        while (valid && requestedIndex < requested.size) {
            if (!registryArrayContains(names, requested[requestedIndex])) {
                valid = false
                error = "required Vulkan constant has no definition: ${requested[requestedIndex]}"
            }
            requestedIndex = requestedIndex + 1
        }
        if (valid) {
            error = registryResolveConstantAliases(names, values)
            if (error != "") valid = false
        }
    }
    if (valid) registrySortPaired(names, values)
    RegistryConstants(names, values, valid, error)
}

fun registryCommandName(source: string, begin: int, end: int): string {
    var result = ""
    val proto = textFindSequence(source, "<proto", begin, end)
    if (proto >= 0) {
        val protoEnd = textFindSequence(source, "</proto>", proto, end)
        if (protoEnd >= 0) {
            val nameOpen = textFindSequence(source, "<name>", proto, protoEnd)
            if (nameOpen >= 0) {
                val nameBegin = nameOpen + 6
                val nameEnd = textFindSequence(
                    source, "</name>", nameBegin, protoEnd
                )
                if (nameEnd >= 0) result = source.slice(nameBegin, nameEnd)
            }
        }
    }
    result
}

fun registryTagSelfClosing(opening: string): bool {
    var offset = opening.size - 2
    while (offset >= 0 && (opening[offset] == 32 || opening[offset] == 9 ||
        opening[offset] == 10 || opening[offset] == 13)) offset = offset - 1
    offset >= 0 && opening[offset] == 47
}

fun registryAppendRequiredCommands(
    source: string,
    begin: int,
    end: int,
    wantedApi: string,
    excludeCompatibility: bool,
    var commands: array<string>
): bool {
    var valid = true
    var cursor = begin
    while (valid) {
        val requireBegin = textFindSequence(source, "<require", cursor, end)
        if (requireBegin < 0) break
        val afterName = requireBegin + 8
        if (afterName < end && source[afterName] != 62 &&
            source[afterName] != 32 && source[afterName] != 9 &&
            source[afterName] != 10 && source[afterName] != 13) {
            cursor = afterName
            continue
        }
        val openEnd = textFindByte(source, 62, afterName, end)
        if (openEnd < 0) {
            valid = false
        } else {
            val opening = source.slice(requireBegin, openEnd + 1)
            val requireApi = registryAttribute(opening, "api")
            val profile = registryAttribute(opening, "profile")
            val selectedApi = requireApi == "" ||
                registryTokenListContains(requireApi, wantedApi)
            val selectedProfile = !excludeCompatibility ||
                profile != "compatibility"
            if (registryTagSelfClosing(opening)) {
                cursor = openEnd + 1
            } else {
                val close = textFindSequence(
                    source, "</require>", openEnd + 1, end
                )
                if (close < 0) {
                    valid = false
                } else {
                    if (selectedApi && selectedProfile) {
                        var commandCursor = openEnd + 1
                        while (commandCursor < close) {
                            val commandBegin = textFindSequence(
                                source, "<command", commandCursor, close
                            )
                            if (commandBegin < 0) break
                            val commandEnd = textFindByte(
                                source, 62, commandBegin + 8, close
                            )
                            if (commandEnd < 0) {
                                valid = false
                                commandCursor = close
                            } else {
                                val commandTag = source.slice(
                                    commandBegin, commandEnd + 1
                                )
                                val name = registryAttribute(commandTag, "name")
                                if (name != "" &&
                                    !registryArrayContains(commands, name)) {
                                    commands.append(name)
                                }
                                commandCursor = commandEnd + 1
                            }
                        }
                    }
                    cursor = close + 10
                }
            }
        }
    }
    valid
}

fun registryParse(source: string, api: string): RegistryInventory {
    val definitions: array<string> = []
    val definitionForms: array<string> = []
    val requiredCommands: array<string> = []
    val commands: array<string> = []
    val commandForms: array<string> = []
    val features: array<string> = []
    val extensions: array<string> = []
    var valid = api == "vulkan" || api == "opengl"
    var error = if (valid) "" else "API must be vulkan or opengl"
    if (valid && (
        textFindSequence(source, "<registry") < 0 ||
        textFindSequence(source, "</registry>") < 0
    )) {
        valid = false
        error = "input is not a complete Khronos registry"
    }

    val commandsBeginMarker = textFindSequence(source, "<commands")
    val commandsOpeningEnd = if (commandsBeginMarker >= 0)
        registryOpeningTagEnd(source, commandsBeginMarker)
    else -1
    val commandsEndMarker = textFindSequence(source, "</commands>")
    if (valid && (commandsBeginMarker < 0 || commandsOpeningEnd < 0 ||
        commandsEndMarker <= commandsOpeningEnd)) {
        valid = false
        error = "registry has no complete commands definition section"
    }
    var cursor = if (commandsOpeningEnd >= 0) commandsOpeningEnd + 1 else 0
    while (valid) {
        val begin = textFindSequence(
            source, "<command", cursor, commandsEndMarker
        )
        if (begin < 0) break
        cursor = begin + 8
        if (cursor < source.size && source[cursor] != 62 &&
            source[cursor] != 32 && source[cursor] != 9 &&
            source[cursor] != 10 && source[cursor] != 13) continue
        val openEnd = textFindByte(source, 62, cursor, commandsEndMarker)
        if (openEnd < 0 || openEnd >= commandsEndMarker) {
            valid = false
            error = "unterminated command opening tag"
        } else {
            val opening = source.slice(begin, openEnd + 1)
            val aliasName = registryAttribute(opening, "name")
            val aliasTarget = registryAttribute(opening, "alias")
            var name = ""
            var form = "definition"
            if (aliasName != "" && aliasTarget != "") {
                name = aliasName
                form = "alias"
                cursor = openEnd + 1
            } else {
                val close = textFindSequence(
                    source, "</command>", openEnd + 1, commandsEndMarker
                )
                if (close < 0) {
                    valid = false
                    error = "unterminated command definition"
                } else {
                    name = registryCommandName(source, openEnd + 1, close)
                    cursor = close + 10
                }
            }
            if (valid && name == "") {
                valid = false
                error = "command has no canonical name"
            }
            if (valid) {
                val existing = registryArrayIndex(definitions, name)
                if (existing < 0) {
                    definitions.append(name)
                    definitionForms.append(form)
                } else if (form == "definition") {
                    definitionForms[existing] = form
                }
            }
        }
    }

    cursor = 0
    val wantedApi = if (api == "opengl") "gl" else "vulkan"
    while (valid) {
        val begin = textFindSequence(source, "<feature", cursor, source.size)
        if (begin < 0) break
        cursor = begin + 8
        if (cursor < source.size && source[cursor] != 62 &&
            source[cursor] != 32 && source[cursor] != 9 &&
            source[cursor] != 10 && source[cursor] != 13) continue
        val openEnd = registryOpeningTagEnd(source, cursor)
        if (openEnd < 0) {
            valid = false
            error = "unterminated feature opening tag"
        } else {
            val opening = source.slice(begin, openEnd + 1)
            val featureApi = registryAttribute(opening, "api")
            val name = registryAttribute(opening, "name")
            val apiType = registryAttribute(opening, "apitype")
            val selectedApi = registryTokenListContains(featureApi, wantedApi) &&
                name != ""
            val published = selectedApi && apiType != "internal"
            if (published && !registryArrayContains(features, name)) {
                features.append(name)
            }
            if (registryTagSelfClosing(opening)) {
                cursor = openEnd + 1
            } else {
                val close = textFindSequence(
                    source, "</feature>", openEnd + 1, source.size
                )
                if (close < 0) {
                    valid = false
                    error = "unterminated core feature"
                } else {
                    if (selectedApi && !registryAppendRequiredCommands(
                        source, openEnd + 1, close, wantedApi,
                        api == "opengl", requiredCommands
                    )) {
                        valid = false
                        error = "malformed core feature requirement"
                    }
                    cursor = close + 10
                }
            }
        }
    }

    cursor = 0
    while (valid) {
        val begin = textFindSequence(source, "<extension", cursor, source.size)
        if (begin < 0) break
        cursor = begin + 10
        if (cursor < source.size && source[cursor] != 62 &&
            source[cursor] != 32 && source[cursor] != 9 &&
            source[cursor] != 10 && source[cursor] != 13) continue
        val openEnd = registryOpeningTagEnd(source, cursor)
        if (openEnd < 0) {
            valid = false
            error = "unterminated extension opening tag"
        } else {
            val opening = source.slice(begin, openEnd + 1)
            val supported = registryAttribute(opening, "supported")
            val name = registryAttribute(opening, "name")
            var selected = registryTokenListContains(supported, wantedApi)
            if (api == "opengl" &&
                registryTokenListContains(supported, "glcore")) selected = true
            if (selected && name != "" &&
                !registryArrayContains(extensions, name)) extensions.append(name)
            if (registryTagSelfClosing(opening)) {
                cursor = openEnd + 1
            } else {
                val close = textFindSequence(
                    source, "</extension>", openEnd + 1, source.size
                )
                if (close < 0) {
                    valid = false
                    error = "unterminated extension"
                } else {
                    if (selected && !registryAppendRequiredCommands(
                        source, openEnd + 1, close, wantedApi,
                        api == "opengl", requiredCommands
                    )) {
                        valid = false
                        error = "malformed extension requirement"
                    }
                    cursor = close + 12
                }
            }
        }
    }

    var requiredIndex = 0
    while (valid && requiredIndex < requiredCommands.size) {
        val name = requiredCommands[requiredIndex]
        val definition = registryArrayIndex(definitions, name)
        if (definition < 0) {
            valid = false
            error = "required command has no definition: $name"
        } else {
            commands.append(name)
            commandForms.append(definitionForms[definition])
        }
        requiredIndex = requiredIndex + 1
    }
    if (valid && (commands.size == 0 || features.size == 0)) {
        valid = false
        error = "registry contains no commands or selected core features"
    }
    if (valid) {
        registrySortPaired(commands, commandForms)
        registrySort(features)
        registrySort(extensions)
    }
    RegistryInventory(
        commands, commandForms, features, extensions, valid, error
    )
}

fun registryAppend(path: Path, batch: string, line: string): string {
    if (batch == "#write-failed") return batch
    var result = "$batch$line\n"
    if (result.size >= 16384) {
        if (!path.appendText(result)) return "#write-failed"
        result = ""
    }
    result
}

fun registryWrite(
    output: Path,
    api: string,
    revision: string,
    sha256: string,
    inventory: RegistryInventory,
    audit: RegistryAudit,
    constants: RegistryConstants,
    types: RegistryTypes,
    signatures: RegistryCommandSignatures,
    aggregates: RegistryAggregates
): bool {
    val title = if (api == "vulkan") "Vulkan" else "OpenGL"
    var success = output.writeText("")
    var batch = ""
    if (success) batch = registryAppend(output, batch, "# $title registry inventory")
    if (success) batch = registryAppend(output, batch, "")
    if (success) batch = registryAppend(output, batch, "- Revision: `$revision`")
    if (success) batch = registryAppend(output, batch, "- SHA-256: `$sha256`")
    if (success) batch = registryAppend(
        output, batch, "- Commands: ${inventory.commands.size}"
    )
    if (success) batch = registryAppend(
        output, batch, "- Core features: ${inventory.features.size}"
    )
    if (success) batch = registryAppend(
        output, batch, "- Extensions: ${inventory.extensions.size}"
    )
    if (success) batch = registryAppend(
        output, batch, "- Constants: ${constants.names.size}"
    )
    if (success) batch = registryAppend(
        output, batch, "- Types: ${types.names.size}"
    )
    if (success) batch = registryAppend(
        output,
        batch,
        "- Command parameters: ${signatures.parameterNames.size}"
    )
    if (success) batch = registryAppend(
        output, batch, "- Aggregates: ${aggregates.names.size}"
    )
    if (success) batch = registryAppend(
        output, batch, "- Aggregate members: ${aggregates.memberNames.size}"
    )
    var commandAudits = 0
    var featureAudits = 0
    var extensionAudits = 0
    var auditIndex = 0
    while (auditIndex < audit.kinds.size) {
        if (audit.kinds[auditIndex] == "command") commandAudits = commandAudits + 1
        if (audit.kinds[auditIndex] == "core-feature") featureAudits = featureAudits + 1
        if (audit.kinds[auditIndex] == "extension") extensionAudits = extensionAudits + 1
        auditIndex = auditIndex + 1
    }
    if (success) batch = registryAppend(
        output, batch, "- Classified commands: $commandAudits/${inventory.commands.size}"
    )
    if (success) batch = registryAppend(
        output, batch, "- Classified core features: $featureAudits/${inventory.features.size}"
    )
    if (success) batch = registryAppend(
        output, batch, "- Classified extensions: $extensionAudits/${inventory.extensions.size}"
    )
    if (success) batch = registryAppend(output, batch, "")
    if (success) batch = registryAppend(output, batch, "## Commands")
    if (success) batch = registryAppend(output, batch, "")
    if (success) batch = registryAppend(
        output, batch,
        "| Name | Form | Status | Loader | ABI | Positive test | Unsupported path |"
    )
    if (success) batch = registryAppend(
        output, batch, "| --- | --- | --- | --- | --- | --- | --- |"
    )
    var index = 0
    while (success && index < inventory.commands.size) {
        val found = registryAuditIndex(
            audit, "command", inventory.commands[index]
        )
        val status = if (found >= 0) audit.statuses[found] else "unclassified"
        val loader = if (found >= 0) audit.loaders[found] else "-"
        val abi = if (found >= 0) audit.abis[found] else "-"
        val positive = if (found >= 0) audit.positives[found] else "-"
        val unsupported = if (found >= 0)
            audit.unsupportedPaths[found] else "-"
        batch = registryAppend(
            output, batch,
            "| `${inventory.commands[index]}` | ${inventory.commandForms[index]} | $status | $loader | $abi | $positive | $unsupported |"
        )
        index = index + 1
    }
    if (success) batch = registryAppend(output, batch, "")
    if (success) batch = registryAppend(output, batch, "## Core features")
    if (success) batch = registryAppend(output, batch, "")
    if (success) batch = registryAppend(
        output, batch,
        "| Name | Status | Loader | ABI | Positive test | Unsupported path |"
    )
    if (success) batch = registryAppend(
        output, batch, "| --- | --- | --- | --- | --- | --- |"
    )
    index = 0
    while (success && index < inventory.features.size) {
        val found = registryAuditIndex(
            audit, "core-feature", inventory.features[index]
        )
        val status = if (found >= 0) audit.statuses[found] else "unclassified"
        val loader = if (found >= 0) audit.loaders[found] else "-"
        val abi = if (found >= 0) audit.abis[found] else "-"
        val positive = if (found >= 0) audit.positives[found] else "-"
        val unsupported = if (found >= 0)
            audit.unsupportedPaths[found] else "-"
        batch = registryAppend(
            output, batch,
            "| `${inventory.features[index]}` | $status | $loader | $abi | $positive | $unsupported |"
        )
        index = index + 1
    }
    if (success) batch = registryAppend(output, batch, "")
    if (success) batch = registryAppend(output, batch, "## Extensions")
    if (success) batch = registryAppend(output, batch, "")
    if (success) batch = registryAppend(
        output, batch,
        "| Name | Status | Loader | ABI | Positive test | Unsupported path |"
    )
    if (success) batch = registryAppend(
        output, batch, "| --- | --- | --- | --- | --- | --- |"
    )
    index = 0
    while (success && index < inventory.extensions.size) {
        val found = registryAuditIndex(
            audit, "extension", inventory.extensions[index]
        )
        val status = if (found >= 0) audit.statuses[found] else "unclassified"
        val loader = if (found >= 0) audit.loaders[found] else "-"
        val abi = if (found >= 0) audit.abis[found] else "-"
        val positive = if (found >= 0) audit.positives[found] else "-"
        val unsupported = if (found >= 0)
            audit.unsupportedPaths[found] else "-"
        batch = registryAppend(
            output, batch,
            "| `${inventory.extensions[index]}` | $status | $loader | $abi | $positive | $unsupported |"
        )
        index = index + 1
    }
    if (batch == "#write-failed") success = false
    if (success && batch != "") success = output.appendText(batch)
    success
}

fun registrySourcePrefix(api: string): string =
    if (api == "vulkan") "rawVulkanRegistry" else "rawOpenGlRegistry"

fun registryWriteSourceArray(
    output: Path,
    batch: string,
    name: string,
    values: array<string>,
    blankAfter: bool = true
): string {
    var result = registryAppend(
        output,
        batch,
        "fun $name(): array<string> = ["
    )
    var index = 0
    while (result != "#write-failed" && index < values.size) {
        val suffix = if (index + 1 < values.size) "," else ""
        result = registryAppend(
            output,
            result,
            "    \"${values[index]}\"$suffix"
        )
        index = index + 1
    }
    if (result != "#write-failed") {
        result = registryAppend(output, result, "]")
        if (blankAfter) result = registryAppend(output, result, "")
    }
    result
}

fun registryStatuses(
    audit: RegistryAudit,
    kind: string,
    names: array<string>
): array<string> {
    val statuses: array<string> = []
    var index = 0
    while (index < names.size) {
        val found = registryAuditIndex(audit, kind, names[index])
        statuses.append(
            if (found >= 0) audit.statuses[found] else "unclassified"
        )
        index = index + 1
    }
    statuses
}

fun registryCommandCallShapes(
    inventory: RegistryInventory,
    signatures: RegistryCommandSignatures
): array<string> {
    val shapes: array<string> = []
    var commandIndex = 0
    while (commandIndex < inventory.commands.size) {
        val command = inventory.commands[commandIndex]
        var shape = "${signatures.returnTypes[commandIndex]}("
        var parameterIndex = 0
        var count = 0
        while (parameterIndex < signatures.parameterOwners.size) {
            if (signatures.parameterOwners[parameterIndex] == command) {
                if (count > 0) shape = "$shape,"
                if (signatures.parameterConstness[parameterIndex] == "true") {
                    shape = "${shape}const "
                }
                shape = "$shape${signatures.parameterTypes[parameterIndex]}"
                val pointers = signatures.parameterPointerLevels[
                    parameterIndex
                ]
                if (pointers == "1") shape = "$shape*"
                else if (pointers == "2") shape = "$shape**"
                else if (pointers == "3") shape = "$shape***"
                else if (pointers != "0") shape = "$shape*[$pointers]"
                count = count + 1
            }
            parameterIndex = parameterIndex + 1
        }
        shape = "$shape)"
        shapes.append(shape)
        commandIndex = commandIndex + 1
    }
    shapes
}

fun registryCallSourcePrefix(api: string): string =
    if (api == "vulkan") "rawVulkanCall" else "rawOpenGlCall"

fun registryWriteCallSource(
    output: Path,
    api: string,
    revision: string,
    sha256: string,
    inventory: RegistryInventory,
    signatures: RegistryCommandSignatures
): bool {
    val prefix = registryCallSourcePrefix(api)
    val shapes = registryCommandCallShapes(inventory, signatures)
    var success = output.writeText("")
    var batch = ""
    if (success) batch = registryAppend(
        output,
        batch,
        "// Generated callable-command metadata. Do not edit."
    )
    if (success) batch = registryAppend(output, batch, "")
    if (success) batch = registryAppend(
        output, batch, "val ${prefix}Revision = \"$revision\""
    )
    if (success) batch = registryAppend(
        output, batch, "val ${prefix}Sha256 = \"$sha256\""
    )
    if (success) batch = registryAppend(
        output, batch, "val ${prefix}Count = ${inventory.commands.size}"
    )
    if (success) batch = registryAppend(output, batch, "")
    if (success) batch = registryWriteSourceArray(
        output, batch, "${prefix}Names", inventory.commands
    )
    if (success) batch = registryWriteSourceArray(
        output, batch, "${prefix}Shapes", shapes, false
    )
    if (batch == "#write-failed") success = false
    if (success && batch != "") success = output.appendText(batch)
    success
}

fun registryWriteSource(
    output: Path,
    api: string,
    revision: string,
    sha256: string,
    inventory: RegistryInventory,
    audit: RegistryAudit,
    constants: RegistryConstants,
    types: RegistryTypes,
    signatures: RegistryCommandSignatures,
    aggregates: RegistryAggregates
): bool {
    val prefix = registrySourcePrefix(api)
    val commandStatuses = registryStatuses(
        audit,
        "command",
        inventory.commands
    )
    val featureStatuses = registryStatuses(
        audit,
        "core-feature",
        inventory.features
    )
    val extensionStatuses = registryStatuses(
        audit,
        "extension",
        inventory.extensions
    )
    val commandCallShapes = registryCommandCallShapes(
        inventory,
        signatures
    )
    var success = output.writeText("")
    var batch = ""
    if (success) batch = registryAppend(
        output,
        batch,
        "// Generated from the pinned Khronos registry. Do not edit."
    )
    if (success) batch = registryAppend(output, batch, "")
    if (success) batch = registryAppend(
        output, batch, "val ${prefix}Revision = \"$revision\""
    )
    if (success) batch = registryAppend(
        output, batch, "val ${prefix}Sha256 = \"$sha256\""
    )
    if (success) batch = registryAppend(
        output,
        batch,
        "val ${prefix}CommandCount = ${inventory.commands.size}"
    )
    if (success) batch = registryAppend(
        output,
        batch,
        "val ${prefix}CoreFeatureCount = ${inventory.features.size}"
    )
    if (success) batch = registryAppend(
        output,
        batch,
        "val ${prefix}ExtensionCount = ${inventory.extensions.size}"
    )
    if (success) batch = registryAppend(
        output,
        batch,
        "val ${prefix}ConstantCount = ${constants.names.size}"
    )
    if (success) batch = registryAppend(
        output,
        batch,
        "val ${prefix}TypeCount = ${types.names.size}"
    )
    if (success && constants.names.size > 0) {
        batch = registryAppend(output, batch, "")
        var constantIndex = 0
        while (batch != "#write-failed" &&
            constantIndex < constants.names.size) {
            batch = registryAppend(
                output,
                batch,
                "val ${constants.names[constantIndex]} = ${constants.values[constantIndex]}"
            )
            constantIndex = constantIndex + 1
        }
    }
    if (success) batch = registryAppend(output, batch, "")
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}ConstantNames",
        constants.names
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}Types",
        types.names
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}TypeCategories",
        types.categories
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}TypeAliases",
        types.aliases
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}TypeDependencies",
        types.dependencies
    )
    if (success) batch = registryWriteSourceArray(
        output, batch, "${prefix}Aggregates", aggregates.names
    )
    if (success) batch = registryWriteSourceArray(
        output, batch, "${prefix}AggregateKinds", aggregates.kinds
    )
    if (success) batch = registryWriteSourceArray(
        output, batch, "${prefix}AggregateMemberOwners",
        aggregates.memberOwners
    )
    if (success) batch = registryWriteSourceArray(
        output, batch, "${prefix}AggregateMemberNames",
        aggregates.memberNames
    )
    if (success) batch = registryWriteSourceArray(
        output, batch, "${prefix}AggregateMemberTypes",
        aggregates.memberTypes
    )
    if (success) batch = registryWriteSourceArray(
        output, batch, "${prefix}AggregateMemberPointerLevels",
        aggregates.memberPointerLevels
    )
    if (success) batch = registryWriteSourceArray(
        output, batch, "${prefix}AggregateMemberConstness",
        aggregates.memberConstness
    )
    if (success) batch = registryWriteSourceArray(
        output, batch, "${prefix}AggregateMemberArrayShapes",
        aggregates.memberArrayShapes
    )
    if (success) batch = registryWriteSourceArray(
        output, batch, "${prefix}AggregateMemberBitWidths",
        aggregates.memberBitWidths
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}Commands",
        inventory.commands
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}CommandForms",
        inventory.commandForms
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}CommandReturnTypes",
        signatures.returnTypes
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}CommandParameterCounts",
        signatures.parameterCounts
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}CommandParameterOwners",
        signatures.parameterOwners
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}CommandParameterNames",
        signatures.parameterNames
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}CommandParameterTypes",
        signatures.parameterTypes
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}CommandParameterPointerLevels",
        signatures.parameterPointerLevels
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}CommandParameterConstness",
        signatures.parameterConstness
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}CommandCallShapes",
        commandCallShapes
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}CommandStatuses",
        commandStatuses
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}CoreFeatures",
        inventory.features
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}CoreFeatureStatuses",
        featureStatuses
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}Extensions",
        inventory.extensions
    )
    if (success) batch = registryWriteSourceArray(
        output,
        batch,
        "${prefix}ExtensionStatuses",
        extensionStatuses,
        false
    )
    if (batch == "#write-failed") success = false
    if (success && batch != "") success = output.appendText(batch)
    success
}

fun main: int {
    if (processArgumentCount() != 7 && processArgumentCount() != 8) {
        eprintln("usage: registry-generator <vulkan|opengl> <input.xml> <audit.tsv> <coverage.md> <raw.ab> <revision> <sha256> [calls.ab]")
        2
    } else {
        val api = processArgument(0)
        val input = Path(processArgument(1))
        val auditInput = Path(processArgument(2))
        val output = Path(processArgument(3))
        val sourceOutput = Path(processArgument(4))
        if (!input.exists()) {
            eprintln("registry input does not exist: ${input.text}")
            3
        } else if (!auditInput.exists()) {
            eprintln("registry audit does not exist: ${auditInput.text}")
            3
        } else {
            val inventory = registryParse(input.readText(), api)
            val audit = registryParseAudit(auditInput.readText())
            val constants = registryParseConstants(input.readText(), api)
            val types = registryParseTypes(input.readText(), api, inventory)
            val signatures = registryParseCommandSignatures(
                input.readText(), inventory
            )
            val aggregates = registryParseAggregates(
                input.readText(), api, types
            )
            if (!inventory.valid) {
                eprintln("registry parse failed: ${inventory.error}")
                4
            } else if (!audit.valid) {
                eprintln("registry audit failed: ${audit.error}")
                4
            } else if (!constants.valid) {
                eprintln("registry constants failed: ${constants.error}")
                4
            } else if (!types.valid) {
                eprintln("registry types failed: ${types.error}")
                4
            } else if (!signatures.valid) {
                eprintln("registry command signatures failed: ${signatures.error}")
                4
            } else if (!aggregates.valid) {
                eprintln("registry aggregates failed: ${aggregates.error}")
                4
            } else if (registryAuditValidate(audit, inventory) != "") {
                eprintln("registry audit failed: ${registryAuditValidate(audit, inventory)}")
                4
            } else if (!registryWrite(
                output, api, processArgument(5), processArgument(6), inventory,
                audit, constants, types, signatures, aggregates
            )) {
                eprintln("failed to write registry inventory: ${output.text}")
                5
            } else if (!registryWriteSource(
                sourceOutput,
                api,
                processArgument(5),
                processArgument(6),
                inventory,
                audit,
                constants,
                types,
                signatures,
                aggregates
            )) {
                eprintln("failed to write raw registry source: ${sourceOutput.text}")
                5
            } else if (processArgumentCount() == 8 &&
                !registryWriteCallSource(
                    Path(processArgument(7)),
                    api,
                    processArgument(5),
                    processArgument(6),
                    inventory,
                    signatures
                )) {
                eprintln("failed to write callable registry source: ${processArgument(7)}")
                5
            } else {
                println("$api: ${inventory.commands.size} commands, ${inventory.features.size} core features, ${inventory.extensions.size} extensions")
                0
            }
        }
    }
}
