import "abla/io"
import "abla/process/arguments"
import "abla/runtime/memory"
import "../../src/graphics.ab"

trusted fun main: int {
    val requested = if (processArgumentCount() > 0)
        processArgument(0)
    else "vulkan"
    val backend = if (requested == "opengl")
        graphicsBackendOpenGl
    else graphicsBackendVulkan
    val app = graphicsApplication(
        GraphicsConfig(backend = backend, validation = true),
        WindowConfig(
            title = "Abla Graphics recorded texture subpasses",
            width = 480,
            height = 270
        )
    )
    val colorDescriptor = TextureDescriptor(
        size = Extent3D(64, 64), format = textureFormatRgba8Unorm,
        usage = textureUsageRenderAttachment | textureUsageCopySource
    )
    val depthDescriptor = TextureDescriptor(
        size = Extent3D(64, 64), format = textureFormatDepth32Float,
        usage = textureUsageRenderAttachment
    )
    val sampledDescriptor = TextureDescriptor(
        size = Extent3D(1, 1), format = textureFormatRgba8Unorm,
        usage = textureUsageSampled | textureUsageCopyDestination
    )
    val graph = app.materializeRenderGraphResources([
        GraphicsGraphResource(0, "subpass-color", false, 0, 10),
        GraphicsGraphResource(1, "subpass-depth", false, 0, 11),
        GraphicsGraphResource(2, "first-atlas", false, 0, 12),
        GraphicsGraphResource(3, "second-atlas", false, 0, 13)
    ], [
        GraphicsGraphPass(10, "recorded-texture-subpasses", [
            GraphicsGraphUse(0, graphAccessWrite),
            GraphicsGraphUse(1, graphAccessWrite),
            GraphicsGraphUse(2, graphAccessRead),
            GraphicsGraphUse(3, graphAccessRead)
        ])
    ], [
        GraphicsGraphTextureDeclaration(0, colorDescriptor),
        GraphicsGraphTextureDeclaration(1, depthDescriptor),
        GraphicsGraphTextureDeclaration(2, sampledDescriptor),
        GraphicsGraphTextureDeclaration(3, sampledDescriptor)
    ], [])
    val shader = $glsl {
        vertex {
            #version 450
            layout(location = 0) out vec2 texCoord;
            const vec2 positions[3] = vec2[3](
                vec2(-0.75, -0.65), vec2(0.75, -0.65),
                vec2(0.0, 0.75)
            );
            const vec2 texCoords[3] = vec2[3](
                vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.0, 1.0)
            );
            void main() {
                gl_Position = vec4(
                    positions[gl_VertexID], 0.0, 1.0
                );
                texCoord = texCoords[gl_VertexID];
            }
        }
        fragment {
            #version 450
            layout(location = 0) in vec2 texCoord;
            layout(location = 0) out vec4 color;
            layout(binding = 0) uniform sampler2D atlas;
            void main() { color = texture(atlas, texCoord); }
        }
    }
    val target = app.renderTargetWithDepth(
        app.texture(colorDescriptor), app.texture(depthDescriptor)
    )
    val pass = app.renderPass(
        target,
        renderPassClearValues(Color(0.0, 0.0, 0.0), [], 1.0),
        RenderPassOperations(), 2
    )
    val firstTexture = app.texture(sampledDescriptor)
    val secondTexture = app.texture(sampledDescriptor)
    val firstPixels = pixelBuffer(1, 1)
    val secondPixels = pixelBuffer(1, 1)
    val uploaded = firstPixels.setRgba8(0, 0, 255, 0, 0) &&
        secondPixels.setRgba8(0, 0, 31, 138, 245) &&
        firstTexture.writePixels(firstPixels, TextureWriteDescriptor()) &&
        secondTexture.writePixels(secondPixels, TextureWriteDescriptor())
    val firstSampler = app.sampler(SamplerDescriptor())
    val secondSampler = app.sampler(SamplerDescriptor())
    val firstBinding = app.bindGroup([
        app.sampledTextureEntry(
            0, shaderVisibilityFragment, firstTexture, firstSampler
        )
    ])
    val secondBinding = app.bindGroup([
        app.sampledTextureEntry(
            0, shaderVisibilityFragment, secondTexture, secondSampler
        )
    ])
    val first = app.renderPassPipeline(
        target, pass, 0, shader,
        VertexBufferLayout(), RasterPipelineState(),
        DepthStencilState(
            enabled = true, write = true, compare = compareFunctionNever
        ), move(firstBinding)
    )
    val second = app.renderPassPipeline(
        target, pass, 1, shader,
        VertexBufferLayout(), RasterPipelineState(),
        DepthStencilState(
            enabled = true, write = false, compare = compareFunctionAlways
        ), move(secondBinding)
    )
    val sequence = app.subpassPipelines(
        target, pass, [move(first), move(second)]
    )
    val resources = graphSubpassTextureResources(
        [2, 3], [move(firstTexture), move(secondTexture)],
        [move(firstSampler), move(secondSampler)], [[0], [1]]
    )
    val commands = app.graphCommandList(graph, 2)
    var succeeded = app.valid() && graph.valid() && shader.valid &&
        target.valid() && pass.valid() && sequence.valid() && uploaded &&
        resources.validFor(graph, 10, sequence, app.backend) &&
        commands.valid() && commands.recordPass(graph, 10) &&
        commands.recordRenderBindingSubpasses(
            graph, [0], [], 1,
            move(target), move(pass), move(sequence), move(resources)
        ) && commands.seal(graph)
    val liveBefore = runtimeMemoryLiveBytes()
    var iteration = 0
    while (succeeded && iteration < 1001) {
        succeeded = app.executeGraphCommands(graph, commands)
        iteration = iteration + 1
    }
    val liveAfter = runtimeMemoryLiveBytes()
    val exact = commands.subpassTargets[0].texture.rgba8(32, 32) ==
        4294281759
    val stable = succeeded && iteration == 1001 && exact &&
        liveAfter == liveBefore && commands.executions == 1001 &&
        graph.completedExecutions == 1001 &&
        commands.vulkanSubmissions ==
            (if (app.backend == graphicsBackendVulkan) 1001 else 0)
    println(
        "recorded-graph-texture-subpasses ${graphicsBackendName(app.backend)}: stages=${commands.subpassSequences[0].pipelines.size} textures=${commands.subpassBufferResources[0].textures.size} exact=$exact executions=${commands.executions}/${graph.completedExecutions} submissions=${commands.vulkanSubmissions} live=${liveAfter - liveBefore} stable=$stable"
    )
    if (stable) 0 else 1
}
