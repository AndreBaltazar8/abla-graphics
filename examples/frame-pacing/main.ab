import "abla/io"
import "abla/runtime/memory"
import "../../src/graphics.ab"

fun main: int {
    val pacer = graphicsFramePacer(240)
    val started = graphicsMonotonicNanoseconds()
    val baseline = runtimeMemoryLiveBytes()
    var paced = pacer.valid()
    var frame = 0
    while (paced && frame < 4) {
        paced = pacer.wait()
        frame = frame + 1
    }
    val liveAfterFrames = runtimeMemoryLiveBytes()
    val elapsed = graphicsMonotonicNanoseconds() - started
    println(
        "Frame pacing: frames=$frame elapsedNs=$elapsed liveBytes=$liveAfterFrames"
    )
    if (paced && frame == 4 && elapsed > 0 &&
        liveAfterFrames == baseline) 0 else 1
}
