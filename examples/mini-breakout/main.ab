import "abla/io"
import "abla/process/arguments"
import "abla/runtime/memory"
import "../../src/graphics.ab"

val breakoutWidth = 160
val breakoutHeight = 100
val breakoutScale = 256
val breakoutBrickColumns = 6
val breakoutBrickRows = 4
val breakoutBrickCount = breakoutBrickColumns * breakoutBrickRows
val breakoutAllBricks = (1 << breakoutBrickCount) - 1

class MiniBreakout(
    var paddleX: int = 68,
    var ballX: int = 80 * breakoutScale,
    var ballY: int = 78 * breakoutScale,
    var velocityX: int = 245,
    var velocityY: int = -205,
    var bricks: int = breakoutAllBricks,
    var score: int = 0,
    var lives: int = 3,
    var won: bool = false,
    var lost: bool = false
) {
    fun resetBall(): void {
        this.paddleX = 68
        this.ballX = 80 * breakoutScale
        this.ballY = 78 * breakoutScale
        this.velocityX = if ((this.lives & 1) == 0) -245 else 245
        this.velocityY = -205
        return
    }

    fun reset(): void {
        this.bricks = breakoutAllBricks
        this.score = 0
        this.lives = 3
        this.won = false
        this.lost = false
        this.resetBall()
        return
    }

    fun movePaddle(direction: int): void {
        this.paddleX = this.paddleX + direction * 2
        if (this.paddleX < 3) this.paddleX = 3
        if (this.paddleX > breakoutWidth - 27) {
            this.paddleX = breakoutWidth - 27
        }
        return
    }

    fun update(): void {
        if (!this.won && !this.lost) {
            var nextX = this.ballX + this.velocityX
            var nextY = this.ballY + this.velocityY
            val radius = 2 * breakoutScale
            if (nextX - radius < 3 * breakoutScale) {
                nextX = 3 * breakoutScale + radius
                this.velocityX = -this.velocityX
            } else if (nextX + radius >= 157 * breakoutScale) {
                nextX = 157 * breakoutScale - radius
                this.velocityX = -this.velocityX
            }
            if (nextY - radius < 9 * breakoutScale) {
                nextY = 9 * breakoutScale + radius
                this.velocityY = -this.velocityY
            }

            val ballPixelX = nextX / breakoutScale
            val ballPixelY = nextY / breakoutScale
            if (this.velocityY > 0 && ballPixelY + 2 >= 89 &&
                ballPixelY - 2 <= 92 &&
                ballPixelX + 2 >= this.paddleX &&
                ballPixelX - 2 < this.paddleX + 24) {
                nextY = 87 * breakoutScale
                this.velocityY = -this.velocityY
                this.velocityX = this.velocityX +
                    (ballPixelX - (this.paddleX + 12)) * 12
                if (this.velocityX < -360) this.velocityX = -360
                if (this.velocityX > 360) this.velocityX = 360
            }

            var brick = 0
            var hit = false
            while (!hit && brick < breakoutBrickCount) {
                if ((this.bricks & (1 << brick)) != 0) {
                    val row = brick / breakoutBrickColumns
                    val column = brick - row * breakoutBrickColumns
                    val brickX = 8 + column * 24
                    val brickY = 15 + row * 11
                    if (ballPixelX + 2 >= brickX &&
                        ballPixelX - 2 < brickX + 20 &&
                        ballPixelY + 2 >= brickY &&
                        ballPixelY - 2 < brickY + 7) {
                        this.bricks = this.bricks & ~(1 << brick)
                        this.score = this.score + 100
                        this.velocityY = -this.velocityY
                        hit = true
                    }
                }
                brick = brick + 1
            }
            this.ballX = nextX
            this.ballY = nextY
            if (this.bricks == 0) this.won = true
            if (this.ballY / breakoutScale > breakoutHeight + 3) {
                this.lives = this.lives - 1
                if (this.lives <= 0) this.lost = true
                else this.resetBall()
            }
        }
        return
    }
}

fun miniBreakoutSimulationChecks(): bool {
    val game = MiniBreakout()
    game.bricks = 1
    game.ballX = 18 * breakoutScale
    game.ballY = 18 * breakoutScale
    game.velocityX = 0
    game.velocityY = 0
    game.update()
    val won = game.won && game.bricks == 0 && game.score == 100
    game.reset()
    game.lives = 1
    game.ballY = 104 * breakoutScale
    game.velocityY = 1
    game.update()
    val lost = game.lost && game.lives == 0
    game.reset()
    won && lost && game.bricks == breakoutAllBricks &&
        game.score == 0 && game.lives == 3 && !game.won && !game.lost
}

trusted fun drawMiniBreakout(
    var pixels: PixelBuffer,
    game: MiniBreakout
): bool {
    var drawn = pixels.clearRgba8(7, 11, 24) &&
        pixels.strokeRectRgba8(
            2, 8, breakoutWidth - 4, breakoutHeight - 10,
            1, 64, 82, 116
        ) &&
        pixels.drawLineRgba8(3, 10, breakoutWidth - 4, 10, 31, 211, 191)
    var brick = 0
    while (drawn && brick < breakoutBrickCount) {
        if ((game.bricks & (1 << brick)) != 0) {
            val row = brick / breakoutBrickColumns
            val column = brick - row * breakoutBrickColumns
            val red = if (row == 0) 244 else if (row == 1) 255 else
                if (row == 2) 80 else 93
            val green = if (row == 0) 91 else if (row == 1) 188 else
                if (row == 2) 201 else 132
            val blue = if (row == 0) 105 else if (row == 1) 82 else
                if (row == 2) 178 else 255
            drawn = pixels.fillClippedRectRgba8(
                8 + column * 24,
                15 + row * 11,
                20,
                7,
                red,
                green,
                blue
            )
        }
        brick = brick + 1
    }
    if (drawn) drawn = pixels.fillClippedRectRgba8(
        game.paddleX, 89, 24, 4, 229, 235, 245
    )
    if (drawn) drawn = pixels.fillCircleRgba8(
        game.ballX / breakoutScale,
        game.ballY / breakoutScale,
        2,
        255,
        226,
        92
    )
    var life = 0
    while (drawn && life < game.lives) {
        drawn = pixels.fillCircleRgba8(
            7 + life * 7, 5, 2, 255, 112, 128
        )
        life = life + 1
    }
    val cleared = breakoutBrickCount - game.score / 100
    var scoreMark = 0
    while (drawn && scoreMark < cleared) {
        drawn = pixels.fillClippedRectRgba8(
            breakoutWidth - 6 - scoreMark * 3,
            3,
            2,
            4,
            255,
            211,
            91
        )
        scoreMark = scoreMark + 1
    }
    if (drawn && game.won) drawn =
        pixels.strokeRectRgba8(45, 58, 70, 25, 3, 62, 230, 154) &&
        pixels.drawLineRgba8(50, 77, 67, 65, 62, 230, 154) &&
        pixels.drawLineRgba8(67, 65, 108, 78, 62, 230, 154)
    if (drawn && game.lost) drawn =
        pixels.strokeRectRgba8(45, 58, 70, 25, 3, 247, 92, 111) &&
        pixels.drawLineRgba8(52, 64, 108, 78, 247, 92, 111) &&
        pixels.drawLineRgba8(108, 64, 52, 78, 247, 92, 111)
    drawn
}

trusted fun main: int {
    val requested = if (processArgumentCount() > 0)
        processArgument(0) else "auto"
    val backend = if (requested == "opengl") graphicsBackendOpenGl else
        if (requested == "vulkan") graphicsBackendVulkan else
        graphicsBackendAuto
    val interactive = processArgumentCount() == 0 ||
        (processArgumentCount() > 1 && processArgument(1) == "play")
    val app = graphicsApplication(
        GraphicsConfig(backend = backend),
        WindowConfig(
            title = "Abla Mini Breakout — arrows/A/D, Space resets",
            width = breakoutWidth,
            height = breakoutHeight,
            resizable = false
        )
    )
    val pixels = pixelBuffer(breakoutWidth, breakoutHeight)
    val game = MiniBreakout()
    val pacer = graphicsFramePacer(60)
    val simulationChecks = miniBreakoutSimulationChecks()
    var running = app.valid() && pixels.valid() && pacer.valid() &&
        simulationChecks
    var left = false
    var right = false
    var frame = 0

    // Warm both presentation slots before measuring steady-state frames.
    while (running && frame < 3) {
        game.movePaddle(if (game.ballX / breakoutScale < game.paddleX + 12)
            -1 else 1)
        game.update()
        running = drawMiniBreakout(pixels, game) && app.presentPixels(pixels)
        frame = frame + 1
    }
    val measuredStart = graphicsMonotonicNanoseconds()
    val liveBefore = runtimeMemoryLiveBytes()
    var measuredFrames = 0
    while (running && (interactive || measuredFrames < 1001)) {
        if (interactive) {
            var event = app.pollEvent(0)
            while (event.happened()) {
                if (event.kind == windowEventCloseRequested ||
                    (event.kind == windowEventKey &&
                     event.key() == keyEscape && event.keyPressed())) {
                    running = false
                } else if (event.kind == windowEventKey) {
                    if (event.key() == keyLeft || event.key() == keyA) {
                        left = event.keyPressed()
                    } else if (event.key() == keyRight || event.key() == keyD) {
                        right = event.keyPressed()
                    } else if ((event.key() == keySpace ||
                        event.key() == keyEnter) && event.keyPressed()) {
                        game.reset()
                    }
                }
                event = app.pollEvent(0)
            }
            if (left && !right) game.movePaddle(-1)
            if (right && !left) game.movePaddle(1)
        } else {
            if (game.won || game.lost) game.reset()
            game.movePaddle(
                if (game.ballX / breakoutScale < game.paddleX + 12) -1 else 1
            )
        }
        if (running) game.update()
        if (running) running =
            drawMiniBreakout(pixels, game) && app.presentPixels(pixels)
        if (running && interactive) running = pacer.wait()
        measuredFrames = measuredFrames + 1
    }
    val liveAfter = runtimeMemoryLiveBytes()
    val elapsed = graphicsMonotonicNanoseconds() - measuredStart
    val noGrowth = !interactive && liveAfter == liveBefore
    val framesPerSecond = if (elapsed > 0)
        measuredFrames * graphicsNanosecondsPerSecond / elapsed else 0
    if (!interactive) println(
        "Mini Breakout ${graphicsBackendName(app.backend)}: frames=$measuredFrames score=${game.score} lives=${game.lives} fps=$framesPerSecond repeatNoGrowth=$noGrowth liveDelta=${liveAfter - liveBefore} simulationChecks=$simulationChecks on ${app.adapterName}"
    )
    if (running && (interactive ||
        (measuredFrames == 1001 && noGrowth && simulationChecks))) 0 else 1
}
