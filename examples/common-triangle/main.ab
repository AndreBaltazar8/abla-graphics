import "abla/io"
import "abla/process/arguments"
import "abla/runtime/memory"
import "../../src/graphics.ab"

fun main: int {
    val requested = if (processArgumentCount() > 0)
        processArgument(0)
    else "auto"
    val backend = if (requested == "opengl")
        graphicsBackendOpenGl
    else if (requested == "vulkan") graphicsBackendVulkan
    else graphicsBackendAuto
    val app = graphicsApplication(
        GraphicsConfig(backend = backend, framesInFlight = 2),
        WindowConfig(
            title = "Abla Graphics common triangle",
            width = 800,
            height = 600
        )
    )
    val shader = $glsl {
        vertex {
            #version 450
            layout(location = 0) in vec2 position;
            void main() {
                gl_Position = vec4(position, 0.0, 1.0);
            }
        }
        fragment {
            #version 450
            layout(location = 0) out vec4 color;
            void main() {
                color = vec4(0.12, 0.54, 0.96, 1.0);
            }
        }
    }
    val vertexBytes = bufferBytes(24)
    val verticesStored =
        vertexBytes.storeF32(-0.75, 0) &&
        vertexBytes.storeF32(-0.65, 4) &&
        vertexBytes.storeF32(0.75, 8) &&
        vertexBytes.storeF32(-0.65, 12) &&
        vertexBytes.storeF32(0.0, 16) &&
        vertexBytes.storeF32(0.75, 20)
    val vertices = app.buffer(BufferDescriptor(
        label = "triangle-positions",
        size = 24,
        usage = bufferUsageVertex | bufferUsageCopyDestination
    ))
    val verticesUploaded = verticesStored &&
        vertices.writeAllBytes(vertexBytes)
    val pipeline = app.renderPipeline(shader, VertexBufferLayout(8))
    val clear = Color(0.02, 0.03, 0.05)
    val warmed = app.valid() && pipeline.valid() && vertices.valid() &&
        verticesUploaded &&
        app.presentRenderVertices(pipeline, vertices, 3, clear)
    val openGlProgram = pipeline.openGl.handle
    val openGlArray = pipeline.openGl.vertexArray
    val openGlVertexBuffer = vertices.openGl.handle
    val vulkanPipeline = pipeline.vulkan.handle
    val vulkanRenderPass = pipeline.vulkan.renderPass
    val vulkanVertexBuffer = vertices.vulkan.handle
    val vulkanFramebuffer = if (
        app.backend == graphicsBackendVulkan &&
        pipeline.vulkan.framebuffers.size > 0
    ) pipeline.vulkan.framebuffers[0] else 0
    val commandPool = if (app.backend == graphicsBackendVulkan)
        app.vulkanPixels.frames[0].commandPool else 0
    val command = if (app.backend == graphicsBackendVulkan)
        nativePointerAddress(app.vulkanPixels.frames[0].command.load())
    else 0
    val liveBefore = runtimeMemoryLiveBytes()
    var presented = warmed
    var frame = 0
    while (presented && frame < 4) {
        presented = app.presentRenderVertices(
            pipeline,
            vertices,
            3,
            clear
        )
        frame = frame + 1
    }
    val liveAfter = runtimeMemoryLiveBytes()
    val noGrowth = liveAfter == liveBefore
    val handlesStable = if (app.backend == graphicsBackendOpenGl)
        pipeline.openGl.handle == openGlProgram &&
            pipeline.openGl.vertexArray == openGlArray &&
            vertices.openGl.handle == openGlVertexBuffer
    else pipeline.vulkan.handle == vulkanPipeline &&
        pipeline.vulkan.renderPass == vulkanRenderPass &&
        vertices.vulkan.handle == vulkanVertexBuffer &&
        pipeline.vulkan.framebuffers[0] == vulkanFramebuffer &&
        app.vulkanPixels.frames[0].commandPool == commandPool &&
        nativePointerAddress(app.vulkanPixels.frames[0].command.load()) ==
            command
    println(
        "Common triangle ${graphicsBackendName(app.backend)}: frames=$frame, repeatNoGrowth=$noGrowth, handlesStable=$handlesStable, liveDelta=${liveAfter - liveBefore} on ${app.adapterName}"
    )
    app.pollEvent(250)
    if (presented && frame == 4 && noGrowth && handlesStable) 0 else 1
}
