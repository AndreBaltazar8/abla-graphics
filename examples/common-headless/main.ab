import "../../src/graphics.ab"
import "abla/io"

fun probeHeadless(backend: int): bool {
    val app = graphicsHeadlessApplication(
        GraphicsConfig(backend = backend),
        64,
        64
    )
    val passed = app.valid() && app.probe()
    println(
        "Headless ${graphicsBackendName(app.backend)}: ${app.adapterName}"
    )
    passed
}

fun main: int = if (
    probeHeadless(graphicsBackendOpenGl) &&
    probeHeadless(graphicsBackendVulkan)
) 0 else 1
