import "../../src/graphics.ab"
import "abla/io"

fun main: int {
    val window = waylandXdgWindow(
        "Abla Graphics Wayland window",
        "io.abla.graphics.wayland-window",
        640,
        480
    )
    if (window.valid()) {
        val idleInhibitAvailable = window.idleInhibitAvailable()
        val tearingAvailable = window.tearingControlAvailable()
        val contentTypeAvailable = window.contentTypeAvailable()
        val presentationAvailable = window.presentationTimingAvailable()
        val decorationAvailable = window.connection.global(
            "zxdg_decoration_manager_v1"
        ).valid
        val decorationEnabled = decorationAvailable &&
            window.enableDecorations()
        val viewportAvailable = window.connection.global(
            "wp_viewporter"
        ).valid
        val viewportEnabled = if (viewportAvailable)
            window.enableViewport()
        else false
        val viewportConfigured = viewportEnabled &&
            window.setPreferredViewportDestination() && window.commit()
        println(
            "wayland-window: configured=${window.configured} size=${window.width}x${window.height} bufferState=${window.bufferScale}/${window.bufferTransform} preferred=${window.preferredBufferScale}/${window.preferredBufferTransform} regions=${window.opaqueRegionSet}/${window.inputRegionMode} tearing=$tearingAvailable contentType=$contentTypeAvailable timing=$presentationAvailable idle=$idleInhibitAvailable decoration=$decorationAvailable/$decorationEnabled/${window.decorationMode} viewport=$viewportAvailable/$viewportEnabled/$viewportConfigured"
        )
    }
    if (window.valid()) 0 else 1
}
