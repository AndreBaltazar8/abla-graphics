import "../../src/graphics.ab"
import "abla/io"

fun main: int {
    val window = waylandXdgWindow(
        "Abla Graphics Wayland window",
        "io.abla.graphics.wayland-window",
        640,
        480
    )
    if (window.valid()) {
        val viewportAvailable = window.connection.global(
            "wp_viewporter"
        ).valid
        val viewportEnabled = if (viewportAvailable)
            window.enableViewport()
        else false
        val viewportConfigured = viewportEnabled &&
            window.setPreferredViewportDestination() && window.commit()
        println(
            "wayland-window: configured=${window.configured} size=${window.width}x${window.height} viewport=$viewportAvailable/$viewportEnabled/$viewportConfigured"
        )
    }
    if (window.valid()) 0 else 1
}
