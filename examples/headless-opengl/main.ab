import "abla/io"
import "../../src/driver/opengl.ab"

fun main: int {
    val context = openGlHeadlessContext(256, 256)
    val version = context.version()
    println(
        "OpenGL ${version / 1000}.${version - version / 1000 * 1000}"
    )
    val pixel = context.clearBlackAndReadRgba8()
    if (context.valid() && version >= 3003 && pixel == 0) 0 else 1
}
