import "abla/io"
import "abla/process/arguments"
import "abla/runtime/memory"
import "../../src/raw/opengl.ab"
import "../../src/raw/vulkan.ab"

trusted fun main: int {
    val requested = if (processArgumentCount() > 0)
        processArgument(0) else "auto"
    val backend = if (requested == "opengl") graphicsBackendOpenGl else
        if (requested == "vulkan") graphicsBackendVulkan else
        graphicsBackendAuto
    val app = graphicsApplication(
        GraphicsConfig(backend = backend, validation = true),
        WindowConfig(
            title = "Abla Graphics raw command addresses",
            width = 160,
            height = 120,
            visible = false
        )
    )
    var stable = false
    var detail = "unavailable"
    if (app.valid() && app.backend == graphicsBackendOpenGl) {
        val raw = app.rawOpenGlApi()
        val finish = raw.command("glFinish")
        val clear = raw.command("glClear")
        val enable = raw.command("glEnable")
        val disable = raw.command("glDisable")
        val pixelStore = raw.command("glPixelStorei")
        val missing = raw.command("glAblaMissing")
        val unsupportedRejected = !raw.callVoid0(clear) &&
            !raw.callVoidI32(finish, 0) &&
            !raw.callVoidI32I32(enable, 0, 0) &&
            !raw.callVoid0(missing)
        val scissorWasEnabled = glIsEnabled(3089) != 0
        val packAlignment = nativeI64Cell(0)
        glGetIntegerv(3333, packAlignment.address)
        val originalPackAlignment = packAlignment.load()
        val liveBefore = runtimeMemoryLiveBytes()
        var call = 0
        var called = true
        while (called && call < 1000) {
            called = raw.callVoid0(finish) &&
                raw.callVoidI32(enable, 3089) &&
                glIsEnabled(3089) != 0 &&
                raw.callVoidI32(disable, 3089) &&
                glIsEnabled(3089) == 0 &&
                raw.callVoidI32I32(pixelStore, 3333, 1)
            if (called) glGetIntegerv(3333, packAlignment.address)
            called = called && packAlignment.load() == 1 &&
                raw.callVoidI32I32(pixelStore, 3333, 4)
            if (called) glGetIntegerv(3333, packAlignment.address)
            called = called && packAlignment.load() == 4
            call = call + 1
        }
        val liveAfter = runtimeMemoryLiveBytes()
        if (scissorWasEnabled) raw.callVoidI32(enable, 3089)
        else raw.callVoidI32(disable, 3089)
        val restored = raw.callVoidI32I32(
            pixelStore,
            3333,
            originalPackAlignment
        )
        glGetIntegerv(3333, packAlignment.address)
        stable = raw.available && finish.valid() &&
            finish.callShape == "void()" && finish.callAbi == "void()" &&
            clear.callShape == "void(GLbitfield)" &&
            clear.callAbi == "void(i32)" &&
            enable.callAbi == "void(i32)" &&
            disable.callAbi == "void(i32)" &&
            pixelStore.callShape == "void(GLenum,GLint)" &&
            pixelStore.callAbi == "void(i32,i32)" &&
            !missing.valid() && missing.callShape == "" &&
            missing.callAbi == "unsupported" &&
            unsupportedRejected && called && call == 1000 &&
            restored && packAlignment.load() == originalPackAlignment &&
            liveAfter == liveBefore
        detail = "finish=${finish.address} calls=$call pack=$originalPackAlignment live=${liveAfter - liveBefore}"
    } else if (app.valid() && app.backend == graphicsBackendVulkan) {
        val raw = app.rawVulkanApi()
        val enumerate = raw.instanceCommand("vkEnumeratePhysicalDevices")
        val idle = raw.deviceCommand("vkDeviceWaitIdle")
        val setDeviceMask = raw.deviceCommand("vkCmdSetDeviceMask")
        val endRendering = raw.deviceCommand("vkCmdEndRendering")
        val setStencilReference = raw.deviceCommand(
            "vkCmdSetStencilReference"
        )
        val createEvent = raw.deviceCommand("vkCreateEvent")
        val destroyEvent = raw.deviceCommand("vkDestroyEvent")
        val getEventStatus = raw.deviceCommand("vkGetEventStatus")
        val getFeatures2 = raw.instanceCommand(
            "vkGetPhysicalDeviceFeatures2"
        )
        val missing = raw.deviceCommand("vkAblaMissing")
        val command = app.vulkanPixels.frames[0].command.load()
        val idleStatus = nativeI64Cell(-1)
        val eventHandle = nativeI64Cell(0)
        val eventStatus = nativeI64Cell(-1)
        val eventInfo = nativeByteBuffer(24)
        val features2 = nativeByteBuffer(240)
        var initialize = 0
        while (initialize < eventInfo.capacity) {
            eventInfo.store(initialize, 0)
            initialize = initialize + 1
        }
        initialize = 0
        while (initialize < features2.capacity) {
            features2.store(initialize, 0)
            initialize = initialize + 1
        }
        eventInfo.storeI64(0, 10)
        eventInfo.storePointer(8, nativeNullPointer())
        eventInfo.storeI64(16, 0)
        features2.storeI64(0, 1000059000)
        features2.storePointer(8, nativeNullPointer())
        var recorded = raw.available && !pointerIsNull(command) &&
            !app.vulkanPixels.frames[0].inFlight &&
            vkQueueWaitIdle(app.vulkanDevice.queue) == vulkanSuccess &&
            vkResetCommandPool(
                app.vulkanDevice.handle,
                app.vulkanPixels.frames[0].commandPool,
                0
            ) == vulkanSuccess
        if (recorded) {
            app.vulkanPixels.frames[0].scratch.storeI64(0, 42)
            app.vulkanPixels.frames[0].scratch.storePointer(
                8, nativeNullPointer()
            )
            app.vulkanPixels.frames[0].scratch.storeI64(16, 1)
            app.vulkanPixels.frames[0].scratch.storePointer(
                24, nativeNullPointer()
            )
            recorded = vkBeginCommandBuffer(
                command,
                app.vulkanPixels.frames[0].scratch.address
            ) == vulkanSuccess
        }
        if (recorded) {
            // Empty dynamic rendering is legal and gives the pointer-only
            // raw family a real paired begin/end operation.
            app.vulkanPixels.frames[0].scratch.storeI64(96, 1000044000)
            app.vulkanPixels.frames[0].scratch.storePointer(
                104, nativeNullPointer()
            )
            app.vulkanPixels.frames[0].scratch.storeI64(112, 0)
            app.vulkanPixels.frames[0].scratch.storeI64(
                120, 4294967296
            )
            app.vulkanPixels.frames[0].scratch.storeI64(
                128, 4294967297
            )
            app.vulkanPixels.frames[0].scratch.storeI64(136, 0)
            app.vulkanPixels.frames[0].scratch.storePointer(
                144, nativeNullPointer()
            )
            app.vulkanPixels.frames[0].scratch.storePointer(
                152, nativeNullPointer()
            )
            app.vulkanPixels.frames[0].scratch.storePointer(
                160, nativeNullPointer()
            )
            vkCmdBeginRendering(
                command,
                app.vulkanPixels.frames[0].scratch.pointerAt(96)
            )
            recorded = raw.callVoidPointer(endRendering, command)
        }
        val unsupportedRejected =
            !raw.callVoidPointerI32(idle, command, 1) &&
            !raw.callVoidPointerI32(
                setDeviceMask,
                nativeNullPointer(),
                1
            ) &&
            !raw.callVoidPointer(setDeviceMask, command) &&
            !raw.callVoidPointerI32I32(
                setStencilReference,
                nativeNullPointer(),
                3,
                1
            ) &&
            !raw.callI32Pointer(
                idle,
                app.vulkanDevice.handle,
                nativeNullPointer()
            ) &&
            !raw.callI32Pointer4(
                createEvent,
                app.vulkanDevice.handle,
                nativeNullPointer(),
                nativeNullPointer(),
                eventHandle.address,
                eventStatus.address
            ) &&
            !raw.callVoidPointerI64Pointer(
                destroyEvent,
                app.vulkanDevice.handle,
                0,
                nativeNullPointer()
            ) &&
            !raw.callI32PointerI64(
                getEventStatus,
                app.vulkanDevice.handle,
                0,
                eventStatus.address
            ) &&
            !raw.callVoidPointerPointer(
                getFeatures2,
                app.vulkanDevice.physicalDevice,
                nativeNullPointer()
            )
        val liveBefore = runtimeMemoryLiveBytes()
        var createdEvent = 0
        var resourceRoundTrip = raw.callVoidPointerPointer(
            getFeatures2,
            app.vulkanDevice.physicalDevice,
            features2.address
        ) && (features2.loadI64(16) & 4294967295) <= 1 &&
            raw.callI32Pointer4(
                createEvent,
                app.vulkanDevice.handle,
                eventInfo.address,
                nativeNullPointer(),
                eventHandle.address,
                eventStatus.address
            ) && eventStatus.load() == vulkanSuccess &&
            eventHandle.load() != 0
        if (resourceRoundTrip) {
            createdEvent = eventHandle.load()
            eventStatus.store(-1)
            resourceRoundTrip = raw.callI32PointerI64(
                getEventStatus,
                app.vulkanDevice.handle,
                createdEvent,
                eventStatus.address
            ) && eventStatus.load() == 4 &&
                raw.callVoidPointerI64Pointer(
                    destroyEvent,
                    app.vulkanDevice.handle,
                    createdEvent,
                    nativeNullPointer()
                )
            if (resourceRoundTrip) eventHandle.store(0)
        }
        var call = 0
        while (recorded && resourceRoundTrip && call < 1000) {
            recorded = raw.callVoidPointerI32(
                setDeviceMask,
                command,
                1
            ) && raw.callVoidPointerI32I32(
                setStencilReference,
                command,
                3,
                call
            )
            call = call + 1
        }
        recorded = recorded && call == 1000 &&
            vkEndCommandBuffer(command) == vulkanSuccess
        if (recorded) {
            app.vulkanPixels.frames[0].scratch.storeI64(0, 4)
            app.vulkanPixels.frames[0].scratch.storePointer(
                8, nativeNullPointer()
            )
            app.vulkanPixels.frames[0].scratch.storeI64(16, 0)
            app.vulkanPixels.frames[0].scratch.storePointer(
                24, nativeNullPointer()
            )
            app.vulkanPixels.frames[0].scratch.storePointer(
                32, nativeNullPointer()
            )
            app.vulkanPixels.frames[0].scratch.storeI64(40, 1)
            app.vulkanPixels.frames[0].scratch.storePointer(
                48,
                app.vulkanPixels.frames[0].command.address
            )
            app.vulkanPixels.frames[0].scratch.storeI64(56, 0)
            app.vulkanPixels.frames[0].scratch.storePointer(
                64, nativeNullPointer()
            )
            recorded = vkQueueSubmit(
                app.vulkanDevice.queue,
                1,
                app.vulkanPixels.frames[0].scratch.address,
                0
            ) == vulkanSuccess &&
                vkQueueWaitIdle(app.vulkanDevice.queue) == vulkanSuccess &&
                raw.callI32Pointer(
                    idle,
                    app.vulkanDevice.handle,
                    idleStatus.address
                ) && idleStatus.load() == vulkanSuccess
        }
        val liveAfter = runtimeMemoryLiveBytes()
        val restored = vkResetCommandPool(
            app.vulkanDevice.handle,
            app.vulkanPixels.frames[0].commandPool,
            0
        ) == vulkanSuccess
        stable = raw.available && enumerate.valid() && idle.valid() &&
            setDeviceMask.valid() &&
            endRendering.valid() && setStencilReference.valid() &&
            createEvent.valid() && destroyEvent.valid() &&
            getEventStatus.valid() && getFeatures2.valid() &&
            enumerate.callShape ==
                "VkResult(VkInstance,uint32_t*,VkPhysicalDevice*)" &&
            idle.callShape == "VkResult(VkDevice)" &&
            setDeviceMask.callShape ==
                "void(VkCommandBuffer,uint32_t)" &&
            setDeviceMask.callAbi == "void(pointer,i32)" &&
            endRendering.callShape == "void(VkCommandBuffer)" &&
            endRendering.callAbi == "void(pointer)" &&
            setStencilReference.callShape ==
                "void(VkCommandBuffer,VkStencilFaceFlags,uint32_t)" &&
            setStencilReference.callAbi == "void(pointer,i32,i32)" &&
            createEvent.callShape ==
                "VkResult(VkDevice,const VkEventCreateInfo*,const VkAllocationCallbacks*,VkEvent*)" &&
            createEvent.callAbi ==
                "i32(pointer,pointer,pointer,pointer)" &&
            destroyEvent.callShape ==
                "void(VkDevice,VkEvent,const VkAllocationCallbacks*)" &&
            destroyEvent.callAbi == "void(pointer,i64,pointer)" &&
            getEventStatus.callShape == "VkResult(VkDevice,VkEvent)" &&
            getEventStatus.callAbi == "i32(pointer,i64)" &&
            getFeatures2.callShape ==
                "void(VkPhysicalDevice,VkPhysicalDeviceFeatures2*)" &&
            getFeatures2.callAbi == "void(pointer,pointer)" &&
            enumerate.callAbi == "unsupported" &&
            idle.callAbi == "i32(pointer)" &&
            !missing.valid() && missing.callShape == "" &&
            missing.callAbi == "unsupported" && unsupportedRejected &&
            resourceRoundTrip && createdEvent != 0 &&
            eventHandle.load() == 0 && recorded && restored &&
            liveAfter == liveBefore
        detail = "enumerate=${enumerate.address} mask=${setDeviceMask.address} event=$createdEvent eventStatus=${eventStatus.load()} calls=$call status=${idleStatus.load()} live=${liveAfter - liveBefore}"
    }
    println(
        "raw-command-addresses ${graphicsBackendName(app.backend)}: $detail stable=$stable"
    )
    if (stable) 0 else 1
}
