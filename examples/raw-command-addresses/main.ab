            setLineWidth.callAbi == "void(pointer,f32)" &&
            clearColorImage.callAbi ==
                "void(pointer,i64,i32,pointer,i32,pointer)" &&
            waitForFences.callAbi ==
                "i32(pointer,i32,pointer,i32,i64)" &&
            idle.callAbi == "i32(pointer)" &&
            !missing.valid() && missing.callShape == "" &&
            missing.callAbi == "unsupported" && unsupportedRejected &&
            pointerQueries && timelineRoundTrip && createdTimeline != 0 &&
            timeline.valid() && createdQueryPool != 0 &&
            timestampQuery.valid() && createdLegacyQueryPool != 0 &&
            legacyTimestampQuery.valid() && rawCompute.valid() &&
            rawCompute.vulkan.handle != 0 &&
            resourceRoundTrip && fenceRoundTrip &&
            createdEvent != 0 && eventHandle.load() == 0 &&
            createdFence != 0 && fenceHandle.load() == 0 &&
            fenceStatus.load() == 1 && resetStatus.load() == vulkanSuccess &&
            timelineWaitStatus.load() == vulkanSuccess &&
            submitStatus.load() == vulkanSuccess &&
            timestampQuery.result.load() > 0 &&
            legacyTimestampQuery.result.load() > 0 && rawUnmapped &&
            waitFenceStatus.load() == vulkanSuccess &&
            transferFirst == 72623859790382856 &&
            transferSecond == 72623859723010820 &&
            rawImagePixel == 4278190335 &&
            beginStatus.load() == vulkanSuccess && recorded && restored &&
            loopLiveAfter == loopLiveBefore
        detail = "enumerate=${enumerate.address} resolved=${resolvedEnumerateAddress.load()} version=${instanceVersion.load()} surface=${surfaceSupported.load()} devices=${physicalDeviceCount.load()} queue=${nativePointerAddress(queriedQueue.load())} legacyQueue=${nativePointerAddress(queriedLegacyQueue.load())} images=${swapchainImageCount.load()} begin=${beginStatus.load()} format=${formatProperties.loadI64(0)} timeline=$createdTimeline timelineValue=${timelineValue.load()} wait=${timelineWaitStatus.load()} queryPool=$createdQueryPool ticks=${timestampQuery.result.load()} legacyPool=$createdLegacyQueryPool legacyTicks=${legacyTimestampQuery.result.load()} compute=${rawCompute.vulkan.handle} transfer=$transferFirst/$transferSecond image=$rawImagePixel unmapped=$rawUnmapped submit=${submitStatus.load()} mask=${setDeviceMask.address} event=$createdEvent eventStatus=${eventStatus.load()} fence=$createdFence fenceStatus=${fenceStatus.load()} fenceWait=${waitFenceStatus.load()} reset=${resetStatus.load()}/${resetPoolStatus.load()} calls=$call status=${idleStatus.load()} loopLive=${loopLiveAfter - loopLiveBefore} live=${liveAfter - liveBefore}"
        rawCompute.drop()
        timeline.drop()
        timestampQuery.drop()
        legacyTimestampQuery.drop()
        rawTransferSource.drop()
        rawTransferDestination.drop()
        rawImage.drop()
        eventInfo.drop()
        fenceInfo.drop()
        queueInfo.drop()
        beginInfo.drop()
        updateData.close()
        stable = stable && timeline.handle == 0 &&
            timestampQuery.queryPool == 0 &&
            legacyTimestampQuery.queryPool == 0 &&
            rawCompute.vulkan.handle == 0 &&
            rawTransferSource.vulkan.handle == 0 &&
            rawTransferDestination.vulkan.handle == 0 && updateData.closed
        stable = stable && rawImage.vulkan.image == 0 &&
            !eventInfo.valid() && !fenceInfo.valid() &&
            !queueInfo.valid() && !beginInfo.valid()
    }
    println(
        "raw-command-addresses ${graphicsBackendName(app.backend)}: $detail stable=$stable"
    )
    if (stable) 0 else 1
}
