import "abla/io"
import "abla/process/arguments"
import "abla/runtime/memory"
import "../../src/graphics.ab"

trusted fun fillPitchedLayers(var bytes: BufferBytes, seed: int): bool {
    var succeeded = bytes.fill(204)
    var layer = 0
    while (succeeded && layer < 2) {
        var row = 0
        while (succeeded && row < 2) {
            var byte = 0
            while (succeeded && byte < 12) {
                val offset = 16 + layer * 80 + row * 20 + byte
                succeeded = bytes.store(
                    offset,
                    (seed + layer * 53 + row * 17 + byte * 3) & 255
                )
                byte = byte + 1
            }
            row = row + 1
        }
        layer = layer + 1
    }
    succeeded
}

fun pitchedLayersExact(source: BufferBytes, readback: BufferBytes): bool {
    var exact = source.valid() && readback.valid()
    var layer = 0
    while (exact && layer < 2) {
        var row = 0
        while (exact && row < 2) {
            var byte = 0
            while (exact && byte < 12) {
                val offset = 16 + layer * 80 + row * 20 + byte
                exact = source.load(offset) == readback.load(offset)
                byte = byte + 1
            }
            row = row + 1
        }
        layer = layer + 1
    }
    exact && readback.load(0) == 238 && readback.load(28) == 238 &&
        readback.load(68) == 238
}

fun main: int {
    val requested = if (processArgumentCount() > 0)
        processArgument(0)
    else "vulkan"
    val backend = if (requested == "opengl")
        graphicsBackendOpenGl
    else graphicsBackendVulkan
    val app = graphicsApplication(
        GraphicsConfig(
            backend = backend,
            requiredFeatures = graphicsFeaturePersistentMapping
        ),
        WindowConfig(
            title = "Abla Graphics asynchronous wider texture",
            width = 480,
            height = 270
        )
    )
    val usage = textureUsageSampled | textureUsageCopySource |
        textureUsageCopyDestination
    val texture = app.texture(TextureDescriptor(
        label = "streamed-array",
        size = Extent3D(16, 8, 4),
        mipLevels = 3,
        dimension = textureDimension2DArray,
        usage = usage
    ))
    val selection = TextureRegion(
        mipLevel = 1,
        x = 1,
        y = 1,
        z = 1,
        width = 3,
        height = 2,
        depth = 2
    )
    val layout = TextureDataLayout(
        offset = 16,
        bytesPerRow = 20,
        rowsPerImage = 4
    )
    val source = bufferBytes(160)
    val readback = bufferBytes(160)
    val upload = app.textureTransferQueue(TextureTransferQueueDescriptor(
        label = "sample-wider-upload",
        direction = textureTransferDirectionUpload,
        slotCapacity = 64,
        slotCount = 3,
        alignment = 16
    ))
    val download = app.textureTransferQueue(TextureTransferQueueDescriptor(
        label = "sample-wider-readback",
        direction = textureTransferDirectionReadback,
        slotCapacity = 64,
        slotCount = 3,
        alignment = 16
    ))
    val initialized = fillPitchedLayers(source, 11) && readback.fill(238)
    val firstUpload = if (initialized) app.enqueueUploadTextureBytes(
        upload,
        source,
        texture,
        selection,
        layout
    ) else 0
    val uploaded = textureTransferTicketValid(firstUpload) &&
        upload.wait(firstUpload)
    val firstReadback = if (uploaded) app.enqueueReadbackTextureBytes(
        download,
        texture,
        selection,
        layout
    ) else 0
    val downloaded = textureTransferTicketValid(firstReadback) &&
        app.waitTextureBytesReadback(download, firstReadback, readback)
    val exact = downloaded && pitchedLayersExact(source, readback)

    val liveBefore = runtimeMemoryLiveBytes()
    var repeated = exact
    var frame = 0
    while (repeated && frame < 6) {
        val uploadTicket = app.enqueueUploadTextureBytesRange(
            upload, source, texture, 1, 1, 1, 1, 3, 2, 2, 16, 20, 4
        )
        val readbackTicket = if (
            textureTransferTicketValid(uploadTicket) &&
            upload.wait(uploadTicket)
        ) app.enqueueReadbackTextureBytesRange(
            download, texture, 1, 1, 1, 1, 3, 2, 2, 16, 20, 4
        ) else 0
        repeated = textureTransferTicketValid(readbackTicket) &&
            app.waitTextureBytesReadback(
                download,
                readbackTicket,
                readback
            ) && pitchedLayersExact(source, readback)
        frame = frame + 1
    }
    val liveAfter = runtimeMemoryLiveBytes()
    val presented = app.presentClear(Color(0.04, 0.12, 0.28))
    val passed = app.valid() && texture.valid() && upload.valid() &&
        download.valid() && exact && repeated && frame == 6 &&
        liveAfter == liveBefore && presented
    println(
        "async-wider-texture ${graphicsBackendName(app.backend)}: exact=$exact frames=$frame repeated=$repeated live=${liveAfter - liveBefore}"
    )
    if (passed) 0 else 1
}
