import "abla/io"
import "abla/process/arguments"
import "abla/runtime/memory"
import "../../src/graphics.ab"

trusted fun main: int {
    val requested = if (processArgumentCount() > 0)
        processArgument(0)
    else "vulkan"
    val backend = if (requested == "opengl")
        graphicsBackendOpenGl
    else graphicsBackendVulkan
    val app = graphicsApplication(
        GraphicsConfig(backend = backend, validation = true),
        WindowConfig(
            title = "Abla Graphics recorded depth render",
            width = 480,
            height = 270
        )
    )
    val colorDescriptor = TextureDescriptor(
        label = "recorded-depth-color",
        size = Extent3D(64, 64),
        format = textureFormatRgba8Unorm,
        usage = textureUsageRenderAttachment | textureUsageCopySource
    )
    val depthDescriptor = TextureDescriptor(
        label = "recorded-depth-attachment",
        size = Extent3D(64, 64),
        format = textureFormatDepth32Float,
        usage = textureUsageRenderAttachment
    )
    val graph = app.materializeRenderGraphTextures([
        GraphicsGraphResource(0, "color", false, 0, 10),
        GraphicsGraphResource(1, "depth", false, 0, 11)
    ], [
        GraphicsGraphPass(10, "depth-render", [
            GraphicsGraphUse(0, graphAccessWrite),
            GraphicsGraphUse(1, graphAccessWrite)
        ])
    ], [
        GraphicsGraphTextureDeclaration(0, colorDescriptor),
        GraphicsGraphTextureDeclaration(1, depthDescriptor)
    ])
    val shader = $glsl {
        vertex {
            #version 450
            const vec2 positions[3] = vec2[3](
                vec2(-0.75, -0.65),
                vec2(0.75, -0.65),
                vec2(0.0, 0.75)
            );
            void main() {
                gl_Position = vec4(positions[gl_VertexID], 0.0, 1.0);
            }
        }
        fragment {
            #version 450
            layout(location = 0) out vec4 color;
            void main() { color = vec4(1.0, 0.0, 0.0, 1.0); }
        }
    }
    val color = app.texture(colorDescriptor)
    val depth = app.texture(depthDescriptor)
    val target = app.renderTargetWithDepth(move(color), move(depth))
    val pipeline = app.renderTargetPipeline(
        target,
        shader,
        VertexBufferLayout(),
        RasterPipelineState(),
        DepthStencilState(
            enabled = true,
            write = true,
            compare = compareFunctionLess
        )
    )
    val commands = app.graphCommandList(graph, 2)
    var succeeded = app.valid() && graph.valid() && shader.valid &&
        target.valid() && pipeline.valid() && commands.valid() &&
        commands.recordPass(graph, 10) &&
        commands.recordRenderTargetDepth(
            graph,
            0,
            1,
            move(target),
            move(pipeline),
            Color(0.0, 0.0, 0.0)
        ) && commands.seal(graph)
    val liveBefore = runtimeMemoryLiveBytes()
    var iteration = 0
    while (succeeded && iteration < 1001) {
        succeeded = app.executeGraphCommands(graph, commands)
        iteration = iteration + 1
    }
    val liveAfter = runtimeMemoryLiveBytes()
    val exact = commands.renderTargets[0].texture.rgba8(32, 32) ==
        4278190335
    val stable = succeeded && iteration == 1001 && exact &&
        commands.renderTargets[0].hasDepth() &&
        commands.renderDepthResourceIds[0] == 1 &&
        liveAfter == liveBefore && commands.executions == 1001 &&
        graph.completedExecutions == 1001 && commands.vulkanSubmissions ==
            (if (app.backend == graphicsBackendVulkan) 1001 else 0)
    println(
        "recorded-graph-depth-render ${graphicsBackendName(app.backend)}: depth=${commands.renderDepthResourceIds[0]} exact=$exact executions=${commands.executions}/${graph.completedExecutions} submissions=${commands.vulkanSubmissions} live=${liveAfter - liveBefore} stable=$stable"
    )
    if (stable) 0 else 1
}
