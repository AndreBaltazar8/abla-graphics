import "abla/io"
import "abla/process/arguments"
import "abla/runtime/memory"
import "../../src/graphics.ab"

fun main: int {
    val requested = if (processArgumentCount() > 0)
        processArgument(0)
    else "vulkan"
    val backend = if (requested == "opengl")
        graphicsBackendOpenGl
    else graphicsBackendVulkan
    val app = graphicsApplication(
        GraphicsConfig(backend = backend),
        WindowConfig(
            title = "Abla Graphics common buffer",
            width = 480,
            height = 270
        )
    )
    val buffer = app.buffer(BufferDescriptor(
        label = "sample-storage",
        size = 256,
        usage = bufferUsageStorage | bufferUsageCopySource |
            bufferUsageCopyDestination
    ))
    val expected = 1311768465173141112
    val upload = bufferBytes(32)
    val uploadReady = upload.fill(23) &&
        upload.storeI64(72623859790382856, 8)
    val uploadRange = BufferCopyDescriptor(5, 80, 19)
    val uploaded = uploadReady && buffer.writeBytes(
        upload,
        uploadRange
    )
    val readback = bufferBytes(32)
    val readbackRange = BufferCopyDescriptor(80, 3, 19)
    val downloaded = readback.fill(0) && buffer.readBytes(
        readback,
        readbackRange
    )
    val copiedBuffer = app.buffer(BufferDescriptor(
        label = "sample-copy-destination",
        size = 256,
        usage = bufferUsageCopySource | bufferUsageCopyDestination
    ))
    val gpuCopyRange = BufferCopyDescriptor(80, 41, 19)
    val gpuCopied = app.copyBuffer(buffer, copiedBuffer, gpuCopyRange)
    val gpuReadback = bufferBytes(32)
    val gpuReadbackRange = BufferCopyDescriptor(41, 6, 19)
    val gpuDownloaded = gpuReadback.fill(0) && copiedBuffer.readBytes(
        gpuReadback,
        gpuReadbackRange
    )
    val gpuFillRange = BufferFillDescriptor(2309737967, 8, 20)
    val gpuFilled = app.fillBuffer(copiedBuffer, gpuFillRange)
    val gpuFillReadback = bufferBytes(24)
    val gpuFillReadbackRange = BufferCopyDescriptor(8, 2, 20)
    val gpuFillDownloaded = gpuFillReadback.fill(0) &&
        copiedBuffer.readBytes(
            gpuFillReadback,
            gpuFillReadbackRange
        )
    val liveBeforeRepeats = runtimeMemoryLiveBytes()
    var repeated = uploaded && downloaded && gpuCopied && gpuDownloaded &&
        gpuFilled && gpuFillDownloaded
    var repeat = 0
    while (repeated && repeat < 4) {
        repeated = buffer.writeBytes(upload, uploadRange) &&
            buffer.readBytes(readback, readbackRange) &&
            app.copyBuffer(buffer, copiedBuffer, gpuCopyRange) &&
            copiedBuffer.readBytes(gpuReadback, gpuReadbackRange) &&
            app.fillBuffer(copiedBuffer, gpuFillRange) &&
            copiedBuffer.readBytes(
                gpuFillReadback,
                gpuFillReadbackRange
            )
        repeat = repeat + 1
    }
    val liveAfterRepeats = runtimeMemoryLiveBytes()
    val noTransferAllocations = liveAfterRepeats == liveBeforeRepeats
    val passed = app.valid() && buffer.valid() && copiedBuffer.valid() &&
        buffer.writeI64(expected, 24) && buffer.readI64(24) == expected &&
        uploaded && downloaded && gpuCopied && gpuDownloaded &&
        gpuFilled && gpuFillDownloaded &&
        repeated && noTransferAllocations &&
        readback.load(3) == 23 &&
        readback.loadI64(6) == 72623859790382856 &&
        readback.load(21) == 23 &&
        gpuReadback.load(6) == 23 &&
        gpuReadback.loadI64(9) == 72623859790382856 &&
        gpuReadback.load(24) == 23 &&
        gpuFillReadback.load(1) == 0 &&
        gpuFillReadback.load(2) == 239 &&
        gpuFillReadback.load(3) == 205 &&
        gpuFillReadback.load(4) == 171 &&
        gpuFillReadback.load(5) == 137 &&
        gpuFillReadback.load(21) == 137 &&
        gpuFillReadback.load(22) == 0 &&
        app.presentClear(Color(
            0.0625,
            0.1875,
            0.4375
        ))
    println(
        "Common buffer ${graphicsBackendName(app.backend)}: ${buffer.descriptor.size} bytes, range=${uploaded && downloaded}, gpuCopy=${gpuCopied && gpuDownloaded}, gpuFill=${gpuFilled && gpuFillDownloaded}, repeatNoAlloc=${noTransferAllocations}, liveDelta=${liveAfterRepeats - liveBeforeRepeats} on ${app.adapterName}"
    )
    if (passed) 0 else 1
}
