import "abla/io"
import "../../src/driver/vulkan.ab"

fun main: int {
    val loader = vulkanLoaderVersion()
    println("Vulkan loader ${vulkanVersionMajor(loader)}.${vulkanVersionMinor(loader)}.${vulkanVersionPatch(loader)}")
    val instance = vulkanInstance("Abla Graphics adapter report")
    val adapters = instance.adapters()
    var index = 0
    while (index < adapters.size) {
        val adapter = adapters[index]
        println("${index}: ${adapter.name} ${vulkanVersionMajor(adapter.apiVersion)}.${vulkanVersionMinor(adapter.apiVersion)}.${vulkanVersionPatch(adapter.apiVersion)}")
        index = index + 1
    }
    if (instance.valid() && adapters.size > 0) 0 else 1
}
