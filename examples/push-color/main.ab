import "abla/io"
import "abla/process/arguments"
import "abla/runtime/memory"
import "../../src/graphics.ab"

fun main: int {
    val requested = if (processArgumentCount() > 0)
        processArgument(0)
    else "auto"
    val backend = if (requested == "opengl") graphicsBackendOpenGl
        else if (requested == "vulkan") graphicsBackendVulkan
        else graphicsBackendAuto
    val app = graphicsApplication(
        GraphicsConfig(
            backend = backend,
            framesInFlight = 2,
            requiredFeatures = graphicsFeaturePersistentMapping
        ),
        WindowConfig(title = "Abla Graphics push color", width = 640, height = 480)
    )
    val shader = $glsl {
        vertex {
            #version 450
            const vec2 positions[3] = vec2[3](
                vec2(-0.75, -0.65),
                vec2(0.75, -0.65),
                vec2(0.0, 0.75)
            );
            void main() {
                gl_Position = vec4(positions[gl_VertexID], 0.0, 1.0);
            }
        }
        fragment {
            #version 450
            layout(location = 0) out vec4 color;
            layout(push_constant) uniform Draw {
                vec3 tint;
                float alpha;
            } draw;
            void main() {
                color = vec4(draw.tint.x, draw.tint.y, draw.tint.z, draw.alpha);
            }
        }
    }
    val bufferedShader = $glsl {
        vertex {
            #version 450
            layout(location = 0) in vec2 position;
            void main() {
                gl_Position = vec4(position, 0.0, 1.0);
            }
        }
        fragment {
            #version 450
            layout(location = 0) out vec4 color;
            layout(push_constant) uniform Draw {
                vec3 tint;
                float alpha;
            } draw;
            void main() {
                color = vec4(draw.tint.x, draw.tint.y, draw.tint.z, draw.alpha);
            }
        }
    }
    val texture = app.texture(TextureDescriptor(
        label = "push-color-proof",
        size = Extent3D(64, 64),
        usage = textureUsageRenderAttachment | textureUsageCopySource
    ))
    val target = app.renderTarget(move(texture))
    val targetPipeline = app.renderTargetPipeline(target, shader)
    val windowPipeline = app.renderPipeline(shader)
    val vertexLayout = VertexBufferLayout(8, [
        VertexAttribute(0, 0, vertexFormatFloat32x2)
    ])
    val targetBufferedPipeline = app.renderTargetPipeline(
        target,
        bufferedShader,
        vertexLayout
    )
    val windowBufferedPipeline = app.renderPipeline(
        bufferedShader,
        vertexLayout
    )
    val drawPool = app.bufferPool(BufferPoolDescriptor(
        label = "push-color-draw-pool",
        capacity = 256,
        blockSize = 16,
        maximumAllocations = 8,
        usage = bufferUsageCopySource | bufferUsageCopyDestination |
            bufferUsageVertex | bufferUsageIndex | bufferUsageIndirect
    ))
    val drawPrefix = drawPool.allocate(16)
    val vertices = drawPool.allocate(24, 4)
    val indices = drawPool.allocate(12, 4)
    val direct = drawPool.allocate(16, 4)
    val indexed = drawPool.allocate(20, 4)
    val vertexBytes = bufferBytes(24)
    val verticesStored = vertexBytes.storeF32(-0.75, 0) &&
        vertexBytes.storeF32(-0.65, 4) &&
        vertexBytes.storeF32(0.75, 8) &&
        vertexBytes.storeF32(-0.65, 12) &&
        vertexBytes.storeF32(0.0, 16) &&
        vertexBytes.storeF32(0.75, 20)
    val indexBytes = bufferBytes(12)
    val indicesStored = indexBytes.storeU32(0, 0) &&
        indexBytes.storeU32(1, 4) && indexBytes.storeU32(2, 8)
    val directBytes = bufferBytes(16)
    val directStored = directBytes.storeI64(4294967299, 0) &&
        directBytes.storeI64(0, 8)
    val indexedBytes = bufferBytes(20)
    val indexedStored = indexedBytes.storeI64(4294967299, 0) &&
        indexedBytes.storeI64(
            drawPool.allocationOffset(indices) / 4,
            8
        ) && indexedBytes.storeU32(0, 16)
    val drawUploads = app.bufferTransferQueue(
        BufferTransferQueueDescriptor(
            label = "push-color-draw-uploads",
            direction = bufferTransferDirectionUpload,
            slotCapacity = 32,
            slotCount = 4,
            alignment = 16
        )
    )
    val vertexUpload = app.enqueueUploadBufferPoolRange(
        drawUploads, vertexBytes, drawPool, vertices, 0, 0, 24
    )
    val indexUpload = app.enqueueUploadBufferPoolRange(
        drawUploads, indexBytes, drawPool, indices, 0, 0, 12
    )
    val directUpload = app.enqueueUploadBufferPoolRange(
        drawUploads, directBytes, drawPool, direct, 0, 0, 16
    )
    val indexedUpload = app.enqueueUploadBufferPoolRange(
        drawUploads, indexedBytes, drawPool, indexed, 0, 0, 20
    )
    val drawsUploaded = verticesStored && indicesStored && directStored &&
        indexedStored && bufferTransferTicketValid(vertexUpload) &&
        bufferTransferTicketValid(indexUpload) &&
        bufferTransferTicketValid(directUpload) &&
        bufferTransferTicketValid(indexedUpload) &&
        drawUploads.wait(vertexUpload) && drawUploads.wait(indexUpload) &&
        drawUploads.wait(directUpload) && drawUploads.wait(indexedUpload)
    val values = shader.pushConstants()
    val clear = Color(0.01, 0.02, 0.03)
    val clearValues = renderPassClearValues(clear)
    val clearPass = app.renderPass(target, move(clearValues))
    val loadValues = renderPassClearValues(Color(0.0, 0.0, 1.0))
    val loadPass = app.renderPass(
        target,
        move(loadValues),
        RenderPassOperations(color = RenderAttachmentOperations(
            load = attachmentLoadOperationLoad
        ))
    )
    val discardValues = renderPassClearValues(Color(0.0, 1.0, 0.0))
    val discardPass = app.renderPass(
        target,
        move(discardValues),
        RenderPassOperations(color = RenderAttachmentOperations(
            load = attachmentLoadOperationDiscard,
            store = attachmentStoreOperationDiscard
        ))
    )
    val subpassValues = renderPassClearValues(Color(0.0, 0.0, 0.0))
    val subpassPass = app.renderPass(
        target,
        move(subpassValues),
        RenderPassOperations(),
        2
    )
    val firstSubpassPipeline = app.renderPassPipeline(
        target,
        subpassPass,
        0,
        shader
    )
    val secondSubpassPipeline = app.renderPassPipeline(
        target,
        subpassPass,
        1,
        shader
    )
    val subpassSequence = app.subpassPipelines(
        target,
        subpassPass,
        [move(firstSubpassPipeline), move(secondSubpassPipeline)]
    )
    val subpassConstants = subpassSequence.pushConstants()
    val stored = values.storeMemberF32("tint", 1.0) &&
        values.storeMemberF32("tint", 0.0, 1) &&
        values.storeMemberF32("tint", 0.0, 2) &&
        values.storeMemberF32("alpha", 1.0)
    val missingBufferedRejected = !app.renderBufferPoolVerticesToTarget(
        target,
        targetBufferedPipeline,
        drawPool,
        vertices,
        3,
        clear
    ) && !app.presentRenderBufferPoolVertices(
        windowBufferedPipeline,
        drawPool,
        vertices,
        3,
        clear
    )
    val missingPassRejected = !app.renderPassToTarget(
        target,
        targetPipeline,
        clearPass
    ) && !app.renderPassBufferPoolVerticesToTarget(
        target,
        targetBufferedPipeline,
        clearPass,
        drawPool,
        vertices,
        3
    )
    val subpassStored = subpassConstants.writeSubpass(0, values) &&
        subpassConstants.writeSubpass(1, values)
    val missingSubpassesRejected = !app.renderSubpassesToTarget(
        target,
        subpassSequence,
        subpassPass
    ) && !subpassConstants.writeSubpass(-1, values) &&
        !subpassConstants.storeF32(2, 1.0)
    val warmed = app.valid() && target.valid() &&
        targetPipeline.valid() && windowPipeline.valid() && values.valid() &&
        targetBufferedPipeline.valid() && windowBufferedPipeline.valid() &&
        clearPass.valid() && loadPass.valid() && discardPass.valid() &&
        subpassPass.valid() && subpassSequence.valid() &&
        subpassConstants.valid() && drawPool.valid() &&
        drawPool.backing.deviceLocal() && drawUploads.valid() &&
        drawPool.allocationOffset(drawPrefix) == 0 &&
        drawPool.allocationOffset(vertices) == 16 &&
        drawPool.allocationOffset(indices) == 48 &&
        drawPool.allocationOffset(direct) == 64 &&
        drawPool.allocationOffset(indexed) == 80 && drawsUploaded &&
        missingBufferedRejected &&
        missingPassRejected && missingSubpassesRejected && subpassStored &&
        stored && app.renderPushToTarget(
            target,
            targetPipeline,
            values,
            clear
        ) && target.texture.rgba8(32, 32) == 4278190335 &&
        app.renderPushPassToTarget(
            target, targetPipeline, values, clearPass
        ) && app.renderPushPassToTarget(
            target, targetPipeline, values, loadPass
        ) && app.renderPushPassToTarget(
            target, targetPipeline, values, discardPass
        ) && app.renderPushPassBufferPoolVerticesToTarget(
            target, targetBufferedPipeline, values, clearPass, drawPool,
            vertices, 3
        ) && app.renderPushPassBufferPoolIndexedToTarget(
            target, targetBufferedPipeline, values, clearPass, drawPool,
            vertices, indices, 3
        ) && app.renderPushPassBufferPoolVerticesIndirectToTarget(
            target, targetBufferedPipeline, values, clearPass, drawPool,
            vertices, direct
        ) && app.renderPushPassBufferPoolIndexedIndirectToTarget(
            target, targetBufferedPipeline, values, clearPass, drawPool,
            vertices, indices, indexed
        ) && target.texture.rgba8(32, 32) == 4278190335 &&
        app.renderPushSubpassesToTarget(
            target, subpassSequence, subpassConstants, subpassPass
        ) && target.texture.rgba8(32, 32) == 4278190335 &&
        app.renderPushBufferPoolVerticesToTarget(
            target, targetBufferedPipeline, values, drawPool, vertices, 3,
            clear
        ) && app.renderPushBufferPoolIndexedToTarget(
            target, targetBufferedPipeline, values, drawPool, vertices,
            indices, 3, clear
        ) && app.renderPushBufferPoolVerticesIndirectToTarget(
            target, targetBufferedPipeline, values, drawPool, vertices,
            direct, clear
        ) && app.renderPushBufferPoolIndexedIndirectToTarget(
            target, targetBufferedPipeline, values, drawPool, vertices,
            indices, indexed, clear
        ) && target.texture.rgba8(32, 32) == 4278190335 &&
        app.presentPushRender(windowPipeline, values, clear) &&
        app.presentPushRenderBufferPoolVertices(
            windowBufferedPipeline, values, drawPool, vertices, 3, clear
        ) && app.presentPushRenderBufferPoolIndexed(
            windowBufferedPipeline, values, drawPool, vertices, indices, 3,
            clear
        ) && app.presentPushRenderBufferPoolVerticesIndirect(
            windowBufferedPipeline, values, drawPool, vertices, direct, clear
        ) && app.presentPushRenderBufferPoolIndexedIndirect(
            windowBufferedPipeline, values, drawPool, vertices, indices,
            indexed, clear
        )
    val targetHandle = if (app.backend == graphicsBackendOpenGl)
        targetPipeline.openGl.pushConstantBuffer
    else targetPipeline.vulkan.handle
    val windowHandle = if (app.backend == graphicsBackendOpenGl)
        windowPipeline.openGl.pushConstantBuffer
    else windowPipeline.vulkan.handle
    val targetBufferedHandle = if (app.backend == graphicsBackendOpenGl)
        targetBufferedPipeline.openGl.pushConstantBuffer
    else targetBufferedPipeline.vulkan.handle
    val windowBufferedHandle = if (app.backend == graphicsBackendOpenGl)
        windowBufferedPipeline.openGl.pushConstantBuffer
    else windowBufferedPipeline.vulkan.handle
    val firstSubpassHandle = if (app.backend == graphicsBackendOpenGl)
        subpassSequence.pipelines[0].openGl.pushConstantBuffer
    else subpassSequence.pipelines[0].vulkan.handle
    val secondSubpassHandle = if (app.backend == graphicsBackendOpenGl)
        subpassSequence.pipelines[1].openGl.pushConstantBuffer
    else subpassSequence.pipelines[1].vulkan.handle
    val drawPoolHandle = if (app.backend == graphicsBackendOpenGl)
        drawPool.backing.openGl.handle else drawPool.backing.vulkan.handle
    val liveBefore = runtimeMemoryLiveBytes()
    var repeated = warmed
    var frame = 0
    while (repeated && frame < 4) {
        val even = (frame & 1) == 0
        repeated = values.storeMemberF32(
            "tint", if (even) 0.0 else 1.0
        ) && values.storeMemberF32(
            "tint", if (even) 1.0 else 0.0, 1
        ) && subpassConstants.storeMemberF32(
            0, "tint", if (even) 0.0 else 1.0
        ) && subpassConstants.storeMemberF32(
            0, "tint", if (even) 1.0 else 0.0, 1
        ) && subpassConstants.storeMemberF32(
            1, "tint", if (even) 0.0 else 1.0
        ) && subpassConstants.storeMemberF32(
            1, "tint", if (even) 1.0 else 0.0, 1
        ) && app.renderPushToTarget(
            target, targetPipeline, values, clear
        ) &&
            app.renderPushSubpassesToTarget(
                target, subpassSequence, subpassConstants, subpassPass
            ) &&
            app.renderPushPassToTarget(
                target, targetPipeline, values, clearPass
            ) && app.renderPushPassBufferPoolVerticesToTarget(
                target, targetBufferedPipeline, values, clearPass, drawPool,
                vertices, 3
            ) && app.renderPushPassBufferPoolIndexedToTarget(
                target, targetBufferedPipeline, values, clearPass, drawPool,
                vertices, indices, 3
            ) && app.renderPushPassBufferPoolVerticesIndirectToTarget(
                target, targetBufferedPipeline, values, clearPass, drawPool,
                vertices, direct
            ) && app.renderPushPassBufferPoolIndexedIndirectToTarget(
                target, targetBufferedPipeline, values, clearPass, drawPool,
                vertices, indices, indexed
            ) &&
            app.renderPushBufferPoolVerticesToTarget(
                target, targetBufferedPipeline, values, drawPool, vertices,
                3, clear
            ) && app.renderPushBufferPoolIndexedToTarget(
                target, targetBufferedPipeline, values, drawPool, vertices,
                indices, 3, clear
            ) && app.renderPushBufferPoolVerticesIndirectToTarget(
                target, targetBufferedPipeline, values, drawPool, vertices,
                direct, clear
            ) && app.renderPushBufferPoolIndexedIndirectToTarget(
                target, targetBufferedPipeline, values, drawPool, vertices,
                indices, indexed, clear
            ) && app.presentPushRender(windowPipeline, values, clear) &&
            app.presentPushRenderBufferPoolVertices(
                windowBufferedPipeline, values, drawPool, vertices, 3, clear
            ) && app.presentPushRenderBufferPoolIndexed(
                windowBufferedPipeline, values, drawPool, vertices, indices,
                3, clear
            ) && app.presentPushRenderBufferPoolVerticesIndirect(
                windowBufferedPipeline, values, drawPool, vertices, direct,
                clear
            ) && app.presentPushRenderBufferPoolIndexedIndirect(
                windowBufferedPipeline, values, drawPool, vertices, indices,
                indexed, clear
            )
        frame = frame + 1
    }
    val liveAfter = runtimeMemoryLiveBytes()
    val finalPixel = target.texture.rgba8(32, 32)
    val handlesStable = if (app.backend == graphicsBackendOpenGl)
        targetPipeline.openGl.pushConstantBuffer == targetHandle &&
            windowPipeline.openGl.pushConstantBuffer == windowHandle &&
            targetBufferedPipeline.openGl.pushConstantBuffer ==
                targetBufferedHandle &&
            windowBufferedPipeline.openGl.pushConstantBuffer ==
                windowBufferedHandle &&
            subpassSequence.pipelines[0].openGl.pushConstantBuffer ==
                firstSubpassHandle &&
            subpassSequence.pipelines[1].openGl.pushConstantBuffer ==
                secondSubpassHandle &&
            targetHandle != 0 && windowHandle != 0 &&
            targetBufferedHandle != 0 && windowBufferedHandle != 0 &&
            drawPoolHandle != 0 &&
            drawPool.backing.openGl.handle == drawPoolHandle
    else targetPipeline.vulkan.handle == targetHandle &&
        windowPipeline.vulkan.handle == windowHandle &&
        targetBufferedPipeline.vulkan.handle == targetBufferedHandle &&
        windowBufferedPipeline.vulkan.handle == windowBufferedHandle &&
        subpassSequence.pipelines[0].vulkan.handle == firstSubpassHandle &&
        subpassSequence.pipelines[1].vulkan.handle == secondSubpassHandle &&
        targetPipeline.vulkan.pushConstantSize == 16 &&
        windowPipeline.vulkan.pushConstantSize == 16 &&
        targetBufferedPipeline.vulkan.pushConstantSize == 16 &&
        windowBufferedPipeline.vulkan.pushConstantSize == 16 &&
        drawPoolHandle != 0 &&
        drawPool.backing.vulkan.handle == drawPoolHandle
    println(
        "push-color backend=${graphicsBackendName(app.backend)} forms=16 pooled=true offsets=${drawPool.allocationOffset(vertices)}/${drawPool.allocationOffset(indices)}/${drawPool.allocationOffset(direct)}/${drawPool.allocationOffset(indexed)} pixel=$finalPixel frames=$frame liveDelta=${liveAfter - liveBefore} stable=$handlesStable"
    )
    if (repeated && frame == 4 && finalPixel == 4278190335 &&
        liveAfter == liveBefore && handlesStable) 0 else 1
}
