import "../../src/graphics.ab"
import "abla/io"

trusted fun main: int {
    val window = waylandXdgWindow(
        "Abla Graphics input",
        "io.abla.graphics.wayland-input",
        640,
        480
    )
    val succeeded = window.valid()
    val inputEnabled = succeeded && window.enableInput()
    val cursorEnabled = inputEnabled && window.pointerIdentifier >= 2 &&
        window.enableCursor()
    var attempts = 0
    var eventCount = 0
    while (inputEnabled && attempts < 16 && !window.keyboardMapped()) {
        val event = window.pollInputEvent(25)
        if (event.happened()) eventCount = eventCount + 1
        attempts = attempts + 1
    }
    if (succeeded) println(
        "wayland-input: enabled=$inputEnabled seat=${window.seatName} capabilities=${window.seatCapabilities} pointer=${window.pointerIdentifier >= 2} cursor=$cursorEnabled keyboard=${window.keyboardIdentifier >= 2} keymapBytes=${window.keymap.size} parsedKeys=${window.parsedKeymap.parsedKeys} repeat=${window.repeatRate}/${window.repeatDelay} events=$eventCount"
    )
    if (succeeded) 0 else 1
}
