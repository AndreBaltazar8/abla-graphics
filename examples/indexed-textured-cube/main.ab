import "abla/io"
import "abla/process/arguments"
import "abla/runtime/memory"
import "../../src/graphics.ab"

class CubeExplorerState(
    var cameraX: f64 = 0.0,
    var cameraZ: f64 = 3.0,
    var forward: bool = false,
    var backward: bool = false,
    var left: bool = false,
    var right: bool = false,
    var movements: int = 0
) {
    fun camera(backend: int): CameraMatrix = PerspectiveCamera3D(
        position = Vec3(this.cameraX, 0.0, this.cameraZ),
        target = Vec3(this.cameraX, 0.0, 0.45),
        verticalFieldOfViewDegrees = 70.0,
        nearPlane = 0.1,
        farPlane = 20.0
    ).viewProjectionMatrix(backend, 4.0 / 3.0)

    fun ready(): bool = this.forward && this.backward &&
        this.left && this.right

    fun observe(event: WindowEvent): bool {
        if (event.kind != windowEventKey || !event.keyPressed()) return false
        if (event.key() == keyW) {
            this.cameraZ = this.cameraZ - 0.2
            this.forward = true
        } else if (event.key() == keyS) {
            this.cameraZ = this.cameraZ + 0.2
            this.backward = true
        } else if (event.key() == keyA) {
            this.cameraX = this.cameraX - 0.2
            this.left = true
        } else if (event.key() == keyD) {
            this.cameraX = this.cameraX + 0.2
            this.right = true
        } else return false
        this.movements = this.movements + 1
        true
    }
}

fun main: int {
    val requested = if (processArgumentCount() > 0)
        processArgument(0)
    else "auto"
    val backend = if (requested == "opengl") graphicsBackendOpenGl
        else if (requested == "vulkan") graphicsBackendVulkan
        else graphicsBackendAuto
    val mode = if (processArgumentCount() > 1)
        processArgument(1) else "interactive"
    val automated = mode == "automated" || mode == "self-test"
    val selfTest = mode == "self-test"
    val app = graphicsApplication(
        GraphicsConfig(
            backend = backend,
            framesInFlight = 3,
            requiredFeatures = graphicsFeaturePersistentMapping
        ),
        WindowConfig(
            title = "Abla Graphics Cube Explorer",
            width = 720,
            height = 540,
            resizable = false
        )
    )
    val shader = $glsl {
        vertex {
            #version 450
            layout(location = 0) in vec3 position;
            layout(location = 1) in vec2 uv;
            layout(location = 0) out vec2 texCoord;
            layout(std140, binding = 1) uniform Transform {
                mat4 mvp;
            } transform;
            void main() {
                gl_Position = transform.mvp * vec4(position, 1.0);
                texCoord = uv;
            }
        }
        fragment {
            #version 450
            layout(location = 0) in vec2 texCoord;
            layout(location = 0) out vec4 color;
            layout(binding = 0) uniform sampler2D atlas;
            void main() {
                color = texture(atlas, texCoord);
            }
        }
    }
    val vertexValues = [
        -0.6, -0.55, 0.2, 0.0, 0.0,
         0.6, -0.55, 0.2, 1.0, 0.0,
         0.6,  0.55, 0.2, 1.0, 1.0,
        -0.6,  0.55, 0.2, 0.0, 1.0,
         0.45, -0.3, 0.7, 0.0, 0.0,
        -0.35, -0.3, 0.7, 1.0, 0.0,
        -0.35,  0.4, 0.7, 1.0, 1.0,
         0.45,  0.4, 0.7, 0.0, 1.0,
        -0.35, -0.3, 0.7, 0.0, 0.0,
        -0.6, -0.55, 0.2, 1.0, 0.0,
        -0.6,  0.55, 0.2, 1.0, 1.0,
        -0.35,  0.4, 0.7, 0.0, 1.0,
         0.6, -0.55, 0.2, 0.0, 0.0,
         0.45, -0.3, 0.7, 1.0, 0.0,
         0.45,  0.4, 0.7, 1.0, 1.0,
         0.6,  0.55, 0.2, 0.0, 1.0,
        -0.6,  0.55, 0.2, 0.0, 0.0,
         0.6,  0.55, 0.2, 1.0, 0.0,
         0.45,  0.4, 0.7, 1.0, 1.0,
        -0.35,  0.4, 0.7, 0.0, 1.0,
        -0.35, -0.3, 0.7, 0.0, 0.0,
         0.45, -0.3, 0.7, 1.0, 0.0,
         0.6, -0.55, 0.2, 1.0, 1.0,
        -0.6, -0.55, 0.2, 0.0, 1.0
    ]
    val vertexBytes = bufferBytes(480)
    var verticesStored = vertexValues.size == 120
    var valueIndex = 0
    while (verticesStored && valueIndex < vertexValues.size) {
        verticesStored = vertexBytes.storeF32(
            vertexValues[valueIndex],
            valueIndex * 4
        )
        valueIndex = valueIndex + 1
    }
    val vertices = app.buffer(BufferDescriptor(
        label = "cube-vertices",
        size = 480,
        usage = bufferUsageVertex | bufferUsageCopyDestination
    ))
    val verticesUploaded = verticesStored &&
        vertices.writeAllBytes(vertexBytes)
    val faceIndices = [0, 1, 2, 2, 3, 0]
    val indexBytes = bufferBytes(144)
    var indicesStored = true
    var face = 0
    while (indicesStored && face < 6) {
        var corner = 0
        while (indicesStored && corner < faceIndices.size) {
            indicesStored = indexBytes.storeU32(
                face * 4 + faceIndices[corner],
                (face * 6 + corner) * 4
            )
            corner = corner + 1
        }
        face = face + 1
    }
    val indices = app.buffer(BufferDescriptor(
        label = "cube-indices",
        size = 144,
        usage = bufferUsageIndex | bufferUsageCopyDestination
    ))
    val indicesUploaded = indicesStored && indices.writeAllBytes(indexBytes)
    val pixels = pixelBuffer(4, 4)
    val pixelsReady = pixels.clearRgba8(235, 225, 195) &&
        pixels.fillRectRgba8(0, 0, 2, 2, 210, 45, 65) &&
        pixels.fillRectRgba8(2, 0, 2, 2, 45, 185, 100) &&
        pixels.fillRectRgba8(0, 2, 2, 2, 45, 95, 225) &&
        pixels.fillRectRgba8(2, 2, 2, 2, 235, 180, 35)
    val texture = app.texture(TextureDescriptor(
        label = "cube-atlas",
        size = Extent3D(4, 4),
        format = textureFormatRgba8Unorm,
        usage = textureUsageSampled | textureUsageCopyDestination
    ))
    val textureUploaded = pixelsReady &&
        texture.writePixels(pixels, TextureWriteDescriptor())
    val sampler = app.sampler(SamplerDescriptor(
        magFilter = samplerFilterNearest,
        minFilter = samplerFilterNearest,
        mipmapFilter = samplerFilterNearest
    ))
    val transformBytes = bufferBytes(64)
    val explorer = CubeExplorerState()
    val initialCamera = explorer.camera(app.backend)
    val transformStored = initialCamera.valid &&
        transformBytes.storeMat4(initialCamera.value)
    val transformAlignment =
        app.capabilities.limits.minimumUniformBufferOffsetAlignment
    val transformPool = app.bufferPool(BufferPoolDescriptor(
        label = "cube-transform-pool",
        capacity = 4096,
        blockSize = 16,
        maximumAllocations = 4,
        usage = bufferUsageCopySource | bufferUsageCopyDestination |
            bufferUsageUniform
    ))
    val transformPrefix = transformPool.allocate(16)
    val transformAllocation = transformPool.allocate(64, transformAlignment)
    val transformUploads = app.bufferTransferQueue(
        BufferTransferQueueDescriptor(
            label = "cube-transform-uploads",
            direction = bufferTransferDirectionUpload,
            slotCapacity = 64,
            slotCount = 2,
            alignment = 16
        )
    )
    val firstTransformUpload = app.enqueueUploadBufferPoolRange(
        transformUploads,
        transformBytes,
        transformPool,
        transformAllocation
    )
    val transformUploaded = transformStored &&
        bufferTransferTicketValid(firstTransformUpload) &&
        transformUploads.wait(firstTransformUpload)
    val binding = app.bindGroup([
        app.sampledTextureEntry(
            0,
            shaderVisibilityFragment,
            texture,
            sampler
        ),
        app.uniformBufferPoolEntry(
            1,
            shaderVisibilityVertex,
            transformPool,
            transformAllocation
        )
    ])
    val pipeline = app.renderPipeline(
        shader,
        VertexBufferLayout(20, [
            VertexAttribute(0, 0, vertexFormatFloat32x3),
            VertexAttribute(1, 12, vertexFormatFloat32x2)
        ]),
        RasterPipelineState(
            topology = primitiveTopologyTriangleList,
            cullMode = cullModeNone,
            frontFace = frontFaceCounterClockwise
        ),
        DepthStencilState(
            enabled = true,
            write = true,
            compare = compareFunctionLess
        ),
        move(binding)
    )
    val clear = Color(0.012, 0.018, 0.03)
    val warmed = app.valid() && shader.valid && vertices.valid() &&
        indices.valid() && texture.valid() && sampler.valid() &&
        transformPool.valid() && transformUploads.valid() &&
        bufferPoolTokenValid(transformPrefix) &&
        bufferPoolTokenValid(transformAllocation) &&
        verticesUploaded && indicesUploaded &&
        textureUploaded && transformUploaded &&
        pipeline.valid() &&
        app.presentRenderIndexed(pipeline, vertices, indices, 36, clear)
    val pipelineHandle = if (app.backend == graphicsBackendOpenGl)
        pipeline.openGl.handle else pipeline.vulkan.handle
    val bindingHandle = if (app.backend == graphicsBackendOpenGl)
        pipeline.binding.openGlResources[0]
    else pipeline.binding.vulkan.descriptorSet
    val transformBufferHandle = if (app.backend == graphicsBackendOpenGl)
        transformPool.backing.openGl.handle
    else transformPool.backing.vulkan.handle
    val deadline = graphicsMonotonicNanoseconds() + 10000000000
    var running = warmed
    var presentedFrames = if (warmed) 1 else 0
    var matrixUpdates = 0
    while (running && (!automated || !explorer.ready() ||
        (!selfTest && explorer.movements < 5)) &&
        (!automated || graphicsMonotonicNanoseconds() < deadline)) {
        var event = WindowEvent()
        if (selfTest && explorer.movements == 0)
            event = WindowEvent(windowEventKey, keyW, 1)
        else if (selfTest && explorer.movements == 1)
            event = WindowEvent(windowEventKey, keyA, 1)
        else if (selfTest && explorer.movements == 2)
            event = WindowEvent(windowEventKey, keyD, 1)
        else if (selfTest && explorer.movements == 3)
            event = WindowEvent(windowEventKey, keyS, 1)
        else event = app.pollEvent(20)
        var changed = false
        while (event.happened()) {
            if (event.kind == windowEventCloseRequested ||
                (event.kind == windowEventKey &&
                 event.key() == keyEscape && event.keyPressed())) {
                running = false
            } else if (explorer.observe(event)) changed = true
            if (selfTest) event = WindowEvent()
            else event = app.pollEvent(0)
        }
        if (running && changed) {
            val cameraMatrix = explorer.camera(app.backend)
            val upload = if (cameraMatrix.valid &&
                transformBytes.storeMat4(cameraMatrix.value))
                app.enqueueUploadBufferPoolRange(
                    transformUploads,
                    transformBytes,
                    transformPool,
                    transformAllocation
                )
            else 0
            running = bufferTransferTicketValid(upload) &&
                transformUploads.wait(upload) && app.presentRenderIndexed(
                    pipeline,
                    vertices,
                    indices,
                    36,
                    clear
                )
            if (running) {
                matrixUpdates = matrixUpdates + 1
                presentedFrames = presentedFrames + 1
            }
        }
    }
    val inputMatrixUpdates = matrixUpdates
    var warmFrames = 0
    while (running && automated && warmFrames < 2) {
        explorer.cameraX = if ((warmFrames & 1) == 0) 0.02 else -0.02
        val cameraMatrix = explorer.camera(app.backend)
        val upload = if (cameraMatrix.valid &&
            transformBytes.storeMat4(cameraMatrix.value))
            app.enqueueUploadBufferPoolRange(
                transformUploads,
                transformBytes,
                transformPool,
                transformAllocation
            )
        else 0
        running = bufferTransferTicketValid(upload) &&
            transformUploads.wait(upload) && app.presentRenderIndexed(
                pipeline, vertices, indices, 36, clear
            )
        if (running) {
            matrixUpdates = matrixUpdates + 1
            presentedFrames = presentedFrames + 1
        }
        warmFrames = warmFrames + 1
    }
    val liveBefore = runtimeMemoryLiveBytes()
    val steadyMemory = runtimeMemoryCheckpoint()
    val started = graphicsMonotonicNanoseconds()
    var steadyFrames = 0
    while (running && automated && steadyFrames < 120) {
        explorer.cameraX = if ((steadyFrames & 1) == 0) 0.02 else -0.02
        val cameraMatrix = explorer.camera(app.backend)
        val upload = if (cameraMatrix.valid &&
            transformBytes.storeMat4(cameraMatrix.value))
            app.enqueueUploadBufferPoolRange(
                transformUploads,
                transformBytes,
                transformPool,
                transformAllocation
            )
        else 0
        running = bufferTransferTicketValid(upload) &&
            transformUploads.wait(upload) && app.presentRenderIndexed(
                pipeline, vertices, indices, 36, clear
            )
        if (running) {
            matrixUpdates = matrixUpdates + 1
            presentedFrames = presentedFrames + 1
            steadyFrames = steadyFrames + 1
        }
    }
    val elapsed = graphicsMonotonicNanoseconds() - started
    runtimeMemoryReset(steadyMemory)
    val liveAfter = runtimeMemoryLiveBytes()
    val noGrowth = liveBefore == liveAfter
    val framesPerSecond = if (elapsed > 0)
        steadyFrames * 1000000000 / elapsed else 0
    val handlesStable = pipelineHandle != 0 && bindingHandle != 0 &&
        transformBufferHandle != 0 &&
        (if (app.backend == graphicsBackendOpenGl)
            transformPool.backing.openGl.handle == transformBufferHandle
         else transformPool.backing.vulkan.handle == transformBufferHandle) &&
        (if (app.backend == graphicsBackendOpenGl)
            pipeline.openGl.handle == pipelineHandle &&
                pipeline.binding.openGlResources[0] == bindingHandle
         else pipeline.vulkan.handle == pipelineHandle &&
                pipeline.binding.vulkan.descriptorSet == bindingHandle)
    val uniformRange = pipeline.binding.entries.size == 2 &&
        pipeline.binding.entries[1].offset ==
            transformPool.allocationOffset(transformAllocation) &&
        pipeline.binding.entries[1].size == 64 &&
        pipeline.binding.entries[1].offset > 0
    val passed = if (automated) running && explorer.ready() &&
        explorer.movements >= (if (selfTest) 4 else 5) &&
        inputMatrixUpdates >= 1 && warmFrames == 2 && steadyFrames == 120 &&
        matrixUpdates >= 123 && presentedFrames >= 124 &&
        framesPerSecond >= 30 &&
        uniformRange && noGrowth && handlesStable
    else !running && uniformRange && handlesStable
    println(
        "Cube explorer ${graphicsBackendName(app.backend)}: camera=true input=${explorer.forward}/${explorer.backward}/${explorer.left}/${explorer.right} movements=${explorer.movements} inputMatrices=$inputMatrixUpdates matrices=$matrixUpdates steady=$steadyFrames rate=$framesPerSecond frames=$presentedFrames uniformRange=$uniformRange/${pipeline.binding.entries[1].offset}/64 depth=${pipeline.depth.enabled}/${pipeline.depth.write} repeatNoGrowth=$noGrowth handlesStable=$handlesStable liveDelta=${liveAfter - liveBefore} adapter=${app.adapterName} passed=$passed"
    )
    if (passed) 0 else 1
}
