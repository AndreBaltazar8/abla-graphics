import "abla/io"
import "abla/process/arguments"
import "abla/runtime/memory"
import "../../src/graphics.ab"

fun main: int {
    val requested = if (processArgumentCount() > 0)
        processArgument(0)
    else "auto"
    val backend = if (requested == "opengl") graphicsBackendOpenGl
        else if (requested == "vulkan") graphicsBackendVulkan
        else graphicsBackendAuto
    val app = graphicsApplication(
        GraphicsConfig(backend = backend, framesInFlight = 2),
        WindowConfig(
            title = "Abla Graphics textured triangle",
            width = 640,
            height = 480
        )
    )
    val shader = $glsl {
        vertex {
            #version 450
            layout(location = 0) in vec2 position;
            layout(location = 1) in vec2 uv;
            layout(location = 0) out vec2 texCoord;
            void main() {
                gl_Position = vec4(position, 0.0, 1.0);
                texCoord = uv;
            }
        }
        fragment {
            #version 450
            layout(location = 0) in vec2 texCoord;
            layout(location = 0) out vec4 color;
            layout(binding = 0) uniform sampler2D atlas;
            void main() {
                color = texture(atlas, texCoord);
            }
        }
    }
    val vertexBytes = bufferBytes(48)
    val verticesStored =
        vertexBytes.storeF32(-0.8, 0) &&
        vertexBytes.storeF32(-0.7, 4) &&
        vertexBytes.storeF32(0.0, 8) &&
        vertexBytes.storeF32(0.0, 12) &&
        vertexBytes.storeF32(0.8, 16) &&
        vertexBytes.storeF32(-0.7, 20) &&
        vertexBytes.storeF32(1.0, 24) &&
        vertexBytes.storeF32(0.0, 28) &&
        vertexBytes.storeF32(0.0, 32) &&
        vertexBytes.storeF32(0.8, 36) &&
        vertexBytes.storeF32(0.5, 40) &&
        vertexBytes.storeF32(1.0, 44)
    val vertices = app.buffer(BufferDescriptor(
        label = "textured-triangle-vertices",
        size = 48,
        usage = bufferUsageVertex | bufferUsageCopyDestination
    ))
    val verticesUploaded = verticesStored &&
        vertices.writeAllBytes(vertexBytes)
    val indexBytes = bufferBytes(12)
    val indicesStored = indexBytes.storeU32(0, 0) &&
        indexBytes.storeU32(1, 4) && indexBytes.storeU32(2, 8)
    val indices = app.buffer(BufferDescriptor(
        label = "textured-triangle-indices",
        size = 12,
        usage = bufferUsageIndex | bufferUsageCopyDestination
    ))
    val indicesUploaded = indicesStored && indices.writeAllBytes(indexBytes)
    val pixels = pixelBuffer(2, 2)
    val pixelsReady = pixels.setRgba8(0, 0, 240, 55, 75) &&
        pixels.setRgba8(1, 0, 35, 210, 120) &&
        pixels.setRgba8(0, 1, 40, 105, 245) &&
        pixels.setRgba8(1, 1, 245, 205, 45)
    val texture = app.texture(TextureDescriptor(
        label = "textured-triangle-atlas",
        size = Extent3D(2, 2),
        format = textureFormatRgba8Unorm,
        usage = textureUsageSampled | textureUsageCopyDestination
    ))
    val uploaded = pixelsReady &&
        texture.writePixels(pixels, TextureWriteDescriptor())
    val sampler = app.sampler(SamplerDescriptor(
        magFilter = samplerFilterNearest,
        minFilter = samplerFilterNearest,
        mipmapFilter = samplerFilterNearest
    ))
    val binding = app.textureBinding(texture, sampler)
    val bindingHandle = if (app.backend == graphicsBackendOpenGl)
        binding.openGlTexture
    else binding.vulkan.descriptorSet
    val pipeline = app.renderPipeline(
        shader,
        VertexBufferLayout(16, [
            VertexAttribute(0, 0, vertexFormatFloat32x2),
            VertexAttribute(1, 8, vertexFormatFloat32x2)
        ]),
        RasterPipelineState(),
        DepthStencilState(),
        move(binding)
    )
    val missingBinding = app.renderPipeline(
        shader,
        VertexBufferLayout(16, [
            VertexAttribute(0, 0, vertexFormatFloat32x2),
            VertexAttribute(1, 8, vertexFormatFloat32x2)
        ])
    )
    val clear = Color(0.015, 0.02, 0.035)
    val warmed = app.valid() && shader.valid && vertices.valid() &&
        indices.valid() && texture.valid() && sampler.valid() &&
        verticesUploaded && indicesUploaded && uploaded && pipeline.valid() &&
        !missingBinding.valid() && missingBinding.error.code ==
            graphicsErrorInvalidConfiguration &&
        app.presentRenderIndexed(pipeline, vertices, indices, 3, clear)
    val pipelineHandle = if (app.backend == graphicsBackendOpenGl)
        pipeline.openGl.handle else pipeline.vulkan.handle
    val liveBefore = runtimeMemoryLiveBytes()
    var presented = warmed
    var frame = 0
    while (presented && frame < 4) {
        presented = app.presentRenderIndexed(
            pipeline,
            vertices,
            indices,
            3,
            clear
        )
        frame = frame + 1
    }
    val liveAfter = runtimeMemoryLiveBytes()
    val noGrowth = liveBefore == liveAfter
    val handlesStable = bindingHandle != 0 &&
        (if (app.backend == graphicsBackendOpenGl)
            pipeline.openGl.handle == pipelineHandle &&
                pipeline.binding.openGlTexture == bindingHandle
         else pipeline.vulkan.handle == pipelineHandle &&
                pipeline.binding.vulkan.descriptorSet == bindingHandle)
    var resized = app.resize(512, 384)
    var resizeEvent = WindowEvent()
    var resizePoll = 0
    while (resized && resizeEvent.kind != windowEventResized &&
        resizePoll < 32) {
        resizeEvent = app.pollEvent(50)
        resizePoll = resizePoll + 1
    }
    resized = resized && resizeEvent.first == 512 &&
        resizeEvent.second == 384 &&
        app.presentRenderIndexed(pipeline, vertices, indices, 3, clear) &&
        (if (app.backend == graphicsBackendOpenGl)
            pipeline.binding.openGlTexture == bindingHandle
         else pipeline.binding.vulkan.descriptorSet == bindingHandle &&
            pipeline.vulkan.width == 512 && pipeline.vulkan.height == 384)
    println(
        "Common textured ${graphicsBackendName(app.backend)}: frames=$frame, binding=$bindingHandle, repeatNoGrowth=$noGrowth, handlesStable=$handlesStable, resized=$resized, liveDelta=${liveAfter - liveBefore} on ${app.adapterName}"
    )
    if (presented && frame == 4 && noGrowth && handlesStable && resized) 0
    else 1
}
