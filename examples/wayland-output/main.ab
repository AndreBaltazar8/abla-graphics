import "../../src/graphics.ab"
import "abla/io"

trusted fun main: int {
    val window = waylandXdgWindow(
        "Abla Graphics output",
        "io.abla.graphics.wayland-output",
        640,
        480
    )
    val succeeded = window.valid() && window.enableOutputs()
    val monitor = window.primaryMonitor()
    if (succeeded) println(
        "wayland-output: outputs=${window.outputs.size} name=${monitor.name} mode=${monitor.width}x${monitor.height} physical=${monitor.widthMillimeters}x${monitor.heightMillimeters} scale=${window.primaryOutputScale()}"
    )
    if (succeeded && monitor.valid()) 0 else 1
}
