import "../../src/graphics.ab"
import "abla/io"

trusted fun main: int {
    val window = waylandXdgWindow(
        "Abla Graphics clipboard — C copies, V pastes",
        "io.abla.graphics.wayland-clipboard",
        640,
        360
    )
    var succeeded = window.valid() &&
        window.createSharedBuffers(640, 360, 2) &&
        window.clearSharedPixels(20, 28, 48) &&
        window.fillSharedRect(80, 100, 480, 160, 54, 211, 153) &&
        window.presentSharedPixels() && window.waitFrame() &&
        window.enableClipboard()
    println("wayland-clipboard: press C to copy, V to paste, Escape to quit")
    var running = succeeded
    while (running && succeeded) {
        val event = window.pollInputEvent(100)
        if (event.kind == windowEventCloseRequested ||
            (event.kind == windowEventKey && event.key() == keyEscape &&
             event.keyPressed())) {
            running = false
        } else if (event.kind == windowEventKey && event.key() == keyC &&
            event.keyPressed() && !event.keyRepeated()) {
            succeeded = window.setClipboard(
                "Copied by pure-Abla Wayland"
            )
            println("wayland-clipboard: copied=$succeeded")
        } else if (event.kind == windowEventKey && event.key() == keyV &&
            event.keyPressed() && !event.keyRepeated()) {
            window.requestClipboard()
        } else if (event.kind == windowEventClipboard) {
            println(
                "wayland-clipboard: pasted=${event.clipboardSucceeded()} text=${event.clipboardText()}"
            )
        }
        succeeded = succeeded && window.connection.valid()
    }
    if (succeeded) 0 else 1
}
