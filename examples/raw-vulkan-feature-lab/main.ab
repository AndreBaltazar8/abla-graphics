import "abla/io"
import "../../src/raw/vulkan.ab"
import "../../src/graphics.ab"

trusted fun main: int {
    val app = graphicsApplication(
        GraphicsConfig(
            backend = graphicsBackendVulkan,
            validation = true
        ),
        WindowConfig(
            title = "Abla raw Vulkan feature lab",
            width = 160,
            height = 120,
            visible = false
        )
    )
    var passed = false
    var detail = "unavailable"
    if (app.valid() && app.backend == graphicsBackendVulkan) {
        val matrix = app.rawVulkanApi().featureMatrix()
        passed = matrix.complete() &&
            matrix.totalCommands == 842 &&
            matrix.contextCommands == 0 &&
            matrix.globalCommands > 0 &&
            matrix.instanceCommands > 0 &&
            matrix.deviceCommands > 0 &&
            matrix.globalCommands + matrix.instanceCommands +
                matrix.deviceCommands == matrix.totalCommands &&
            matrix.corePathCommands > 0 &&
            matrix.extensionPathCommands > 0
        detail =
            "total=${matrix.totalCommands} metadata=${matrix.metadataCommands} core=${matrix.corePathCommands} extension=${matrix.extensionPathCommands} advertised=${matrix.advertisedCommands} supported=${matrix.supportedCommands} scopes=${matrix.globalCommands}/${matrix.instanceCommands}/${matrix.deviceCommands} invalid=${matrix.firstInvalidMetadata} unresolved=${matrix.firstAdvertisedUnresolved}"
    }
    println("raw-vulkan-feature-lab: $detail complete=$passed")
    if (passed) 0 else 1
}
