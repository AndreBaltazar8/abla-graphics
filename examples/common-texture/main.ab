import "abla/io"
import "abla/process/arguments"
import "abla/runtime/memory"
import "../../src/graphics.ab"

fun main: int {
    val requested = if (processArgumentCount() > 0)
        processArgument(0)
    else "vulkan"
    val backend = if (requested == "opengl")
        graphicsBackendOpenGl
    else graphicsBackendVulkan
    val app = graphicsApplication(
        GraphicsConfig(backend = backend),
        WindowConfig(
            title = "Abla Graphics common texture",
            width = 480,
            height = 270
        )
    )
    val color = app.texture(TextureDescriptor(
        label = "sample-color",
        size = Extent3D(256, 256),
        mipLevels = 9,
        format = textureFormatRgba8UnormSrgb,
        usage = textureUsageSampled | textureUsageCopySource |
            textureUsageCopyDestination
    ))
    val pixels = pixelBuffer(2, 2)
    val pixelsReady = pixels.clearRgba8(23, 47, 89, 131) &&
        pixels.setRgba8(1, 1, 149, 167, 191, 211)
    val writeRegion = TextureWriteDescriptor(2, 7, 9)
    val uploaded = pixelsReady && color.writePixels(pixels, writeRegion)
    val readback = color.rgba8(8, 10, 2)
    val copyDestination = app.texture(TextureDescriptor(
        label = "sample-copy-destination",
        size = Extent3D(256, 256),
        mipLevels = 9,
        format = textureFormatRgba8UnormSrgb,
        usage = textureUsageSampled | textureUsageCopySource |
            textureUsageCopyDestination
    ))
    val copyRegion = TextureCopyDescriptor(2, 7, 9, 1, 3, 5, 2, 2)
    val gpuCopied = app.copyTexture(color, copyDestination, copyRegion)
    val copiedReadback = copyDestination.rgba8(4, 6, 1)
    val transferPoolBefore = app.vulkanDevice.transferPool
    val transferCommandBefore = if (
        app.backend == graphicsBackendVulkan &&
        !app.vulkanDevice.transferCommand.closed
    ) nativePointerAddress(app.vulkanDevice.transferCommand.load()) else 0
    val textureCommandPoolBefore = color.vulkan.commandPool
    val textureCommandBefore = if (
        app.backend == graphicsBackendVulkan && !color.vulkan.command.closed
    ) nativePointerAddress(color.vulkan.command.load()) else 0
    val liveBeforeCopies = runtimeMemoryLiveBytes()
    var copiesRepeated = gpuCopied
    var copyIndex = 0
    while (copiesRepeated && copyIndex < 4) {
        copiesRepeated = color.writePixels(pixels, writeRegion) &&
            color.rgba8(8, 10, 2) == 3552552853 &&
            app.copyTexture(color, copyDestination, copyRegion)
        copyIndex = copyIndex + 1
    }
    val liveAfterCopies = runtimeMemoryLiveBytes()
    val transferStateStable = app.backend != graphicsBackendVulkan ||
        (app.vulkanDevice.transferPool == transferPoolBefore &&
         nativePointerAddress(app.vulkanDevice.transferCommand.load()) ==
            transferCommandBefore &&
         color.vulkan.commandPool == textureCommandPoolBefore &&
         nativePointerAddress(color.vulkan.command.load()) ==
            textureCommandBefore)
    val copiesNoGrowth = liveAfterCopies == liveBeforeCopies
    val generatedTexture = app.texture(TextureDescriptor(
        label = "sample-generated-mipmaps",
        size = Extent3D(8, 8),
        mipLevels = 4,
        format = textureFormatBgra8Unorm,
        usage = textureUsageSampled | textureUsageCopySource |
            textureUsageCopyDestination
    ))
    val generatedPixels = pixelBuffer(8, 8)
    val generatedUploaded = generatedPixels.clearRgba8(17, 31, 47, 61) &&
        generatedTexture.writePixels(
            generatedPixels,
            TextureWriteDescriptor()
        )
    val mipmapsGenerated = generatedUploaded &&
        generatedTexture.generateMipmaps()
    val generatedLastPixel = generatedTexture.rgba8(0, 0, 3)
    val generatedOpenGlHandle = generatedTexture.openGl.handle
    val generatedVulkanImage = generatedTexture.vulkan.image
    val generatedVulkanPool = generatedTexture.vulkan.commandPool
    val generatedVulkanCommand = if (
        app.backend == graphicsBackendVulkan &&
        !generatedTexture.vulkan.command.closed
    ) nativePointerAddress(generatedTexture.vulkan.command.load()) else 0
    val mipmapLiveBefore = runtimeMemoryLiveBytes()
    var mipmapsRepeated = mipmapsGenerated
    var mipmapIndex = 0
    while (mipmapsRepeated && mipmapIndex < 4) {
        mipmapsRepeated = generatedTexture.generateMipmaps()
        mipmapIndex = mipmapIndex + 1
    }
    val mipmapLiveAfter = runtimeMemoryLiveBytes()
    val mipmapsNoGrowth = mipmapLiveAfter == mipmapLiveBefore
    val mipmapHandlesStable = if (app.backend == graphicsBackendOpenGl)
        generatedTexture.openGl.handle == generatedOpenGlHandle
    else generatedTexture.vulkan.image == generatedVulkanImage &&
        generatedTexture.vulkan.commandPool == generatedVulkanPool &&
        nativePointerAddress(generatedTexture.vulkan.command.load()) ==
            generatedVulkanCommand
    val colorView = color.view()
    val depth = app.texture(TextureDescriptor(
        label = "sample-depth",
        size = Extent3D(256, 256),
        format = textureFormatDepth16Unorm,
        usage = textureUsageSampled | textureUsageRenderAttachment
    ))
    val depthView = depth.view(TextureViewDescriptor(
        aspect = textureAspectDepth
    ))
    val passed = app.valid() && color.valid() && copyDestination.valid() &&
        colorView.valid() &&
        colorView.descriptor.resolvedMipLevelCount(color.descriptor) == 9 &&
        uploaded && readback == 3552552853 &&
        gpuCopied && copiedReadback == 3552552853 && copiesRepeated &&
        transferStateStable && copiesNoGrowth &&
        generatedTexture.valid() && mipmapsGenerated && mipmapsRepeated &&
        mipmapIndex == 4 && generatedLastPixel == 1026498321 &&
        mipmapsNoGrowth && mipmapHandlesStable &&
        depth.valid() && depthView.valid() &&
        !depth.generateMipmaps() &&
        app.presentClear(Color(
            0.0625,
            0.1875,
            0.4375
        ))
    println(
        "Common texture ${graphicsBackendName(app.backend)}: color mips=${color.descriptor.mipLevels}, upload=${uploaded}, readback=${readback}, gpuCopy=${gpuCopied}, copyReadback=${copiedReadback}, generatedMips=${generatedTexture.descriptor.mipLevels}/$generatedLastPixel, repeatNoGrowth=${copiesNoGrowth && mipmapsNoGrowth}, liveDelta=${liveAfterCopies - liveBeforeCopies}/${mipmapLiveAfter - mipmapLiveBefore}, depth view on ${app.adapterName}"
    )
    if (passed) 0 else 1
}
