import "abla/io"
import "abla/process/arguments"
import "abla/runtime/memory"
import "../../src/graphics.ab"

fun main: int {
    val requested = if (processArgumentCount() > 0)
        processArgument(0)
    else "auto"
    val backend = if (requested == "opengl") graphicsBackendOpenGl
        else if (requested == "vulkan") graphicsBackendVulkan
        else graphicsBackendAuto
    val app = graphicsApplication(
        GraphicsConfig(backend = backend, framesInFlight = 2),
        WindowConfig(
            title = "Abla Graphics HDR PBR",
            width = 640,
            height = 360
        )
    )
    val pbrShader = $glsl {
        vertex {
            #version 450
            layout(location = 0) out vec2 texCoord;
            const vec2 positions[3] = vec2[3](
                vec2(-0.75, -0.65),
                vec2(0.75, -0.65),
                vec2(0.0, 0.75)
            );
            const vec2 texCoords[3] = vec2[3](
                vec2(0.0, 0.0),
                vec2(1.0, 0.0),
                vec2(0.0, 1.0)
            );
            void main() {
                gl_Position = vec4(positions[gl_VertexID], 0.0, 1.0);
                texCoord = texCoords[gl_VertexID];
            }
        }
        fragment {
            #version 450
            layout(location = 0) in vec2 texCoord;
            layout(location = 0) out vec4 color;
            layout(push_constant) uniform Pbr {
                vec4 baseColor;
                vec4 material;
                vec4 lightDirectionIntensity;
                vec4 lightColor;
            } pbr;
            void main() {
                vec3 normal = normalize(vec3(
                    texCoord.x * 2.0 - 1.0,
                    texCoord.y * 2.0 - 1.0,
                    1.0
                ));
                vec3 lightDirection = normalize(
                    -pbr.lightDirectionIntensity.xyz
                );
                vec3 halfway = normalize(
                    lightDirection + vec3(0.0, 0.0, 1.0)
                );
                float diffuseTerm = max(dot(normal, lightDirection), 0.0);
                float specularTerm = pow(
                    max(dot(normal, halfway), 0.0),
                    mix(256.0, 8.0, pbr.material.y)
                );
                vec3 f0 = mix(
                    vec3(0.04), pbr.baseColor.rgb, pbr.material.x
                );
                vec3 diffuseSpecular = pbr.baseColor.rgb *
                    (1.0 - pbr.material.x) * diffuseTerm +
                    f0 * specularTerm;
                vec3 lit = diffuseSpecular * pbr.lightColor.rgb *
                    pbr.lightDirectionIntensity.w + pbr.baseColor.rgb *
                    (0.03 * pbr.material.z + pbr.material.w) + vec3(0.02);
                color = vec4(lit, 1.0);
            }
        }
    }
    val toneShader = $glsl {
        vertex {
            #version 450
            layout(location = 0) out vec2 texCoord;
            const vec2 positions[3] = vec2[3](
                vec2(-0.75, -0.65),
                vec2(0.75, -0.65),
                vec2(0.0, 0.75)
            );
            const vec2 texCoords[3] = vec2[3](
                vec2(0.0, 0.0),
                vec2(1.0, 0.0),
                vec2(0.0, 1.0)
            );
            void main() {
                gl_Position = vec4(positions[gl_VertexID], 0.0, 1.0);
                texCoord = texCoords[gl_VertexID];
            }
        }
        fragment {
            #version 450
            layout(location = 0) in vec2 texCoord;
            layout(location = 0) out vec4 color;
            layout(binding = 0) uniform sampler2D hdrScene;
            layout(push_constant) uniform Tone {
                float exposure;
                float gamma;
            } tone;
            void main() {
                vec3 hdr = texture(hdrScene, texCoord).rgb * tone.exposure;
                vec3 mapped = hdr / (hdr + vec3(1.0));
                vec3 corrected = pow(
                    mapped, vec3(1.0 / tone.gamma)
                );
                color = vec4(corrected, 1.0);
            }
        }
    }
    val hdrTarget = app.renderTarget(app.texture(TextureDescriptor(
        label = "hdr-pbr-scene",
        size = Extent3D(128, 128),
        format = textureFormatRgba16Float,
        usage = textureUsageRenderAttachment | textureUsageSampled
    )))
    val toneTarget = app.renderTarget(app.texture(TextureDescriptor(
        label = "hdr-pbr-tone-map",
        size = Extent3D(128, 128),
        format = textureFormatRgba8Unorm,
        usage = textureUsageRenderAttachment | textureUsageCopySource
    )))
    val pbrPipeline = app.renderTargetPipeline(hdrTarget, pbrShader)
    val sampler = app.sampler(SamplerDescriptor(
        magFilter = samplerFilterNearest,
        minFilter = samplerFilterNearest,
        mipmapFilter = samplerFilterNearest
    ))
    val toneTargetBinding = app.bindGroup([
        app.sampledTextureEntry(
            0, shaderVisibilityFragment, hdrTarget.texture, sampler
        )
    ])
    val toneTargetPipeline = app.renderTargetPipeline(
        toneTarget,
        toneShader,
        VertexBufferLayout(),
        RasterPipelineState(),
        DepthStencilState(),
        move(toneTargetBinding)
    )
    val windowBinding = app.bindGroup([
        app.sampledTextureEntry(
            0, shaderVisibilityFragment, hdrTarget.texture, sampler
        )
    ])
    val windowPipeline = app.renderPipeline(
        toneShader,
        VertexBufferLayout(),
        RasterPipelineState(),
        DepthStencilState(),
        move(windowBinding)
    )
    val pbrValues = pbrShader.pushConstants()
    val toneValues = toneShader.pushConstants()
    val parameters = PbrParameters(
        PbrMaterial(
            baseColor = Color(0.82, 0.22, 0.08),
            metallic = 0.65,
            roughness = 0.28,
            ambientOcclusion = 1.0,
            emissiveStrength = 0.04
        ),
        PbrDirectionalLight(
            direction = Vec3(-0.4, -0.7, -1.0),
            color = Color(1.0, 0.92, 0.78),
            intensity = 6.0
        )
    )
    val tone = HdrToneMapping(exposure = 1.15, gamma = 2.2)
    val contracts = parameters.valid() && tone.valid() &&
        !PbrMaterial(roughness = 0.0).valid() &&
        !PbrDirectionalLight(direction = Vec3(0.0, 0.0, 0.0)).valid() &&
        !HdrToneMapping(exposure = 0.0).valid() &&
        !toneValues.storePbr(parameters) &&
        !pbrValues.storeHdrToneMapping(tone)
    val initialized = app.valid() && pbrShader.valid && toneShader.valid &&
        hdrTarget.valid() && toneTarget.valid() && pbrPipeline.valid() &&
        toneTargetPipeline.valid() && windowPipeline.valid() &&
        sampler.valid() && contracts && pbrValues.storePbr(parameters) &&
        toneValues.storeHdrToneMapping(tone)
    val hdrClear = Color(0.0, 0.0, 0.0)
    val displayClear = Color(0.01, 0.01, 0.015)
    var rendered = initialized && app.renderPushToTarget(
        hdrTarget, pbrPipeline, pbrValues, hdrClear
    ) && app.renderPushToTarget(
        toneTarget, toneTargetPipeline, toneValues, displayClear
    ) && app.presentPushRender(windowPipeline, toneValues, displayClear)
    var warmFrame = 0
    while (rendered && warmFrame < 4) {
        rendered = app.renderPushToTarget(
            hdrTarget, pbrPipeline, pbrValues, hdrClear
        ) && app.renderPushToTarget(
            toneTarget, toneTargetPipeline, toneValues, displayClear
        ) && app.presentPushRender(windowPipeline, toneValues, displayClear)
        warmFrame = warmFrame + 1
    }
    val firstPixel = if (rendered) toneTarget.texture.rgba8(64, 48) else -1
    val liveBefore = runtimeMemoryLiveBytes()
    var frame = 0
    while (rendered && frame < 4) {
        rendered = app.renderPushToTarget(
            hdrTarget, pbrPipeline, pbrValues, hdrClear
        ) && app.renderPushToTarget(
            toneTarget, toneTargetPipeline, toneValues, displayClear
        ) && app.presentPushRender(windowPipeline, toneValues, displayClear) &&
            toneTarget.texture.rgba8(64, 48) == firstPixel
        frame = frame + 1
    }
    val liveAfter = runtimeMemoryLiveBytes()
    val hdrHandle = if (app.backend == graphicsBackendOpenGl)
        hdrTarget.texture.openGl.handle else hdrTarget.texture.vulkan.image
    val stable = rendered && frame == 4 && firstPixel >= 0 &&
        firstPixel != 4278190080 && liveAfter == liveBefore &&
        hdrHandle != 0
    println(
        "hdr-pbr ${graphicsBackendName(app.backend)}: configured=$initialized pixel=$firstPixel frames=$frame live=${liveAfter - liveBefore} stable=$stable"
    )
    if (stable) 0 else 1
}
