import "../../src/graphics.ab"
import "abla/io"

trusted fun main: int {
    val window = waylandXdgWindow(
        "Abla Graphics shared pixels",
        "io.abla.graphics.wayland-pixels",
        640,
        480
    )
    var succeeded = window.valid() && window.createSharedBuffer(640, 480)
    if (succeeded) succeeded = window.clearSharedPixels(18, 28, 48)
    var y = 120
    while (succeeded && y < 360) {
        var x = 160
        while (x < 480) {
            val alternate = ((x / 32) + (y / 32)) & 1
            succeeded = window.fillSharedRect(
                x,
                y,
                32,
                32,
                if (alternate == 0) 44 else 238,
                if (alternate == 0) 202 else 94,
                if (alternate == 0) 224 else 126
            )
            x = x + 32
        }
        y = y + 32
    }
    if (succeeded) succeeded = window.presentSharedPixels()
    if (succeeded) succeeded = window.waitFrame()
    if (succeeded) println(
        "wayland-pixels: frame=${window.frameComplete} size=${window.bufferWidth}x${window.bufferHeight} bytes=${window.mappedLength}"
    )
    if (succeeded) 0 else 1
}
