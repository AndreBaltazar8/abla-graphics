import "abla/float"
import "abla/io"
import "abla/process/arguments"
import "abla/runtime/memory"
import "../../src/graphics.ab"

fun main: int {
    val requested = if (processArgumentCount() > 0)
        processArgument(0)
    else "auto"
    val backend = if (requested == "opengl") graphicsBackendOpenGl
        else if (requested == "vulkan") graphicsBackendVulkan
        else graphicsBackendAuto
    val app = graphicsApplication(
        GraphicsConfig(
            backend = backend,
            requiredFeatures = graphicsFeatureTimestampQueries
        ),
        WindowConfig(
            title = "Abla Graphics GPU timestamp",
            width = 640,
            height = 360
        )
    )
    val query = app.timestampQuery()
    val first = query.sampleTicks()
    val queryLiveBefore = runtimeMemoryLiveBytes()
    val warmSecond = query.sampleTicks()
    val warmThird = query.sampleTicks()
    val queryLiveAfter = runtimeMemoryLiveBytes()
    val clear = Color(0.08, 0.18, 0.32)
    val liveBefore = runtimeMemoryLiveBytes()
    var presented = app.valid() && query.valid()
    var frame = 0
    while (presented && frame < 4) {
        presented = app.presentClear(clear)
        frame = frame + 1
    }
    val last = query.sampleTicks()
    val liveAfter = runtimeMemoryLiveBytes()
    val repeatLiveBefore = runtimeMemoryLiveBytes()
    val repeated = query.sampleTicks() >= last && query.sampleTicks() >= last
    val repeatLiveAfter = runtimeMemoryLiveBytes()
    val elapsed = query.elapsedNanoseconds(first, last)
    val succeeded = presented && frame == 4 && first >= 0 && last >= first &&
        warmSecond >= first && warmThird >= warmSecond &&
        queryLiveAfter == queryLiveBefore && elapsed > 0.0 && repeated &&
        liveAfter == liveBefore && repeatLiveAfter == repeatLiveBefore
    println(
        "GPU timestamp ${graphicsBackendName(app.backend)}: frames=$frame ticks=$first..$last periodBits=${f64ToBits(query.periodNanoseconds)} elapsedBits=${f64ToBits(elapsed)} queryLiveDelta=${queryLiveAfter - queryLiveBefore}/${repeatLiveAfter - repeatLiveBefore} frameLiveDelta=${liveAfter - liveBefore}"
    )
    if (succeeded) 0 else 1
}
