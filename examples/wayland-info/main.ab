import "../../src/graphics.ab"
import "abla/io"

fun main: int {
    val connection = waylandConnection()
    val compositor = connection.global("wl_compositor")
    val sharedMemory = connection.global("wl_shm")
    val shell = connection.global("xdg_wm_base")
    if (connection.valid()) {
        println(
            "wayland: globals=${connection.globals.size} compositor=${compositor.version} shm=${sharedMemory.version} xdg=${shell.version}"
        )
    }
    if (connection.valid() && compositor.valid &&
        sharedMemory.valid && shell.valid) 0 else 1
}
