import "abla/io"
import "abla/process/arguments"
import "abla/runtime/memory"
import "../../src/graphics.ab"

fun main: int {
    val requested = if (processArgumentCount() > 0)
        processArgument(0)
    else "auto"
    val backend = if (requested == "opengl") graphicsBackendOpenGl
        else if (requested == "vulkan") graphicsBackendVulkan
        else graphicsBackendAuto
    val app = graphicsApplication(
        GraphicsConfig(
            backend = backend,
            framesInFlight = 2,
            requiredFeatures = graphicsFeaturePersistentMapping
        ),
        WindowConfig(
            title = "Abla Graphics render to texture",
            width = 640,
            height = 480
        )
    )
    val sceneShader = $glsl {
        vertex {
            #version 450
            layout(location = 0) in vec2 position;
            void main() {
                gl_Position = vec4(position, 0.0, 1.0);
            }
        }
        fragment {
            #version 450
            layout(location = 0) out vec4 color;
            void main() {
                color = vec4(0.12, 0.54, 0.96, 1.0);
            }
        }
    }
    val postShader = $glsl {
        vertex {
            #version 450
            layout(location = 0) in vec2 position;
            layout(location = 1) in vec2 uv;
            layout(location = 0) out vec2 texCoord;
            void main() {
                gl_Position = vec4(position, 0.0, 1.0);
                texCoord = uv;
            }
        }
        fragment {
            #version 450
            layout(location = 0) in vec2 texCoord;
            layout(location = 0) out vec4 color;
            layout(binding = 0) uniform sampler2D atlas;
            void main() {
                color = texture(atlas, texCoord);
            }
        }
    }
    val color = app.texture(TextureDescriptor(
        label = "post-process-multisample-color",
        size = Extent3D(256, 256),
        samples = 4,
        format = textureFormatRgba8Unorm,
        usage = textureUsageRenderAttachment
    ))
    val depth = app.texture(TextureDescriptor(
        label = "post-process-multisample-depth",
        size = Extent3D(256, 256),
        samples = 4,
        format = textureFormatDepth32Float,
        usage = textureUsageRenderAttachment
    ))
    val resolvedColor = app.texture(TextureDescriptor(
        label = "post-process-resolved-color",
        size = Extent3D(256, 256),
        format = textureFormatRgba8Unorm,
        usage = textureUsageRenderAttachment | textureUsageSampled |
            textureUsageCopyDestination | textureUsageCopySource
    ))
    val target = app.renderTargetWithDepth(
        move(color),
        move(depth),
        [move(resolvedColor)]
    )
    val sceneLayout = VertexBufferLayout(8, [
        VertexAttribute(0, 0, vertexFormatFloat32x2)
    ])
    val scenePipeline = app.renderTargetPipeline(
        target,
        sceneShader,
        sceneLayout,
        RasterPipelineState(),
        DepthStencilState(
            enabled = true,
            write = true,
            compare = compareFunctionLess
        )
    )
    val scenePool = app.bufferPool(BufferPoolDescriptor(
        label = "offscreen-scene-pool",
        capacity = 256,
        blockSize = 16,
        maximumAllocations = 8,
        usage = bufferUsageCopySource | bufferUsageCopyDestination |
            bufferUsageVertex | bufferUsageIndex | bufferUsageIndirect
    ))
    val scenePrefix = scenePool.allocate(16)
    val sceneVertices = scenePool.allocate(24, 4)
    val sceneIndices = scenePool.allocate(12, 4)
    val sceneDraw = scenePool.allocate(16, 4)
    val sceneIndexedDraw = scenePool.allocate(20, 4)
    val sceneVertexBytes = bufferBytes(24)
    val sceneVerticesStored =
        sceneVertexBytes.storeF32(-0.75, 0) &&
        sceneVertexBytes.storeF32(-0.65, 4) &&
        sceneVertexBytes.storeF32(0.75, 8) &&
        sceneVertexBytes.storeF32(-0.65, 12) &&
        sceneVertexBytes.storeF32(0.0, 16) &&
        sceneVertexBytes.storeF32(0.75, 20)
    val sceneIndexBytes = bufferBytes(12)
    val sceneIndicesStored = sceneIndexBytes.storeU32(0, 0) &&
        sceneIndexBytes.storeU32(1, 4) &&
        sceneIndexBytes.storeU32(2, 8)
    val sceneDrawBytes = bufferBytes(16)
    val sceneDrawStored = sceneDrawBytes.storeI64(4294967299, 0) &&
        sceneDrawBytes.storeI64(0, 8)
    val sceneIndexedDrawBytes = bufferBytes(20)
    val sceneIndexedDrawStored =
        sceneIndexedDrawBytes.storeI64(4294967299, 0) &&
        sceneIndexedDrawBytes.storeI64(
            scenePool.allocationOffset(sceneIndices) / 4,
            8
        ) && sceneIndexedDrawBytes.storeU32(0, 16)
    val sceneUploads = app.bufferTransferQueue(
        BufferTransferQueueDescriptor(
            label = "offscreen-scene-uploads",
            direction = bufferTransferDirectionUpload,
            slotCapacity = 32,
            slotCount = 4,
            alignment = 16
        )
    )
    val sceneVertexUpload = app.enqueueUploadBufferPoolRange(
        sceneUploads,
        sceneVertexBytes,
        scenePool,
        sceneVertices,
        0,
        0,
        24
    )
    val sceneIndexUpload = app.enqueueUploadBufferPoolRange(
        sceneUploads,
        sceneIndexBytes,
        scenePool,
        sceneIndices,
        0,
        0,
        12
    )
    val sceneDrawUpload = app.enqueueUploadBufferPoolRange(
        sceneUploads,
        sceneDrawBytes,
        scenePool,
        sceneDraw,
        0,
        0,
        16
    )
    val sceneIndexedDrawUpload = app.enqueueUploadBufferPoolRange(
        sceneUploads,
        sceneIndexedDrawBytes,
        scenePool,
        sceneIndexedDraw,
        0,
        0,
        20
    )
    val sceneUploaded = sceneVerticesStored && sceneIndicesStored &&
        sceneDrawStored && sceneIndexedDrawStored &&
        bufferTransferTicketValid(sceneVertexUpload) &&
        bufferTransferTicketValid(sceneIndexUpload) &&
        bufferTransferTicketValid(sceneDrawUpload) &&
        bufferTransferTicketValid(sceneIndexedDrawUpload) &&
        sceneUploads.wait(sceneVertexUpload) &&
        sceneUploads.wait(sceneIndexUpload) &&
        sceneUploads.wait(sceneDrawUpload) &&
        sceneUploads.wait(sceneIndexedDrawUpload)
    val vertexBytes = bufferBytes(48)
    val verticesStored =
        vertexBytes.storeF32(-1.0, 0) &&
        vertexBytes.storeF32(-1.0, 4) &&
        vertexBytes.storeF32(0.0, 8) &&
        vertexBytes.storeF32(0.0, 12) &&
        vertexBytes.storeF32(3.0, 16) &&
        vertexBytes.storeF32(-1.0, 20) &&
        vertexBytes.storeF32(2.0, 24) &&
        vertexBytes.storeF32(0.0, 28) &&
        vertexBytes.storeF32(-1.0, 32) &&
        vertexBytes.storeF32(3.0, 36) &&
        vertexBytes.storeF32(0.0, 40) &&
        vertexBytes.storeF32(2.0, 44)
    val vertices = app.buffer(BufferDescriptor(
        label = "post-process-triangle",
        size = 48,
        usage = bufferUsageVertex | bufferUsageCopyDestination
    ))
    val verticesUploaded = verticesStored &&
        vertices.writeAllBytes(vertexBytes)
    val sampler = app.sampler(SamplerDescriptor(
        magFilter = samplerFilterLinear,
        minFilter = samplerFilterLinear
    ))
    val binding = app.textureBinding(target.resolveTextures[0], sampler)
    val bindingHandle = if (app.backend == graphicsBackendOpenGl)
        binding.openGlResources[0]
    else binding.vulkan.descriptorSet
    val postPipeline = app.renderPipeline(
        postShader,
        VertexBufferLayout(16, [
            VertexAttribute(0, 0, vertexFormatFloat32x2),
            VertexAttribute(1, 8, vertexFormatFloat32x2)
        ]),
        RasterPipelineState(),
        DepthStencilState(),
        move(binding)
    )
    val sceneClear = Color(0.01, 0.015, 0.025)
    val sceneClearValues = renderPassClearValues(sceneClear, [], 1.0)
    val scenePass = app.renderPass(target, move(sceneClearValues))
    val windowClear = Color(0.0, 0.0, 0.0)
    val warmed = app.valid() && target.valid() && scenePipeline.valid() &&
        scenePass.valid() && postPipeline.valid() && vertices.valid() &&
        sampler.valid() && target.resolveTextures[0].valid() &&
        scenePool.valid() && scenePool.backing.deviceLocal() &&
        sceneUploads.valid() &&
        scenePool.allocationOffset(scenePrefix) == 0 &&
        scenePool.allocationOffset(sceneVertices) == 16 &&
        scenePool.allocationOffset(sceneIndices) == 48 &&
        scenePool.allocationOffset(sceneDraw) == 64 &&
        scenePool.allocationOffset(sceneIndexedDraw) == 80 &&
        verticesUploaded && sceneUploaded &&
        app.renderPassBufferPoolVerticesToTarget(
            target,
            scenePipeline,
            scenePass,
            scenePool,
            sceneVertices,
            3
        ) && app.renderPassBufferPoolVerticesIndirectToTarget(
            target,
            scenePipeline,
            scenePass,
            scenePool,
            sceneVertices,
            sceneDraw
        ) && app.renderPassBufferPoolIndexedToTarget(
            target,
            scenePipeline,
            scenePass,
            scenePool,
            sceneVertices,
            sceneIndices,
            3
        ) && app.renderPassBufferPoolIndexedIndirectToTarget(
            target,
            scenePipeline,
            scenePass,
            scenePool,
            sceneVertices,
            sceneIndices,
            sceneIndexedDraw
        ) && app.presentRenderVertices(
            postPipeline,
            vertices,
            3,
            windowClear
        ) && target.resolveTextures[0].rgba8(128, 128) == 4294281759
    val sceneHandle = if (app.backend == graphicsBackendOpenGl)
        scenePipeline.openGl.handle else scenePipeline.vulkan.handle
    val postHandle = if (app.backend == graphicsBackendOpenGl)
        postPipeline.openGl.handle else postPipeline.vulkan.handle
    val resolveHandle = if (app.backend == graphicsBackendOpenGl)
        target.openGl.resolveFramebuffer else target.vulkan.resolveViews[0]
    val poolHandle = if (app.backend == graphicsBackendOpenGl)
        scenePool.backing.openGl.handle else scenePool.backing.vulkan.handle
    val liveBefore = runtimeMemoryLiveBytes()
    var presented = warmed
    var frame = 0
    while (presented && frame < 4) {
        presented = app.renderPassBufferPoolVerticesToTarget(
            target,
            scenePipeline,
            scenePass,
            scenePool,
            sceneVertices,
            3
        ) && app.renderPassBufferPoolVerticesIndirectToTarget(
            target,
            scenePipeline,
            scenePass,
            scenePool,
            sceneVertices,
            sceneDraw
        ) && app.renderPassBufferPoolIndexedToTarget(
            target,
            scenePipeline,
            scenePass,
            scenePool,
            sceneVertices,
            sceneIndices,
            3
        ) && app.renderPassBufferPoolIndexedIndirectToTarget(
            target,
            scenePipeline,
            scenePass,
            scenePool,
            sceneVertices,
            sceneIndices,
            sceneIndexedDraw
        ) && app.presentRenderVertices(
            postPipeline,
            vertices,
            3,
            windowClear
        )
        frame = frame + 1
    }
    val liveAfter = runtimeMemoryLiveBytes()
    val noGrowth = liveAfter == liveBefore
    val handlesStable = bindingHandle != 0 && resolveHandle != 0 &&
        poolHandle != 0 &&
        (if (app.backend == graphicsBackendOpenGl)
            scenePipeline.openGl.handle == sceneHandle &&
                postPipeline.openGl.handle == postHandle &&
                target.openGl.resolveFramebuffer == resolveHandle &&
                postPipeline.binding.openGlResources[0] == bindingHandle &&
                scenePool.backing.openGl.handle == poolHandle
         else scenePipeline.vulkan.handle == sceneHandle &&
                postPipeline.vulkan.handle == postHandle &&
                target.vulkan.resolveViews.size == 1 &&
                target.vulkan.resolveViews[0] == resolveHandle &&
                postPipeline.binding.vulkan.descriptorSet == bindingHandle &&
                scenePool.backing.vulkan.handle == poolHandle)
    println(
        "Render to texture ${graphicsBackendName(app.backend)}: frames=$frame, target=256x256, samples=${target.texture.descriptor.samples}, depth=${target.hasDepth()}, resolved=true, sampled=true, pooled=true, offsets=${scenePool.allocationOffset(sceneVertices)}/${scenePool.allocationOffset(sceneIndices)}/${scenePool.allocationOffset(sceneDraw)}/${scenePool.allocationOffset(sceneIndexedDraw)}, repeatNoGrowth=$noGrowth, handlesStable=$handlesStable, liveDelta=${liveAfter - liveBefore} on ${app.adapterName}"
    )
    if (presented && frame == 4 && noGrowth && handlesStable) 0 else 1
}
