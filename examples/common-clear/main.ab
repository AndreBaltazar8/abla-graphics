import "abla/io"
import "../../src/graphics.ab"

fun main: int {
    val app = graphicsApplication(
        GraphicsConfig(backend = graphicsBackendAuto),
        WindowConfig(
            title = "Abla Graphics common clear",
            width = 800,
            height = 600
        )
    )
    val presented = app.valid() && app.presentClear(Color(
        0.15,
        0.45,
        0.85
    ))
    println(
        "Common ${graphicsBackendName(app.backend)} adapter: ${app.adapterName}"
    )
    app.pollEvent(250)
    if (presented) 0 else 1
}
