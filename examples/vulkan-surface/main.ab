import "abla/io"
import "../../src/platform/x11.ab"
import "../../src/driver/vulkan.ab"

fun main: int {
    val window = x11Window(WindowConfig(
        title = "Abla Vulkan surface",
        width = 800,
        height = 600,
        visible = true
    ))
    val instance = vulkanX11Instance("Abla Vulkan surface")
    val surface = vulkanX11Surface(instance, window)
    val adapters = instance.adapters()
    var selected = false
    var index = 0
    while (!selected && index < adapters.size) {
        val family = adapters[index].graphicsQueueFamily()
        if (adapters[index].supportsSurface(surface, family)) {
            val capabilities = adapters[index].surfaceCapabilities(surface)
            val device = adapters[index].deviceForSurface(surface)
            val swapchain = device.swapchain(adapters[index], surface)
            println(
                "Vulkan surface ${adapters[index].name}: ${swapchain.width}x${swapchain.height}, ${swapchain.images.size} images"
            )
            selected = capabilities.valid && device.valid() &&
                swapchain.valid() && device.presentBlue(swapchain)
        }
        index = index + 1
    }
    if (window.valid() && instance.valid() && surface.valid() && selected) 0
    else 1
}
