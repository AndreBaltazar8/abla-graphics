import "abla/io"
import "../../src/raw/opengl.ab"
import "../../src/graphics.ab"

trusted fun main: int {
    val app = graphicsApplication(
        GraphicsConfig(backend = graphicsBackendOpenGl),
        WindowConfig(
            title = "Abla raw OpenGL feature lab",
            width = 160,
            height = 120,
            visible = false
        )
    )
    var passed = false
    var detail = "unavailable"
    if (app.valid() && app.backend == graphicsBackendOpenGl) {
        val matrix = app.rawOpenGlApi().featureMatrix()
        passed = matrix.complete() &&
            matrix.totalCommands == 2892 &&
            matrix.contextCommands == matrix.totalCommands &&
            matrix.globalCommands == 0 &&
            matrix.instanceCommands == 0 &&
            matrix.deviceCommands == 0 &&
            matrix.corePathCommands > 0 &&
            matrix.extensionPathCommands > 0
        detail =
            "total=${matrix.totalCommands} metadata=${matrix.metadataCommands} core=${matrix.corePathCommands} extension=${matrix.extensionPathCommands} advertised=${matrix.advertisedCommands} supported=${matrix.supportedCommands} invalid=${matrix.firstInvalidMetadata} unresolved=${matrix.firstAdvertisedUnresolved}"
    }
    println("raw-opengl-feature-lab: $detail complete=$passed")
    if (passed) 0 else 1
}
