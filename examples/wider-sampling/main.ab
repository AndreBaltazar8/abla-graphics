import "abla/io"
import "abla/process/arguments"
import "abla/runtime/memory"
import "../../src/graphics.ab"

trusted fun fillRgba8(
    var bytes: BufferBytes,
    red: int,
    green: int,
    blue: int,
    alpha: int,
    offset: int = 0,
    size: int = -1
): bool {
    val byteCount = if (size == -1) bytes.size - offset else size
    var succeeded = bytes.valid() && offset >= 0 && byteCount > 0 &&
        offset <= bytes.size - byteCount &&
        offset - offset / 4 * 4 == 0 &&
        byteCount - byteCount / 4 * 4 == 0
    var cursor = offset
    while (succeeded && cursor < offset + byteCount) {
        succeeded = bytes.store(cursor, red) &&
            bytes.store(cursor + 1, green) &&
            bytes.store(cursor + 2, blue) &&
            bytes.store(cursor + 3, alpha)
        cursor = cursor + 4
    }
    succeeded
}

fun packedRgba8(red: int, green: int, blue: int, alpha: int): int =
    red + green * 256 + blue * 65536 + alpha * 16777216

fun main: int {
    val requested = if (processArgumentCount() > 0)
        processArgument(0)
    else "auto"
    val backend = if (requested == "opengl") graphicsBackendOpenGl
        else if (requested == "vulkan") graphicsBackendVulkan
        else graphicsBackendAuto
    val app = graphicsApplication(
        GraphicsConfig(backend = backend, framesInFlight = 2),
        WindowConfig(
            title = "Abla Graphics wider sampling",
            width = 480,
            height = 270
        )
    )
    val arrayShader = $glsl {
        vertex {
            #version 450
            layout(location = 0) in vec2 position;
            layout(location = 1) in vec3 uv;
            layout(location = 0) out vec3 texCoord;
            void main() {
                gl_Position = vec4(position, 0.0, 1.0);
                texCoord = uv;
            }
        }
        fragment {
            #version 450
            layout(location = 0) in vec3 texCoord;
            layout(location = 0) out vec4 color;
            layout(binding = 0) uniform sampler2DArray atlas;
            void main() {
                vec3 shifted = texCoord + vec3(0.0);
                const ivec2 offset = ivec2(0, 0);
                vec4 sampled = textureGradOffset(
                    atlas,
                    shifted,
                    dFdx(shifted.xy),
                    dFdy(shifted.xy),
                    offset
                );
                vec4 gathered = textureGatherOffset(
                    atlas,
                    shifted,
                    offset
                );
                vec4 gatheredFour = textureGatherOffsets(
                    atlas,
                    shifted,
                    ivec2[4](offset, offset, offset, offset),
                    1
                );
                vec2 queriedLod = textureQueryLod(atlas, shifted.xy);
                vec2 floatingOffset = vec2(offset);
                color = (sampled + (gathered + gatheredFour) * 0.0) *
                    (queriedLod.x * 0.0 + floatingOffset.x * 0.0 + 1.0);
            }
        }
    }
    val cubeShader = $glsl {
        vertex {
            #version 450
            layout(location = 0) in vec2 position;
            layout(location = 1) in vec3 uv;
            layout(location = 0) out vec3 texCoord;
            void main() {
                gl_Position = vec4(position, 0.0, 1.0);
                texCoord = uv;
            }
        }
        fragment {
            #version 450
            layout(location = 0) in vec3 texCoord;
            layout(location = 0) out vec4 color;
            layout(binding = 0) uniform samplerCube atlas;
            void main() {
                vec3 direction = normalize(texCoord);
                vec4 sampled = textureGrad(
                    atlas,
                    direction,
                    dFdx(direction),
                    dFdy(direction)
                );
                vec4 gathered = textureGather(atlas, direction, 0);
                color = mix(sampled + gathered * 0.0, sampled, 0.5);
            }
        }
    }
    val volumeShader = $glsl {
        vertex {
            #version 450
            layout(location = 0) in vec2 position;
            layout(location = 1) in vec3 uv;
            layout(location = 0) out vec3 texCoord;
            void main() {
                gl_Position = vec4(position, 0.0, 1.0);
                texCoord = uv;
            }
        }
        fragment {
            #version 450
            layout(location = 0) in vec3 texCoord;
            layout(location = 0) out vec4 color;
            layout(binding = 0) uniform sampler3D atlas;
            void main() {
                int lod = 0;
                const ivec3 base = ivec3(0, 0, 0);
                ivec3 extent = textureSize(atlas, lod);
                int levels = textureQueryLevels(atlas);
                extent -= ivec3(0, 0, 0);
                levels++;
                --levels;
                ivec3 point = extent - ivec3(2, 2, levels);
                float levelValue = float(levels);
                vec3 floatingExtent = vec3(extent);
                vec4 sampled = texelFetch(atlas, point, lod);
                vec4 filtered = textureLodOffset(
                    atlas,
                    vec3(0.25, 0.25, 0.75),
                    0.0,
                    base
                );
                color = mix(
                    sampled,
                    filtered,
                    levelValue * 0.0 + floatingExtent.z * 0.0 + 0.5
                );
            }
        }
    }
    val vertexBytes = bufferBytes(60)
    val verticesStored =
        vertexBytes.storeF32(-0.8, 0) &&
        vertexBytes.storeF32(-0.8, 4) &&
        vertexBytes.storeF32(0.25, 8) &&
        vertexBytes.storeF32(0.25, 12) &&
        vertexBytes.storeF32(0.75, 16) &&
        vertexBytes.storeF32(0.8, 20) &&
        vertexBytes.storeF32(-0.8, 24) &&
        vertexBytes.storeF32(0.25, 28) &&
        vertexBytes.storeF32(0.25, 32) &&
        vertexBytes.storeF32(0.75, 36) &&
        vertexBytes.storeF32(0.0, 40) &&
        vertexBytes.storeF32(0.8, 44) &&
        vertexBytes.storeF32(0.25, 48) &&
        vertexBytes.storeF32(0.25, 52) &&
        vertexBytes.storeF32(0.75, 56)
    val vertices = app.buffer(BufferDescriptor(
        label = "wider-sampling-vertices",
        size = 60,
        usage = bufferUsageVertex | bufferUsageCopyDestination
    ))
    val verticesUploaded = verticesStored &&
        vertices.writeAllBytes(vertexBytes)
    val viewVertexBytes = bufferBytes(60)
    val viewVerticesStored =
        viewVertexBytes.storeF32(-0.8, 0) &&
        viewVertexBytes.storeF32(-0.8, 4) &&
        viewVertexBytes.storeF32(0.25, 8) &&
        viewVertexBytes.storeF32(0.25, 12) &&
        viewVertexBytes.storeF32(0.0, 16) &&
        viewVertexBytes.storeF32(0.8, 20) &&
        viewVertexBytes.storeF32(-0.8, 24) &&
        viewVertexBytes.storeF32(0.25, 28) &&
        viewVertexBytes.storeF32(0.25, 32) &&
        viewVertexBytes.storeF32(0.0, 36) &&
        viewVertexBytes.storeF32(0.0, 40) &&
        viewVertexBytes.storeF32(0.8, 44) &&
        viewVertexBytes.storeF32(0.25, 48) &&
        viewVertexBytes.storeF32(0.25, 52) &&
        viewVertexBytes.storeF32(0.0, 56)
    val viewVertices = app.buffer(BufferDescriptor(
        label = "wider-sampling-view-vertices",
        size = 60,
        usage = bufferUsageVertex | bufferUsageCopyDestination
    ))
    val viewVerticesUploaded = viewVerticesStored &&
        viewVertices.writeAllBytes(viewVertexBytes)
    val sampledUsage = textureUsageSampled | textureUsageCopyDestination
    val arrayTexture = app.texture(TextureDescriptor(
        label = "sampled-array",
        size = Extent3D(2, 2, 2),
        dimension = textureDimension2DArray,
        usage = sampledUsage
    ))
    val cubeTexture = app.texture(TextureDescriptor(
        label = "sampled-cube",
        size = Extent3D(2, 2, 6),
        dimension = textureDimensionCube,
        usage = sampledUsage
    ))
    val volumeTexture = app.texture(TextureDescriptor(
        label = "sampled-volume",
        size = Extent3D(2, 2, 2),
        dimension = textureDimension3D,
        usage = sampledUsage
    ))
    val arrayBytes = bufferBytes(32)
    val cubeBytes = bufferBytes(96)
    val volumeBytes = bufferBytes(32)
    val arrayExpected = packedRgba8(31, 59, 83, 255)
    val cubeExpected = packedRgba8(211, 139, 23, 255)
    val volumeExpected = packedRgba8(101, 47, 193, 255)
    val texturesUploaded = fillRgba8(arrayBytes, 7, 11, 13, 255) &&
        fillRgba8(arrayBytes, 31, 59, 83, 255, 16, 16) &&
        fillRgba8(cubeBytes, 17, 19, 29, 255) &&
        fillRgba8(cubeBytes, 211, 139, 23, 255, 64, 16) &&
        fillRgba8(volumeBytes, 37, 41, 43, 255) &&
        fillRgba8(volumeBytes, 101, 47, 193, 255, 16, 16) &&
        arrayTexture.writeBytes(arrayBytes) &&
        cubeTexture.writeBytes(cubeBytes) &&
        volumeTexture.writeBytes(volumeBytes)
    val arrayLayerView = arrayTexture.view(TextureViewDescriptor(
        dimension = textureDimension2DArray,
        baseArrayLayer = 1,
        arrayLayerCount = 1
    ))
    val cubeFaceView = cubeTexture.view(TextureViewDescriptor(
        dimension = textureDimension2DArray,
        baseArrayLayer = 4,
        arrayLayerCount = 1
    ))
    val volumeSampleView = volumeTexture.view(TextureViewDescriptor(
        mipLevelCount = 1
    ))
    val sampler = app.sampler()
    val targetTexture = app.texture(TextureDescriptor(
        label = "wider-sampling-target",
        size = Extent3D(64, 64),
        usage = textureUsageRenderAttachment | textureUsageCopySource
    ))
    val target = app.renderTarget(move(targetTexture))
    val layout = VertexBufferLayout(20, [
        VertexAttribute(0, 0, vertexFormatFloat32x2),
        VertexAttribute(1, 8, vertexFormatFloat32x3)
    ])
    val arrayBinding = app.bindGroup([
        app.sampledTextureEntry(
            0,
            shaderVisibilityFragment,
            arrayTexture,
            sampler
        )
    ])
    val cubeBinding = app.bindGroup([
        app.sampledTextureEntry(
            0,
            shaderVisibilityFragment,
            cubeTexture,
            sampler
        )
    ])
    val volumeBinding = app.bindGroup([
        app.sampledTextureEntry(
            0,
            shaderVisibilityFragment,
            volumeTexture,
            sampler
        )
    ])
    val arrayViewBinding = app.textureViewBinding(arrayLayerView, sampler)
    val cubeViewBinding = app.bindGroup([
        app.sampledTextureViewEntry(
            0,
            shaderVisibilityFragment,
            cubeFaceView,
            sampler
        )
    ])
    val volumeViewBinding = app.bindGroup([
        app.sampledTextureViewEntry(
            0,
            shaderVisibilityFragment,
            volumeSampleView,
            sampler
        )
    ])
    val mismatchBinding = app.bindGroup([
        app.sampledTextureEntry(
            0,
            shaderVisibilityFragment,
            arrayTexture,
            sampler
        )
    ])
    val arrayPipeline = app.renderTargetPipeline(
        target,
        arrayShader,
        layout,
        RasterPipelineState(),
        DepthStencilState(),
        move(arrayBinding)
    )
    val cubePipeline = app.renderTargetPipeline(
        target,
        cubeShader,
        layout,
        RasterPipelineState(),
        DepthStencilState(),
        move(cubeBinding)
    )
    val volumePipeline = app.renderTargetPipeline(
        target,
        volumeShader,
        layout,
        RasterPipelineState(),
        DepthStencilState(),
        move(volumeBinding)
    )
    val arrayViewPipeline = app.renderTargetPipeline(
        target,
        arrayShader,
        layout,
        RasterPipelineState(),
        DepthStencilState(),
        move(arrayViewBinding)
    )
    val cubeViewPipeline = app.renderTargetPipeline(
        target,
        arrayShader,
        layout,
        RasterPipelineState(),
        DepthStencilState(),
        move(cubeViewBinding)
    )
    val volumeViewPipeline = app.renderTargetPipeline(
        target,
        volumeShader,
        layout,
        RasterPipelineState(),
        DepthStencilState(),
        move(volumeViewBinding)
    )
    val mismatchedPipeline = app.renderTargetPipeline(
        target,
        cubeShader,
        layout,
        RasterPipelineState(),
        DepthStencilState(),
        move(mismatchBinding)
    )
    val clear = Color(0.0, 0.0, 0.0)
    val arrayRendered = app.renderVerticesToTarget(
        target,
        arrayPipeline,
        vertices,
        3,
        clear
    ) && target.texture.rgba8(32, 32) == arrayExpected
    val cubeRendered = app.renderVerticesToTarget(
        target,
        cubePipeline,
        vertices,
        3,
        clear
    ) && target.texture.rgba8(32, 32) == cubeExpected
    val volumeRendered = app.renderVerticesToTarget(
        target,
        volumePipeline,
        vertices,
        3,
        clear
    ) && target.texture.rgba8(32, 32) == volumeExpected
    val arrayViewRendered = app.renderVerticesToTarget(
        target,
        arrayViewPipeline,
        viewVertices,
        3,
        clear
    ) && target.texture.rgba8(32, 32) == arrayExpected
    val cubeViewRendered = app.renderVerticesToTarget(
        target,
        cubeViewPipeline,
        viewVertices,
        3,
        clear
    ) && target.texture.rgba8(32, 32) == cubeExpected
    val volumeViewRendered = app.renderVerticesToTarget(
        target,
        volumeViewPipeline,
        vertices,
        3,
        clear
    ) && target.texture.rgba8(32, 32) == volumeExpected
    val arrayPipelineHandle = if (app.backend == graphicsBackendOpenGl)
        arrayPipeline.openGl.handle else arrayPipeline.vulkan.handle
    val cubePipelineHandle = if (app.backend == graphicsBackendOpenGl)
        cubePipeline.openGl.handle else cubePipeline.vulkan.handle
    val volumePipelineHandle = if (app.backend == graphicsBackendOpenGl)
        volumePipeline.openGl.handle else volumePipeline.vulkan.handle
    val arrayBindingHandle = if (app.backend == graphicsBackendOpenGl)
        arrayPipeline.binding.openGlResources[0]
    else arrayPipeline.binding.vulkan.descriptorSet
    val cubeBindingHandle = if (app.backend == graphicsBackendOpenGl)
        cubePipeline.binding.openGlResources[0]
    else cubePipeline.binding.vulkan.descriptorSet
    val volumeBindingHandle = if (app.backend == graphicsBackendOpenGl)
        volumePipeline.binding.openGlResources[0]
    else volumePipeline.binding.vulkan.descriptorSet
    val arrayViewHandle = if (app.backend == graphicsBackendVulkan)
        arrayPipeline.binding.vulkan.views[0] else 0
    val cubeViewHandle = if (app.backend == graphicsBackendVulkan)
        cubePipeline.binding.vulkan.views[0] else 0
    val volumeViewHandle = if (app.backend == graphicsBackendVulkan)
        volumePipeline.binding.vulkan.views[0] else 0
    val explicitArrayViewHandle = if (app.backend == graphicsBackendOpenGl)
        arrayLayerView.openGl.handle else arrayLayerView.vulkan.handle
    val explicitCubeViewHandle = if (app.backend == graphicsBackendOpenGl)
        cubeFaceView.openGl.handle else cubeFaceView.vulkan.handle
    val explicitVolumeViewHandle = if (app.backend == graphicsBackendOpenGl)
        volumeSampleView.openGl.handle else volumeSampleView.vulkan.handle
    val explicitArrayBindingHandle = if (
        app.backend == graphicsBackendOpenGl
    ) arrayViewPipeline.binding.openGlResources[0]
    else arrayViewPipeline.binding.vulkan.descriptorSet
    val explicitCubeBindingHandle = if (
        app.backend == graphicsBackendOpenGl
    ) cubeViewPipeline.binding.openGlResources[0]
    else cubeViewPipeline.binding.vulkan.descriptorSet
    val explicitVolumeBindingHandle = if (
        app.backend == graphicsBackendOpenGl
    ) volumeViewPipeline.binding.openGlResources[0]
    else volumeViewPipeline.binding.vulkan.descriptorSet
    val liveBefore = runtimeMemoryLiveBytes()
    var repeated = arrayRendered && cubeRendered && volumeRendered &&
        arrayViewRendered && cubeViewRendered && volumeViewRendered
    var frame = 0
    while (repeated && frame < 4) {
        repeated = app.renderVerticesToTarget(
            target,
            arrayPipeline,
            vertices,
            3,
            clear
        ) && target.texture.rgba8(32, 32) == arrayExpected &&
            app.renderVerticesToTarget(
                target,
                cubePipeline,
                vertices,
                3,
                clear
            ) && target.texture.rgba8(32, 32) == cubeExpected &&
            app.renderVerticesToTarget(
                target,
                volumePipeline,
                vertices,
                3,
                clear
            ) && target.texture.rgba8(32, 32) == volumeExpected &&
            app.renderVerticesToTarget(
                target,
                arrayViewPipeline,
                viewVertices,
                3,
                clear
            ) && target.texture.rgba8(32, 32) == arrayExpected &&
            app.renderVerticesToTarget(
                target,
                cubeViewPipeline,
                viewVertices,
                3,
                clear
            ) && target.texture.rgba8(32, 32) == cubeExpected &&
            app.renderVerticesToTarget(
                target,
                volumeViewPipeline,
                vertices,
                3,
                clear
            ) && target.texture.rgba8(32, 32) == volumeExpected
        frame = frame + 1
    }
    val liveAfter = runtimeMemoryLiveBytes()
    val handlesStable = arrayPipelineHandle != 0 &&
        cubePipelineHandle != 0 && volumePipelineHandle != 0 &&
        arrayBindingHandle != 0 && cubeBindingHandle != 0 &&
        volumeBindingHandle != 0 &&
        (if (app.backend == graphicsBackendOpenGl)
            arrayPipeline.openGl.handle == arrayPipelineHandle &&
                cubePipeline.openGl.handle == cubePipelineHandle &&
                volumePipeline.openGl.handle == volumePipelineHandle &&
                arrayPipeline.binding.openGlResources[0] ==
                    arrayBindingHandle &&
                cubePipeline.binding.openGlResources[0] ==
                    cubeBindingHandle &&
                volumePipeline.binding.openGlResources[0] ==
                    volumeBindingHandle
         else arrayPipeline.vulkan.handle == arrayPipelineHandle &&
            cubePipeline.vulkan.handle == cubePipelineHandle &&
            volumePipeline.vulkan.handle == volumePipelineHandle &&
            arrayPipeline.binding.vulkan.descriptorSet ==
                arrayBindingHandle &&
            cubePipeline.binding.vulkan.descriptorSet == cubeBindingHandle &&
            volumePipeline.binding.vulkan.descriptorSet ==
                volumeBindingHandle && arrayViewHandle != 0 &&
            cubeViewHandle != 0 && volumeViewHandle != 0 &&
            arrayPipeline.binding.vulkan.views[0] == arrayViewHandle &&
            cubePipeline.binding.vulkan.views[0] == cubeViewHandle &&
            volumePipeline.binding.vulkan.views[0] == volumeViewHandle)
    val explicitViewsStable = explicitArrayViewHandle != 0 &&
        explicitCubeViewHandle != 0 && explicitVolumeViewHandle != 0 &&
        explicitArrayBindingHandle != 0 && explicitCubeBindingHandle != 0 &&
        explicitVolumeBindingHandle != 0 &&
        (if (app.backend == graphicsBackendOpenGl)
            arrayLayerView.openGl.handle == explicitArrayViewHandle &&
                cubeFaceView.openGl.handle == explicitCubeViewHandle &&
                volumeSampleView.openGl.handle == explicitVolumeViewHandle &&
                arrayViewPipeline.binding.openGlResources[0] ==
                    explicitArrayBindingHandle &&
                cubeViewPipeline.binding.openGlResources[0] ==
                    explicitCubeBindingHandle &&
                volumeViewPipeline.binding.openGlResources[0] ==
                    explicitVolumeBindingHandle
         else arrayLayerView.vulkan.handle == explicitArrayViewHandle &&
            cubeFaceView.vulkan.handle == explicitCubeViewHandle &&
            volumeSampleView.vulkan.handle == explicitVolumeViewHandle &&
            arrayViewPipeline.binding.vulkan.descriptorSet ==
                explicitArrayBindingHandle &&
            cubeViewPipeline.binding.vulkan.descriptorSet ==
                explicitCubeBindingHandle &&
            volumeViewPipeline.binding.vulkan.descriptorSet ==
                explicitVolumeBindingHandle &&
            arrayViewPipeline.binding.vulkan.views.size == 0 &&
            cubeViewPipeline.binding.vulkan.views.size == 0 &&
            volumeViewPipeline.binding.vulkan.views.size == 0)
    val presented = app.presentClear(Color(0.03125, 0.125, 0.3125))
    val passed = app.valid() && arrayShader.valid && cubeShader.valid &&
        volumeShader.valid && vertices.valid() && verticesUploaded &&
        viewVertices.valid() && viewVerticesUploaded &&
        arrayTexture.valid() && cubeTexture.valid() && volumeTexture.valid() &&
        texturesUploaded && arrayLayerView.valid() && cubeFaceView.valid() &&
        volumeSampleView.valid() && sampler.valid() && target.valid() &&
        arrayPipeline.valid() && cubePipeline.valid() &&
        volumePipeline.valid() && arrayViewPipeline.valid() &&
        cubeViewPipeline.valid() && volumeViewPipeline.valid() &&
        !mismatchedPipeline.valid() &&
        mismatchedPipeline.error.code == graphicsErrorInvalidConfiguration &&
        repeated && frame == 4 && handlesStable && explicitViewsStable &&
        liveAfter == liveBefore && presented
    println(
        "wider-sampling ${graphicsBackendName(app.backend)}: array=$arrayRendered/$arrayExpected cube=$cubeRendered/$cubeExpected volume=$volumeRendered/$volumeExpected views=$arrayViewRendered/$cubeViewRendered/$volumeViewRendered mismatch=${!mismatchedPipeline.valid()} frames=$frame stable=$handlesStable/$explicitViewsStable live=${liveAfter - liveBefore} error=${arrayPipeline.error.message}"
    )
    if (passed) 0 else 1
}
