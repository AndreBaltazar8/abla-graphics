import "abla/io"
import "abla/process/arguments"
import "abla/runtime/memory"
import "../../src/texture.ab"
import "../../src/texture_pool.ab"
import "../../src/render.ab"
import "../../src/gltf_buffer.ab"
import "../../src/gltf_texture.ab"

fun storeGltfDraw(
    var batch: GraphicsPushConstantBatch,
    draw: int,
    transform: Mat4,
    material: f64,
    reserved: f64
): bool =
    batch.storeMemberF32(draw, "row0", transform.m00, 0) &&
    batch.storeMemberF32(draw, "row0", transform.m01, 1) &&
    batch.storeMemberF32(draw, "row0", transform.m02, 2) &&
    batch.storeMemberF32(draw, "row0", transform.m03, 3) &&
    batch.storeMemberF32(draw, "row1", transform.m10, 0) &&
    batch.storeMemberF32(draw, "row1", transform.m11, 1) &&
    batch.storeMemberF32(draw, "row1", transform.m12, 2) &&
    batch.storeMemberF32(draw, "row1", transform.m13, 3) &&
    batch.storeMemberF32(draw, "row2", transform.m20, 0) &&
    batch.storeMemberF32(draw, "row2", transform.m21, 1) &&
    batch.storeMemberF32(draw, "row2", transform.m22, 2) &&
    batch.storeMemberF32(draw, "row2", transform.m23, 3) &&
    batch.storeMemberF32(draw, "tint", material, 0) &&
    batch.storeMemberF32(draw, "tint", reserved, 1) &&
    batch.storeMemberF32(draw, "tint", 0.0, 2) &&
    batch.storeMemberF32(draw, "tint", 1.0, 3)

fun main: int {
    val requested = if (processArgumentCount() > 0)
        processArgument(0) else "auto"
    val backend = if (requested == "opengl") graphicsBackendOpenGl
        else if (requested == "vulkan") graphicsBackendVulkan
        else graphicsBackendAuto
    val app = graphicsApplication(
        GraphicsConfig(backend = backend, framesInFlight = 2),
        WindowConfig(title = "Abla Graphics glTF scene", width = 640, height = 360)
    )
    val png = "iVBORw0KGgoAAAANSUhEUgAAAAIAAAACCAYAAABytg0kAAAAFElEQVR42mP4z8DwHwyBNBAw/AcAR8oI+FuapL4AAAAASUVORK5CYII="
    val bluePng = "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNgYPj/HwADAgH/OSkZvgAAAABJRU5ErkJggg=="
    val source = "{\"asset\":{\"version\":\"2.0\"},\"buffers\":[{\"uri\":\"data:application/octet-stream;base64,MzMzv5qZGb8AAAAAMzMzP5qZGb8AAAAAAAAAADMzMz8AAAAAAAABAAIAAAAAAEA/AACAPgAAQD8AAIA+AABAPwAAgD7NzEy+zcxMvgAAAADNzEw+zcxMvgAAAAAAAAAAmpmZPgAAAAA=\",\"byteLength\":104}],\"bufferViews\":[{\"buffer\":0,\"byteOffset\":0,\"byteLength\":36,\"target\":34962},{\"buffer\":0,\"byteOffset\":36,\"byteLength\":6,\"target\":34963},{\"buffer\":0,\"byteOffset\":44,\"byteLength\":24,\"target\":34962},{\"buffer\":0,\"byteOffset\":68,\"byteLength\":36,\"target\":34962}],\"accessors\":[{\"bufferView\":0,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\"},{\"bufferView\":1,\"componentType\":5123,\"count\":3,\"type\":\"SCALAR\"},{\"bufferView\":2,\"componentType\":5126,\"count\":3,\"type\":\"VEC2\"},{\"bufferView\":3,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\"}],\"images\":[{\"name\":\"four colors\",\"uri\":\"data:image/png;base64,$png\"},{\"name\":\"blue\",\"uri\":\"data:image/png;base64,$bluePng\"}],\"samplers\":[{\"name\":\"nearest repeat\",\"magFilter\":9728,\"minFilter\":9984,\"wrapS\":10497,\"wrapT\":10497}],\"textures\":[{\"name\":\"albedo green\",\"sampler\":0,\"source\":0},{\"name\":\"albedo blue\",\"sampler\":0,\"source\":1}],\"materials\":[{\"name\":\"green\",\"pbrMetallicRoughness\":{\"baseColorTexture\":{\"index\":0}}},{\"name\":\"blue\",\"pbrMetallicRoughness\":{\"baseColorTexture\":{\"index\":1}}}],\"meshes\":[{\"name\":\"green triangle\",\"primitives\":[{\"attributes\":{\"POSITION\":0,\"TEXCOORD_0\":2},\"indices\":1,\"material\":0}]},{\"name\":\"blue triangle\",\"primitives\":[{\"attributes\":{\"POSITION\":3,\"TEXCOORD_0\":2},\"indices\":1,\"material\":1}]}],\"nodes\":[{\"mesh\":0},{\"mesh\":1,\"translation\":[0.5,0.0,0.0]}],\"scenes\":[{\"nodes\":[0,1]}],\"scene\":0}"
    val parsed = gltfDocument(source)
    val payloads = if (parsed.succeeded)
        gltfBufferPayloads(parsed.document) else GltfBufferPayloads([], false, "parse")
    val drawList = gltfSceneDrawList(parsed.document)
    val resourcePlan = gltfSceneAccessorResourcePlan(parsed.document, drawList)
    val shader = $glsl {
        vertex {
            #version 450
            layout(location = 0) in vec3 position;
            layout(location = 1) in vec2 uv;
            layout(location = 0) out vec2 texCoord;
            layout(push_constant) uniform Draw {
                vec4 row0;
                vec4 row1;
                vec4 row2;
                vec4 tint;
            } draw;
            void main() {
                vec4 point = vec4(position, 1.0);
                gl_Position = vec4(
                    dot(draw.row0, point),
                    dot(draw.row1, point),
                    dot(draw.row2, point),
                    1.0
                );
                texCoord = uv;
            }
        }
        fragment {
            #version 450
            layout(location = 0) in vec2 texCoord;
            layout(location = 0) out vec4 color;
            layout(binding = 0) uniform sampler2D greenAtlas;
            layout(binding = 1) uniform sampler2D blueAtlas;
            layout(push_constant) uniform Draw {
                vec4 row0;
                vec4 row1;
                vec4 row2;
                vec4 tint;
            } draw;
            void main() {
                vec4 green = texture(greenAtlas, texCoord);
                vec4 blue = texture(blueAtlas, texCoord);
                color = mix(green, blue, draw.tint.x);
            }
        }
    }
    val target = app.renderTarget(app.texture(TextureDescriptor(
        label = "gltf-live-target",
        size = Extent3D(64, 64),
        format = textureFormatRgba8Unorm,
        usage = textureUsageRenderAttachment | textureUsageCopySource
    )))
    val greenTexture = app.gltfGpuTexture(
        parsed.document, payloads,
        parsed.document.materials[0].baseColorTexture.index
    )
    val blueTexture = app.gltfGpuTexture(
        parsed.document, payloads,
        parsed.document.materials[1].baseColorTexture.index
    )
    val sceneGeometry = app.gltfGpuTexturedScene(
        parsed.document, payloads, drawList, resourcePlan
    )
    val drawIndexCounts = sceneGeometry.drawIndexCounts
    val drawIndexOffsets = sceneGeometry.drawIndexOffsets
    val targetBinding = app.bindGroup([
        app.sampledTextureEntry(
            0, shaderVisibilityFragment,
            greenTexture.texture, greenTexture.sampler
        ),
        app.sampledTextureEntry(
            1, shaderVisibilityFragment,
            blueTexture.texture, blueTexture.sampler
        )
    ])
    val windowBinding = app.bindGroup([
        app.sampledTextureEntry(
            0, shaderVisibilityFragment,
            greenTexture.texture, greenTexture.sampler
        ),
        app.sampledTextureEntry(
            1, shaderVisibilityFragment,
            blueTexture.texture, blueTexture.sampler
        )
    ])
    val targetPipeline = app.renderTargetPipeline(
        target, shader, sceneGeometry.layout,
        RasterPipelineState(), DepthStencilState(),
        move(targetBinding)
    )
    val windowPipeline = app.renderPipeline(
        shader, sceneGeometry.layout,
        RasterPipelineState(), DepthStencilState(),
        move(windowBinding)
    )
    val batch = shader.pushConstantBatch(drawList.drawables.size)
    val batchReady = batch.valid() && batch.drawCount == 2 &&
        batch.layout.size == 64 && storeGltfDraw(
            batch, 0, drawList.drawables[0].worldTransform, 0.0, 0.0
        ) && storeGltfDraw(
            batch, 1, drawList.drawables[1].worldTransform, 1.0, 0.0
        ) && batch.storeIndexedDrawRange(
            0, drawIndexCounts[0], drawIndexOffsets[0]
        ) && batch.storeIndexedDrawRange(
            1, drawIndexCounts[1], drawIndexOffsets[1]
        )
    val clear = Color(0.01, 0.01, 0.015)
    val initialized = app.valid() && parsed.succeeded && payloads.valid &&
        drawList.valid && drawList.drawables.size == 2 && resourcePlan.valid &&
        resourcePlan.meshIndices.size == 2 &&
        resourcePlan.drawableResources.size == 2 &&
        resourcePlan.drawableResources[0] == 0 &&
        resourcePlan.drawableResources[1] == 1 &&
        sceneGeometry.valid() && sceneGeometry.vertexCount == 6 &&
        sceneGeometry.indexCount == 6 &&
        drawIndexCounts.size == 2 && drawIndexCounts[0] == 3 &&
        drawIndexCounts[1] == 3 && drawIndexOffsets.size == 2 &&
        drawIndexOffsets[0] == 0 && drawIndexOffsets[1] == 12 &&
        drawList.drawables[0].material == 0 &&
        drawList.drawables[1].material == 1 && greenTexture.valid() &&
        blueTexture.valid() &&
        shader.valid && target.valid() &&
        targetPipeline.valid() && windowPipeline.valid() && batchReady
    if (!initialized) println(
        "gltf-live setup: app=${app.valid()} plan=${resourcePlan.valid}:${resourcePlan.error} geometry=${sceneGeometry.valid()}:${sceneGeometry.error} textures=${greenTexture.valid()}:${greenTexture.error}/${blueTexture.valid()}:${blueTexture.error} shader=${shader.valid}:${shader.error} target=${target.valid()} pipelines=${targetPipeline.valid()}:${windowPipeline.valid()} errors=${targetPipeline.error.operation}:${targetPipeline.error.message}/${windowPipeline.error.operation}:${windowPipeline.error.message}"
    )
    var rendered = initialized && app.renderPushBatchIndexedToTarget(
        target, targetPipeline, batch, sceneGeometry.vertices,
        sceneGeometry.indices, sceneGeometry.indexCount, clear
    ) && app.presentPushBatchRenderIndexed(
        windowPipeline, batch, sceneGeometry.vertices,
        sceneGeometry.indices, sceneGeometry.indexCount, clear
    )
    var warm = 0
    while (rendered && warm < 4) {
        rendered = app.renderPushBatchIndexedToTarget(
            target, targetPipeline, batch, sceneGeometry.vertices,
            sceneGeometry.indices, sceneGeometry.indexCount, clear
        ) && app.presentPushBatchRenderIndexed(
            windowPipeline, batch, sceneGeometry.vertices,
            sceneGeometry.indices, sceneGeometry.indexCount, clear
        )
        warm = warm + 1
    }
    val firstPixel = if (rendered) target.texture.rgba8(24, 32) else -1
    val secondPixel = if (rendered) target.texture.rgba8(51, 32) else -1
    val liveBefore = runtimeMemoryLiveBytes()
    var frame = 0
    while (rendered && frame < 4) {
        rendered = app.renderPushBatchIndexedToTarget(
            target, targetPipeline, batch, sceneGeometry.vertices,
            sceneGeometry.indices, sceneGeometry.indexCount, clear
        ) && app.presentPushBatchRenderIndexed(
            windowPipeline, batch, sceneGeometry.vertices,
            sceneGeometry.indices, sceneGeometry.indexCount, clear
        ) && target.texture.rgba8(24, 32) == firstPixel &&
            target.texture.rgba8(51, 32) == secondPixel
        frame = frame + 1
    }
    val liveAfter = runtimeMemoryLiveBytes()
    val vertexHandle = if (app.backend == graphicsBackendOpenGl)
        sceneGeometry.vertices.openGl.handle
        else sceneGeometry.vertices.vulkan.handle
    val indexHandle = if (app.backend == graphicsBackendOpenGl)
        sceneGeometry.indices.openGl.handle else sceneGeometry.indices.vulkan.handle
    val stable = rendered && frame == 4 &&
        firstPixel == 4278255360 && secondPixel == 4294901760 &&
        liveAfter == liveBefore &&
        vertexHandle != 0 && indexHandle != 0
    println("gltf-live-scene ${graphicsBackendName(app.backend)}: parsed=${parsed.succeeded} payloads=${payloads.valid} textures=${greenTexture.valid()}:${blueTexture.valid()} drawables=${drawList.drawables.size} materials=${drawList.drawables[0].material}/${drawList.drawables[1].material} resources=${resourcePlan.meshIndices.size} vertices=${sceneGeometry.vertexCount} indices=${sceneGeometry.indexCount} ranges=${drawIndexOffsets[0]}:${drawIndexCounts[0]}/${drawIndexOffsets[1]}:${drawIndexCounts[1]} pixels=$firstPixel/$secondPixel frames=$frame live=${liveAfter - liveBefore} stable=$stable")
    if (stable) 0 else 1
}
