import "abla/io"
import "abla/float"
import "abla/process/arguments"
import "abla/runtime/memory"
import "../../src/texture.ab"
import "../../src/texture_pool.ab"
import "../../src/render.ab"
import "../../src/gltf_buffer.ab"
import "../../src/gltf_texture.ab"
import "../../src/gltf_render.ab"

fun storeGltfDraw(
    var batch: GraphicsPushConstantBatch,
    draw: int,
    transform: Mat4,
    material: f64,
    reserved: f64,
    surface: GltfMaterialSurfaceParameters
): bool =
    batch.storeMemberF32(draw, "row0", transform.m00, 0) &&
    batch.storeMemberF32(draw, "row0", transform.m01, 1) &&
    batch.storeMemberF32(draw, "row0", transform.m02, 2) &&
    batch.storeMemberF32(draw, "row0", transform.m03, 3) &&
    batch.storeMemberF32(draw, "row1", transform.m10, 0) &&
    batch.storeMemberF32(draw, "row1", transform.m11, 1) &&
    batch.storeMemberF32(draw, "row1", transform.m12, 2) &&
    batch.storeMemberF32(draw, "row1", transform.m13, 3) &&
    batch.storeMemberF32(draw, "row2", transform.m20, 0) &&
    batch.storeMemberF32(draw, "row2", transform.m21, 1) &&
    batch.storeMemberF32(draw, "row2", transform.m22, 2) &&
    batch.storeMemberF32(draw, "row2", transform.m23, 3) &&
    batch.storeMemberF32(draw, "tint", material, 0) &&
    batch.storeMemberF32(draw, "tint", reserved, 1) &&
    batch.storeMemberF32(draw, "tint", 0.0, 2) &&
    batch.storeMemberF32(draw, "tint", 1.0, 3) &&
    batch.storeGltfMaterialSurface(draw, surface)

fun storeGltfBatchPair(
    var first: GraphicsPushConstantBatch,
    var second: GraphicsPushConstantBatch,
    document: GltfDocument,
    drawList: GltfSceneDrawList,
    materialPlan: GltfMaterialBatchPlan,
    indexCounts: array<int>,
    indexOffsets: array<int>
): bool = first.valid() && second.valid() &&
    first.layout.size == 112 && second.layout.size == 112 &&
    storeGltfDraw(
        first, 0, drawList.drawables[0].worldTransform,
        f64FromInt(materialPlan.drawableMaterialSlot(0)), 0.0,
        document.materials[drawList.drawables[0].material].surfaceParameters()
    ) && storeGltfDraw(
        first, 1, drawList.drawables[1].worldTransform,
        f64FromInt(materialPlan.drawableMaterialSlot(1)), 0.0,
        document.materials[drawList.drawables[1].material].surfaceParameters()
    ) && storeGltfDraw(
        second, 0, drawList.drawables[2].worldTransform,
        f64FromInt(materialPlan.drawableMaterialSlot(2)), 0.0,
        document.materials[drawList.drawables[2].material].surfaceParameters()
    ) && first.storeIndexedDrawRange(
        0, indexCounts[0], indexOffsets[0]
    ) && first.storeIndexedDrawRange(
        1, indexCounts[1], indexOffsets[1]
    ) && second.storeIndexedDrawRange(
        0, indexCounts[2], indexOffsets[2]
    )

fun main: int {
    val requested = if (processArgumentCount() > 0)
        processArgument(0) else "auto"
    val backend = if (requested == "opengl") graphicsBackendOpenGl
        else if (requested == "vulkan") graphicsBackendVulkan
        else graphicsBackendAuto
    val app = graphicsApplication(
        GraphicsConfig(backend = backend, framesInFlight = 2),
        WindowConfig(title = "Abla Graphics glTF scene", width = 640, height = 360)
    )
    val png = "iVBORw0KGgoAAAANSUhEUgAAAAIAAAACCAYAAABytg0kAAAAFElEQVR42mP4z8DwHwyBNBAw/AcAR8oI+FuapL4AAAAASUVORK5CYII="
    val blueJpeg = ""
    val source = "{\"asset\":{\"version\":\"2.0\"},\"buffers\":[{\"uri\":\"data:application/octet-stream;base64,MzMzv5qZGb8AAAAAMzMzP5qZGb8AAAAAAAAAADMzMz8AAAAAAAABAAIAv0C/QL9AzcxMvs3MTL4AAAAAzcxMPs3MTL4AAAAAAAAAAJqZmT4AAAAA/78AQP+/AED/vwBAAAAAAAAAAAAAAIA/AAAAAAAAAAAAAIA/AAAAAAAAAAAAAIA/AACAPwAAAAAAAAAAAACAPwAAgD8AAAAAAAAAAAAAgD8AAIA/AAAAAAAAAAAAAIA/\",\"byteLength\":180}],\"bufferViews\":[{\"buffer\":0,\"byteOffset\":0,\"byteLength\":36,\"target\":34962},{\"buffer\":0,\"byteOffset\":36,\"byteLength\":6,\"target\":34963},{\"buffer\":0,\"byteOffset\":42,\"byteLength\":6,\"target\":34962},{\"buffer\":0,\"byteOffset\":48,\"byteLength\":36,\"target\":34962},{\"buffer\":0,\"byteOffset\":84,\"byteLength\":12,\"target\":34962},{\"buffer\":0,\"byteOffset\":96,\"byteLength\":36,\"target\":34962},{\"buffer\":0,\"byteOffset\":132,\"byteLength\":48,\"target\":34962}],\"accessors\":[{\"bufferView\":0,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\"},{\"bufferView\":1,\"componentType\":5123,\"count\":3,\"type\":\"SCALAR\"},{\"bufferView\":2,\"componentType\":5121,\"normalized\":true,\"count\":3,\"type\":\"VEC2\"},{\"bufferView\":3,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\"},{\"bufferView\":4,\"componentType\":5123,\"normalized\":true,\"count\":3,\"type\":\"VEC2\"},{\"bufferView\":5,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\"},{\"bufferView\":6,\"componentType\":5126,\"count\":3,\"type\":\"VEC4\"}],\"images\":[{\"name\":\"four colors\",\"uri\":\"data:image/png;base64,$png\"},{\"name\":\"blue JPEG\",\"uri\":\"data:image/jpeg;base64,$blueJpeg\"}],\"samplers\":[{\"name\":\"nearest repeat\",\"magFilter\":9728,\"minFilter\":9984,\"wrapS\":10497,\"wrapT\":10497}],\"textures\":[{\"name\":\"albedo green\",\"sampler\":0,\"source\":0},{\"name\":\"albedo blue\",\"sampler\":0,\"source\":1}],\"materials\":[{\"name\":\"green layered surface\",\"pbrMetallicRoughness\":{\"baseColorTexture\":{\"index\":0}},\"extensions\":{\"KHR_materials_clearcoat\":{\"clearcoatFactor\":0.8,\"clearcoatRoughnessFactor\":0.25},\"KHR_materials_sheen\":{\"sheenColorFactor\":[0.2,0.05,0.0],\"sheenRoughnessFactor\":0.4},\"KHR_materials_specular\":{\"specularFactor\":0.5,\"specularColorFactor\":[1.0,0.8,0.6]},\"KHR_materials_ior\":{\"ior\":1.5}}},{\"name\":\"blue unlit surface\",\"pbrMetallicRoughness\":{\"baseColorTexture\":{\"index\":1}},\"extensions\":{\"KHR_materials_unlit\":{}}}],\"meshes\":[{\"name\":\"green triangle\",\"primitives\":[{\"attributes\":{\"POSITION\":0,\"NORMAL\":5,\"TANGENT\":6,\"TEXCOORD_0\":2},\"indices\":1,\"material\":0}]},{\"name\":\"blue triangle\",\"primitives\":[{\"attributes\":{\"POSITION\":3,\"NORMAL\":5,\"TANGENT\":6,\"TEXCOORD_0\":4},\"indices\":1,\"material\":1}]}],\"nodes\":[{\"mesh\":0},{\"mesh\":1,\"translation\":[0.5,0.0,0.0]}],\"scenes\":[{\"nodes\":[0,1]}],\"scene\":0}"
    val parsed = gltfDocument(source)
    val payloads = if (parsed.succeeded)
        gltfBufferPayloads(parsed.document) else GltfBufferPayloads([], false, "parse")
    val parsedDrawList = gltfSceneDrawList(parsed.document)
    val drawList = if (parsedDrawList.valid &&
        parsedDrawList.drawables.size == 2) GltfSceneDrawList([
            parsedDrawList.drawables[0], parsedDrawList.drawables[0],
            parsedDrawList.drawables[1]
        ], parsedDrawList.cameras, true, "") else parsedDrawList
    // A width of one forces the two real materials through separate retained
    // bindings/pipelines and proves ordered pass composition on both backends.
    val materialPlan = gltfMaterialBatchPlan(drawList, 1)
    val resourcePlan = gltfSceneAccessorResourcePlan(parsed.document, drawList)
    val shader = $glsl {
        vertex {
            #version 450
            layout(location = 0) in vec3 position;
            layout(location = 1) in vec2 uv;
            layout(location = 2) in vec3 normal;
            layout(location = 3) in vec4 tangent;
            layout(location = 0) out vec2 texCoord;
            layout(push_constant) uniform Draw {
                vec4 row0;
                vec4 row1;
                vec4 row2;
                vec4 tint;
                vec4 surface0;
                vec4 surface1;
                vec4 surface2;
            } draw;
            void main() {
                vec4 point = vec4(position, 1.0);
                gl_Position = vec4(
                    dot(draw.row0, point),
                    dot(draw.row1, point),
                    dot(draw.row2, point),
                    1.0
                );
                texCoord = uv;
            }
        }
        fragment {
            #version 450
            layout(location = 0) in vec2 texCoord;
            layout(location = 0) out vec4 color;
            layout(binding = 0) uniform sampler2D baseColor0;
            layout(binding = 1) uniform sampler2D metallicRoughness0;
            layout(binding = 2) uniform sampler2D normal0;
            layout(binding = 3) uniform sampler2D occlusion0;
            layout(binding = 4) uniform sampler2D emissive0;
            layout(binding = 5) uniform sampler2D baseColor1;
            layout(binding = 6) uniform sampler2D metallicRoughness1;
            layout(binding = 7) uniform sampler2D normal1;
            layout(binding = 8) uniform sampler2D occlusion1;
            layout(binding = 9) uniform sampler2D emissive1;
            layout(push_constant) uniform Draw {
                vec4 row0;
                vec4 row1;
                vec4 row2;
                vec4 tint;
                vec4 surface0;
                vec4 surface1;
                vec4 surface2;
            } draw;
            void main() {
                vec4 base0 = texture(baseColor0, texCoord);
                vec4 factors0 = texture(metallicRoughness0, texCoord);
                vec3 shaded0 = (base0.rgb * (1.0 - factors0.b) +
                    mix(vec3(0.04), base0.rgb, factors0.b) * pow(
                        texture(normal0, texCoord).b,
                        mix(256.0, 8.0, factors0.g)
                    )) * texture(occlusion0, texCoord).r +
                    texture(emissive0, texCoord).rgb;
                vec4 base1 = texture(baseColor1, texCoord);
                vec4 factors1 = texture(metallicRoughness1, texCoord);
                vec3 shaded1 = (base1.rgb * (1.0 - factors1.b) +
                    mix(vec3(0.04), base1.rgb, factors1.b) * pow(
                        texture(normal1, texCoord).b,
                        mix(256.0, 8.0, factors1.g)
                    )) * texture(occlusion1, texCoord).r +
                    texture(emissive1, texCoord).rgb;
                vec4 base = mix(base0, base1, draw.tint.x);
                vec3 shaded = mix(shaded0, shaded1, draw.tint.x);
                color = mix(
                    vec4(
                        shaded * (1.0 - draw.surface0.y *
                            (1.0 - draw.surface0.z) * 0.25) +
                        vec3(1.0) * draw.surface0.y *
                            (1.0 - draw.surface0.z) * 0.04 +
                        draw.surface2.rgb *
                            ((draw.surface2.w - 1.0) /
                             (draw.surface2.w + 1.0)) *
                            ((draw.surface2.w - 1.0) /
                             (draw.surface2.w + 1.0)) *
                            draw.surface0.w * 0.25 +
                        draw.surface1.rgb *
                            (1.0 - draw.surface1.w) * 0.25,
                        base.a
                    ),
                    base,
                    draw.surface0.x
                );
            }
        }
    }
    val target = app.renderTarget(app.texture(TextureDescriptor(
        label = "gltf-live-target",
        size = Extent3D(64, 64),
        format = textureFormatRgba8Unorm,
        usage = textureUsageRenderAttachment | textureUsageCopySource
    )))
    val firstMaterialTextures = app.gltfGpuMaterialTextureTable(
        parsed.document, payloads, [0, 1]
    )
    val secondMaterialTextures = app.gltfGpuMaterialTextureTable(
        parsed.document, payloads, [1, 0]
    )
    val sceneGeometry = app.gltfGpuTexturedScene(
        parsed.document, payloads, drawList, resourcePlan
    )
    val layeredSurface = if (parsed.succeeded)
        parsed.document.materials[0].surfaceParameters()
        else GltfMaterialSurfaceParameters(accepted = false, error = "parse")
    val unlitSurface = if (parsed.succeeded)
        parsed.document.materials[1].surfaceParameters()
        else GltfMaterialSurfaceParameters(accepted = false, error = "parse")
    val drawIndexCounts = sceneGeometry.drawIndexCounts
    val drawIndexOffsets = sceneGeometry.drawIndexOffsets
    val firstTargetEntries = app.gltfMaterialTextureEntries(
        firstMaterialTextures
    )
    val secondTargetEntries = app.gltfMaterialTextureEntries(
        secondMaterialTextures
    )
    val firstWindowEntries = app.gltfMaterialTextureEntries(
        firstMaterialTextures
    )
    val secondWindowEntries = app.gltfMaterialTextureEntries(
        secondMaterialTextures
    )
    val clearPass = app.renderPass(
        target,
        renderPassClearValues(Color(0.01, 0.01, 0.015))
    )
    val loadPass = app.renderPass(
        target,
        renderPassClearValues(Color(0.01, 0.01, 0.015)),
        RenderPassOperations(color = RenderAttachmentOperations(
            load = attachmentLoadOperationLoad
        ))
    )
    val firstTargetPipeline = app.renderTargetPipeline(
        target, shader, sceneGeometry.layout,
        RasterPipelineState(), DepthStencilState(),
        app.bindGroup(firstTargetEntries)
    )
    val secondTargetPipeline = app.renderTargetPipeline(
        target, shader, sceneGeometry.layout,
        RasterPipelineState(), DepthStencilState(),
        app.bindGroup(secondTargetEntries)
    )
    val firstWindowPipeline = app.renderPipeline(
        shader, sceneGeometry.layout,
        RasterPipelineState(), DepthStencilState(),
        app.bindGroup(firstWindowEntries)
    )
    val secondWindowPipeline = app.renderPipeline(
        shader, sceneGeometry.layout,
        RasterPipelineState(), DepthStencilState(),
        app.bindGroup(secondWindowEntries)
    )
    val firstBatch = shader.pushConstantBatch(2)
    val secondBatch = shader.pushConstantBatch(1)
    val firstWindowBatch = shader.pushConstantBatch(2)
    val secondWindowBatch = shader.pushConstantBatch(1)
    val batchReady = storeGltfBatchPair(
        firstBatch, secondBatch, parsed.document, drawList, materialPlan,
        drawIndexCounts, drawIndexOffsets
    ) && storeGltfBatchPair(
        firstWindowBatch, secondWindowBatch, parsed.document,
        drawList, materialPlan,
        drawIndexCounts, drawIndexOffsets
    )
    val targetPipelines = [
        move(firstTargetPipeline), move(secondTargetPipeline)
    ]
    val batches = [move(firstBatch), move(secondBatch)]
    val passes = [move(clearPass), move(loadPass)]
    val windowSequence = app.pushBatchRenderSequence(
        [move(firstWindowPipeline), move(secondWindowPipeline)],
        [move(firstWindowBatch), move(secondWindowBatch)]
    )
    val clear = Color(0.01, 0.01, 0.015)
    val initialized = app.valid() && parsed.succeeded && payloads.valid &&
        drawList.valid && drawList.drawables.size == 3 && resourcePlan.valid &&
        materialPlan.valid && materialPlan.batchCount() == 2 &&
        materialPlan.batchDrawableOffsets[0] == 0 &&
        materialPlan.batchDrawableOffsets[1] == 2 &&
        materialPlan.batchDrawableCounts[0] == 2 &&
        materialPlan.batchDrawableCounts[1] == 1 &&
        materialPlan.drawableMaterialSlot(0) == 0 &&
        materialPlan.drawableMaterialSlot(1) == 0 &&
        materialPlan.drawableMaterialSlot(2) == 0 &&
        resourcePlan.meshIndices.size == 2 &&
        resourcePlan.drawableResources.size == 3 &&
        resourcePlan.drawableResources[0] == 0 &&
        resourcePlan.drawableResources[1] == 0 &&
        resourcePlan.drawableResources[2] == 1 &&
        layeredSurface.valid() && !layeredSurface.unlit &&
        layeredSurface.clearcoat >= 0.799 &&
        layeredSurface.clearcoat <= 0.801 &&
        layeredSurface.sheenColor.x >= 0.199 &&
        layeredSurface.sheenColor.x <= 0.201 &&
        layeredSurface.specular >= 0.499 &&
        layeredSurface.specular <= 0.501 &&
        layeredSurface.ior >= 1.499 && layeredSurface.ior <= 1.501 &&
        unlitSurface.valid() && unlitSurface.unlit &&
        sceneGeometry.valid() && sceneGeometry.vertexCount == 6 &&
        sceneGeometry.indexCount == 6 &&
        sceneGeometry.layout.stride == 48 &&
        sceneGeometry.layout.attributes.size == 4 &&
        parsed.document.accessors[2].componentType == gltfComponentU8 &&
        parsed.document.accessors[2].normalized &&
        parsed.document.accessors[4].componentType == gltfComponentU16 &&
        parsed.document.accessors[4].normalized &&
        parsed.document.meshes[0].primitives[0].normal == 5 &&
        parsed.document.meshes[0].primitives[0].tangent == 6 &&
        drawIndexCounts.size == 3 && drawIndexCounts[0] == 3 &&
        drawIndexCounts[1] == 3 && drawIndexCounts[2] == 3 &&
        drawIndexOffsets.size == 3 &&
        drawIndexOffsets[0] == 0 && drawIndexOffsets[1] == 0 &&
        drawIndexOffsets[2] == 12 &&
        drawList.drawables[0].material == 0 &&
        drawList.drawables[1].material == 0 &&
        drawList.drawables[2].material == 1 &&
        firstMaterialTextures.valid() && secondMaterialTextures.valid() &&
        firstMaterialTextures.materialCount() == 2 &&
        secondMaterialTextures.materialCount() == 2 &&
        firstMaterialTextures.values.size == 5 &&
        secondMaterialTextures.values.size == 5 &&
        firstMaterialTextures.slots.size == 10 &&
        secondMaterialTextures.slots.size == 10 &&
        firstTargetEntries.size == 10 && secondTargetEntries.size == 10 &&
        firstWindowEntries.size == 10 && secondWindowEntries.size == 10 &&
        shader.valid && target.valid() &&
        targetPipelines[0].valid() && targetPipelines[1].valid() &&
        windowSequence.valid() && windowSequence.groupCount() == 2 &&
        batches[0].valid() && batches[1].valid() &&
        passes[0].valid() && passes[1].valid() && batchReady
    if (!initialized) println(
        "gltf-live setup: app=${app.valid()} plan=${resourcePlan.valid}:${resourcePlan.error} geometry=${sceneGeometry.valid()}:${sceneGeometry.error} materials=${firstMaterialTextures.valid()}:${secondMaterialTextures.valid()} shader=${shader.valid}:${shader.error} target=${target.valid()} pipelines=${targetPipelines[0].valid()}:${targetPipelines[0].error.message}/${targetPipelines[1].valid()}:${targetPipelines[1].error.message}/${windowSequence.valid()}:${windowSequence.error.message}"
    )
    val targetRendered = initialized && app.renderGltfMaterialBatchesToTarget(
        target, materialPlan, targetPipelines, batches, passes,
        sceneGeometry.vertices, sceneGeometry.indices, sceneGeometry.indexCount
    )
    val windowRendered = targetRendered &&
        app.presentPushBatchRenderIndexedSequence(
        windowSequence, sceneGeometry.vertices,
        sceneGeometry.indices, sceneGeometry.indexCount, clear
    )
    if (!targetRendered || !windowRendered) println(
        "gltf-live first-frame: target=$targetRendered window=$windowRendered"
    )
    val firstWindowPipelineHandle = if (
        app.backend == graphicsBackendVulkan && windowSequence.valid()
    ) windowSequence.vulkanPipelines[0] else 0
    var resized = targetRendered && windowRendered && app.resize(672, 384)
    var resizeEvent = WindowEvent()
    var resizePoll = 0
    while (resized && resizeEvent.kind != windowEventResized &&
        resizePoll < 32) {
        resizeEvent = app.pollEvent(50)
        resizePoll = resizePoll + 1
    }
    resized = resized && resizeEvent.first == 672 &&
        resizeEvent.second == 384 &&
        app.presentPushBatchRenderIndexedSequence(
            windowSequence, sceneGeometry.vertices, sceneGeometry.indices,
            sceneGeometry.indexCount, clear
        ) && (app.backend == graphicsBackendOpenGl || (
            app.vulkanSwapchain.width == 672 &&
            app.vulkanSwapchain.height == 384 &&
            windowSequence.pipelines[0].vulkan.width == 672 &&
            windowSequence.pipelines[1].vulkan.width == 672 &&
            windowSequence.vulkanPipelines[0] ==
                windowSequence.pipelines[0].vulkan.handle &&
            windowSequence.vulkanPipelines[1] ==
                windowSequence.pipelines[1].vulkan.handle &&
            windowSequence.vulkanPipelines[0] != firstWindowPipelineHandle
        ))
    var rendered = targetRendered && windowRendered && resized
    var warm = 0
    while (rendered && warm < 4) {
        rendered = app.renderGltfMaterialBatchesToTarget(
            target, materialPlan, targetPipelines, batches, passes,
            sceneGeometry.vertices, sceneGeometry.indices,
            sceneGeometry.indexCount
        ) && app.presentPushBatchRenderIndexedSequence(
            windowSequence, sceneGeometry.vertices,
            sceneGeometry.indices, sceneGeometry.indexCount, clear
        )
        warm = warm + 1
    }
    val firstPixel = if (rendered) target.texture.rgba8(24, 32) else -1
    val secondPixel = if (rendered) target.texture.rgba8(51, 32) else -1
    val liveBefore = runtimeMemoryLiveBytes()
    var frame = 0
    while (rendered && frame < 4) {
        rendered = app.renderGltfMaterialBatchesToTarget(
            target, materialPlan, targetPipelines, batches, passes,
            sceneGeometry.vertices, sceneGeometry.indices,
            sceneGeometry.indexCount
        ) && app.presentPushBatchRenderIndexedSequence(
            windowSequence, sceneGeometry.vertices,
            sceneGeometry.indices, sceneGeometry.indexCount, clear
        ) && target.texture.rgba8(24, 32) == firstPixel &&
            target.texture.rgba8(51, 32) == secondPixel
        frame = frame + 1
    }
    val liveAfter = runtimeMemoryLiveBytes()
    val vertexHandle = if (app.backend == graphicsBackendOpenGl)
        sceneGeometry.vertices.openGl.handle
        else sceneGeometry.vertices.vulkan.handle
    val indexHandle = if (app.backend == graphicsBackendOpenGl)
        sceneGeometry.indices.openGl.handle else sceneGeometry.indices.vulkan.handle
    val stable = rendered && frame == 4 &&
        firstPixel == 4278706703 && secondPixel == 4294770688 &&
        liveAfter == liveBefore &&
        vertexHandle != 0 && indexHandle != 0
    println("gltf-live-scene ${graphicsBackendName(app.backend)}: parsed=${parsed.succeeded} payloads=${payloads.valid} materialTextures=5/10 batches=${materialPlan.batchCount()} windowGroups=${windowSequence.groupCount()} resize=$resized drawables=${drawList.drawables.size} materials=${drawList.drawables[0].material}/${drawList.drawables[2].material} resources=${resourcePlan.meshIndices.size} vertices=${sceneGeometry.vertexCount} indices=${sceneGeometry.indexCount} stride=${sceneGeometry.layout.stride} uv=u8/u16 surface=unlit+clearcoat+sheen+specular+ior channels=base/mr/normal/occlusion/emissive ranges=${drawIndexOffsets[0]}:${drawIndexCounts[0]}/${drawIndexOffsets[2]}:${drawIndexCounts[2]} pixels=$firstPixel/$secondPixel frames=$frame live=${liveAfter - liveBefore} stable=$stable")
    if (stable) 0 else 1
}
