import "../../src/graphics.ab"

fun main: int {
    val window = x11Window(WindowConfig(
        title = "Abla Graphics - pure Abla X11",
        width = 800,
        height = 450
    ))
    var polls = 0
    var close = !window.valid()
    while (!close && polls < 120) {
        val event = window.pollEvent(16)
        if (event.kind == windowEventCloseRequested) close = true
        polls = polls + 1
    }
    if (window.valid()) 0 else 1
}
