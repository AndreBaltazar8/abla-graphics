import "abla/io"
import "abla/process/arguments"
import "abla/runtime/memory"
import "../../src/graphics.ab"

trusted fun main: int {
    val requested = if (processArgumentCount() > 0)
        processArgument(0)
    else "vulkan"
    val backend = if (requested == "opengl")
        graphicsBackendOpenGl
    else graphicsBackendVulkan
    val app = graphicsApplication(
        GraphicsConfig(backend = backend, validation = true),
        WindowConfig(
            title = "Abla Graphics recorded graph compute",
            width = 480,
            height = 270
        )
    )
    val storageDescriptor = BufferDescriptor(
        size = 8,
        usage = bufferUsageStorage | bufferUsageCopySource |
            bufferUsageCopyDestination
    )
    val graph = app.materializeRenderGraphResources([
        GraphicsGraphResource(0, "storage", false, 8, 10)
    ], [
        GraphicsGraphPass(10, "compute", [
            GraphicsGraphUse(0, graphAccessReadWrite)
        ]),
        GraphicsGraphPass(11, "consume", [
            GraphicsGraphUse(0, graphAccessRead)
        ])
    ], [], [
        GraphicsGraphBufferDeclaration(0, storageDescriptor)
    ])
    val shader = $glsl {
        compute {
            #version 450
            layout(local_size_x = 1) in;
            layout(std430, binding = 0) buffer Values {
                uint value;
            } values;
            layout(push_constant) uniform Push {
                uint addend;
            } push;
            void main() {
                values.value = values.value + push.addend;
            }
        }
    }
    val storage = app.buffer(storageDescriptor)
    val pipeline = app.computeStoragePipeline(shader, storage)
    val pushValues = shader.pushConstants()
    val commands = app.graphCommandList(graph, 3)
    var succeeded = app.valid() && graph.valid() && shader.valid &&
        graph.plan.barriers.size == 1 && graph.pools.size == 0 &&
        storage.writeI64(0) && pipeline.valid() &&
        pushValues.storeU32(3) && commands.valid() &&
        commands.recordPass(graph, 10) &&
        commands.recordComputeStoragePush(
            graph,
            0,
            move(storage),
            move(pipeline),
            pushValues,
            1
        ) && commands.recordPass(graph, 11) && commands.seal(graph) &&
        commands.prepared && commands.commandCount == 3 &&
        commands.computeResources[0].resourceIds.size == 1 &&
        commands.computeResources[0].resourceIds[0] == 0 &&
        commands.computePushSizes[1] == 4 && pushValues.storeU32(9) &&
        commands.consolidatedVulkan ==
            (app.backend == graphicsBackendVulkan)
    val storageIdentity = if (app.backend == graphicsBackendOpenGl)
        commands.computeResources[0].buffers[0].openGl.handle
    else commands.computeResources[0].buffers[0].vulkan.handle
    val pipelineIdentity = if (app.backend == graphicsBackendOpenGl)
        commands.computePipelines[0].openGl.handle
    else commands.computePipelines[0].vulkan.handle
    val commandPoolIdentity = commands.computePipelines[0].vulkan.commandPool
    val liveBefore = runtimeMemoryLiveBytes()
    var iteration = 0
    while (succeeded && iteration < 1001) {
        succeeded = app.executeGraphCommands(graph, commands)
        iteration = iteration + 1
    }
    val liveAfter = runtimeMemoryLiveBytes()
    val result = if (succeeded)
        commands.computeResources[0].buffers[0].readI64()
        else -1
    val stable = succeeded && iteration == 1001 && result == 3003 &&
        liveAfter == liveBefore && storageIdentity != 0 &&
        pipelineIdentity != 0 &&
        (if (app.backend == graphicsBackendOpenGl)
            commands.computeResources[0].buffers[0].openGl.handle ==
                storageIdentity &&
            commands.computePipelines[0].openGl.handle == pipelineIdentity
         else commands.computeResources[0].buffers[0].vulkan.handle ==
            storageIdentity &&
            commands.computePipelines[0].vulkan.handle == pipelineIdentity &&
            commands.computePipelines[0].vulkan.commandPool ==
                commandPoolIdentity) && commands.executions == 1001 &&
        graph.completedExecutions == 1001 &&
        graph.lastExecutionBarriers == 1 &&
        graph.totalExecutedBarriers == 1001 &&
        graph.backendBarrierCalls == 1001 &&
        commands.vulkanSubmissions ==
            (if (app.backend == graphicsBackendVulkan) 1001 else 0)
    println(
        "recorded-graph-compute ${graphicsBackendName(app.backend)}: commands=${commands.commandCount}/${commands.capacity} result=$result snapshot=${result == 3003} executions=${commands.executions}/${graph.completedExecutions} barriers=${graph.lastExecutionBarriers}/${graph.totalExecutedBarriers}/${graph.backendBarrierCalls} submissions=${commands.vulkanSubmissions} live=${liveAfter - liveBefore} stable=$stable handles=$storageIdentity/$pipelineIdentity/$commandPoolIdentity"
    )
    if (stable) 0 else 1
}
