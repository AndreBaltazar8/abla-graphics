import "abla/io"
import "abla/process/arguments"
import "abla/runtime/memory"
import "../../src/texture.ab"
import "../../src/texture_pool.ab"
import "../../src/render.ab"
import "../../src/gltf_buffer.ab"

fun main: int {
    val requested = if (processArgumentCount() > 0)
        processArgument(0) else "auto"
    val backend = if (requested == "opengl") graphicsBackendOpenGl
        else if (requested == "vulkan") graphicsBackendVulkan
        else graphicsBackendAuto
    val app = graphicsApplication(
        GraphicsConfig(backend = backend, framesInFlight = 2),
        WindowConfig(
            title = "Abla Graphics glTF deformation",
            width = 640,
            height = 360
        )
    )
    val payload = ""
    val source = "{\"asset\":{\"version\":\"2.0\"},\"buffers\":[{\"uri\":\"data:application/octet-stream;base64,$payload\",\"byteLength\":310}],\"bufferViews\":[{\"buffer\":0,\"byteOffset\":0,\"byteLength\":36},{\"buffer\":0,\"byteOffset\":36,\"byteLength\":24},{\"buffer\":0,\"byteOffset\":60,\"byteLength\":36},{\"buffer\":0,\"byteOffset\":96,\"byteLength\":48},{\"buffer\":0,\"byteOffset\":144,\"byteLength\":12},{\"buffer\":0,\"byteOffset\":156,\"byteLength\":48},{\"buffer\":0,\"byteOffset\":204,\"byteLength\":36},{\"buffer\":0,\"byteOffset\":240,\"byteLength\":64},{\"buffer\":0,\"byteOffset\":304,\"byteLength\":6}],\"accessors\":[{\"bufferView\":0,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\"},{\"bufferView\":1,\"componentType\":5126,\"count\":3,\"type\":\"VEC2\"},{\"bufferView\":2,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\"},{\"bufferView\":3,\"componentType\":5126,\"count\":3,\"type\":\"VEC4\"},{\"bufferView\":4,\"componentType\":5121,\"count\":3,\"type\":\"VEC4\"},{\"bufferView\":5,\"componentType\":5126,\"count\":3,\"type\":\"VEC4\"},{\"bufferView\":6,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\"},{\"bufferView\":7,\"componentType\":5126,\"count\":1,\"type\":\"MAT4\"},{\"bufferView\":8,\"componentType\":5123,\"count\":3,\"type\":\"SCALAR\"}],\"meshes\":[{\"weights\":[0.0],\"primitives\":[{\"attributes\":{\"POSITION\":0,\"TEXCOORD_0\":1,\"NORMAL\":2,\"TANGENT\":3,\"JOINTS_0\":4,\"WEIGHTS_0\":5},\"targets\":[{\"POSITION\":6}],\"indices\":8}]}],\"nodes\":[{\"mesh\":0,\"skin\":0,\"weights\":[1.0]},{\"translation\":[0.25,0,0]}],\"skins\":[{\"inverseBindMatrices\":7,\"joints\":[1],\"skeleton\":1}],\"scenes\":[{\"nodes\":[0,1]}],\"scene\":0}"
    val parsed = gltfDocument(source)
    val buffers = if (parsed.succeeded)
        gltfBufferPayloads(parsed.document) else GltfBufferPayloads([], false, "parse")
    val draws = if (parsed.succeeded)
        gltfSceneDrawList(parsed.document) else GltfSceneDrawList([], [], false, "parse")
    val resources = if (parsed.succeeded)
        gltfSceneAccessorResourcePlan(parsed.document, draws)
        else GltfSceneResourcePlan([], [], [], false, "parse")
    val deformation = if (parsed.succeeded)
        gltfDeformationPlan(parsed.document, draws)
        else GltfDeformationPlan([], [], [], [], [], [], [], [], [], [], [], [], false, "parse")
    val geometry = app.gltfGpuTexturedScene(
        parsed.document, buffers, draws, resources
    )
    val shader = $glsl {
        vertex {
            #version 450
            layout(location = 0) in vec3 position;
            layout(location = 1) in vec2 uv;
            layout(location = 0) out vec2 texCoord;
            layout(std140, binding = 1) uniform Transform {
                mat4 mvp;
            } transform;
            void main() {
                gl_Position = transform.mvp * vec4(position, 1.0);
                texCoord = uv;
            }
        }
        fragment {
            #version 450
            layout(location = 0) in vec2 texCoord;
            layout(location = 0) out vec4 color;
            layout(binding = 0) uniform sampler2D surface;
            void main() {
                color = texture(surface, texCoord);
            }
        }
    }
    val target = app.renderTarget(app.texture(TextureDescriptor(
        label = "gltf-deformation-target",
        size = Extent3D(64, 64),
        format = textureFormatRgba8Unorm,
        usage = textureUsageRenderAttachment | textureUsageCopySource
    )))
    val greenPixels = pixelBuffer(1, 1)
    val greenTexture = app.texture(TextureDescriptor(
        label = "gltf-deformation-green",
        size = Extent3D(1, 1),
        format = textureFormatRgba8Unorm,
        usage = textureUsageSampled | textureUsageCopyDestination
    ))
    val greenSampler = app.sampler(SamplerDescriptor(
        magFilter = samplerFilterNearest,
        minFilter = samplerFilterNearest,
        mipmapFilter = samplerFilterNearest
    ))
    val transformBytes = bufferBytes(64)
    val transform = app.buffer(BufferDescriptor(
        label = "gltf-deformation-transform",
        size = 64,
        usage = bufferUsageUniform | bufferUsageCopyDestination
    ))
    var transformReady = transformBytes.fill(0)
    var diagonal = 0
    while (transformReady && diagonal < 4) {
        transformReady = transformBytes.storeF32(1.0, diagonal * 20)
        diagonal = diagonal + 1
    }
    val resourcesReady = greenPixels.clearRgba8(0, 255, 0) &&
        greenTexture.writePixels(greenPixels, TextureWriteDescriptor()) &&
        transformReady && transform.writeAllBytes(transformBytes)
    val pipelineLayout = VertexBufferLayout(48, [
        VertexAttribute(0, 0, vertexFormatFloat32x3),
        VertexAttribute(1, 12, vertexFormatFloat32x2)
    ])
    val targetPipeline = app.renderTargetPipeline(
        target, shader, pipelineLayout,
        RasterPipelineState(), DepthStencilState(), app.bindGroup([
            app.sampledTextureEntry(
                0, shaderVisibilityFragment, greenTexture, greenSampler
            ),
            app.uniformBufferEntry(
                1, shaderVisibilityVertex, transform
            )
        ])
    )
    val windowPipeline = app.renderPipeline(
        shader, pipelineLayout,
        RasterPipelineState(), DepthStencilState(), app.bindGroup([
            app.sampledTextureEntry(
                0, shaderVisibilityFragment, greenTexture, greenSampler
            ),
            app.uniformBufferEntry(
                1, shaderVisibilityVertex, transform
            )
        ])
    )
    val clear = Color(0.01, 0.01, 0.015)
    val setup = app.valid() && parsed.succeeded && buffers.valid &&
        draws.valid && draws.drawables.size == 1 && resources.valid &&
        resources.meshIndices.size == 1 && resources.resourceNodes[0] == 0 &&
        deformation.valid && deformation.skinJointCounts[0] == 1 &&
        deformation.drawableMorphCounts[0] == 1 &&
        geometry.valid() && geometry.vertexCount == 3 &&
        geometry.indexCount == 3 && geometry.layout.stride == 48 &&
        shader.valid && target.valid() && targetPipeline.valid() &&
        windowPipeline.valid() && resourcesReady
    if (!setup) println("gltf-live-deformation setup: app=${app.valid()} parsed=${parsed.succeeded}:${parsed.error} buffers=${buffers.valid}:${buffers.error} draws=${draws.valid}:${draws.error} resources=${resources.valid}:${resources.error} deformation=${deformation.valid}:${deformation.error} geometry=${geometry.valid()}:${geometry.error} shader=${shader.valid}:${shader.error} target=${target.valid()} pipelines=${targetPipeline.valid()}:${targetPipeline.error.message}/${windowPipeline.valid()}:${windowPipeline.error.message}")
    var rendered = setup && app.renderIndexedToTarget(
            target, targetPipeline, geometry.vertices, geometry.indices,
            geometry.indexCount, clear
        ) && app.presentRenderIndexed(
            windowPipeline, geometry.vertices, geometry.indices,
            geometry.indexCount, clear
        )
    var warm = 0
    while (rendered && warm < 4) {
        rendered = app.renderIndexedToTarget(
            target, targetPipeline, geometry.vertices, geometry.indices,
            geometry.indexCount, clear
        ) && app.presentRenderIndexed(
            windowPipeline, geometry.vertices, geometry.indices,
            geometry.indexCount, clear
        )
        warm = warm + 1
    }
    val center = if (rendered) target.texture.rgba8(32, 32) else -1
    val deformed = if (rendered) target.texture.rgba8(48, 32) else -1
    val liveBefore = runtimeMemoryLiveBytes()
    var frame = 0
    while (rendered && frame < 4) {
        rendered = app.renderIndexedToTarget(
            target, targetPipeline, geometry.vertices, geometry.indices,
            geometry.indexCount, clear
        ) && app.presentRenderIndexed(
            windowPipeline, geometry.vertices, geometry.indices,
            geometry.indexCount, clear
        ) && target.texture.rgba8(32, 32) == center &&
            target.texture.rgba8(48, 32) == deformed
        frame = frame + 1
    }
    val liveAfter = runtimeMemoryLiveBytes()
    val stable = rendered && frame == 4 && center != 4278255360 &&
        deformed == 4278255360 && liveAfter == liveBefore
    println("gltf-live-deformation ${graphicsBackendName(app.backend)}: skin=1 morph=1 resources=${resources.meshIndices.size} vertices=${geometry.vertexCount} pixels=$center/$deformed frames=$frame live=${liveAfter - liveBefore} stable=$stable")
    if (stable) 0 else 1
}
